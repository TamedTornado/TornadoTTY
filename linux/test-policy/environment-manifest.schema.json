{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:zentty:linux-test-policy:environment-manifest:v1",
  "title": "Zentty Linux qualification environment manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_id", "captured_at_utc", "captured_at_epoch", "claim_scope", "test_tier", "status", "source", "os", "toolchains", "libraries", "display", "locale", "keymap", "fonts", "ime", "dbus", "packages", "required_features", "isolation"],
  "properties": {
    "schema_version": {"const": 1},
    "manifest_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]+$"},
    "captured_at_utc": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "captured_at_epoch": {"type": "integer", "minimum": 0},
    "claim_scope": {"enum": ["local", "controlled_ci", "representative_hardware", "dogfood"]},
    "test_tier": {"enum": ["unit_property", "contract_component", "qualification_host_integration", "product_boundary_integration", "installed_artifact", "representative_desktop_hardware", "dogfood"]},
    "status": {"enum": ["PASS", "FAIL", "BLOCKED", "XFAIL", "NOT_IMPLEMENTED"]},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "revision", "tree_state", "tree_identity_sha256"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "tree_state": {"enum": ["clean", "dirty"]},
        "tree_identity_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "os": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "architecture", "kernel", "image"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "architecture": {"type": "string", "minLength": 1},
        "kernel": {"type": "string", "minLength": 1},
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "digest"],
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "digest": {"type": "string", "pattern": "^(sha256:[0-9a-f]{64}|not-containerized)$"}
          }
        }
      }
    },
    "toolchains": {"$ref": "#/$defs/versionedList"},
    "libraries": {"$ref": "#/$defs/versionedList"},
    "packages": {"$ref": "#/$defs/versionedList"},
    "display": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected_backend", "actual_backend", "compositor_or_server", "renderer", "input", "scale"],
      "properties": {
        "expected_backend": {"enum": ["none", "wayland", "x11"]},
        "actual_backend": {"enum": ["none", "wayland", "x11"]},
        "compositor_or_server": {"$ref": "#/$defs/provedComponent"},
        "renderer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["api", "vendor", "device", "driver", "software", "proof"],
          "properties": {
            "api": {"type": "string"},
            "vendor": {"type": "string"},
            "device": {"type": "string"},
            "driver": {"type": "string"},
            "software": {"type": "boolean"},
            "proof": {"$ref": "#/$defs/acknowledgement"}
          }
        },
        "input": {"$ref": "#/$defs/provedComponent"},
        "scale": {
          "type": "object",
          "additionalProperties": false,
          "required": ["expected", "actual", "proof"],
          "properties": {
            "expected": {"type": "number", "exclusiveMinimum": 0},
            "actual": {"type": "number", "exclusiveMinimum": 0},
            "proof": {"$ref": "#/$defs/acknowledgement"}
          }
        }
      }
    },
    "locale": {"type": "object", "additionalProperties": false, "required": ["lang", "lc_all"], "properties": {"lang": {"type": "string", "minLength": 1}, "lc_all": {"type": "string", "minLength": 1}}},
    "keymap": {"type": "object", "additionalProperties": false, "required": ["layout", "variant", "options"], "properties": {"layout": {"type": "string", "minLength": 1}, "variant": {"type": "string"}, "options": {"type": "string"}}},
    "fonts": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["family", "version", "sha256"], "properties": {"family": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}},
    "ime": {"$ref": "#/$defs/provedComponent"},
    "dbus": {"$ref": "#/$defs/provedComponent"},
    "required_features": {"type": "array", "uniqueItems": true, "items": {"enum": ["display", "renderer", "input", "scale", "ime", "dbus", "installed_root"]}},
    "isolation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_root", "xdg_config_home", "xdg_data_home", "xdg_cache_home", "xdg_state_home", "xdg_runtime_dir", "tmp_dir", "installed_root", "display_socket", "dbus_address_fingerprint", "process_group", "allocated_ports", "child_processes_after", "cleanup_acknowledgement"],
      "properties": {
        "run_root": {"type": "string", "minLength": 2},
        "xdg_config_home": {"type": "string", "minLength": 2},
        "xdg_data_home": {"type": "string", "minLength": 2},
        "xdg_cache_home": {"type": "string", "minLength": 2},
        "xdg_state_home": {"type": "string", "minLength": 2},
        "xdg_runtime_dir": {"type": "string", "minLength": 2},
        "tmp_dir": {"type": "string", "minLength": 2},
        "installed_root": {"type": "string", "minLength": 2},
        "display_socket": {"type": "string", "minLength": 1},
        "dbus_address_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "process_group": {"type": "integer", "minimum": 1},
        "allocated_ports": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 1, "maximum": 65535}},
        "child_processes_after": {"type": "array", "maxItems": 0},
        "cleanup_acknowledgement": {"$ref": "#/$defs/acknowledgement"}
      }
    },
    "explanation": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "acknowledgement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected", "observed", "matched"],
      "properties": {
        "expected": {"type": "string", "minLength": 1},
        "observed": {"type": "string", "minLength": 1},
        "matched": {"type": "boolean"}
      }
    },
    "provedComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "endpoint", "controlled", "active", "proof"],
      "properties": {
        "name": {"type": "string"},
        "version": {"type": "string"},
        "endpoint": {"type": "string"},
        "controlled": {"type": "boolean"},
        "active": {"type": "boolean"},
        "proof": {"$ref": "#/$defs/acknowledgement"}
      }
    },
    "versionedList": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version", "source"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
