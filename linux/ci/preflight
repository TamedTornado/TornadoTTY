#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
manifest="${ZENTTY_CI_ENVIRONMENT_MANIFEST:-${repo_root}/linux/ci/environment-v1.json}"
os_release="${ZENTTY_CI_OS_RELEASE:-/etc/os-release}"
tools_root="${ZENTTY_CI_TOOLS_ROOT:-${repo_root}/build/linux-ci-tools}"
receipt="${ZENTTY_CI_PREFLIGHT_RECEIPT:-${repo_root}/build/linux/ci-preflight.json}"
started_at_epoch="$(date +%s)"

fail() {
    echo "ci-preflight: error: $*" >&2
    exit 1
}

rm -f -- "${receipt}"
"${repo_root}/linux/ci/validate-environment" >/dev/null
[[ -f "${os_release}" ]] || fail "OS release identity is missing"
# shellcheck disable=SC1090
source "${os_release}"
[[ "${ID:-}" == ubuntu && "${VERSION_ID:-}" == 24.04* ]] ||
    fail "Ubuntu 24.04 is required"
[[ "$(dpkg --print-architecture)" == amd64 && "$(uname -m)" == x86_64 ]] ||
    fail "amd64/x86_64 is required"
[[ -z "$(git -C "${repo_root}" status --porcelain=v1)" ]] || fail "Zentty checkout is dirty"
while IFS='=' read -r name expected; do
    [[ "${!name:-}" == "${expected}" ]] || fail "deterministic environment mismatch: ${name}"
done < <(jq -r '.deterministic_environment | to_entries[] | "\(.key)=\(.value)"' "${manifest}")

apt_receipt="$(mktemp)"
trap 'rm -f -- "${apt_receipt:-}"' EXIT
while IFS= read -r package; do
    version="$(dpkg-query -W -f='${Version}' "${package}" 2>/dev/null)" ||
        fail "required apt package is missing: ${package}"
    printf '%s\t%s\n' "${package}" "${version}" >>"${apt_receipt}"
done < <(jq -r '.apt_packages[]' "${manifest}")

ghostty_source="${GHOSTTY_SOURCE_DIR:-${repo_root}/build/linux-deps/ghostty}"
expected_ghostty_repo="$(jq -r '.source_contract.ghostty_repository' "${manifest}")"
expected_ghostty_revision="$(jq -r '.source_contract.ghostty_revision' "${manifest}")"
[[ -e "${ghostty_source}/.git" ]] || fail "prepared Ghostty checkout is missing"
[[ "$(git -C "${ghostty_source}" remote get-url origin)" == "${expected_ghostty_repo}" ]] ||
    fail "prepared Ghostty origin is not reviewed"
[[ "$(git -C "${ghostty_source}" rev-parse HEAD)" == "${expected_ghostty_revision}" ]] ||
    fail "prepared Ghostty revision is not reviewed"
[[ -z "$(git -C "${ghostty_source}" status --porcelain=v1)" ]] || fail "Ghostty checkout is dirty"

for dependency in bwrap cage jq labwc rustup valgrind weston Xvfb xdotool wtype; do
    command -v "${dependency}" >/dev/null || fail "${dependency} is required"
done
unshare --user --map-root-user true >/dev/null 2>&1 || fail "unprivileged user namespaces are required"
bwrap --ro-bind / / --proc /proc --dev /dev true >/dev/null 2>&1 ||
    fail "Bubblewrap user namespaces are required"

zig="${ZIG:-${tools_root}/zig-x86_64-linux-0.16.0/zig}"
blueprint="${BLUEPRINT_COMPILER_DIR:-${tools_root}/blueprint-compiler-0.16.0/bin}/blueprint-compiler"
pnpm="${ZENTTY_PNPM:-${tools_root}/pnpm-10.32.1/bin/pnpm.cjs}"
[[ "$("${zig}" version)" == "$(jq -r '.toolchains.zig.version' "${manifest}")" ]] ||
    fail "Zig version is not reviewed"
[[ "$("${blueprint}" --version)" == "$(jq -r '.toolchains.blueprint_compiler.version' "${manifest}")" ]] ||
    fail "Blueprint compiler version is not reviewed"
[[ "$(rustc --version | awk '{print $2}')" == "$(jq -r '.toolchains.rust.version' "${manifest}")" ]] ||
    fail "Rust version is not reviewed"
[[ "$(node --version)" == v24.* ]] || fail "Node 24 is required"
[[ "$("${pnpm}" --version)" == "$(jq -r '.toolchains.node.pnpm_version' "${manifest}")" ]] ||
    fail "pnpm version is not reviewed"

node_bin="${repo_root}/linux/ci/node-tools/node_modules/.bin"
PATH="${node_bin}:${HOME}/.local/bin:${PATH}"
export PATH
[[ "$(gemini --version 2>/dev/null | tail -1)" == "$(jq -r '.reviewed_agent_clis.gemini.version' "${manifest}")" ]] ||
    fail "Gemini version is not reviewed"
[[ "$(codex --version 2>/dev/null)" == "codex-cli $(jq -r '.reviewed_agent_clis.codex.version' "${manifest}")" ]] ||
    fail "Codex version is not reviewed"
claude_binary="$(readlink -f -- "$(command -v claude)")"
[[ "${claude_binary}" == "${HOME}/.local/share/claude/versions/$(jq -r '.reviewed_agent_clis.claude.version' "${manifest}")" ]] ||
    fail "Claude executable path is not reviewed"
[[ "$(sha256sum "${claude_binary}" | awk '{print $1}')" == "$(jq -r '.reviewed_agent_clis.claude.sha256' "${manifest}")" ]] ||
    fail "Claude executable checksum is not reviewed"
[[ "$(claude --version 2>/dev/null)" == "$(jq -r '.reviewed_agent_clis.claude.version' "${manifest}") (Claude Code)" ]] ||
    fail "Claude version is not reviewed"

mkdir -p "$(dirname "${receipt}")"
apt_packages_json="$(jq -Rn '
  [inputs | split("\t") | {(.[0]):.[1]}] | add
' <"${apt_receipt}")"
jq -n \
    --arg runner_label "$(jq -r '.baseline.runner_label' "${manifest}")" \
    --arg runner_image_version "${ImageVersion:-local-unversioned}" \
    --arg started_at_epoch "${started_at_epoch}" \
    --arg run_id "${GITHUB_RUN_ID:-local}" \
    --arg run_attempt "${GITHUB_RUN_ATTEMPT:-1}" \
    --arg zentty_revision "$(git -C "${repo_root}" rev-parse HEAD)" \
    --arg ghostty_revision "${expected_ghostty_revision}" \
    --arg manifest_sha256 "$(sha256sum "${manifest}" | awk '{print $1}')" \
    --arg zig "$(${zig} version)" \
    --arg rust "$(rustc --version)" \
    --arg pnpm "$("${pnpm}" --version)" \
    --arg gemini "$(gemini --version 2>/dev/null | tail -1)" \
    --arg codex "$(codex --version 2>/dev/null)" \
    --arg claude "$(claude --version 2>/dev/null)" \
    --argjson apt_packages "${apt_packages_json}" '
    {
      schema_version:1,
      generated_at_epoch:($started_at_epoch | tonumber),
      baseline:{runner_label:$runner_label,runner_image_version:$runner_image_version},
      run:{id:$run_id,attempt:($run_attempt | tonumber)},
      source:{zentty_revision:$zentty_revision,ghostty_revision:$ghostty_revision,trees:"clean"},
      environment_manifest_sha256:$manifest_sha256,
      apt_packages:$apt_packages,
      tools:{zig:$zig,rust:$rust,pnpm:$pnpm,gemini:$gemini,codex:$codex,claude:$claude},
      prerequisites:{user_namespaces:true,bubblewrap:true,controlled_x11:true,controlled_wayland:true}
    }
' >"${receipt}"
rm -f -- "${apt_receipt}"
trap - EXIT

echo "ci-preflight: PASS receipt=${receipt}"
