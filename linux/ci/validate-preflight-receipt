#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
manifest="${ZENTTY_CI_ENVIRONMENT_MANIFEST:-${repo_root}/linux/ci/environment-v1.json}"
receipt="${ZENTTY_CI_PREFLIGHT_RECEIPT:-${repo_root}/build/linux/ci-preflight.json}"
now="$(date +%s)"
qualification_profile="${ZENTTY_CI_QUALIFICATION_PROFILE:-full}"

fail() {
    echo "validate-ci-preflight-receipt: error: $*" >&2
    exit 1
}

[[ -f "${receipt}" ]] || fail "receipt is missing: ${receipt}"
manifest_sha="$(sha256sum "${manifest}" | awk '{print $1}')"
zentty_revision="${ZENTTY_EXPECTED_COMMIT:-$(git -C "${repo_root}" rev-parse HEAD)}"
ghostty_revision="$(sed -n 's/^revision=//p' "${repo_root}/linux/ghostty.lock")"
case "${qualification_profile}" in
    full)
        expected_apt="$(jq -c '.apt_packages | sort' "${manifest}")"
        max_receipt_age_seconds=10800
        ;;
    public-pr)
        expected_apt="$(jq -c '.qualification_profiles["public-pr"].apt_packages | sort' "${manifest}")"
        max_receipt_age_seconds=3600
        ;;
    *) fail "unknown qualification profile: ${qualification_profile}" ;;
esac

jq -e \
    --argjson now "${now}" \
    --argjson max_receipt_age_seconds "${max_receipt_age_seconds}" \
    --arg manifest_sha "${manifest_sha}" \
    --arg zentty_revision "${zentty_revision}" \
    --arg ghostty_revision "${ghostty_revision}" \
    --arg qualification_profile "${qualification_profile}" \
    --argjson expected_apt "${expected_apt}" \
    --slurpfile manifest "${manifest}" \
    --arg expected_image_version "${ZENTTY_EXPECTED_RUNNER_IMAGE_VERSION:-}" '
  $manifest[0] as $m |
  .schema_version == 2 and
  (.generated_at_epoch | type == "number" and . <= $now and
    . >= ($now - $max_receipt_age_seconds)) and
  (.baseline.runner_label == "ubuntu-24.04") and
  (.baseline.runner_image_version | type == "string" and length > 0) and
  ($expected_image_version == "" or .baseline.runner_image_version == $expected_image_version) and
  (.run.id | type == "string" and length > 0) and
  (.run.attempt | type == "number" and . >= 1 and floor == .) and
  (.source == {zentty_revision:$zentty_revision,ghostty_revision:$ghostty_revision,trees:"clean"}) and
  (.environment_manifest_sha256 == $manifest_sha) and
  (.qualification_profile == $qualification_profile) and
  ((.apt_packages | keys | sort) == $expected_apt) and
  (all(.apt_packages[]; type == "string" and length > 0)) and
  (.tools.zig == $m.toolchains.zig.version) and
  (.tools.rust | startswith("rustc \($m.toolchains.rust.version) ")) and
  (.tools.pnpm == $m.toolchains.node.pnpm_version) and
  (.tools.fish == "fish, version \($m.toolchains.qualification_shells.fish.version)") and
  (.tools.nu == $m.toolchains.qualification_shells.nu.version) and
  (.tools.bun == $m.toolchains.bun.version) and
  (.tools.gemini == $m.reviewed_agent_clis.gemini.version) and
  (.tools.codex == "codex-cli \($m.reviewed_agent_clis.codex.version)") and
  (.tools.claude == "\($m.reviewed_agent_clis.claude.version) (Claude Code)") and
  (.prerequisites == {user_namespaces:true,bubblewrap:true,controlled_x11:true,controlled_wayland:true}) and
  ([paths(scalars) as $p | getpath($p) | strings] |
    all(.[]; test("(gh[pousr]_[A-Za-z0-9_]{20,}|sk-[A-Za-z0-9]{20,}|must-not-cross-product-boundary)") | not))
' "${receipt}" >/dev/null || fail "receipt is stale, incomplete, mismatched, or unsafe"

echo "validate-ci-preflight-receipt: PASS revision=${zentty_revision}"
