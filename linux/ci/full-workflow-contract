#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
workflow="${ZENTTY_CI_FULL_WORKFLOW:-${repo_root}/.github/workflows/linux-ci-full.yml}"
actions_manifest="${ZENTTY_CI_ACTIONS_MANIFEST:-${repo_root}/linux/ci/actions-v1.json}"
environment_manifest="${ZENTTY_CI_ENVIRONMENT_MANIFEST:-${repo_root}/linux/ci/environment-v1.json}"
fixture="$(mktemp -d)"
trap 'rm -rf -- "${fixture}"' EXIT
fail() { echo "ci-full-workflow-contract: error: $*" >&2; exit 1; }

for dependency in awk grep jq sort; do command -v "${dependency}" >/dev/null || fail "${dependency} is required"; done
[[ -f "${workflow}" ]] || fail "full qualification workflow is missing"
while IFS=$'\t' read -r repository revision; do
    grep -Fq "uses: ${repository}@${revision}" "${workflow}" || fail "workflow does not pin ${repository} to ${revision}"
done < <(jq -r '.actions[] | [.repository,.revision] | @tsv' "${actions_manifest}")
! grep -Eq 'uses: [^#[:space:]]+@(v[0-9]+|main|master|latest)([[:space:]#]|$)' "${workflow}" || fail "mutable action reference"

grep -Eq '^  schedule:$' "${workflow}" || fail "scheduled trigger is absent"
grep -Eq '^  workflow_dispatch:$' "${workflow}" || fail "manual trigger is absent"
grep -Eq '^  push:$' "${workflow}" || fail "integration-branch trigger is absent"
grep -Fq '      - linux/port' "${workflow}" || fail "integration-branch identity is absent"
! grep -Eq '^[[:space:]]+paths:' "${workflow}" || fail "integration-branch trigger excludes changes"
! grep -Eq 'pull_request_target|^[[:space:]]*secrets:' "${workflow}" || fail "privileged trigger or secrets are present"
grep -Fq 'runs-on: ubuntu-24.04' "${workflow}" || fail "runner baseline is not pinned"
grep -Fq 'timeout-minutes: 360' "${workflow}" || fail "job deadline is absent"
grep -Fq 'node-version: 24.14.0' "${workflow}" || fail "Node version is not pinned"
grep -Fq 'ZENTTY_CI_QUALIFICATION_PROFILE: full' "${workflow}" || fail "full profile is absent"
grep -Fq 'contents: read' "${workflow}" || fail "read-only permission is absent"
! grep -Eq 'contents:[[:space:]]+write|permissions:[[:space:]]+write-all' "${workflow}" || fail "write permission is present"
grep -Fq 'persist-credentials: false' "${workflow}" || fail "checkout credentials persist"
# shellcheck disable=SC2016
grep -Fq 'ZENTTY_EXPECTED_COMMIT: ${{ github.sha }}' "${workflow}" || fail "event commit binding is absent"
grep -Fq 'linux/tests/qualify-local' "${workflow}" || fail "authoritative runner is absent"
grep -Fq 'linux/ci/reset-product-outputs' "${workflow}" || fail "product cleanup is absent"
grep -Fq 'cargo fetch --locked' "${workflow}" || fail "prepared Cargo registry is absent"
grep -Fq 'rm -rf -- build/linux/matrix-logs' "${workflow}" || fail "qualification cleanup is absent"
[[ "$(grep -Fc 'if: always()' "${workflow}")" -ge 3 ]] || fail "always-run evidence is incomplete"
grep -Fq 'GITHUB_STEP_SUMMARY' "${workflow}" || fail "human summary is absent"
grep -Fq 'Release qualification: NOT_CLAIMED' "${workflow}" || fail "release can be overclaimed"
grep -Fq 'Full Linux qualification: NOT_CLAIMED' "${workflow}" || fail "full qualification can be overclaimed"
grep -Fq 'PASS only when reported with reviewed suppressions' "${workflow}" || fail "reviewed-suppression wording is absent"
grep -Fq 'ReleaseSafe Valgrind: expected XFAIL' "${workflow}" || fail "ReleaseSafe XFAIL wording is absent"
grep -Fq 'build/linux/memory-safety-*.raw.log' "${workflow}" || fail "raw Valgrind logs are absent"
grep -Fq 'build/linux/memory-safety-*.suppressed.log' "${workflow}" || fail "reviewed Valgrind logs are absent"
grep -Fq 'linux/tests/valgrind-suppressions.json' "${workflow}" || fail "suppression manifest is absent"
grep -Fq 'linux/tests/valgrind-suppressions.schema.json' "${workflow}" || fail "suppression schema is absent"
grep -Fq 'build/linux/package-qualification' "${workflow}" || fail "package evidence is absent"
grep -Fq 'build/linux-package/*.deb' "${workflow}" || fail "Debian artifact is absent"
grep -Fq 'retention-days: 14' "${workflow}" || fail "retention is unbounded"
grep -Fq 'cancel-in-progress: true' "${workflow}" || fail "supersession is disabled"
# shellcheck disable=SC2016
grep -Fq 'name: linux-ci-full-${{ github.sha }}-${{ github.run_attempt }}' "${workflow}" || fail "artifact identity is unsafe"

awk '/^[[:space:]]+packages=\($/{capture=1;next} capture&&/^[[:space:]]+\)$/{exit} capture{for(i=1;i<=NF;i++)print $i}' "${workflow}" | sort >"${fixture}/workflow"
jq -r '.apt_packages[]' "${environment_manifest}" | sort >"${fixture}/manifest"
cmp -s "${fixture}/workflow" "${fixture}/manifest" || fail "literal packages differ from full manifest"
[[ "$(grep -Fc 'timeout --signal=TERM --kill-after=30s 1800s' "${workflow}")" == 2 ]] || fail "apt deadlines are absent"
[[ "$(grep -Ec '^[[:space:]]+sudo (timeout --signal=TERM --kill-after=30s 1800s|env DEBIAN_FRONTEND=noninteractive|sysctl -w kernel[.]apparmor_restrict_unprivileged_userns=0)' "${workflow}")" == 3 ]] || fail "sudo boundary changed"
! grep -Eq 'sudo[[:space:]]+(env[[:space:]]+[^[:space:]]+[[:space:]]+)?linux/|sudo .*\$\(|sudo .*`' "${workflow}" || fail "repository command crosses sudo"

echo "ci-full-workflow-contract: PASS triggers=integration+schedule+manual permissions=read runner=qualify-local packages=full cargo=prepared"
