#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
manifest="${ZENTTY_CI_ENVIRONMENT_MANIFEST:-${repo_root}/linux/ci/environment-v1.json}"
tools_root="${ZENTTY_CI_TOOLS_ROOT:-${repo_root}/../.tools}"
environment_root="${repo_root}/build/linux-ci-tools"
install_system=true

tools_root="$(readlink -m -- "${tools_root}")"
[[ "${tools_root}/" != "${repo_root}/"* ]] || {
    echo "bootstrap-ubuntu-24.04: error: tools root must be outside the source checkout" >&2
    exit 1
}

fail() {
    echo "bootstrap-ubuntu-24.04: error: $*" >&2
    exit 1
}

case "${1:-}" in
    --print-apt)
        jq -r '.apt_packages[]' "${manifest}"
        exit 0
        ;;
    --no-system-install) install_system=false ;;
    "") ;;
    *) fail "usage: $0 [--print-apt|--no-system-install]" ;;
esac

"${repo_root}/linux/ci/validate-environment" >/dev/null
for dependency in base64 curl git jq openssl sha256sum tar; do
    command -v "${dependency}" >/dev/null || fail "${dependency} is required"
done

if "${install_system}"; then
    [[ "$(id -u)" == 0 ]] || fail "system package installation requires root"
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    mapfile -t apt_packages < <(jq -r '.apt_packages[]' "${manifest}")
    apt-get install -y --no-install-recommends "${apt_packages[@]}"
fi

mkdir -p "${tools_root}" "${environment_root}" "${repo_root}/build/linux-deps"

zig_version="$(jq -r '.toolchains.zig.version' "${manifest}")"
zig_url="$(jq -r '.toolchains.zig.url' "${manifest}")"
zig_sha="$(jq -r '.toolchains.zig.sha256' "${manifest}")"
zig_dir="${tools_root}/zig-x86_64-linux-${zig_version}"
if [[ ! -x "${zig_dir}/zig" ]] || [[ "$("${zig_dir}/zig" version)" != "${zig_version}" ]]; then
    archive="$(mktemp)"
    trap 'rm -f -- "${archive:-}"' EXIT
    curl -fsSL "${zig_url}" -o "${archive}"
    [[ "$(sha256sum "${archive}" | awk '{print $1}')" == "${zig_sha}" ]] ||
        fail "Zig archive checksum mismatch"
    rm -rf -- "${zig_dir}"
    tar -xJf "${archive}" -C "${tools_root}"
    rm -f -- "${archive}"
    trap - EXIT
fi
[[ "$("${zig_dir}/zig" version)" == "${zig_version}" ]] || fail "Zig version mismatch"

blueprint_version="$(jq -r '.toolchains.blueprint_compiler.version' "${manifest}")"
blueprint_repository="$(jq -r '.toolchains.blueprint_compiler.repository' "${manifest}")"
blueprint_revision="$(jq -r '.toolchains.blueprint_compiler.revision' "${manifest}")"
blueprint_source="${tools_root}/blueprint-compiler-source"
blueprint_prefix="${tools_root}/blueprint-compiler-${blueprint_version}"
if [[ ! -x "${blueprint_prefix}/bin/blueprint-compiler" ]] ||
    [[ "$("${blueprint_prefix}/bin/blueprint-compiler" --version)" != "${blueprint_version}" ]]; then
    rm -rf -- "${blueprint_source}" "${blueprint_prefix}"
    git clone --filter=blob:none --no-checkout "${blueprint_repository}" "${blueprint_source}"
    git -C "${blueprint_source}" fetch --depth=1 origin "${blueprint_revision}"
    git -C "${blueprint_source}" checkout --detach "${blueprint_revision}"
    [[ "$(git -C "${blueprint_source}" rev-parse HEAD)" == "${blueprint_revision}" ]] ||
        fail "Blueprint compiler revision mismatch"
    meson setup "${blueprint_source}/build" "${blueprint_source}" \
        --prefix "${blueprint_prefix}" --buildtype release
    meson install -C "${blueprint_source}/build"
fi
[[ "$("${blueprint_prefix}/bin/blueprint-compiler" --version)" == "${blueprint_version}" ]] ||
    fail "Blueprint compiler version mismatch"

rust_version="$(jq -r '.toolchains.rust.version' "${manifest}")"
rust_channel="$(jq -r '.toolchains.rust.channel' "${manifest}")"
command -v rustup >/dev/null || fail "rustup is required"
if ! rustup toolchain list | grep -Eq "^${rust_channel}(-x86_64-unknown-linux-gnu)?( \(.*\))?$"; then
    rustup toolchain install "${rust_channel}" --profile minimal --component clippy,rustfmt
fi
[[ "$(rustc +"${rust_channel}" --version | awk '{print $2}')" == "${rust_version}" ]] ||
    fail "Rust toolchain version mismatch"

fish_version="$(jq -r '.toolchains.qualification_shells.fish.version' "${manifest}")"
fish_url="$(jq -r '.toolchains.qualification_shells.fish.url' "${manifest}")"
fish_sha="$(jq -r '.toolchains.qualification_shells.fish.sha256' "${manifest}")"
fish_dir="${tools_root}/fish-${fish_version}"
if [[ ! -x "${fish_dir}/bin/fish" ]] ||
    [[ "$("${fish_dir}/bin/fish" --version)" != "fish, version ${fish_version}" ]]; then
    archive="$(mktemp)"
    trap 'rm -f -- "${archive:-}"' EXIT
    curl -fsSL "${fish_url}" -o "${archive}"
    [[ "$(sha256sum "${archive}" | awk '{print $1}')" == "${fish_sha}" ]] ||
        fail "Fish archive checksum mismatch"
    rm -rf -- "${fish_dir}"
    mkdir -p "${fish_dir}/bin"
    tar -xJf "${archive}" -C "${fish_dir}/bin"
    rm -f -- "${archive}"
    trap - EXIT
fi
[[ "$("${fish_dir}/bin/fish" --version)" == "fish, version ${fish_version}" ]] ||
    fail "Fish version mismatch"

nu_version="$(jq -r '.toolchains.qualification_shells.nu.version' "${manifest}")"
nu_url="$(jq -r '.toolchains.qualification_shells.nu.url' "${manifest}")"
nu_sha="$(jq -r '.toolchains.qualification_shells.nu.sha256' "${manifest}")"
nu_dir="${tools_root}/nu-${nu_version}"
if [[ ! -x "${nu_dir}/nu" ]] || [[ "$("${nu_dir}/nu" --version)" != "${nu_version}" ]]; then
    archive="$(mktemp)"
    trap 'rm -f -- "${archive:-}"' EXIT
    curl -fsSL "${nu_url}" -o "${archive}"
    [[ "$(sha256sum "${archive}" | awk '{print $1}')" == "${nu_sha}" ]] ||
        fail "Nushell archive checksum mismatch"
    rm -rf -- "${nu_dir}"
    mkdir -p "${nu_dir}"
    tar -xzf "${archive}" --strip-components=1 -C "${nu_dir}"
    rm -f -- "${archive}"
    trap - EXIT
fi
[[ "$("${nu_dir}/nu" --version)" == "${nu_version}" ]] || fail "Nushell version mismatch"

pnpm_version="$(jq -r '.toolchains.node.pnpm_version' "${manifest}")"
pnpm_url="$(jq -r '.toolchains.node.pnpm_url' "${manifest}")"
pnpm_integrity="$(jq -r '.toolchains.node.pnpm_integrity' "${manifest}")"
pnpm_dir="${tools_root}/pnpm-${pnpm_version}"
pnpm_bin="${pnpm_dir}/bin/pnpm.cjs"
command -v node >/dev/null || fail "Node is required"
[[ "$(node --version)" == "v$(jq -r '.toolchains.node.version' "${manifest}")" ]] ||
    fail "reviewed Node version is required"
if [[ ! -x "${pnpm_bin}" ]] || [[ "$("${pnpm_bin}" --version)" != "${pnpm_version}" ]]; then
    archive="$(mktemp)"
    trap 'rm -f -- "${archive:-}"' EXIT
    curl -fsSL "${pnpm_url}" -o "${archive}"
    actual_integrity="sha512-$(openssl dgst -sha512 -binary "${archive}" | base64 -w0)"
    [[ "${actual_integrity}" == "${pnpm_integrity}" ]] || fail "pnpm archive integrity mismatch"
    rm -rf -- "${pnpm_dir}"
    mkdir -p "${pnpm_dir}"
    tar -xzf "${archive}" --strip-components=1 -C "${pnpm_dir}"
    chmod 0755 "${pnpm_bin}" "${pnpm_dir}/bin/pnpx.cjs"
    rm -f -- "${archive}"
    trap - EXIT
fi
ln -sfn pnpm.cjs "${pnpm_dir}/bin/pnpm"
ln -sfn pnpx.cjs "${pnpm_dir}/bin/pnpx"
[[ "$("${pnpm_dir}/bin/pnpm" --version)" == "${pnpm_version}" ]] ||
    fail "pnpm command shim is not reviewed"
(
    cd "${repo_root}/linux/ci/node-tools"
    "${pnpm_bin}" install --frozen-lockfile
)

claude_version="$(jq -r '.reviewed_agent_clis.claude.version' "${manifest}")"
claude_url="$(jq -r '.reviewed_agent_clis.claude.url' "${manifest}")"
claude_sha="$(jq -r '.reviewed_agent_clis.claude.sha256' "${manifest}")"
claude_size="$(jq -r '.reviewed_agent_clis.claude.size_bytes' "${manifest}")"
claude_dir="${HOME}/.local/share/claude/versions"
claude_binary="${claude_dir}/${claude_version}"
mkdir -p "${claude_dir}" "${HOME}/.local/bin"
if [[ ! -f "${claude_binary}" ]] || [[ "$(sha256sum "${claude_binary}" | awk '{print $1}')" != "${claude_sha}" ]]; then
    rm -f -- "${claude_binary}"
    curl -fsSL "${claude_url}" -o "${claude_binary}"
fi
[[ "$(stat -c %s "${claude_binary}")" == "${claude_size}" ]] || fail "Claude binary size mismatch"
[[ "$(sha256sum "${claude_binary}" | awk '{print $1}')" == "${claude_sha}" ]] ||
    fail "Claude binary checksum mismatch"
[[ -x "${claude_binary}" ]] || chmod 0755 "${claude_binary}"
if [[ "$(readlink -f "${HOME}/.local/bin/claude" 2>/dev/null || true)" != "${claude_binary}" ]]; then
    ln -sfn "${claude_binary}" "${HOME}/.local/bin/claude"
fi

cat >"${environment_root}/environment.sh" <<EOF
export ZIG='${zig_dir}/zig'
export BLUEPRINT_COMPILER_DIR='${blueprint_prefix}/bin'
export ZENTTY_PNPM='${pnpm_bin}'
export ZENTTY_TEST_FISH='${fish_dir}/bin/fish'
export ZENTTY_TEST_NU='${nu_dir}/nu'
export CARGO_HOME='${CARGO_HOME:-${HOME}/.cargo}'
export RUSTUP_HOME='${RUSTUP_HOME:-${HOME}/.rustup}'
export PATH='${repo_root}/linux/ci/node-tools/node_modules/.bin:${pnpm_dir}/bin:${HOME}/.local/bin':\$PATH
export LANG='C.UTF-8'
export LC_ALL='C.UTF-8'
export TZ='UTC'
export XKB_DEFAULT_LAYOUT='us'
export LIBGL_ALWAYS_SOFTWARE='1'
export GALLIUM_DRIVER='llvmpipe'
export GSETTINGS_BACKEND='memory'
export GIO_USE_VFS='local'
EOF

echo "bootstrap-ubuntu-24.04: PASS tools=${tools_root} environment=${environment_root}/environment.sh"
