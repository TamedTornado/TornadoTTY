#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
ghostty_source="${1:?usage: collect-package-notices GHOSTTY_SOURCE OUTPUT_DIR}"
output="${2:?usage: collect-package-notices GHOSTTY_SOURCE OUTPUT_DIR}"
manifest="${repo_root}/linux/packaging/ghostty-notices-v1.json"

fail() {
    echo "collect-package-notices: error: $*" >&2
    exit 1
}

jq -e '
  .schema_version == 1 and .status == "RATIFIED" and
  (.components | length > 0) and
  all(.components[];
    (.name | type == "string" and length > 0) and
    (.license | type == "string" and length > 0) and
    (.notice | test("^[A-Za-z0-9._+-]+$")) and
    ([has("source"), has("system_source"), has("project_source")] |
      map(select(.)) | length == 1)) and
  (.embedded_notice_only | length > 0) and
  all(.embedded_notice_only[];
    (.name | test("^[A-Za-z0-9._+-]+$")) and
    (.license | type == "string" and length > 0) and
    (.evidence | test("^[A-Za-z0-9._+/-]+$") and
      (startswith("/") | not) and (contains("..") | not)))' "${manifest}" >/dev/null ||
    fail "Ghostty notice manifest is invalid"

rm -rf -- "${output}"
mkdir -p -- "${output}/ghostty" "${output}/cargo"

while IFS=$'\t' read -r name license notice source_kind source; do
    case "${source_kind}" in
        source) source_path="${ghostty_source}/${source}" ;;
        system_source) source_path="${source}" ;;
        project_source) source_path="${repo_root}/${source}" ;;
        *) fail "unsupported source kind for ${name}" ;;
    esac
    [[ -f "${source_path}" ]] || fail "notice source is missing for ${name}: ${source_path}"
    install -m 0644 "${source_path}" "${output}/ghostty/${notice}"
    jq -cn --arg name "${name}" --arg license "${license}" \
        --arg notice "ghostty/${notice}" \
        '{name:$name,license:$license,notice:$notice}'
done < <(jq -r '.components[] |
  if has("source") then [.name,.license,.notice,"source",.source]
  elif has("system_source") then [.name,.license,.notice,"system_source",.system_source]
  else [.name,.license,.notice,"project_source",.project_source] end | @tsv' "${manifest}") |
    jq -s '{schema_version:1,ecosystem:"ghostty-zig",components:.}' \
        >"${output}/ghostty-components.json"

cargo_metadata="${output}/cargo-metadata.json"
host_target="$(rustc -vV | sed -n 's/^host: //p')"
[[ "${host_target}" =~ ^[A-Za-z0-9_.-]+$ ]] ||
    fail "could not determine the Rust host target"
# A Linux package ships only the dependency closure selected for its target.
# Without --filter-platform, Cargo also resolves target-specific crates for
# other operating systems and an otherwise complete clean Linux build can fail
# here merely because (for example) a Windows-only crate was never downloaded.
cargo metadata --locked --offline --format-version 1 \
    --filter-platform "${host_target}" >"${cargo_metadata}"
jq -e 'all(.packages[] | select(.source != null); .license != null or .license_file != null)' \
    "${cargo_metadata}" >/dev/null || fail "a Cargo dependency lacks license metadata"

jq '[.packages[] | select(.source != null) |
  {name,version,source,license,license_file,repository}] |
  sort_by(.name,.version,.source)' "${cargo_metadata}" >"${output}/cargo-packages.json"

while IFS=$'\t' read -r name version manifest_path license_file; do
    package_root="${manifest_path%/*}"
    destination="${output}/cargo/${name}-${version}"
    mkdir -p -- "${destination}"
    copied=0
    while IFS= read -r license_path; do
        install -m 0644 "${license_path}" "${destination}/$(basename "${license_path}")"
        copied=$((copied + 1))
    done < <(find "${package_root}" -maxdepth 1 -type f \
        \( -iname 'LICENSE*' -o -iname 'COPYING*' -o -iname 'NOTICE*' \) \
        -print | LC_ALL=C sort)
    if [[ "${copied}" -eq 0 && -n "${license_file}" ]]; then
        license_path="${package_root}/${license_file}"
        [[ -f "${license_path}" ]] || fail "Cargo license file is missing for ${name} ${version}"
        install -m 0644 "${license_path}" "${destination}/$(basename "${license_path}")"
        copied=1
    fi
    [[ "${copied}" -gt 0 ]] || fail "Cargo notice text is missing for ${name} ${version}"
done < <(jq -r '.packages[] | select(.source != null) |
    [.name,.version,.manifest_path,(.license_file // "")] | @tsv' "${cargo_metadata}")

rm -- "${cargo_metadata}"
install -m 0644 "${repo_root}/linux/packaging/notices/embedded-code-NOTICE" \
    "${output}/ghostty/embedded-code-NOTICE"
install -m 0644 "${repo_root}/linux/packaging/notices/Apache-2.0" \
    "${output}/ghostty/Apache-2.0"

zentty_revision="$(git -C "${repo_root}" rev-parse HEAD)"
ghostty_revision="$(git -C "${ghostty_source}" rev-parse HEAD)"
zentty_repository="$(cargo metadata --locked --offline --no-deps --format-version 1 |
    jq -er '.packages[] | select(.name == "zentty-linux") | .repository')"
ghostty_repository="$(sed -n 's/^repo=//p' "${repo_root}/linux/ghostty.lock")"
zentty_repository="${zentty_repository%.git}"
ghostty_repository="${ghostty_repository%.git}"
[[ "${zentty_revision}" =~ ^[0-9a-f]{40}$ &&
   "${ghostty_revision}" =~ ^[0-9a-f]{40}$ ]] ||
    fail "catalog source revisions are invalid"
[[ "${zentty_repository}" =~ ^https://github\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ &&
   "${ghostty_repository}" =~ ^https://github\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] ||
    fail "catalog source repositories are not reviewed HTTPS GitHub origins"

jq -n \
    --slurpfile cargo "${output}/cargo-packages.json" \
    --slurpfile ghostty "${output}/ghostty-components.json" \
    --slurpfile notice_manifest "${manifest}" \
    --arg zentty_revision "${zentty_revision}" \
    --arg ghostty_revision "${ghostty_revision}" \
    --arg zentty_repository "${zentty_repository}" \
    --arg ghostty_repository "${ghostty_repository}" '
  def https_repository_or_crate:
    if (.repository | type) == "string" and
       (.repository | test("^https://[A-Za-z0-9._~:/?#@!$&()*+,;=%-]+$"))
    then .repository
    else "https://crates.io/crates/\(.name)/\(.version)"
    end;
  {
    schema_version:1,
    generated_from:{
      zentty:{repository:$zentty_repository,revision:$zentty_revision},
      ghostty:{repository:$ghostty_repository,revision:$ghostty_revision}
    },
    entries:(
      ($cargo[0] | map({
        id:("cargo/" + .name + "/" + .version),
        ecosystem:"cargo",
        display_name:.name,
        version:.version,
        license:(.license // ("License file: " + .license_file)),
        source_url:https_repository_or_crate,
        homepage_url:(if (.repository | type) == "string" and
          (.repository | startswith("https://")) then .repository else null end),
        notice:{kind:"directory",path:("cargo/" + .name + "-" + .version)}
      })) +
      ($ghostty[0].components | map({
        id:("ghostty/" + .name),
        ecosystem:"ghostty-zig",
        display_name:.name,
        version:$ghostty_revision,
        license:.license,
        source_url:(if .name == "ghostty" then
          $ghostty_repository + "/tree/" + $ghostty_revision
        else $ghostty_repository + "/blob/" + $ghostty_revision + "/build.zig.zon" end),
        homepage_url:(if .name == "ghostty" then "https://ghostty.org" else null end),
        notice:{kind:"file",path:.notice}
      })) +
      ($notice_manifest[0].embedded_notice_only | map({
        id:("ghostty-embedded/" + .name),
        ecosystem:"ghostty-embedded",
        display_name:.name,
        version:$ghostty_revision,
        license:.license,
        source_url:($ghostty_repository + "/blob/" + $ghostty_revision + "/" + .evidence),
        homepage_url:null,
        notice:{kind:"file",path:"ghostty/embedded-code-NOTICE"}
      }))
    ) | sort_by(.display_name,.version,.id)
  }' >"${output}/catalog-v1.json"

jq -e '
  .schema_version == 1 and
  (.generated_from.zentty.revision | test("^[0-9a-f]{40}$")) and
  (.generated_from.ghostty.revision | test("^[0-9a-f]{40}$")) and
  (.entries | length > 0) and
  ([.entries[].id] | length == (unique | length)) and
  all(.entries[];
    (.id | test("^[A-Za-z0-9._+/-]+$")) and
    (.display_name | type == "string" and length > 0) and
    (.version | type == "string" and length > 0) and
    (.license | type == "string" and length > 0) and
    (.source_url | startswith("https://")) and
    (.homepage_url == null or (.homepage_url | startswith("https://"))) and
    (.notice.kind == "file" or .notice.kind == "directory") and
    (.notice.path | test("^[A-Za-z0-9._+/-]+$") and
      (startswith("/") | not) and (contains("..") | not)))
' "${output}/catalog-v1.json" >/dev/null || fail "UI license catalog is invalid"

echo "collect-package-notices: PASS cargo=$(jq 'length' "${output}/cargo-packages.json") ghostty=$(jq '.components | length' "${output}/ghostty-components.json") catalog=$(jq '.entries | length' "${output}/catalog-v1.json")"
