#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
lock_file="${repo_root}/linux/ghostty.lock"
ghostty_repo="$(sed -n 's/^repo=//p' "${lock_file}")"
ghostty_revision="$(sed -n 's/^revision=//p' "${lock_file}")"
ghostty_source="${GHOSTTY_SOURCE_DIR:-${repo_root}/build/linux-deps/ghostty}"
zig="${ZIG:-${repo_root}/../.tools/zig-x86_64-linux-0.15.2/zig}"
blueprint_dir="${BLUEPRINT_COMPILER_DIR:-${repo_root}/../.tools/blueprint-compiler-0.16.0/bin}"
output_dir="${repo_root}/build/linux"
optimize="${GHOSTTY_OPTIMIZE:-ReleaseSafe}"

if [[ ! -x "${zig}" ]]; then
    echo "error: Zig 0.15.2 not found at ${zig}" >&2
    exit 1
fi
if [[ -z "${ghostty_repo}" || -z "${ghostty_revision}" ]]; then
    echo "error: invalid Ghostty lock file: ${lock_file}" >&2
    exit 1
fi
if [[ -z "${GHOSTTY_SOURCE_DIR:-}" ]]; then
    if [[ ! -d "${ghostty_source}/.git" ]]; then
        mkdir -p "$(dirname "${ghostty_source}")"
        git clone --filter=blob:none --no-checkout \
            "${ghostty_repo}" "${ghostty_source}"
    fi
    git -C "${ghostty_source}" fetch origin "${ghostty_revision}"
    git -C "${ghostty_source}" checkout --detach "${ghostty_revision}"
elif [[ ! -d "${ghostty_source}/.git" ]]; then
    echo "error: GHOSTTY_SOURCE_DIR is not a Git checkout: ${ghostty_source}" >&2
    exit 1
fi

actual_revision="$(git -C "${ghostty_source}" rev-parse HEAD)"
if [[ "${actual_revision}" != "${ghostty_revision}" ]]; then
    echo "error: Ghostty checkout is ${actual_revision}; expected ${ghostty_revision}" >&2
    exit 1
fi

(
    cd "${ghostty_source}"
    PATH="${blueprint_dir}:$(dirname "${zig}"):${PATH}" \
        "${zig}" build \
        gtk-embed-lib \
        -Doptimize="${optimize}" \
        -Dcpu=baseline \
        -fno-sys=gtk4-layer-shell
)

mkdir -p "${output_dir}/bin" "${output_dir}/lib"
cp "${ghostty_source}/zig-out/lib/libghostty-gtk-embed.so" "${output_dir}/lib/"
layer_shell_library="$(
    ldd "${ghostty_source}/zig-out/lib/libghostty-gtk-embed.so" |
        awk '/libgtk4-layer-shell\.so => \/.*/ { print $3; exit }'
)"
if [[ -z "${layer_shell_library}" || ! -f "${layer_shell_library}" ]]; then
    layer_shell_runpath="$(
        readelf -d "${ghostty_source}/zig-out/lib/libghostty-gtk-embed.so" |
            awk -F'[][]' '/RUNPATH/ { print $2; exit }' |
            cut -d: -f1
    )"
    layer_shell_library="${ghostty_source}/${layer_shell_runpath}/libgtk4-layer-shell.so"
fi
if [[ -z "${layer_shell_library}" || ! -f "${layer_shell_library}" ]]; then
    echo "error: Ghostty GTK layer-shell dependency was not found" >&2
    exit 1
fi
cp "${layer_shell_library}" "${output_dir}/lib/"

cc \
    -std=c17 \
    -Wall \
    -Wextra \
    -Werror \
    -I"${ghostty_source}/zig-out/include" \
    "${repo_root}/linux/src/main.c" \
    -L"${output_dir}/lib" \
    -Wl,-rpath-link,"${output_dir}/lib" \
    -Wl,--disable-new-dtags,-rpath,'$ORIGIN/../lib' \
    -lghostty-gtk-embed \
    $(pkg-config --cflags --libs gtk4) \
    -o "${output_dir}/bin/zentty-linux"

cc \
    -std=c17 \
    -Wall \
    -Wextra \
    -Werror \
    -I"${ghostty_source}/zig-out/include" \
    "${repo_root}/linux/tests/api-contract.c" \
    -L"${output_dir}/lib" \
    -Wl,-rpath-link,"${output_dir}/lib" \
    -Wl,--disable-new-dtags,-rpath,'$ORIGIN/../lib' \
    -lghostty-gtk-embed \
    -o "${output_dir}/bin/api-contract"

printf 'ghostty_source=%s\nghostty_revision=%s\noptimize=%s\n' \
    "${ghostty_source}" \
    "${ghostty_revision}" \
    "${optimize}" \
    >"${output_dir}/build-metadata"

echo "Built ${output_dir}/bin/zentty-linux"
