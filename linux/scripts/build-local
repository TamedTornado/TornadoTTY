#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
lock_file="${repo_root}/linux/ghostty.lock"
ghostty_repo="$(sed -n 's/^repo=//p' "${lock_file}")"
ghostty_revision="$(sed -n 's/^revision=//p' "${lock_file}")"
ghostty_source="${GHOSTTY_SOURCE_DIR:-${repo_root}/build/linux-deps/ghostty}"
zig="${ZIG:-${repo_root}/../.tools/zig-x86_64-linux-0.16.0/zig}"
blueprint_dir="${BLUEPRINT_COMPILER_DIR:-${repo_root}/../.tools/blueprint-compiler-0.16.0/bin}"
zig_global_cache="${repo_root}/build/linux-deps/zig-global-cache"
zig_local_cache="${ghostty_source}/.zig-cache"
output_dir="${ZENTTY_BUILD_OUTPUT_DIR:-${repo_root}/build/linux}"
if [[ "${output_dir}" != /* ]]; then
    output_dir="${repo_root}/${output_dir}"
fi
ghostty_install_dir="${ZENTTY_GHOSTTY_INSTALL_DIR:-${ghostty_source}/zig-out}"
if [[ "${ghostty_install_dir}" != /* ]]; then
    ghostty_install_dir="${repo_root}/${ghostty_install_dir}"
fi
optimize="${GHOSTTY_OPTIMIZE:-ReleaseSafe}"
c_probe_flags=(
    -std=c17
    -Wall
    -Wextra
    -Werror
    -Wconversion
    -Wshadow
    -Wformat=2
    -Wstrict-prototypes
    -Wmissing-prototypes
    -fanalyzer
    -fstack-protector-strong
    -fPIE
)
c_probe_link_flags=(
    -pie
    "-Wl,-z,relro"
    "-Wl,-z,now"
    "-Wl,-z,noexecstack"
)
gtk4_flags_text="$(pkg-config --cflags --libs gtk4)"
read -r -a gtk4_flags <<<"${gtk4_flags_text}"
if [[ "${optimize}" == "Debug" ]]; then
    c_probe_flags+=(-O0 -g3)
    cargo_profile="debug"
    probe_profile="debug"
    cargo_arguments=(build --workspace --locked)
else
    c_probe_flags+=(-O2 -g -DNDEBUG -D_FORTIFY_SOURCE=3)
    cargo_profile="release-safe"
    probe_profile="release"
    cargo_arguments=(build --workspace --locked --profile release-safe)
fi

if [[ ! -x "${zig}" ]]; then
    echo "error: Zig 0.16.0 not found at ${zig}" >&2
    exit 1
fi
if [[ ! "${ghostty_repo}" =~ ^https://github\.com/[^/]+/[^/]+\.git$ ]] ||
    [[ ! "${ghostty_revision}" =~ ^[0-9a-f]{40}$ ]]; then
    echo "error: invalid Ghostty lock file: ${lock_file}" >&2
    exit 1
fi
if [[ "${ZENTTY_GHOSTTY_PREPARED:-false}" != "true" ]]; then
    if [[ -n "${GHOSTTY_SOURCE_DIR:-}" ]]; then
        GHOSTTY_SOURCE_DIR="${ghostty_source}" \
            "${repo_root}/linux/scripts/prepare-ghostty-source"
    else
        "${repo_root}/linux/scripts/prepare-ghostty-source"
    fi
elif [[ ! -e "${ghostty_source}/.git" ]]; then
    echo "error: prepared Ghostty source is not a Git checkout: ${ghostty_source}" >&2
    exit 1
fi

mkdir -p "${zig_global_cache}" "${zig_local_cache}" "${ghostty_install_dir}"

actual_revision="$(git -C "${ghostty_source}" rev-parse HEAD)"
if [[ "${actual_revision}" != "${ghostty_revision}" ]]; then
    echo "error: Ghostty checkout is ${actual_revision}; expected ${ghostty_revision}" >&2
    exit 1
fi
ghostty_tree="clean"
if [[ -n "$(git -C "${ghostty_source}" status --porcelain)" ]]; then
    ghostty_tree="dirty"
fi
zentty_revision="$(git -C "${repo_root}" rev-parse --short=12 HEAD)"
if [[ ! "${zentty_revision}" =~ ^[0-9a-f]{12}$ ]]; then
    echo "error: invalid Zentty revision: ${zentty_revision}" >&2
    exit 1
fi

(
    cd "${ghostty_source}"
    PATH="${blueprint_dir}:$(dirname "${zig}"):${PATH}" \
        ZIG_GLOBAL_CACHE_DIR="${zig_global_cache}" \
        ZIG_LOCAL_CACHE_DIR="${zig_local_cache}" \
        "${zig}" build \
        gtk-embed-lib \
        --prefix "${ghostty_install_dir}" \
        -Doptimize="${optimize}" \
        -Dcpu=baseline \
        -fno-sys=gtk4-layer-shell
)

mkdir -p "${output_dir}/bin" "${output_dir}/lib"
cp "${ghostty_install_dir}/lib/libghostty-gtk-embed.so" "${output_dir}/lib/"
layer_shell_library="$(
    ldd "${ghostty_install_dir}/lib/libghostty-gtk-embed.so" |
        awk '/libgtk4-layer-shell\.so => \/.*/ { print $3; exit }'
)"
if [[ -z "${layer_shell_library}" || ! -f "${layer_shell_library}" ]]; then
    layer_shell_runpath="$(
        readelf -d "${ghostty_install_dir}/lib/libghostty-gtk-embed.so" |
            awk -F'[][]' '/RUNPATH/ { print $2; exit }' |
            cut -d: -f1
    )"
    layer_shell_library="${ghostty_source}/${layer_shell_runpath}/libgtk4-layer-shell.so"
fi
if [[ -z "${layer_shell_library}" || ! -f "${layer_shell_library}" ]]; then
    echo "error: Ghostty GTK layer-shell dependency was not found" >&2
    exit 1
fi
cp "${layer_shell_library}" "${output_dir}/lib/"

GHOSTTY_LIB_DIR="${ghostty_install_dir}/lib" \
    ZENTTY_BUILD_COMMIT="${zentty_revision}" \
    cargo "${cargo_arguments[@]}"
cp "${repo_root}/target/${cargo_profile}/zentty-linux" \
    "${output_dir}/bin/zentty-linux"
cp "${repo_root}/target/${cargo_profile}/zentty" \
    "${output_dir}/bin/zentty"
wrapper_root="${output_dir}/libexec/zentty/agent-wrappers"
rm -rf "${wrapper_root}"
mkdir -p "${wrapper_root}/shared"
cp "${output_dir}/bin/zentty" "${wrapper_root}/shared/zentty"
for tool in claude codex gemini; do
    mkdir -p "${wrapper_root}/${tool}"
    cp "${repo_root}/ZenttyResources/bin/shared/zentty-agent-wrapper" \
        "${wrapper_root}/${tool}/${tool}"
done
tmux_shim_root="${output_dir}/libexec/zentty/tmux-shim"
rm -rf "${tmux_shim_root}"
mkdir -p "${tmux_shim_root}"
cp "${repo_root}/ZenttyResources/bin/tmux-shim/tmux" \
    "${tmux_shim_root}/tmux"
chmod 0755 "${tmux_shim_root}/tmux"
shell_integration_root="${output_dir}/share/zentty/shell-integration"
rm -rf "${shell_integration_root}"
mkdir -p "${shell_integration_root}"
cp -a "${repo_root}/ZenttyResources/shell-integration/." \
    "${shell_integration_root}/"
ghostty_theme_root="${output_dir}/share/zentty/ghostty/themes"
rm -rf "${ghostty_theme_root}"
mkdir -p "${ghostty_theme_root}"
cp -a "${repo_root}/ZenttyResources/ghostty/themes/." "${ghostty_theme_root}/"
amp_plugin_root="${output_dir}/share/zentty/amp/plugins"
rm -rf "${amp_plugin_root}"
mkdir -p "${amp_plugin_root}"
cp "${repo_root}/ZenttyResources/amp/plugins/zentty-amp-zentty.ts" \
    "${amp_plugin_root}/"

# The linker must receive the literal loader token, not a shell expansion.
# shellcheck disable=SC2016
cc \
    "${c_probe_flags[@]}" \
    -I"${ghostty_install_dir}/include" \
    "${repo_root}/linux/tests/api-contract.c" \
    -L"${output_dir}/lib" \
    -Wl,-rpath-link,"${output_dir}/lib" \
    -Wl,--disable-new-dtags,-rpath,'$ORIGIN/../lib' \
    -lghostty-gtk-embed \
    "${gtk4_flags[@]}" \
    "${c_probe_link_flags[@]}" \
    -o "${output_dir}/bin/api-contract"

# This remains a separate executable because each initialization order must
# start with untouched Ghostty/GTK process-global state.
# The linker must receive the literal loader token, not a shell expansion.
# shellcheck disable=SC2016
cc \
    "${c_probe_flags[@]}" \
    -I"${ghostty_install_dir}/include" \
    "${repo_root}/linux/tests/runtime-init-order.c" \
    -L"${output_dir}/lib" \
    -Wl,-rpath-link,"${output_dir}/lib" \
    -Wl,--disable-new-dtags,-rpath,'$ORIGIN/../lib' \
    -lghostty-gtk-embed \
    "${gtk4_flags[@]}" \
    "${c_probe_link_flags[@]}" \
    -o "${output_dir}/bin/runtime-init-order"

cc \
    "${c_probe_flags[@]}" \
    "${repo_root}/linux/tests/ibus-focus-reproducer.c" \
    "${gtk4_flags[@]}" \
    "${c_probe_link_flags[@]}" \
    -o "${output_dir}/bin/ibus-focus-reproducer"

c++ \
    -std=c++17 \
    -Wall \
    -Wextra \
    -Werror \
    -Wpedantic \
    -fsyntax-only \
    -I"${ghostty_install_dir}/include" \
    "${repo_root}/linux/tests/api-header-cpp.cc"

printf 'ghostty_source=%s\nghostty_revision=%s\nghostty_tree=%s\nzentty_revision=%s\noptimize=%s\nproduct_profile=%s\nprobe_profile=%s\nibus_focus_reproducer_sha256=%s\n' \
    "${ghostty_source}" \
    "${ghostty_revision}" \
    "${ghostty_tree}" \
    "${zentty_revision}" \
    "${optimize}" \
    "${cargo_profile}" \
    "${probe_profile}" \
    "$(sha256sum "${repo_root}/linux/tests/ibus-focus-reproducer.c" | awk '{print $1}')" \
    >"${output_dir}/build-metadata"

profile_bundle="${repo_root}/build/linux-profiles/${cargo_profile}"
if [[ "$(readlink -m -- "${output_dir}")" != "$(readlink -m -- "${profile_bundle}")" ]]; then
    rm -rf -- "${profile_bundle}"
    mkdir -p "${profile_bundle}"
    for entry in bin lib libexec share build-metadata; do
        cp -a "${output_dir}/${entry}" "${profile_bundle}/${entry}"
    done
fi

echo "Built ${output_dir}/bin/zentty-linux"
