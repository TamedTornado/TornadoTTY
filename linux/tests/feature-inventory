#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
inventory="${1:-${repo_root}/docs/design/zentty-linux-feature-inventory.json}"
evidence="${2:-${repo_root}/docs/design/zentty-feature-evidence-2026-08-04.json}"
summary_path="${3:-}"

fail() {
    echo "feature-inventory: error: $*" >&2
    exit 1
}

command -v jq >/dev/null || fail "jq is required"
[[ -f "${inventory}" ]] || fail "inventory not found: ${inventory}"
jq empty "${inventory}" 2>/dev/null || fail "inventory is not valid JSON"
[[ -f "${evidence}" ]] || fail "evidence ledger not found: ${evidence}"
jq empty "${evidence}" 2>/dev/null || fail "evidence ledger is not valid JSON"

jq -e '
    .schema_version == 1 and
    (.scope | type == "string" and length > 0) and
    (.entries | type == "array" and length > 0) and
    all(.entries[];
        (.id | type == "string" and test("^[a-z0-9]+([.-][a-z0-9]+)*$")) and
        (.category | IN(
            "workspace_session", "worklanes", "panes", "command_routing", "coding_agents",
            "terminal_foundation", "application_shell", "search_clipboard", "project_context",
            "project_utilities", "configuration", "desktop_integration", "cli_shell",
            "lifecycle_trust"
        )) and
        (.behavior | type == "string" and length > 0) and
        (.source | type == "array" and length > 0) and
        (.swift_tests | type == "array" and length > 0) and
        (.classification | IN("REQUIRED_INITIAL_RELEASE", "REQUIRED_LATER", "PLATFORM_ALTERNATIVE", "NOT_APPLICABLE", "BLOCKED")) and
        (.origin | IN("PORT_PARITY", "LINUX_NECESSITY")) and
        (.user_impact | type == "string" and length > 0) and
        (.linux_owner_issue | type == "number" and . > 0 and floor == .) and
        (.implementation_status | IN("IMPLEMENTED", "PARTIAL", "MODEL_ONLY", "NOT_IMPLEMENTED", "BLOCKED")) and
        (.focused_tests | type == "array") and
        (.product_scenarios | type == "array") and
        (.test_plan | type == "string" and length > 0) and
        (if .implementation_status == "IMPLEMENTED"
         then (.focused_tests | length > 0) and (.product_scenarios | length > 0)
         else true
         end) and
        (if (.classification == "PLATFORM_ALTERNATIVE" or .classification == "BLOCKED")
         then (.alternative_or_blocker | type == "string" and length > 0)
         else .alternative_or_blocker == null
         end)
    )
' "${inventory}" >/dev/null || fail "inventory schema or enum contract failed"

duplicate_ids="$(jq -r '.entries[].id' "${inventory}" | LC_ALL=C sort | uniq -d)"
[[ -z "${duplicate_ids}" ]] || fail "duplicate IDs: ${duplicate_ids//$'\n'/, }"

while IFS= read -r relative_path; do
    [[ "${relative_path}" != /* && "${relative_path}" != *".."* ]] ||
        fail "unsafe repository path: ${relative_path}"
    [[ -f "${repo_root}/${relative_path}" ]] || fail "referenced file is missing: ${relative_path}"
done < <(jq -r '.entries[] | .source[], .swift_tests[], .focused_tests[], .product_scenarios[]' "${inventory}" | LC_ALL=C sort -u)

expected_agents=(
    amp antigravity claude-code codex copilot cursor custom droid gemini grok
    hermes kimi omp opencode pi small-harness vibe
)
for agent in "${expected_agents[@]}"; do
    count="$(jq --arg id "agent.${agent}" '[.entries[] | select(.id == $id)] | length' "${inventory}")"
    [[ "${count}" == 1 ]] || fail "agent ${agent} must have exactly one individual inventory entry"
done

jq -e '
    .schema_version == 1 and
    (.audit_date | type == "string" and length > 0) and
    (.source_head | type == "string" and test("^[0-9a-f]{40}$")) and
    (.latest_public_release | type == "string" and length > 0) and
    (.linux_issues | type == "array" and length > 0) and
    (.public_release_tags | type == "array" and length > 0) and
    (.release_feature_map | type == "array" and length > 0) and
    (.first_party_documents | type == "array" and length > 0) and
    (.screenshots | type == "array" and length > 0) and
    (.external_discussions | type == "array" and length > 0) and
    (.source_coverage | type == "array" and length > 0) and
    (.root_source_files | type == "array" and length > 0) and
    (.test_coverage | type == "array" and length > 0) and
    (.test_infrastructure_exclusions | type == "array") and
    all(.linux_issues[];
        (.number | type == "number" and . > 0 and floor == .) and
        (.state | IN("OPEN", "CLOSED")) and
        (.depends_on | type == "array" and all(.[]; type == "number" and . > 0 and floor == .)) and
        (.features | type == "array" and all(.[]; type == "string" and length > 0)) and
        (.title | type == "string" and length > 0) and
        (.url | type == "string" and test("^https://github\\.com/TamedTornado/zentty/issues/[0-9]+$"))
    ) and
    (.command_registry.location | type == "string" and length > 0) and
    (.command_registry.commands | type == "object" and length > 0) and
    all(.command_registry.commands | to_entries[];
        (.key | type == "string" and length > 0) and
        (.value | type == "string" and length > 0)
    ) and
    (.pane_command_registry.location | type == "string" and length > 0) and
    (.pane_command_registry.commands | type == "object" and length > 0) and
    all(.pane_command_registry.commands | to_entries[];
        (.key | type == "string" and test("^[A-Za-z][A-Za-z0-9]*$")) and
        (.value | type == "string" and length > 0)
    ) and
    (.settings_registry.location | type == "string" and length > 0) and
    (.settings_registry.sections | type == "object" and length > 0) and
    all(.settings_registry.sections | to_entries[];
        (.key | type == "string" and length > 0) and
        (.value | type == "string" and length > 0)
    ) and
    (.cli_registry.directory | type == "string" and length > 0) and
    (.cli_registry.commands | type == "object" and length > 0) and
    all(.cli_registry.commands | to_entries[];
        (.key | type == "string" and test("^[A-Za-z][A-Za-z0-9]*$")) and
        (.value | type == "string" and length > 0)
    ) and
    all(.first_party_documents[];
        (.id | type == "string" and length > 0) and
        (.location | type == "string" and length > 0) and
        (.features | type == "array" and length > 0)
    ) and
    all(.screenshots[];
        (.id | type == "string" and length > 0) and
        (.location | type == "string" and length > 0) and
        (.observations | type == "array" and length > 0) and
        (.features | type == "array" and length > 0)
    ) and
    all(.external_discussions[];
        (.id | type == "string" and length > 0) and
        (.location | type == "string" and startswith("https://")) and
        (.role | IN("workflow_corroboration", "risk_corroboration")) and
        (.features | type == "array" and length > 0)
    ) and
    all(.source_coverage[];
        (.directory | type == "string" and startswith("Zentty")) and
        ((.recursive == false) or (.directory | IN("Zentty", "Zentty/UI", "Zentty/AppState") | not)) and
        (.recursive | type == "boolean") and
        (.features | type == "array" and length > 0)
    ) and
    all(.release_feature_map[];
        (.tag | type == "string" and length > 0) and
        (.features | type == "array" and length > 0)
    ) and
    all(.root_source_files[];
        (.path | type == "string" and startswith("Zentty/") and endswith(".swift")) and
        (.features | type == "array" and length > 0)
    ) and
    all(.test_coverage[];
        (.path | type == "string" and test("^Zentty(Logic|Integration)Tests/.+\\.swift$")) and
        (.features | type == "array" and length > 0)
    ) and
    all(.test_infrastructure_exclusions[];
        (.path | type == "string" and test("^Zentty(Logic|Integration)Tests/.+\\.swift$")) and
        (.reason | type == "string" and length > 20)
    )
' "${evidence}" >/dev/null || fail "evidence ledger schema failed"

duplicate_issue_numbers="$(jq -r '.linux_issues[].number' "${evidence}" | LC_ALL=C sort -n | uniq -d)"
[[ -z "${duplicate_issue_numbers}" ]] ||
    fail "duplicate Linux issue numbers: ${duplicate_issue_numbers//$'\n'/, }"

declare -A issue_state_set=()
while IFS=$'\t' read -r issue_number issue_state; do
    issue_state_set["${issue_number}"]="${issue_state}"
done < <(jq -r '.linux_issues[] | [.number, .state] | @tsv' "${evidence}")
while IFS=$'\t' read -r owner_issue implementation_status; do
    [[ -n "${issue_state_set[${owner_issue}]:-}" ]] ||
        fail "feature references nonexistent owner issue: ${owner_issue}"
    [[ "${issue_state_set[${owner_issue}]}" == OPEN || "${implementation_status}" == IMPLEMENTED ]] ||
        fail "feature references closed owner issue: ${owner_issue}"
done < <(jq -r '.entries[] | [.linux_owner_issue, .implementation_status] | @tsv' "${inventory}" | LC_ALL=C sort -u)
while IFS= read -r dependency_issue; do
    [[ -n "${issue_state_set[${dependency_issue}]:-}" ]] ||
        fail "issue dependency is absent from the reviewed ledger: ${dependency_issue}"
done < <(jq -r '.linux_issues[].depends_on[]' "${evidence}" | LC_ALL=C sort -nu)

inventory_owner_pairs="$(jq -r '.entries[] | [.linux_owner_issue, .id] | @tsv' "${inventory}" | LC_ALL=C sort -n -k1,1 -k2,2)"
ledger_owner_pairs="$(jq -r '.linux_issues[] as $issue | $issue.features[] | [$issue.number, .] | @tsv' "${evidence}" | LC_ALL=C sort -n -k1,1 -k2,2)"
[[ "${inventory_owner_pairs}" == "${ledger_owner_pairs}" ]] ||
    fail "feature owner assignment drifted from the reviewed issue ledger"

declare -A inventory_id_set=()
while IFS= read -r feature_id; do
    inventory_id_set["${feature_id}"]=1
done < <(jq -r '.entries[].id' "${inventory}")
while IFS= read -r feature_id; do
    [[ -n "${inventory_id_set[${feature_id}]:-}" ]] ||
        fail "evidence references unknown feature: ${feature_id}"
done < <(jq -r '
    .first_party_documents[].features[],
    .screenshots[].features[],
    .external_discussions[].features[],
    .release_feature_map[].features[],
    .linux_issues[].features[],
    .source_coverage[].features[],
    .root_source_files[].features[],
    .test_coverage[].features[],
    .command_registry.commands[],
    .pane_command_registry.commands[],
    .settings_registry.sections[],
    .cli_registry.commands[]
' "${evidence}" | LC_ALL=C sort -u)

while IFS= read -r location; do
    if [[ "${location}" == http://* || "${location}" == https://* ]]; then
        continue
    fi
    [[ -f "${repo_root}/${location}" ]] || fail "evidence file is missing: ${location}"
done < <(jq -r '.first_party_documents[].location, .screenshots[].location' "${evidence}")

[[ "$(jq -r '.public_release_tags | length' "${evidence}")" == 40 ]] ||
    fail "public release ledger must contain all 40 audited releases from v0.1.7 through v0.2.0"
[[ "$(jq -r '.public_release_tags[0]' "${evidence}")" == v0.1.7 ]] ||
    fail "public release ledger must begin at v0.1.7"
[[ "$(jq -r '.public_release_tags[-1]' "${evidence}")" == "$(jq -r '.latest_public_release' "${evidence}")" ]] ||
    fail "latest public release does not match the release ledger tail"
release_tags="$(jq -r '.public_release_tags[]' "${evidence}")"
mapped_release_tags="$(jq -r '.release_feature_map[].tag' "${evidence}")"
[[ "${mapped_release_tags}" == "${release_tags}" ]] ||
    fail "release feature map must cover every public release exactly once and in order"
declare -A repository_tag_set=()
while IFS= read -r release_tag; do
    repository_tag_set["${release_tag}"]=1
done < <(git -C "${repo_root}" tag --list)
while IFS= read -r release_tag; do
    [[ -n "${repository_tag_set[${release_tag}]:-}" ]] ||
        fail "audited public release tag is absent: ${release_tag}"
done < <(jq -r '.public_release_tags[]' "${evidence}")
git -C "${repo_root}" cat-file -e "$(jq -r '.source_head' "${evidence}")^{commit}" 2>/dev/null ||
    fail "audited source head is absent"
if git -C "${repo_root}" show-ref --verify --quiet refs/remotes/upstream/main; then
    merge_head_path="$(git -C "${repo_root}" rev-parse --git-path MERGE_HEAD)"
    if [[ -f "${merge_head_path}" ]]; then
        expected_source_head="$(head -n 1 "${merge_head_path}")"
    else
        expected_source_head="$(git -C "${repo_root}" merge-base HEAD refs/remotes/upstream/main)"
    fi
    [[ "$(jq -r '.source_head' "${evidence}")" == "${expected_source_head}" ]] ||
        fail "audited source head is stale relative to the port branch"
fi

required_document_ids="$(printf '%s\n' \
    repo-readme repo-cli repo-agent-hooks repo-agent-protocol site-home site-docs-index \
    site-getting-started site-worklanes-panes site-agent-workflows site-shortcuts site-cli \
    site-themes-settings site-tmux site-reference site-faq | LC_ALL=C sort)"
actual_document_ids="$(jq -r '.first_party_documents[].id' "${evidence}" | LC_ALL=C sort)"
[[ "${actual_document_ids}" == "${required_document_ids}" ]] ||
    fail "required first-party document evidence is missing or unexpected"
[[ "$(jq -r '[.screenshots[] | select(.id == "repository-hero")] | length' "${evidence}")" == 1 ]] ||
    fail "repository hero screenshot evidence is missing or duplicated"
[[ "$(jq -r '.external_discussions | length' "${evidence}")" -ge 5 ]] ||
    fail "external workflow/risk evidence is incomplete"

for evidence_array in first_party_documents screenshots external_discussions release_feature_map; do
    duplicate_evidence_ids="$(jq -r --arg key "${evidence_array}" '
        .[$key][] | .id // .tag
    ' "${evidence}" | LC_ALL=C sort | uniq -d)"
    [[ -z "${duplicate_evidence_ids}" ]] ||
        fail "duplicate evidence IDs in ${evidence_array}: ${duplicate_evidence_ids//$'\n'/, }"
done

command_file="${repo_root}/$(jq -r '.command_registry.location' "${evidence}")"
expected_commands="$(jq -r '.command_registry.commands | keys[]' "${evidence}" | LC_ALL=C sort)"
actual_commands="$(
    awk '/^enum AppCommandID:/,/^}/' "${command_file}" |
        sed -n 's/^    case [A-Za-z][A-Za-z]* = "\([^"]*\)"$/\1/p' |
        LC_ALL=C sort
)"
[[ "${actual_commands}" == "${expected_commands}" ]] ||
    fail "command registry coverage is stale or incomplete"

linux_shortcut_registry="${ZENTTY_LINUX_SHORTCUT_REGISTRY:-${repo_root}/crates/zentty-linux/src/application_shell/shortcut_registry.rs}"
[[ -f "${linux_shortcut_registry}" ]] || fail "Linux shortcut registry is missing"
linux_shortcut_commands="$(
    awk '
        /^[[:space:]]*command!\($/ {
            getline
            if (match($0, /"[^"]+"/)) {
                print substr($0, RSTART + 1, RLENGTH - 2)
            }
        }
    ' "${linux_shortcut_registry}" | LC_ALL=C sort
)"
missing_linux_shortcut_commands="$(
    comm -23 <(printf '%s\n' "${expected_commands}") \
        <(printf '%s\n' "${linux_shortcut_commands}")
)"
[[ -z "${missing_linux_shortcut_commands}" ]] ||
    fail "Linux bindable command registry omits audited source commands: ${missing_linux_shortcut_commands//$'\n'/, }"

pane_command_file="${repo_root}/$(jq -r '.pane_command_registry.location' "${evidence}")"
expected_pane_commands="$(jq -r '.pane_command_registry.commands | keys[]' "${evidence}" | LC_ALL=C sort)"
actual_pane_commands="$(
    awk '/^enum PaneCommand:/,/^}/' "${pane_command_file}" |
        sed -n 's/^    case \([A-Za-z][A-Za-z0-9]*\).*$/\1/p' |
        LC_ALL=C sort
)"
[[ "${actual_pane_commands}" == "${expected_pane_commands}" ]] ||
    fail "pane command registry coverage is stale or incomplete"

settings_file="${repo_root}/$(jq -r '.settings_registry.location' "${evidence}")"
expected_settings="$(jq -r '.settings_registry.sections | keys[]' "${evidence}" | LC_ALL=C sort)"
actual_settings="$(awk '/^enum SettingsSection:/,/^}/' "${settings_file}" | sed -n 's/^    case \([A-Za-z][A-Za-z]*\)$/\1/p')"
actual_settings="$(printf '%s\n' "${actual_settings}" | LC_ALL=C sort)"
[[ "${actual_settings}" == "${expected_settings}" ]] ||
    fail "settings registry coverage is stale"

cli_directory="${repo_root}/$(jq -r '.cli_registry.directory' "${evidence}")"
[[ -d "${cli_directory}" ]] || fail "CLI registry directory is missing"
expected_cli_commands="$(jq -r '.cli_registry.commands | keys[]' "${evidence}" | LC_ALL=C sort)"
actual_cli_commands="$(
    grep -Rh '^struct [A-Za-z][A-Za-z0-9]*: ParsableCommand' "${cli_directory}" --include='*.swift' |
        sed -n 's/^struct \([A-Za-z][A-Za-z0-9]*\): ParsableCommand.*$/\1/p' |
        LC_ALL=C sort
)"
[[ "${actual_cli_commands}" == "${expected_cli_commands}" ]] ||
    fail "CLI command registry coverage is stale or incomplete"

while IFS= read -r directory; do
    [[ -d "${repo_root}/${directory}" ]] || fail "source coverage directory is missing: ${directory}"
done < <(jq -r '.source_coverage[].directory' "${evidence}")

while IFS= read -r root_file; do
    [[ -f "${repo_root}/${root_file}" ]] || fail "covered root source file is missing: ${root_file}"
done < <(jq -r '.root_source_files[].path' "${evidence}")

declare -A covered_root_source=()
while IFS= read -r root_file; do
    covered_root_source["${root_file}"]=1
done < <(jq -r '.root_source_files[].path' "${evidence}")
mapfile -t source_coverage_rules < <(
    jq -r '.source_coverage[] | [.directory, (.recursive | tostring)] | @tsv' "${evidence}"
)

while IFS= read -r source_file; do
    covered=false
    if [[ -n "${covered_root_source[${source_file}]:-}" ]]; then
        covered=true
    fi
    if [[ "${covered}" == false ]]; then
        source_directory="${source_file%/*}"
        for source_rule in "${source_coverage_rules[@]}"; do
            IFS=$'\t' read -r directory recursive <<<"${source_rule}"
            if [[ "${recursive}" == true && ("${source_directory}" == "${directory}" || "${source_directory}" == "${directory}/"*) ]] ||
                [[ "${recursive}" == false && "${source_directory}" == "${directory}" ]]; then
                covered=true
                break
            fi
        done
    fi
    [[ "${covered}" == true ]] || fail "product source file has no feature coverage: ${source_file}"
done < <(
    find "${repo_root}/Zentty" -type f -name '*.swift' -printf 'Zentty/%P\n'
    find "${repo_root}/ZenttyCLI" -type f -name '*.swift' -printf 'ZenttyCLI/%P\n'
)

duplicate_test_paths="$(jq -r '.test_coverage[].path, .test_infrastructure_exclusions[].path' \
    "${evidence}" | LC_ALL=C sort | uniq -d)"
[[ -z "${duplicate_test_paths}" ]] || fail "duplicate test evidence paths: ${duplicate_test_paths//$'\n'/, }"

while IFS= read -r covered_test; do
    [[ -f "${repo_root}/${covered_test}" ]] || fail "covered test file is missing: ${covered_test}"
done < <(jq -r '.test_coverage[].path, .test_infrastructure_exclusions[].path' "${evidence}")

declare -A covered_tests=()
while IFS= read -r test_file; do
    covered_tests["${test_file}"]=1
done < <(
    jq -r '.entries[].swift_tests[]' "${inventory}"
    jq -r '.test_coverage[].path, .test_infrastructure_exclusions[].path' "${evidence}"
)
while IFS= read -r test_file; do
    [[ -n "${covered_tests[${test_file}]:-}" ]] ||
        fail "test file has no feature coverage or reviewed exclusion: ${test_file}"
done < <(find "${repo_root}/ZenttyLogicTests" "${repo_root}/ZenttyIntegrationTests" \
    -maxdepth 1 -type f -name '*.swift' -printf '%p\n' |
    sed "s#^${repo_root}/##" | LC_ALL=C sort)

required_categories=(
    workspace_session worklanes panes command_routing coding_agents
    terminal_foundation application_shell search_clipboard project_context
    project_utilities configuration desktop_integration cli_shell lifecycle_trust
)
for category in "${required_categories[@]}"; do
    jq -e --arg category "${category}" 'any(.entries[]; .category == $category)' \
        "${inventory}" >/dev/null || fail "required category is absent: ${category}"
done

totals="$(jq -c '
    reduce .entries[] as $entry ({}; .[$entry.classification] += 1)
' "${inventory}")"
implementation_totals="$(jq -c '
    reduce .entries[] as $entry ({}; .[$entry.implementation_status] += 1)
' "${inventory}")"
category_totals="$(jq -c '
    reduce .entries[] as $entry ({}; .[$entry.category] += 1)
' "${inventory}")"
entry_count="$(jq '.entries | length' "${inventory}")"

if [[ -n "${summary_path}" ]]; then
    jq -n \
        --arg result PASS \
        --argjson entry_count "${entry_count}" \
        --argjson classifications "${totals}" \
        --argjson implementation_statuses "${implementation_totals}" \
        --argjson categories "${category_totals}" \
        --argjson commands "$(jq '.command_registry.commands | length' "${evidence}")" \
        --argjson pane_commands "$(jq '.pane_command_registry.commands | length' "${evidence}")" \
        --argjson settings_sections "$(jq '.settings_registry.sections | length' "${evidence}")" \
        --argjson cli_commands "$(jq '.cli_registry.commands | length' "${evidence}")" \
        --argjson source_files "$(find "${repo_root}/Zentty" "${repo_root}/ZenttyCLI" -type f -name '*.swift' | wc -l)" \
        --argjson test_files "$(find "${repo_root}/ZenttyLogicTests" "${repo_root}/ZenttyIntegrationTests" -type f -name '*.swift' | wc -l)" \
        '{
            schema_version: 1,
            result: $result,
            entry_count: $entry_count,
            classifications: $classifications,
            implementation_statuses: $implementation_statuses,
            categories: $categories,
            evidence: {
                app_commands: $commands,
                pane_commands: $pane_commands,
                settings_sections: $settings_sections,
                cli_commands: $cli_commands,
                swift_product_files: $source_files,
                swift_test_files: $test_files
            }
        }' >"${summary_path}"
fi

echo "feature-inventory: PASS entries=${entry_count} classifications=${totals} implementation=${implementation_totals}"
