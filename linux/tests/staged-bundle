#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
backend="${GDK_BACKEND:-wayland}"
build_dir="${repo_root}/build/linux"
stage_dir="${build_dir}/staged-bundle-${backend}"

rm -rf "${stage_dir}"
mkdir -p "${stage_dir}/bin" "${stage_dir}/lib" "${stage_dir}/libexec/zentty"
mkdir -p "${stage_dir}/share/zentty"
cp "${build_dir}/bin/zentty-linux" "${stage_dir}/bin/"
cp "${build_dir}/bin/zentty" "${stage_dir}/bin/"
cp "${build_dir}/lib/libghostty-gtk-embed.so" "${stage_dir}/lib/"
cp "${build_dir}/lib/libgtk4-layer-shell.so" "${stage_dir}/lib/"
cp -a "${build_dir}/libexec/zentty/." "${stage_dir}/libexec/zentty/"
cp -a "${build_dir}/share/zentty/." "${stage_dir}/share/zentty/"

theme_source="${repo_root}/ZenttyResources/ghostty/themes"
theme_stage="${stage_dir}/share/zentty/ghostty/themes"
[[ -f "${theme_stage}/GitHub-Dark-Personal" ]] || {
    echo "staged-bundle: bundled fallback theme is missing" >&2
    exit 1
}
diff -qr --no-dereference "${theme_source}" "${theme_stage}" || {
    echo "staged-bundle: bundled theme library differs from source" >&2
    exit 1
}

amp_plugin="${stage_dir}/share/zentty/amp/plugins/zentty-amp-zentty.ts"
[[ -f "${amp_plugin}" ]] || {
    echo "staged-bundle: Amp integration resource is missing" >&2
    exit 1
}
grep -F "zentty-amp-plugin-v1" "${amp_plugin}" >/dev/null || {
    echo "staged-bundle: Amp integration resource lacks its ownership marker" >&2
    exit 1
}

integration_home="${stage_dir}/integration-home"
mkdir -p "${integration_home}"
for target in amp-hooks cursor-hooks droid-hooks kimi-hooks grok-hooks agy-hooks hermes-hooks vibe-hooks; do
    HOME="${integration_home}" \
    XDG_CONFIG_HOME="${integration_home}/.config" \
    KIMI_CODE_HOME="${integration_home}/.kimi-code" \
    HERMES_HOME="${integration_home}/.hermes" \
        "${stage_dir}/bin/zentty" install "${target}" >/dev/null
done
grep -F "${stage_dir}/bin/zentty" "${integration_home}/.cursor/hooks.json" >/dev/null
grep -F "${stage_dir}/bin/zentty" "${integration_home}/.factory/settings.local.json" >/dev/null
grep -F "${stage_dir}/bin/zentty" "${integration_home}/.kimi-code/config.toml" >/dev/null
grep -F "${stage_dir}/bin/zentty" "${integration_home}/.gemini/config/hooks.json" >/dev/null
grep -F "${stage_dir}/bin/zentty" "${integration_home}/.vibe/hooks.toml" >/dev/null
grep -F "zentty-amp-plugin-v1" \
    "${integration_home}/.config/amp/plugins/zentty-amp-zentty.ts" >/dev/null
[[ -x "${integration_home}/.grok/hooks/zentty-status/01-zentty-status.sh" ]]
[[ -x "${integration_home}/.hermes/hooks/zentty-status/on-session-start.sh" ]]
for target in amp-hooks cursor-hooks droid-hooks kimi-hooks grok-hooks agy-hooks hermes-hooks vibe-hooks; do
    HOME="${integration_home}" \
    XDG_CONFIG_HOME="${integration_home}/.config" \
    KIMI_CODE_HOME="${integration_home}/.kimi-code" \
    HERMES_HOME="${integration_home}/.hermes" \
        "${stage_dir}/bin/zentty" uninstall "${target}" >/dev/null
done
! grep -R -E "zentty-(amp-plugin|agy-hook)|adapter=(cursor|droid|kimi|grok|vibe)|zentty hermes" \
    "${integration_home}" --exclude='*.lock' >/dev/null

shim="${stage_dir}/libexec/zentty/tmux-shim/tmux"
[[ -x "${shim}" ]] || {
    echo "staged-bundle: executable tmux shim is missing" >&2
    exit 1
}
shim_probe="${stage_dir}/shim-probe"
cat >"${shim_probe}" <<'SHIM_PROBE'
#!/usr/bin/env bash
set -euo pipefail
printf '<%s>\n' "$@"
SHIM_PROBE
chmod 0700 "${shim_probe}"
shim_output="$(ZENTTY_CLI_BIN="${shim_probe}" "${shim}" -S ignored list-panes -F '#{pane_id}')"
[[ "${shim_output}" == $'<__tmux-compat>\n<-S>\n<ignored>\n<list-panes>\n<-F>\n<#{pane_id}>' ]] || {
    echo "staged-bundle: tmux shim did not preserve exact CLI arguments" >&2
    exit 1
}

dependencies="$(ldd "${stage_dir}/bin/zentty-linux")"
if grep -F "not found" <<<"${dependencies}" >/dev/null; then
    printf '%s\n' "${dependencies}" >&2
    exit 1
fi
grep -F "${stage_dir}/bin/../lib/libghostty-gtk-embed.so" \
    <<<"${dependencies}" >/dev/null
grep -F "${stage_dir}/bin/../lib/libgtk4-layer-shell.so" \
    <<<"${dependencies}" >/dev/null

GDK_BACKEND="${backend}" \
ZENTTY_LINUX_BINARY="${stage_dir}/bin/zentty-linux" \
    "${repo_root}/linux/tests/rust-product-smoke"
GDK_BACKEND="${backend}" \
ZENTTY_LINUX_BINARY="${stage_dir}/bin/zentty-linux" \
    "${repo_root}/linux/tests/rust-agent-ipc"
GDK_BACKEND="${backend}" \
ZENTTY_LINUX_BINARY="${stage_dir}/bin/zentty-linux" \
    "${repo_root}/linux/tests/rust-tmux-compat-product"

echo "Zentty Linux staged bundle passed (${backend})"
