# Ubuntu GLib 2.80.0 intentionally leaves the previous 2,048-pointer quark
# array allocated when lock-free lookup growth replaces it. Upstream marks the
# object for LeakSanitizer only, so Memcheck reports the constructor allocation
# once per process that crosses the first growth boundary. The exact library,
# constructor, loader path, 16 KiB size, scenario, and count are manifest-bound.
{
   GLib quark array growth
   Memcheck:Leak
   match-leak-kinds: definite
   fun:malloc
   fun:g_malloc
   obj:*libglib-2.0.so.0.8000.0
   fun:call_init.part.0
   fun:_dl_init
   obj:*ld-linux-x86-64.so.2
}

# Ubuntu 24.04's stripped librsvg emits undefined-value reports while GTK's
# icon loader initializes SVG types. Keep this test-only suppression bounded by
# the external library at the source and GDK Pixbuf at the consumer.
{
   GTK SVG loader stripped librsvg undefined values
   Memcheck:Cond
   obj:*librsvg*.so*
   ...
   fun:gdk_pixbuf_loader_close
}

# Mesa 25.2.8 llvmpipe reads driver-owned vector padding while executing a
# completed Ghostty instanced draw. Keep both the external producer and the
# Ghostty draw consumer in the rule so unrelated Gallium findings stay visible.
{
   Mesa llvmpipe Ghostty instanced draw undefined values
   Memcheck:Cond
   obj:*libgallium*.so*
   ...
   fun:draw.drawArraysInstanced
}

# GTK 4.14.5 retains each mnemonic label relationship after the owning widget
# is destroyed. The standalone gtk-mnemonic-memory-reproducer proves the same
# 24-byte root without loading Ghostty or Zentty.
{
   GTK mnemonic label accessibility relation
   Memcheck:Leak
   match-leak-kinds: definite
   fun:malloc
   fun:g_malloc
   fun:g_list_prepend
   fun:gtk_widget_list_mnemonic_labels
   fun:gtk_widget_add_mnemonic_label
}

# Ubuntu 24.04's stripped Fontconfig retains the Pango metrics cache through
# process exit. The direct allocation originates in Fontconfig and reaches GTK
# only through pango_context_get_metrics; do not suppress other Fontconfig or
# Ghostty allocations.
{
   GTK Pango Fontconfig metrics cache
   Memcheck:Leak
   match-leak-kinds: definite,indirect
   fun:realloc
   obj:*libfontconfig.so*
   ...
   fun:pango_context_get_metrics
}
{
   GTK Pango Fontconfig metrics cache children
   Memcheck:Leak
   match-leak-kinds: indirect
   fun:calloc
   obj:*libfontconfig.so*
   ...
   fun:pango_context_get_metrics
}
{
   GTK Pango Fontconfig metrics cache strings
   Memcheck:Leak
   match-leak-kinds: indirect
   fun:malloc
   fun:strdup
   obj:*libfontconfig.so*
   obj:*libfontconfig.so*
   obj:*libfontconfig.so*
   obj:*libfontconfig.so*
   obj:*libfontconfig.so*
}
{
   GTK Pango Fontconfig metrics cache nodes
   Memcheck:Leak
   match-leak-kinds: indirect
   fun:malloc
   obj:*libfontconfig.so*
   obj:*libfontconfig.so*
   obj:*libfontconfig.so*
   obj:*libfontconfig.so*
   obj:*libfontconfig.so*
   obj:*libfontconfig.so*
   obj:*libfontconfig.so*
   obj:*libfontconfig.so*
}
{
   GTK Pango Fontconfig layout cache
   Memcheck:Leak
   match-leak-kinds: definite,indirect
   fun:realloc
   obj:*libfontconfig.so*
   ...
   fun:pango_layout_get_size
}
{
   GTK Pango Fontconfig layout cache children
   Memcheck:Leak
   match-leak-kinds: indirect
   fun:calloc
   obj:*libfontconfig.so*
   ...
   fun:pango_layout_get_size
}

# GTK's external IBus input module retains a tiny empty preedit text object
# after repeated focus transitions. Require both the IBus constructor/module
# and GTK's IBus constructor path. A separate non-Ghostty GtkIMMulticontext
# reproducer establishes the same finding; scenario governance prevents this
# rule from silently matching unrelated runs.
{
   GTK IBus focus preedit object
   Memcheck:Leak
   match-leak-kinds: definite,indirect
   fun:g_type_create_instance
   ...
   fun:ibus_text_new_from_string
   obj:*libim-ibus.so*
}
{
   GTK IBus focus preedit string
   Memcheck:Leak
   match-leak-kinds: indirect
   fun:malloc
   fun:g_malloc
   fun:g_strdup
   fun:ibus_text_new_from_string
   obj:*libim-ibus.so*
}
