#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
validator="${repo_root}/linux/tests/qualification-host-freeze"
source_manifest="${repo_root}/linux/test-policy/qualification-host-freeze.json"
temp_dir="$(mktemp -d)"
trap 'rm -rf "${temp_dir}"' EXIT

make_fixture() {
    local root="$1"
    mkdir -p \
        "${root}/linux/src" \
        "${root}/linux/scripts" \
        "${root}/linux/test-policy"
    cp "${repo_root}/linux/src/main.c" "${root}/linux/src/main.c"
    cp "${repo_root}/linux/src/host_options.c" "${root}/linux/src/host_options.c"
    cp "${repo_root}/linux/src/host_options.h" "${root}/linux/src/host_options.h"
    cp "${repo_root}/linux/scripts/build-local" "${root}/linux/scripts/build-local"
    cp "${source_manifest}" "${root}/linux/test-policy/qualification-host-freeze.json"
}

run_expect_failure() {
    local name="$1"
    local pattern="$2"
    local root="${temp_dir}/${name}"
    local output="${temp_dir}/${name}.log"
    make_fixture "${root}"
    shift 2
    "$@" "${root}"
    set +e
    ZENTTY_QUALIFICATION_HOST_ROOT="${root}" \
        bash "${validator}" >"${output}" 2>&1
    local status=$?
    set -e
    if [[ "${status}" -eq 0 ]]; then
        echo "error: ${name} unexpectedly passed" >&2
        cat "${output}" >&2
        exit 1
    fi
    grep -F "${pattern}" "${output}" >/dev/null || {
        echo "error: ${name} did not report ${pattern}" >&2
        cat "${output}" >&2
        exit 1
    }
}

canonical_root="${temp_dir}/canonical"
make_fixture "${canonical_root}"
ZENTTY_QUALIFICATION_HOST_ROOT="${canonical_root}" \
    bash "${validator}" >/dev/null

alter_source() {
    printf '\n/* forbidden qualification-host drift */\n' >>"$1/linux/src/main.c"
}
run_expect_failure altered-source \
    "protected source hash drift: linux/src/main.c" alter_source

add_source() {
    printf 'int forbidden_product_source;\n' >"$1/linux/src/product.c"
}
run_expect_failure added-source \
    "unexpected qualification-host source entry: linux/src/product.c" add_source

add_directory() {
    mkdir "$1/linux/src/product"
}
run_expect_failure added-directory \
    "unexpected qualification-host source entry: linux/src/product" add_directory

remove_source() {
    rm "$1/linux/src/host_options.h"
}
run_expect_failure missing-source \
    "protected source must be a regular non-symbolic file: linux/src/host_options.h" \
    remove_source

symlink_source() {
    rm "$1/linux/src/main.c"
    ln -s host_options.c "$1/linux/src/main.c"
}
run_expect_failure symlink-source \
    "protected source must be a regular non-symbolic file: linux/src/main.c" \
    symlink_source

nonregular_source() {
    rm "$1/linux/src/main.c"
    mkdir "$1/linux/src/main.c"
}
run_expect_failure nonregular-source \
    "protected source must be a regular non-symbolic file: linux/src/main.c" \
    nonregular_source

symlink_source_directory() {
    local root="$1"
    mv "${root}/linux/src" "${root}/linux/src.real"
    ln -s src.real "${root}/linux/src"
}
run_expect_failure symlink-source-directory \
    "protected source directory must be a non-symbolic directory" \
    symlink_source_directory

extra_manifest_key() {
    local manifest="$1/linux/test-policy/qualification-host-freeze.json"
    jq '.unexpected = true' "${manifest}" >"${manifest}.tmp"
    mv "${manifest}.tmp" "${manifest}"
}
run_expect_failure extra-manifest-key \
    "invalid qualification-host freeze manifest shape or policy" \
    extra_manifest_key

extra_source_key() {
    local manifest="$1/linux/test-policy/qualification-host-freeze.json"
    jq '.sources[0].purpose = "product"' "${manifest}" >"${manifest}.tmp"
    mv "${manifest}.tmp" "${manifest}"
}
run_expect_failure extra-source-key \
    "invalid qualification-host freeze manifest shape or policy" \
    extra_source_key

symlink_manifest() {
    local root="$1"
    local manifest="${root}/linux/test-policy/qualification-host-freeze.json"
    mv "${manifest}" "${manifest}.real"
    ln -s qualification-host-freeze.json.real "${manifest}"
}
run_expect_failure symlink-manifest \
    "freeze manifest must be a regular non-symbolic file" \
    symlink_manifest

nonregular_manifest() {
    local manifest="$1/linux/test-policy/qualification-host-freeze.json"
    rm "${manifest}"
    mkdir "${manifest}"
}
run_expect_failure nonregular-manifest \
    "freeze manifest must be a regular non-symbolic file" \
    nonregular_manifest

extend_manifest_inventory() {
    local root="$1"
    local manifest="${root}/linux/test-policy/qualification-host-freeze.json"
    printf 'int forbidden_product_source;\n' >"${root}/linux/src/product.c"
    jq --arg sha "$(sha256sum "${root}/linux/src/product.c" | awk '{print $1}')" \
        '.sources += [{path:"linux/src/product.c",sha256:$sha}]' \
        "${manifest}" >"${manifest}.tmp"
    mv "${manifest}.tmp" "${manifest}"
}
run_expect_failure extended-manifest-inventory \
    "invalid qualification-host freeze manifest shape or policy" \
    extend_manifest_inventory

alter_build() {
    printf '\n# forbidden build drift\n' >>"$1/linux/scripts/build-local"
}
run_expect_failure altered-build \
    "protected build entrypoint hash drift: linux/scripts/build-local" \
    alter_build

symlink_build() {
    local root="$1"
    mv "${root}/linux/scripts/build-local" "${root}/linux/scripts/build-local.real"
    ln -s build-local.real "${root}/linux/scripts/build-local"
}
run_expect_failure symlink-build \
    "protected build entrypoint must be a regular non-symbolic file: linux/scripts/build-local" \
    symlink_build

nonregular_build() {
    local build="$1/linux/scripts/build-local"
    rm "${build}"
    mkdir "${build}"
}
run_expect_failure nonregular-build \
    "protected build entrypoint must be a regular non-symbolic file: linux/scripts/build-local" \
    nonregular_build

echo "C qualification-host freeze self-test passed"
