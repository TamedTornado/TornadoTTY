#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
inventory="${GHOSTTY_API_INVENTORY:-${repo_root}/linux/ghostty-api-audit.json}"
matrix="${repo_root}/linux/qualification-matrix.json"
ghostty_source="${GHOSTTY_SOURCE_DIR:-}"
mode="${1:-}"

fail() {
    echo "ghostty-api-audit: error: $*" >&2
    exit 1
}

for command in git jq grep sed sort mktemp; do
    command -v "${command}" >/dev/null || fail "required command not found: ${command}"
done
[[ "$#" -le 1 ]] || fail "usage: $0 [--self-test]"
[[ -z "${mode}" || "${mode}" == "--self-test" ]] || fail "unknown option: ${mode}"
[[ -f "${inventory}" ]] || fail "inventory not found: ${inventory}"

expected_revision="$(sed -n 's/^revision=//p' "${repo_root}/linux/ghostty.lock")"
if [[ -z "${ghostty_source}" ]]; then
    for candidate in "${repo_root}/../ghostty" "${repo_root}/build/linux-deps/ghostty"; do
        if git -C "${candidate}" rev-parse --is-inside-work-tree >/dev/null 2>&1 &&
           [[ "$(git -C "${candidate}" rev-parse HEAD)" == "${expected_revision}" ]]; then
            ghostty_source="${candidate}"
            break
        fi
    done
fi
[[ -n "${ghostty_source}" ]] || fail "no exact locked Ghostty checkout found"
git -C "${ghostty_source}" rev-parse --is-inside-work-tree >/dev/null 2>&1 ||
    fail "Ghostty source is not a Git checkout: ${ghostty_source}"

jq -e '
    .schema_version == 2 and
    .issue == 11 and
    .decision.outcome == "retain_downstream" and
    .decision.upstream_submission == "not_now" and
    .decision.communication_requires_operator_approval == true and
    .decision.rust_binding_in_ghostty == false and
    (.snapshot.official_base | test("^[0-9a-f]{40}$")) and
    (.snapshot.head | test("^[0-9a-f]{40}$")) and
    (.snapshot.downstream_commit_count | type) == "number" and
    (.patch_series | length) > 0 and
    all(.patch_series[];
        (.first | test("^[0-9a-f]{40}$")) and
        (.last | test("^[0-9a-f]{40}$")) and
        (.purpose | length) > 0 and
        (.upstream_disposition | length) > 0) and
    (.changed_files | length) == 19 and
    ([.changed_files[].path] | length == (unique | length)) and
    all(.changed_files[];
        (.status == "A" or .status == "M") and
        (.owner | length) > 0 and
        (.purpose | length) > 0 and
        (.tests | length) > 0) and
    (.changed_files | any(.path == "AGENTS.md") | not) and
    .abi.exported_function_count == 14 and
    (.abi.operations | length) == .abi.exported_function_count and
    ([.abi.operations[].symbol] | length == (unique | length)) and
    (.abi.removed_unproven_exports | length) == 3 and
    ([.abi.removed_unproven_exports[]] | length == (unique | length)) and
    .abi.async_backend_type == "int32_t" and
    .abi.text_extent_type == "uint32_t" and
    .abi.external_public_type == "GtkWidget" and
    all(.abi.operations[];
        (.safe_owner.path | length) > 0 and
        (.safe_owner.needle | length) > 0 and
        (.product_callers | length) > 0 and
        all(.product_callers[]; (.path | length) > 0 and (.needle | length) > 0) and
        (.real_journeys | length) > 0 and
        (.negative_test | length) > 0) and
    (.qualification_cells | length) == 6 and
    ([.qualification_cells[].id] | length == (unique | length)) and
    all(.qualification_cells[]; .status == "PASS")
' "${inventory}" >/dev/null || fail "inventory schema or required review fields are invalid"

base="$(jq -r '.snapshot.official_base' "${inventory}")"
head="$(jq -r '.snapshot.head' "${inventory}")"
[[ "${expected_revision}" == "${head}" ]] || fail "linux/ghostty.lock and audit head differ"
[[ "$(git -C "${ghostty_source}" rev-parse HEAD)" == "${head}" ]] ||
    fail "Ghostty checkout HEAD differs from audited head"
[[ -z "$(git -C "${ghostty_source}" status --porcelain=v1)" ]] ||
    fail "Ghostty checkout must be clean"
git -C "${ghostty_source}" merge-base --is-ancestor "${base}" "${head}" ||
    fail "official base is not an ancestor of the candidate"
[[ "$(git -C "${ghostty_source}" rev-list --count "${base}..${head}")" == \
   "$(jq -r '.snapshot.downstream_commit_count' "${inventory}")" ]] ||
    fail "downstream commit count differs"

while IFS=$'\t' read -r first last; do
    git -C "${ghostty_source}" merge-base --is-ancestor "${base}" "${first}" ||
        fail "patch-series first commit is outside the downstream range: ${first}"
    git -C "${ghostty_source}" merge-base --is-ancestor "${first}" "${last}" ||
        fail "patch-series order is invalid: ${first}..${last}"
    git -C "${ghostty_source}" merge-base --is-ancestor "${last}" "${head}" ||
        fail "patch-series last commit is outside the downstream range: ${last}"
done < <(jq -r '.patch_series[] | [.first, .last] | @tsv' "${inventory}")

expected_files="$(jq -r '.changed_files[] | [.status, .path] | @tsv' "${inventory}" | sort)"
actual_files="$(git -C "${ghostty_source}" diff --name-status "${base}..${head}" | sort)"
[[ "${actual_files}" == "${expected_files}" ]] || fail "changed-file ledger differs"
! grep -Fx $'M\tAGENTS.md' <<<"${actual_files}" >/dev/null ||
    fail "Zentty policy leaked into the Ghostty candidate"

expected_symbols="$(jq -r '.abi.operations[].symbol' "${inventory}" | sort)"
header_symbols="$(
    grep -Eo 'ghostty_gtk_embed_[a-z_]+[[:space:]]*\(' \
        "${ghostty_source}/include/ghostty/gtk.h" |
        sed -E 's/[[:space:]]*\($//' | sort -u
)"
zig_symbols="$(
    sed -n -E 's/^export fn (ghostty_gtk_embed_[a-z_]+).*/\1/p' \
        "${ghostty_source}/src/gtk_embed_lib.zig" | sort -u
)"
version_symbols="$(
    sed -n -E 's/^[[:space:]]+(ghostty_gtk_embed_[a-z_]+);/\1/p' \
        "${ghostty_source}/src/gtk_embed_lib.version-script" | sort -u
)"
[[ "${header_symbols}" == "${expected_symbols}" ]] || fail "header operations differ from inventory"
[[ "${zig_symbols}" == "${expected_symbols}" ]] || fail "Zig exports differ from inventory"
[[ "${version_symbols}" == "${expected_symbols}" ]] || fail "version-script allowlist differs from inventory"
[[ "$(grep -c '^GHOSTTY_GTK_EMBED_1\.0 {' "${ghostty_source}/src/gtk_embed_lib.version-script")" == 1 ]] ||
    fail "symbol-version node differs"

grep -Fx 'typedef int32_t ghostty_gtk_embed_async_backend_t;' \
    "${ghostty_source}/include/ghostty/gtk.h" >/dev/null ||
    fail "async backend is not fixed-width int32_t"
grep -Fx 'typedef uint32_t ghostty_gtk_embed_text_extent_t;' \
    "${ghostty_source}/include/ghostty/gtk.h" >/dev/null ||
    fail "text extent is not fixed-width uint32_t"
grep -Fx 'typedef struct _GtkWidget GtkWidget;' \
    "${ghostty_source}/include/ghostty/gtk.h" >/dev/null ||
    fail "GtkWidget forward declaration differs"
while IFS= read -r removed; do
    ! grep -Fq "${removed}(" "${ghostty_source}/include/ghostty/gtk.h" ||
        fail "removed unproven export remains in the public header: ${removed}"
    ! grep -Fq "export fn ${removed}(" "${ghostty_source}/src/gtk_embed_lib.zig" ||
        fail "removed unproven export remains in the Zig ABI: ${removed}"
done < <(jq -r '.abi.removed_unproven_exports[]' "${inventory}")

actual_rust_symbols="$(
    sed -n -E 's/^[[:space:]]+pub fn (ghostty_gtk_embed_[a-z_]+).*/\1/p' \
        "${repo_root}/crates/zentty-ghostty-sys/src/lib.rs" | sort -u
)"
[[ "${actual_rust_symbols}" == "${expected_symbols}" ]] ||
    fail "raw Rust declarations differ from the reviewed public ABI"

while IFS=$'\t' read -r path needle; do
    [[ -f "${repo_root}/${path}" ]] || fail "product-usage path is missing: ${path}"
    grep -Fq -- "${needle}" "${repo_root}/${path}" ||
        fail "reviewed product callsite is missing: ${path}: ${needle}"
done < <(
    jq -r '.abi.operations[] | .safe_owner, .product_callers[] | [.path, .needle] | @tsv' \
        "${inventory}"
)

while IFS= read -r journey; do
    [[ -x "${repo_root}/${journey}" ]] || fail "real product journey is missing: ${journey}"
    jq -e --arg journey "${journey}" '
        any(.cells[]; .status == "PASS" and ((.command // "") | contains($journey)))
    ' "${matrix}" >/dev/null || fail "real product journey has no PASS matrix cell: ${journey}"
done < <(jq -r '[.abi.operations[].real_journeys[]] | unique[]' "${inventory}")

while IFS=$'\t' read -r id status; do
    jq -e --arg id "${id}" --arg status "${status}" '
        any(.cells[]; .id == $id and .status == $status)
    ' "${matrix}" >/dev/null || fail "qualification cell differs from audit: ${id}"
done < <(jq -r '.qualification_cells[] | [.id, .status] | @tsv' "${inventory}")

pass_message="Ghostty API audit passed: current official base, 19 reviewed files, 14 product-used exports, fixed-width backend ABI, no Zentty policy in Ghostty, downstream maintenance decision recorded"
echo "${pass_message}"

if [[ "${mode}" == "--self-test" ]]; then
    temporary="$(mktemp -d -t zentty-ghostty-audit.XXXXXX)"
    trap 'rm -rf -- "${temporary}"' EXIT

    jq '.changed_files |= .[1:]' "${inventory}" >"${temporary}/missing-file.json"
    if GHOSTTY_API_INVENTORY="${temporary}/missing-file.json" \
       GHOSTTY_SOURCE_DIR="${ghostty_source}" "$0" >"${temporary}/missing.out" 2>&1; then
        fail "self-test accepted a missing changed-file cell"
    fi
    grep -Eq 'inventory schema|changed-file ledger differs' "${temporary}/missing.out" ||
        fail "missing changed-file self-test failed for the wrong reason"

    jq '.decision.outcome = "submit_upstream"' "${inventory}" >"${temporary}/wrong-decision.json"
    if GHOSTTY_API_INVENTORY="${temporary}/wrong-decision.json" \
       GHOSTTY_SOURCE_DIR="${ghostty_source}" "$0" >"${temporary}/decision.out" 2>&1; then
        fail "self-test accepted an unreviewed upstream decision"
    fi
    grep -F 'inventory schema or required review fields are invalid' \
        "${temporary}/decision.out" >/dev/null ||
        fail "decision self-test failed for the wrong reason"

    echo "Ghostty API audit self-tests passed: missing ledger entries and unreviewed decision changes rejected"
fi
