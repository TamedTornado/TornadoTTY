#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
backend="${GDK_BACKEND:-}"

[[ "${backend}" == wayland || "${backend}" == x11 ]] || {
    echo "rust-product-lifecycle: GDK_BACKEND must be wayland or x11" >&2
    exit 1
}

ZENTTY_RUST_SCENARIO=lifecycle \
ZENTTY_RUST_TERMINALS=2 \
ZENTTY_RUST_CYCLES=3 \
    "${repo_root}/linux/tests/rust-product-smoke"
