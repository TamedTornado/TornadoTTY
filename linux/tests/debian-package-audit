#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
root="${1:?usage: debian-package-audit PACKAGE_ROOT EXPANDED_MANIFEST}"
expanded_manifest="${2:?usage: debian-package-audit PACKAGE_ROOT EXPANDED_MANIFEST}"
policy="${repo_root}/linux/packaging/policy-v1.json"

fail() {
    echo "debian-package-audit: error: $*" >&2
    exit 1
}

[[ -d "${root}/DEBIAN" && -f "${root}/DEBIAN/control" ]] || fail "package control is missing"
jq -e '.schema_version == 1 and .package == "tornadotty" and .architecture == "amd64" and
    (.files | type == "array" and length > 0) and
    ([.files[].path] | length == (unique | length))' "${expanded_manifest}" >/dev/null ||
    fail "expanded manifest is invalid"

actual_paths="$(mktemp)"
receipt_paths="$(mktemp)"
trap 'rm -f -- "${actual_paths}" "${receipt_paths}"' EXIT
find "${root}" -mindepth 1 \( -type f -o -type l \) ! -path "${root}/DEBIAN/*" \
    -printf '/%P\n' | LC_ALL=C sort >"${actual_paths}"
jq -r '.files[].path' "${expanded_manifest}" | LC_ALL=C sort >"${receipt_paths}"
cmp -s "${actual_paths}" "${receipt_paths}" || fail "expanded manifest and payload differ"

declare -A receipt_types receipt_modes receipt_digests receipt_targets
while IFS=$'\x1f' read -r path type mode digest target; do
    receipt_types["${path}"]="${type}"
    receipt_modes["${path}"]="${mode}"
    receipt_digests["${path}"]="${digest}"
    receipt_targets["${path}"]="${target}"
done < <(jq -r '.files[] |
    [.path,.type,(.mode // ""),(.sha256 // ""),(.target // "")] | join("\u001f")' \
    "${expanded_manifest}")

while IFS= read -r path; do
    absolute="${root}${path}"
    receipt_type="${receipt_types[${path}]}"
    [[ "${path}" != *'/../'* && "${path}" != /home/* && "${path}" != /tmp/* ]] ||
        fail "unsafe payload path: ${path}"
    if [[ -L "${absolute}" ]]; then
        [[ "${receipt_type}" == symlink ]] || fail "payload type drift: ${path}"
        target="$(readlink "${absolute}")"
        [[ "${target}" == "${receipt_targets[${path}]}" ]] ||
            fail "payload symlink drift: ${path}"
        [[ "${target}" != /* && "${target}" != *'..'*'..'* ]] || fail "unsafe symlink: ${path}"
    else
        [[ "${receipt_type}" == file ]] || fail "payload type drift: ${path}"
        mode="$(stat -c %a "${absolute}")"
        [[ "${mode}" == "${receipt_modes[${path}]}" ]] ||
            fail "payload mode drift: ${path}"
        [[ "$(sha256sum "${absolute}" | awk '{print $1}')" == \
            "${receipt_digests[${path}]}" ]] ||
            fail "payload digest drift: ${path}"
        [[ "${mode}" == 644 || "${mode}" == 755 ]] || fail "unsafe payload mode ${mode}: ${path}"
        [[ ! -u "${absolute}" && ! -g "${absolute}" ]] || fail "set-id payload file: ${path}"
        case "${path}" in
            *.a|*.la|*.log|*.receipt|*/tests/*|*/fixtures/*) fail "forbidden payload file: ${path}" ;;
        esac
        if grep -IElq '(^|[^A-Za-z])(api[_-]?key|authorization|bearer)[=:][^[:space:]]+' "${absolute}"; then
            fail "credential-shaped content in payload: ${path}"
        fi
        if grep -IaFq "${repo_root}" "${absolute}" || grep -IaEq '/(home|tmp)/[^ ]+/(Projects|build)/' "${absolute}"; then
            fail "source or build path leaked into payload: ${path}"
        fi
    fi
done <"${actual_paths}"

ghostty="${root}/usr/lib/zentty/lib/libghostty-gtk-embed.so"
# The loader token must remain literal in the audited ELF.
# shellcheck disable=SC2016
[[ "$(patchelf --print-rpath "${ghostty}")" == '$ORIGIN' ]] ||
    fail "Ghostty RUNPATH is not install-relative"
for elf in \
    "${root}/usr/lib/zentty/bin/zentty-linux" \
    "${root}/usr/lib/zentty/bin/zentty" \
    "${ghostty}" \
    "${root}/usr/lib/zentty/lib/libgtk4-layer-shell.so"; do
    file "${elf}" | grep -Fq ELF || fail "expected ELF payload is missing: ${elf}"
    readelf -lW "${elf}" | grep -Fq GNU_RELRO || fail "RELRO missing: ${elf}"
    ! readelf -lW "${elf}" | grep -F GNU_STACK | grep -Fq RWE || fail "executable stack: ${elf}"
    readelf -dW "${elf}" | grep -Eq 'BIND_NOW|FLAGS_1.*NOW' || fail "immediate binding missing: ${elf}"
    runpath="$(readelf -dW "${elf}" | sed -n 's/.*\(RPATH\|RUNPATH\).*\[\([^]]*\)\].*/\2/p')"
    [[ "${runpath}" != *'.zig-cache'* && "${runpath}" != *'/home/'* && "${runpath}" != *'/tmp/'* ]] ||
        fail "build-tree loader path: ${elf}"
done

control="${root}/DEBIAN/control"
[[ "$(sed -n 's/^Package: //p' "${control}")" == tornadotty ]] || fail "wrong package name"
[[ "$(sed -n 's/^Architecture: //p' "${control}")" == amd64 ]] || fail "wrong package architecture"
[[ "$(sed -n 's/^Provides: //p' "${control}")" == zentty ]] ||
    fail "legacy package provision is missing"
[[ "$(sed -n 's/^Conflicts: //p' "${control}")" == zentty ]] ||
    fail "legacy package conflict is missing"
[[ "$(sed -n 's/^Replaces: //p' "${control}")" == zentty ]] ||
    fail "legacy package replacement is missing"
dependencies="$(sed -n 's/^Depends: //p' "${control}")"
dependency_floor_pattern='\(>=[[:space:]]+([^)]+)\)'
while IFS=$'\t' read -r package minimum; do
    dependency_relation="$(tr ',' '\n' <<<"${dependencies}" |
        sed 's/^[[:space:]]*//;s/[[:space:]]*$//' |
        grep -E "^${package//./\\.}([[:space:]]|$)" || true)"
    [[ "${dependency_relation}" =~ ${dependency_floor_pattern} ]] ||
        fail "ratified dependency floor is absent: ${package} >= ${minimum}"
    dpkg --compare-versions "${BASH_REMATCH[1]}" ge "${minimum}" ||
        fail "ratified dependency floor is too low: ${package} ${BASH_REMATCH[1]} < ${minimum}"
done < <(jq -r '.dependencies.baseline_packages[] | [.name,.minimum] | @tsv' "${policy}")

desktop-file-validate "${root}/usr/share/applications/com.tamedtornado.tornadotty.desktop"
appstreamcli validate --no-net --pedantic \
    "${root}/usr/share/metainfo/com.tamedtornado.tornadotty.metainfo.xml" >/dev/null
[[ -s "${root}/usr/share/doc/tornadotty/copyright" ]] || fail "copyright is absent"
notices="${root}/usr/share/doc/tornadotty/third-party"
ghostty_notices="${notices}/ghostty-components.json"
cargo_notices="${notices}/cargo-packages.json"
catalog="${notices}/catalog-v1.json"
[[ -s "${ghostty_notices}" && -s "${cargo_notices}" && -s "${catalog}" ]] ||
    fail "third-party notice manifests are absent"
jq -e '.schema_version == 1 and .ecosystem == "ghostty-zig" and
    (.components | length > 0) and
    ([.components[].name] | length == (unique | length)) and
    all(.components[]; .license != "" and (.notice | startswith("ghostty/")))' \
    "${ghostty_notices}" >/dev/null || fail "Ghostty notice manifest is invalid"
jq -e 'type == "array" and length > 0 and
    all(.[]; .name != "" and .version != "" and
      (.license != null or .license_file != null))' \
    "${cargo_notices}" >/dev/null || fail "Cargo notice manifest is invalid"
jq -e --slurpfile cargo "${cargo_notices}" --slurpfile ghostty "${ghostty_notices}" \
    --slurpfile policy "${repo_root}/linux/packaging/ghostty-notices-v1.json" \
    --arg zentty_revision "$(jq -r '.zentty_revision' "${expanded_manifest}")" \
    --arg ghostty_revision "$(sed -n 's/^revision=//p' "${repo_root}/linux/ghostty.lock")" '
    .schema_version == 1 and
    .generated_from.zentty.revision == $zentty_revision and
    .generated_from.ghostty.revision == $ghostty_revision and
    (.entries | length) ==
      (($cargo[0] | length) + ($ghostty[0].components | length) +
       ($policy[0].embedded_notice_only | length)) and
    ([.entries[].id] | length == (unique | length)) and
    all(.entries[];
      (.source_url | startswith("https://")) and
      (.homepage_url == null or (.homepage_url | startswith("https://"))) and
      (.notice.kind == "file" or .notice.kind == "directory") and
      (.notice.path | startswith("/") | not) and
      (.notice.path | contains("..") | not))
' "${catalog}" >/dev/null || fail "product license catalog is invalid or incomplete"
while IFS= read -r notice; do
    [[ -s "${notices}/${notice}" ]] || fail "Ghostty notice text is absent: ${notice}"
done < <(jq -r '.components[].notice' "${ghostty_notices}")
while IFS=$'\t' read -r name version; do
    cargo_notice_dir="${notices}/cargo/${name}-${version}"
    [[ -d "${cargo_notice_dir}" ]] || fail "Cargo notice directory is absent: ${name} ${version}"
    find "${cargo_notice_dir}" -maxdepth 1 -type f -size +0c -print -quit | grep -q . ||
        fail "Cargo notice text is absent: ${name} ${version}"
done < <(jq -r '.[] | [.name,.version] | @tsv' "${cargo_notices}")
while IFS=$'\t' read -r kind notice; do
    if [[ "${kind}" == file ]]; then
        [[ -s "${notices}/${notice}" ]] ||
            fail "catalog notice text is absent: ${notice}"
    else
        find "${notices}/${notice}" -maxdepth 1 -type f -size +0c -print -quit |
            grep -q . || fail "catalog notice directory is empty: ${notice}"
    fi
done < <(jq -r '.entries[] | [.notice.kind,.notice.path] | @tsv' "${catalog}")
[[ -s "${notices}/ghostty/embedded-code-NOTICE" &&
   -s "${notices}/ghostty/Apache-2.0" ]] || fail "embedded source notices are absent"
[[ -s "${root}/usr/share/terminfo/x/xterm-ghostty" ]] || fail "terminfo is absent"
[[ "$(readlink "${root}/usr/share/terminfo/g/ghostty")" == ../x/xterm-ghostty ]] ||
    fail "terminfo alias is wrong"

echo "debian-package-audit: PASS files=$(wc -l <"${actual_paths}") cargo_notices=$(jq 'length' "${cargo_notices}") ghostty_notices=$(jq '.components | length' "${ghostty_notices}")"
