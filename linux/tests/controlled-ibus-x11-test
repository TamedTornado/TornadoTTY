cat >"${fake_bin}/ibus" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail

case "${1:-}" in
    address)
        if [[ "${ZENTTY_FAKE_IBUS_MODE:-ready}" == slow-query &&
            ! -e "${ZENTTY_FAKE_CAPTURE_DIR}/slow-query.attempted" ]]; then
            : >"${ZENTTY_FAKE_CAPTURE_DIR}/slow-query.attempted"
            printf '%s\n' "${BASHPID}" >"${ZENTTY_FAKE_CAPTURE_DIR}/slow-query.pid"
            trap 'printf "stopped\n" >"${ZENTTY_FAKE_CAPTURE_DIR}/slow-query.stopped"; exit 143' TERM HUP INT
            while :; do
                sleep 1
            done
        fi
        mkdir -p "${XDG_CACHE_HOME}/ibus"
        case "${ZENTTY_FAKE_IBUS_MODE:-ready}" in
            outside-address)
                printf 'unix:path=/tmp/not-controlled/fake-ibus,guid=0123456789abcdef0123456789abcdef\n'
                ;;
            traversal-address)
                printf 'unix:path=%s/ibus/../../outside/fake-ibus,guid=0123456789abcdef0123456789abcdef\n' "${XDG_CACHE_HOME}"
                ;;
            compound-address)
                printf 'unix:path=%s/ibus/fake-ibus,guid=0123456789abcdef0123456789abcdef;unix:path=/tmp/outside\n' "${XDG_CACHE_HOME}"
                ;;
            *)
                printf 'unix:path=%s/ibus/fake-ibus,guid=0123456789abcdef0123456789abcdef\n' "${XDG_CACHE_HOME}"
                ;;
        esac
        ;;
    list-engine)
        printf 'language: English\n  xkb:us::eng - English (US)\n'
        printf 'language: Chinese\n  table:cangjie5 - CangJie5\n'
        ;;
    engine)
        if [[ -n "${2:-}" ]]; then
            printf '%s\n' "${2}" >"${ZENTTY_FAKE_CAPTURE_DIR}/engine"
        elif [[ "${ZENTTY_FAKE_ENGINE_READBACK:-selected}" == wrong ]]; then
            printf 'xkb:gb::eng\n'
        else
            cat "${ZENTTY_FAKE_CAPTURE_DIR}/engine"
        fi
        ;;
    *)
        exit 2
        ;;
esac
EOF

