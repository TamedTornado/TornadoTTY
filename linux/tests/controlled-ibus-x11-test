#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
wrapper="${repo_root}/linux/tests/controlled-ibus-x11"
marker_prefix="controlled-ibus-x11: READY x11-display private-xvfb private-dbus foreground-ibus engine=xkb:us::eng sync-mode=1"
temp_dir="$(mktemp -d)"
fake_bin="${temp_dir}/bin"
signal_wrapper_pid=""

# This is a deterministic orchestration unit test. The fakes deliberately do
# not certify real Xvfb, D-Bus, or IBus topology; ibus-focus-memory is the real
# service integration gate.

cleanup() {
    if [[ -n "${signal_wrapper_pid}" ]] &&
        kill -0 "${signal_wrapper_pid}" 2>/dev/null; then
        kill -TERM "${signal_wrapper_pid}" 2>/dev/null || true
        wait "${signal_wrapper_pid}" 2>/dev/null || true
    fi
    rm -rf -- "${temp_dir}"
}
trap cleanup EXIT

fail() {
    echo "controlled-ibus-x11-test: error: $*" >&2
    exit 1
}

assert_dead() {
    local pid="$1"
    local label="$2"

    if kill -0 "${pid}" 2>/dev/null; then
        fail "${label} process ${pid} survived wrapper cleanup"
    fi
}

assert_cleaned() {
    local capture_dir="$1"
    local expect_term_marker="$2"
    local run_root
    local daemon_pid

    [[ -s "${capture_dir}/run-root" ]] || fail "fixture did not capture its private root"
    read -r run_root <"${capture_dir}/run-root"
    [[ ! -e "${run_root}" ]] || fail "private root survived cleanup: ${run_root}"

    [[ -s "${capture_dir}/daemon.pid" ]] || fail "fixture did not capture ibus-daemon PID"
    read -r daemon_pid <"${capture_dir}/daemon.pid"
    assert_dead "${daemon_pid}" "ibus-daemon"

    if [[ "${expect_term_marker}" == true ]]; then
        [[ -f "${capture_dir}/daemon.stopped" ]] ||
            fail "ibus-daemon did not receive a cleanup signal"
    fi
}

wait_for_file() {
    local path="$1"

    for _ in {1..200}; do
        [[ -s "${path}" ]] && return 0
        sleep 0.01
    done
    fail "timed out waiting for fixture file: ${path}"
}

