    fail "outside IBus address lacked a diagnostic"
if grep -F "${marker_prefix} session-id=" \
    "${outside_address_capture}/stdout" >/dev/null; then
    fail "outside IBus address emitted a controlled-session marker"
fi
[[ ! -e "${outside_address_capture}/child-ran" ]] ||
    fail "wrapped child ran with an IBus address outside the controlled root"
assert_cleaned "${outside_address_capture}" true
echo "controlled IBus outside-address negative test passed"

for address_mode in traversal-address compound-address; do
    address_capture="${temp_dir}/${address_mode}-failure"
    mkdir -p "${address_capture}"
    set +e
    ZENTTY_FAKE_CAPTURE_DIR="${address_capture}" \
    ZENTTY_FAKE_IBUS_MODE="${address_mode}" \
        "${wrapper}" session-probe success \
        >"${address_capture}/stdout" 2>"${address_capture}/stderr"
    address_status=$?
    set -e
    [[ "${address_status}" -eq 1 ]] ||
        fail "${address_mode} status 1 became ${address_status}"
    if [[ "${address_mode}" == traversal-address ]]; then
        address_diagnostic="private IBus returned an address outside the controlled root"
    else
        address_diagnostic="private IBus returned a malformed or compound address"
    fi
    grep -F "${address_diagnostic}" "${address_capture}/stderr" >/dev/null ||
        fail "${address_mode} lacked its containment diagnostic"
    if grep -F "${marker_prefix} session-id=" \
        "${address_capture}/stdout" >/dev/null; then
        fail "${address_mode} emitted a controlled-session marker"
    fi
    [[ ! -e "${address_capture}/child-ran" ]] ||
        fail "wrapped child ran with ${address_mode}"
    assert_cleaned "${address_capture}" true
done
echo "controlled IBus traversal/compound-address negative tests passed"

missing_bin="${temp_dir}/missing-bin"
mkdir -p "${missing_bin}"
for dependency in \
    bash xvfb-run Xvfb xauth xdpyinfo dbus-run-session dbus-daemon ibus-daemon; do
    ln -s "$(PATH="${original_path}" command -v "${dependency}")" \
        "${missing_bin}/${dependency}"
done
set +e
PATH="${missing_bin}" "${wrapper}" true \
    >"${temp_dir}/missing.stdout" 2>"${temp_dir}/missing.stderr"
missing_status=$?
set -e
[[ "${missing_status}" -eq 77 ]] ||
    fail "missing runtime dependency status 77 became ${missing_status}"
grep -F "missing runtime dependency: ibus" "${temp_dir}/missing.stderr" >/dev/null ||
    fail "missing runtime dependency lacked a diagnostic"
echo "controlled IBus missing-dependency test passed"

missing_cat_bin="${temp_dir}/missing-cat-bin"
mkdir -p "${missing_cat_bin}"
for dependency in \
    bash xvfb-run Xvfb xauth xdpyinfo dbus-run-session dbus-daemon ibus-daemon \
    ibus setsid ps grep sed mktemp mkdir chmod rm sleep env timeout readlink; do
    ln -s "$(PATH="${original_path}" command -v "${dependency}")" \
        "${missing_cat_bin}/${dependency}"
done
set +e
PATH="${missing_cat_bin}" "${wrapper}" true \
    >"${temp_dir}/missing-cat.stdout" 2>"${temp_dir}/missing-cat.stderr"
missing_cat_status=$?
set -e
[[ "${missing_cat_status}" -eq 77 ]] ||
    fail "missing cat dependency status 77 became ${missing_cat_status}"
grep -F "missing runtime dependency: cat" \
    "${temp_dir}/missing-cat.stderr" >/dev/null ||
    fail "missing cat dependency lacked a diagnostic"
echo "controlled IBus complete dependency-preflight test passed"

echo "controlled IBus wrapper tests passed"
