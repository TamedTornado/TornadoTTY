#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
runner="${repo_root}/linux/tests/qualification-matrix"
source_matrix="${repo_root}/linux/qualification-matrix.json"
temp_dir="$(mktemp -d)"
trap 'rm -rf -- "${temp_dir}"' EXIT

expect_validation_failure() {
    local expected="$1"
    if ZENTTY_QUALIFICATION_MATRIX="${temp_dir}/matrix.json" \
        "${runner}" --validate-only \
        >"${temp_dir}/stdout" 2>"${temp_dir}/stderr"; then
        echo "qualification-matrix-test: expected validation failure: ${expected}" >&2
        exit 1
    fi
    grep -F "${expected}" "${temp_dir}/stderr" >/dev/null || {
        cat "${temp_dir}/stderr" >&2
        exit 1
    }
}

expect_schema_validation_failure() {
    expect_validation_failure \
        'matrix does not conform to qualification-matrix.schema.json'
}

"${runner}" --validate-only >/dev/null

# CI checks repository changes; it is not product behavior or qualification
# authority. Keep provider/workflow state out of the product matrix.
if jq -e '
    (.required_capabilities[]? == "controlled_public_ci") or
    (.cells[]? | .capability == "controlled_public_ci" or (.id | startswith("controlled-ci-")))
' "${source_matrix}" >/dev/null; then
    echo "qualification-matrix-test: CI authority returned to the product matrix" >&2
    exit 1
fi

if ZENTTY_QUALIFICATION_JOBS=0 "${runner}" --validate-only \
    >"${temp_dir}/stdout" 2>"${temp_dir}/stderr"; then
    echo "qualification-matrix-test: zero parallel jobs were accepted" >&2
    exit 1
fi
grep -F 'ZENTTY_QUALIFICATION_JOBS must be a positive integer' \
    "${temp_dir}/stderr" >/dev/null
if ZENTTY_QUALIFICATION_JOBS=33 "${runner}" --validate-only \
    >"${temp_dir}/stdout" 2>"${temp_dir}/stderr"; then
    echo "qualification-matrix-test: unsafe parallel job count was accepted" >&2
    exit 1
fi
grep -F 'ZENTTY_QUALIFICATION_JOBS must not exceed 32' \
    "${temp_dir}/stderr" >/dev/null
if ZENTTY_QUALIFICATION_DISPLAY_JOBS=0 "${runner}" --validate-only \
    >"${temp_dir}/stdout" 2>"${temp_dir}/stderr"; then
    echo "qualification-matrix-test: zero display jobs were accepted" >&2
    exit 1
fi
grep -F 'ZENTTY_QUALIFICATION_DISPLAY_JOBS must be a positive integer' \
    "${temp_dir}/stderr" >/dev/null
if ZENTTY_QUALIFICATION_JOBS=4 ZENTTY_QUALIFICATION_DISPLAY_JOBS=5 \
    "${runner}" --validate-only >"${temp_dir}/stdout" 2>"${temp_dir}/stderr"; then
    echo "qualification-matrix-test: display jobs exceeded total jobs" >&2
    exit 1
fi
grep -F 'ZENTTY_QUALIFICATION_DISPLAY_JOBS must not exceed total jobs' \
    "${temp_dir}/stderr" >/dev/null
if ZENTTY_QUALIFICATION_INTERACTIVE_JOBS=0 "${runner}" --validate-only \
    >"${temp_dir}/stdout" 2>"${temp_dir}/stderr"; then
    echo "qualification-matrix-test: zero interactive jobs were accepted" >&2
    exit 1
fi
grep -F 'ZENTTY_QUALIFICATION_INTERACTIVE_JOBS must be a positive integer' \
    "${temp_dir}/stderr" >/dev/null
if ZENTTY_QUALIFICATION_DISPLAY_JOBS=4 ZENTTY_QUALIFICATION_INTERACTIVE_JOBS=5 \
    "${runner}" --validate-only >"${temp_dir}/stdout" 2>"${temp_dir}/stderr"; then
    echo "qualification-matrix-test: interactive jobs exceeded display jobs" >&2
    exit 1
fi
grep -F 'ZENTTY_QUALIFICATION_INTERACTIVE_JOBS must not exceed display jobs' \
    "${temp_dir}/stderr" >/dev/null

# A killed matrix run may leave its scheduler-owned scratch directory. The next
# exclusively locked run must remove that stale scratch, but reject unrelated
# directories rather than silently erasing them.
scratch_summary="${temp_dir}/scratch-summary.json"
scratch_logs="${scratch_summary}.logs"
mkdir -p "${scratch_logs}/.cell-results.interrupted"
printf '{}\n' >"${temp_dir}/invalid-matrix.json"
if ZENTTY_QUALIFICATION_MATRIX="${temp_dir}/invalid-matrix.json" \
    ZENTTY_QUALIFICATION_SUMMARY="${scratch_summary}" "${runner}" \
    >"${temp_dir}/stdout" 2>"${temp_dir}/stderr"; then
    echo "qualification-matrix-test: invalid scratch-cleanup fixture passed" >&2
    exit 1
fi
[[ ! -e "${scratch_logs}/.cell-results.interrupted" ]] || {
    echo "qualification-matrix-test: stale scheduler scratch was retained" >&2
    exit 1
}
mkdir -p "${scratch_logs}/unowned-directory"
if ZENTTY_QUALIFICATION_MATRIX="${temp_dir}/invalid-matrix.json" \
    ZENTTY_QUALIFICATION_SUMMARY="${scratch_summary}" "${runner}" \
    >"${temp_dir}/stdout" 2>"${temp_dir}/stderr"; then
    echo "qualification-matrix-test: unowned logs directory was accepted" >&2
    exit 1
fi
grep -F 'unexpected entry in matrix logs directory:' "${temp_dir}/stderr" >/dev/null

jq '(.cells[] | select(.id == "ghostty-regression")).blocks_display = "yes"' \
    "${source_matrix}" >"${temp_dir}/matrix.json"
expect_schema_validation_failure

# JSON Schema is the structural authority for the matrix, including execution
# graph and scheduler fields. These fixtures must fail before semantic policy
# validation rather than relying on parallel jq type/shape checks.
jq 'del(.execution_graph)' "${source_matrix}" >"${temp_dir}/matrix.json"
expect_schema_validation_failure

jq 'del(.cells[0].order)' "${source_matrix}" >"${temp_dir}/matrix.json"
expect_schema_validation_failure

jq '(.cells[] | select(.id == "ghostty-regression")).schedule_priority = -1' \
    "${source_matrix}" >"${temp_dir}/matrix.json"
expect_schema_validation_failure

jq '(.cells[] | select(.id == "ghostty-regression")).depends_on =
      ["prepare-ghostty", "prepare-ghostty"]' \
    "${source_matrix}" >"${temp_dir}/matrix.json"
expect_schema_validation_failure

jq '(.cells[] | select(.id == "ghostty-regression")).undocumented_scheduler_flag = true' \
    "${source_matrix}" >"${temp_dir}/matrix.json"
expect_schema_validation_failure

# The IBus harness deliberately emits process/random-token markers, while the
# common matrix summary schema requires opaque 64-hex session identities.
source "${repo_root}/linux/tests/lib/controlled-environment"
ibus_session_id="$(zentty_controlled_ibus_session_id '970879-C9xhyI')"
[[ "${ibus_session_id}" =~ ^[0-9a-f]{64}$ ]]
[[ "${ibus_session_id}" == "$(zentty_controlled_ibus_session_id '970879-C9xhyI')" ]]
[[ "${ibus_session_id}" != "$(zentty_controlled_ibus_session_id '970880-C9xhyI')" ]]
if zentty_controlled_ibus_session_id 'not-a-controlled-marker' >/dev/null 2>&1; then
    echo "qualification-matrix-test: malformed IBus marker was accepted" >&2
    exit 1
fi

# A required matrix coordinate may not disappear silently.
jq 'del(.cells[] | select(.id == "debug-wayland-epoll-single"))' \
    "${source_matrix}" >"${temp_dir}/matrix.json"
expect_validation_failure 'missing terminal cell: Debug/wayland/epoll/single'

# Installed payload qualification is an inseparable X11/Wayland pair and may
# not degrade to staged execution or a non-input Wayland environment.
jq 'del(.cells[] | select(.id == "installed-product-x11"))' \
    "${source_matrix}" >"${temp_dir}/matrix.json"
expect_validation_failure 'cells with unknown dependencies: package-qualification-summary'

jq '(.cells[] | select(.id == "installed-product-wayland")).environment_profile = "nested-wayland-v1"' \
    "${source_matrix}" >"${temp_dir}/matrix.json"
expect_validation_failure 'installed-product cells are missing or malformed'

# Agent lifecycle qualification may not silently drift to an ambient Gemini
# installation or an unreviewed package version.
jq '(.cells[] | select(.id == "agent-integration-x11")).command |= sub("ZENTTY_REAL_GEMINI_BIN=linux/ci/node-tools/node_modules/.bin/gemini "; "")' \
    "${source_matrix}" >"${temp_dir}/matrix.json"
expect_validation_failure \
    'agent-integration cells must pin the reviewed repository Gemini executable and version'

# The Codex lifecycle must not resolve the operator's ambient CLI. It executes
# the exact pnpm-pinned repository package while retaining the user-facing
# command name inside the product PTY.
grep -F 'codex_binary="${ZENTTY_REAL_CODEX_BIN:-${repo_root}/linux/ci/node-tools/node_modules/.bin/codex}"' \
    "${repo_root}/linux/tests/installed-codex-integration" >/dev/null
grep -F 'PATH="$(dirname "${codex_binary}"):${PATH}"' \
    "${repo_root}/linux/tests/installed-codex-integration" >/dev/null

jq '(.cells[] | select(.id == "agent-integration-wayland")).command |= sub("ZENTTY_EXPECTED_GEMINI_VERSION=0.53.0"; "ZENTTY_EXPECTED_GEMINI_VERSION=0.56.0")' \
    "${source_matrix}" >"${temp_dir}/matrix.json"
expect_validation_failure \
    'agent-integration cells must pin the reviewed repository Gemini executable and version'

# Package closure is a closed evidence graph. Lifecycle labels may validate the
# one real producer receipt, but no cell or installed backend may disappear.
jq 'del(.cells[] | select(.id == "package-upgrade-failure-evidence"))' \
    "${source_matrix}" >"${temp_dir}/matrix.json"
expect_validation_failure 'cells with unknown dependencies: package-qualification-summary'

jq '(.cells[] | select(.id == "package-qualification-summary")).depends_on -= ["installed-product-wayland"]' \
    "${source_matrix}" >"${temp_dir}/matrix.json"
expect_validation_failure 'package-qualification cells are missing or malformed'

jq '(.cells[] | select(.id == "package-clean-build-reproducibility")).depends_on = ["install-uninstall"]' \
    "${source_matrix}" >"${temp_dir}/matrix.json"
expect_validation_failure 'package-qualification cells are missing or malformed'

# Status vocabulary is closed; SKIPPED is never an accepted qualification result.
jq '(.cells[] | select(.id == "install-uninstall")).status = "SKIPPED"' \
    "${source_matrix}" >"${temp_dir}/matrix.json"
expect_schema_validation_failure

# Deferred statuses are auditable states, not aliases for an unexplained skip.
# Exercise both real ReleaseSafe Valgrind XFAIL declarations so either cell
# drifting independently is caught.
for valgrind_id in release-valgrind-wayland release-valgrind-x11; do
    jq --arg id "${valgrind_id}" \
        '(.cells[] | select(.id == $id)) |= del(.tracking)' \
        "${source_matrix}" >"${temp_dir}/matrix.json"
    expect_validation_failure \
        "BLOCKED/XFAIL cells without nonblank tracking IDs: ${valgrind_id}"

    jq --arg id "${valgrind_id}" \
        '(.cells[] | select(.id == $id)).tracking = ""' \
        "${source_matrix}" >"${temp_dir}/matrix.json"
    expect_schema_validation_failure

    jq --arg id "${valgrind_id}" \
        '(.cells[] | select(.id == $id)).tracking = "   "' \
        "${source_matrix}" >"${temp_dir}/matrix.json"
    expect_schema_validation_failure

    jq --arg id "${valgrind_id}" \
        '(.cells[] | select(.id == $id)) |= del(.defect, .prerequisite)' \
        "${source_matrix}" >"${temp_dir}/matrix.json"
    expect_validation_failure \
        "BLOCKED/XFAIL cells without a nonblank defect or prerequisite: ${valgrind_id}"

    jq --arg id "${valgrind_id}" \
        '(.cells[] | select(.id == $id)) |= (.defect = "" | del(.prerequisite))' \
        "${source_matrix}" >"${temp_dir}/matrix.json"
    expect_schema_validation_failure

    jq --arg id "${valgrind_id}" \
        '(.cells[] | select(.id == $id)) |= (.defect = " \t " | del(.prerequisite))' \
        "${source_matrix}" >"${temp_dir}/matrix.json"
    expect_schema_validation_failure
done

# BLOCKED has the same governance contract. A prerequisite may explain the
# block in place of a defect, but it and the tracking ID must contain text.
jq '(.cells[] | select(.id == "visual-parity-map")) |=
      (.status = "BLOCKED" | .tracking = "TEST-BLOCKED" |
       .prerequisite = "controlled reference environment" |
       del(.environment_profile))' \
    "${source_matrix}" >"${temp_dir}/matrix.json"
ZENTTY_QUALIFICATION_MATRIX="${temp_dir}/matrix.json" \
    "${runner}" --validate-only >/dev/null

for field in tracking prerequisite; do
    jq --arg field "${field}" '
        (.cells[] | select(.id == "visual-parity-map")) |=
          (.status = "BLOCKED" | .tracking = "TEST-BLOCKED" |
           .prerequisite = "controlled reference environment" |
           .[$field] = " \n " | del(.environment_profile))
    ' "${source_matrix}" >"${temp_dir}/matrix.json"
    if [[ "${field}" == "tracking" ]]; then
        expect_schema_validation_failure
    else
        expect_schema_validation_failure
    fi
done

# Independently scheduled Valgrind producers must retain unique report paths.
jq '(.cells[] | select(.id == "debug-valgrind-ibus-focus-x11")).valgrind_report = "build/linux/memory-safety-Debug-single-x11.json"' \
    "${source_matrix}" >"${temp_dir}/matrix.json"
expect_validation_failure \
    'duplicate Valgrind report paths:'

jq '(.cells[] | select(.id == "release-x11-default-single")).resources = ["desktop"]' \
    "${source_matrix}" >"${temp_dir}/matrix.json"
expect_validation_failure \
    'cells with unknown resources: release-x11-default-single'

jq '(.cells[] | select(.id == "development-servers-docker-x11")) |= del(.resources)' \
    "${source_matrix}" >"${temp_dir}/matrix.json"
expect_validation_failure \
    'resource-mutating cells lack their named resource: development-servers-docker-x11'

jq '(.cells[] | select(.id == "ghostty-api-audit-inventory")).depends_on = ["missing-cell"]' \
    "${source_matrix}" >"${temp_dir}/matrix.json"
expect_validation_failure \
    'cells with unknown dependencies: ghostty-api-audit-inventory'

jq 'del(.cells[] | select(.id == "prepare-ghostty"))' \
    "${source_matrix}" >"${temp_dir}/matrix.json"
expect_validation_failure 'execution graph prerequisite cells are missing or malformed'

jq '(.cells[] | select(.id == "prepare-ghostty")).depends_on = ["build-release"]' \
    "${source_matrix}" >"${temp_dir}/matrix.json"
expect_validation_failure 'matrix dependency graph contains a cycle'

# Full qualification cannot be asserted while any explicit gap remains.
jq '.claims.full_linux_qualification_passed = true' \
    "${source_matrix}" >"${temp_dir}/matrix.json"
expect_validation_failure 'matrix incorrectly claims full Linux qualification'

# Suppression review must depend on every evidence producer, not merely sort
# after it in the human report.
jq '(.cells[] | select(.id == "valgrind-suppression-governance")).depends_on = ["ghostty-abi-old-new-mismatch"]' \
    "${source_matrix}" >"${temp_dir}/matrix.json"
expect_validation_failure \
    'suppression-governance cell must execute after every Valgrind report and artifact-mutating build cell'

# Profile builds are immutable, and the obsolete third build may not return.
if jq -e '.cells[] | select(.id == "restore-release")' "${source_matrix}" >/dev/null; then
    echo "qualification-matrix-test: redundant ReleaseSafe rebuild returned" >&2
    exit 1
fi
jq -e '
    (.cells[] | select(.id == "build-debug") |
      ((.resources // []) | length) == 0 and (.blocks_display // false) == false and
      (.command | contains("ZENTTY_BUILD_OUTPUT_DIR=build/linux-profiles/debug")) and
      (.command | contains("ZENTTY_GHOSTTY_INSTALL_DIR=build/linux-deps/ghostty-install/debug")) and
      (.command | contains("ZENTTY_ZIG_LOCAL_CACHE_DIR=build/linux-deps/ghostty/.zig-cache/qualification/debug"))) and
    (all(.cells[] | select((.command // "") | contains("GHOSTTY_LIB_DIR="));
      (.command | contains("GHOSTTY_LIB_DIR=$PWD/")))) and
    (.cells[] | select(.id == "ghostty-regression") |
      ((.resources // []) | length) == 0 and .schedule_priority == 12 and
      (.blocks_display // false) == false and
      (.command | contains("ZENTTY_BUILD_JOBS=16")) and
      (.command | contains("ZENTTY_ZIG_LOCAL_CACHE_DIR=build/linux-deps/ghostty/.zig-cache/qualification/regression")) and
      .skip_profile_prerequisite == true)
' "${source_matrix}" >/dev/null

# Every graphical journey owns a nested display rather than imposing a global
# display barrier in the declared execution graph.
jq -e '
    [.cells[] | select(.blocks_display == true) | .id] == []
' "${source_matrix}" >/dev/null

# Cargo test commands share one build target and do not gain real parallelism
# by contending on Cargo's own lock. Profile builds and Ghostty regression use
# isolated Zig cache/install outputs and are intentionally admitted together.
jq -e '
    all(.cells[] | select((.command // "") | contains("cargo test"));
      (.resources // []) | index("compiler-load") != null) and
    all(.cells[] | select(.id == "package-clean-build-reproducibility");
      (.resources // []) | index("compiler-load") != null)
' "${source_matrix}" >/dev/null

jq -e '
    all(.cells[] | select(has("valgrind_report"));
      ((.resources // []) | length) == 0) and
    ((.execution_graph.resources | index("valgrind-evidence")) == null)
' "${source_matrix}" >/dev/null

jq -e '
    (.cells[] | select(.id == "development-servers-docker-x11") |
      (.command | contains("ZENTTY_TEST_BUSYBOX_IMAGE=busybox@sha256:7a3ebe5bfd1a4a19797d20b0c0bb39d44393e9a03fd852c0865b0f540d868df0")) and
      (.command | contains("ZENTTY_TEST_DOCKER=true")))
' "${source_matrix}" >/dev/null

jq -e '
    all(.cells[] | select(.id == "installed-product-x11" or .id == "installed-product-wayland");
      (.command | startswith("dbus-run-session -- env "))) and
    (.cells[] | select(.id == "notification-custom-sound-import") |
      (.command | startswith("GHOSTTY_LIB_DIR=$PWD/build/linux-profiles/release-safe/lib ")))
' "${source_matrix}" >/dev/null

# Private bookmark and multi-window journeys do not share input devices,
# compositors, state directories, or receipt paths. They must not regain
# fictitious global resource locks that serialize independent environments.
jq -e '
    all(.cells[] | select(
      (.id | startswith("bookmarks-presets-")) or
      (.id | startswith("product-multi-window-")) or
      (.id | startswith("product-pane-drag-")) or
      .id == "product-existing-worklane-transfer-wayland" or
      .id == "product-window-state-wayland");
      ((.resources // []) | length) == 0)
' "${source_matrix}" >/dev/null

if jq -e '.cells[] | has("exclusive_host_input")' "${source_matrix}" >/dev/null; then
    echo "qualification-matrix-test: disproven global input exclusivity returned" >&2
    exit 1
fi

echo "Qualification matrix focused tests passed"
