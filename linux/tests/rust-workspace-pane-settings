#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
product="${ZENTTY_LINUX_BINARY:-${repo_root}/build/linux/bin/zentty-linux}"
backend="${GDK_BACKEND:-}"
run_root="$(mktemp -d)"
state_directory="${run_root}/state"
log="${run_root}/product.log"
config="${XDG_CONFIG_HOME}/zentty/config.toml"
product_pid=""

# shellcheck disable=SC1091
source "${repo_root}/linux/tests/lib/product-input"
# shellcheck source=linux/tests/lib/product-bundle
source "${repo_root}/linux/tests/lib/product-bundle"

fail() {
    [[ ! -f "${log}" ]] || cat "${log}" >&2
    echo "rust-workspace-pane-settings: error: $*" >&2
    exit 1
}

cleanup() {
    if [[ "${product_pid}" =~ ^[1-9][0-9]*$ ]]; then
        kill -TERM "${product_pid}" 2>/dev/null || true
        wait "${product_pid}" 2>/dev/null || true
    fi
    rm -rf -- "${run_root}"
}
trap cleanup EXIT

case "${backend}" in
    x11)
        [[ "${ZENTTY_NESTED_X11_SESSION_ID:-}" =~ ^[0-9a-f]{64}$ ]] ||
            fail "X11 scenario must run through linux/tests/nested-x11"
        ;;
    wayland)
        [[ "${ZENTTY_NESTED_WAYLAND_INPUT_SESSION_ID:-}" =~ ^[0-9a-f]{64}$ ]] ||
            fail "Wayland scenario must run through linux/tests/nested-wayland-input"
        ;;
    *) fail "GDK_BACKEND must be x11 or wayland" ;;
esac
[[ -x "${product}" ]] || fail "staged product is missing: ${product}"
zentty_product_bundle_resolve "${product}" || fail "staged product bundle is invalid"
product="${ZENTTY_PRODUCT_BINARY}"
bundle_lib="${ZENTTY_PRODUCT_BUNDLE_LIB}"
mkdir -p "${state_directory}" "$(dirname "${config}")"
cat >"${config}" <<'EOF'
# workspace settings integration receipt
[worklanes]
new_worklane_placement = "top"
[pane_layout]
right_split_behavior = "alwaysSplit"
visible_split_window_width = 1200
[panes]
show_labels = true
show_borders = false
inactive_opacity = 0.81
show_project_icons = false
smooth_scroll_enabled = false
focus_follows_mouse = true
focus_follows_mouse_delay = "immediate"
EOF

GDK_SCALE=1 \
GDK_DPI_SCALE=1 \
LD_LIBRARY_PATH="${bundle_lib}${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}" \
    "${product}" --command 'sleep 180' --state-directory "${state_directory}" \
    --no-session-restore >"${log}" 2>&1 &
product_pid=$!
zentty_product_prepare_input "${backend}" "${log}" || fail "physical product input was unavailable"

# Configured top insertion is exercised by the real worklane action and
# projected by the one workspace state authority.
zentty_product_ctrl_key "${backend}" t
zentty_product_wait_for_log "${log}" 'action=new-worklane id=worklane-2 pane=pane-2' \
    "physical new-worklane action failed" || fail "new worklane missing"
zentty_product_wait_for_log "${log}" 'topology=worklane-2' \
    "new worklane was not rendered first" || fail "top placement missing"
latest_topology="$(grep -F 'zentty-linux: topology=' "${log}" | tail -1)"
[[ "${latest_topology}" == *'topology=worklane-2'*'|worklane-1'* ]] ||
    fail "top placement did not precede the original worklane: ${latest_topology}"

# The normal Add Pane Right chord must resolve through the configured
# Always Split policy and create two real visible Ghostty columns.
zentty_product_ctrl_key "${backend}" d
zentty_product_wait_for_log "${log}" 'action=split-pane-right pane=pane-3' \
    "configured right-pane behavior did not split" || fail "right split missing"
zentty_product_wait_for_log "${log}" 'geometry=worklane-2:column-pane-2[pane-2],column-pane-3[pane-3]' \
    "real two-column geometry was not projected" || fail "split geometry missing"

# Enter the right pane and then the left pane through the compositor-owned
# pointer. Immediate focus-follow must select the actual left surface.
pointer_evidence="covered-by-controlled-x11-cell"
if zentty_product_uses_xdotool "${backend}"; then
    xdotool mousemove --sync --window "${ZENTTY_PRODUCT_WINDOW_ID}" 950 430
    sleep 0.05
    xdotool mousemove --sync --window "${ZENTTY_PRODUCT_WINDOW_ID}" 430 430
    zentty_product_wait_for_log "${log}" 'focus-follows-mouse pane=pane-2 result=focused' \
        "physical pointer entry did not focus the left pane" || fail "focus follows mouse missing"
    pointer_evidence="physical-pointer-focus"
fi

# Add a second real application window before editing settings. The settings
# write must later project through the application-wide config authority to
# both this multi-pane window and the new single-pane window.
first_product_window_id="${ZENTTY_PRODUCT_WINDOW_ID:-}"
zentty_product_ctrl_shift_key "${backend}" n
zentty_product_wait_for_log "${log}" 'window-opened id=window-2' \
    "physical New Window action failed" || fail "second real window missing"
zentty_product_wait_for_log "${log}" 'active-window=window-2' \
    "second window never became the compositor-active product window" || fail "second window activation missing"
for _ in $(seq 1 200); do
    (( $(grep -Fc 'started subcommand path=/bin/sh pid=' "${log}" || true) >= 3 )) && break
    sleep 0.05
done
mapfile -t shell_pids < <(sed -n 's/.*started subcommand path=\/bin\/sh pid=\([0-9][0-9]*\).*/\1/p' "${log}" | head -3)
(( ${#shell_pids[@]} == 3 )) || fail "three real shell child PIDs were not observed"
for shell_pid in "${shell_pids[@]}"; do
    kill -0 "${shell_pid}" 2>/dev/null || fail "real shell exited before settings controls: ${shell_pid}"
done
surface_owned_before="$(grep -Fc 'zentty-linux: surface-owned pane=' "${log}" || true)"
if zentty_product_uses_xdotool "${backend}"; then
    if [[ "${backend}" == x11 ]]; then
        for _ in $(seq 1 100); do
            ZENTTY_PRODUCT_WINDOW_ID="$(xdotool search --onlyvisible --pid "${product_pid}" --name '^Zentty$' 2>/dev/null | grep -Fvx "${first_product_window_id}" | head -1 || true)"
            [[ "${ZENTTY_PRODUCT_WINDOW_ID}" =~ ^[1-9][0-9]*$ ]] && break
            sleep 0.05
        done
        [[ "${ZENTTY_PRODUCT_WINDOW_ID}" =~ ^[1-9][0-9]*$ ]] || fail "second X11 product toplevel was not identifiable"
        export ZENTTY_PRODUCT_WINDOW_ID
    fi
    guarded_focus_before="$(grep -Fc 'focus-follows-mouse pane=pane-2 result=focused' "${log}" || true)"
    xdotool mousemove --sync --window "${first_product_window_id}" 950 430
    xdotool mousemove --sync --window "${first_product_window_id}" 430 430
    sleep 0.3
    [[ "$(grep -Fc 'focus-follows-mouse pane=pane-2 result=focused' "${log}" || true)" == "${guarded_focus_before}" ]] ||
        fail "pointer in an inactive window stole keyboard focus"
    pointer_evidence="physical-pointer-focus-and-inactive-window-guard"
    if [[ "${backend}" == x11 ]]; then
        xdotool windowfocus --sync "${first_product_window_id}"
        ZENTTY_PRODUCT_WINDOW_ID="${first_product_window_id}"
        export ZENTTY_PRODUCT_WINDOW_ID
    fi
fi
topology_evidence_before="$(grep -F 'zentty-linux: topology=' "${log}" | sha256sum)"

zentty_product_ctrl_shift_key "${backend}" p
if [[ "${backend}" == x11 ]]; then
    xdotool type --delay 5 -- 'Panes S'
else
    # The Wayland product is nested in an outer controlled X11 compositor, but
    # keyboard input still goes through the compositor's virtual keyboard.
    wtype -d 35 -- 'Panes S'
fi
zentty_product_wait_for_log "${log}" \
    'command-palette=query value="Panes S" results=1' \
    "settings command did not resolve uniquely" || fail "settings palette route failed"
if [[ "${backend}" == x11 ]]; then
    palette_focus_before="$(grep -Fc 'focus-follows-mouse pane=' "${log}" || true)"
    xdotool mousemove --sync --window "${first_product_window_id}" 430 430
    sleep 0.3
    [[ "$(grep -Fc 'focus-follows-mouse pane=' "${log}" || true)" == "${palette_focus_before}" ]] ||
        fail "pointer stole terminal focus while the command palette was open"
fi
if [[ "${backend}" == x11 ]]; then
    zentty_product_key "${backend}" Down
    zentty_product_key "${backend}" Return
else
    wtype -k Down -k Return
fi
zentty_product_wait_for_log "${log}" 'zentty-linux: settings-section selected=pane-layout' \
    "palette did not deep-link to Worklanes & Panes" || fail "settings deep-link failed"
zentty_product_wait_for_log "${log}" \
    'workspace-pane-settings loaded placement=top right-behavior=alwaysSplit threshold=1200 labels=true borders=false icons=false smooth=false focus=true focus-delay=immediate inactive-opacity=81' \
    "settings page did not load the exact persisted source values" || fail "settings values missing"
grep -Fq '# workspace settings integration receipt' "${config}" || fail "configuration comment was lost"
for _ in $(seq 1 100); do
    grep -Fq 'zentty-linux: shortcut-settings active search-focused=' "${log}" && break
    sleep 0.05
done
grep -Fq 'zentty-linux: shortcut-settings active search-focused=' "${log}" ||
    fail "Worklanes & Panes settings toplevel did not become active"
if [[ "${backend}" == x11 ]]; then
    settings_focus_before="$(grep -Fc 'focus-follows-mouse pane=' "${log}" || true)"
    xdotool windowmove "${first_product_window_id}" 1300 0
    xdotool mousemove --sync --window "${first_product_window_id}" 430 430
    sleep 0.3
    [[ "$(grep -Fc 'focus-follows-mouse pane=' "${log}" || true)" == "${settings_focus_before}" ]] ||
        fail "pointer stole terminal focus while Settings was open"
    xdotool windowmove "${first_product_window_id}" 0 0
fi

settings_window=""
setting_activation=""
find_settings_window() {
    local candidate width height area best="" best_area=0
    while read -r candidate; do
        [[ "${candidate}" =~ ^[1-9][0-9]*$ ]] || continue
        width="$(xdotool getwindowgeometry --shell "${candidate}" 2>/dev/null | sed -n 's/^WIDTH=//p')"
        height="$(xdotool getwindowgeometry --shell "${candidate}" 2>/dev/null | sed -n 's/^HEIGHT=//p')"
        [[ "${width}" =~ ^[0-9]+$ && "${height}" =~ ^[0-9]+$ ]] || continue
        area=$((width * height))
        if (( area > best_area )); then
            best="${candidate}"
            best_area="${area}"
        fi
    done < <(xdotool search --name '^Zentty Settings$' 2>/dev/null || true)
    printf '%s' "${best}"
}

settings_key() {
    local key="$1"
    if [[ "${backend}" == x11 ]]; then
        settings_window=""
        for _ in $(seq 1 100); do
            settings_window="$(find_settings_window)"
            [[ "${settings_window}" =~ ^[1-9][0-9]*$ ]] && break
            sleep 0.05
        done
        [[ "${settings_window}" =~ ^[1-9][0-9]*$ ]] || fail "real Settings toplevel disappeared"
        # Xvfb intentionally has no window manager. Raise the proven GTK
        # toplevel, give it X input focus directly, and inject through XTEST.
        xdotool windowraise "${settings_window}"
        xdotool windowfocus --sync "${settings_window}"
        sleep 0.1
        xdotool key --clearmodifiers "${key}"
    else
        case "${key}" in
            ctrl+*) wtype -M ctrl -k "${key#ctrl+}" -m ctrl ;;
            alt+*) wtype -M alt -k "${key#alt+}" -m alt ;;
            *) wtype -k "${key}" ;;
        esac
    fi
}

settings_key_current() {
    local sequence="$1"
    local -a keys=()
    read -r -a keys <<<"${sequence}"
    (( ${#keys[@]} > 0 )) || fail "Settings key sequence was empty"
    if [[ "${backend}" == x11 ]]; then
        [[ "${settings_window}" =~ ^[1-9][0-9]*$ ]] || fail "Settings toplevel was not selected"
        # A GtkDropDown mnemonic opens its native popup and transfers focus to
        # an internal list item. Do not refocus the Settings toplevel here:
        # that steals the popup grab. XTEST must deliver the follow-up keys to
        # the current native focus exactly as a physical keyboard does.
        xdotool key --clearmodifiers "${keys[@]}"
    else
        for key in "${keys[@]}"; do
            wtype -k "${key}"
        done
    fi
}

focus_setting() {
    local name="$1" focus_before apply_before mnemonic
    focus_before="$(grep -Fc "workspace-pane-settings focus=${name}" "${log}" || true)"
    apply_before="$(grep -Fc "workspace-pane-settings control=${name} result=applied" "${log}" || true)"
    case "${name}" in
        new-worklane-placement) mnemonic=alt+n ;;
        pane-right-behavior) mnemonic=alt+r ;;
        pane-split-threshold) mnemonic=alt+t ;;
        settings-pane-labels) mnemonic=alt+l ;;
        settings-pane-borders) mnemonic=alt+b ;;
        settings-pane-project-icons) mnemonic=alt+i ;;
        focus-follows-mouse) mnemonic=alt+m ;;
        focus-follows-mouse-delay) mnemonic=alt+d ;;
        *) fail "no settings mnemonic for ${name}" ;;
    esac
    settings_key "${mnemonic}"
    for _ in $(seq 1 100); do
        if (( $(grep -Fc "workspace-pane-settings control=${name} result=applied" "${log}" || true) > apply_before )); then
            setting_activation="applied"
            return
        fi
        if (( $(grep -Fc "workspace-pane-settings focus=${name}" "${log}" || true) > focus_before )); then
            setting_activation="focused"
            return
        fi
        sleep 0.05
    done
    fail "accessible mnemonic did not reach settings control ${name}"
}

change_setting() {
    local name="$1" key="$2" before
    before="$(grep -Fc "workspace-pane-settings control=${name} result=applied" "${log}" || true)"
    # GTK mnemonics route through the rendered label/control relationship and
    # therefore remain stable across fonts, themes, and runner DPI. Keep both
    # compositors on the same physical keyboard path; fixed X11 coordinates
    # silently target the wrong row when hosted font metrics differ.
    focus_setting "${name}"
    if [[ "${setting_activation}" == focused ]]; then
        settings_key_current "${key}"
    elif [[ "${key}" != space ]]; then
        fail "dropdown mnemonic applied without opening its selection popup: ${name}"
    fi
    for _ in $(seq 1 200); do
        (( $(grep -Fc "workspace-pane-settings control=${name} result=applied" "${log}" || true) > before )) && return
        sleep 0.05
    done
    fail "physical settings control did not apply: ${name}"
}

# Drive every available control through the staged GTK page. X11 uses the
# controlled compositor pointer; Wayland uses the page's accessible mnemonics.
if [[ "${backend}" == x11 ]]; then
    change_setting new-worklane-placement "End Return"
    change_setting pane-right-behavior "Home Return"
    change_setting pane-split-threshold "End Return"
    change_setting settings-pane-labels space
    change_setting settings-pane-borders space
    change_setting settings-pane-project-icons space
    change_setting focus-follows-mouse space
    change_setting focus-follows-mouse space
    change_setting focus-follows-mouse-delay "End Return"
else
    # The controlled Cage profile provides a scoped virtual keyboard but no
    # settings-toplevel pointer injector. It qualifies real presentation,
    # exact projection, deep linking, and restart; every physical control and
    # multi-window continuity invariant is owned by the companion X11 cell.
    grep -Fq 'new_worklane_placement = "top"' "${config}" || fail "Wayland presentation changed placement without input"
    grep -Fq 'right_split_behavior = "alwaysSplit"' "${config}" || fail "Wayland presentation changed right-pane behavior without input"
fi

if [[ "${backend}" == x11 ]]; then
    grep -Fq 'new_worklane_placement = "end"' "${config}" || fail "placement control was not persisted"
    grep -Fq 'right_split_behavior = "adaptive"' "${config}" || fail "right-pane behavior was not persisted"
    grep -Fq 'visible_split_window_width = 2560' "${config}" || fail "threshold control was not persisted"
    grep -Fq 'show_labels = false' "${config}" || fail "pane-label control was not persisted"
    grep -Fq 'show_borders = true' "${config}" || fail "pane-border control was not persisted"
    grep -Fq 'show_project_icons = true' "${config}" || fail "project-icon control was not persisted"
    grep -Fq 'focus_follows_mouse = true' "${config}" || fail "focus-follow control was not restored enabled"
    grep -Fq 'focus_follows_mouse_delay = "short"' "${config}" || fail "focus delay was not persisted"
fi
grep -Fq 'smooth_scroll_enabled = false' "${config}" || fail "unavailable smooth-scroll value was destroyed"
grep -Fq 'inactive_opacity = 0.81' "${config}" || fail "unavailable opacity value was destroyed"

for window_id in window-1 window-2; do
    grep -Fq "config-live-projected window=${window_id}" "${log}" ||
        fail "settings never projected to ${window_id}"
done
for shell_pid in "${shell_pids[@]}"; do
    kill -0 "${shell_pid}" 2>/dev/null || fail "settings recreated or stopped shell ${shell_pid}"
done
[[ "$(grep -Fc 'zentty-linux: surface-owned pane=' "${log}" || true)" == "${surface_owned_before}" ]] ||
    fail "display settings recreated a Ghostty surface"
[[ "$(grep -F 'zentty-linux: topology=' "${log}" | sha256sum)" == "${topology_evidence_before}" ]] ||
    fail "settings emitted a topology mutation while applying display/focus controls"

settings_hidden_before="$(grep -Fc 'shortcut-settings hidden parent-presented=true' "${log}" || true)"
settings_key Escape
for _ in $(seq 1 100); do
    (( $(grep -Fc 'shortcut-settings hidden parent-presented=true' "${log}" || true) > settings_hidden_before )) && break
    sleep 0.05
done
(( $(grep -Fc 'shortcut-settings hidden parent-presented=true' "${log}" || true) > settings_hidden_before )) ||
    fail "Settings did not return physical input to the product window"

# The source-pinned adaptive policy is exercised at real viewport widths on
# both sides of every supported boundary. Each case uses a fresh real worklane
# so prior topology cannot influence the decision.
if [[ "${backend}" == x11 ]]; then
    ZENTTY_PRODUCT_WINDOW_ID="${first_product_window_id}"
    [[ "${ZENTTY_PRODUCT_WINDOW_ID}" =~ ^[1-9][0-9]*$ ]] || fail "real primary window disappeared before threshold checks"
    export ZENTTY_PRODUCT_WINDOW_ID
    xdotool windowfocus --sync "${ZENTTY_PRODUCT_WINDOW_ID}"
    sleep 0.1
    for threshold_value in 1200 1440 1680 1920 2560; do
        reload_before="$(grep -Fc 'config-reload result=applied windows=2 retained-sections=none' "${log}" || true)"
        # Establish the receipt boundary before editing. Under load the GIO
        # directory watcher can project the atomic sed rename before the next
        # shell command runs; sampling afterward incorrectly waits for a
        # second reload that will never occur.
        sed -i "s/^visible_split_window_width = .*/visible_split_window_width = ${threshold_value}/" "${config}"
        for _ in $(seq 1 200); do
            (( $(grep -Fc 'config-reload result=applied windows=2 retained-sections=none' "${log}" || true) > reload_before )) && break
            sleep 0.05
        done
        (( $(grep -Fc 'config-reload result=applied windows=2 retained-sections=none' "${log}" || true) > reload_before )) ||
            fail "threshold ${threshold_value} was not projected to both windows"

        below_width="$((threshold_value + 280))"
        below_resize_before="$(grep -Fc "window-size=${below_width}x700" "${log}" || true)"
        xdotool windowsize --sync "${ZENTTY_PRODUCT_WINDOW_ID}" "${below_width}" 700
        for _ in $(seq 1 100); do
            (( $(grep -Fc "window-size=${below_width}x700" "${log}" || true) > below_resize_before )) && break
            sleep 0.05
        done
        (( $(grep -Fc "window-size=${below_width}x700" "${log}" || true) > below_resize_before )) ||
            fail "window did not reach controlled width below threshold ${threshold_value}"
        zentty_product_ctrl_key "${backend}" t
        add_before="$(grep -Fc 'action=add-pane-right pane=' "${log}" || true)"
        zentty_product_ctrl_key "${backend}" d
        for _ in $(seq 1 100); do
            (( $(grep -Fc 'action=add-pane-right pane=' "${log}" || true) > add_before )) && break
            sleep 0.05
        done
        (( $(grep -Fc 'action=add-pane-right pane=' "${log}" || true) > add_before )) ||
            fail "adaptive threshold ${threshold_value}-1 did not add a stacked pane"

        at_width="$((threshold_value + 281))"
        at_resize_before="$(grep -Fc "window-size=${at_width}x700" "${log}" || true)"
        xdotool windowsize --sync "${ZENTTY_PRODUCT_WINDOW_ID}" "${at_width}" 700
        for _ in $(seq 1 100); do
            (( $(grep -Fc "window-size=${at_width}x700" "${log}" || true) > at_resize_before )) && break
            sleep 0.05
        done
        (( $(grep -Fc "window-size=${at_width}x700" "${log}" || true) > at_resize_before )) ||
            fail "window did not reach controlled width at threshold ${threshold_value}"
        zentty_product_ctrl_key "${backend}" t
        split_before="$(grep -Fc 'action=split-pane-right pane=' "${log}" || true)"
        zentty_product_ctrl_key "${backend}" d
        for _ in $(seq 1 100); do
            (( $(grep -Fc 'action=split-pane-right pane=' "${log}" || true) > split_before )) && break
            sleep 0.05
        done
        (( $(grep -Fc 'action=split-pane-right pane=' "${log}" || true) > split_before )) ||
            fail "adaptive threshold ${threshold_value} did not split visibly"
    done
fi

# Restart from the authoritative document and prove every normalized setting is
# loaded. The first process is deliberately terminated only after continuity
# checks, so restart cannot masquerade as a successful live update.
kill -TERM "${product_pid}"
wait "${product_pid}" 2>/dev/null || true
product_pid=""
restart_log="${run_root}/restart.log"
GDK_SCALE=1 GDK_DPI_SCALE=1 \
LD_LIBRARY_PATH="${bundle_lib}${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}" \
    "${product}" --command 'sleep 30' --state-directory "${state_directory}" \
    --no-session-restore >"${restart_log}" 2>&1 &
product_pid=$!
zentty_product_wait_for_log "${restart_log}" 'zentty-linux: terminal-ready' \
    "restarted staged product did not become ready" || fail "restart failed"
grep -Fq 'config-loaded path=' "${restart_log}" || fail "restart did not load authoritative config"

if [[ "${backend}" == x11 ]]; then
    control_evidence="all-physical-controls multi-window shell-continuity threshold-boundaries"
else
    control_evidence="exact-projection presentation-preservation companion-x11-owns-physical-controls"
fi
echo "rust-workspace-pane-settings-${backend}: PASS real-worklanes real-split real-ghostty-surfaces ${pointer_evidence} ${control_evidence} restart physical-settings-deep-link exact-config"
