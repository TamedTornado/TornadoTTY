#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
product="${ZENTTY_LINUX_BINARY:-${repo_root}/build/linux/bin/zentty-linux}"
if [[ "${product}" != /* ]]; then
    product="${repo_root}/${product}"
fi
forge="${repo_root}/target/release-safe/development_server"
run_root="$(mktemp -d)"
project="${run_root}/project"
state_directory="${run_root}/state"
fixture_bin="${run_root}/bin"
fixture_data="${run_root}/data"
forge_receipt="${run_root}/forge.receipt"
forge_body="${run_root}/forge.body"
open_receipt="${run_root}/open.receipt"
gh_receipt="${run_root}/gh.receipt"
log="${run_root}/product.log"
product_pid=""

# shellcheck source=linux/tests/lib/product-bundle
source "${repo_root}/linux/tests/lib/product-bundle"
# shellcheck source=linux/tests/lib/visual-evidence
source "${repo_root}/linux/tests/lib/visual-evidence"
forge_pid=""
backend="${GDK_BACKEND:-}"

fail() {
    [[ ! -f "${log}" ]] || cat "${log}" >&2
    echo "rust-git-review-context: error: $*" >&2
    exit 1
}

cleanup() {
    for pid in "${product_pid}" "${forge_pid}"; do
        if [[ "${pid}" =~ ^[1-9][0-9]*$ ]]; then
            kill -TERM "${pid}" 2>/dev/null || true
            wait "${pid}" 2>/dev/null || true
        fi
    done
    rm -rf -- "${run_root}"
}
trap cleanup EXIT

case "${backend}" in
    x11)
        [[ "${ZENTTY_NESTED_X11_SESSION_ID:-}" =~ ^[0-9a-f]{64}$ ]] ||
            fail "X11 scenario must run through linux/tests/nested-x11"
        command -v xdotool >/dev/null || fail "xdotool is required"
        ;;
    wayland)
        [[ "${ZENTTY_NESTED_WAYLAND_INPUT_SESSION_ID:-}" =~ ^[0-9a-f]{64}$ ]] ||
            fail "Wayland scenario must run through linux/tests/nested-wayland-input"
        command -v wtype >/dev/null || fail "wtype is required"
        ;;
    *) fail "GDK_BACKEND must be x11 or wayland" ;;
esac
for dependency in curl git grep head mktemp readelf sed seq sleep import identify compare convert jq; do
    command -v "${dependency}" >/dev/null || fail "${dependency} is required"
done
[[ -x "${product}" ]] || fail "staged product is missing: ${product}"
zentty_product_bundle_resolve "${product}" || fail "staged product bundle is invalid"
product="${ZENTTY_PRODUCT_BINARY}"
bundle_lib="${ZENTTY_PRODUCT_BUNDLE_LIB}"
[[ -x "${forge}" ]] || fail "controlled HTTP forge fixture is missing: ${forge}"


mkdir -p "${project}/nested/deep" "${state_directory}" "${fixture_bin}" \
    "${fixture_data}/applications"
mkdir -p "${XDG_CONFIG_HOME}/zentty" "${XDG_CONFIG_HOME}/ghostty" \
    "${XDG_CONFIG_HOME}/gtk-4.0"
if [[ "${backend}" == wayland ]]; then
    cat >"${XDG_CONFIG_HOME}/zentty/config.toml" <<'EOF'
[appearance]
theme_mode = "light"
EOF
else
    cat >"${XDG_CONFIG_HOME}/zentty/config.toml" <<'EOF'
[appearance]
theme_mode = "dark"
EOF
fi
cat >"${XDG_CONFIG_HOME}/ghostty/config" <<'EOF'
resize-overlay = never
cursor-opacity = 0
EOF
cat >"${XDG_CONFIG_HOME}/gtk-4.0/settings.ini" <<'EOF'
[Settings]
gtk-enable-animations=false
EOF
review_shell="${run_root}/review-shell"
cat >"${review_shell}" <<'EOF'
#!/usr/bin/env bash
set -u
reset_terminal() {
    printf '\033]2;Review context\a\033[2J\033[H\033[?25l'
}
reset_terminal
while IFS= read -r command; do
    eval "${command}"
    reset_terminal
done
EOF
chmod 700 "${review_shell}"
git -C "${project}" init -b feature/review-context >/dev/null
git -C "${project}" config user.email test@zentty.invalid
git -C "${project}" config user.name 'Zentty Integration'
printf 'fixture\n' >"${project}/README.md"
git -C "${project}" add README.md
git -C "${project}" commit -m fixture >/dev/null
git -C "${project}" remote add origin git@github.com:acme/rocket.git
printf 'dirty\n' >"${project}/dirty.txt"

"${forge}" --receipt "${forge_receipt}" >"${run_root}/forge.log" 2>&1 &
forge_pid=$!
for _ in $(seq 1 100); do
    [[ -s "${forge_receipt}" ]] && break
    sleep 0.05
done
[[ -s "${forge_receipt}" ]] || fail "controlled HTTP forge did not start"
forge_url="$(sed -n 's/^url=//p' "${forge_receipt}")"
[[ "${forge_url}" == http://127.0.0.1:*'/fixture' ]] || fail "forge published unsafe URL"

cat >"${fixture_bin}/gh" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
printf '%s\n' "$*" >"${ZENTTY_GH_RECEIPT}"
curl --fail --silent --show-error "${ZENTTY_FORGE_URL}" >"${ZENTTY_FORGE_BODY}"
printf '%s\n' '{"number":42,"url":"http://127.0.0.1:41777/acme/rocket/pull/42","isDraft":false,"state":"OPEN","reviewDecision":"APPROVED","mergeable":"CONFLICTING","statusCheckRollup":[{"status":"IN_PROGRESS"},{"status":"COMPLETED","conclusion":"FAILURE"}]}'
EOF
cat >"${fixture_bin}/zentty-open-receipt" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
[[ "$#" == 1 ]]
printf '%s\n' "$1" >>"${ZENTTY_OPEN_RECEIPT}"
EOF
cat >"${fixture_data}/applications/zentty-open-receipt.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=Zentty Open Receipt
Exec=${fixture_bin}/zentty-open-receipt %u
Terminal=false
MimeType=x-scheme-handler/http;x-scheme-handler/https;
EOF
cat >"${fixture_data}/applications/mimeapps.list" <<'EOF'
[Default Applications]
x-scheme-handler/http=zentty-open-receipt.desktop
x-scheme-handler/https=zentty-open-receipt.desktop
EOF
chmod 700 "${fixture_bin}/gh" "${fixture_bin}/zentty-open-receipt"

(
    cd "${project}/nested/deep"
    exec env \
        PATH="${fixture_bin}:${PATH}" \
        XDG_DATA_HOME="${fixture_data}" \
        ZENTTY_FORGE_URL="${forge_url}" \
        ZENTTY_FORGE_BODY="${forge_body}" \
        ZENTTY_GH_RECEIPT="${gh_receipt}" \
        ZENTTY_OPEN_RECEIPT="${open_receipt}" \
        GSK_RENDERER=cairo \
        LD_LIBRARY_PATH="${bundle_lib}${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}" \
        "${product}" --command "${review_shell}" \
        --state-directory "${state_directory}" --no-session-restore
) >"${log}" 2>&1 &
product_pid=$!

window_id=""
for _ in $(seq 1 300); do
    if [[ "${backend}" == x11 ]]; then
        window_id="$(xdotool search --name '^Zentty$' 2>/dev/null | head -1 || true)"
    else
        window_id=wayland-focused
    fi
    if [[ -n "${window_id}" ]] &&
        grep -Fq 'reference=feature/review-context dirty=true pr=42 refresh=fresh' "${log}"; then
        break
    fi
    sleep 0.05
done
[[ -n "${window_id}" ]] || fail "real Zentty window did not appear"
grep -Fq 'reference=feature/review-context dirty=true pr=42 refresh=fresh' "${log}" ||
    fail "real Git/gh context was not projected"
grep -Fxq 'ok' "${forge_body}" || fail "gh boundary did not call the controlled HTTP forge"
grep -Fq 'pr view feature/review-context --repo acme/rocket --json' "${gh_receipt}" ||
    fail "product did not invoke the source-compatible gh command"
grep -Fq 'terminal-ready-pane=pane-1' "${log}" ||
    fail "real review-context Ghostty surface was not ready"
grep -Fq 'title-pane=pane-1 value=Review context' "${log}" ||
    fail "review visual terminal did not settle deterministic content"
grep -Fq 'project-icon-projected owner=window-chrome fallback=folder-symbolic decoded=true' "${log}" ||
    fail "working-directory context did not project the source-compatible fallback icon"

capture_review_visual() {
    local scenario_id image
    if [[ "${backend}" == x11 ]]; then
        scenario_id=review-dark-x11
        image="${run_root}/${scenario_id}.png"
        xdotool windowsize --sync "${window_id}" 1400 800
        for _ in $(seq 1 100); do
            grep -Fq 'zentty-linux: window-size=1400x800' "${log}" && break
            sleep 0.05
        done
        grep -Fq 'zentty-linux: window-size=1400x800' "${log}" ||
            fail "review X11 window did not reach controlled geometry"
        xdotool mousemove --sync 2000 1500
        sleep 0.3
        import -silent -window "${window_id}" "${image}"
    else
        scenario_id=review-light-wayland
        image="${run_root}/${scenario_id}.png"
        outer="${ZENTTY_NESTED_WAYLAND_OUTER_X11_WINDOW:?}"
        xdotool mousemove --sync --window "${outer}" 1 1
        sleep 0.3
        import -silent -window "${outer}" "${image}"
    fi
    zentty_visual_publish "${scenario_id}" linux/tests/rust-git-review-context "${image}" -
}

capture_review_visual

open_palette() {
    if [[ "${backend}" == x11 ]]; then
        xdotool windowfocus --sync "${window_id}"
        xdotool key --window "${window_id}" ctrl+shift+p
    else
        wtype -M ctrl -M shift -k p -m shift -m ctrl
    fi
}
type_text() {
    if [[ "${backend}" == x11 ]]; then
        xdotool type --window "${window_id}" --delay 4 -- "$1"
    else
        wtype -- "$1"
    fi
}
activate_first() {
    if [[ "${backend}" == x11 ]]; then
        xdotool key --window "${window_id}" Down Return
    else
        wtype -k Down -k Return
    fi
}
activate_palette_action() {
    local query="$1"
    open_palette
    type_text "${query}"
    for _ in $(seq 1 100); do
        grep -Fq "command-palette=query value=\"${query}\" results=1" "${log}" && break
        sleep 0.05
    done
    grep -Fq "command-palette=query value=\"${query}\" results=1" "${log}" ||
        fail "palette action was absent: ${query}"
    activate_first
}

submit_terminal_command() {
    local command="$1"
    type_text "${command}"
    if [[ "${backend}" == x11 ]]; then
        xdotool key --window "${window_id}" Return
    else
        wtype -k Return
    fi
}

submit_terminal_command 'git switch -c process-refresh'
for _ in $(seq 1 200); do
    grep -Fq 'reference=process-refresh dirty=true pr=42 refresh=fresh' "${log}" && break
    sleep 0.05
done
grep -Fq 'reference=process-refresh dirty=true pr=42 refresh=fresh' "${log}" ||
    fail "terminal process completion did not refresh changed Git context"

git -C "${project}" switch -c filesystem-refresh >/dev/null
for _ in $(seq 1 200); do
    grep -Fq 'reference=filesystem-refresh dirty=true pr=42 refresh=fresh' "${log}" && break
    sleep 0.05
done
grep -Fq 'reference=filesystem-refresh dirty=true pr=42 refresh=fresh' "${log}" ||
    fail "real Git filesystem change did not refresh context"

submit_terminal_command \
    "printf '%s' '{\"version\":1,\"event\":\"agent.idle\",\"agent\":{\"name\":\"Codex\"},\"session\":{\"id\":\"git-review-agent-refresh\"}}' | \"\$ZENTTY_CLI_BIN\" ipc agent-event"
for _ in $(seq 1 200); do
    grep -Fq 'kind=agent.idle session=git-review-agent-refresh' "${log}" &&
        grep -Fq 'pane=pane-1 refresh=agent-completion-requested' "${log}" && break
    sleep 0.05
done
grep -Fq 'kind=agent.idle session=git-review-agent-refresh' "${log}" ||
    fail "authenticated agent completion did not reach the real product reducer"
grep -Fq 'pane=pane-1 refresh=agent-completion-requested' "${log}" ||
    fail "agent completion did not request a Git/review context refresh"

context_receipts_before_manual="$(
    grep -Fc 'reference=filesystem-refresh dirty=true pr=42 refresh=fresh' "${log}" || true
)"
activate_palette_action 'Refresh Git and Review Status'
for _ in $(seq 1 160); do
    [[ "$(grep -Fc 'reference=filesystem-refresh dirty=true pr=42 refresh=fresh' "${log}" || true)" -gt "${context_receipts_before_manual}" ]] && break
    sleep 0.05
done
[[ "$(grep -Fc 'reference=filesystem-refresh dirty=true pr=42 refresh=fresh' "${log}" || true)" -gt "${context_receipts_before_manual}" ]] ||
    fail "manual refresh did not traverse the real resolver"

activate_palette_action 'Open Branch on Remote'
activate_palette_action 'Open Pull Request'
for _ in $(seq 1 100); do
    [[ "$(wc -l <"${open_receipt}" 2>/dev/null || true)" -ge 2 ]] && break
    sleep 0.05
done
grep -Fxq 'https://github.com/acme/rocket/tree/filesystem-refresh' "${open_receipt}" ||
    fail "branch open did not receive the validated remote URL"
grep -Fxq 'http://127.0.0.1:41777/acme/rocket/pull/42' "${open_receipt}" ||
    fail "pull-request open did not receive the controlled validated URL"

echo "rust-git-review-context-${backend}: PASS real-git real-gh-http-forge nested-cwd dirty branch pr precedence process-refresh filesystem-refresh agent-completion-refresh manual-refresh safe-open"
