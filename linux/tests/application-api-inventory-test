#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
runner="${repo_root}/linux/tests/application-api-inventory"
source_inventory="${repo_root}/docs/architecture/zentty-application-api-v1.json"
source_cli="${repo_root}/docs/design/zentty-cli-source-contract.json"
temp_dir="$(mktemp -d)"
trap 'rm -rf -- "${temp_dir}"' EXIT

expect_rejected() {
    local name="$1"
    local expected="$2"
    if "${runner}" "${temp_dir}/${name}.json" "${source_cli}" >"${temp_dir}/${name}.log" 2>&1; then
        echo "application-api-inventory-test: ${name} unexpectedly passed" >&2
        exit 1
    fi
    grep -Fq "${expected}" "${temp_dir}/${name}.log" || {
        cat "${temp_dir}/${name}.log" >&2
        echo "application-api-inventory-test: ${name} lacked expected failure" >&2
        exit 1
    }
}

"${runner}" >/dev/null

jq '.operations |= .[:-1]' "${source_inventory}" >"${temp_dir}/missing-operation.json"
expect_rejected missing-operation "schema or closed enums failed"

jq '.operations[0].scope = "socket"' "${source_inventory}" >"${temp_dir}/unknown-scope.json"
expect_rejected unknown-scope "schema or closed enums failed"

jq '.operations[1].id = .operations[0].id | .operations[1].wire_name = .operations[0].wire_name | .operations[1].scope = .operations[0].scope' \
    "${source_inventory}" >"${temp_dir}/duplicate-operation.json"
expect_rejected duplicate-operation "operation IDs are duplicated"

jq '.operations[0].cli_contract_ids = ["not-a-command"]' \
    "${source_inventory}" >"${temp_dir}/unknown-cli.json"
expect_rejected unknown-cli "CLI command coverage is incomplete"

jq '.operations[0].gui_entry_points = ["missing-action"]' \
    "${source_inventory}" >"${temp_dir}/missing-gui-action.json"
expect_rejected missing-gui-action "GUI entry point is not registered"

jq '.operations[0].external = false' "${source_inventory}" >"${temp_dir}/false-public-classification.json"
expect_rejected false-public-classification "external API classification drifted"

jq '.error_categories[0] = "miscellaneous"' "${source_inventory}" >"${temp_dir}/unknown-error-category.json"
expect_rejected unknown-error-category "schema or closed enums failed"

echo "application-api-inventory runner negative tests passed"
