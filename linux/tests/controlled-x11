#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
scenario="${ZENTTY_CONTROLLED_X11_SCENARIO:-all}"
iterations="${ZENTTY_CONTROLLED_X11_ITERATIONS:-1}"
nested_x11="${ZENTTY_NESTED_X11_WRAPPER:-${repo_root}/linux/tests/nested-x11}"
resize_driver="${ZENTTY_EXTERNAL_RESIZE_DRIVER:-${repo_root}/linux/tests/external-resize-driver}"
key_driver="${ZENTTY_PHYSICAL_KEY_DRIVER:-${repo_root}/linux/tests/physical-key-driver}"
if [[ "${scenario}" != "all" && "${scenario}" != "resize" &&
    "${scenario}" != "physical-key" ]]; then
    echo "error: ZENTTY_CONTROLLED_X11_SCENARIO must be all, resize, or physical-key" >&2
    exit 64
fi
if ! [[ "${iterations}" =~ ^[1-9][0-9]*$ ]]; then
    echo "error: ZENTTY_CONTROLLED_X11_ITERATIONS must be a positive integer" >&2
    exit 64
fi

if [[ -z "${ZENTTY_NESTED_X11_SESSION_ID:-}" ]]; then
    if [[ ! -x "${nested_x11}" ]]; then
        echo "controlled-x11: missing prerequisite ${nested_x11}" >&2
        exit 77
    fi
    exec "${nested_x11}" "${BASH_SOURCE[0]}"
fi

[[ "${ZENTTY_NESTED_X11_SESSION_ID}" =~ ^[0-9a-f]{64}$ ]] || {
    echo "error: invalid nested X11 session identity" >&2
    exit 1
}
for dependency in timeout xdotool; do
    if ! command -v "${dependency}" >/dev/null; then
        echo "controlled-x11: missing prerequisite ${dependency}" >&2
        exit 77
    fi
done
for driver in "${resize_driver}" "${key_driver}"; do
    [[ -x "${driver}" ]] || {
        echo "controlled-x11: missing executable driver ${driver}" >&2
        exit 77
    }
done

for ((iteration = 1; iteration <= iterations; iteration++)); do
    if [[ "${scenario}" == "all" || "${scenario}" == "resize" ]]; then
        timeout 30s "${resize_driver}"
    fi
    if [[ "${scenario}" == "all" || "${scenario}" == "physical-key" ]]; then
        timeout 30s "${key_driver}"
    fi
done

echo "Zentty Linux controlled X11 environment passed"
