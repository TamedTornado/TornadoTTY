#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
product="${ZENTTY_LINUX_BINARY:-${repo_root}/build/linux/bin/zentty-linux}"
ghostty_root="${GHOSTTY_SOURCE_DIR:-${repo_root}/build/linux-deps/ghostty}"
backend="${GDK_BACKEND:-}"
log=""

fail() {
    if [[ -n "${log}" && -f "${log}" ]]; then
        cat "${log}" >&2
    fi
    echo "rust-workspace-actions: error: $*" >&2
    exit 1
}

[[ "${backend}" == wayland || "${backend}" == x11 ]] ||
    fail "GDK_BACKEND must be wayland or x11"
if [[ "${backend}" == wayland ]]; then
    [[ "${ZENTTY_NESTED_WAYLAND_SESSION_ID:-}" =~ ^[0-9a-f]{64}$ ]] ||
        fail "Wayland workspace actions must run through linux/tests/nested-wayland"
else
    [[ "${ZENTTY_NESTED_X11_SESSION_ID:-}" =~ ^[0-9a-f]{64}$ ]] ||
        fail "X11 workspace actions must run through linux/tests/nested-x11"
fi
for dependency in jq mktemp readelf timeout; do
    command -v "${dependency}" >/dev/null || fail "${dependency} is required"
done
[[ -x "${product}" ]] || fail "delivered Rust product is not built: ${product}"
[[ -f "${ghostty_root}/zig-out/lib/libghostty-gtk-embed.so" ]] ||
    fail "pinned Ghostty library is not built"

layer_runpath="$(
    readelf -d "${ghostty_root}/zig-out/lib/libghostty-gtk-embed.so" |
        sed -n 's/.*Library runpath: \[\([^]]*\)\].*/\1/p' |
        cut -d: -f1
)"
[[ "${layer_runpath}" == .zig-cache/* ]] ||
    fail "Ghostty library has no pinned relative layer-shell runpath"
layer_directory="${ghostty_root}/${layer_runpath}"

log="$(mktemp)"
state_dir="$(mktemp -d)"
persistence_log="$(mktemp)"
trap 'rm -f -- "${log}" "${persistence_log}"; rm -rf -- "${state_dir}"' EXIT

child_command='printf "\033]2;zentty-workspace-$$\a"; sleep 5'
set +e
timeout --foreground --kill-after=2s 20s \
    env LD_LIBRARY_PATH="${ghostty_root}/zig-out/lib:${layer_directory}${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}" \
    "${product}" \
    --command "${child_command}" \
    --exercise-workspace-actions \
    --quit-after-last-terminal-exit >"${log}" 2>&1
status=$?
set -e

if (( status != 0 )); then
    fail "workspace action scenario exited ${status}"
fi

grep -Fxq 'zentty-linux: workspace-action-scenario complete' "${log}" ||
    fail "the delivered product did not complete its named GTK action sequence"
grep -Fxq 'zentty-linux: action=new-worklane id=worklane-2 pane=pane-2' "${log}" ||
    fail "new-worklane action did not create its real pane"
grep -Fxq 'zentty-linux: action=split-pane-right pane=pane-3' "${log}" ||
    fail "active second worklane did not split"
grep -Fxq 'zentty-linux: action=select-worklane id=worklane-1' "${log}" ||
    fail "select-worklane action did not run"
grep -Fxq 'zentty-linux: action=split-pane-right pane=pane-4' "${log}" ||
    fail "reselected first worklane did not split"
grep -Fxq 'zentty-linux: action=rename-worklane id=worklane-1 title="  Frontend  "' "${log}" ||
    fail "rename-worklane action did not preserve action input for trimming"
grep -Fxq 'zentty-linux: action=rename-pane id=pane-4 title="  Review Shell  "' "${log}" ||
    fail "rename-pane action did not preserve action input for trimming"
grep -Fxq 'zentty-linux: action=set-worklane-color id=worklane-1 color=red' "${log}" ||
    fail "exact worklane color action did not run"
grep -Fxq 'zentty-linux: action=move-worklane target=1' "${log}" ||
    fail "worklane reorder action did not run"
grep -Fxq 'zentty-linux: action=move-worklane id=worklane-1 direction=down' "${log}" ||
    fail "targeted worklane reorder action did not run"
grep -Fxq 'zentty-linux: action=move-pane-left' "${log}" ||
    fail "pane reorder action did not run"
grep -Fxq 'zentty-linux: action=split-pane-below pane=pane-5' "${log}" ||
    fail "vertical split action did not create its real pane"
grep -Fxq 'zentty-linux: action=move-pane-up' "${log}" ||
    fail "vertical move-up action did not run"
grep -Fxq 'zentty-linux: action=move-pane-down' "${log}" ||
    fail "vertical move-down action did not run"
grep -Fxq 'zentty-linux: action=move-pane-to-worklane pane=pane-5 target=worklane-2' "${log}" ||
    fail "cross-worklane pane transfer action did not run"
grep -Fxq 'zentty-linux: action=close-worklane id=worklane-1 panes=2' "${log}" ||
    fail "targeted worklane close did not dispose its two real panes"
grep -Fxq 'zentty-linux: topology=worklane-2[title=none,color=none]:pane-2,pane-3,pane-5*|worklane-1[title=Frontend,color=red]:pane-4,pane-1' "${log}" ||
    fail "final worklane/pane topology or active selection is wrong"
grep -Fxq 'zentty-linux: geometry=worklane-2:column-pane-2[pane-2],column-pane-3[pane-3],column-pane-5[pane-5]|worklane-1:column-worklane-1[pane-4,pane-1]' "${log}" ||
    fail "final horizontal, vertical, and cross-worklane pane geometry is wrong"
grep -Fxq 'zentty-linux: sidebar-card id=worklane-1 panes=2 active=false title=Some("Frontend")' "${log}" ||
    fail "compound source worklane card did not render its transferred pane count"
grep -Fxq 'zentty-linux: sidebar-card id=worklane-2 panes=3 active=true title=None' "${log}" ||
    fail "compound destination worklane card did not render its transferred pane count"

[[ "$(grep -Fxc 'zentty-linux: terminal-ready' "${log}" || true)" -eq 5 ]] ||
    fail "not every product pane initialized a real Ghostty terminal"
[[ "$(grep -Fxc 'zentty-linux: child-exited' "${log}" || true)" -eq 3 ]] ||
    fail "the three retained PTY children did not report their natural exits"
native_closed="$(grep -Fc 'info(surface): surface closed addr=' "${log}" || true)"
if [[ "${native_closed}" -ne 5 ]]; then
    fail "expected 2 explicitly closed and 3 naturally exited Ghostty surfaces, observed ${native_closed}"
fi
[[ "$(sed -n 's/^zentty-linux: title=zentty-workspace-\([0-9][0-9]*\)$/\1/p' "${log}" | sort -u | wc -l)" -eq 5 ]] ||
    fail "the five panes did not prove distinct real PTY child processes"
if grep -Eq 'panicked at|thread caused non-unwinding panic|RefCell already borrowed|CRITICAL: Gtk|has a parent GtkBox' "${log}"; then
    fail "the GTK action scenario reported a panic or lifecycle critical"
fi

set +e
timeout --foreground --kill-after=2s 20s \
    env LD_LIBRARY_PATH="${ghostty_root}/zig-out/lib:${layer_directory}${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}" \
    "${product}" \
    --command "${child_command}" \
    --state-directory "${state_dir}" \
    --no-session-restore \
    --exercise-workspace-actions \
    --quit-after-workspace-actions >"${persistence_log}" 2>&1
persistence_status=$?
set -e
if (( persistence_status != 0 )); then
    cat "${persistence_log}" >&2
    fail "cross-worklane persistence scenario exited ${persistence_status}"
fi
if grep -Eq 'panicked at|thread caused non-unwinding panic|RefCell already borrowed|CRITICAL: Gtk|has a parent GtkBox' "${persistence_log}"; then
    cat "${persistence_log}" >&2
    fail "the persistence shutdown reported a panic or lifecycle critical"
fi

snapshot="${state_dir}/restore-snapshot.json"
jq -e '
    .workspace.windows[0] |
    .activeWorklaneID == "worklane-2" and
    [.worklanes[].id] == ["worklane-2", "worklane-1"] and
    (.worklanes[] | select(.id == "worklane-2") |
        .focusedColumnID == "column-pane-5" and
        [.columns[].panes[].id] == ["pane-2", "pane-3", "pane-5"]) and
    (.worklanes[] | select(.id == "worklane-1") |
        .title == "Frontend" and .color == "red" and
        [.columns[].panes[].id] == ["pane-4", "pane-1"] and
        (.columns[].panes[] | select(.id == "pane-4") | .customTitle == "Review Shell"))
' "${snapshot}" >/dev/null || {
    cat "${persistence_log}" >&2
    fail "clean product snapshot did not preserve the cross-worklane transfer"
}

echo "Rust workspace actions passed: ${backend}, worklanes=2, panes=5, real-pty-children=5, persisted-transfer=real"
