#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
product="${ZENTTY_LINUX_BINARY:-${repo_root}/build/linux/bin/zentty-linux}"
backend="${GDK_BACKEND:-}"
run_root="$(mktemp -d)"
state_directory="${run_root}/state"
receipt="${run_root}/notifications.receipt"
cli_receipt="${run_root}/cli-endpoint.receipt"
cli_child="${run_root}/cli-child"
audio_fixture="${run_root}/Friendly notification.wav"
alsa_config="${run_root}/asound.conf"
daemon_log="${run_root}/notification-daemon.log"
log=""
launch_count=0
product_pid=""
event_receipt=""
daemon_pid=""
monitor_pid=""
wm_pid=""

# shellcheck disable=SC1091
source "${repo_root}/linux/tests/lib/product-input"
# shellcheck source=linux/tests/lib/product-bundle
source "${repo_root}/linux/tests/lib/product-bundle"
# shellcheck source=linux/tests/lib/product-receipts
source "${repo_root}/linux/tests/lib/product-receipts"

fail() {
    [[ ! -f "${daemon_log}" ]] || cat "${daemon_log}" >&2
    for product_log in "${run_root}"/product-*.log; do
        [[ ! -f "${product_log}" ]] || cat "${product_log}" >&2
    done
    echo "rust-notifications-settings: error: $*" >&2
    exit 1
}

cleanup() {
    [[ ! "${product_pid}" =~ ^[1-9][0-9]*$ ]] || kill -TERM "${product_pid}" 2>/dev/null || true
    [[ ! "${monitor_pid}" =~ ^[1-9][0-9]*$ ]] || kill -TERM "${monitor_pid}" 2>/dev/null || true
    [[ ! "${daemon_pid}" =~ ^[1-9][0-9]*$ ]] || kill -TERM "${daemon_pid}" 2>/dev/null || true
    [[ ! "${wm_pid}" =~ ^[1-9][0-9]*$ ]] || kill -TERM "${wm_pid}" 2>/dev/null || true
    [[ ! "${product_pid}" =~ ^[1-9][0-9]*$ ]] || wait "${product_pid}" 2>/dev/null || true
    [[ ! "${monitor_pid}" =~ ^[1-9][0-9]*$ ]] || wait "${monitor_pid}" 2>/dev/null || true
    [[ ! "${daemon_pid}" =~ ^[1-9][0-9]*$ ]] || wait "${daemon_pid}" 2>/dev/null || true
    [[ ! "${wm_pid}" =~ ^[1-9][0-9]*$ ]] || wait "${wm_pid}" 2>/dev/null || true
    rm -rf -- "${run_root}"
}
trap cleanup EXIT

case "${backend}" in
    x11)
        [[ "${ZENTTY_NESTED_X11_SESSION_ID:-}" =~ ^[0-9a-f]{64}$ ]] ||
        fail "X11 scenario must run through linux/tests/nested-x11"
        command -v openbox >/dev/null || fail "openbox is required for the real native chooser"
        openbox >"${run_root}/openbox.log" 2>&1 &
        wm_pid=$!
        for _ in {1..200}; do
            xprop -root _NET_SUPPORTING_WM_CHECK 2>/dev/null | grep -Fq 'window id #' && break
            sleep 0.05
        done
        xprop -root _NET_SUPPORTING_WM_CHECK 2>/dev/null | grep -Fq 'window id #' ||
            fail "controlled X11 window manager did not become ready"
        ;;
    wayland)
        [[ "${ZENTTY_NESTED_WAYLAND_INPUT_SESSION_ID:-}" =~ ^[0-9a-f]{64}$ ]] ||
            fail "Wayland scenario must run through linux/tests/nested-wayland-input"
        ;;
    *) fail "GDK_BACKEND must be x11 or wayland" ;;
esac
[[ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ]] || fail "a private session bus is required"
export GTK_USE_PORTAL=0
export GIO_USE_VFS=local
export XDG_CURRENT_DESKTOP=ZenttyQualification
[[ -x "${product}" ]] || fail "staged product is missing: ${product}"
zentty_product_bundle_resolve "${product}" || fail "staged product bundle is invalid"
product="${ZENTTY_PRODUCT_BINARY}"
bundle_lib="${ZENTTY_PRODUCT_BUNDLE_LIB}"
[[ -x /usr/lib/notification-daemon/notification-daemon ]] ||
    fail "Ubuntu notification-daemon is required"
command -v dbus-monitor >/dev/null || fail "dbus-monitor is required"
command -v gdbus >/dev/null || fail "gdbus is required"
for dependency in aplay ffmpeg ffprobe stat; do
    command -v "${dependency}" >/dev/null || fail "${dependency} is required"
done
if [[ "${backend}" == x11 ]]; then
    command -v xclip >/dev/null || fail "xclip is required for the real chooser"
fi
ffmpeg -nostdin -v error -f lavfi -i sine=frequency=523.25:duration=0.15 \
    -y "${audio_fixture}"
cat >"${alsa_config}" <<'EOF'
pcm.zentty_dynamic { type null }
EOF
export ALSA_CONFIG_PATH="${alsa_config}"
export ZENTTY_AUDIO_DEVICE=zentty_dynamic
cat >"${cli_child}" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
umask 077
printf 'socket=%s\ntoken=%s\ncli=%s\n' \
    "${ZENTTY_INSTANCE_SOCKET}" "${ZENTTY_PANE_TOKEN}" "${ZENTTY_CLI_BIN}" \
    >"${ZENTTY_NOTIFICATION_CLI_RECEIPT}"
exec sleep 120
EOF
chmod 0700 "${cli_child}"

mkdir -p "${state_directory}" "${XDG_CONFIG_HOME}/zentty"
config="${XDG_CONFIG_HOME}/zentty/config.toml"
cat >"${config}" <<'EOF'
# preserve notification settings comment
future_root = 7
[notifications]
sound_name = ""
future_notification = true
EOF

# notification-daemon 3.20 is an X11 notification server. Keep that real
# service on the wrapper-owned Xvfb transport while the product itself uses
# the requested GTK backend; D-Bus notification semantics are display-neutral.
GDK_BACKEND=x11 /usr/lib/notification-daemon/notification-daemon >"${daemon_log}" 2>&1 &
daemon_pid=$!
for _ in {1..100}; do
    has_owner="$(gdbus call --session --dest org.freedesktop.DBus \
        --object-path /org/freedesktop/DBus \
        --method org.freedesktop.DBus.NameHasOwner org.freedesktop.Notifications 2>/dev/null || true)"
    [[ "${has_owner}" == '(true,)' ]] && break
    kill -0 "${daemon_pid}" 2>/dev/null || fail "notification-daemon exited"
    sleep 0.02
done
[[ "${has_owner:-}" == '(true,)' ]] || fail "notification-daemon did not own its bus name"
dbus-monitor --session \
    "type='method_call',interface='org.freedesktop.Notifications',member='Notify'" \
    >"${receipt}" 2>&1 &
monitor_pid=$!
sleep 0.05

start_product() {
    launch_count=$((launch_count + 1))
    log="${run_root}/product-${launch_count}.log"
    event_receipt="${run_root}/product-events-${launch_count}.ndjson"
    tornadotty_product_receipt_prepare "${product}" "${event_receipt}" ||
        fail "typed product receipt could not be prepared for launch ${launch_count}"
    rm -f -- "${cli_receipt}"
    GDK_SCALE=1 \
    GDK_DPI_SCALE=1 \
    ZENTTY_NOTIFICATION_CLI_RECEIPT="${cli_receipt}" \
    LD_LIBRARY_PATH="${bundle_lib}${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}" \
        "${product}" \
        --command "${cli_child}" \
        --state-directory "${state_directory}" \
        --no-session-restore >"${log}" 2>&1 &
    product_pid=$!
    zentty_product_prepare_input "${backend}" "${log}" ||
        fail "physical product input was unavailable"
    for _ in {1..100}; do [[ -s "${cli_receipt}" ]] && break; sleep 0.02; done
    [[ -s "${cli_receipt}" ]] || fail "real pane did not publish its staged CLI endpoint"
}

stop_product() {
    kill -TERM "${product_pid}" 2>/dev/null || true
    wait "${product_pid}" 2>/dev/null || true
    product_pid=""
}

main_key() {
    if [[ "${backend}" == x11 ]]; then
        xdotool windowfocus --sync "${ZENTTY_PRODUCT_WINDOW_ID}"
        xdotool key "$1"
    elif zentty_product_uses_xdotool "${backend}"; then
        zentty_product_xdotool_key "$1"
    else
        case "$1" in
            ctrl+shift+*) wtype -M ctrl -M shift -k "${1#ctrl+shift+}" -m shift -m ctrl ;;
            ctrl+*) wtype -M ctrl -k "${1#ctrl+}" -m ctrl ;;
            alt+*) wtype -M alt -k "${1#alt+}" -m alt ;;
            shift+*) wtype -M shift -k "${1#shift+}" -m shift ;;
            *) wtype -k "$1" ;;
        esac
    fi
}

settings_key() {
    if [[ "${backend}" == x11 ]]; then
        xdotool windowfocus --sync "${settings_window}"
        xdotool key "$1"
    else
        case "$1" in
            ctrl+shift+*) wtype -M ctrl -M shift -k "${1#ctrl+shift+}" -m shift -m ctrl ;;
            ctrl+*) wtype -M ctrl -k "${1#ctrl+}" -m ctrl ;;
            alt+*) wtype -M alt -k "${1#alt+}" -m alt ;;
            *) wtype -k "$1" ;;
        esac
    fi
}

type_text() {
    if [[ "${backend}" == x11 ]]; then
        xdotool windowfocus --sync "${ZENTTY_PRODUCT_WINDOW_ID}"
        xdotool type --delay 5 -- "$1"
    elif zentty_product_uses_xdotool "${backend}"; then
        xdotool type --delay 5 -- "$1"
    else
        wtype -d 5 -- "$1"
    fi
}

open_notification_settings() {
    main_key ctrl+shift+p
    type_text 'Notifications Settings'
    zentty_product_wait_for_log "${log}" 'command-palette=query value="Notifications Settings" results=1' \
        "Notifications Settings did not resolve uniquely" || fail "notification palette route failed"
    main_key Down
    main_key Return
    tornadotty_product_receipt_wait "${event_receipt}" 10000 1 \
        action select-notifications-settings completed - >/dev/null ||
        fail "notification deep-link lacked typed completion"
    tornadotty_product_receipt_wait "${event_receipt}" 10000 1 \
        focus-widget settings-window >/dev/null ||
        fail "notification settings lacked typed activation"
    settings_window=""
    if [[ "${backend}" == x11 ]]; then
        for _ in {1..100}; do
            settings_window="$(xdotool search --onlyvisible --name '^Tornado TTY Settings$' 2>/dev/null | tail -1 || true)"
            [[ "${settings_window}" =~ ^[1-9][0-9]*$ ]] && break
            sleep 0.02
        done
        [[ "${settings_window}" =~ ^[1-9][0-9]*$ ]] || fail "settings window did not appear"
        xdotool windowfocus --sync "${settings_window}"
    fi
}

start_product
open_notification_settings

settings_key alt+n
zentty_product_wait_for_log "${log}" 'notification-settings focus=visible-pane' \
    "visible-pane mnemonic did not focus the real GTK switch" ||
    fail "visible-pane notification focus failed"
settings_key space
zentty_product_wait_for_log "${log}" \
    'notification-settings action=visible-pane result=applied value=false' \
    "visible-pane notification preference did not persist through the real GTK switch" ||
    fail "visible-pane notification toggle failed"
grep -Fq 'notify_when_pane_visible = false' "${config}" ||
    fail "visible-pane notification preference is absent from durable config"

settings_key alt+t
tornadotty_product_receipt_wait "${event_receipt}" 10000 1 \
    action send-test-notification completed - >/dev/null ||
    fail "Send Test lacked typed completion"
for _ in {1..100}; do [[ -s "${receipt}" ]] && break; sleep 0.02; done
grep -Fq 'string "Tornado TTY"' "${receipt}" ||
    fail "D-Bus monitor did not receive the source test payload"
grep -Fq 'string "This is a test notification."' "${receipt}" ||
    fail "D-Bus monitor did not receive the source test body"

cli_socket="$(sed -n 's/^socket=//p' "${cli_receipt}")"
cli_token="$(sed -n 's/^token=//p' "${cli_receipt}")"
cli_binary="$(sed -n 's/^cli=//p' "${cli_receipt}")"
[[ "${cli_socket}" == /* && "${cli_token}" =~ ^[0-9a-f]{64}$ && -x "${cli_binary}" ]] ||
    fail "real pane published an invalid CLI endpoint"
env ZENTTY_INSTANCE_SOCKET="${cli_socket}" ZENTTY_PANE_TOKEN="${cli_token}" \
    "${cli_binary}" notify --title 'CLI D-Bus title' --subtitle 'CLI subtitle' \
    --body $'CLI body one\nCLI body two' --silent
zentty_product_wait_for_log "${log}" \
    'cli-notification desktop=sent service-id=2 pane=pane-1 silent=true' \
    "public CLI notification did not reach the freedesktop service" ||
    fail "public CLI notification delivery failed"
for _ in {1..100}; do
    grep -Fq 'string "CLI D-Bus title"' "${receipt}" && break
    sleep 0.02
done
grep -Fq 'string "CLI D-Bus title"' "${receipt}" ||
    fail "D-Bus monitor did not receive the public CLI title"
grep -Fq 'string "CLI subtitle' "${receipt}" ||
    fail "D-Bus monitor did not receive the public CLI subtitle/body payload"
grep -Fq 'string "suppress-sound"' "${receipt}" ||
    fail "silent public CLI notification lacked the suppress-sound hint"

# Import through the staged GTK page and the native chooser. The installed
# preview crosses the real aplay/ALSA null-device boundary rather than a mock.
if [[ "${backend}" == wayland ]]; then
    # Cage/Wayland reserves some Alt chords depending on the host keymap. Start
    # from the settings search field, whose shortcut is already qualified, and
    # traverse the real GTK focus chain until the product reports Import Audio.
    settings_key ctrl+f
    for _ in {1..40}; do
        focus_before="$(grep -Fc 'zentty-linux: settings-focus widget=' "${log}" || true)"
        settings_key Tab
        zentty_product_wait_for_log_count "${log}" \
            'zentty-linux: settings-focus widget=' "$((focus_before + 1))" \
            "settings focus did not acknowledge one physical Tab" ||
            fail "settings focus traversal lost physical input"
        [[ "$(grep -F 'zentty-linux: settings-focus widget=' "${log}" | tail -1)" == \
            'zentty-linux: settings-focus widget=notification-sound-import' ]] && break
    done
    [[ "$(grep -F 'zentty-linux: settings-focus widget=' "${log}" | tail -1)" == \
        'zentty-linux: settings-focus widget=notification-sound-import' ]] ||
        fail "custom import focus failed"
    settings_key Return
else
    settings_key alt+i
fi
zentty_product_wait_for_log "${log}" \
    'notification-settings action=import-custom result=chooser-opened' \
    "Import Audio did not open the native chooser" || fail "custom import control failed"
if [[ "${backend}" == x11 ]]; then
    chooser_window=""
    for _ in {1..200}; do
        chooser_window="$(
            xdotool search --onlyvisible --name \
                '^(Import Notification Audio|Open File)$' 2>/dev/null | tail -1 || true
        )"
        [[ "${chooser_window}" =~ ^[1-9][0-9]*$ ]] && break
        sleep 0.05
    done
    [[ "${chooser_window}" =~ ^[1-9][0-9]*$ ]] || fail "native audio chooser did not map"
    xdotool windowactivate --sync "${chooser_window}"
    xdotool key --clearmodifiers ctrl+l
    sleep 0.1
    printf '%s' "${audio_fixture}" | xclip -selection clipboard -in
    xdotool key --clearmodifiers ctrl+v Return
else
    sleep 0.4
    settings_key ctrl+l
    type_text "${audio_fixture}"
    settings_key Return
fi
zentty_product_wait_for_log "${log}" \
    'notification-settings action=import-custom result=installed sound="zentty-custom-' \
    "custom audio did not install through the staged GTK page" || fail "custom import failed"
zentty_product_wait_for_log "${log}" \
    'notification-settings action=import-preview result=played' \
    "custom audio did not cross real aplay/ALSA" || fail "custom preview failed"
custom_name="$(
    sed -n 's/^sound_name = "\(zentty-custom-[0-9a-f]\{32\}\.wav\)"$/\1/p' "${config}" |
        tail -1
)"
[[ "${custom_name}" =~ ^zentty-custom-[0-9a-f]{32}\.wav$ ]] ||
    fail "custom sound config name is not strict and collision-safe"
custom_file="${XDG_DATA_HOME}/zentty/sounds/${custom_name}"
[[ -f "${custom_file}" && ! -L "${custom_file}" ]] || fail "custom sound was not installed as a regular file"
[[ "$(stat -c %a "${XDG_DATA_HOME}/zentty")" == 700 ]] || fail "custom data directory is not 0700"
[[ "$(stat -c %a "${XDG_DATA_HOME}/zentty/sounds")" == 700 ]] || fail "custom sounds directory is not 0700"
[[ "$(stat -c %a "${custom_file}")" == 600 ]] || fail "custom sound is not 0600"
grep -Fq 'custom_sound_display_name = "Friendly notification.wav"' "${config}" ||
    fail "custom sound display name did not persist"

settings_key alt+t
zentty_product_wait_for_log "${log}" 'notification-settings action=send-test result=sent id=3' \
    "custom sound notification did not reach the real service" || fail "custom notification failed"
for _ in {1..100}; do
    grep -Fq "${custom_file}" "${receipt}" && break
    sleep 0.02
done
grep -Fq 'string "sound-file"' "${receipt}" || fail "custom notification lacked sound-file hint"
grep -Fq "${custom_file}" "${receipt}" || fail "custom notification did not reference the owned asset"

# Restart the staged product against the same config and XDG data root. This
# proves that the custom selection is reconstructed from durable state rather
# than retained in process-local GTK state.
stop_product
start_product
open_notification_settings
zentty_product_wait_for_log "${log}" \
    "notification-settings loaded sound=\"${custom_name}\" visible-pane=false" \
    "notification settings did not survive a real product restart" ||
    fail "custom sound restart persistence failed"
[[ -f "${custom_file}" && ! -L "${custom_file}" ]] ||
    fail "custom sound asset did not survive a real product restart"

# A missing ALSA PCM is an explicit unavailable preview, not a pass.
cat >"${alsa_config}" <<'EOF'
pcm.zentty_dynamic { type does_not_exist }
EOF
settings_key alt+p
zentty_product_wait_for_log "${log}" \
    'notification-settings action=preview result=unavailable detail=custom sound preview exited' \
    "missing audio device was not visibly unavailable" || fail "audio absence became a pass"
[[ "$(find "${XDG_DATA_HOME}/zentty/sounds" -maxdepth 1 -type f -name 'zentty-custom-*.wav' | wc -l)" -eq 1 ]] ||
    fail "custom sound store contains unexpected assets"

settings_key alt+r
zentty_product_wait_for_log "${log}" \
    'notification-settings action=remove-custom result=removed' \
    "custom sound was not removed through the staged GTK page" || fail "custom removal failed"
[[ ! -e "${custom_file}" ]] || fail "removed custom sound remained on disk"
grep -Fq 'sound_name = ""' "${config}" || fail "custom sound removal did not persist default selection"
if grep -Fq 'custom_sound_display_name' "${config}"; then
    fail "custom sound removal retained stale display metadata"
fi

kill -TERM "${daemon_pid}"
wait "${daemon_pid}" 2>/dev/null || true
daemon_pid=""
for _ in {1..100}; do
    has_owner="$(gdbus call --session --dest org.freedesktop.DBus \
        --object-path /org/freedesktop/DBus \
        --method org.freedesktop.DBus.NameHasOwner org.freedesktop.Notifications 2>/dev/null || true)"
    [[ "${has_owner}" == '(false,)' ]] && break
    sleep 0.02
done
[[ "${has_owner:-}" == '(false,)' ]] || fail "notification service owner did not disappear"
settings_key alt+t
zentty_product_wait_for_log "${log}" 'notification-settings action=send-test result=error detail=no freedesktop notification service is available' \
    "missing service was not reported as an error" || fail "notification absence became a pass"

echo "rust-notifications-settings-${backend}: PASS real-gtk-settings physical-input private-dbus real-freedesktop-notify custom-import real-aplay sound-file-hint secure-xdg restart-persistence dedupe remove explicit-unavailable"
