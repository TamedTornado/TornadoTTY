#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
harness="${repo_root}/linux/tests/nested-wayland-input"
report="$(mktemp)"
output="$(mktemp)"
malformed_report="$(mktemp)"
trap 'rm -f -- "${report}" "${output}" "${malformed_report}"' EXIT

fail() {
    cat "${output}" >&2 2>/dev/null || true
    echo "nested-wayland-input-test: error: $*" >&2
    exit 1
}

for dependency in jq sha256sum stat date; do
    command -v "${dependency}" >/dev/null || fail "${dependency} is required"
done
[[ -x "${harness}" ]] || fail "input-capable Wayland harness is missing"

set +e
ZENTTY_NESTED_WAYLAND_INPUT_COMPOSITOR=labwc \
    ZENTTY_NESTED_WAYLAND_XWAYLAND_PROFILE=1 "${harness}" true \
    >"${output}" 2>&1
invalid_status=$?
set -e
if [[ "${invalid_status}" -ne 64 ]] ||
    ! grep -Fxq 'nested-wayland-input: error: Xwayland profile requires the labwc scaling profile' \
        "${output}"; then
    fail "invalid Xwayland profile combination was not rejected"
fi

set +e
ZENTTY_NESTED_WAYLAND_XWAYLAND_PROFILE=2 "${harness}" true >"${output}" 2>&1
invalid_status=$?
set -e
if [[ "${invalid_status}" -ne 64 ]] ||
    ! grep -Fxq 'nested-wayland-input: error: ZENTTY_NESTED_WAYLAND_XWAYLAND_PROFILE must be 0 or 1' \
        "${output}"; then
    fail "invalid Xwayland profile value was not rejected"
fi

# shellcheck disable=SC1091
source "${repo_root}/linux/tests/lib/controlled-environment"

before_roots="$(find /tmp -maxdepth 1 -type d -name 'zwi.*' -printf '%f\n' | sort)"
started_at="$(date +%s)"
# The controlled child, not this support test, expands the sanitized values.
# shellcheck disable=SC2016
child='test "${GDK_BACKEND:-}" = wayland && test -z "${DBUS_SESSION_BUS_ADDRESS:-}" && test -z "${AT_SPI_BUS_ADDRESS:-}" && test -n "${ZENTTY_NESTED_X11_SESSION_ID:-}" && wayland-info | grep -F zwp_virtual_keyboard_manager_v1 >/dev/null && wtype test'
DISPLAY=:poison WAYLAND_DISPLAY=poison DBUS_SESSION_BUS_ADDRESS=poison \
    AT_SPI_BUS_ADDRESS=poison IBUS_ADDRESS=poison \
    ZENTTY_NESTED_WAYLAND_INPUT_REPORT="${report}" \
    "${harness}" bash -c "${child}" >"${output}" 2>&1 ||
    fail "real Cage/Wayland input environment failed"

grep -Fxq \
    'nested-wayland-input: READY private-cage-x11-nested backend=wayland software-renderer=1 virtual-keyboard=1' \
    "${output}" || fail "readiness receipt is missing"
grep -Eq '^nested-wayland-input: SESSION [0-9a-f]{64}$' "${output}" ||
    fail "session identity is missing"
expected_command="$(jq -cn --arg child "${child}" '["bash","-c",$child]')"
zentty_controlled_environment_validate_report \
    "${report}" "${harness}" wayland 0 "${expected_command}" "${started_at}" 900 \
    >/dev/null || fail "machine-readable Cage receipt was rejected"
jq -e '
    .server.name == "Cage" and .server.backend == "x11-nested" and
    (.server.protocols | index("zwp_virtual_keyboard_manager_v1") != null) and
    .renderer == {software:true,name:"Pixman",proof:"WLR_RENDERER=pixman"} and
    .isolation.run_root_removed == true and
    .isolation.remaining_processes == []
' "${report}" >/dev/null || fail "Cage capability or cleanup proof is incomplete"

started_at="$(date +%s)"
# The controlled child, not this support test, expands the sanitized values.
# shellcheck disable=SC2016
weston_child='test "${GDK_BACKEND:-}" = wayland && test "${ZENTTY_NESTED_WAYLAND_OUTER_X11_INPUT:-}" = 1 && wayland-info | grep -F wl_data_device_manager >/dev/null && xdotool search --onlyvisible --class "^Weston Compositor$" >/dev/null'
ZENTTY_NESTED_WAYLAND_INPUT_COMPOSITOR=weston \
    ZENTTY_NESTED_WAYLAND_INPUT_REPORT="${report}" \
    "${harness}" bash -c "${weston_child}" >"${output}" 2>&1 ||
    fail "real Weston multi-window input environment failed"
grep -Fxq \
    'nested-wayland-input: READY private-weston-x11-nested backend=wayland software-renderer=1 outer-x11-input=1' \
    "${output}" || fail "Weston readiness receipt is missing"
expected_command="$(jq -cn --arg child "${weston_child}" '["bash","-c",$child]')"
zentty_controlled_environment_validate_report \
    "${report}" "${harness}" wayland 0 "${expected_command}" "${started_at}" 900 \
    >/dev/null || fail "machine-readable Weston receipt was rejected"
jq -e '
    .server.name == "Weston" and .server.backend == "x11-nested" and
    (.server.protocols | index("wl_data_device_manager") != null) and
    (.server.protocols | index("wl_seat") != null) and
    .renderer == {software:true,name:"Pixman",proof:"Using Pixman renderer"}
' "${report}" >/dev/null || fail "Weston capability proof is incomplete"

started_at="$(date +%s)"
# Labwc is the activation-capable profile: unlike the older Cage and Weston
# packages on this baseline, it advertises xdg-activation-v1 and receives
# timestamped input through its private nested X11 seat.
# shellcheck disable=SC2016
labwc_child='test "${GDK_BACKEND:-}" = wayland && test "${ZENTTY_NESTED_WAYLAND_OUTER_X11_INPUT:-}" = 1 && test "${ZENTTY_NESTED_WAYLAND_OUTER_X11_WINDOW:-}" -gt 0 && wayland-info | grep -F xdg_activation_v1 >/dev/null && xdotool windowfocus --sync "${ZENTTY_NESTED_WAYLAND_OUTER_X11_WINDOW}"'
ZENTTY_NESTED_WAYLAND_INPUT_COMPOSITOR=labwc \
    ZENTTY_NESTED_WAYLAND_INPUT_REPORT="${report}" \
    "${harness}" bash -c "${labwc_child}" >"${output}" 2>&1 ||
    fail "real labwc activation-capable input environment failed"
grep -Fxq \
    'nested-wayland-input: READY private-labwc-x11-nested backend=wayland software-renderer=1 outer-x11-input=1 xdg-activation=1' \
    "${output}" || fail "labwc readiness receipt is missing"
expected_command="$(jq -cn --arg child "${labwc_child}" '["bash","-c",$child]')"
zentty_controlled_environment_validate_report \
    "${report}" "${harness}" wayland 0 "${expected_command}" "${started_at}" 900 \
    >/dev/null || fail "machine-readable labwc receipt was rejected"
jq -e '
    .server.name == "labwc" and .server.backend == "x11-nested" and
    (.server.protocols | index("xdg_activation_v1") != null) and
    (.server.protocols | index("wl_seat") != null) and
    .renderer == {software:true,name:"Pixman",proof:"WLR_RENDERER=pixman"}
' "${report}" >/dev/null || fail "labwc activation capability proof is incomplete"

started_at="$(date +%s)"
# shellcheck disable=SC2016
scaling_child='test "${GDK_BACKEND:-}" = wayland && test "$(wlr-randr | grep -c "^[^ ]")" -eq 2 && wayland-info | grep -F wp_fractional_scale_manager_v1 >/dev/null && wayland-info | grep -F zwlr_output_manager_v1 >/dev/null'
ZENTTY_NESTED_WAYLAND_INPUT_COMPOSITOR=labwc \
    ZENTTY_NESTED_WAYLAND_SCALING_PROFILE=1 \
    ZENTTY_NESTED_WAYLAND_INPUT_REPORT="${report}" \
    "${harness}" bash -c "${scaling_child}" >"${output}" 2>&1 ||
    fail "real labwc mixed-scale environment failed"
grep -Fxq \
    'nested-wayland-input: READY private-labwc-x11-nested backend=wayland software-renderer=1 outer-x11-input=1 xdg-activation=1 mixed-scale-outputs=2' \
    "${output}" || fail "labwc scaling readiness receipt is missing"
expected_command="$(jq -cn --arg child "${scaling_child}" '["bash","-c",$child]')"
zentty_controlled_environment_validate_report \
    "${report}" "${harness}" wayland 0 "${expected_command}" "${started_at}" 900 \
    >/dev/null || fail "machine-readable labwc scaling receipt was rejected"
jq -e '
    .server.name == "labwc" and
    (.server.protocols | index("wp_fractional_scale_manager_v1") != null) and
    (.server.protocols | index("wp_viewporter") != null) and
    (.server.protocols | index("zwlr_output_manager_v1") != null) and
    (.server.outputs | length) == 2 and
    any(.server.outputs[]; .name == "X11-1" and .position == "0,0" and .scale == 1) and
    any(.server.outputs[]; .name == "X11-2" and .position == "1024,0" and .scale == 2)
' "${report}" >/dev/null || fail "labwc scaling protocol or output proof is incomplete"

started_at="$(date +%s)"
# shellcheck disable=SC2016
xwayland_child='test "${GDK_BACKEND:-}" = wayland && test "${DISPLAY:-}" = "${ZENTTY_NESTED_XWAYLAND_DISPLAY:-missing}" && test "${ZENTTY_NESTED_XWAYLAND_PID:-}" -gt 0 && xdpyinfo | grep -F "dimensions:    1536x768 pixels" >/dev/null && test "$(xrandr --current | grep -c " connected ")" -eq 2'
ZENTTY_NESTED_WAYLAND_INPUT_COMPOSITOR=labwc \
    ZENTTY_NESTED_WAYLAND_SCALING_PROFILE=1 \
    ZENTTY_NESTED_WAYLAND_XWAYLAND_PROFILE=1 \
    ZENTTY_NESTED_WAYLAND_INPUT_REPORT="${report}" \
    "${harness}" bash -c "${xwayland_child}" >"${output}" 2>&1 ||
    fail "real labwc-owned Xwayland environment failed"
grep -Fxq \
    'nested-wayland-input: READY private-labwc-x11-nested backend=wayland software-renderer=1 outer-x11-input=1 xdg-activation=1 mixed-scale-outputs=2 owned-xwayland=1' \
    "${output}" || fail "labwc Xwayland readiness receipt is missing"
expected_command="$(jq -cn --arg child "${xwayland_child}" '["bash","-c",$child]')"
zentty_controlled_environment_validate_report \
    "${report}" "${harness}" wayland 0 "${expected_command}" "${started_at}" 900 \
    >/dev/null || fail "machine-readable labwc Xwayland receipt was rejected"
jq -e '
    .server.name == "labwc" and .server.xwayland.display != "" and
    .server.xwayland.pid > 0 and .server.xwayland.process_group > 0 and
    .server.xwayland.binary_path == "/usr/bin/Xwayland" and
    (.server.xwayland.binary_sha256 | test("^[0-9a-f]{64}$")) and
    (.server.xwayland.command_sha256 | test("^[0-9a-f]{64}$")) and
    .server.xwayland.transport == "shm" and
    .server.xwayland.root_geometry == "1536x768" and
    (.server.xwayland.version | length) > 0 and
    (.server.xwayland.xdpyinfo_sha256 | test("^[0-9a-f]{64}$")) and
    (.server.xwayland.randr_sha256 | test("^[0-9a-f]{64}$"))
' "${report}" >/dev/null || fail "labwc Xwayland identity or geometry proof is incomplete"
jq 'del(.server.xwayland.command_sha256)' "${report}" >"${malformed_report}"
if zentty_controlled_environment_validate_report \
    "${malformed_report}" "${harness}" wayland 0 "${expected_command}" \
    "${started_at}" 900 >/dev/null 2>&1; then
    fail "Xwayland receipt without command identity was accepted"
fi

after_roots="$(find /tmp -maxdepth 1 -type d -name 'zwi.*' -printf '%f\n' | sort)"
[[ "${after_roots}" == "${before_roots}" ]] || fail "controlled runtime root leaked"

echo "Nested Wayland input tests passed: Cage/Weston/labwc, Xvfb transport, Pixman, virtual keyboard/outer input, xdg activation, mixed scaling, owned Xwayland, isolation, cleanup"
