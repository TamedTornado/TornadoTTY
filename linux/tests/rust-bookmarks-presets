#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
# shellcheck source=linux/tests/lib/product-input
source "${repo_root}/linux/tests/lib/product-input"
product="${ZENTTY_LINUX_BINARY:-${repo_root}/build/linux/bin/zentty-linux}"
ghostty_root="${GHOSTTY_SOURCE_DIR:-${repo_root}/build/linux-deps/ghostty}"
run_root="$(mktemp -d)"
project="${run_root}/project"
state_directory="${run_root}/state"
first_log="${run_root}/save.log"
restore_log="${run_root}/restore.log"
fallback_log="${run_root}/fallback.log"
scenario="${ZENTTY_BOOKMARK_SCENARIO:-save-restore}"
bookmarks="${XDG_CONFIG_HOME:?}/zentty/bookmarks.json"
product_pid=""
portal_wm_pid=""
backend="${GDK_BACKEND:-}"

fail() {
    for log in "${first_log}" "${restore_log}" "${fallback_log}"; do
        [[ ! -f "${log}" ]] || tail -100 "${log}" >&2
    done
    if [[ -f "${bookmarks}" ]]; then
        echo "rust-bookmarks-presets: persisted template identities at failure:" >&2
        jq '{templates: [.templates[] | {id, name, kind, pinned}]}' "${bookmarks}" >&2 || true
    fi
    echo "rust-bookmarks-presets: error: $*" >&2
    exit 1
}

cleanup() {
    if [[ "${product_pid}" =~ ^[1-9][0-9]*$ ]]; then
        kill -TERM "${product_pid}" 2>/dev/null || true
        wait "${product_pid}" 2>/dev/null || true
    fi
    if [[ "${portal_wm_pid}" =~ ^[1-9][0-9]*$ ]]; then
        kill -TERM "${portal_wm_pid}" 2>/dev/null || true
        wait "${portal_wm_pid}" 2>/dev/null || true
    fi
    rm -rf -- "${run_root}"
}
trap cleanup EXIT

case "${backend}" in
    x11)
        [[ "${ZENTTY_NESTED_X11_SESSION_ID:-}" =~ ^[0-9a-f]{64}$ ]] ||
            fail "X11 scenario must run through linux/tests/nested-x11"
        ;;
    wayland)
        [[ "${ZENTTY_NESTED_WAYLAND_INPUT_SESSION_ID:-}" =~ ^[0-9a-f]{64}$ ]] ||
            fail "Wayland scenario must run through linux/tests/nested-wayland-input"
        ;;
    *) fail "GDK_BACKEND must be x11 or wayland" ;;
esac
for dependency in grep jq mktemp readelf readlink sed sleep stat xdotool; do
    command -v "${dependency}" >/dev/null || fail "${dependency} is required"
done
if [[ "${scenario}" == import-export && "${backend}" == x11 ]]; then
    for dependency in openbox xprop; do
        command -v "${dependency}" >/dev/null || fail "${dependency} is required for the real X11 chooser"
    done
fi
[[ -x "${product}" ]] || fail "staged product is not built: ${product}"
product="$(readlink -f -- "${product}")"
mkdir -p "${project}" "${state_directory}"
canonical_project="$(readlink -f -- "${project}")"

layer_runpath="$({
    readelf -d "${ghostty_root}/zig-out/lib/libghostty-gtk-embed.so" |
        sed -n 's/.*Library runpath: \[\([^]]*\)\].*/\1/p' |
        cut -d: -f1
})"
layer_directory="${ghostty_root}/${layer_runpath}"

start_product() {
    local log="$1"
    (
        cd "${project}"
        exec env \
            GDK_SCALE=1 \
            GDK_DPI_SCALE=1 \
            BOOKMARK_TEST_SECRET_DO_NOT_PERSIST='real-ambient-secret' \
            LD_LIBRARY_PATH="${ghostty_root}/zig-out/lib:${layer_directory}${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}" \
            "${product}" \
            --state-directory "${state_directory}" \
            --no-session-restore
    ) >"${log}" 2>&1 &
    product_pid=$!
    for _ in {1..240}; do
        grep -Fq 'zentty-linux: terminal-ready-pane=pane-1' "${log}" && break
        sleep 0.05
    done
    grep -Fq 'zentty-linux: terminal-ready-pane=pane-1' "${log}" ||
        fail "real staged product terminal did not become ready"
    zentty_product_prepare_input "${backend}" "${log}" ||
        fail "real staged product input could not be prepared"
    if [[ "${backend}" == x11 ]]; then
        xdotool windowsize --sync "${ZENTTY_PRODUCT_WINDOW_ID}" 1000 700
        xdotool windowfocus --sync "${ZENTTY_PRODUCT_WINDOW_ID}"
    fi
    sleep 0.15
}

open_bookmarks() {
    local log="$1"
    local visible_before search_before
    visible_before="$(grep -Fc 'zentty-linux: bookmarks-popover visible=true' "${log}" 2>/dev/null || true)"
    search_before="$(grep -Fc 'zentty-linux: bookmarks-search-focused=true' "${log}" 2>/dev/null || true)"
    if [[ "${backend}" == x11 ]]; then
        xdotool keyup Control_L Control_R Shift_L Shift_R Alt_L Alt_R 2>/dev/null || true
        if [[ "${portal_wm_pid}" =~ ^[1-9][0-9]*$ ]]; then
            xdotool windowactivate --sync "${ZENTTY_PRODUCT_WINDOW_ID}"
        else
            # The ordinary isolated X11 cells intentionally have no window
            # manager, so _NET_ACTIVE_WINDOW is unavailable there.
            xdotool windowfocus --sync "${ZENTTY_PRODUCT_WINDOW_ID}"
        fi
        xdotool key ctrl+shift+b
    else
        zentty_product_ctrl_shift_key "${backend}" b
    fi
    zentty_product_wait_for_log_count "${log}" \
        'zentty-linux: bookmarks-popover visible=true' "$((visible_before + 1))" \
        'physical bookmark shortcut did not open the real GTK popover' ||
        fail "bookmark popover did not open"
    zentty_product_wait_for_log_count "${log}" \
        'zentty-linux: bookmarks-search-focused=true' "$((search_before + 1))" \
        'bookmark popover did not focus its real search field' ||
        fail "bookmark search did not receive focus"
}

input_key() {
    local key="$1"
    if [[ "${backend}" == x11 ]]; then
        xdotool key "${key}"
    else
        zentty_product_key "${backend}" "${key}"
    fi
}

input_type() {
    local value="$1"
    if [[ "${backend}" == x11 ]]; then
        xdotool type --delay 5 -- "${value}"
    else
        zentty_product_type "${backend}" "${value}"
    fi
}

input_ctrl_key() {
    local key="$1"
    if [[ "${backend}" == x11 ]]; then
        xdotool key "ctrl+${key}"
    else
        zentty_product_ctrl_key "${backend}" "${key}"
    fi
}

input_shift_key() {
    local key="$1"
    if [[ "${backend}" == x11 ]]; then
        xdotool key "shift+${key}"
    else
        wtype -M shift -k "${key}" -m shift
    fi
}

replace_text() {
    local value="$1"
    if zentty_product_uses_xdotool "${backend}"; then
        input_ctrl_key a
        input_type "${value}"
    else
        local clear=(-k End)
        for _ in {1..128}; do
            clear+=(-k BackSpace)
        done
        # Avoid compositor-specific selection shortcuts: clear the focused
        # GTK entry and type its replacement through one real virtual keyboard.
        wtype "${clear[@]}" -d 1 -- "${value}"
    fi
}

focus_bookmark_control() {
    local log="$1"
    local receipt="$2"
    for _ in {1..36}; do
        grep -Fq "zentty-linux: bookmarks-focus=${receipt}" "${log}" && return 0
        input_key Tab
        sleep 0.05
    done
    grep -Fq "zentty-linux: bookmarks-focus=${receipt}" "${log}" ||
        fail "bookmark keyboard focus did not reach ${receipt}"
}

focus_bookmark_control_after() {
    local log="$1"
    local receipt="$2"
    local before
    before="$(grep -Fc "zentty-linux: bookmarks-focus=${receipt}" "${log}" 2>/dev/null || true)"
    for _ in {1..16}; do
        if (( $(grep -Fc "zentty-linux: bookmarks-focus=${receipt}" "${log}" 2>/dev/null || true) > before )); then
            return 0
        fi
        input_key Tab
        sleep 0.05
    done
    fail "bookmark keyboard focus did not newly reach ${receipt}"
}

activate_focused_control() {
    if [[ "${backend}" == x11 ]]; then
        xdotool keyup Control_L Control_R Shift_L Shift_R Alt_L Alt_R 2>/dev/null || true
        # Do not reactivate the toplevel after reaching the button: Openbox may
        # restore the popover's initial search focus as part of activation,
        # invalidating the widget-focus receipt. Traversal already established
        # that this private X session's product window owns keyboard focus.
        if [[ "${portal_wm_pid}" =~ ^[1-9][0-9]*$ ]]; then
            xdotool key --clearmodifiers Return
        else
            # The ordinary private X11 profile intentionally has no window
            # manager or active-window property. Send the event to the mapped
            # product toplevel while preserving its already-proven widget
            # focus.
            xdotool key --clearmodifiers --window "${ZENTTY_PRODUCT_WINDOW_ID}" Return
        fi
        return
    fi
    input_key Return
}

save_named_bookmark() {
    local log="$1"
    local name="$2"
    local focus_before dialog_window attempt
    open_bookmarks "${log}"
    focus_bookmark_control "${log}" save-bookmark
    focus_before="$(grep -Fc 'zentty-linux: bookmark-name-focused=true' "${log}" 2>/dev/null || true)"
    activate_focused_control
    for attempt in {1..200}; do
        if (( $(grep -Fc 'zentty-linux: bookmark-name-focused=true' "${log}" 2>/dev/null || true) > focus_before )); then
            break
        fi
        if [[ "${backend}" == x11 && $((attempt % 20)) -eq 0 ]]; then
            dialog_window="$(
                xdotool search --onlyvisible --pid "${product_pid}" --name '^Save workspace$' \
                    2>/dev/null | head -1 || true
            )"
            # Retrying Return is safe only while the modal dialog has not
            # mapped. Once mapped, wait for its idle focus receipt rather than
            # risking submission of an empty name.
            [[ "${dialog_window}" =~ ^[1-9][0-9]*$ ]] || activate_focused_control
        fi
        sleep 0.05
    done
    (( $(grep -Fc 'zentty-linux: bookmark-name-focused=true' "${log}" 2>/dev/null || true) > focus_before )) ||
        fail "bookmark name dialog unavailable"
    # GTK focus changes before the nested compositor has necessarily routed the
    # keyboard to the newly mapped dialog surface.
    sleep 0.15
    input_type "${name}"
    input_key Return
    zentty_product_wait_for_log "${log}" 'zentty-linux: action=save-template result=ok' \
        'bookmark save action did not succeed' || fail "bookmark save failed"
}

focus_filtered_template() {
    local log="$1"
    local name="$2"
    local receipt="zentty-linux: bookmarks-focus=activate-template"
    local before
    open_bookmarks "${log}"
    replace_text "${name}"
    before="$(grep -F "${receipt}" "${log}" 2>/dev/null | grep -Fc "name=\"${name}\"" || true)"
    for _ in {1..16}; do
        if (( $(grep -F "${receipt}" "${log}" 2>/dev/null | grep -Fc "name=\"${name}\"" || true) > before )); then
            return 0
        fi
        input_key Tab
        sleep 0.05
    done
    fail "bookmark keyboard focus did not reach filtered template ${name}"
}

open_template_action() {
    local log="$1"
    local action="$2"
    local shown_before
    shown_before="$(grep -Fc 'zentty-linux: bookmarks-context-menu=shown keyboard=true' "${log}" 2>/dev/null || true)"
    sleep 0.1
    if [[ "${backend}" == x11 ]]; then
        xdotool keyup Menu 2>/dev/null || true
    fi
    input_key Menu
    if [[ "${backend}" == x11 ]]; then
        xdotool keyup Menu 2>/dev/null || true
    fi
    for _ in {1..20}; do
        if (( $(grep -Fc 'zentty-linux: bookmarks-context-menu=shown keyboard=true' "${log}" 2>/dev/null || true) > shown_before )); then
            break
        fi
        sleep 0.05
    done
    if (( $(grep -Fc 'zentty-linux: bookmarks-context-menu=shown keyboard=true' "${log}" 2>/dev/null || true) <= shown_before )); then
        input_shift_key F10
    fi
    zentty_product_wait_for_log_count "${log}" \
        'zentty-linux: bookmarks-context-menu=shown keyboard=true' "$((shown_before + 1))" \
        'standard keyboard context menu did not open' || fail "template context menu unavailable"
    focus_bookmark_control_after "${log}" "${action}"
    sleep 0.1
    input_key space
}

wait_for_action_after() {
    local log="$1"
    local action="$2"
    local before="$3"
    local attempts="${4:-200}"
    zentty_product_wait_for_log_count "${log}" \
        "zentty-linux: action=${action} result=ok" "$((before + 1))" \
        "${action} did not complete" "${attempts}" || fail "${action} failed"
}

action_count() {
    grep -Fc "zentty-linux: action=$2 result=ok" "$1" 2>/dev/null || true
}

jq_wait() {
    local expression="$1"
    for _ in {1..200}; do
        [[ -f "${bookmarks}" ]] && jq -e "${expression}" "${bookmarks}" >/dev/null 2>&1 && return 0
        sleep 0.05
    done
    return 1
}

stop_product() {
    kill -TERM "${product_pid}" 2>/dev/null || true
    wait "${product_pid}" 2>/dev/null || true
    product_pid=""
}

run_management() {
    start_product "${first_log}"
    save_named_bookmark "${first_log}" 'Managed'

    focus_filtered_template "${first_log}" 'Managed'
    open_template_action "${first_log}" rename-template
    zentty_product_wait_for_log "${first_log}" 'zentty-linux: bookmark-name-focused=true' \
        'rename dialog did not focus its name entry' || fail "rename dialog unavailable"
    sleep 0.15
    replace_text 'Managed Renamed'
    before="$(action_count "${first_log}" rename-template)"
    input_key Return
    wait_for_action_after "${first_log}" rename-template "${before}"
    jq_wait 'any(.templates[]; .name == "Managed Renamed")' || fail "rename was not persisted"

    focus_filtered_template "${first_log}" 'Managed Renamed'
    before="$(action_count "${first_log}" duplicate-template)"
    open_template_action "${first_log}" duplicate-template
    wait_for_action_after "${first_log}" duplicate-template "${before}"
    jq_wait '(.templates | length) == 2 and any(.templates[]; .name == "Managed Renamed copy")' ||
        fail "duplicate was not uniquely persisted"

    focus_filtered_template "${first_log}" 'Managed Renamed'
    before="$(action_count "${first_log}" toggle-template-pin)"
    open_template_action "${first_log}" toggle-template-pin
    wait_for_action_after "${first_log}" toggle-template-pin "${before}"
    jq_wait 'any(.templates[]; .name == "Managed Renamed" and .pinned == true)' || fail "pin was not persisted"

    focus_filtered_template "${first_log}" 'Managed Renamed'
    open_template_action "${first_log}" edit-template
    zentty_product_wait_for_log "${first_log}" 'zentty-linux: bookmark-edit-command-focused=true' \
        'edit dialog did not focus the first command' || fail "edit dialog unavailable"
    sleep 0.15
    replace_text 'sleep 30'
    before="$(action_count "${first_log}" edit-template)"
    input_key Return
    wait_for_action_after "${first_log}" edit-template "${before}"
    jq_wait 'any(.templates[]; .name == "Managed Renamed" and .columns[0].panes[0].command == "sleep 30")' ||
        fail "edit was not persisted"

    focus_filtered_template "${first_log}" 'Managed Renamed'
    before="$(action_count "${first_log}" convert-template)"
    open_template_action "${first_log}" convert-template
    wait_for_action_after "${first_log}" convert-template "${before}"
    jq_wait '(.templates | length) == 3 and any(.templates[]; .name == "Managed Renamed (preset)" and .kind == "preset")' ||
        fail "bookmark-to-preset conversion did not create a portable copy"

    focus_filtered_template "${first_log}" 'Managed Renamed copy'
    before="$(action_count "${first_log}" delete-template)"
    open_template_action "${first_log}" delete-template
    wait_for_action_after "${first_log}" delete-template "${before}"
    jq_wait '(.templates | length) == 2 and all(.templates[]; .name != "Managed Renamed copy")' ||
        fail "delete was not persisted"

    focus_filtered_template "${first_log}" 'Managed Renamed'
    input_key Return
    zentty_product_wait_for_log "${first_log}" 'zentty-linux: bookmark-restored id=' \
        'managed bookmark did not activate' || fail "activation before linked update failed"
    zentty_product_wait_for_log "${first_log}" 'zentty-linux: terminal-ready-pane=pane-3' \
        'linked restore did not create a real PTY' || fail "linked restore PTY unavailable"

    open_bookmarks "${first_log}"
    focus_bookmark_control_after "${first_log}" update-linked-template
    before="$(action_count "${first_log}" update-linked-template)"
    input_key Return
    wait_for_action_after "${first_log}" update-linked-template "${before}"
    open_bookmarks "${first_log}"
    focus_bookmark_control_after "${first_log}" unlink-template
    before="$(action_count "${first_log}" unlink-template)"
    input_key Return
    wait_for_action_after "${first_log}" unlink-template "${before}"

    stop_product
    echo "Rust bookmark management passed: ${backend}, context-menu=standard, rename=physical, edit=physical, duplicate=physical, pin=physical, convert=physical, update=physical, unlink=physical, delete=physical"
}

chooser_path() {
    local path="$1"
    local mode="$2"
    if [[ "${backend}" == x11 ]]; then
        local chooser_window=""
        for _ in {1..200}; do
            chooser_window="$(
                xdotool search --onlyvisible --name \
                    '^(Export Zentty preset|Import Zentty preset|Save File|Open File)$' \
                    2>/dev/null | tail -1 || true
            )"
            [[ "${chooser_window}" =~ ^[1-9][0-9]*$ ]] && break
            sleep 0.05
        done
        [[ "${chooser_window}" =~ ^[1-9][0-9]*$ ]] || fail "real GTK file chooser did not map"
        echo "rust-bookmarks-presets: chooser-window=$(xdotool getwindowname "${chooser_window}")"
        if [[ "${mode}" == save ]]; then
            xdotool windowactivate --sync "${chooser_window}"
            xdotool key --clearmodifiers ctrl+a
            xdotool type --clearmodifiers --delay 5 -- "${path##*/}"
            xdotool key --clearmodifiers alt+s
        else
            xdotool windowactivate --sync "${chooser_window}"
            xdotool key --clearmodifiers ctrl+l
            sleep 0.1
            xdotool type --clearmodifiers --delay 5 -- "${path}"
            # The location entry filters the real file list but does not select
            # its sole result. A physical double-click on that row both selects
            # and accepts it, matching normal chooser use.
            xdotool mousemove --window "${chooser_window}" 250 90
            xdotool click --repeat 2 --delay 100 1
        fi
        return
    else
        sleep 0.4
    fi
    if [[ "${mode}" == save ]]; then
        replace_text "${path##*/}"
        input_key Return
    else
        input_ctrl_key l
        sleep 0.1
        input_type "${path}"
        input_key Return
    fi
}

run_import_export() {
    local exported="${project}/Portable.zenttypreset"
    if [[ "${backend}" == x11 ]]; then
        openbox >"${run_root}/openbox.log" 2>&1 &
        portal_wm_pid=$!
        for _ in {1..200}; do
            xprop -root _NET_SUPPORTING_WM_CHECK 2>/dev/null | grep -Fq 'window id #' && break
            sleep 0.05
        done
        xprop -root _NET_SUPPORTING_WM_CHECK 2>/dev/null | grep -Fq 'window id #' ||
            fail "controlled X11 window manager did not become ready"
    fi
    start_product "${first_log}"
    save_named_bookmark "${first_log}" 'Portable'
    focus_filtered_template "${first_log}" 'Portable'
    before="$(action_count "${first_log}" export-template)"
    open_template_action "${first_log}" export-template
    chooser_path "${exported}" save
    wait_for_action_after "${first_log}" export-template "${before}" 80
    [[ -f "${exported}" && ! -L "${exported}" ]] || fail "real chooser did not create the export"
    jq -e '.schemaVersion == 1 and .template.kind == "preset" and .template.projectRoot == null' \
        "${exported}" >/dev/null || fail "exported envelope was not portable"

    focus_filtered_template "${first_log}" 'Portable'
    before="$(action_count "${first_log}" delete-template)"
    open_template_action "${first_log}" delete-template
    wait_for_action_after "${first_log}" delete-template "${before}"
    jq_wait '(.templates | length) == 0' || fail "live bookmark was not deleted before import"

    open_bookmarks "${first_log}"
    before="$(grep -Fc 'zentty-linux: bookmarks-focus=create-menu' "${first_log}" 2>/dev/null || true)"
    input_key Tab
    zentty_product_wait_for_log_count "${first_log}" \
        'zentty-linux: bookmarks-focus=create-menu' "$((before + 1))" \
        'Tab from bookmark search did not reach the create/import menu' ||
        fail "bookmark create/import menu was not keyboard reachable"
    input_key Return
    focus_bookmark_control_after "${first_log}" import-template
    input_key Return
    before="$(action_count "${first_log}" import-template)"
    chooser_path "${exported}" open
    wait_for_action_after "${first_log}" import-template "${before}" 80
    jq_wait '(.templates | length) == 1 and .templates[0].kind == "preset" and .templates[0].projectRoot == null and all(.templates[0].columns[].panes[]; .workingDirectory == null)' ||
        fail "real chooser import did not persist one portable preset"
    stop_product
    echo "Rust bookmark import/export passed: ${backend}, export-chooser=real, file=real, delete=physical, import-chooser=real, portable=persisted"
}

case "${scenario}" in
    management)
        run_management
        exit 0
        ;;
    import-export)
        run_import_export
        exit 0
        ;;
    save-restore) ;;
    *) fail "unsupported ZENTTY_BOOKMARK_SCENARIO=${scenario}" ;;
esac

start_product "${first_log}"
input_type 'sleep 30'
input_key Return
sleep 0.3
open_bookmarks "${first_log}"
sleep 0.3
focus_bookmark_control "${first_log}" save-bookmark
input_key Return
zentty_product_wait_for_log "${first_log}" \
    'zentty-linux: bookmark-name-focused=true' \
    'bookmark name dialog did not receive physical keyboard focus' ||
    fail "bookmark name dialog was not ready"
input_type 'Controlled bookmark'
input_key Return
zentty_product_wait_for_log "${first_log}" 'zentty-linux: bookmark-saved id=' \
    'save dialog did not persist the focused worklane' || fail "bookmark save did not complete"

[[ -f "${bookmarks}" && ! -L "${bookmarks}" ]] || fail "bookmark store is absent or unsafe"
[[ "$(stat -c '%a' "${bookmarks}")" == 600 ]] || fail "bookmark store is not private"
! grep -Fq 'real-ambient-secret' "${bookmarks}" ||
    fail "ambient process environment leaked into bookmark persistence"
if ! jq -e --arg cwd "${canonical_project}" '
    .schemaVersion == 1 and
    (.templates | length) == 1 and
    .templates[0].name == "Controlled bookmark" and
    .templates[0].kind == "bookmark" and
    .templates[0].projectRoot == $cwd and
    .templates[0].columns[0].panes[0].workingDirectory == $cwd and
    .templates[0].columns[0].panes[0].command == "sleep 30" and
    ((.templates[0].columns[0].panes[0].environment // {}) | length) == 0
' "${bookmarks}" >/dev/null; then
    jq '{schemaVersion, count: (.templates | length), template: (.templates[0] | {
        name, kind, projectRoot, workingDirectory: .columns[0].panes[0].workingDirectory,
        command: .columns[0].panes[0].command,
        environmentCount: ((.columns[0].panes[0].environment // {}) | length)
    })}' "${bookmarks}" >&2
    fail "saved bookmark JSON did not match the real pane"
fi

stop_product

start_product "${restore_log}"
open_bookmarks "${restore_log}"
sleep 0.3
input_type 'Controlled bookmark'
focus_bookmark_control "${restore_log}" activate-template
input_key Return
zentty_product_wait_for_log "${restore_log}" \
    'zentty-linux: bookmark-restored id=' \
    'physical template activation did not restore a worklane' || fail "bookmark restore did not complete"
zentty_product_wait_for_log "${restore_log}" \
    'zentty-linux: terminal-ready-pane=pane-3' \
    'restored worklane did not create its real Ghostty PTY' || fail "restored PTY did not initialize"
grep -Fq "zentty-linux: surface-config pane=pane-3 cwd=${canonical_project}" "${restore_log}" ||
    fail "restored real PTY did not use the bookmarked directory"
grep -Eq 'zentty-linux: bookmark-restored id=.* panes=1 fallbacks=0 ' "${restore_log}" ||
    fail "restore receipt did not prove one pane and no fallback"
jq -e '.templates[0].lastUsedAt | type == "string" and length > 0' "${bookmarks}" >/dev/null ||
    fail "template activation did not persist recency"
stop_product

# Exercise the real persisted-state boundary, not an in-process restore fixture:
# make the template stale between two complete product launches, then activate
# it through the same physical GTK route.
missing_directory="${run_root}/directory-removed-before-restore"
missing_command="zentty-command-removed-before-restore --controlled"
jq --arg cwd "${missing_directory}" --arg command "${missing_command}" '
    .templates[0].projectRoot = $cwd |
    .templates[0].columns[0].panes[0].workingDirectory = $cwd |
    .templates[0].columns[0].panes[0].command = $command
' "${bookmarks}" >"${bookmarks}.updated"
chmod 600 "${bookmarks}.updated"
mv -f -- "${bookmarks}.updated" "${bookmarks}"

start_product "${fallback_log}"
open_bookmarks "${fallback_log}"
sleep 0.3
input_type 'Controlled bookmark'
focus_bookmark_control "${fallback_log}" activate-template
input_key Return
zentty_product_wait_for_log "${fallback_log}" \
    'zentty-linux: restore-notice visible=true fallbacks=2' \
    'stale restore did not display its user-visible warning' || fail "fallback warning did not appear"
zentty_product_wait_for_log "${fallback_log}" \
    "zentty-linux: restore-prefill pane=pane-3 text=${missing_command}" \
    'missing command was not inserted for user review' || fail "fallback command was not prefilled"
grep -Fq "requested: \"${missing_directory}\"" "${fallback_log}" ||
    fail "missing-directory fallback was not recorded"
grep -Fq "command: \"${missing_command}\"" "${fallback_log}" ||
    fail "missing-command fallback was not recorded"
grep -Fq "zentty-linux: surface-config pane=pane-3 cwd=${canonical_project}" "${fallback_log}" ||
    fail "stale directory did not fall back to the focused real local directory"

if grep -Eq 'panicked at|RefCell already borrowed|CRITICAL: (Gtk|Gdk)|ambient-secret' \
    "${first_log}" "${restore_log}" "${fallback_log}"; then
    fail "bookmark journey reported a panic, GTK/GDK lifecycle critical, or secret"
fi

echo "Rust bookmarks/presets passed: ${backend}, save=physical, persistence=private, ambient-secret=absent, relaunch=real, restore-pty=real, stale-fallbacks=visible"
