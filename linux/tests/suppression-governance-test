assert_source_order() {
    local label="$1"
    local producer="$2"
    local before_pattern="$3"
    local after_pattern="$4"
    local before_line after_line

    before_line="$(grep -nF "${before_pattern}" "${producer}" | head -n 1 | cut -d: -f1 || true)"
    after_line="$(grep -nF "${after_pattern}" "${producer}" | head -n 1 | cut -d: -f1 || true)"
    [[ -n "${before_line}" && -n "${after_line}" && "${before_line}" -lt "${after_line}" ]] || {
        echo "error: ${label} source ordering is not fail-closed: ${producer}" >&2
        exit 1
    }
}

