#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
validator="${repo_root}/linux/tests/suppression-governance"
export ZENTTY_SUPPRESSION_MANIFEST_SCHEMA="${repo_root}/linux/tests/valgrind-suppressions.schema.json"
source "${repo_root}/linux/tests/lib/valgrind-report"
source "${repo_root}/linux/tests/lib/ibus-focus-protocol"
# The self-test creates and owns isolated evidence sets. A parent matrix may
# itself hold a production evidence lease while invoking this test; do not let
# that inherited lease masquerade as ownership of any fixture lock.
unset ZENTTY_VALGRIND_EVIDENCE_LOCK_FD ZENTTY_VALGRIND_EVIDENCE_LOCK_PATH
temp_dir="$(mktemp -d)"
trap 'rm -rf "${temp_dir}"' EXIT
suppression="${temp_dir}/fixture.supp"
manifest="${temp_dir}/manifest.json"
reports="${temp_dir}/reports"
report="${reports}/memory-safety-Debug-single-wayland.json"
nested_x11="${repo_root}/linux/tests/nested-x11"
nested_wayland="${repo_root}/linux/tests/nested-wayland"
raw_receipt="${report%.json}.raw.log"
suppressed_receipt="${report%.json}.suppressed.log"
expected_reports_json="$(jq -cn --arg report "${report}" '[$report]')"
mkdir -p "${reports}"

write_suppression() {
    cat >"${suppression}" <<'EOF'
{
   fixture rule
   Memcheck:Leak
   fun:malloc
}
EOF
}

write_manifest() {
    jq -n \
        --arg path "${suppression}" \
        --arg sha256 "$(sha256sum "${suppression}" | awk '{print $1}')" \
        --arg valgrind "$(valgrind --version)" \
        '{
            schema_version: 1,
            manifest_semantics: {
                "expected_suppressed.matches": "fixture match semantics",
                "expected_suppressed.bytes": "fixture byte semantics",
                usage_profiles: "fixture exact profile semantics",
                "usage_profiles.evidence_identity": "fixture identity-only evidence semantics",
                protocol_ceilings: "fixture acknowledged lifecycle ceiling semantics"
            },
            environment: {
                os: "fixture", valgrind: "fixture", gtk: "fixture",
                glib: "fixture", fontconfig: "fixture", pango: "fixture",
                librsvg: "fixture", ibus: "fixture"
            },
            project_suppression_file: {path: $path, sha256: $sha256, rule_count: 1},
            effective_inherited_sets: [{
                id: "builtin", base: "builtin", version: $valgrind,
                audit: "fixture built-in suppression audit"
            }],
            usage_profiles: [],
            protocol_ceilings: [],
            rules: [{
                rule_name: "fixture rule",
                tracking_id: "FIXTURE-1",
                affected: "fixture",
                finding_type: "Memcheck:Leak",
                expected_suppressed: {matches: {min: 1, max: 1}, bytes: {min: 10, max: 10}},
                allowed_scenarios: ["Debug/single/wayland"],
                justification: "fixture",
                reproducer: "fixture",
                required_usage: true
            }]
        }' >"${manifest}"
}

write_report() {
    local matches="$1"
    local backend="$2"
    local rule="$3"
    local bytes="${4:-10}"
    local raw_identity suppressed_identity report_generated_at_epoch
    local raw_metrics suppressed_metrics suppression_usage suppressed_contexts
    local raw_environment suppressed_environment phase_environment
    local raw_environment_identity suppressed_environment_identity
    local raw_session suppressed_session wrapper_sha nested_wrapper
    local phase_harness phase_environment_field
    local raw_server suppressed_server renderer isolation

    cat >"${raw_receipt}" <<'EOF'
==1== definitely lost: 10 bytes in 1 blocks
==1== indirectly lost: 0 bytes in 0 blocks
==1== ERROR SUMMARY: 1 errors from 1 contexts (suppressed: 0 from 0)
EOF
    if (( matches > 0 )); then
        suppressed_contexts=1
    else
        suppressed_contexts=0
    fi
    cat >"${suppressed_receipt}" <<EOF
==2== definitely lost: 0 bytes in 0 blocks
==2== indirectly lost: 0 bytes in 0 blocks
==2== ERROR SUMMARY: 0 errors from 0 contexts (suppressed: ${matches} from ${suppressed_contexts})
EOF
    if (( matches > 0 )); then
        printf '%s\n' \
            "==2== used_suppression: ${matches} ${rule} ${suppression}:1 suppressed: ${bytes} bytes in 1 blocks" \
            >>"${suppressed_receipt}"
    fi
    raw_identity="$(zentty_valgrind_receipt_identity_json "${raw_receipt}")"
    suppressed_identity="$(zentty_valgrind_receipt_identity_json "${suppressed_receipt}")"
    raw_metrics="$(zentty_valgrind_metrics_json "${raw_receipt}")"
    suppressed_metrics="$(zentty_valgrind_metrics_json "${suppressed_receipt}")"
    suppression_usage="$(zentty_valgrind_usage_json \
        "${suppressed_receipt}" "${suppression}")"
    report_generated_at_epoch="$(date +%s)"
    raw_environment="${report%.json}.raw.environment"
    suppressed_environment="${report%.json}.suppressed.environment"
    rm -f -- "${raw_environment}" "${suppressed_environment}"
    raw_session="$(printf '%s:raw\n' "${report}" | sha256sum | awk '{print $1}')"
    suppressed_session="$(printf '%s:suppressed\n' "${report}" | sha256sum | awk '{print $1}')"
    if [[ "${backend}" == "x11" ]]; then
        nested_wrapper="${nested_x11}"
        phase_harness="linux/tests/nested-x11"
        phase_environment_field="x11_phase_environment"
        raw_server='{"name":"Xvfb","endpoint":":9753","vendor":"fixture","vendor_release":"1"}'
        suppressed_server='{"name":"Xvfb","endpoint":":9754","vendor":"fixture","vendor_release":"1"}'
        renderer='{"software":true,"name":"llvmpipe (fixture)","vendor":"fixture","version":"1"}'
        isolation='{"ambient_display_sanitized":true,"ambient_dbus_sanitized":true,"process_group":9753,"run_root_removed":true,"display_unreachable_after":true,"remaining_processes":[]}'
    else
        nested_wrapper="${nested_wayland}"
        phase_harness="linux/tests/nested-wayland"
        phase_environment_field="wayland_phase_environment"
        raw_server='{"name":"Weston","version":"13.0.0","backend":"headless","endpoint":"wayland-z-1111111111111111","width":1280,"height":1024,"scale":1,"protocols":["wl_compositor","wl_output","wl_shm","xdg_wm_base"],"wayland_info_sha256":"1111111111111111111111111111111111111111111111111111111111111111"}'
        suppressed_server='{"name":"Weston","version":"13.0.0","backend":"headless","endpoint":"wayland-z-2222222222222222","width":1280,"height":1024,"scale":1,"protocols":["wl_compositor","wl_output","wl_shm","xdg_wm_base"],"wayland_info_sha256":"2222222222222222222222222222222222222222222222222222222222222222"}'
        renderer='{"software":true,"name":"Pixman","proof":"Using Pixman renderer"}'
        isolation='{"ambient_display_sanitized":true,"ambient_dbus_sanitized":true,"process_group":9753,"run_root_removed":true,"display_unreachable_after":true,"remaining_processes":[]}'
    fi
    wrapper_sha="$(sha256sum "${nested_wrapper}" | awk '{print $1}')"
    jq -n \
        --arg session "${raw_session}" \
        --arg backend "${backend}" \
        --arg wrapper "${nested_wrapper}" \
        --arg wrapper_sha "${wrapper_sha}" \
        --argjson started "$((report_generated_at_epoch - 3))" \
        --argjson finished "$((report_generated_at_epoch - 2))" \
        --argjson server "${raw_server}" \
        --argjson renderer "${renderer}" \
        --argjson isolation "${isolation}" '
        {
          schema_version:1,session_id:$session,backend:$backend,
          wrapper:{path:$wrapper,sha256:$wrapper_sha},
          started_at_epoch:$started,finished_at_epoch:$finished,
          command:["env","valgrind"],command_exit_code:0,
          server:$server,renderer:$renderer,isolation:$isolation
        }
    ' >"${raw_environment}"
    jq -n \
        --arg session "${suppressed_session}" \
        --arg backend "${backend}" \
        --arg wrapper "${nested_wrapper}" \
        --arg wrapper_sha "${wrapper_sha}" \
        --argjson started "$((report_generated_at_epoch - 1))" \
        --argjson finished "${report_generated_at_epoch}" \
        --argjson server "${suppressed_server}" \
        --argjson renderer "${renderer}" \
        --argjson isolation "${isolation}" '
        {
          schema_version:1,session_id:$session,backend:$backend,
          wrapper:{path:$wrapper,sha256:$wrapper_sha},
          started_at_epoch:$started,finished_at_epoch:$finished,
          command:["env","valgrind","--error-exitcode=99","--suppressions=/fixture.supp"],command_exit_code:0,
          server:$server,renderer:$renderer,isolation:$isolation
        }
    ' >"${suppressed_environment}"
    touch -d "@${report_generated_at_epoch}" \
        "${raw_environment}" "${suppressed_environment}"
    raw_environment_identity="$(zentty_valgrind_receipt_identity_json \
        "${raw_environment}")"
    suppressed_environment_identity="$(zentty_valgrind_receipt_identity_json \
        "${suppressed_environment}")"
    phase_environment="$(jq -cn \
        --arg harness "${phase_harness}" \
        --arg harness_sha256 "${wrapper_sha}" \
        --arg raw_report "${raw_environment}" \
        --arg raw_session "${raw_session}" \
        --argjson raw_identity "${raw_environment_identity}" \
        --arg suppressed_report "${suppressed_environment}" \
        --arg suppressed_session "${suppressed_session}" \
        --argjson suppressed_identity "${suppressed_environment_identity}" '
        {
          harness:$harness,harness_sha256:$harness_sha256,phase_isolation:true,
          raw:{report:$raw_report,report_identity:$raw_identity,session_id:$raw_session},
          suppressed:{report:$suppressed_report,report_identity:$suppressed_identity,session_id:$suppressed_session}
        }
    ')"
    jq -n \
        --arg project "${suppression}" \
        --arg sha256 "$(sha256sum "${suppression}" | awk '{print $1}')" \
        --arg backend "${backend}" \
        --arg raw "${raw_receipt}" \
        --arg suppressed "${suppressed_receipt}" \
        --arg valgrind_version "$(valgrind --version)" \
        --argjson report_generated_at_epoch "${report_generated_at_epoch}" \
        --argjson raw_identity "${raw_identity}" \
        --argjson suppressed_identity "${suppressed_identity}" \
        --argjson raw_metrics "${raw_metrics}" \
        --argjson suppressed_metrics "${suppressed_metrics}" \
        --argjson suppression_usage "${suppression_usage}" \
        --arg phase_environment_field "${phase_environment_field}" \
        --argjson phase_environment "${phase_environment}" \
        '{
            optimize: "Debug", scenario: "single", display_backend: $backend,
            raw_receipt: $raw, suppressed_receipt: $suppressed,
            suppressed_exit_code: 0,
            valgrind_version: $valgrind_version,
            valgrind_builtin_suppressions: true,
            report_generated_at_epoch: $report_generated_at_epoch,
            receipt_identities: {raw: $raw_identity, suppressed: $suppressed_identity},
            effective_suppression_files: [{path: $project, sha256: $sha256}],
            suppression_usage: $suppression_usage,
            raw: $raw_metrics,
            post_suppression: $suppressed_metrics
        } + {($phase_environment_field):$phase_environment}' >"${report}"
}

refresh_phase_environment_binding() {
    local raw_environment="${report%.json}.raw.environment"
    local suppressed_environment="${report%.json}.suppressed.environment"
    local raw_identity suppressed_identity generated phase_environment_field

    raw_identity="$(zentty_valgrind_receipt_identity_json "${raw_environment}")"
    suppressed_identity="$(zentty_valgrind_receipt_identity_json \
        "${suppressed_environment}")"
    generated="$(date +%s)"
    phase_environment_field="$(jq -r '
        if .display_backend == "x11" then
            "x11_phase_environment"
        else
            "wayland_phase_environment"
        end
    ' "${report}")"
    jq \
        --arg field "${phase_environment_field}" \
        --arg raw_session "$(jq -r '.session_id' "${raw_environment}")" \
        --arg suppressed_session "$(jq -r '.session_id' "${suppressed_environment}")" \
        --argjson raw_identity "${raw_identity}" \
        --argjson suppressed_identity "${suppressed_identity}" \
        --argjson generated "${generated}" '
        .[$field].raw.session_id = $raw_session |
        .[$field].raw.report_identity = $raw_identity |
        .[$field].suppressed.session_id = $suppressed_session |
        .[$field].suppressed.report_identity = $suppressed_identity |
        .report_generated_at_epoch = $generated
    ' "${report}" >"${temp_dir}/refreshed-phase-report.json"
    mv "${temp_dir}/refreshed-phase-report.json" "${report}"
}

expect_failure() {
    local label="$1"
    local pattern="$2"
    local output="${temp_dir}/${label}.log"
    set +e
    ZENTTY_SUPPRESSION_MANIFEST="${manifest}" \
    ZENTTY_SUPPRESSION_REPORTS_DIR="${reports}" \
    ZENTTY_VALGRIND_EXPECTED_REPORTS_JSON="${expected_reports_json}" \
    ZENTTY_SUPPRESSION_VALIDATION_NOW_EPOCH="${ZENTTY_SUPPRESSION_VALIDATION_NOW_EPOCH:-$(date +%s)}" \
        "${validator}" >"${output}" 2>&1
    status=$?
    set -e
    [[ "${status}" -ne 0 ]] || {
        echo "error: ${label} unexpectedly passed" >&2
        exit 1
    }
    grep -F "${pattern}" "${output}" >/dev/null || {
        echo "error: ${label} did not report ${pattern}" >&2
        cat "${output}" >&2
        exit 1
    }
}

