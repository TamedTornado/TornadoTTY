#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
product="${ZENTTY_LINUX_BINARY:-${repo_root}/build/linux/bin/zentty-linux}"
backend="${GDK_BACKEND:-}"
bundle_root="$(cd "$(dirname "${product}")/.." 2>/dev/null && pwd)" || bundle_root=""
bundle_lib="${bundle_root}/lib"
state_dir=""
log=""
product_pid=""
config_file="${XDG_CONFIG_HOME:?}/zentty/config.toml"

# shellcheck source=linux/tests/lib/product-input disable=SC1091
source "${repo_root}/linux/tests/lib/product-input"

fail() {
    [[ -z "${log}" || ! -f "${log}" ]] || cat "${log}" >&2
    echo "rust-config-reload: error: $*" >&2
    exit 1
}

wait_for_applied_quiescence() {
    local previous current stable=0
    previous="$(grep -Fc 'zentty-linux: config-reload result=applied' "${log}" || true)"
    for _ in {1..100}; do
        sleep 0.05
        current="$(grep -Fc 'zentty-linux: config-reload result=applied' "${log}" || true)"
        if [[ "${current}" == "${previous}" ]]; then
            stable=$((stable + 1))
            [[ "${stable}" -ge 10 ]] && return 0
        else
            previous="${current}"
            stable=0
        fi
    done
    fail "config reload stream did not become quiescent"
}

cleanup() {
    if [[ "${product_pid}" =~ ^[1-9][0-9]*$ ]]; then
        kill -TERM "${product_pid}" 2>/dev/null || true
        wait "${product_pid}" 2>/dev/null || true
    fi
    [[ -z "${state_dir}" ]] || rm -rf -- "${state_dir}"
    [[ -z "${log}" ]] || rm -f -- "${log}"
}
trap cleanup EXIT

case "${backend}" in
    x11)
        [[ "${ZENTTY_NESTED_X11_SESSION_ID:-}" =~ ^[0-9a-f]{64}$ ]] ||
            fail "X11 journey must run through linux/tests/nested-x11"
        ;;
    wayland)
        [[ "${ZENTTY_NESTED_WAYLAND_INPUT_SESSION_ID:-}" =~ ^[0-9a-f]{64}$ ]] ||
            fail "Wayland journey must run through linux/tests/nested-wayland-input"
        ;;
    *) fail "GDK_BACKEND must be x11 or wayland" ;;
esac
for dependency in chmod cmp dirname id ln mkdir mktemp mv pgrep sort stat; do
    command -v "${dependency}" >/dev/null || fail "${dependency} is required"
done
[[ -x "${product}" ]] || fail "staged product is not built: ${product}"
[[ -f "${bundle_lib}/libghostty-gtk-embed.so" ]] || fail "Ghostty bundle is missing"
[[ "$(id -u)" -ne 0 ]] || fail "permission journey requires a non-root product identity"

state_dir="$(mktemp -d)"
log="$(mktemp)"
mkdir -p "$(dirname "${config_file}")"
chmod 0777 "$(dirname "${config_file}")"
cat >"${config_file}" <<'EOF'
# external edits must preserve this operator-owned document
[confirmations]
confirm_before_closing_window = false
confirm_before_quitting = false

[clipboard]
always_clean_copies = false

[future_plugin]
operator_key = "preserved"
EOF
chmod 0644 "${config_file}"

# The real PTY child reports typed sentinels through the terminal title.
# shellcheck disable=SC2016
child_command='while IFS= read -r value; do printf '\''\033]2;%s\a'\'' "$value"; done'

pty_children() {
    # Zentty also owns short-lived project-discovery helpers. A bare pgrep of
    # every direct child can therefore capture a transient git process in
    # place of a not-yet-scheduled second shell. Identify the two deliberately
    # launched real PTY children by their unique command contract instead.
    pgrep -P "${product_pid}" -f 'while IFS= read -r value' | sort -n
}

LD_LIBRARY_PATH="${bundle_lib}${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}" \
    "${product}" --command "${child_command}" --state-directory "${state_dir}" \
    --async-backend default >"${log}" 2>&1 &
product_pid=$!
zentty_product_wait_for_log "${log}" 'zentty-linux: terminal-ready-pane=pane-1' \
    "first real terminal did not become ready" || fail "first terminal missing"
[[ "$(stat -c %a "$(dirname "${config_file}")")" == 700 ]] ||
    fail "Zentty did not tighten its XDG config directory to mode 0700"
[[ "$(stat -c %a "${config_file}")" == 600 ]] ||
    fail "Zentty did not tighten its regular config file to mode 0600"
zentty_product_prepare_input "${backend}" "${log}" || fail "could not prepare physical input"
zentty_product_ctrl_shift_key "${backend}" n
zentty_product_wait_for_log "${log}" 'zentty-linux: terminal-ready-pane=pane-window-2' \
    "second real terminal did not become ready" || fail "second terminal missing"

children_before=()
for _ in {1..200}; do
    mapfile -t children_before < <(pty_children)
    [[ "${#children_before[@]}" -eq 2 ]] && break
    sleep 0.05
done
[[ "${#children_before[@]}" -eq 2 ]] || fail "two windows did not own two PTY children"
if [[ "${backend}" == wayland ]]; then
    zentty_product_wait_for_log "${log}" 'zentty-linux: active-window=window-2' \
        "second Wayland window did not receive compositor activation" || fail "Wayland activation missing"
fi

# Project the source sidebar section through the one config authority into both
# live windows. Hidden reserves no content width; restoring pinnedOpen must
# reuse the configured width without replacing either real PTY.
sidebar_projection_before="$(grep -Fc 'zentty-linux: sidebar-config width=' "${log}" || true)"
cat >"${config_file}.sidebar-hidden" <<'EOF'
[sidebar]
width = 319
visibility = "hidden"

[confirmations]
confirm_before_closing_window = false
confirm_before_quitting = false

[clipboard]
always_clean_copies = false

[future_plugin]
operator_key = "preserved"
EOF
mv -f -- "${config_file}.sidebar-hidden" "${config_file}"
zentty_product_wait_for_log_count "${log}" \
    'zentty-linux: sidebar-config width=319 visibility=hidden result=projected' 2 \
    "hidden sidebar config did not project into both windows" || fail "hidden sidebar projection missing"
[[ "$(grep -Fc 'zentty-linux: sidebar-config width=' "${log}" || true)" -eq "$((sidebar_projection_before + 2))" ]] ||
    fail "hidden sidebar configuration projected more than once per window"
# The two-window projection is the accepted state, but its directory monitor
# may still be coalescing duplicate rename notifications. Require the existing
# observable reload stream to settle before publishing the next independent
# operator transaction; otherwise two intended states can collapse into one.
wait_for_applied_quiescence

cat >"${config_file}.sidebar-pinned" <<'EOF'
[sidebar]
width = 307
visibility = "pinnedOpen"

[confirmations]
confirm_before_closing_window = false
confirm_before_quitting = false

[clipboard]
always_clean_copies = false

[future_plugin]
operator_key = "preserved"
EOF
mv -f -- "${config_file}.sidebar-pinned" "${config_file}"
zentty_product_wait_for_log_count "${log}" \
    'zentty-linux: sidebar-config width=307 visibility=pinnedOpen result=projected' 2 \
    "pinned sidebar config did not project into both windows" || fail "pinned sidebar projection missing"
for child in "${children_before[@]}"; do
    [[ "$(ps -o ppid= -p "${child}" 2>/dev/null | tr -d ' ')" == "${product_pid}" ]] ||
        fail "sidebar live projection replaced real PTY child ${child}"
done

replace_config() {
    local clean_copy="$1"
    local confirm="$2"
    local temporary="${config_file}.external.$$"
    cat >"${temporary}" <<EOF
# external replacement receipt
[confirmations]
confirm_before_closing_window = ${confirm}
confirm_before_quitting = ${confirm}

[clipboard]
always_clean_copies = ${clean_copy}

[future_plugin]
operator_key = "preserved"
EOF
    mv -f -- "${temporary}" "${config_file}"
}

cancel_confirmation() {
    local accepted_before parent_before restored_before
    accepted_before="$(grep -Fc 'zentty-linux: confirmation accepted=false' "${log}" || true)"
    parent_before="$(grep -Fc 'zentty-linux: confirmation parent-presented=true' "${log}" || true)"
    restored_before="$(grep -Fc 'zentty-linux: confirmation focus-restored pane=' "${log}" || true)"
    zentty_product_key "${backend}" Escape
    zentty_product_wait_for_log_count "${log}" \
        'zentty-linux: confirmation accepted=false' "$((accepted_before + 1))" \
        "confirmation cancellation was not accepted" || fail "confirmation cancellation missing"
    zentty_product_wait_for_log_count "${log}" \
        'zentty-linux: confirmation parent-presented=true' "$((parent_before + 1))" \
        "confirmation cancellation did not request its real parent" || fail "confirmation parent presentation missing"
    if [[ "${backend}" == wayland && "${ZENTTY_NESTED_WAYLAND_OUTER_X11_INPUT:-}" == 1 ]]; then
        # Wayland activation is compositor-owned. The application requests its
        # parent; this real outer-compositor click grants activation.
        xdotool mousemove --sync --window "${ZENTTY_PRODUCT_WINDOW_ID}" 700 400 click 1
    fi
    zentty_product_wait_for_log_count "${log}" \
        'zentty-linux: confirmation focus-restored pane=' \
        "$((restored_before + 1))" \
        "confirmation cancellation did not restore the live terminal" || fail "confirmation terminal restoration missing"
    grep 'zentty-linux: confirmation focus-restored pane=' "${log}" | tail -1 | grep -Fq 'window-active=true' ||
        fail "confirmation restored terminal before its window became active"
}

type_product_text() {
    zentty_product_type "${backend}" "$1"
}

# Keep a real settings editor open while an external atomic replacement changes
# its model. The accepted publication must reconstruct the visible editor from
# authority, retain its selected section, and leave both PTYs intact. A product
# write from that reconstructed editor must then publish once without rebuilding
# the initiating editor or entering a watcher loop.
settings_open_reload_before="$(grep -Fc 'zentty-linux: config-reload result=applied' "${log}" || true)"
zentty_product_prepare_input "${backend}" "${log}" || fail "could not focus settings reload window"
zentty_product_ctrl_shift_key "${backend}" p
type_product_text 'Updates & Privacy Settings'
zentty_product_wait_for_log "${log}" \
    'command-palette=query value="Updates & Privacy Settings" results=1' \
    "settings route did not resolve uniquely" || fail "settings route missing"
zentty_product_key "${backend}" Down
zentty_product_key "${backend}" Return
zentty_product_wait_for_log "${log}" \
    'updates-privacy-settings loaded channel=stable error-reporting-available=true' \
    "visible settings did not load the initial authority" || fail "initial settings state missing"
zentty_product_wait_for_log "${log}" \
    'zentty-linux: shortcut-settings active search-focused=' \
    "initial settings did not receive compositor activation" || fail "initial settings activation missing"
zentty_product_wait_for_log_count "${log}" 'zentty-linux: config-reload result=applied' \
    "$((settings_open_reload_before + 1))" \
    "settings presentation reconciliation did not reach config authority" || fail "settings reconciliation barrier missing"
[[ "$(stat -c %a "${config_file}")" == 600 ]] || fail "product config replacement is not mode 0600"
[[ "$(stat -c %a "$(dirname "${config_file}")/.zentty-config.lock")" == 600 ]] ||
    fail "product config lock is not mode 0600"
settings_window=""
if [[ "${backend}" == x11 ]]; then
    for _ in {1..100}; do
        settings_window="$(xdotool search --onlyvisible --pid "${product_pid}" --name '^Tornado TTY Settings$' 2>/dev/null | tail -1 || true)"
        [[ "${settings_window}" =~ ^[1-9][0-9]*$ ]] && break
        sleep 0.02
    done
    [[ "${settings_window}" =~ ^[1-9][0-9]*$ ]] || fail "settings window did not appear"
fi
settings_refresh_before="$(grep -Fc 'zentty-linux: settings-live-refresh section=' "${log}" || true)"
settings_active_before="$(grep -Fc 'zentty-linux: shortcut-settings active search-focused=' "${log}" || true)"
settings_reload_before="$(grep -Fc 'zentty-linux: config-reload result=applied' "${log}" || true)"
cat >"${config_file}.settings-external" <<'EOF'
[confirmations]
confirm_before_closing_window = false
confirm_before_quitting = false

[clipboard]
always_clean_copies = false

[updates]
channel = "beta"

[future_plugin]
operator_key = "preserved"
EOF
mv -f -- "${config_file}.settings-external" "${config_file}"
zentty_product_wait_for_log_count "${log}" \
    'zentty-linux: settings-live-refresh section=updates-privacy' \
    "$((settings_refresh_before + 1))" \
    "visible settings editor did not refresh in place" || fail "visible settings refresh missing"
zentty_product_wait_for_log_count "${log}" \
    'zentty-linux: config-reload result=applied' \
    "$((settings_reload_before + 1))" \
    "external settings reload did not reach config authority" || fail "external settings reload barrier missing"
zentty_product_wait_for_log "${log}" \
    'updates-privacy-settings loaded channel=beta error-reporting-available=true' \
    "refreshed settings did not render the accepted external value" || fail "refreshed settings state stale"
if [[ "${backend}" == x11 ]]; then
    settings_window=""
    for _ in {1..100}; do
        settings_window="$(xdotool search --onlyvisible --pid "${product_pid}" --name '^Tornado TTY Settings$' 2>/dev/null | tail -1 || true)"
        [[ "${settings_window}" =~ ^[1-9][0-9]*$ ]] && break
        sleep 0.02
    done
    [[ "${settings_window}" =~ ^[1-9][0-9]*$ ]] || fail "refreshed settings window did not appear"
else
    zentty_product_wait_for_log_count "${log}" \
        'zentty-linux: shortcut-settings active search-focused=' \
        "$((settings_active_before + 1))" \
        "refreshed settings did not receive Wayland activation" || fail "refreshed settings activation missing"
fi
for child in "${children_before[@]}"; do
    [[ "$(ps -o ppid= -p "${child}" 2>/dev/null | tr -d ' ')" == "${product_pid}" ]] ||
        fail "visible settings refresh replaced real PTY child ${child}"
done

overlap_pending="${config_file}.external-overlap"
cat >"${overlap_pending}" <<'EOF'
# external transaction began before the product write
[updates]
channel = "beta"

[external_overlap]
winner = "external"
EOF
applied_before_self_write="$(grep -Fc 'zentty-linux: config-reload result=applied' "${log}" || true)"
if [[ "${backend}" == x11 ]]; then
    xdotool windowfocus --sync "${settings_window}"
    xdotool key alt+s
elif zentty_product_uses_xdotool "${backend}"; then
    xdotool key alt+s
else
    wtype -M alt -k s -m alt
fi
for _ in {1..100}; do
    grep -Fq 'channel = "stable"' "${config_file}" && break
    sleep 0.05
done
grep -Fq 'channel = "stable"' "${config_file}" || fail "settings self-write did not persist"
zentty_product_wait_for_log_count "${log}" 'zentty-linux: config-reload result=applied' \
    "$((applied_before_self_write + 1))" \
    "settings self-write was not published to the other window" || fail "self-write publication missing"
sleep 0.5
[[ "$(grep -Fc 'zentty-linux: config-reload result=applied' "${log}" || true)" -eq "$((applied_before_self_write + 1))" ]] ||
    fail "settings self-write entered a reload loop"
[[ "$(grep -Fc 'zentty-linux: settings-live-refresh section=' "${log}" || true)" -eq "$((settings_refresh_before + 1))" ]] ||
    fail "initiating settings editor rebuilt for its own write"

# The external transaction started above but commits after the product write,
# so its complete atomic document wins. The visible settings page must refresh.
settings_active_before_external_win="$(grep -Fc 'zentty-linux: shortcut-settings active search-focused=' "${log}" || true)"
mv -f -- "${overlap_pending}" "${config_file}"
zentty_product_wait_for_log_count "${log}" 'zentty-linux: config-reload result=applied' \
    "$((applied_before_self_write + 2))" \
    "external-last overlapping transaction did not publish" || fail "external-last overlap missing"
grep -Fq 'channel = "beta"' "${config_file}" || fail "external-last document did not win atomically"
zentty_product_wait_for_log_count "${log}" \
    'zentty-linux: settings-live-refresh section=updates-privacy' \
    "$((settings_refresh_before + 2))" \
    "external-last document did not refresh visible settings" || fail "external overlap refresh missing"
if [[ "${backend}" == x11 ]]; then
    settings_window=""
    for _ in {1..100}; do
        settings_window="$(xdotool search --onlyvisible --pid "${product_pid}" --name '^Tornado TTY Settings$' 2>/dev/null | tail -1 || true)"
        [[ "${settings_window}" =~ ^[1-9][0-9]*$ ]] && break
        sleep 0.02
    done
    [[ "${settings_window}" =~ ^[1-9][0-9]*$ ]] || fail "external-last refreshed settings window did not appear"
    xdotool windowfocus --sync "${settings_window}"
else
    zentty_product_wait_for_log_count "${log}" \
        'zentty-linux: shortcut-settings active search-focused=' \
        "$((settings_active_before_external_win + 1))" \
        "external-last settings did not receive Wayland activation" || fail "external-last activation missing"
fi

# Product-last is the inverse ordering. Its read/modify/replace must preserve
# the complete external document's unknown section while changing only Updates.
if [[ "${backend}" == x11 ]]; then
    xdotool key alt+s
elif zentty_product_uses_xdotool "${backend}"; then
    xdotool key alt+s
else
    wtype -M alt -k s -m alt
fi
zentty_product_wait_for_log_count "${log}" 'zentty-linux: config-reload result=applied' \
    "$((applied_before_self_write + 3))" \
    "product-last overlapping transaction did not publish" || fail "product-last overlap missing"
grep -Fq 'channel = "stable"' "${config_file}" || fail "product-last update did not win"
grep -Fq 'winner = "external"' "${config_file}" || fail "product-last update lost external unknown data"

# A real external process dies after publishing only a sibling temporary file.
# The watcher must ignore it and the accepted/final config must remain complete.
# First prove the preceding accepted transaction has finished emitting. Under
# a loaded qualification host its final coalesced notification may otherwise
# arrive after the baseline and be misattributed to the sibling fixture.
wait_for_applied_quiescence
applied_before_interruption="$(grep -Fc 'zentty-linux: config-reload result=applied' "${log}" || true)"
interrupted="${config_file}.external-interrupted"
set +e
sh -c 'printf "%s" "[updates" >"$1"; kill -KILL $$' sh "${interrupted}"
interrupted_status=$?
set -e
[[ "${interrupted_status}" -eq 137 ]] || fail "external interruption fixture did not die by SIGKILL"
[[ -f "${interrupted}" ]] || fail "external interruption did not leave its sibling temporary file"
sleep 0.5
[[ "$(grep -Fc 'zentty-linux: config-reload result=applied' "${log}" || true)" -eq "${applied_before_interruption}" ]] ||
    fail "interrupted sibling write was incorrectly published"
grep -Fq 'channel = "stable"' "${config_file}" || fail "interrupted write damaged accepted config"
grep -Fq 'winner = "external"' "${config_file}" || fail "interrupted write damaged preserved external data"
if [[ "${backend}" == x11 ]]; then
    # The process owns two terminal toplevels plus Settings. The generic X11
    # product target deliberately resolves a terminal, so close the already
    # discovered Settings window through its actual X input focus instead of
    # sending Escape to an arbitrary sibling toplevel.
    xdotool windowfocus --sync "${settings_window}"
    xdotool key Escape
else
    zentty_product_key "${backend}" Escape
fi
zentty_product_wait_for_log "${log}" 'shortcut-settings hidden parent-presented=true' \
    "settings did not return focus to its product window" || fail "settings close missing"
if [[ "${backend}" == wayland && "${ZENTTY_NESTED_WAYLAND_OUTER_X11_INPUT:-}" == 1 ]]; then
    # Presenting the parent does not grant activation under Wayland. Prove the
    # compositor routes a real gesture back to the live terminal before the
    # mandatory physical quit shortcut exercises the reloaded configuration.
    # The surface is already logically focused, so a second focus receipt is
    # not expected; the following shortcut and confirmation are the acceptance
    # proof rather than a synthetic activation claim.
    xdotool mousemove --sync --window "${ZENTTY_PRODUCT_WINDOW_ID}" 700 400 click 1
fi

# Two replace-by-rename writes inside the quiet period must publish only the
# final valid state to both real windows.
applied_before="$(grep -Fc 'zentty-linux: config-reload result=applied' "${log}" || true)"
projected_before="$(grep -Fc 'zentty-linux: config-live-projected window=' "${log}" || true)"
replace_config true false
replace_config true true
zentty_product_wait_for_log_count "${log}" \
    'zentty-linux: config-live-projected window=' "$((projected_before + 2))" \
    "final external config did not reach both windows" || fail "multi-window projection missing"
[[ "$(grep -Fc 'zentty-linux: config-reload result=applied' "${log}" || true)" -eq "$((applied_before + 1))" ]] ||
    fail "rapid external writes were not coalesced to one publication"
grep -Fq 'config-live-projected window=window-1 automatic-clean-copy=true confirm-close-window=true confirm-quit=true' "${log}" ||
    fail "first window did not receive final valid state"
grep -Fq 'config-live-projected window=window-2 automatic-clean-copy=true confirm-close-window=true confirm-quit=true' "${log}" ||
    fail "second window did not receive final valid state"
mapfile -t children_after < <(pty_children)
[[ "${children_after[*]}" == "${children_before[*]}" ]] || fail "config reload replaced a real PTY child"

# The externally enabled confirmation is exercised through the real product UI.
zentty_product_prepare_input "${backend}" "${log}" || fail "could not focus live reload window"
zentty_product_close_window "${backend}"
zentty_product_wait_for_log "${log}" 'zentty-linux: confirmation shown title="Quit Zentty?"' \
    "live confirmation setting did not affect application quit" || fail "live behavior missing"
cancel_confirmation
zentty_product_prepare_input "${backend}" "${log}" || fail "could not restore terminal focus"
zentty_product_type "${backend}" "after-valid-config-reload"
zentty_product_key "${backend}" Return
for _ in {1..200}; do
    grep -Eq 'zentty-linux: title-pane=(pane-1|pane-window-2) value=after-valid-config-reload$' "${log}" && break
    sleep 0.05
done
grep -Eq 'zentty-linux: title-pane=(pane-1|pane-window-2) value=after-valid-config-reload$' "${log}" ||
    fail "live PTYs stopped accepting physical input after reload"

# Valid known sections publish independently while an invalid known section
# retains only its last-good value. A later fully valid edit must converge.
applied_before="$(grep -Fc 'zentty-linux: config-reload result=applied' "${log}" || true)"
cat >"${config_file}.partial" <<'EOF'
[confirmations]
confirm_before_quitting = "invalid-and-must-not-appear"

[clipboard]
always_clean_copies = false
EOF
mv -f -- "${config_file}.partial" "${config_file}"
zentty_product_wait_for_log_count "${log}" \
    'zentty-linux: config-reload result=applied windows=2 retained-sections=confirmations' 1 \
    "partially valid edit did not publish its independent section" || fail "partial publication missing"
grep -Fq 'config-live-projected window=window-1 automatic-clean-copy=false confirm-close-window=true confirm-quit=true' "${log}" ||
    fail "first window did not apply valid partial section and retain invalid confirmations"
grep -Fq 'config-live-projected window=window-2 automatic-clean-copy=false confirm-close-window=true confirm-quit=true' "${log}" ||
    fail "second window did not apply valid partial section and retain invalid confirmations"
! grep -Fq 'invalid-and-must-not-appear' "${log}" || fail "partial diagnostic leaked a config value"
confirmation_before="$(grep -Fc 'zentty-linux: confirmation shown title="Quit Zentty?"' "${log}" || true)"
zentty_product_prepare_input "${backend}" "${log}" || fail "could not focus partially reloaded window"
zentty_product_close_window "${backend}"
zentty_product_wait_for_log_count "${log}" 'zentty-linux: confirmation shown title="Quit Zentty?"' \
    "$((confirmation_before + 1))" "invalid confirmation section did not retain live behavior" || fail "partial retention behavior missing"
cancel_confirmation

replace_config true true
zentty_product_wait_for_log_count "${log}" 'zentty-linux: config-reload result=applied' \
    "$((applied_before + 2))" "fully valid edit did not converge after partial reload" || fail "post-partial convergence missing"

# Invalid replacement and disappearance both retain the accepted state without
# logging file contents or silently resetting to defaults.
cat >"${config_file}.invalid" <<'EOF'
[confirmations
operator_secret = "must-not-appear-in-diagnostics"
EOF
mv -f -- "${config_file}.invalid" "${config_file}"
zentty_product_wait_for_log "${log}" 'zentty-linux: config-reload result=retained-last-good' \
    "invalid external config did not retain last good" || fail "invalid retention missing"
! grep -Fq 'must-not-appear-in-diagnostics' "${log}" || fail "diagnostic leaked config contents"
retained_before="$(grep -Fc 'zentty-linux: config-reload result=retained-last-good' "${log}")"
mv -- "${config_file}" "${config_file}.gone"
zentty_product_wait_for_log_count "${log}" 'zentty-linux: config-reload result=retained-last-good' \
    "$((retained_before + 1))" "missing config did not retain last good" || fail "missing retention absent"

zentty_product_prepare_input "${backend}" "${log}" || fail "could not focus retained-last-good window"
confirmation_before="$(grep -Fc 'zentty-linux: confirmation shown title="Quit Zentty?"' "${log}" || true)"
zentty_product_close_window "${backend}"
zentty_product_wait_for_log_count "${log}" 'zentty-linux: confirmation shown title="Quit Zentty?"' \
    "$((confirmation_before + 1))" \
    "last-good behavior did not survive invalid and missing files" || fail "last-good behavior reset"
cancel_confirmation

# A live operator-managed symlink must preserve the link while following
# target replacement, a retarget, and later replacement of the new target.
symlink_root="${state_dir}/managed-config"
first_target="${symlink_root}/first/settings.toml"
second_target="${symlink_root}/second/settings.toml"
mkdir -p "$(dirname "${first_target}")" "$(dirname "${second_target}")"
write_target() {
    local target="$1"
    local clean_copy="$2"
    local confirm="$3"
    local temporary="${target}.external.$$"
    cat >"${temporary}" <<EOF
[sidebar]
width = 311
visibility = "hidden"

[confirmations]
confirm_before_closing_window = ${confirm}
confirm_before_quitting = ${confirm}

[clipboard]
always_clean_copies = ${clean_copy}
EOF
    mv -f -- "${temporary}" "${target}"
}

write_target "${first_target}" false false
applied_before="$(grep -Fc 'zentty-linux: config-reload result=applied' "${log}" || true)"
watch_before="$(grep -Fc 'zentty-linux: config-watch path=' "${log}" || true)"
ln -s "${first_target}" "${config_file}.external-link"
mv -f -- "${config_file}.external-link" "${config_file}"
zentty_product_wait_for_log_count "${log}" 'zentty-linux: config-reload result=applied' \
    "$((applied_before + 1))" "live symlink publication was not observed" || fail "symlink publication missing"
zentty_product_wait_for_log_count "${log}" 'zentty-linux: config-watch path=' \
    "$((watch_before + 1))" "watch set was not rebuilt for the symlink target" || fail "symlink watch refresh missing"
[[ -L "${config_file}" ]] || fail "logical config path stopped being a symlink"

write_target "${first_target}" true false
zentty_product_wait_for_log_count "${log}" 'zentty-linux: config-reload result=applied' \
    "$((applied_before + 2))" "first symlink target replacement was not observed" || fail "first target replacement missing"
[[ -L "${config_file}" ]] || fail "target replacement overwrote the logical symlink"

write_target "${second_target}" false true
watch_before="$(grep -Fc 'zentty-linux: config-watch path=' "${log}" || true)"
ln -s "${second_target}" "${config_file}.external-link"
mv -f -- "${config_file}.external-link" "${config_file}"
zentty_product_wait_for_log_count "${log}" 'zentty-linux: config-reload result=applied' \
    "$((applied_before + 3))" "config symlink retarget was not observed" || fail "symlink retarget missing"
zentty_product_wait_for_log_count "${log}" 'zentty-linux: config-watch path=' \
    "$((watch_before + 1))" "watch set was not rebuilt after symlink retarget" || fail "retarget watch refresh missing"

write_target "${second_target}" true true
zentty_product_wait_for_log_count "${log}" 'zentty-linux: config-reload result=applied' \
    "$((applied_before + 4))" "replacement of retargeted config was not observed" || fail "retargeted replacement missing"
[[ -L "${config_file}" ]] || fail "retargeted config stopped being a symlink"
grep -Fq 'config-live-projected window=window-1 automatic-clean-copy=true confirm-close-window=true confirm-quit=true' "${log}" ||
    fail "final symlink target state did not reach the first window"
grep -Fq 'config-live-projected window=window-2 automatic-clean-copy=true confirm-close-window=true confirm-quit=true' "${log}" ||
    fail "final symlink target state did not reach the second window"
mapfile -t children_after_symlink < <(pty_children)
[[ "${children_after_symlink[*]}" == "${children_before[*]}" ]] || fail "symlink reload replaced a real PTY child"

# Losing read access must retain the final accepted symlink target state.
retained_before="$(grep -Fc 'zentty-linux: config-reload result=retained-last-good' "${log}")"
chmod 000 "${second_target}"
zentty_product_wait_for_log_count "${log}" 'zentty-linux: config-reload result=retained-last-good' \
    "$((retained_before + 1))" "unreadable target did not retain last-good state" || fail "permission retention missing"
chmod 600 "${second_target}"
write_target "${second_target}" false false
zentty_product_wait_for_log_count "${log}" 'zentty-linux: config-reload result=applied' \
    "$((applied_before + 5))" "valid edit after permission restoration did not resume projection" || fail "permission recovery missing"
grep -Fq 'config-live-projected window=window-1 automatic-clean-copy=false confirm-close-window=false confirm-quit=false' "${log}" ||
    fail "permission recovery did not reach the first window"
grep -Fq 'config-live-projected window=window-2 automatic-clean-copy=false confirm-close-window=false confirm-quit=false' "${log}" ||
    fail "permission recovery did not reach the second window"
mapfile -t children_after_permission < <(pty_children)
[[ "${children_after_permission[*]}" == "${children_before[*]}" ]] || fail "permission recovery replaced a real PTY child"

kill -KILL "${product_pid}"
wait "${product_pid}" 2>/dev/null || true
product_pid=""
first_log="${log}"
log="$(mktemp)"
LD_LIBRARY_PATH="${bundle_lib}${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}" \
    "${product}" --command "${child_command}" --state-directory "${state_dir}/sidebar-restart" \
    --no-session-restore --async-backend default >"${log}" 2>&1 &
product_pid=$!
zentty_product_wait_for_log "${log}" 'zentty-linux: terminal-ready-pane=pane-1' \
    "crash-style sidebar restart did not create a real terminal" || fail "sidebar restart terminal missing"
zentty_product_wait_for_log "${log}" 'zentty-linux: sidebar-visibility=hidden' \
    "crash-style restart did not restore hidden sidebar" || fail "sidebar restart visibility missing"
zentty_product_wait_for_log "${log}" \
    'zentty-linux: sidebar-config width=311 visibility=hidden result=initial' \
    "crash-style restart did not project the persisted sidebar preference" ||
    fail "sidebar restart preference missing"
zentty_product_prepare_input "${backend}" "${log}" || fail "could not focus restarted hidden sidebar"
zentty_product_ctrl_shift_key "${backend}" f
zentty_product_wait_for_log "${log}" 'zentty-linux: global-find shown targets=1' \
    "restarted hidden sidebar could not open Global Find" || fail "sidebar restart Global Find missing"
zentty_product_wait_for_log "${log}" 'zentty-linux: sidebar-visibility=hover-peek' \
    "Global Find did not reveal the restarted hidden sidebar" || fail "sidebar restart hover peek missing"
for _ in {1..200}; do
    grep -Eq 'zentty-linux: sidebar-width=31(0|1)' "${log}" && break
    sleep 0.025
done
grep -Eq 'zentty-linux: sidebar-width=31(0|1)' "${log}" ||
    fail "crash-style restart did not restore the persisted sidebar width"
zentty_product_move_pointer_to_terminal "${backend}" ||
    fail "could not move the real pointer outside the transient sidebar"
zentty_product_key "${backend}" Escape
zentty_product_wait_for_log_count "${log}" 'zentty-linux: sidebar-visibility=hidden' 2 \
    "closing restarted Global Find did not restore hidden mode" || fail "sidebar restart dismissal missing"
zentty_product_prepare_input "${backend}" "${log}" || fail "could not focus restarted real PTY"
zentty_product_type "${backend}" "sidebar-restart-focus"
zentty_product_key "${backend}" Return
zentty_product_wait_for_log "${log}" 'zentty-linux: title-pane=pane-1 value=sidebar-restart-focus' \
    "restarted hidden sidebar did not preserve real PTY focus" || fail "sidebar restart PTY focus missing"
rm -f -- "${first_log}"

kill -TERM "${product_pid}"
wait "${product_pid}" || true
product_pid=""
echo "rust-config-reload: PASS backend=${backend} real-pty=true multi-window=true sidebar=live+hidden+width+crash-restart rename=true coalesced=true partial=true last-good=true symlink-retarget=true permission-recovery=true private-xdg=true product-external-last-writer=true interrupted-temp-ignored=true settings-refresh=true self-write-no-loop=true"
