#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
product="${ZENTTY_LINUX_BINARY:-${repo_root}/build/linux/bin/zentty-linux}"
log="$(mktemp)"
state_directory="$(mktemp -d)"
product_pid=""

# shellcheck source=linux/tests/lib/product-bundle
source "${repo_root}/linux/tests/lib/product-bundle"

fail() {
    grep -E 'worklane-drag|reorder-worklane|sidebar-(reveal|active-visible)' "${log}" >&2 || true
    tail -40 "${log}" >&2
    echo "rust-sidebar-management-x11: error: $*" >&2
    exit 1
}

cleanup() {
    if [[ "${product_pid}" =~ ^[1-9][0-9]*$ ]]; then
        kill -TERM "${product_pid}" 2>/dev/null || true
        wait "${product_pid}" 2>/dev/null || true
    fi
    rm -f -- "${log}"
    rm -rf -- "${state_directory}"
}
trap cleanup EXIT

[[ "${GDK_BACKEND:-}" == x11 ]] || fail "GDK_BACKEND must be x11"
[[ "${ZENTTY_NESTED_X11_SESSION_ID:-}" =~ ^[0-9a-f]{64}$ ]] ||
    fail "scenario must run through linux/tests/nested-x11"
for dependency in grep mkdir mktemp readelf readlink sed seq sleep xdotool; do
    command -v "${dependency}" >/dev/null || fail "${dependency} is required"
done
[[ -x "${product}" ]] || fail "staged product is not built: ${product}"
zentty_product_bundle_resolve "${product}" || fail "staged product bundle is invalid"
product="${ZENTTY_PRODUCT_BINARY}"
bundle_lib="${ZENTTY_PRODUCT_BUNDLE_LIB}"
mkdir -p "${state_directory}/working-directory"

# Keep all nine real PTYs alive through the pointer journey and expose a title
# receipt for the final post-transfer physical-input proof.
(
    cd "${state_directory}/working-directory"
    exec env GDK_SCALE=1 GDK_DPI_SCALE=1 \
    LD_LIBRARY_PATH="${bundle_lib}${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}" \
    "${product}" \
        --command "while IFS= read -r line; do printf '\033]2;%s\a' \"\$line\"; done" \
    --state-directory "${state_directory}" \
        --no-session-restore
) >"${log}" 2>&1 &
product_pid=$!

window_id=""
for _ in $(seq 1 200); do
    window_id="$(xdotool search --name '^Zentty$' 2>/dev/null | head -1 || true)"
    [[ "${window_id}" =~ ^[1-9][0-9]*$ ]] && grep -Fxq 'zentty-linux: terminal-ready' "${log}" && break
    sleep 0.05
done
[[ "${window_id}" =~ ^[1-9][0-9]*$ ]] || fail "real Zentty window did not appear"
xdotool windowsize --sync "${window_id}" 1000 700
for _ in $(seq 1 100); do
    grep -Fxq 'zentty-linux: window-size=1000x700' "${log}" && break
    sleep 0.05
done
grep -Fxq 'zentty-linux: window-size=1000x700' "${log}" ||
    fail "GTK did not finish the controlled window allocation before sidebar input"

# Nine real worklanes overflow the controlled 700px sidebar. The first creation
# proves the visible button; the remaining source-owned New Worklane commands
# use source-compatible Ctrl+T so automatic reveal cannot scroll the pointer target away.
# Every lane owns a real Ghostty PTY.
for pane_number in $(seq 2 9); do
    if ((pane_number == 2)); then
        xdotool mousemove --window "${window_id}" 100 68 click 1
    else
        xdotool key --window "${window_id}" ctrl+t
    fi
    for _ in $(seq 1 240); do
        grep -Fxq "zentty-linux: terminal-ready-pane=pane-${pane_number}" "${log}" && break
        sleep 0.05
    done
    grep -Fxq "zentty-linux: terminal-ready-pane=pane-${pane_number}" "${log}" ||
        fail "New worklane did not create real pane-${pane_number}"
done
for _ in $(seq 1 100); do
    grep -Fq 'zentty-linux: sidebar-reveal worklane=worklane-9 value=' "${log}" && break
    sleep 0.05
done
grep -Fq 'zentty-linux: sidebar-reveal worklane=worklane-9 value=' "${log}" ||
    fail "the active overflowing worklane was not automatically revealed"

# Real keyboard traversal wraps to the first lane and must scroll it back into
# view rather than leaving the selected worklane offscreen.
worklane_1_focus_before="$(grep -Fc 'zentty-linux: focus-pane pane=pane-1' "${log}" || true)"
xdotool key --window "${window_id}" ctrl+Tab
for _ in $(seq 1 100); do
    [[ "$(grep -Fc 'zentty-linux: focus-pane pane=pane-1' "${log}" || true)" -gt "${worklane_1_focus_before}" ]] && break
    sleep 0.05
done
[[ "$(grep -Fc 'zentty-linux: focus-pane pane=pane-1' "${log}" || true)" -gt "${worklane_1_focus_before}" ]] ||
    fail "Ctrl+Tab did not wrap to the first real worklane"
for _ in $(seq 1 100); do
    grep -Fq 'zentty-linux: sidebar-active-visible worklane=worklane-1 value=' "${log}" && break
    sleep 0.05
done
grep -Fq 'zentty-linux: sidebar-active-visible worklane=worklane-1 value=' "${log}" ||
    fail "wrapped selection did not reveal the first sidebar row"

# Make worklane 2 active before picking up worklane 1. Dragging a navigation
# item must select it once GTK crosses the drag threshold, like a browser/editor
# tab strip; testing an already-active source would not prove that contract.
worklane_2_visible_before="$(grep -Fc 'zentty-linux: sidebar-active-visible worklane=worklane-2 value=' "${log}" || true)"
worklane_2_focus_before="$(grep -Fc 'zentty-linux: focus-pane pane=pane-2' "${log}" || true)"
xdotool key --window "${window_id}" ctrl+Tab
for _ in $(seq 1 100); do
    action_ready=false
    [[ "$(grep -Fc 'zentty-linux: focus-pane pane=pane-2' "${log}" || true)" -gt "${worklane_2_focus_before}" ]] &&
        action_ready=true
    visible_count="$(grep -Fc 'zentty-linux: sidebar-active-visible worklane=worklane-2 value=' "${log}" || true)"
    [[ "${action_ready}" == true && "${visible_count}" -gt "${worklane_2_visible_before}" ]] && break
    sleep 0.05
done
[[ "$(grep -Fc 'zentty-linux: focus-pane pane=pane-2' "${log}" || true)" -gt "${worklane_2_focus_before}" ]] ||
    fail "precondition did not make worklane 1 inactive before pointer drag"
[[ "$(grep -Fc 'zentty-linux: sidebar-active-visible worklane=worklane-2 value=' "${log}" || true)" -gt "${worklane_2_visible_before}" ]] ||
    fail "worklane 2 selection did not finish its real sidebar projection before pointer drag"

# Drag worklane 1 between worklanes 2 and 3 through GTK DnD. The insertion slot is
# calculated after excluding the dragged ID, exactly like the source model.
# Worklane 2 selection scrolls the first card upward by the controlled 40px
# reveal offset. Pick up worklane 1 through its still-visible header rather
# than the old pre-scroll coordinate, which now lands outside the drag source.
xdotool keyup ctrl shift alt super
# Force a real leave before resolving the rendered header. Selection-driven
# scrolling can move worklane 1 underneath an already stationary pointer; in
# that case GTK has already emitted enter and moving only within the header
# cannot produce a fresh synchronization receipt.
xdotool mousemove --sync --window "${window_id}" 500 70
sleep 0.05
pointer_target_before="$(grep -Fxc 'zentty-linux: worklane-drag=pointer-target id=worklane-1' "${log}" || true)"
pickup_y=""
for _ in $(seq 1 8); do
    for candidate_y in 90 100 110 120 130 140 150 160 170 180 190 200 210 220 230 240 250 260 270 280 290 300; do
        xdotool mousemove --sync --window "${window_id}" 120 "${candidate_y}"
        sleep 0.02
        pointer_target_after="$(grep -Fxc 'zentty-linux: worklane-drag=pointer-target id=worklane-1' "${log}" || true)"
        if ((pointer_target_after > pointer_target_before)); then
            pickup_y="${candidate_y}"
            break 2
        fi
    done
    # Selection-driven reveal may place the inactive first card just above the
    # viewport. Scroll the real sidebar upward and resolve its rendered header
    # again instead of assuming a fixed developer-desktop allocation.
    xdotool mousemove --sync --window "${window_id}" 120 180 click 4 click 4
    sleep 0.08
done
[[ -n "${pickup_y}" ]] || fail "physical pointer did not enter the rendered worklane 1 drag header"
xdotool mousedown 1
sleep 0.25
after_slot_before="$(grep -Fxc 'zentty-linux: worklane-drag=preview-slot target=worklane-2 edge=after reflow=live' "${log}" || true)"
after_slot_ready=false
for drag_offset in 40 80 120 160 200 240; do
    drag_y=$((pickup_y + drag_offset))
    xdotool mousemove --sync --window "${window_id}" 120 "${drag_y}"
    for _ in $(seq 1 40); do
        after_slot_count="$(grep -Fxc 'zentty-linux: worklane-drag=preview-slot target=worklane-2 edge=after reflow=live' "${log}" || true)"
        if ((after_slot_count > after_slot_before)); then
            after_slot_ready=true
            break 2
        fi
        sleep 0.05
    done
done
[[ "${after_slot_ready}" == true ]] ||
    fail "physical drag did not reach the reviewed worklane 2 after-slot"
xdotool mouseup 1
for _ in $(seq 1 120); do
    grep -Fxq 'zentty-linux: action=reorder-worklane id=worklane-1 insertion=1 order=worklane-2,worklane-1,worklane-3,worklane-4,worklane-5,worklane-6,worklane-7,worklane-8,worklane-9 active=worklane-1 pane=pane-1' "${log}" && break
    sleep 0.05
done
grep -Fxq 'zentty-linux: action=reorder-worklane id=worklane-1 insertion=1 order=worklane-2,worklane-1,worklane-3,worklane-4,worklane-5,worklane-6,worklane-7,worklane-8,worklane-9 active=worklane-1 pane=pane-1' "${log}" ||
    fail "real sidebar drag did not reorder the stable worklane ID"
grep -Fxq 'zentty-linux: worklane-drag=begin id=worklane-1 selected=true visual=floating ghost=card slot=rendered' "${log}" ||
    fail "real sidebar drag did not detach the card into a fully rendered source preview"
grep -Fxq 'zentty-linux: action=select-worklane id=worklane-1' "${log}" ||
    fail "dragging an inactive worklane did not select it at the drag threshold"
grep -Eq '^zentty-linux: worklane-drag=preview-slot target=worklane-[23] edge=(before|after) reflow=live$' "${log}" ||
    fail "real sidebar drag did not move a full-size slot and reflow adjacent cards"
for _ in $(seq 1 100); do
    grep -Fxq 'zentty-linux: worklane-drag=end id=worklane-1 visual=cleared' "${log}" && break
    sleep 0.05
done
grep -Fxq 'zentty-linux: worklane-drag=end id=worklane-1 visual=cleared' "${log}" ||
    fail "real sidebar drag did not clear its intermediate visual state"

# Linux maps the source Command+Control arrow commands to Super+Control. Move
# the same active lane back through the real capture-phase keyboard route.
move_up_count="$(grep -Fxc 'zentty-linux: action=move-worklane target=0' "${log}" || true)"
xdotool key --window "${window_id}" ctrl+super+Up
for _ in $(seq 1 100); do
    (( $(grep -Fxc 'zentty-linux: action=move-worklane target=0' "${log}" || true) > move_up_count )) && break
    sleep 0.05
done
(( $(grep -Fxc 'zentty-linux: action=move-worklane target=0' "${log}" || true) > move_up_count )) ||
    fail "Ctrl+Super+Up did not move the active worklane through the real key route"

# Reordering and selection metadata must reuse existing rows rather than
# rebuilding all nine cards and invalidating their pointer/focus state.
[[ "$(grep -Fc 'zentty-linux: sidebar-card id=worklane-4 panes=1 ' "${log}" || true)" -eq 1 ]] ||
    fail "an unaffected worklane card was rebuilt during selection or reorder"

# The source pane menu catalogs every other worklane in current sidebar order.
# Resolve each rendered hit target from GTK pointer-enter receipts instead of
# encoding compositor- or font-dependent menu coordinates. The final click
# moves pane-1's live Ghostty surface into worklane-2; no model-only action or
# synthetic test API stands in for the visible contextual affordance.
find_pointer_target() {
    local receipt="$1"
    local x="$2"
    local before candidate_x y
    local -a candidate_xs
    before="$(grep -Fxc "${receipt}" "${log}" || true)"
    if [[ "${x}" == any ]]; then
        # Popovers may be placed to either side of the sidebar when the source
        # worklane catalog is tall. Search the complete owned 1000px toplevel;
        # the pointer receipt, not a coordinate assumption, identifies the row.
        mapfile -t candidate_xs < <(seq 40 30 940)
    else
        candidate_xs=("${x}")
    fi
    for candidate_x in "${candidate_xs[@]}"; do
        xdotool mousemove --sync --window "${window_id}" 600 60
        for y in $(seq 70 10 680); do
            xdotool mousemove --sync --window "${window_id}" "${candidate_x}" "${y}"
            sleep 0.03
            if (( $(grep -Fxc "${receipt}" "${log}" || true) > before )); then
                return 0
            fi
        done
    done
    return 1
}

find_pointer_target \
    'zentty-linux: pane-context-pointer action=open pane=pane-1' 250 ||
    fail "physical pointer could not locate pane-1's rendered action button"
xdotool click 1
sleep 0.1
find_pointer_target \
    'zentty-linux: pane-context-pointer action=move-pane-to-worklane pane=pane-1' any ||
    fail "physical pointer could not locate the source Move Pane to Worklane affordance"
xdotool click 1
sleep 0.1
find_pointer_target \
    'zentty-linux: pane-context-pointer action=move-pane-to-worklane window=window-1 target=worklane-2' any ||
    fail "physical pointer could not locate the ordered worklane-2 destination"
xdotool click 1
for _ in $(seq 1 120); do
    grep -Fxq 'zentty-linux: action=move-pane-to-worklane pane=pane-1 target=worklane-2' "${log}" && break
    sleep 0.05
done
grep -Fxq 'zentty-linux: action=move-pane-to-worklane pane=pane-1 target=worklane-2' "${log}" ||
    fail "the real contextual destination did not move pane-1 into worklane-2"
[[ "$(grep -Fc 'zentty-linux: terminal-ready-pane=' "${log}" || true)" -eq 9 ]] ||
    fail "same-window worklane transfer recreated or destroyed a Ghostty terminal"
xdotool type --window "${window_id}" --delay 5 'contextual-transfer-live-pty'
xdotool key --window "${window_id}" Return
for _ in $(seq 1 100); do
    grep -Fxq 'zentty-linux: title-pane=pane-1 value=contextual-transfer-live-pty' "${log}" && break
    sleep 0.05
done
grep -Fxq 'zentty-linux: title-pane=pane-1 value=contextual-transfer-live-pty' "${log}" ||
    fail "moved pane-1 did not retain real PTY input after contextual transfer"

# With pane-1 now sharing worklane-2, the same source submenu must append the
# distinct "New Worklane in This Window" operation. Drive that final item and
# prove it isolates the existing live pane rather than starting a replacement.
find_pointer_target \
    'zentty-linux: pane-context-pointer action=open pane=pane-1' any ||
    fail "physical pointer could not relocate pane-1 after its first transfer"
xdotool click 1
sleep 0.1
find_pointer_target \
    'zentty-linux: pane-context-pointer action=move-pane-to-worklane pane=pane-1' any ||
    fail "relocated pane did not retain its Move Pane to Worklane affordance"
xdotool click 1
sleep 0.1
find_pointer_target \
    'zentty-linux: pane-context-pointer action=move-pane-to-new-worklane target=new' any ||
    fail "source New Worklane in This Window destination was not rendered"
xdotool click 1
for _ in $(seq 1 120); do
    grep -Fxq 'zentty-linux: action=move-pane-to-new-worklane pane=pane-1 target=worklane-10' "${log}" && break
    sleep 0.05
done
grep -Fxq 'zentty-linux: action=move-pane-to-new-worklane pane=pane-1 target=worklane-10' "${log}" ||
    fail "New Worklane in This Window did not isolate the selected live pane"
[[ "$(grep -Fc 'zentty-linux: terminal-ready-pane=' "${log}" || true)" -eq 9 ]] ||
    fail "new-worklane isolation recreated or destroyed a Ghostty terminal"
xdotool type --window "${window_id}" --delay 5 'contextual-new-worklane-live-pty'
xdotool key --window "${window_id}" Return
for _ in $(seq 1 100); do
    grep -Fxq 'zentty-linux: title-pane=pane-1 value=contextual-new-worklane-live-pty' "${log}" && break
    sleep 0.05
done
grep -Fxq 'zentty-linux: title-pane=pane-1 value=contextual-new-worklane-live-pty' "${log}" ||
    fail "isolated pane-1 did not retain real PTY input"

if grep -Eq 'panicked at|thread caused non-unwinding panic|RefCell already borrowed|CRITICAL: Gtk|has a parent GtkBox' "${log}"; then
    fail "sidebar management reported a panic or GTK lifecycle critical"
fi

echo "Rust sidebar management passed: x11, worklanes=9, overflow=revealed, drag-reorder=real, contextual-transfer=live-pty, rows=stable"
