#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
default_root="$(cd "${script_dir}/../.." && pwd)"
root_input="${ZENTTY_QUALIFICATION_HOST_ROOT:-${default_root}}"

fail() {
    echo "qualification-host-freeze: error: $*" >&2
    exit 1
}

for required_command in awk find jq sha256sum; do
    command -v "${required_command}" >/dev/null ||
        fail "${required_command} is required"
done

[[ -d "${root_input}" && ! -L "${root_input}" ]] ||
    fail "qualification-host root must be a non-symbolic directory: ${root_input}"
root="$(cd "${root_input}" && pwd -P)"
manifest="${ZENTTY_QUALIFICATION_HOST_FREEZE_MANIFEST:-${root}/linux/test-policy/qualification-host-freeze.json}"
if [[ "${manifest}" != /* ]]; then
    manifest="${root}/${manifest}"
fi

[[ -f "${manifest}" && ! -L "${manifest}" ]] ||
    fail "freeze manifest must be a regular non-symbolic file: ${manifest}"
jq -e . "${manifest}" >/dev/null 2>&1 || fail "freeze manifest is not valid JSON"

expected_source_paths='["linux/src/host_options.c","linux/src/host_options.h","linux/src/main.c"]'
expected_policy_boundary="qualification-host-only-no-product-behavior"
expected_policy_inventory="exact-top-level-inventory; no symbolic links or non-regular files"
expected_policy_build_hash="SHA-256 over every byte of build_entrypoint.path as stored; the external manifest is not part of that hash input"
expected_policy_change="Any protected source or build byte change requires explicit freeze-manifest review and fresh qualification."
expected_policy_retirement="Retire by replacement and removal, never extension into the product."

jq -e \
    --argjson expected_sources "${expected_source_paths}" \
    --arg boundary "${expected_policy_boundary}" \
    --arg inventory "${expected_policy_inventory}" \
    --arg build_hash "${expected_policy_build_hash}" \
    --arg change "${expected_policy_change}" \
    --arg retirement "${expected_policy_retirement}" '
    (keys == ["build_entrypoint","policy","schema_version","source_directory","sources","status","tracking"]) and
    .schema_version == 1 and
    .status == "FROZEN" and
    .tracking == "GH-2" and
    .source_directory == "linux/src" and
    (.sources | type == "array" and length == 3) and
    all(.sources[];
        (keys == ["path","sha256"]) and
        (.path | type == "string") and
        (.sha256 | type == "string" and test("^[0-9a-f]{64}$"))) and
    ([.sources[].path] | sort) == $expected_sources and
    ([.sources[].path] | length) == ([.sources[].path] | unique | length) and
    (.build_entrypoint | keys) == ["hash_rule","path","sha256"] and
    .build_entrypoint.path == "linux/scripts/build-local" and
    .build_entrypoint.hash_rule == "sha256-entire-file-bytes" and
    (.build_entrypoint.sha256 | type == "string" and test("^[0-9a-f]{64}$")) and
    (.policy | keys) == ["boundary","build_hash_rule","change_rule","inventory_rule","retirement_rule"] and
    .policy.boundary == $boundary and
    .policy.inventory_rule == $inventory and
    .policy.build_hash_rule == $build_hash and
    .policy.change_rule == $change and
    .policy.retirement_rule == $retirement
' "${manifest}" >/dev/null || fail "invalid qualification-host freeze manifest shape or policy"

source_directory="${root}/$(jq -r '.source_directory' "${manifest}")"
[[ -d "${source_directory}" && ! -L "${source_directory}" ]] ||
    fail "protected source directory must be a non-symbolic directory: ${source_directory}"

declare -A protected_paths=()
while IFS=$'\t' read -r relative_path expected_sha256; do
    protected_paths["${relative_path}"]="${expected_sha256}"
    protected_file="${root}/${relative_path}"
    [[ -f "${protected_file}" && ! -L "${protected_file}" ]] ||
        fail "protected source must be a regular non-symbolic file: ${relative_path}"
    actual_sha256="$(sha256sum "${protected_file}" | awk '{print $1}')"
    [[ "${actual_sha256}" == "${expected_sha256}" ]] ||
        fail "protected source hash drift: ${relative_path}"
done < <(jq -r '.sources[] | [.path,.sha256] | @tsv' "${manifest}")

actual_source_count=0
while IFS= read -r -d '' source_entry; do
    relative_path="${source_entry#${root}/}"
    if [[ -z "${protected_paths[${relative_path}]+present}" ]]; then
        printf -v quoted_path '%q' "${relative_path}"
        fail "unexpected qualification-host source entry: ${quoted_path}"
    fi
    ((actual_source_count += 1))
done < <(find "${source_directory}" -mindepth 1 -maxdepth 1 -print0)

[[ "${actual_source_count}" -eq "${#protected_paths[@]}" ]] ||
    fail "qualification-host source inventory is incomplete"

build_path="$(jq -r '.build_entrypoint.path' "${manifest}")"
build_file="${root}/${build_path}"
[[ -f "${build_file}" && ! -L "${build_file}" ]] ||
    fail "protected build entrypoint must be a regular non-symbolic file: ${build_path}"
expected_build_sha256="$(jq -r '.build_entrypoint.sha256' "${manifest}")"
actual_build_sha256="$(sha256sum "${build_file}" | awk '{print $1}')"
[[ "${actual_build_sha256}" == "${expected_build_sha256}" ]] ||
    fail "protected build entrypoint hash drift: ${build_path}"

echo "C qualification-host source and build boundary is frozen"
