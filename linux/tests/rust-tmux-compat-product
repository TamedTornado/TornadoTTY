#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
product="${ZENTTY_LINUX_BINARY:-${repo_root}/build/linux/bin/zentty-linux}"
backend="${GDK_BACKEND:-}"

fail() {
    printf 'rust-tmux-compat-product: error: %s\n' "$*" >&2
    exit 1
}

[[ "${backend}" == x11 || "${backend}" == wayland ]] ||
    fail "GDK_BACKEND must be x11 or wayland"
[[ -x "${product}" ]] || fail "staged Zentty product is missing: ${product}"

fixture_root="$(mktemp -d)"
log="${fixture_root}/product.log"
state_directory="${fixture_root}/state"
child="${fixture_root}/child"
cleanup() {
    rm -rf -- "${fixture_root}"
}
trap cleanup EXIT

cat >"${child}" <<'CHILD'
#!/usr/bin/env bash
set -euo pipefail
trap 'status=$?; printf "tmux-product-child: assertion failed line=%s status=%s\n" "${LINENO}" "${status}" | tee -a "${ZENTTY_TMUX_PRODUCT_PROBE}" >&2; exit "${status}"' ERR

if [[ "${ZENTTY_PANE_ID}" != pane-1 ]]; then
    if [[ "${ZENTTY_RESPAWN_PROBE:-}" == 1 ]]; then
        printf 'respawned=%s\n' "${ZENTTY_PANE_ID}" >>"${ZENTTY_TMUX_PRODUCT_PROBE}"
    fi
    IFS= read -r value
    [[ "${value}" == team-ready ]]
    printf '\033]2;zentty-tmux-team-%s\a' "${ZENTTY_PANE_ID}"
    sleep 30
    exit 1
fi

[[ "${CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS}" == 1 ]]
[[ -n "${ZENTTY_INSTANCE_ID}" ]]
[[ -x "${ZENTTY_TMUX_SHIM_DIR}/tmux" ]]
[[ "$(readlink -f -- "$(command -v tmux)")" == "$(readlink -f -- "${ZENTTY_TMUX_SHIM_DIR}/tmux")" ]]
instance_runtime="$(dirname -- "${ZENTTY_INSTANCE_SOCKET}")"
[[ "${TMUX}" == "${instance_runtime}/tmux-compat,0,${ZENTTY_PANE_ID}" ]]
[[ "${TMUX_PANE}" == "%${ZENTTY_PANE_ID}" ]]
[[ "${ZDOTDIR}" == "${ZENTTY_SHELL_INTEGRATION_DIR}" ]]
[[ -f "${ZENTTY_SHELL_INTEGRATION_DIR}/.zshenv" ]]
[[ -f "${ZENTTY_SHELL_INTEGRATION_DIR}/zentty-bash-integration.bash" ]]
[[ -f "${ZENTTY_SHELL_INTEGRATION_DIR}/fish/vendor_conf.d/zentty-shell-integration.fish" ]]
[[ -f "${ZENTTY_SHELL_INTEGRATION_DIR}/nushell/vendor/autoload/zentty.nu" ]]
[[ "${PROMPT_COMMAND}" == '. "$ZENTTY_SHELL_INTEGRATION_DIR/zentty-bash-integration.bash"' ]]
[[ ":${XDG_DATA_DIRS}:" == *":${ZENTTY_SHELL_INTEGRATION_DIR}:"* ]]
has_system_data_directory=false
IFS=: read -r -a data_directories <<<"${XDG_DATA_DIRS}"
for data_directory in "${data_directories[@]}"; do
    if [[ "${data_directory%/}" == /usr/share ]]; then
        has_system_data_directory=true
        break
    fi
done
[[ "${has_system_data_directory}" == true ]]
pane="$(${ZENTTY_CLI_BIN} __tmux-compat display-message -p '#{pane_id}')"
[[ "${pane}" == "%${ZENTTY_PANE_ID}" ]]
shim_pane="$(tmux -S ignored display-message -p '#{pane_id}')"
[[ "${shim_pane}" == "%${ZENTTY_PANE_ID}" ]]
listed="$(${ZENTTY_CLI_BIN} __tmux-compat list-panes -F '#{pane_id}')"
[[ "${listed}" == "%${ZENTTY_PANE_ID}" ]]
${ZENTTY_CLI_BIN} __tmux-compat wait-for --timeout 2 product-wait-ready &
waiter=$!
sleep 0.15
# A pending wait uses short authenticated probes; it must not occupy the app
# callback or prevent another real command from receiving a response.
pane="$(${ZENTTY_CLI_BIN} __tmux-compat display-message -p '#{pane_id}')"
[[ "${pane}" == "%${ZENTTY_PANE_ID}" ]]
${ZENTTY_CLI_BIN} __tmux-compat wait-for -S product-wait-ready
wait "${waiter}"
${ZENTTY_CLI_BIN} __tmux-compat wait-for -S product-pre-signalled
${ZENTTY_CLI_BIN} __tmux-compat wait-for --timeout 1 product-pre-signalled
if ${ZENTTY_CLI_BIN} __tmux-compat wait-for --timeout 0.06 product-never-signalled \
    2>"${TMPDIR:-/tmp}/zentty-wait-timeout.$$"; then
    exit 1
fi
grep -Fxq "zentty: tmux wait-for: timed out waiting for 'product-never-signalled'" \
    "${TMPDIR:-/tmp}/zentty-wait-timeout.$$"
rm -f -- "${TMPDIR:-/tmp}/zentty-wait-timeout.$$"
first="$(${ZENTTY_CLI_BIN} __tmux-compat split-window -h -P -F '#{pane_id}')"
second="$(${ZENTTY_CLI_BIN} __tmux-compat split-window -v -d -P -F '#{pane_id}')"
first_id="${first#%}"
second_id="${second#%}"
[[ "${first_id}" != "${first}" && "${second_id}" != "${second}" ]]
[[ "${first_id}" != "${second_id}" ]]
if ${ZENTTY_CLI_BIN} __tmux-compat respawn-pane -k -t "%${first_id}"; then
    exit 1
fi
${ZENTTY_CLI_BIN} __tmux-compat respawn-pane -k -t "%${first_id}" \
    -- "env ZENTTY_RESPAWN_PROBE=1 $0"
listed="$(${ZENTTY_CLI_BIN} __tmux-compat list-panes -F '#{pane_id}')"
[[ "${listed}" == $'%pane-1\n%'"${first_id}"$'\n%'"${second_id}" ]]
${ZENTTY_CLI_BIN} __tmux-compat select-layout -t @foreign main-vertical
${ZENTTY_CLI_BIN} __tmux-compat select-layout even-vertical
${ZENTTY_CLI_BIN} __tmux-compat select-layout tiled
${ZENTTY_CLI_BIN} __tmux-compat resize-pane -t "%${second_id}" -x 30%
${ZENTTY_CLI_BIN} __tmux-compat resize-pane -t "%${second_id}" -x 30
sleep 0.2
${ZENTTY_CLI_BIN} __tmux-compat send-keys -t "%${first_id}" team-ready Enter
${ZENTTY_CLI_BIN} __tmux-compat send-keys -t "%${second_id}" team-ready Enter
${ZENTTY_CLI_BIN} __tmux-compat send-keys \
    -t "%${ZENTTY_PANE_ID}" agent-real-input Enter
IFS= read -r value
[[ "${value}" == agent-real-input ]]
printf '\033]2;zentty-tmux-compat-real\a'
printf 'zentty-capture-real-one\nzentty-capture-real-two\n'
sleep 0.2
captured="$(${ZENTTY_CLI_BIN} __tmux-compat capture-pane -p -t "%${ZENTTY_PANE_ID}")"
[[ "${captured}" == *zentty-capture-real-one* ]]
[[ "${captured}" == *zentty-capture-real-two* ]]
${ZENTTY_CLI_BIN} __tmux-compat capture-pane -t "%${ZENTTY_PANE_ID}"
buffered="$(${ZENTTY_CLI_BIN} __tmux-compat show-buffer -b default)"
[[ "${buffered}" == *zentty-capture-real-two* ]]
printf named-buffer-real | ${ZENTTY_CLI_BIN} __tmux-compat set-buffer -b agent
[[ "$(${ZENTTY_CLI_BIN} __tmux-compat save-buffer -b agent)" == named-buffer-real ]]
printf loaded-buffer-real | ${ZENTTY_CLI_BIN} __tmux-compat load-buffer -b loaded
[[ "$(${ZENTTY_CLI_BIN} __tmux-compat show-buffer -b loaded)" == loaded-buffer-real ]]
${ZENTTY_CLI_BIN} __tmux-compat kill-pane -t "%${first_id}"
listed="$(${ZENTTY_CLI_BIN} __tmux-compat list-panes -F '#{pane_id}')"
[[ "${listed}" == $'%pane-1\n%'"${second_id}" ]]
${ZENTTY_CLI_BIN} __tmux-compat kill-pane -t "%${second_id}"
listed="$(${ZENTTY_CLI_BIN} __tmux-compat list-panes -F '#{pane_id}')"
[[ "${listed}" == '%pane-1' ]]
${ZENTTY_CLI_BIN} __tmux-compat split-window -h
${ZENTTY_CLI_BIN} __tmux-compat split-window -v -d
${ZENTTY_CLI_BIN} __tmux-compat kill-window
sleep 30
exit 1
CHILD
chmod +x "${child}"

set +e
env -u TMUX -u TMUX_PANE \
    CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS=1 \
    ZENTTY_TMUX_PRODUCT_PROBE="${fixture_root}/child-probe.log" \
    timeout 20s "${product}" \
    --command "${child}" \
    --no-session-restore \
    --state-directory "${state_directory}" >"${log}" 2>&1
status=$?
set -e
if [[ "${status}" -ne 0 ]]; then
    cat "${log}" >&2
    [[ ! -f "${fixture_root}/child-probe.log" ]] || cat "${fixture_root}/child-probe.log" >&2
    fail "staged product exited ${status}"
fi

[[ "$(grep -Fxc 'zentty-linux: tmux-command pane=pane-1 worklane=worklane-1 command=DisplayMessage' "${log}" || true)" -eq 3 ]] || {
    cat "${log}" >&2
    [[ ! -f "${fixture_root}/child-probe.log" ]] || cat "${fixture_root}/child-probe.log" >&2
    fail "real display-message did not cross the product handler"
}
[[ "$(grep -Fxc 'zentty-linux: tmux-command pane=pane-1 worklane=worklane-1 command=WaitFor' "${log}" || true)" -ge 7 ]] || {
    cat "${log}" >&2
    fail "real wait-for signal, consume, pending, and timeout requests did not cross the product handler"
}
awk '
    /command=DisplayMessage$/ { displays += 1 }
    displays == 2 && /command=WaitFor$/ { pending_before_independent_command = 1 }
    END { exit !(displays == 3 && pending_before_independent_command == 1) }
' "${log}" || {
    cat "${log}" >&2
    fail "pending wait probe did not precede the independent display command"
}
[[ "$(grep -Fxc 'zentty-linux: tmux-command pane=pane-1 worklane=worklane-1 command=ListPanes' "${log}" || true)" -eq 4 ]] || {
    cat "${log}" >&2
    fail "real list-panes did not cross the product handler"
}
[[ "$(grep -Fxc 'zentty-linux: tmux-command pane=pane-1 worklane=worklane-1 command=KillPane' "${log}" || true)" -eq 2 ]] || {
    cat "${log}" >&2
    fail "two real kill-pane commands did not cross the product handler"
}
[[ "$(grep -Fxc 'zentty-linux: tmux-command pane=pane-1 worklane=worklane-1 command=SelectLayout' "${log}" || true)" -eq 3 ]] || {
    cat "${log}" >&2
    fail "three real select-layout commands did not cross the product handler"
}
[[ "$(grep -Fxc 'zentty-linux: tmux-command pane=pane-1 worklane=worklane-1 command=ResizePane' "${log}" || true)" -eq 2 ]] || {
    cat "${log}" >&2
    fail "two real resize-pane commands did not cross the product handler"
}
[[ "$(grep -Fxc 'zentty-linux: tmux-command pane=pane-1 worklane=worklane-1 command=SendKeys' "${log}" || true)" -eq 3 ]] || {
    cat "${log}" >&2
    fail "real send-keys did not cross the product handler"
}
[[ "$(grep -Fxc 'zentty-linux: tmux-command pane=pane-1 worklane=worklane-1 command=SplitWindow' "${log}" || true)" -eq 4 ]] || {
    cat "${log}" >&2
    fail "four real split-window commands did not cross the product handler"
}
[[ "$(grep -Fxc 'zentty-linux: tmux-command pane=pane-1 worklane=worklane-1 command=RespawnPane' "${log}" || true)" -eq 2 ]] || {
    cat "${log}" >&2
    fail "valid and rejected real respawn-pane commands did not cross the product handler"
}
grep -Fxq 'zentty-linux: tmux-respawn pane=pane-2' "${log}" || {
    cat "${log}" >&2
    fail "real respawn-pane did not replace the targeted Ghostty PTY child"
}
grep -Fxq 'respawned=pane-2' "${fixture_root}/child-probe.log" || {
    cat "${log}" >&2
    fail "respawned command did not run in the targeted real pane"
}
[[ "$(grep -Fxc 'zentty-linux: tmux-command pane=pane-1 worklane=worklane-1 command=KillWindow' "${log}" || true)" -eq 1 ]] || {
    cat "${log}" >&2
    fail "real kill-window did not cross the product handler"
}
[[ "$(grep -Fxc 'zentty-linux: tmux-command pane=pane-1 worklane=worklane-1 command=CapturePane' "${log}" || true)" -eq 2 ]] || {
    cat "${log}" >&2
    fail "real capture-pane did not read both printed and buffered terminal text"
}
for command in SetBuffer SaveBuffer LoadBuffer ShowBuffer; do
    grep -Fxq "zentty-linux: tmux-command pane=pane-1 worklane=worklane-1 command=${command}" "${log}" || {
        cat "${log}" >&2
        fail "real ${command} did not cross the product handler"
    }
done
grep -Fxq 'zentty-linux: tmux-layout equalize=pane-2 golden=pane-1 changed=false' "${log}" || {
    cat "${log}" >&2
    fail "main-vertical did not target the real teammate and leader columns"
}
grep -Fxq 'zentty-linux: tmux-layout equalize=pane-2 golden=none changed=false' "${log}" || {
    cat "${log}" >&2
    fail "even-vertical did not target the real teammate column"
}
[[ "$(grep -Fxc 'zentty-linux: tmux-layout equalize=none golden=none changed=false' "${log}" || true)" -eq 2 ]] || {
    cat "${log}" >&2
    fail "non-mutating layout and absolute resize were not explicit"
}
grep -Fxq 'zentty-linux: tmux-layout equalize=none golden=pane-1 changed=false' "${log}" || {
    cat "${log}" >&2
    fail "percentage resize did not preserve the real golden leader column"
}
grep -Fq 'zentty-linux: geometry=worklane-1:column-worklane-1[pane-1],column-pane-2[pane-2,pane-3]' "${log}" || {
    cat "${log}" >&2
    fail "team topology was not one right column with stacked teammates"
}
layout="$(grep -E 'zentty-linux: pane-layout .*columns=column-worklane-1:[0-9]+,column-pane-2:[0-9]+' "${log}" | tail -1)"
if [[ ! "${layout}" =~ column-worklane-1:([0-9]+),column-pane-2:([0-9]+) ]]; then
    cat "${log}" >&2
    fail "team column widths were not observable"
fi
leader_width="${BASH_REMATCH[1]}"
team_width="${BASH_REMATCH[2]}"
leader_percent=$((100 * leader_width / (leader_width + team_width)))
((leader_percent >= 61 && leader_percent <= 62)) || {
    cat "${log}" >&2
    fail "leader column is not golden-wide: ${leader_percent}%"
}
heights="$(grep -E 'zentty-linux: pane-height-layout column=column-pane-2 .*panes=pane-2:[0-9]+,pane-3:[0-9]+' "${log}" | tail -1)"
if [[ ! "${heights}" =~ pane-2:([0-9]+),pane-3:([0-9]+) ]]; then
    cat "${log}" >&2
    fail "stacked teammate heights were not observable"
fi
height_difference=$((BASH_REMATCH[1] - BASH_REMATCH[2]))
((height_difference >= -1 && height_difference <= 1)) || {
    cat "${log}" >&2
    fail "stacked teammate heights are not equal"
}
if grep -Eq 'zentty-linux: focus-pane pane=pane-[23]$' "${log}"; then
    cat "${log}" >&2
    fail "team split stole terminal focus from the leader"
fi
grep -Fxq 'zentty-linux: title=zentty-tmux-compat-real' "${log}" || {
    cat "${log}" >&2
    fail "send-keys text did not cross the Ghostty surface and PTY"
}
for teammate in pane-2 pane-3; do
    grep -Fxq "zentty-linux: title=zentty-tmux-team-${teammate}" "${log}" || {
        cat "${log}" >&2
        fail "${teammate} did not receive real terminal input"
    }
done
final_layout="$(grep -E 'zentty-linux: pane-layout .*columns=column-worklane-1:[0-9]+$' "${log}" | tail -1)"
if [[ ! "${final_layout}" =~ column-worklane-1:([0-9]+)$ ]]; then
    cat "${log}" >&2
    fail "dissolved-team leader width was not observable"
fi
final_leader_width="${BASH_REMATCH[1]}"
pre_team_width=$((leader_width + team_width + 1))
[[ "${final_leader_width}" -eq "${pre_team_width}" ]] || {
    cat "${log}" >&2
    fail "team dissolution did not restore leader width: ${pre_team_width} -> ${final_leader_width}"
}
for pane in pane-1 pane-2 pane-3 pane-4 pane-5; do
    grep -Fxq "zentty-linux: tmux-close pane=${pane}" "${log}" || {
        cat "${log}" >&2
        fail "${pane} did not cross real tmux-owned terminal teardown"
    }
done

printf 'Rust tmux compatibility product journey passed: %s\n' "${backend}"
