#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
# shellcheck source=linux/tests/lib/product-input
source "${repo_root}/linux/tests/lib/product-input"
product="${ZENTTY_LINUX_BINARY:-${repo_root}/build/linux/bin/zentty-linux}"
backend="${GDK_BACKEND:-}"

fail() {
    printf 'rust-tmux-compat-product: error: %s\n' "$*" >&2
    exit 1
}

assert_no_child_assertion() {
    local receipt="$1"
    local product_log="$2"
    if [[ -f "${receipt}" ]] && grep -Fq 'tmux-product-child: assertion failed' "${receipt}"; then
        cat "${product_log}" >&2
        cat "${receipt}" >&2
        fail "real product child assertion was masked by normal application shutdown"
    fi
}

[[ "${backend}" == x11 || "${backend}" == wayland ]] ||
    fail "GDK_BACKEND must be x11 or wayland"
[[ -x "${product}" ]] || fail "staged Zentty product is missing: ${product}"

fixture_root="$(mktemp -d)"
log="${fixture_root}/product.log"
state_directory="${fixture_root}/state"
child="${fixture_root}/child"
endpoint_receipt="${fixture_root}/endpoint.receipt"
split_cwd="${fixture_root}/split-cwd"
restart_log="${fixture_root}/restart.log"
recovery_log="${fixture_root}/recovery.log"
topology_state="${fixture_root}/topology-state"
topology_receipt="${fixture_root}/topology.receipt"
topology_log="${fixture_root}/topology.log"
topology_restart_log="${fixture_root}/topology-restart.log"
tmux_store="${XDG_CONFIG_HOME}/zentty/tmux-compat-store.json"
mkdir -p -- "${split_cwd}"
cleanup() {
    rm -rf -- "${fixture_root}"
}
trap cleanup EXIT

cat >"${child}" <<'CHILD'
#!/usr/bin/env bash
set -euo pipefail
trap 'status=$?; printf "tmux-product-child: assertion failed line=%s status=%s\n" "${LINENO}" "${status}" | tee -a "${ZENTTY_TMUX_PRODUCT_PROBE}" >&2; exit "${status}"' ERR

if [[ "${ZENTTY_PANE_ID}" == pane-1 && "${ZENTTY_TMUX_RESTART_PROBE:-}" == 1 ]]; then
    [[ -n "${ZENTTY_TMUX_OLD_SOCKET:-}" && -n "${ZENTTY_TMUX_OLD_TOKEN:-}" ]]
    [[ "${ZENTTY_INSTANCE_SOCKET}" != "${ZENTTY_TMUX_OLD_SOCKET}" ]]
    [[ "${ZENTTY_PANE_TOKEN}" != "${ZENTTY_TMUX_OLD_TOKEN}" ]]
    if env ZENTTY_PANE_TOKEN="${ZENTTY_TMUX_OLD_TOKEN}" \
        "${ZENTTY_CLI_BIN}" __tmux-compat split-window -h; then
        exit 1
    fi
    listed="$("${ZENTTY_CLI_BIN}" __tmux-compat list-panes -F '#{pane_id}')"
    [[ "${listed}" == '%pane-1' ]]
    [[ "$("${ZENTTY_CLI_BIN}" __tmux-compat show-buffer -b agent)" == named-buffer-real ]]
    umask 077
    printf 'socket=%s\ntoken=%s\ncli=%s\n' \
        "${ZENTTY_INSTANCE_SOCKET}" "${ZENTTY_PANE_TOKEN}" "${ZENTTY_CLI_BIN}" \
        >"${ZENTTY_TMUX_ENDPOINT_RECEIPT}"
    "${ZENTTY_CLI_BIN}" __tmux-compat kill-pane -t "%${ZENTTY_PANE_ID}"
    sleep 30
    exit 1
fi

if [[ "${ZENTTY_PANE_ID}" == pane-1 && "${ZENTTY_TMUX_RECOVERY_PROBE:-}" == 1 ]]; then
    [[ -z "$("${ZENTTY_CLI_BIN}" __tmux-compat show-buffer -b agent)" ]]
    printf recovered-buffer | "${ZENTTY_CLI_BIN}" __tmux-compat set-buffer -b recovered
    [[ "$("${ZENTTY_CLI_BIN}" __tmux-compat show-buffer -b recovered)" == recovered-buffer ]]
    "${ZENTTY_CLI_BIN}" __tmux-compat kill-pane -t "%${ZENTTY_PANE_ID}"
    sleep 30
    exit 1
fi

if [[ "${ZENTTY_TOPOLOGY_PERSIST_SETUP:-}" == 1 ]]; then
    if [[ "${ZENTTY_PANE_ID}" != pane-1 ]]; then
        sleep 30
        exit 1
    fi
    persisted_grid="$(${ZENTTY_CLI_BIN} grid 2x2 --focus source --json)"
    persisted_layout="$(${ZENTTY_CLI_BIN} layout golden-wide --json)"
    jq -e '
        .action == "grid" and (.createdPaneIDs | length) == 3 and
        (.topology.columns | length) == 2 and
        all(.topology.columns[]; (.panes | length) == 2)
    ' <<<"${persisted_grid}" >/dev/null
    jq -e '.action == "layout" and (.topology.columns | length) == 2' \
        <<<"${persisted_layout}" >/dev/null
    printf '%s\n' "${persisted_layout}" >"${ZENTTY_TOPOLOGY_RECEIPT}"
    sleep 30
    exit 1
fi

if [[ "${ZENTTY_TOPOLOGY_PERSIST_VERIFY:-}" == 1 ]]; then
    if [[ "${ZENTTY_PANE_ID}" != pane-1 ]]; then
        sleep 30
        exit 1
    fi
    for _ in {1..200}; do
        restored_panes="$(${ZENTTY_CLI_BIN} list panes --json)"
        [[ "$(jq length <<<"${restored_panes}")" == 4 ]] && break
        sleep 0.02
    done
    [[ "$(jq length <<<"${restored_panes}")" == 4 ]]
    restored_layout="$(${ZENTTY_CLI_BIN} layout golden-wide --json)"
    jq -e '
        .action == "layout" and (.topology.columns | length) == 2 and
        all(.topology.columns[]; (.panes | length) == 2)
    ' <<<"${restored_layout}" >/dev/null
    printf '%s\n' "${restored_layout}" >"${ZENTTY_TOPOLOGY_RECEIPT}"
    sleep 30
    exit 1
fi

if [[ "${ZENTTY_TOPOLOGY_REPRESENTATIVE:-}" == 1 ]]; then
    if [[ "${ZENTTY_PANE_ID}" != pane-1 ]]; then
        sleep 30
        exit 1
    fi
    representative_grid="$(${ZENTTY_CLI_BIN} grid 2x2 --focus last --json)"
    jq -e '
        .action == "grid" and (.createdPaneIDs | length) == 3 and
        .focusedPaneID == .createdPaneIDs[-1] and (.topology.columns | length) == 2 and
        all(.topology.columns[]; (.panes | length) == 2)
    ' <<<"${representative_grid}" >/dev/null
    representative_before="$(jq -r '.topology.viewportWidth' <<<"${representative_grid}")"
    representative_layout="$(${ZENTTY_CLI_BIN} layout golden-wide --json)"
    jq -e '
        .action == "layout" and .focusedPaneID as $focused |
        [.topology.columns[] | select(any(.panes[]; .id == $focused))][0].width >
            [.topology.columns[] | select(all(.panes[]; .id != $focused))][0].width
    ' <<<"${representative_layout}" >/dev/null
    printf 'representative-topology=2x2 layout=golden-wide\n' >>"${ZENTTY_TMUX_PRODUCT_PROBE}"
    if [[ "${ZENTTY_TEST_EXTERNAL_RESIZE:-}" == 1 || \
        "${ZENTTY_NESTED_WAYLAND_OUTER_X11_INPUT:-}" == 1 ]]; then
        if [[ "${GDK_BACKEND}" == x11 ]]; then
            outer_window="$(xdotool search --onlyvisible --name '^Zentty$' | tail -1)"
        else
            outer_window="${ZENTTY_NESTED_WAYLAND_OUTER_X11_WINDOW:?}"
        fi
        outer_geometry="$(xdotool getwindowgeometry --shell "${outer_window}")"
        outer_width="$(sed -n 's/^WIDTH=//p' <<<"${outer_geometry}")"
        outer_height="$(sed -n 's/^HEIGHT=//p' <<<"${outer_geometry}")"
        xdotool windowsize "${outer_window}" "$((outer_width - 100))" "$((outer_height - 50))"
        sleep 0.25
        representative_after="$(${ZENTTY_CLI_BIN} layout reset --json)"
        [[ "$(jq -r '.topology.viewportWidth' <<<"${representative_after}")" != \
            "${representative_before}" ]]
        printf 'representative-external-resize=validated\n' >>"${ZENTTY_TMUX_PRODUCT_PROBE}"
    fi
    representative_panes="$(${ZENTTY_CLI_BIN} list panes --include-control-token --json)"
    while IFS=$'\t' read -r pane_id pane_token; do
        [[ "${pane_id}" != pane-1 ]] || continue
        env ZENTTY_PANE_TOKEN="${pane_token}" \
            ${ZENTTY_CLI_BIN} pane close --pane-id "${pane_id}" --pane-token "${pane_token}"
    done < <(jq -r '.[] | [.id,.controlToken] | @tsv' <<<"${representative_panes}")
    ${ZENTTY_CLI_BIN} __tmux-compat kill-window
    sleep 30
    exit 1
fi

if [[ "${ZENTTY_PANE_ID}" != pane-1 ]]; then
    if [[ "${ZENTTY_SPLIT_PROBE:-}" == 1 ]]; then
        printf 'split-started=%s cwd=%s\n' "${ZENTTY_PANE_ID}" "${PWD}" \
            >>"${ZENTTY_TMUX_PRODUCT_PROBE}"
    fi
    if [[ "${ZENTTY_DEFERRED_PROBE:-}" == 1 ]]; then
        printf 'deferred-started=%s cwd=%s\n' "${ZENTTY_PANE_ID}" "${PWD}" \
            >>"${ZENTTY_TMUX_PRODUCT_PROBE}"
        printf '\033]2;zentty-tmux-team-%s\a' "${ZENTTY_PANE_ID}"
        sleep 30
        exit 1
    fi
    if [[ "${ZENTTY_RESPAWN_PROBE:-}" == 1 ]]; then
        printf 'respawned=%s\n' "${ZENTTY_PANE_ID}" >>"${ZENTTY_TMUX_PRODUCT_PROBE}"
    fi
    IFS= read -r value
    if [[ "${value}" == sh\ -c* ]]; then
        eval "${value}"
        IFS= read -r value
        [[ "${value}" == sh\ -c* ]]
        eval "${value}"
        sleep 30
        exit 1
    fi
    [[ "${value}" == team-ready ]]
    printf '\033]2;zentty-tmux-team-%s\a' "${ZENTTY_PANE_ID}"
    sleep 30
    exit 1
fi

[[ "${CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS}" == 1 ]]
[[ -n "${ZENTTY_INSTANCE_ID}" ]]
[[ -x "${ZENTTY_TMUX_SHIM_DIR}/tmux" ]]
[[ "$(readlink -f -- "$(command -v tmux)")" == "$(readlink -f -- "${ZENTTY_TMUX_SHIM_DIR}/tmux")" ]]
instance_runtime="$(dirname -- "${ZENTTY_INSTANCE_SOCKET}")"
[[ "${TMUX}" == "${instance_runtime}/tmux-compat,0,${ZENTTY_PANE_ID}" ]]
[[ "${TMUX_PANE}" == "%${ZENTTY_PANE_ID}" ]]
[[ "${ZDOTDIR}" == "${ZENTTY_SHELL_INTEGRATION_DIR}" ]]
[[ -f "${ZENTTY_SHELL_INTEGRATION_DIR}/.zshenv" ]]
[[ -f "${ZENTTY_SHELL_INTEGRATION_DIR}/zentty-bash-integration.bash" ]]
[[ -f "${ZENTTY_SHELL_INTEGRATION_DIR}/fish/vendor_conf.d/zentty-shell-integration.fish" ]]
[[ -f "${ZENTTY_SHELL_INTEGRATION_DIR}/nushell/vendor/autoload/zentty.nu" ]]
[[ "${PROMPT_COMMAND}" == '. "$ZENTTY_SHELL_INTEGRATION_DIR/zentty-bash-integration.bash"' ]]
[[ "$("${ZENTTY_CLI_BIN}" version)" =~ ^zentty\ [0-9]+\.[0-9]+\.[0-9]+\ \([0-9a-f]{12}\)$ ]]
umask 077
printf 'socket=%s\ntoken=%s\ncli=%s\n' \
    "${ZENTTY_INSTANCE_SOCKET}" "${ZENTTY_PANE_TOKEN}" "${ZENTTY_CLI_BIN}" \
    >"${ZENTTY_TMUX_ENDPOINT_RECEIPT}"
[[ ":${XDG_DATA_DIRS}:" == *":${ZENTTY_SHELL_INTEGRATION_DIR}:"* ]]
has_system_data_directory=false
IFS=: read -r -a data_directories <<<"${XDG_DATA_DIRS}"
for data_directory in "${data_directories[@]}"; do
    if [[ "${data_directory%/}" == /usr/share ]]; then
        has_system_data_directory=true
        break
    fi
done
[[ "${has_system_data_directory}" == true ]]
pane="$(${ZENTTY_CLI_BIN} __tmux-compat display-message -p '#{pane_id}')"
[[ "${pane}" == "%${ZENTTY_PANE_ID}" ]]
shim_pane="$(tmux -S ignored display-message -p '#{pane_id}')"
[[ "${shim_pane}" == "%${ZENTTY_PANE_ID}" ]]
listed="$(${ZENTTY_CLI_BIN} __tmux-compat list-panes -F '#{pane_id}')"
[[ "${listed}" == "%${ZENTTY_PANE_ID}" ]]
${ZENTTY_CLI_BIN} __tmux-compat wait-for --timeout 2 product-wait-ready &
waiter=$!
sleep 0.15
# A pending wait uses short authenticated probes; it must not occupy the app
# callback or prevent another real command from receiving a response.
pane="$(${ZENTTY_CLI_BIN} __tmux-compat display-message -p '#{pane_id}')"
[[ "${pane}" == "%${ZENTTY_PANE_ID}" ]]
${ZENTTY_CLI_BIN} __tmux-compat wait-for -S product-wait-ready
wait "${waiter}"
${ZENTTY_CLI_BIN} __tmux-compat wait-for -S product-pre-signalled
${ZENTTY_CLI_BIN} __tmux-compat wait-for --timeout 1 product-pre-signalled
if ${ZENTTY_CLI_BIN} __tmux-compat wait-for --timeout 0.06 product-never-signalled \
    2>"${TMPDIR:-/tmp}/zentty-wait-timeout.$$"; then
    exit 1
fi
grep -Fxq "zentty: tmux wait-for: timed out waiting for 'product-never-signalled'" \
    "${TMPDIR:-/tmp}/zentty-wait-timeout.$$"
rm -f -- "${TMPDIR:-/tmp}/zentty-wait-timeout.$$"
first="$(${ZENTTY_CLI_BIN} __tmux-compat split-window -h -c "${ZENTTY_TMUX_SPLIT_CWD}" \
    -P -F '#{pane_id}' "env ZENTTY_SPLIT_PROBE=1 $0")"
second="$(${ZENTTY_CLI_BIN} __tmux-compat split-window -v -d -P -F '#{pane_id}')"
first_id="${first#%}"
second_id="${second#%}"
[[ "${first_id}" != "${first}" && "${second_id}" != "${second}" ]]
[[ "${first_id}" != "${second_id}" ]]
for _ in {1..100}; do
    grep -Fxq "split-started=${first_id} cwd=${ZENTTY_TMUX_SPLIT_CWD}" \
        "${ZENTTY_TMUX_PRODUCT_PROBE}" 2>/dev/null && break
    sleep 0.02
done
grep -Fxq "split-started=${first_id} cwd=${ZENTTY_TMUX_SPLIT_CWD}" \
    "${ZENTTY_TMUX_PRODUCT_PROBE}"
if ${ZENTTY_CLI_BIN} __tmux-compat capture-pane -p -t "%${second_id}"; then
    exit 1
fi
if ${ZENTTY_CLI_BIN} __tmux-compat respawn-pane -k -t "%${first_id}"; then
    exit 1
fi
listed="$(${ZENTTY_CLI_BIN} __tmux-compat list-panes -F '#{pane_id}')"
[[ "${listed}" == $'%pane-1\n%'"${first_id}"$'\n%'"${second_id}" ]]
${ZENTTY_CLI_BIN} __tmux-compat respawn-pane -k -t "%${first_id}" \
    -- "env ZENTTY_RESPAWN_PROBE=1 $0"
for _ in {1..100}; do
    listed="$(${ZENTTY_CLI_BIN} __tmux-compat list-panes -F '#{pane_id}')"
    [[ "${listed}" == $'%pane-1\n%'"${first_id}"$'\n%'"${second_id}" ]] && break
    sleep 0.02
done
[[ "${listed}" == $'%pane-1\n%'"${first_id}"$'\n%'"${second_id}" ]]
${ZENTTY_CLI_BIN} __tmux-compat select-layout -t @foreign main-vertical
${ZENTTY_CLI_BIN} __tmux-compat select-layout even-vertical
${ZENTTY_CLI_BIN} __tmux-compat select-layout tiled
${ZENTTY_CLI_BIN} __tmux-compat resize-pane -t "%${second_id}" -x 30%
${ZENTTY_CLI_BIN} __tmux-compat resize-pane -t "%${second_id}" -x 30
sleep 0.2
${ZENTTY_CLI_BIN} __tmux-compat send-keys -t "%${first_id}" team-ready Enter
${ZENTTY_CLI_BIN} __tmux-compat send-keys -t "%${second_id}" \
    "env ZENTTY_DEFERRED_PROBE=1 $0" Enter
for _ in {1..100}; do
    grep -Fxq "deferred-started=${second_id} cwd=${ZENTTY_TMUX_SPLIT_CWD}" \
        "${ZENTTY_TMUX_PRODUCT_PROBE}" 2>/dev/null && break
    sleep 0.02
done
grep -Fxq "deferred-started=${second_id} cwd=${ZENTTY_TMUX_SPLIT_CWD}" \
    "${ZENTTY_TMUX_PRODUCT_PROBE}"
${ZENTTY_CLI_BIN} __tmux-compat send-keys \
    -t "%${ZENTTY_PANE_ID}" agent-real-input Enter
IFS= read -r value
[[ "${value}" == agent-real-input ]]
printf '\033]2;zentty-tmux-compat-real\a'
printf 'zentty-capture-real-one\nzentty-capture-real-two\n'
sleep 0.2
captured="$(${ZENTTY_CLI_BIN} __tmux-compat capture-pane -p -t "%${ZENTTY_PANE_ID}")"
[[ "${captured}" == *zentty-capture-real-one* ]]
[[ "${captured}" == *zentty-capture-real-two* ]]
${ZENTTY_CLI_BIN} __tmux-compat capture-pane -t "%${ZENTTY_PANE_ID}"
buffered="$(${ZENTTY_CLI_BIN} __tmux-compat show-buffer -b default)"
[[ "${buffered}" == *zentty-capture-real-two* ]]
printf named-buffer-real | ${ZENTTY_CLI_BIN} __tmux-compat set-buffer -b agent
[[ "$(${ZENTTY_CLI_BIN} __tmux-compat save-buffer -b agent)" == named-buffer-real ]]
printf loaded-buffer-real | ${ZENTTY_CLI_BIN} __tmux-compat load-buffer -b loaded
[[ "$(${ZENTTY_CLI_BIN} __tmux-compat show-buffer -b loaded)" == loaded-buffer-real ]]
${ZENTTY_CLI_BIN} __tmux-compat kill-pane -t "%${first_id}"
listed="$(${ZENTTY_CLI_BIN} __tmux-compat list-panes -F '#{pane_id}')"
[[ "${listed}" == $'%pane-1\n%'"${second_id}" ]]
${ZENTTY_CLI_BIN} __tmux-compat kill-pane -t "%${second_id}"
listed="$(${ZENTTY_CLI_BIN} __tmux-compat list-panes -F '#{pane_id}')"
[[ "${listed}" == '%pane-1' ]]
[[ "$(${ZENTTY_CLI_BIN} version)" == zentty\ * ]]
windows="$(${ZENTTY_CLI_BIN} list windows --json)"
jq -e '
    length == 1 and .[0].id == "window-1" and .[0].order == 1 and
    .[0].isFocused == true and .[0].worklaneCount == 1 and .[0].paneCount == 1
' <<<"${windows}" >/dev/null
${ZENTTY_CLI_BIN} pane rename "CLI source pane"
${ZENTTY_CLI_BIN} worklane rename "CLI source lane"
${ZENTTY_CLI_BIN} worklane color blue
split_receipt="$(${ZENTTY_CLI_BIN} split right --equal --json)"
jq -e '
    .version == 1 and .action == "split" and .windowID == "window-1" and
    .worklaneID == "worklane-1" and .sourcePaneID == "pane-1" and
    (.createdPaneIDs | length) == 1 and (.affectedPaneIDs | length) == 2 and
    (.topology.columns | length) == 2 and
    all(.topology.columns[]; (.panes | length) == 1) and
    (tostring | contains("controlToken") | not) and
    (tostring | contains("ZENTTY_PANE_TOKEN") | not)
' <<<"${split_receipt}" >/dev/null
[[ "$(${ZENTTY_CLI_BIN} theme dark)" == dark ]]
${ZENTTY_CLI_BIN} pane zoom
${ZENTTY_CLI_BIN} pane zoom
${ZENTTY_CLI_BIN} notify --title "CLI ready" --subtitle "Review" \
    --body $'Line one\nline two' --silent
${ZENTTY_CLI_BIN} notify --title "Ephemeral" --no-inbox --silent
panes="$(${ZENTTY_CLI_BIN} list panes --include-control-token --json)"
printf 'cli-stage=discovered-split\n' >>"${ZENTTY_TMUX_PRODUCT_PROBE}"
jq -e '
    length == 2 and
    any(.[]; .id == "pane-1" and .title == "CLI source pane" and .isFocused == false) and
    any(.[]; .id != "pane-1" and .isFocused == true and (.controlToken | test("^[0-9a-f]{64}$")))
' <<<"${panes}" >/dev/null
cli_split_id="$(jq -r '.[] | select(.id != "pane-1") | .id' <<<"${panes}")"
cli_split_token="$(jq -r --arg id "${cli_split_id}" '.[] | select(.id == $id) | .controlToken' <<<"${panes}")"
if ${ZENTTY_CLI_BIN} pane close --pane-id "${cli_split_id}" \
    2>"${TMPDIR:-/tmp}/zentty-cli-selector.$$"; then
    exit 1
fi
cat "${TMPDIR:-/tmp}/zentty-cli-selector.$$" >>"${ZENTTY_TMUX_PRODUCT_PROBE}"
grep -Fq 'unauthorized_target' "${TMPDIR:-/tmp}/zentty-cli-selector.$$"
rm -f -- "${TMPDIR:-/tmp}/zentty-cli-selector.$$"
printf 'cli-stage=rejected-mismatched-selector\n' >>"${ZENTTY_TMUX_PRODUCT_PROBE}"
if ! env ZENTTY_PANE_TOKEN="${cli_split_token}" \
    ${ZENTTY_CLI_BIN} pane focus 2 --pane-token "${cli_split_token}" \
    2>>"${ZENTTY_TMUX_PRODUCT_PROBE}"; then
    exit 1
fi
printf 'cli-stage=focused-by-index\n' >>"${ZENTTY_TMUX_PRODUCT_PROBE}"
if ! resize_receipt="$(env ZENTTY_PANE_TOKEN="${cli_split_token}" \
    ${ZENTTY_CLI_BIN} pane resize 60% --json --pane-token "${cli_split_token}" \
    2>>"${ZENTTY_TMUX_PRODUCT_PROBE}")"; then
    exit 1
fi
jq -e '
    .action == "resize" and .focusedPaneID as $focused |
    ([.topology.columns[] | select(any(.panes[]; .id == $focused))][0].width /
        .topology.viewportWidth - 0.60 | fabs) < 0.02
' <<<"${resize_receipt}" >/dev/null
printf 'cli-stage=resized-by-percentage\n' >>"${ZENTTY_TMUX_PRODUCT_PROBE}"
env ZENTTY_PANE_TOKEN="${cli_split_token}" \
    ${ZENTTY_CLI_BIN} pane close --pane-id "${cli_split_id}" --pane-token "${cli_split_token}" \
    2>>"${ZENTTY_TMUX_PRODUCT_PROBE}"
printf 'cli-stage=closed-split\n' >>"${ZENTTY_TMUX_PRODUCT_PROBE}"
for _ in {1..100}; do
    panes="$(${ZENTTY_CLI_BIN} list panes --json)"
    [[ "$(jq length <<<"${panes}")" == 1 ]] && break
    sleep 0.02
done
[[ "$(jq length <<<"${panes}")" == 1 ]]
below_receipt="$(${ZENTTY_CLI_BIN} split down --ratio 65 --json)"
jq -e '
    .action == "split" and .focusedPaneID as $focused |
    ([.topology.columns[].panes[] | select(.id == $focused)][0].heightFraction - 0.65 | fabs) < 0.000001
' <<<"${below_receipt}" >/dev/null
panes="$(${ZENTTY_CLI_BIN} list panes --include-control-token --json)"
cli_below_id="$(jq -r '.[] | select(.id != "pane-1") | .id' <<<"${panes}")"
cli_below_token="$(jq -r --arg id "${cli_below_id}" '.[] | select(.id == $id) | .controlToken' <<<"${panes}")"
env ZENTTY_PANE_TOKEN="${cli_below_token}" \
    ${ZENTTY_CLI_BIN} pane close --pane-id "${cli_below_id}" --pane-token "${cli_below_token}"
for _ in {1..100}; do
    panes="$(${ZENTTY_CLI_BIN} list panes --json)"
    [[ "$(jq length <<<"${panes}")" == 1 ]] && break
    sleep 0.02
done
[[ "$(jq length <<<"${panes}")" == 1 ]]
left_receipt="$(${ZENTTY_CLI_BIN} split left --json)"
jq -e '
    .action == "split" and (.createdPaneIDs | length) == 1 and
    .topology.columns[0].panes[0].id == .createdPaneIDs[0] and
    .topology.columns[1].panes[0].id == "pane-1" and
    ((.topology.columns[0].width - .topology.columns[1].width) | fabs) < 0.001
' <<<"${left_receipt}" >/dev/null
left_id="$(jq -r '.createdPaneIDs[0]' <<<"${left_receipt}")"
left_token="$(${ZENTTY_CLI_BIN} list panes --include-control-token --json |
    jq -r --arg id "${left_id}" '.[] | select(.id == $id) | .controlToken')"
env ZENTTY_PANE_TOKEN="${left_token}" \
    ${ZENTTY_CLI_BIN} pane close --pane-id "${left_id}" --pane-token "${left_token}"
up_receipt="$(${ZENTTY_CLI_BIN} split up --json)"
jq -e '
