    [[ -s "${topology_receipt}" ]] && break
    kill -0 "${topology_pid}" 2>/dev/null || break
    sleep 0.02
done
[[ -s "${topology_receipt}" ]] || fail "topology persistence setup produced no receipt"
snapshot="${topology_state}/restore-snapshot.json"
for _ in {1..400}; do
    [[ -f "${snapshot}" ]] && jq -e '
        .workspace.windows[0].worklanes[0].columns | length == 2 and
        all(.[]; (.panes | length) == 2)
    ' "${snapshot}" >/dev/null 2>&1 && break
    kill -0 "${topology_pid}" 2>/dev/null || break
    sleep 0.02
done
[[ -f "${snapshot}" ]] || fail "topology persistence setup produced no live snapshot"
kill -KILL "${topology_pid}"
set +e
wait "${topology_pid}"
topology_status=$?
set -e
[[ "${topology_status}" == 137 ]] || {
    cat "${topology_log}" >&2
    fail "topology persistence crash exited ${topology_status} instead of 137"
}
jq -e '
    .workspace.windows[0].worklanes[0].columns | length == 2 and
    all(.[]; (.panes | length) == 2) and
    ([.[].width] | max) > ([.[].width] | min) and
    all(.[]; (.paneHeights | length) == 2)
' "${snapshot}" >/dev/null || fail "clean snapshot lost the CLI-created 2x2 golden topology"
! grep -Fq 'controlToken' "${snapshot}" || fail "snapshot persisted a pane capability field"
! grep -Fq 'ZENTTY_PANE_TOKEN' "${snapshot}" || fail "snapshot persisted a capability environment name"
rm -f -- "${topology_receipt}"
env -u TMUX -u TMUX_PANE \
    ZENTTY_TOPOLOGY_PERSIST_VERIFY=1 \
    ZENTTY_TOPOLOGY_RECEIPT="${topology_receipt}" \
    ZENTTY_TMUX_PRODUCT_PROBE="${fixture_root}/topology-restart-child-probe.log" \
    "${product}" --command "${child}" \
    --state-directory "${topology_state}" >"${topology_restart_log}" 2>&1 &
topology_restart_pid=$!
for _ in {1..400}; do
    [[ -s "${topology_receipt}" ]] && break
    kill -0 "${topology_restart_pid}" 2>/dev/null || break
    sleep 0.02
done
[[ -s "${topology_receipt}" ]] || fail "topology persistence restart produced no receipt"
# Consumed by the sourced physical-input helper.
# shellcheck disable=SC2034
product_pid="${topology_restart_pid}"
zentty_product_prepare_input "${backend}" "${topology_restart_log}" ||
    fail "topology persistence restart window could not receive real close input"
zentty_product_close_window "${backend}"
set +e
wait "${topology_restart_pid}"
topology_restart_status=$?
set -e
[[ "${topology_restart_status}" == 0 ]] || {
    cat "${topology_restart_log}" >&2
    fail "topology persistence restart exited ${topology_restart_status}"
}
jq -e '
    .action == "layout" and (.topology.columns | length) == 2 and
    all(.topology.columns[]; (.panes | length) == 2)
' "${topology_receipt}" >/dev/null || fail "restarted CLI topology was not the persisted 2x2 grid"
fi

old_socket="$(sed -n 's/^socket=//p' "${endpoint_receipt}")"
old_token="$(sed -n 's/^token=//p' "${endpoint_receipt}")"
staged_cli="$(sed -n 's/^cli=//p' "${endpoint_receipt}")"
[[ "${old_socket}" == /* && "${old_token}" =~ ^[0-9a-f]{64}$ && -x "${staged_cli}" ]] ||
    fail "first product instance did not publish a private endpoint receipt"
[[ ! -e "${old_socket}" ]] || fail "first product instance left its socket behind"
if env ZENTTY_INSTANCE_SOCKET="${old_socket}" ZENTTY_PANE_TOKEN="${old_token}" \
    "${staged_cli}" __tmux-compat display-message -p '#{pane_id}' >/dev/null 2>&1; then
    fail "stale CLI environment reached the stopped first product instance"
fi
[[ -f "${tmux_store}" ]] || fail "first product instance did not publish its XDG compatibility store"
[[ "$(stat -c %a "${tmux_store}")" == 600 ]] || fail "compatibility store is not private"
jq -e '
    .version == 1 and
    .anchors == {} and
    .activePaneIDs == {} and
    .buffers.agent == "named-buffer-real" and
    .buffers.loaded == "loaded-buffer-real" and
    (.buffers.default | contains("zentty-capture-real-two"))
' "${tmux_store}" >/dev/null || fail "first product compatibility store is incomplete"
if grep -Fq "${old_token}" "${tmux_store}" || grep -Fq "${old_socket}" "${tmux_store}"; then
    fail "pane capability or instance socket escaped into the compatibility store"
fi
for forbidden in credential prompt transcript; do
    if grep -Fiq "${forbidden}" "${tmux_store}"; then
        fail "forbidden ${forbidden} field escaped into the compatibility store"
    fi
done

set +e
env -u TMUX -u TMUX_PANE \
    CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS=1 \
    ZENTTY_TMUX_PRODUCT_PROBE="${fixture_root}/restart-child-probe.log" \
    ZENTTY_TMUX_ENDPOINT_RECEIPT="${endpoint_receipt}" \
    ZENTTY_TMUX_RESTART_PROBE=1 \
    ZENTTY_TMUX_OLD_SOCKET="${old_socket}" \
    ZENTTY_TMUX_OLD_TOKEN="${old_token}" \
    timeout 10s "${product}" \
    --command "${child}" \
    --no-session-restore \
    --state-directory "${fixture_root}/restart-state" >"${restart_log}" 2>&1
restart_status=$?
set -e
if [[ "${restart_status}" -ne 0 ]]; then
    cat "${restart_log}" >&2
    [[ ! -f "${fixture_root}/restart-child-probe.log" ]] ||
        cat "${fixture_root}/restart-child-probe.log" >&2
    fail "restarted staged product exited ${restart_status}"
fi
assert_no_child_assertion "${fixture_root}/restart-child-probe.log" "${restart_log}"
fresh_socket="$(sed -n 's/^socket=//p' "${endpoint_receipt}")"
fresh_token="$(sed -n 's/^token=//p' "${endpoint_receipt}")"
[[ "${fresh_socket}" == /* && "${fresh_socket}" != "${old_socket}" ]] ||
    fail "restarted product reused its first socket"
[[ "${fresh_token}" =~ ^[0-9a-f]{64}$ && "${fresh_token}" != "${old_token}" ]] ||
    fail "restarted product reused its first pane capability"
[[ ! -e "${fresh_socket}" ]] || fail "restarted product left its socket behind"
if grep -Fq 'command=SplitWindow' "${restart_log}"; then
    cat "${restart_log}" >&2
    fail "stale pane capability routed a mutating command after restart"
fi
grep -Fxq 'zentty-linux: tmux-command pane=pane-1 worklane=worklane-1 command=ListPanes' \
    "${restart_log}" || fail "fresh capability did not route after restart"
grep -Fxq 'zentty-linux: tmux-command pane=pane-1 worklane=worklane-1 command=KillPane' \
    "${restart_log}" || fail "restarted product did not tear its real pane down"

printf 'not valid tmux JSON\n' >"${tmux_store}"
set +e
env -u TMUX -u TMUX_PANE \
    CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS=1 \
    ZENTTY_TMUX_PRODUCT_PROBE="${fixture_root}/recovery-child-probe.log" \
    ZENTTY_TMUX_RECOVERY_PROBE=1 \
    timeout 10s "${product}" \
    --command "${child}" \
    --no-session-restore \
    --state-directory "${fixture_root}/recovery-state" >"${recovery_log}" 2>&1
recovery_status=$?
set -e
if [[ "${recovery_status}" -ne 0 ]]; then
    cat "${recovery_log}" >&2
    fail "corrupt-store recovery product exited ${recovery_status}"
fi
assert_no_child_assertion "${fixture_root}/recovery-child-probe.log" "${recovery_log}"
grep -Fq 'zentty-linux: tmux-store-recovered quarantine=' "${recovery_log}" ||
    fail "corrupt compatibility store was not quarantined"
mapfile -t quarantines < <(find "$(dirname "${tmux_store}")" -maxdepth 1 -type f \
    -name 'tmux-compat-store.json.corrupt.*' -print)
[[ "${#quarantines[@]}" -eq 1 ]] || fail "corrupt compatibility store receipt count is not exact"
grep -Fxq 'not valid tmux JSON' "${quarantines[0]}" ||
    fail "quarantined compatibility store did not preserve exact bytes"
jq -e '.version == 1 and .buffers.recovered == "recovered-buffer"' \
    "${tmux_store}" >/dev/null || fail "recovered compatibility store is not valid v1 state"

[[ "$(grep -Fxc 'zentty-linux: tmux-command pane=pane-1 worklane=worklane-1 command=DisplayMessage' "${log}" || true)" -eq 3 ]] || {
    cat "${log}" >&2
    [[ ! -f "${fixture_root}/child-probe.log" ]] || cat "${fixture_root}/child-probe.log" >&2
    fail "real display-message did not cross the product handler"
}
[[ "$(grep -Fxc 'zentty-linux: tmux-command pane=pane-1 worklane=worklane-1 command=WaitFor' "${log}" || true)" -ge 7 ]] || {
    cat "${log}" >&2
    fail "real wait-for signal, consume, pending, and timeout requests did not cross the product handler"
}
awk '
    /command=DisplayMessage$/ { displays += 1 }
    displays == 2 && /command=WaitFor$/ { pending_before_independent_command = 1 }
    END { exit !(displays == 3 && pending_before_independent_command == 1) }
' "${log}" || {
    cat "${log}" >&2
    fail "pending wait probe did not precede the independent display command"
}
[[ "$(grep -Fxc 'zentty-linux: tmux-command pane=pane-1 worklane=worklane-1 command=ListPanes' "${log}" || true)" -eq 5 ]] || {
    cat "${log}" >&2
    fail "real list-panes did not cross the product handler"
}
[[ "$(grep -Fxc 'zentty-linux: tmux-command pane=pane-1 worklane=worklane-1 command=KillPane' "${log}" || true)" -eq 2 ]] || {
    cat "${log}" >&2
    fail "two real kill-pane commands did not cross the product handler"
}
[[ "$(grep -Fxc 'zentty-linux: tmux-command pane=pane-1 worklane=worklane-1 command=SelectLayout' "${log}" || true)" -eq 3 ]] || {
    cat "${log}" >&2
    fail "three real select-layout commands did not cross the product handler"
}
[[ "$(grep -Fxc 'zentty-linux: tmux-command pane=pane-1 worklane=worklane-1 command=ResizePane' "${log}" || true)" -eq 2 ]] || {
    cat "${log}" >&2
    fail "two real resize-pane commands did not cross the product handler"
}
[[ "$(grep -Fxc 'zentty-linux: tmux-command pane=pane-1 worklane=worklane-1 command=SendKeys' "${log}" || true)" -eq 3 ]] || {
    cat "${log}" >&2
    fail "real send-keys did not cross the product handler"
}
[[ "$(grep -Fxc 'zentty-linux: tmux-command pane=pane-1 worklane=worklane-1 command=SplitWindow' "${log}" || true)" -eq 4 ]] || {
    cat "${log}" >&2
    fail "four real split-window commands did not cross the product handler"
}
[[ "$(grep -Fxc 'zentty-linux: tmux-command pane=pane-1 worklane=worklane-1 command=RespawnPane' "${log}" || true)" -eq 2 ]] || {
    cat "${log}" >&2
    fail "valid and rejected real respawn-pane commands did not cross the product handler"
}
grep -Fxq 'zentty-linux: tmux-respawn pane=pane-2' "${log}" || {
    cat "${log}" >&2
    fail "real respawn-pane did not replace the targeted Ghostty PTY child"
}
grep -Eq 'zentty-linux: cli-split-layout direction=right mode=equal changed=(true|false)' "${log}" ||
    fail "public CLI equal split did not apply its source layout policy"
grep -Eq 'zentty-linux: cli-pane-resize pane=pane-[0-9]+ percentage=60 width=[0-9]+\.[0-9]+' "${log}" ||
    fail "public CLI percentage resize did not mutate the authenticated real pane"
grep -Eq 'zentty-linux: cli-split-layout direction=down mode=ratio-65 changed=true' "${log}" ||
    fail "public CLI vertical split ratio did not apply to the real pane weights"
grep -Fxq 'zentty-linux: worklane-peek=open trigger=cli' "${log}" ||
    fail "public CLI zoom did not open the real zoomed-out pane view"
grep -Fxq 'zentty-linux: worklane-peek=cancel' "${log}" ||
    fail "second public CLI zoom did not restore the normal pane view"
grep -Eq 'zentty-linux: cli-window-select window=window-1 worklane=worklane-1 pane=pane-1 changed=(true|false)' "${log}" ||
    fail "public CLI focus did not present the original GTK window through the coordinator"
grep -Eq 'zentty-linux: cli-window-select window=window-2 worklane=worklane-window-2 pane=pane-window-2 changed=(true|false)' "${log}" ||
    fail "public CLI focus did not present the new GTK window through the coordinator"
grep -Eq 'zentty-linux: cli-notification inbox=true pane=pane-1 title-bytes=9 body-bytes=24' "${log}" ||
    fail "public CLI pane notification did not enter the one shared inbox"
grep -Eq 'zentty-linux: cli-notification inbox=false pane=pane-1 title-bytes=9 body-bytes=0' "${log}" ||
    fail "public CLI --no-inbox notification did not bypass inbox persistence"
grep -Fxq 'zentty-linux: tmux-deferred pane=pane-3' "${log}" || {
    cat "${log}" >&2
    fail "commandless split did not remain launch-deferred"
}
grep -Fxq 'zentty-linux: tmux-deferred-launch pane=pane-3' "${log}" || {
    cat "${log}" >&2
    fail "submitted send-keys command did not launch the deferred pane"
}
awk '
    /zentty-linux: tmux-deferred pane=pane-3$/ { deferred = NR }
    /zentty-linux: surface-owned pane=pane-3 / { surface = NR }
    /zentty-linux: tmux-deferred-launch pane=pane-3$/ { launched = NR }
    END { exit !(deferred > 0 && surface > deferred && launched >= surface) }
' "${log}" || {
    cat "${log}" >&2
    fail "deferred pane acquired a surface before its submitted launch command"
}
grep -Fxq 'respawned=pane-2' "${fixture_root}/child-probe.log" || {
    cat "${log}" >&2
    fail "respawned command did not run in the targeted real pane"
}
[[ "$(grep -Fxc 'zentty-linux: tmux-command pane=pane-1 worklane=worklane-1 command=KillWindow' "${log}" || true)" -eq 1 ]] || {
    cat "${log}" >&2
    fail "real kill-window did not cross the product handler"
}
[[ "$(grep -Fxc 'zentty-linux: tmux-command pane=pane-1 worklane=worklane-1 command=CapturePane' "${log}" || true)" -eq 3 ]] || {
    cat "${log}" >&2
    fail "real capture-pane did not reject deferred text then read printed and buffered terminal text"
}
for command in SetBuffer SaveBuffer LoadBuffer ShowBuffer; do
    grep -Fxq "zentty-linux: tmux-command pane=pane-1 worklane=worklane-1 command=${command}" "${log}" || {
        cat "${log}" >&2
        fail "real ${command} did not cross the product handler"
    }
done
grep -Fxq 'zentty-linux: tmux-layout equalize=pane-2 golden=pane-1 changed=false' "${log}" || {
    cat "${log}" >&2
    fail "main-vertical did not target the real teammate and leader columns"
}
grep -Fxq 'zentty-linux: tmux-layout equalize=pane-2 golden=none changed=false' "${log}" || {
    cat "${log}" >&2
    fail "even-vertical did not target the real teammate column"
}
[[ "$(grep -Fxc 'zentty-linux: tmux-layout equalize=none golden=none changed=false' "${log}" || true)" -eq 2 ]] || {
    cat "${log}" >&2
    fail "non-mutating layout and absolute resize were not explicit"
}
grep -Fxq 'zentty-linux: tmux-layout equalize=none golden=pane-1 changed=false' "${log}" || {
    cat "${log}" >&2
    fail "percentage resize did not preserve the real golden leader column"
}
grep -Fq 'zentty-linux: geometry=worklane-1:column-worklane-1[pane-1],column-pane-2[pane-2,pane-3]' "${log}" || {
    cat "${log}" >&2
    fail "team topology was not one right column with stacked teammates"
}
layout="$(grep -E 'zentty-linux: pane-layout .*columns=column-worklane-1:[0-9]+,column-pane-2:[0-9]+' "${log}" | tail -1)"
if [[ ! "${layout}" =~ column-worklane-1:([0-9]+),column-pane-2:([0-9]+) ]]; then
    cat "${log}" >&2
    fail "team column widths were not observable"
fi
leader_width="${BASH_REMATCH[1]}"
team_width="${BASH_REMATCH[2]}"
leader_percent=$((100 * leader_width / (leader_width + team_width)))
((leader_percent >= 61 && leader_percent <= 62)) || {
    cat "${log}" >&2
    fail "leader column is not golden-wide: ${leader_percent}%"
}
heights="$(grep -E 'zentty-linux: pane-height-layout column=column-pane-2 .*panes=pane-2:[0-9]+,pane-3:[0-9]+' "${log}" | tail -1)"
if [[ ! "${heights}" =~ pane-2:([0-9]+),pane-3:([0-9]+) ]]; then
    cat "${log}" >&2
    fail "stacked teammate heights were not observable"
fi
height_difference=$((BASH_REMATCH[1] - BASH_REMATCH[2]))
((height_difference >= -1 && height_difference <= 1)) || {
    cat "${log}" >&2
    fail "stacked teammate heights are not equal"
}
if grep -Eq 'zentty-linux: focus-pane pane=pane-[23]$' "${log}"; then
    cat "${log}" >&2
    fail "team split stole terminal focus from the leader"
fi
grep -Fxq 'zentty-linux: title=zentty-tmux-compat-real' "${log}" || {
    cat "${log}" >&2
    fail "send-keys text did not cross the Ghostty surface and PTY"
}
for teammate in pane-2 pane-3; do
    grep -Fxq "zentty-linux: title=zentty-tmux-team-${teammate}" "${log}" || {
        cat "${log}" >&2
        fail "${teammate} did not receive real terminal input"
    }
done
final_layout="$(grep -E 'zentty-linux: pane-layout viewport=[0-9]+ .*columns=column-worklane-1:[0-9]+$' "${log}" | tail -1)"
if [[ ! "${final_layout}" =~ viewport=([0-9]+).*column-worklane-1:([0-9]+)$ ]]; then
    cat "${log}" >&2
    fail "dissolved-team leader width was not observable"
fi
final_viewport_width="${BASH_REMATCH[1]}"
final_leader_width="${BASH_REMATCH[2]}"
[[ "${final_leader_width}" -eq "${final_viewport_width}" ]] || {
    cat "${log}" >&2
    fail "team dissolution did not restore the current viewport width: ${final_viewport_width} -> ${final_leader_width}"
}
mapfile -t final_tmux_panes < <(sed -n 's/^final-tmux-pane=//p' "${fixture_root}/child-probe.log")
[[ "${#final_tmux_panes[@]}" -eq 2 ]] ||
    fail "final tmux teardown pane identities were not recorded exactly"
for pane in pane-1 pane-2 pane-3 "${final_tmux_panes[@]}"; do
    grep -Fxq "zentty-linux: tmux-close pane=${pane}" "${log}" || {
        cat "${log}" >&2
        fail "${pane} did not cross real tmux-owned terminal teardown"
    }
done

printf 'Rust tmux compatibility product journey passed: %s\n' "${backend}"
