#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
# shellcheck source=linux/tests/lib/working-tree-fixture
source "${repo_root}/linux/tests/lib/working-tree-fixture"
temporary="$(mktemp -d)"
trap 'rm -rf -- "${temporary}"' EXIT

# shellcheck disable=SC1091
source "${repo_root}/build/linux-ci-tools/environment.sh"

source_fixture="${temporary}/source"
zentty_create_working_tree_fixture \
    "${repo_root}" "${source_fixture}" 'package builder test source fixture'
mkdir -p "${source_fixture}/build/linux-deps/zig-global-cache/p"

# The contract intentionally matches the literal variable expansion retained
# in build-deb rather than expanding the test process's work_root.
# shellcheck disable=SC2016
grep -Fq '"ZENTTY_ZIG_LOCAL_CACHE_DIR=${package_zig_cache_root}/zig-local-cache"' \
    "${source_fixture}/linux/scripts/build-deb" || {
        echo "debian-package-builder-contract-test: package-owned Zig cache contract missing" >&2
        exit 1
    }
grep -Fq '"ZENTTY_ZIG_GLOBAL_CACHE_DIR=${package_zig_cache_root}/zig-global-cache"' \
    "${source_fixture}/linux/scripts/build-deb" || {
        echo "debian-package-builder-contract-test: package-owned Zig global cache contract missing" >&2
        exit 1
    }
grep -Fq 'ZENTTY_ZIG_GLOBAL_CACHE_DIR="${repo_root}/build/linux-deps/zig-global-cache"' \
    "${source_fixture}/linux/tests/debian-package-lifecycle-build" || {
        echo "debian-package-builder-contract-test: lifecycle builder does not forward the prepared Zig package store" >&2
        exit 1
    }
grep -Fq 'cargo fetch --locked' "${source_fixture}/linux/scripts/build-deb" || {
    echo "debian-package-builder-contract-test: locked Cargo fetch missing" >&2
    exit 1
}
grep -Fq 'release-version" "${ZENTTY_RELEASE_TAG}"' \
    "${source_fixture}/linux/scripts/build-deb" || {
    echo "debian-package-builder-contract-test: release tag validation missing" >&2
    exit 1
}

# Both package builders must compile Ghostty at the same absolute source
# identity. Otherwise Zig may make a different deterministic register-allocation
# choice even though debug paths and input bytes are identical.
if ! grep -Fq -- '--bind "${isolated_ghostty}" "${repo_root}/build/linux-deps/ghostty"' \
        "${source_fixture}/linux/tests/debian-package-clean-checkout" ||
    ! grep -Fq 'GHOSTTY_SOURCE_DIR="${repo_root}/build/linux-deps/ghostty"' \
        "${source_fixture}/linux/tests/debian-package-clean-checkout"; then
    echo "debian-package-builder-contract-test: canonical Ghostty source identity missing" >&2
    exit 1
fi

expect_failure() {
    local name="$1" expected="$2"
    shift 2
    if "$@" >"${temporary}/${name}.log" 2>&1; then
        echo "debian-package-builder-contract-test: ${name} unexpectedly passed" >&2
        exit 1
    fi
    grep -Fq "${expected}" "${temporary}/${name}.log" || {
        cat "${temporary}/${name}.log" >&2
        echo "debian-package-builder-contract-test: ${name} lacked expected failure" >&2
        exit 1
    }
}

git clone --quiet --no-local --no-hardlinks "${source_fixture}" "${temporary}/dirty"
printf '\ndirty package build\n' >>"${temporary}/dirty/README.md"
expect_failure dirty-checkout "Zentty checkout must be clean" \
    env ZENTTY_PACKAGE_OUTPUT_DIR="${temporary}/dirty-output" \
    "${temporary}/dirty/linux/scripts/build-deb"

git clone --quiet --no-local --no-hardlinks "${source_fixture}" "${temporary}/missing-resource"
git -C "${temporary}/missing-resource" rm --quiet assets/icon.png
git -C "${temporary}/missing-resource" \
    -c user.name='Zentty Test' -c user.email='test@invalid' \
    commit --quiet -m 'remove required package resource'
expect_failure missing-resource "manifest source file is missing: assets/icon.png" \
    env ZENTTY_PACKAGE_OUTPUT_DIR="${temporary}/missing-output" \
    "${temporary}/missing-resource/linux/scripts/build-deb"

mkdir -p -- "${temporary}/wrong-ghostty"
git -C "${temporary}/wrong-ghostty" init --quiet
printf 'not Ghostty\n' >"${temporary}/wrong-ghostty/README"
git -C "${temporary}/wrong-ghostty" add README
git -C "${temporary}/wrong-ghostty" \
    -c user.name='Zentty Test' -c user.email='test@invalid' \
    commit --quiet -m 'wrong source'
expect_failure wrong-ghostty "expected $(sed -n 's/^revision=//p' "${source_fixture}/linux/ghostty.lock")" \
    env GHOSTTY_SOURCE_DIR="${temporary}/wrong-ghostty" \
    ZENTTY_PACKAGE_OUTPUT_DIR="${temporary}/wrong-output" \
    ZENTTY_PACKAGE_WORK_DIR="${temporary}/wrong-work" \
    "${source_fixture}/linux/scripts/build-deb"

expect_failure prepared-wrong-ghostty "prepared Ghostty checkout does not match the pinned revision" \
    env GHOSTTY_SOURCE_DIR="${temporary}/wrong-ghostty" \
    ZENTTY_GHOSTTY_PREPARED=true \
    ZENTTY_PACKAGE_OUTPUT_DIR="${temporary}/prepared-wrong-output" \
    ZENTTY_PACKAGE_WORK_DIR="${temporary}/prepared-wrong-work" \
    "${source_fixture}/linux/scripts/build-deb"

echo "debian-package-builder-contract-test: PASS negatives=dirty+missing-resource+wrong-ghostty+prepared-wrong-ghostty"
