#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
runner="${repo_root}/linux/tests/ghostty-async-backend-abi"
source_checkout="${GHOSTTY_SOURCE_DIR:-${repo_root}/build/linux-deps/ghostty}"
expected_revision="$(sed -n 's/^revision=//p' "${repo_root}/linux/ghostty.lock")"
temp_dir="$(mktemp -d)"
trap 'rm -rf "${temp_dir}"' EXIT

git -C "${source_checkout}" rev-parse --is-inside-work-tree >/dev/null 2>&1 || {
    echo "ghostty-async-backend-abi-test: source checkout missing" >&2
    exit 1
}
git clone --quiet --no-hardlinks "${source_checkout}" "${temp_dir}/ghostty"
git -C "${temp_dir}/ghostty" checkout --quiet --detach "${expected_revision}"
mkdir -p "${temp_dir}/ghostty/zig-out/include/ghostty"
cp "${temp_dir}/ghostty/include/ghostty/gtk.h" \
    "${temp_dir}/ghostty/zig-out/include/ghostty/gtk.h"

set +e
GHOSTTY_SOURCE_DIR="${temp_dir}/ghostty" "${runner}" >"${temp_dir}/current.log" 2>&1
current_status=$?
set -e
[[ "${current_status}" -eq 99 ]] || {
    echo "ghostty-async-backend-abi-test: current tracked defect did not exit 99" >&2
    cat "${temp_dir}/current.log" >&2
    exit 1
}

printf '\n/* stale installed-header fixture */\n' \
    >>"${temp_dir}/ghostty/zig-out/include/ghostty/gtk.h"

set +e
GHOSTTY_SOURCE_DIR="${temp_dir}/ghostty" "${runner}" >"${temp_dir}/stale.log" 2>&1
stale_status=$?
set -e
[[ "${stale_status}" -eq 77 ]] &&
    grep -F "generated installed header differs from the pinned source header" \
        "${temp_dir}/stale.log" >/dev/null || {
    echo "ghostty-async-backend-abi-test: stale installed header was accepted" >&2
    cat "${temp_dir}/stale.log" >&2
    exit 1
}

echo "Ghostty async-backend ABI probe self-tests passed"
