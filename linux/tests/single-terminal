#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
binary="${ZENTTY_LINUX_BINARY:-${repo_root}/build/linux/bin/zentty-linux}"
backend="${GDK_BACKEND:-wayland}"
receipt_name="${ZENTTY_TEST_RECEIPT_NAME:-single-terminal-${backend}}"
receipt="${repo_root}/build/linux/${receipt_name}.log"

if [[ ! -x "${binary}" ]]; then
    echo "error: ${binary} does not exist; run linux/scripts/build-local" >&2
    exit 1
fi

GDK_BACKEND="${backend}" \
ZENTTY_LINUX_INTEGRATION_TEST=1 \
timeout 20s "${binary}" >"${receipt}" 2>&1

grep -F "zentty-linux: terminal initialized" "${receipt}" >/dev/null
grep -F "zentty-linux: terminal output acknowledged" "${receipt}" >/dev/null
grep -F "zentty-linux: terminal child exited" "${receipt}" >/dev/null
grep -F "zentty-linux: integration PASS" "${receipt}" >/dev/null

echo "Zentty Linux single-terminal integration passed (${backend})"
