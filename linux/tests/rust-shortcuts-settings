#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
product="${ZENTTY_LINUX_BINARY:-${repo_root}/build/linux/bin/zentty-linux}"
bundle_root="$(cd "$(dirname "${product}")/.." 2>/dev/null && pwd)" || bundle_root=""
bundle_lib="${bundle_root}/lib"
run_root="$(mktemp -d)"
state_directory="${run_root}/state"
ready="${run_root}/terminal.ready"
bytes="${run_root}/terminal.bytes"
log="${run_root}/product.log"
product_pid=""
backend="${GDK_BACKEND:-}"

# shellcheck disable=SC1091
source "${repo_root}/linux/tests/lib/product-input"

fail() {
    [[ ! -f "${log}" ]] || cat "${log}" >&2
    echo "rust-shortcuts-settings: error: $*" >&2
    exit 1
}

cleanup_product() {
    if [[ "${product_pid}" =~ ^[1-9][0-9]*$ ]]; then
        kill -TERM "${product_pid}" 2>/dev/null || true
        wait "${product_pid}" 2>/dev/null || true
        product_pid=""
    fi
}

cleanup() {
    cleanup_product
    rm -rf -- "${run_root}"
}
trap cleanup EXIT

case "${backend}" in
    x11)
        [[ "${ZENTTY_NESTED_X11_SESSION_ID:-}" =~ ^[0-9a-f]{64}$ ]] ||
            fail "X11 scenario must run through linux/tests/nested-x11"
        command -v xdotool >/dev/null || fail "xdotool is required"
        ;;
    wayland)
        [[ "${ZENTTY_NESTED_WAYLAND_INPUT_SESSION_ID:-}" =~ ^[0-9a-f]{64}$ ]] ||
            fail "Wayland scenario must run through linux/tests/nested-wayland-input"
        command -v wtype >/dev/null || fail "wtype is required"
        ;;
    *) fail "GDK_BACKEND must be x11 or wayland" ;;
esac
for dependency in awk cmp grep mktemp od readelf sed sleep stat stty tr; do
    command -v "${dependency}" >/dev/null || fail "${dependency} is required"
done
[[ -x "${product}" ]] || fail "staged product is missing: ${product}"
[[ -f "${bundle_lib}/libghostty-gtk-embed.so" ]] ||
    fail "selected product bundle has no Ghostty library"
[[ -f "${bundle_lib}/libgtk4-layer-shell.so" ]] ||
    fail "selected product bundle has no GTK layer-shell library"

layer_runpath="$(
    readelf -d "${bundle_lib}/libghostty-gtk-embed.so" |
        sed -n 's/.*Library runpath: \[\([^]]*\)\].*/\1/p' |
        cut -d: -f1
)"
[[ "${layer_runpath}" == .zig-cache/* ]] || fail "Ghostty runpath is not pinned"
mkdir -p "${state_directory}"
ghostty_config="${XDG_CONFIG_HOME}/ghostty/config"
mkdir -p "$(dirname "${ghostty_config}")"
printf 'font-size = 10\n' >"${ghostty_config}"
user_theme="${XDG_CONFIG_HOME}/ghostty/themes/TokyoNight Moon"
config="${XDG_CONFIG_HOME}/zentty/config.toml"
mkdir -p "$(dirname "${user_theme}")"
cat >"${user_theme}" <<'EOF'
background = #010203
foreground = #fefefe
palette = 0=#010203
palette = 7=#fefefe
EOF

start_product() {
    local command="$1"
    : >"${log}"
    GDK_SCALE=1 \
    GDK_DPI_SCALE=1 \
    LD_LIBRARY_PATH="${bundle_lib}${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}" \
        "${product}" \
        --command "${command}" \
        --state-directory "${state_directory}" \
        --no-session-restore >"${log}" 2>&1 &
    product_pid=$!
    zentty_product_prepare_input "${backend}" "${log}" || fail "physical product input was unavailable"
}

main_key() {
    local chord="$1"
    case "${chord}" in
        ctrl+alt+*)
            if zentty_product_uses_xdotool "${backend}"; then
                zentty_product_xdotool_key "${chord}"
            else
                wtype -M ctrl -M alt -k "${chord#ctrl+alt+}" -m alt -m ctrl
            fi
            ;;
        ctrl+shift+*) zentty_product_ctrl_shift_key "${backend}" "${chord#ctrl+shift+}" ;;
        ctrl+*) zentty_product_ctrl_key "${backend}" "${chord#ctrl+}" ;;
        *) zentty_product_key "${backend}" "${chord}" ;;
    esac
}

main_type() {
    if [[ "${backend}" == x11 ]]; then
        xdotool type --delay 5 -- "$1"
    else
        # The nested compositor shares CPU with real Ghostty builds and product
        # journeys during the full matrix. Preserve every physical key event
        # under that load rather than accepting a partial query as readiness.
        wtype -d 150 -- "$1"
    fi
}

open_command_palette() {
    local attempt shown_count empty_count hidden_count focus_count query_count query_ready
    for attempt in {1..3}; do
        shown_count="$(grep -Fc 'zentty-linux: command-palette=shown' "${log}" 2>/dev/null || true)"
        main_key ctrl+shift+p
        if ! zentty_product_wait_for_log_count "${log}" \
            'zentty-linux: command-palette=shown' "$((shown_count + 1))" \
            "command palette did not become ready for physical input"; then
            # A chord can arrive while focus is still returning from the
            # preceding overlay. The bounded outer attempt is the recovery;
            # one lost opening chord must not abort before it can run.
            continue
        fi

        # A completed two-key query is an observable focus/readiness barrier.
        # A compositor may deliver the first event while an immediately prior
        # sidebar or config projection is still reallocating the window, then
        # move focus before the second event. Close and reopen in that case;
        # never treat a partial synthetic input sequence as readiness.
        query_count="$(grep -Fc 'zentty-linux: command-palette=query value="zz"' "${log}" 2>/dev/null || true)"
        main_type zz
        query_ready=false
        for _ in {1..40}; do
            if (( $(grep -Fc 'zentty-linux: command-palette=query value="zz"' "${log}" 2>/dev/null || true) > query_count )); then
                query_ready=true
                break
            fi
            sleep 0.05
        done
        if "${query_ready}"; then
            # Close and reopen after the readiness probe rather than racing a
            # Ctrl+A/Backspace pair through the compositor. The public gate
            # proved a stale earlier `zz` receipt could make a later partial
            # `z` query look ready; count every transition from this attempt.
            hidden_count="$(grep -Fc 'zentty-linux: command-palette=hidden' "${log}" 2>/dev/null || true)"
            focus_count="$(grep -Fc 'zentty-linux: focus-pane pane=' "${log}" 2>/dev/null || true)"
            main_key Escape
            zentty_product_wait_for_log_count "${log}" \
                'zentty-linux: command-palette=hidden' "$((hidden_count + 1))" \
                "command palette readiness probe did not close" ||
                fail "command palette readiness reset failed"
            zentty_product_wait_for_log_count "${log}" \
                'zentty-linux: focus-pane pane=' "$((focus_count + 1))" \
                "terminal focus did not return after the readiness probe" ||
                fail "command palette focus reset failed"

            shown_count="$(grep -Fc 'zentty-linux: command-palette=shown' "${log}" 2>/dev/null || true)"
            empty_count="$(grep -Fc 'zentty-linux: command-palette=query value=""' "${log}" 2>/dev/null || true)"
            main_key ctrl+shift+p
            zentty_product_wait_for_log_count "${log}" \
                'zentty-linux: command-palette=shown' "$((shown_count + 1))" \
                "command palette did not reopen after its readiness probe" ||
                fail "command palette readiness reset failed"
            zentty_product_wait_for_log_count "${log}" \
                'zentty-linux: command-palette=query value=""' "$((empty_count + 1))" \
                "command palette did not reopen with an empty query" ||
                fail "command palette readiness reset failed"
            return 0
        fi
        hidden_count="$(grep -Fc 'zentty-linux: command-palette=hidden' "${log}" 2>/dev/null || true)"
        focus_count="$(grep -Fc 'zentty-linux: focus-pane pane=' "${log}" 2>/dev/null || true)"
        main_key Escape
        zentty_product_wait_for_log_count "${log}" \
            'zentty-linux: command-palette=hidden' "$((hidden_count + 1))" \
            "partial command palette probe did not close" ||
            fail "command palette readiness reset failed"
        zentty_product_wait_for_log_count "${log}" \
            'zentty-linux: focus-pane pane=' "$((focus_count + 1))" \
            "terminal focus did not return after a partial readiness probe" ||
            fail "command palette focus reset failed"
    done
    fail "command palette never retained two consecutive physical key events"
}

settings_window=""
prepare_settings_input() {
    if [[ "${backend}" == x11 ]]; then
        settings_window=""
        for _ in {1..200}; do
            settings_window="$(xdotool search --onlyvisible --name '^Zentty Settings$' 2>/dev/null | tail -1 || true)"
            [[ "${settings_window}" =~ ^[1-9][0-9]*$ ]] && break
            sleep 0.05
        done
        [[ "${settings_window}" =~ ^[1-9][0-9]*$ ]] || fail "shortcut settings window did not appear"
        xdotool windowfocus --sync "${settings_window}"
    elif [[ "${ZENTTY_NESTED_WAYLAND_OUTER_X11_INPUT:-}" == 1 ]]; then
        xdotool mousemove --sync --window "${ZENTTY_PRODUCT_WINDOW_ID}" 180 34
        xdotool click 1
    fi
}

settings_key() {
    local chord="$1"
    if [[ "${backend}" == x11 ]]; then
        xdotool windowfocus --sync "${settings_window}"
        xdotool key "${chord}"
    else
        case "${chord}" in
            ctrl+alt+*) wtype -M ctrl -M alt -k "${chord#ctrl+alt+}" -m alt -m ctrl ;;
            ctrl+*) wtype -M ctrl -k "${chord#ctrl+}" -m ctrl ;;
            shift+*) wtype -M shift -k "${chord#shift+}" -m shift ;;
            alt+*) wtype -M alt -k "${chord#alt+}" -m alt ;;
            *) wtype -k "${chord}" ;;
        esac
    fi
}

settings_type() {
    if [[ "${backend}" == x11 ]]; then
        xdotool windowfocus --sync "${settings_window}"
        xdotool type --delay 5 -- "$1"
    else
        wtype -d 5 -- "$1"
    fi
}

settings_tab_until_focus_marker() {
    local marker="$1"
    local attempts="$2"
    local attempt marker_before focus_before
    for ((attempt = 0; attempt < attempts; attempt++)); do
        marker_before="$(grep -Fc "${marker}" "${log}" 2>/dev/null || true)"
        focus_before="$(grep -Fc 'zentty-linux: settings-focus widget=' "${log}" 2>/dev/null || true)"
        settings_key Tab
        zentty_product_wait_for_log_count "${log}" \
            'zentty-linux: settings-focus widget=' "$((focus_before + 1))" \
            "settings focus did not acknowledge one physical Tab" || return 1
        if (( $(grep -Fc "${marker}" "${log}" 2>/dev/null || true) > marker_before )); then
            return 0
        fi
    done
    return 1
}

# The real child PTY enters raw mode so delivery of the old Ctrl+S binding is
# observable as byte 0x13. A bound app shortcut must not satisfy this read.
start_product "printf ready >'${ready}'; stty raw -echo -ixon; dd bs=1 count=1 2>/dev/null | od -An -tx1 | tr -d ' \n' >'${bytes}'; sleep 30"
for _ in {1..200}; do [[ -s "${ready}" ]] && break; sleep 0.05; done
[[ -s "${ready}" ]] || fail "real child PTY did not enter raw input mode"

if [[ "${backend}" == wayland ]]; then
    # Cage returns focus to the originating surface when a transient is opened
    # synchronously by that surface's key event. Activation through the real
    # command palette closes its overlay before presenting the secondary window,
    # matching the already-qualified Task Manager multi-window journey.
    open_command_palette
    main_type 'Settings'
    zentty_product_wait_for_log "${log}" 'command-palette=query value="Settings" results=1' \
        "Settings did not resolve uniquely in the command palette" || fail "settings palette route failed"
    main_key Down
    main_key Return
else
    main_key ctrl+comma
fi
zentty_product_wait_for_log "${log}" 'zentty-linux: shortcut-settings visible commands=' \
    "settings action did not open the real shortcut window" || fail "settings did not open"
prepare_settings_input
zentty_product_wait_for_log "${log}" 'zentty-linux: shortcut-settings active' \
    "settings toplevel did not receive compositor activation" || fail "settings was not activated"
zentty_product_wait_for_log "${log}" 'zentty-linux: settings-section selected=general' \
    "Settings did not open the source default General section" || fail "settings default section failed"
settings_key ctrl+f
settings_tab_until_focus_marker \
    'zentty-linux: general-settings focus=always-clean-copies' 30 ||
    fail "physical keyboard traversal did not reach the General clipboard controls"
settings_key space
zentty_product_wait_for_log "${log}" 'zentty-linux: general-settings action=always-clean-copies value=true' \
    "General did not apply the physical clean-copy toggle" || fail "General clean-copy toggle failed"
for _ in $(seq 1 100); do
    grep -Fq 'always_clean_copies = true' "${config}" 2>/dev/null && break
    sleep 0.05
done
grep -Fq 'always_clean_copies = true' "${config}" ||
    fail "General did not persist the clean-copy toggle"
settings_key space
zentty_product_wait_for_log "${log}" 'zentty-linux: general-settings action=always-clean-copies value=false' \
    "General did not apply the second physical clean-copy toggle" || fail "General clean-copy reset failed"
for _ in $(seq 1 100); do
    grep -Fq 'always_clean_copies = false' "${config}" 2>/dev/null && break
    sleep 0.05
done
grep -Fq 'always_clean_copies = false' "${config}" ||
    fail "General did not persist the clean-copy reset"
settings_key ctrl+f
settings_type crash
zentty_product_wait_for_log "${log}" 'zentty-linux: settings-search query="crash" results=1' \
    "settings search did not find Updates & Privacy by source keyword" || fail "settings search failed"
settings_key ctrl+2
zentty_product_wait_for_log "${log}" 'zentty-linux: settings-section selected=shortcuts' \
    "keyboard navigation did not open Shortcuts" || fail "settings shortcut navigation failed"
zentty_product_wait_for_log "${log}" 'zentty-linux: shortcut-settings keyboard-layout ' \
    "keyboard preview was not allocated at the real default window width" || fail "keyboard layout receipt missing"
grep -F 'zentty-linux: shortcut-settings keyboard-layout ' "${log}" | tail -1 | grep -Fq 'fits=true' ||
    fail "keyboard preview clipped at the real default Settings width"

settings_key ctrl+f
settings_type 'Toggle Sidebar'
settings_key Return
zentty_product_wait_for_log "${log}" 'zentty-linux: shortcut-settings selected=sidebar.toggle' \
    "search did not select Toggle Sidebar" || fail "settings search failed"
settings_key Return
settings_key ctrl+alt+z
zentty_product_wait_for_log "${log}" 'zentty-linux: shortcut-settings saved command=sidebar.toggle value=command+option+z' \
    "physical recorder did not persist the replacement" || fail "shortcut recording failed"
[[ ! -s "${bytes}" ]] || fail "bound application shortcut leaked bytes into the real PTY"

# Bind the source Reload Configuration command through the same physical UI;
# it deliberately has no default shortcut in the source registry.
settings_key ctrl+f
settings_key ctrl+a
settings_type 'Reload Configuration'
settings_key Return
zentty_product_wait_for_log "${log}" 'zentty-linux: shortcut-settings selected=app.reload_config' \
    "search did not select Reload Configuration" || fail "reload command search failed"
settings_key Return
settings_key ctrl+alt+r
zentty_product_wait_for_log "${log}" 'zentty-linux: shortcut-settings saved command=app.reload_config value=command+option+r' \
    "physical recorder did not persist Reload Configuration" || fail "reload binding failed"

focus_count="$(grep -Fc 'zentty-linux: focus-pane pane=pane-1' "${log}" 2>/dev/null || true)"
settings_key Escape
zentty_product_wait_for_log "${log}" 'shortcut-settings hidden parent-presented=true' \
    "closing settings did not present its parent window" || fail "main focus restoration failed"
zentty_product_prepare_input "${backend}" "${log}" || fail "main window could not regain focus"
zentty_product_wait_for_log_count "${log}" 'zentty-linux: focus-pane pane=pane-1' "$((focus_count + 1))" \
    "terminal surface did not regain focus after settings" || fail "terminal focus restoration failed"
main_key ctrl+alt+z
zentty_product_wait_for_log "${log}" 'zentty-linux: shortcut=command+option+z action=toggle-sidebar' \
    "new shortcut did not activate the existing action router" || fail "runtime binding failed"
[[ ! -s "${bytes}" ]] || fail "bound runtime shortcut leaked into the terminal"

# Add a second real Ghostty surface before reload. The runtime operation is
# process-global, so the journey must prove propagation beyond the focused pane.
main_key ctrl+d
zentty_product_wait_for_log "${log}" 'zentty-linux: pane-display id=pane-2' \
    "second live pane did not appear" || fail "multi-surface reload setup failed"

# Pane display projection precedes completion of native surface insertion. Use a
# real no-change runtime reload as the readiness barrier instead of sleeping or
# racing the later metric assertion.
main_key ctrl+alt+r
zentty_product_wait_for_log_count "${log}" \
    'zentty-linux: reload-config-metric stage=after pane=pane-2' 1 \
    "second native surface was not ready for runtime reload" || fail "multi-surface readiness failed"

# Change the real Ghostty config and reload the one process-global runtime.
# Cell metrics come from the native surface both before and after; the same
# foreground PIDs prove that applying appearance did not recreate either PTY.
printf 'font-size = 24\n' >"${ghostty_config}"
main_key ctrl+alt+r
zentty_product_wait_for_log_count "${log}" 'zentty-linux: action=reload-config result=applied' 2 \
    "Reload Configuration did not reach the Ghostty runtime" || fail "runtime reload failed"
for pane_id in pane-1 pane-2; do
    zentty_product_wait_for_log_count "${log}" \
        "zentty-linux: reload-config-metric stage=after pane=${pane_id}" 2 \
        "Ghostty did not publish post-reload metrics for ${pane_id}" || fail "reload metrics missing"
    before_metric="$(grep -F "zentty-linux: reload-config-metric stage=before pane=${pane_id}" "${log}" | tail -1)"
    after_metric="$(grep -F "zentty-linux: reload-config-metric stage=after pane=${pane_id}" "${log}" | tail -1)"
    before_height="$(sed -nE 's/.* cell=[0-9.]+x([0-9.]+) pid=.*/\1/p' <<<"${before_metric}")"
    after_height="$(sed -nE 's/.* cell=[0-9.]+x([0-9.]+) pid=.*/\1/p' <<<"${after_metric}")"
    before_pid="$(sed -nE 's/.* pid=([0-9]+)$/\1/p' <<<"${before_metric}")"
    after_pid="$(sed -nE 's/.* pid=([0-9]+)$/\1/p' <<<"${after_metric}")"
    [[ "${before_pid}" =~ ^[1-9][0-9]*$ && "${after_pid}" == "${before_pid}" ]] ||
        fail "reload replaced or lost the real terminal process for ${pane_id}"
    awk -v before="${before_height}" -v after="${after_height}" 'BEGIN { exit !(after > before) }' ||
        fail "font-size reload did not change ${pane_id} cell metrics (${before_height} -> ${after_height})"
done
[[ ! -s "${bytes}" ]] || fail "bound reload shortcut leaked into the terminal"
main_key ctrl+s
for _ in {1..200}; do [[ -s "${bytes}" ]] && break; sleep 0.05; done
[[ "$(cat "${bytes}" 2>/dev/null || true)" == 13 ]] ||
    fail "displaced shortcut did not reach the real child PTY as byte 0x13"

# Invoke one newly ported source appearance command through the real command
# palette. This crosses command discovery, action routing, both durable config
# files, and the same native live-reload boundary.
open_command_palette
main_type 'Use Light Theme'
zentty_product_wait_for_log "${log}" 'command-palette=query value="Use Light Theme" results=1' \
    "Use Light Theme did not resolve uniquely" || fail "theme command palette route failed"
main_key Down
main_key Return
zentty_product_wait_for_log "${log}" 'zentty-linux: action=theme-mode result=persisted mode=light' \
    "source light-theme command did not persist" || fail "theme mode action failed"
bundled_theme_root="$(readlink -f -- "$(dirname "${product}")/../share/zentty/ghostty/themes")"
grep -Fq "theme = ${bundled_theme_root}/GitHub Light Default" "${ghostty_config}" ||
    fail "theme action did not update the real Ghostty config"

grep -Fq 'command_id = "sidebar.toggle"' "${config}" || fail "binding was not written to XDG config"
grep -Fq 'shortcut = "command+option+z"' "${config}" || fail "stored shortcut is not source-compatible"
grep -Fq 'command_id = "app.reload_config"' "${config}" || fail "reload binding was not persisted"
grep -Fq 'theme_mode = "light"' "${config}" || fail "theme mode was not persisted in Zentty config"

# A fresh product process must load exactly the same binding.
cleanup_product
rm -f -- "${ready}" "${bytes}"
start_product "printf ready >'${ready}'; stty raw -echo -ixon; dd bs=1 count=1 2>/dev/null | od -An -tx1 | tr -d ' \n' >'${bytes}'; sleep 30"
for _ in {1..200}; do [[ -s "${ready}" ]] && break; sleep 0.05; done
zentty_product_wait_for_log "${log}" 'zentty-linux: appearance-startup-projection path=' \
    "persisted appearance was not projected before Ghostty startup" || fail "startup theme projection missing"
grep -Fq "theme = ${bundled_theme_root}/GitHub Light Default" "${ghostty_config}" ||
    fail "restart did not retain the resolvable bundled light-theme path"

# The source dark fallback is a Zentty-owned resource rather than a Ghostty
# built-in. Exercise it after the real restart so this also proves the persisted
# light theme did not prevent a fresh process from selecting and installing it.
open_command_palette
main_type 'Use Dark Theme'
zentty_product_wait_for_log "${log}" 'command-palette=query value="Use Dark Theme" results=1' \
    "Use Dark Theme did not resolve uniquely" || fail "dark-theme palette route failed"
main_key Down
main_key Return
zentty_product_wait_for_log "${log}" 'zentty-linux: action=theme-mode result=persisted mode=dark' \
    "source dark-theme command did not persist" || fail "dark theme mode action failed"
grep -Fq 'theme = GitHub-Dark-Personal' "${ghostty_config}" ||
    fail "dark theme action did not update the real Ghostty config"
installed_theme="${XDG_CONFIG_HOME}/ghostty/themes/GitHub-Dark-Personal"
bundled_theme="$(dirname "${product}")/../share/zentty/ghostty/themes/GitHub-Dark-Personal"
[[ -f "${installed_theme}" ]] || fail "source fallback theme was not installed"
cmp "${bundled_theme}" "${installed_theme}" || fail "installed fallback theme bytes differ"
[[ "$(stat -c '%a' "${installed_theme}")" == 600 ]] || fail "installed fallback theme is not private"
grep -Fq 'theme_mode = "dark"' "${config}" || fail "dark theme mode was not persisted"
zentty_product_wait_for_log_count "${log}" \
    'zentty-linux: reload-config-metric stage=after pane=pane-1' 1 \
    "dark theme reload did not settle before subsequent input" || fail "dark theme reload readiness failed"

# Finally prove the earlier user-recorded binding loaded in this fresh process.
# Running this after the palette avoids allowing its sidebar re-render to race
# focus from the subsequent overlay on fast qualification hosts.
main_key ctrl+alt+z
zentty_product_wait_for_log "${log}" 'zentty-linux: shortcut=command+option+z action=toggle-sidebar' \
    "persisted shortcut was not active after restart" || fail "restart persistence failed"
[[ ! -s "${bytes}" ]] || fail "restarted bound shortcut leaked into the real PTY"

# Finally exercise the new Appearance page through the same real settings shell.
# This runs after the established shortcut and command-palette journeys so a
# native Ghostty reload cannot make Xvfb's direct-to-toplevel synthetic delivery
# look like an application shortcut regression. The feature itself remains real:
# catalog search, persistence, native reload metrics, and the live PTY are all
# observed before the process exits.
open_command_palette
main_type 'Appearance Settings'
zentty_product_wait_for_log "${log}" 'command-palette=query value="Appearance Settings" results=1' \
    "Appearance Settings did not resolve uniquely" || fail "appearance settings palette route failed"
main_key Down
main_key Return
zentty_product_wait_for_log "${log}" 'zentty-linux: shortcut-settings visible commands=' \
    "Appearance did not open the real settings window" || fail "appearance settings did not open"
prepare_settings_input
zentty_product_wait_for_log "${log}" 'zentty-linux: shortcut-settings active' \
    "Appearance settings did not receive compositor activation" || fail "appearance settings was not activated"
zentty_product_wait_for_log "${log}" 'zentty-linux: settings-section selected=appearance' \
    "palette did not deep-link to Appearance" || fail "appearance deep-link failed"
settings_key ctrl+2
zentty_product_wait_for_log "${log}" 'zentty-linux: settings-section selected=shortcuts' \
    "settings did not record a forward navigation" || fail "settings navigation history setup failed"
settings_key ctrl+bracketleft
zentty_product_wait_for_log_count "${log}" 'zentty-linux: settings-section selected=appearance' 2 \
    "settings history did not navigate back" || fail "settings back navigation failed"
settings_key ctrl+bracketright
zentty_product_wait_for_log_count "${log}" 'zentty-linux: settings-section selected=shortcuts' 2 \
    "settings history did not navigate forward" || fail "settings forward navigation failed"
settings_key ctrl+bracketleft
settings_key ctrl+f
settings_type 'TokyoNight Moon'
zentty_product_wait_for_log "${log}" 'zentty-linux: appearance-catalog query="TokyoNight Moon" results=1' \
    "source theme was not searchable in the staged catalog" || fail "theme catalog search failed"
settings_tab_until_focus_marker \
    'zentty-linux: appearance-settings focus=background-opacity' 12 ||
    fail "keyboard traversal did not reach the opacity control"
opacity_apply_before="$(grep -Fc 'zentty-linux: appearance-settings action=background-opacity result=applied' "${log}" 2>/dev/null || true)"
opacity_acknowledged=false
for _ in {1..3}; do
    settings_key Home
    for _ in {1..20}; do
        if (( $(grep -Fc 'zentty-linux: appearance-settings action=background-opacity result=applied' "${log}" 2>/dev/null || true) > opacity_apply_before )); then
            opacity_acknowledged=true
            break 2
        fi
        sleep 0.05
    done
done
"${opacity_acknowledged}" || fail "appearance opacity failed"
grep -Fq 'background-opacity = 0.20' "${ghostty_config}" ||
    fail "opacity control did not update the real Ghostty config"
grep -Fq 'local_background_opacity = 0.2' "${config}" ||
    fail "opacity control did not persist normalized Zentty configuration"
zentty_product_wait_for_log_count "${log}" \
    'zentty-linux: reload-config-metric stage=after pane=pane-1' 2 \
    "opacity reload did not settle" || fail "opacity reload readiness failed"
settings_key ctrl+f
settings_key Return
zentty_product_wait_for_log "${log}" 'zentty-linux: appearance-settings action=theme-selection result=applied' \
    "theme selection did not cross the live appearance boundary" || fail "theme selection failed"
grep -Fq 'zentty-linux: appearance-theme selected="TokyoNight Moon" source=user background=#010203' "${log}" ||
    fail "user theme did not override the identically named bundled theme"
zentty_product_wait_for_log_count "${log}" \
    'zentty-linux: reload-config-metric stage=after pane=pane-1' 3 \
    "appearance selection did not finish native reload" || fail "appearance reload metrics missing"
grep -Fq 'theme = TokyoNight Moon' "${ghostty_config}" ||
    fail "theme selection did not update the real Ghostty config"
grep -Fq 'preferred_dark_theme_name = "TokyoNight Moon"' "${config}" ||
    fail "theme selection did not persist the dark slot"
[[ ! -s "${bytes}" ]] || fail "appearance reload replaced or disturbed the real child PTY"

# Select an ordinary bundled theme, not the one privately installed fallback.
# Embedded Ghostty has no application resource directory, so the generated
# Ghostty config must use the contained staged absolute path rather than a name
# that produces its Configuration Errors dialog.
settings_key ctrl+f
settings_key ctrl+a
settings_type 'Abernathy'
zentty_product_wait_for_log "${log}" 'zentty-linux: appearance-catalog query="Abernathy" results=1' \
    "ordinary bundled theme was not searchable" || fail "bundled theme search failed"
settings_key Return
zentty_product_wait_for_log_count "${log}" \
    'zentty-linux: appearance-settings action=theme-selection result=applied' 2 \
    "ordinary bundled theme did not cross the live appearance boundary" ||
    fail "bundled theme selection failed"
grep -Fq "theme = ${bundled_theme_root}/Abernathy" "${ghostty_config}" ||
    fail "bundled theme was not projected as its staged absolute path"
[[ ! -e "${XDG_CONFIG_HOME}/ghostty/themes/Abernathy" ]] ||
    fail "ordinary bundled selection polluted the user theme directory"
zentty_product_wait_for_log "${log}" \
    'zentty-linux: appearance-theme-projection slot=dark mode=dark active=true preview=Some("Abernathy") palette=16 cursor=true selection=true' \
    "the real theme was not projected with its full terminal palette" ||
    fail "terminal theme preview evidence missing"

# Dark Theme and Light Theme are source-compatible saved slots, not behavior
# switches. Exercise the previously ambiguous inactive Light Theme slot and
# prove both the explicit projection status and that editing it does not alter
# the live Always Dark terminal. Forward traversal is used because GTK's nested
# Wayland reverse traversal skips grouped check buttons in this hierarchy.
settings_key ctrl+f
settings_tab_until_focus_marker \
    'zentty-linux: appearance-settings focus=theme-slot-light' 30 ||
    fail "keyboard traversal did not reach the Light Theme slot card"
settings_key space
zentty_product_wait_for_log "${log}" \
    'zentty-linux: appearance-theme-projection slot=light mode=dark active=false' \
    "inactive Light Theme slot was not distinguished from Always Light mode" ||
    fail "inactive theme-slot projection missing"
settings_key ctrl+f
settings_key ctrl+a
settings_type 'Aizen Light'
zentty_product_wait_for_log "${log}" 'zentty-linux: appearance-catalog query="Aizen Light" results=1' \
    "light theme was not searchable in its source slot" || fail "light slot search failed"
settings_key Return
zentty_product_wait_for_log "${log}" \
    'zentty-linux: appearance-theme-projection slot=light mode=dark active=false preview=Some("Aizen Light") palette=16 cursor=true selection=true' \
    "inactive light theme did not render a complete preview" || fail "light preview evidence missing"
grep -Fq 'preferred_light_theme_name = "Aizen Light"' "${config}" ||
    fail "inactive light theme slot did not persist"
grep -Fq "theme = ${bundled_theme_root}/Abernathy" "${ghostty_config}" ||
    fail "editing the inactive light slot unexpectedly changed the Always Dark terminal"

echo "rust-shortcuts-settings-${backend}: PASS unified-settings theme-catalog terminal-palette-preview explicit-theme-slots bundled-theme-runtime-path real-gtk-settings physical-recorder source-theme-mode real-ghostty-reload preserved-pty bound-action unbound-byte persistence-restart"
