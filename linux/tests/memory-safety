#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
source "${repo_root}/linux/tests/lib/valgrind-report"
ghostty_source="${GHOSTTY_SOURCE_DIR:-${repo_root}/build/linux-deps/ghostty}"
bundle_root="${ZENTTY_MEMORY_BUNDLE_ROOT:-${repo_root}/build/linux}"
[[ "${bundle_root}" == /* ]] || bundle_root="${repo_root}/${bundle_root}"
binary="${bundle_root}/bin/zentty-linux"
api_contract="${bundle_root}/bin/api-contract"
metadata="${bundle_root}/build-metadata"
backend="${GDK_BACKEND:-wayland}"
scenario="${ZENTTY_MEMORY_SCENARIO:-single}"
expected_optimize="${ZENTTY_MEMORY_EXPECT_OPTIMIZE:-Debug}"
if [[ "${backend}" != "wayland" && "${backend}" != "x11" ]]; then
    echo "error: GDK_BACKEND must be wayland or x11" >&2
    exit 1
fi
if [[ "${scenario}" != "single" && "${scenario}" != "interaction" &&
    "${scenario}" != "api" ]]; then
    echo "error: ZENTTY_MEMORY_SCENARIO must be single, interaction, or api" >&2
    exit 1
fi
if [[ "${expected_optimize}" != "Debug" && "${expected_optimize}" != "ReleaseSafe" ]]; then
    echo "error: ZENTTY_MEMORY_EXPECT_OPTIMIZE must be Debug or ReleaseSafe" >&2
    exit 1
fi
receipt_base="${repo_root}/build/linux/memory-safety-${expected_optimize}-${scenario}-${backend}"
raw_receipt="${receipt_base}.raw.log"
suppressed_receipt="${receipt_base}.suppressed.log"
report="${receipt_base}.json"
raw_environment_report="${receipt_base}.raw.environment"
suppressed_environment_report="${receipt_base}.suppressed.environment"
product_diagnostic_log="${receipt_base}.active-product.log"
nested_x11="${repo_root}/linux/tests/nested-x11"
nested_wayland="${repo_root}/linux/tests/nested-wayland"
if [[ "${backend}" == "x11" ]]; then
    phase_wrapper="${nested_x11}"
    phase_harness="linux/tests/nested-x11"
    phase_environment_field="x11_phase_environment"
    display_label="X11"
else
    phase_wrapper="${nested_wayland}"
    phase_harness="linux/tests/nested-wayland"
    phase_environment_field="wayland_phase_environment"
    display_label="Wayland"
fi
evidence_set_lock="$(dirname "${report}")/.zentty-valgrind-evidence.lock"
report_lock="${report}.lock"
max_capture_span_seconds=900
effective_suppressions=(
    "${ghostty_source}/valgrind.supp"
    "${ghostty_source}/src/gtk_embed_spike.valgrind.supp"
)
if [[ "${expected_optimize}" == Debug ]]; then
    effective_suppressions+=("${repo_root}/linux/tests/valgrind.supp")
fi

evidence_set_lock_fd=""
report_lock_fd=""
# Producers hold a shared lease on the evidence set so unrelated scenarios can
# run concurrently. Governance takes the exclusive lease only after all matrix
# producers complete. The report-specific lock still rejects duplicate writers.
zentty_valgrind_acquire_evidence_lock \
    "${evidence_set_lock}" evidence_set_lock_fd shared || exit 1
zentty_valgrind_validate_evidence_lock_descriptor \
    "${evidence_set_lock}" "${evidence_set_lock_fd}" shared || exit 1
zentty_valgrind_acquire_evidence_lock \
    "${report_lock}" report_lock_fd exclusive independent || exit 1
zentty_valgrind_validate_evidence_lock_descriptor \
    "${report_lock}" "${report_lock_fd}" || exit 1

# Any failed invocation must invalidate all prior publishable evidence.
rm -f -- \
    "${raw_receipt}" \
    "${suppressed_receipt}" \
    "${raw_environment_report}" \
    "${suppressed_environment_report}" \
    "${report}"
report_temp=""
# shellcheck disable=SC2317 # invoked by the EXIT trap
cleanup() {
    [[ -z "${report_temp}" ]] || rm -f -- "${report_temp}"
}
trap cleanup EXIT

if ! command -v valgrind >/dev/null || ! command -v jq >/dev/null; then
    echo "error: valgrind and jq are required" >&2
    exit 1
fi
if [[ "${scenario}" != api ]] && ! command -v dbus-run-session >/dev/null; then
    echo "error: dbus-run-session is required for product memory-safety" >&2
    exit 1
fi
if [[ ! -x "${binary}" || ! -x "${api_contract}" ]]; then
    echo "error: Linux test binaries do not exist; run linux/scripts/build-local" >&2
    exit 1
fi
if [[ ! -f "${phase_wrapper}" || -L "${phase_wrapper}" ||
    ! -x "${phase_wrapper}" ]]; then
    echo "error: nested ${display_label} phase harness is missing or unsafe: ${phase_wrapper}" >&2
    exit 1
fi
if [[ ! -f "${metadata}" ]] ||
    ! grep -Fx "optimize=${expected_optimize}" "${metadata}" >/dev/null; then
    echo "error: memory-safety requires optimize=${expected_optimize}" >&2
    exit 1
fi
if [[ "${expected_optimize}" == "Debug" && "${scenario}" != api ]] &&
    ! grep -Fx "product_profile=debug" "${metadata}" >/dev/null; then
    echo "error: memory-safety requires the Debug Rust product" >&2
    exit 1
fi
for suppression in "${effective_suppressions[@]}"; do
    if [[ ! -f "${suppression}" ]]; then
        echo "error: required suppression file not found: ${suppression}" >&2
        exit 1
    fi
done

environment=(
    "GDK_BACKEND=${backend}"
    # Debug Ghostty emits very high-volume diagnostics by default. Under
    # Valgrind, serializing those diagnostics can delay real focus/input far
    # beyond the semantic journey without improving memory evidence.
    "GHOSTTY_LOG=false"
    "ZENTTY_LINUX_ASYNC_BACKEND=epoll"
    "ZENTTY_LINUX_BINARY=${binary}"
    "ZENTTY_EXPECTED_PRODUCT_PROFILE=$([[ "${expected_optimize}" == Debug ]] && printf debug || printf release-safe)"
    # A Debug GTK/Ghostty process under Memcheck can take longer than one
    # minute to map its first real window on cold library/font caches. This is
    # bounded below the enclosing 300-second journey timeout.
    "ZENTTY_RUST_STARTUP_ATTEMPTS=2400"
    # Physical-key translation has dedicated exact-PTY matrix cells. Keep
    # Memcheck focused on the real terminal/window lifecycle rather than
    # multiplying its runtime with an orthogonal XTEST journey.
    "ZENTTY_RUST_X11_PHYSICAL_INPUT=false"
    "ZENTTY_RUST_EMIT_PRODUCT_LOG=1"
    "ZENTTY_RUST_PRODUCT_LOG_PATH=${product_diagnostic_log}"
)
program=("${repo_root}/linux/tests/rust-product-smoke")
case "${scenario}" in
    single)
        environment+=("ZENTTY_RUST_SCENARIO=single" "ZENTTY_RUST_TERMINALS=1")
        ;;
    interaction)
        environment+=("ZENTTY_RUST_SCENARIO=lifecycle" "ZENTTY_RUST_TERMINALS=2")
        ;;
    api)
        environment+=("ZENTTY_API_CONTRACT_ASYNC_BACKEND=epoll")
        program=("${api_contract}")
        ;;
esac

valgrind_flags=(
    -s
    --read-inline-info=no
    --num-callers=40
    --leak-check=full
    "--show-leak-kinds=definite,indirect"
    "--errors-for-leak-kinds=definite,indirect"
)

if [[ "${scenario}" == api ]]; then
    raw_command=(env "${environment[@]}" timeout 300s \
        valgrind "${valgrind_flags[@]}" "${program[@]}")
else
    raw_command=(dbus-run-session -- env "${environment[@]}" \
        timeout 300s "${program[@]}" \
        valgrind "${valgrind_flags[@]}" "${binary}")
fi
set +e
if [[ "${backend}" == "x11" ]]; then
    ZENTTY_NESTED_X11_REPORT="${raw_environment_report}" \
        "${phase_wrapper}" "${raw_command[@]}" >"${raw_receipt}" 2>&1
else
    ZENTTY_NESTED_WAYLAND_REPORT="${raw_environment_report}" \
        "${phase_wrapper}" "${raw_command[@]}" >"${raw_receipt}" 2>&1
fi
raw_status=$?
set -e
if [[ "${raw_status}" -ne 0 ]]; then
    echo "error: unsuppressed Valgrind execution exited ${raw_status}" >&2
    exit "${raw_status}"
fi

suppression_flags=()
for suppression in "${effective_suppressions[@]}"; do
    suppression_flags+=("--suppressions=${suppression}")
done
if [[ "${scenario}" == api ]]; then
    suppressed_command=(env "${environment[@]}" timeout 300s \
        valgrind "${valgrind_flags[@]}" --error-exitcode=99 \
        "${suppression_flags[@]}" "${program[@]}")
else
    suppressed_command=(dbus-run-session -- env "${environment[@]}" \
        timeout 300s "${program[@]}" \
        valgrind "${valgrind_flags[@]}" --error-exitcode=99 \
        "${suppression_flags[@]}" "${binary}")
fi
set +e
if [[ "${backend}" == "x11" ]]; then
    ZENTTY_NESTED_X11_REPORT="${suppressed_environment_report}" \
        "${phase_wrapper}" "${suppressed_command[@]}" >"${suppressed_receipt}" 2>&1
else
    ZENTTY_NESTED_WAYLAND_REPORT="${suppressed_environment_report}" \
        "${phase_wrapper}" "${suppressed_command[@]}" >"${suppressed_receipt}" 2>&1
fi
suppressed_status=$?
set -e
if ! zentty_valgrind_require_publishable_status \
    "${expected_optimize}" "${suppressed_status}" "${report}"; then
    unacceptable_status="${suppressed_status}"
    if (( unacceptable_status == 0 )); then
        unacceptable_status=1
    fi
    exit "${unacceptable_status}"
fi

assert_semantic_pass() {
    local receipt="$1"
    if [[ "${scenario}" == "api" ]]; then
        grep -Fx "api-contract: PASS" "${receipt}" >/dev/null
    else
        grep -F "Rust product smoke passed: ${backend}" "${receipt}" >/dev/null
    fi
}
assert_semantic_pass "${raw_receipt}"
assert_semantic_pass "${suppressed_receipt}"
for receipt in "${raw_receipt}" "${suppressed_receipt}"; do
    if grep -Eq '^(debug|info|warning|error)(\([^)]*\))?: ' "${receipt}"; then
        echo "error: Ghostty embedding diagnostics ignored GHOSTTY_LOG=false: ${receipt}" >&2
        exit 1
    fi
done

raw_metrics="$(zentty_valgrind_metrics_json "${raw_receipt}")"
suppressed_metrics="$(zentty_valgrind_metrics_json "${suppressed_receipt}")"
suppression_usage="$(zentty_valgrind_usage_json \
    "${suppressed_receipt}" \
    "${effective_suppressions[@]}")"
suppression_files='[]'
for suppression in "${effective_suppressions[@]}"; do
    item="$(jq -cn \
        --arg path "${suppression}" \
        --arg sha256 "$(sha256sum "${suppression}" | awk '{print $1}')" \
        '{path: $path, sha256: $sha256}')"
    suppression_files="$(jq -cn \
        --argjson values "${suppression_files}" \
        --argjson item "${item}" \
        '$values + [$item]')"
done

raw_environment_identity="$(zentty_valgrind_receipt_identity_json \
    "${raw_environment_report}")"
suppressed_environment_identity="$(zentty_valgrind_receipt_identity_json \
    "${suppressed_environment_report}")"
raw_session_id="$(jq -r '.session_id' "${raw_environment_report}")"
suppressed_session_id="$(jq -r '.session_id' "${suppressed_environment_report}")"
phase_environment="$(jq -cn \
    --arg harness "${phase_harness}" \
    --arg harness_sha256 "$(sha256sum "${phase_wrapper}" | awk '{print $1}')" \
    --arg raw_report "${raw_environment_report}" \
    --arg raw_session_id "${raw_session_id}" \
    --argjson raw_identity "${raw_environment_identity}" \
    --arg suppressed_report "${suppressed_environment_report}" \
    --arg suppressed_session_id "${suppressed_session_id}" \
    --argjson suppressed_identity "${suppressed_environment_identity}" '
    {
      harness:$harness,
      harness_sha256:$harness_sha256,
      phase_isolation:true,
      raw:{
        report:$raw_report,
        report_identity:$raw_identity,
        session_id:$raw_session_id
      },
      suppressed:{
        report:$suppressed_report,
        report_identity:$suppressed_identity,
        session_id:$suppressed_session_id
      }
    }
')"

raw_receipt_identity="$(zentty_valgrind_receipt_identity_json "${raw_receipt}")"
suppressed_receipt_identity="$(zentty_valgrind_receipt_identity_json "${suppressed_receipt}")"
report_generated_at_epoch="$(date +%s)"
raw_captured_at_epoch="$(jq -r '.captured_at_epoch' <<<"${raw_receipt_identity}")"
suppressed_captured_at_epoch="$(jq -r '.captured_at_epoch' <<<"${suppressed_receipt_identity}")"
if (( raw_captured_at_epoch > suppressed_captured_at_epoch ||
    suppressed_captured_at_epoch > report_generated_at_epoch )); then
    echo "error: Valgrind receipt chronology is invalid" >&2
    exit 1
fi
if (( report_generated_at_epoch - raw_captured_at_epoch > max_capture_span_seconds )); then
    echo "error: Valgrind receipt capture span exceeds ${max_capture_span_seconds}s" >&2
    exit 1
fi

report_temp="$(mktemp "${report}.tmp.XXXXXX")"
jq -n \
    --arg optimize "${expected_optimize}" \
    --arg scenario "${scenario}" \
    --arg backend "${backend}" \
    --arg raw_receipt "${raw_receipt}" \
    --arg suppressed_receipt "${suppressed_receipt}" \
    --arg valgrind_version "$(valgrind --version)" \
    --argjson suppressed_exit_code "${suppressed_status}" \
    --argjson report_generated_at_epoch "${report_generated_at_epoch}" \
    --argjson raw_receipt_identity "${raw_receipt_identity}" \
    --argjson suppressed_receipt_identity "${suppressed_receipt_identity}" \
    --argjson raw "${raw_metrics}" \
    --argjson post "${suppressed_metrics}" \
    --argjson suppression_files "${suppression_files}" \
    --argjson suppression_usage "${suppression_usage}" \
    --arg phase_environment_field "${phase_environment_field}" \
    --argjson phase_environment "${phase_environment}" \
    '{optimize: $optimize, scenario: $scenario, display_backend: $backend, raw_receipt: $raw_receipt, suppressed_receipt: $suppressed_receipt, suppressed_exit_code: $suppressed_exit_code, report_generated_at_epoch: $report_generated_at_epoch, receipt_identities: {raw: $raw_receipt_identity, suppressed: $suppressed_receipt_identity}, valgrind_version: $valgrind_version, valgrind_builtin_suppressions: true, effective_suppression_files: $suppression_files, suppression_usage: $suppression_usage, raw: $raw, post_suppression: $post} + {($phase_environment_field):$phase_environment}' \
    >"${report_temp}"

if ! zentty_valgrind_validate_display_phase_environment \
    "${report_temp}" "${report}" "${phase_wrapper}" "${backend}" \
    "${max_capture_span_seconds}"; then
    echo "error: ${display_label} Valgrind phases did not produce distinct current nested sessions" >&2
    exit 1
fi

if [[ "${expected_optimize}" == "Debug" ]]; then
    jq -e '.post_suppression.errors == 0 and .post_suppression.definite_bytes == 0 and .post_suppression.indirect_bytes == 0' \
        "${report_temp}" >/dev/null
    mv -f -- "${report_temp}" "${report}"
    report_temp=""
    echo "Zentty Linux memory-safety semantic and post-suppression checks PASS; suppression governance pending (${scenario}, ${backend})"
    exit 0
fi

mv -f -- "${report_temp}" "${report}"
report_temp=""
exit "${suppressed_status}"
