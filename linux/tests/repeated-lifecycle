#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
backend="${GDK_BACKEND:-wayland}"
iterations="${ZENTTY_TEST_ITERATIONS:-10}"

if ! [[ "${iterations}" =~ ^[1-9][0-9]*$ ]]; then
    echo "error: ZENTTY_TEST_ITERATIONS must be a positive integer" >&2
    exit 1
fi

for ((iteration = 1; iteration <= iterations; iteration++)); do
    GDK_BACKEND="${backend}" \
    ZENTTY_TEST_RECEIPT_NAME="lifecycle-${backend}-${iteration}" \
        "${repo_root}/linux/tests/single-terminal"
done

echo "Zentty Linux repeated lifecycle passed (${backend}, ${iterations} runs)"
