#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
product="${ZENTTY_LINUX_BINARY:-${repo_root}/build/linux/bin/zentty-linux}"
bundle_root="$(cd "$(dirname "${product}")/.." 2>/dev/null && pwd)" || bundle_root=""
bundle_lib="${bundle_root}/lib"
build_metadata="${bundle_root}/build-metadata"
fixture="${repo_root}/crates/zentty-core/tests/fixtures/session-restore-v3.json"
backend="${GDK_BACKEND:-}"
async_backend="${ZENTTY_LINUX_ASYNC_BACKEND:-default}"
state_dir=""
working_dir=""
cwd_receipt=""
log=""
product_pid=""

# shellcheck disable=SC1091
source "${repo_root}/linux/tests/lib/product-input"

fail() {
    [[ -z "${log}" || ! -f "${log}" ]] || cat "${log}" >&2
    echo "rust-closed-pane-restore: error: $*" >&2
    exit 1
}

cleanup() {
    if [[ "${product_pid}" =~ ^[1-9][0-9]*$ ]]; then
        kill -TERM "${product_pid}" 2>/dev/null || true
        wait "${product_pid}" 2>/dev/null || true
    fi
    [[ -z "${state_dir}" ]] || rm -rf -- "${state_dir}"
    [[ -z "${working_dir}" ]] || rm -rf -- "${working_dir}"
    [[ -z "${log}" ]] || rm -f -- "${log}"
}
trap cleanup EXIT

case "${backend}" in
    x11)
        [[ "${ZENTTY_NESTED_X11_SESSION_ID:-}" =~ ^[0-9a-f]{64}$ ]] ||
            fail "X11 run is not controlled"
        ;;
    wayland)
        [[ "${ZENTTY_NESTED_WAYLAND_INPUT_SESSION_ID:-}" =~ ^[0-9a-f]{64}$ ]] ||
            fail "Wayland run is not input-capable and controlled"
        ;;
    *) fail "GDK_BACKEND must be wayland or x11" ;;
esac
for dependency in jq readelf mktemp grep sed; do
    command -v "${dependency}" >/dev/null || fail "${dependency} is required"
done
[[ -x "${product}" ]] || fail "delivered Rust product is not built: ${product}"
[[ "${async_backend}" == default || "${async_backend}" == epoll ||
    "${async_backend}" == io_uring ]] || fail "invalid async backend"
[[ -f "${bundle_lib}/libghostty-gtk-embed.so" ]] ||
    fail "selected product bundle has no Ghostty library"
[[ -f "${bundle_lib}/libgtk4-layer-shell.so" ]] ||
    fail "selected product bundle has no GTK layer-shell library"
if [[ -n "${ZENTTY_EXPECTED_PRODUCT_PROFILE:-}" ]]; then
    [[ -f "${build_metadata}" ]] || fail "selected product bundle has no build metadata"
    actual_profile="$(sed -n 's/^product_profile=//p' "${build_metadata}")"
    [[ "${actual_profile}" == "${ZENTTY_EXPECTED_PRODUCT_PROFILE}" ]] ||
        fail "selected product profile is ${actual_profile}; expected ${ZENTTY_EXPECTED_PRODUCT_PROFILE}"
fi

layer_runpath="$(
    readelf -d "${bundle_lib}/libghostty-gtk-embed.so" |
        sed -n 's/.*Library runpath: \[\([^]]*\)\].*/\1/p' |
        cut -d: -f1
)"
[[ "${layer_runpath}" == .zig-cache/* ]] || fail "Ghostty layer-shell runpath is missing"

state_dir="$(mktemp -d)"
zentty_product_disable_lifecycle_confirmations
working_dir="$(mktemp -d)"
cwd_receipt="${working_dir}/pty-cwd-receipt"
log="$(mktemp)"
jq --arg cwd "${working_dir}" '
    .workspace.windows[0].worklanes[0].columns[0].panes[].workingDirectory = $cwd |
    .restoreDraftWindows[0].paneDrafts = []
' "${fixture}" >"${state_dir}/restore-snapshot.json"

# The single quotes intentionally defer expansion to each real PTY child.
# shellcheck disable=SC2016
env GHOSTTY_LOG=false \
    ZENTTY_CWD_RECEIPT="${cwd_receipt}" \
    LD_LIBRARY_PATH="${bundle_lib}${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}" \
    "${product}" \
    --state-directory "${state_dir}" \
    --async-backend "${async_backend}" \
    --command 'printf "\033]0;CWD:%s\007" "$PWD"; printf "%s\n" "$PWD" >> "$ZENTTY_CWD_RECEIPT"; sleep 30' >"${log}" 2>&1 &
product_pid=$!

zentty_product_wait_for_log "${log}" 'zentty-linux: terminal-ready-pane=pane-agent' \
    "source pane did not initialize" 400 || fail "source surface missing"
zentty_product_prepare_input "${backend}" "${log}" || fail "physical input was unavailable"
zentty_product_key "${backend}" Shift_L
zentty_product_wait_for_log "${log}" 'zentty-linux: focus-pane pane=pane-agent' \
    "source pane focus did not settle" || fail "source focus missing"
zentty_product_ctrl_shift_key "${backend}" p
zentty_product_wait_for_log "${log}" 'zentty-linux: command-palette=shown' \
    "command palette did not open" || fail "Close Pane palette missing"
zentty_product_type "${backend}" 'Close the focused pane'
zentty_product_wait_for_log "${log}" \
    'zentty-linux: command-palette=query value="Close the focused pane" results=1' \
    "Close Pane was not uniquely discoverable" || fail "Close Pane query failed"
active_visible_before_close="$(grep -Fc 'zentty-linux: sidebar-active-visible worklane=worklane-main' "${log}" || true)"
zentty_product_key "${backend}" Down
zentty_product_key "${backend}" Return
zentty_product_wait_for_log "${log}" 'zentty-linux: action=close-pane pane=pane-agent' \
    "real palette did not close the source pane" || fail "source pane close missing"
zentty_product_wait_for_log "${log}" \
    'zentty-linux: topology=worklane-main[title=Nimbu API,color=blue]:pane-shell*' \
    "surviving pane topology did not project after close" || fail "post-close topology missing"
zentty_product_wait_for_log_count "${log}" \
    'zentty-linux: sidebar-active-visible worklane=worklane-main' \
    "$((active_visible_before_close + 1))" \
    "post-close UI projection did not settle" || fail "post-close projection missing"

zentty_product_ctrl_shift_key "${backend}" p
zentty_product_wait_for_log "${log}" 'zentty-linux: command-palette=shown' \
    "restore command palette did not open" || fail "Undo Close Pane palette missing"
zentty_product_type "${backend}" 'Undo Close Pane'
zentty_product_wait_for_log "${log}" \
    'zentty-linux: command-palette=query value="Undo Close Pane" results=1' \
    "source Undo Close Pane was not uniquely discoverable" || fail "restore query failed"
zentty_product_key "${backend}" Down
zentty_product_key "${backend}" Return
zentty_product_wait_for_log "${log}" 'zentty-linux: action=restore-closed-pane pane=' \
    "real palette did not restore the pane" || fail "restore action missing"
action_line="$(grep -F 'zentty-linux: action=restore-closed-pane pane=' "${log}" | tail -1)"
[[ "${action_line}" == *" cwd=${working_dir} prefill=cargo test" ]] ||
    fail "restore action lost CWD or command prefill: ${action_line}"
restored_pane="$(sed -n 's/.*pane=\([^ ]*\) worklane=.*/\1/p' <<<"${action_line}")"
[[ -n "${restored_pane}" && "${restored_pane}" != pane-agent ]] ||
    fail "restore did not allocate a fresh pane identity"
zentty_product_wait_for_log "${log}" \
    "zentty-linux: pane-prefill pane=${restored_pane} process-started=true bytes=10" \
    "restored pane did not report its PTY prefill" || fail "real prefill receipt missing"
for _ in {1..200}; do
    [[ -f "${cwd_receipt}" ]] &&
        [[ "$(grep -Fxc "${working_dir}" "${cwd_receipt}" || true)" -ge 3 ]] && break
    sleep 0.05
done
if [[ ! -f "${cwd_receipt}" ]] ||
    [[ "$(grep -Fxc "${working_dir}" "${cwd_receipt}" || true)" -lt 3 ]]; then
    fail "restored real PTY did not start in captured CWD"
fi

zentty_product_close_window "${backend}"
for _ in {1..240}; do
    kill -0 "${product_pid}" 2>/dev/null || break
    sleep 0.05
done
kill -0 "${product_pid}" 2>/dev/null && fail "product did not close physically"
set +e
wait "${product_pid}"
status=$?
set -e
product_pid=""
((status == 0)) || fail "product restore run exited ${status}"

late_source_callback="$(
    awk '
        $0 == "zentty-linux: action=close-pane pane=pane-agent" { disposed = 1; next }
        disposed && $0 == "zentty-linux: terminal-ready-pane=pane-agent" { print; exit }
        disposed && index($0, "zentty-linux: title-pane=pane-agent ") == 1 { print; exit }
        disposed && index($0, "zentty-linux: terminal-progress pane=pane-agent ") == 1 { print; exit }
        disposed && $0 == "zentty-linux: child-exited-pane=pane-agent" { print; exit }
    ' "${log}"
)"
[[ -z "${late_source_callback}" ]] ||
    fail "disposed pane delivered a late callback: ${late_source_callback}"

[[ "$(grep -Fc 'started subcommand path=/bin/sh pid=' "${log}" || true)" -eq 3 ]] ||
    fail "expected two original real PTYs plus one restored PTY"
jq -e --arg pane "${restored_pane}" --arg cwd "${working_dir}" '
    .reason == "cleanExit" and
    (.workspace.windows[0].worklanes[0].columns[0].panes[0].id == $pane) and
    (.workspace.windows[0].worklanes[0].columns[0].panes[0].workingDirectory == $cwd) and
    (.workspace.windows[0].worklanes[0].columns[0].panes[0].lastRunCommand == "cargo test")
' "${state_dir}/restore-snapshot.json" >/dev/null ||
    fail "restored identity or launch context was not persisted"

echo "Rust closed-pane restore passed: ${backend}, pane=${restored_pane}, cwd=real, prefill=real, ownership=real, callbacks=quiescent, input=physical"
