product_args=()

# Journey 0b: force destination construction to fail at its real persistent
# tmux-store dependency after the live pane has been detached. The source must
# roll the exact runtime, callbacks, capability route, model, and focus back
# without constructing another terminal or changing the PTY child set.
rm -rf -- "${state_dir}"
state_dir="$(mktemp -d)"
start_product
mapfile -t rollback_children_before_split < <(pgrep -P "${product_pid}" | sort -n)
[[ "${#rollback_children_before_split[@]}" -eq 1 ]] ||
    fail "rollback journey did not begin with exactly one PTY child"
execute_palette_action "Split the focused pane into a visible right column" "Split Right"
zentty_product_wait_for_log "${log}" 'zentty-linux: terminal-ready-pane=pane-2' \
    "rollback journey did not create pane-2's real Ghostty surface" ||
    fail "rollback second pane missing"
rollback_children_before=()
for _ in {1..200}; do
    mapfile -t rollback_children_before < <(pgrep -P "${product_pid}" | sort -n)
    [[ "${#rollback_children_before[@]}" -eq 2 ]] && break
    sleep 0.05
done
[[ "${#rollback_children_before[@]}" -eq 2 ]] ||
    fail "rollback journey did not own exactly two PTY children"
type_and_expect_title "before-failed-window-move" "pane-2"
rollback_focus_before="$(grep -Fc 'zentty-linux: focus-pane pane=pane-2' "${log}" || true)"

tmux_store="${XDG_CONFIG_HOME}/zentty/tmux-compat-store.json"
mkdir -p -- "$(dirname "${tmux_store}")"
tmux_store_backup="${state_dir}/tmux-store-before-transfer-fault"
tmux_store_existed=false
if [[ -f "${tmux_store}" ]]; then
    cp -- "${tmux_store}" "${tmux_store_backup}"
    tmux_store_existed=true
fi
printf '%s\n' '{"version":2}' >"${tmux_store}"
execute_palette_action "Move Pane to New Window" "Move Pane to New Window"
zentty_product_wait_for_log "${log}" \
    'zentty-linux: action=move-pane-to-new-window pane=pane-2 error=unsupported tmux compatibility store version: 2' \
    "real destination-construction failure did not reach the transaction rollback" ||
    fail "destination-construction failure receipt missing"
zentty_product_wait_for_log "${log}" \
    'zentty-linux: topology=worklane-1[title=none,color=none]:pane-1,pane-2*' \
    "failed destination construction did not restore the exact source topology" ||
    fail "source topology rollback missing"
zentty_product_wait_for_log_count "${log}" 'zentty-linux: focus-pane pane=pane-2' \
    "$((rollback_focus_before + 1))" "failed move did not restore pane-2 focus" ||
    fail "source focus rollback missing"
! grep -Fq 'zentty-linux: window-opened id=window-2' "${log}" ||
    fail "failed destination construction exposed a destination window"
[[ "$(grep -Fc 'zentty-linux: terminal-ready-pane=pane-2' "${log}")" -eq 1 ]] ||
    fail "failed destination construction recreated pane-2's Ghostty surface"
mapfile -t rollback_children_after < <(pgrep -P "${product_pid}" | sort -n)
[[ "${rollback_children_after[*]}" == "${rollback_children_before[*]}" ]] ||
    fail "failed destination construction changed the real PTY child set"

# Restore the exact dependency bytes that preceded the external fault, then
# exercise the restored callbacks and authenticated routes through the same
# running child. The fault itself must not become a second persistence policy.
if [[ "${tmux_store_existed}" == true ]]; then
    cp -- "${tmux_store_backup}" "${tmux_store}"
    cmp -s -- "${tmux_store_backup}" "${tmux_store}" ||
        fail "test fault did not restore the exact prior tmux-store bytes"
else
    rm -f -- "${tmux_store}"
fi
type_and_expect_title "after-failed-window-move" "pane-2"
zentty_product_type "${backend}" "agent-running"
zentty_product_key "${backend}" Return
zentty_product_wait_for_log "${log}" \
    'zentty-linux: agent-event pane=pane-2 worklane=worklane-1 kind=agent.running session=moved-live-pane' \
    "failed move did not preserve the source authenticated agent route" ||
    fail "source agent route rollback missing"
zentty_product_type "${backend}" "tmux-route"
zentty_product_key "${backend}" Return
zentty_product_wait_for_log "${log}" \
    'zentty-linux: tmux-command pane=pane-2 worklane=worklane-1 command=DisplayMessage' \
    "failed move did not preserve the source tmux route" ||
    fail "source tmux route rollback missing"
zentty_product_wait_for_log "${log}" 'zentty-linux: title-pane=pane-2 value=tmux:%pane-2' \
    "failed move did not return its tmux reply through the same PTY" ||
    fail "source tmux response after rollback missing"
for _ in {1..240}; do
    [[ -f "${state_dir}/restore-snapshot.json" ]] && jq -e '
        (.workspace.windows | map(.id)) == ["window-1"] and
        [.workspace.windows[0].worklanes[].columns[].panes[].id] == ["pane-1", "pane-2"] and
        .workspace.activeWindowID == "window-1"
    ' "${state_dir}/restore-snapshot.json" >/dev/null 2>&1 && break
    sleep 0.05
done
jq -e '
    (.workspace.windows | map(.id)) == ["window-1"] and
    [.workspace.windows[0].worklanes[].columns[].panes[].id] == ["pane-1", "pane-2"] and
    .workspace.activeWindowID == "window-1"
' "${state_dir}/restore-snapshot.json" >/dev/null ||
    fail "live snapshot published duplicate or missing ownership after rollback"
zentty_product_close_window "${backend}"
wait_for_exit

# Journey 1: create two windows through the real shortcut, prove the active
# second PTY receives input, save both through the one real persistence path,
# and relaunch the exact two-window recipe.
rm -rf -- "${state_dir}"
state_dir="$(mktemp -d)"
start_product
create_second_window
type_and_expect_title "second-window-marker" "pane-window-2"
resize_second_window_x11
for _ in {1..240}; do
    [[ -f "${state_dir}/restore-snapshot.json" ]] &&
        jq -e '
            (.workspace.windows | map(.id)) == ["window-1", "window-2"] and
            .workspace.activeWindowID == "window-2" and
            all(.workspace.windows[]; .frame.width >= 320 and .frame.height >= 240)
        ' "${state_dir}/restore-snapshot.json" >/dev/null 2>&1 && break
    sleep 0.05
done
jq -e '
    (.workspace.windows | map(.id)) == ["window-1", "window-2"] and
    .workspace.activeWindowID == "window-2" and
    all(.workspace.windows[]; .frame.width >= 320 and .frame.height >= 240) and
    (.restoreDraftWindows | length) == 0
' "${state_dir}/restore-snapshot.json" >/dev/null || fail "live snapshot lost multi-window order or active identity"
first_frame_size="$(jq -r '.workspace.windows[0].frame | "\(.width | round)x\(.height | round)"' "${state_dir}/restore-snapshot.json")"
second_frame_size="$(jq -r '.workspace.windows[1].frame | "\(.width | round)x\(.height | round)"' "${state_dir}/restore-snapshot.json")"
