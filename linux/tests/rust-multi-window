product_args=(--no-session-restore)
start_product
zentty_product_wait_for_log "${log}" 'zentty-linux: window-opened id=window-2' \
    "crash relaunch did not restore the transfer destination" || fail "crash transfer restore window missing"
zentty_product_wait_for_log "${log}" 'zentty-linux: terminal-ready-pane=pane-2' \
