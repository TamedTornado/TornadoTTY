jq -e '
    .reason == "liveSnapshot" and
    (.workspace.windows | map(.id)) == ["window-1", "window-2"] and
    .workspace.activeWindowID == "window-2" and
    (.restoreDraftWindows | length) == 0
' "${snapshot}" >/dev/null || fail "crash candidate lost aggregate live state"
jq -e '.cleanExit == false' "${lifecycle}" >/dev/null ||
    fail "running multi-window product was not marked unclean"

crashed_pid="${product_pid}"
