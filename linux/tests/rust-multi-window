# Journey 3: prove the same aggregate live snapshot is authoritative crash
# recovery, not merely normal restore. Explicitly disable normal restoration
# on relaunch: the unclean lifecycle must override that preference once.
rm -rf -- "${state_dir}"
state_dir="$(mktemp -d)"
product_args=()
start_product
create_second_window
type_and_expect_title "crash-second-marker" "pane-window-2"
