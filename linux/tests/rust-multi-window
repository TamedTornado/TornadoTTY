#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
product="${ZENTTY_LINUX_BINARY:-${repo_root}/build/linux/bin/zentty-linux}"
backend="${GDK_BACKEND:-}"
bundle_root="$(cd "$(dirname "${product}")/.." 2>/dev/null && pwd)" || bundle_root=""
bundle_lib="${bundle_root}/lib"
state_dir=""
log=""
product_pid=""
status_notifier_pid=""
window_manager_pid=""
window_manager_log=""
status_notifier_receipt=""
fleet_running_offset=0
route_probe_index=0
product_args=()
config_file=""

# shellcheck source=linux/tests/lib/product-input
source "${repo_root}/linux/tests/lib/product-input"

fail() {
    [[ -z "${log}" || ! -f "${log}" ]] || cat "${log}" >&2
    echo "rust-multi-window: error: $*" >&2
    exit 1
}

cleanup() {
    if [[ "${product_pid}" =~ ^[1-9][0-9]*$ ]]; then
        kill -TERM "${product_pid}" 2>/dev/null || true
        wait "${product_pid}" 2>/dev/null || true
    fi
    if [[ "${status_notifier_pid}" =~ ^[1-9][0-9]*$ ]]; then
        kill -TERM "${status_notifier_pid}" 2>/dev/null || true
        wait "${status_notifier_pid}" 2>/dev/null || true
    fi
    if [[ "${window_manager_pid}" =~ ^[1-9][0-9]*$ ]]; then
        kill -TERM "${window_manager_pid}" 2>/dev/null || true
        wait "${window_manager_pid}" 2>/dev/null || true
    fi
    [[ -z "${state_dir}" ]] || rm -rf -- "${state_dir}"
    [[ -z "${log}" ]] || rm -f -- "${log}"
    [[ -z "${config_file}" ]] || rm -f -- "${config_file}"
    [[ -z "${window_manager_log}" ]] || rm -f -- "${window_manager_log}"
}
trap cleanup EXIT

case "${backend}" in
    x11)
        [[ "${ZENTTY_NESTED_X11_SESSION_ID:-}" =~ ^[0-9a-f]{64}$ ]] ||
            fail "X11 journey must run through linux/tests/nested-x11"
        ;;
    wayland)
        [[ "${ZENTTY_NESTED_WAYLAND_INPUT_SESSION_ID:-}" =~ ^[0-9a-f]{64}$ ]] ||
            fail "Wayland journey must run through linux/tests/nested-wayland-input"
        ;;
    *) fail "GDK_BACKEND must be x11 or wayland" ;;
esac
for dependency in cmp dirname jq mkdir readelf timeout mktemp grep; do
    command -v "${dependency}" >/dev/null || fail "${dependency} is required"
done
if [[ "${backend}" == x11 ]]; then
    command -v xprop >/dev/null || fail "xprop is required for X11 toplevel identity"
    if [[ "${ZENTTY_MULTI_WINDOW_LIFECYCLE_ONLY:-false}" == true ||
        "${ZENTTY_MULTI_WINDOW_WINDOW_STATE_ONLY:-false}" == true ]]; then
        command -v openbox >/dev/null || fail "openbox is required for native X11 lifecycle state"
        window_manager_log="$(mktemp)"
        openbox --sm-disable >"${window_manager_log}" 2>&1 &
        window_manager_pid=$!
        for _ in {1..100}; do
            xprop -root _NET_SUPPORTING_WM_CHECK 2>/dev/null |
                grep -Fq '_NET_SUPPORTING_WM_CHECK(WINDOW)' && break
            sleep 0.05
        done
        xprop -root _NET_SUPPORTING_WM_CHECK 2>/dev/null |
            grep -Fq '_NET_SUPPORTING_WM_CHECK(WINDOW)' || fail "controlled X11 window manager did not start"
    fi
fi
[[ -x "${product}" ]] || fail "staged product is not built: ${product}"
[[ -f "${bundle_lib}/libghostty-gtk-embed.so" ]] ||
    fail "selected product bundle has no Ghostty library"
[[ -f "${bundle_lib}/libgtk4-layer-shell.so" ]] ||
    fail "selected product bundle has no GTK layer-shell library"

layer_runpath="$(
    readelf -d "${bundle_lib}/libghostty-gtk-embed.so" |
        sed -n 's/.*Library runpath: \[\([^]]*\)\].*/\1/p' |
        cut -d: -f1
)"
[[ "${layer_runpath}" == .zig-cache/* ]] || fail "Ghostty layer-shell runpath is missing"

state_dir="$(mktemp -d)"
log="$(mktemp)"
config_file="${XDG_CONFIG_HOME:?}/zentty/config.toml"
mkdir -p "$(dirname "${config_file}")"
cat >"${config_file}" <<'EOF'
[clipboard]
always_clean_copies = true
EOF
# The quoted heredoc defers every expansion to the real PTY child while
# keeping the controlled agent lifecycle readable and independently auditable.
child_command="$(cat <<'EOF'
agent_pid=
while IFS= read -r value; do
    case "$value" in
        agent-waiting)
            printf '%s' '{"version":1,"event":"session.start","agent":{"name":"Claude Code"},"session":{"id":"fleet-waiting"}}' | "$ZENTTY_CLI_BIN" ipc agent-event
            printf '%s' '{"version":1,"event":"agent.needs-input","agent":{"name":"Claude Code"},"session":{"id":"fleet-waiting"},"state":{"text":"Approve cross-window deployment?","interaction":{"kind":"approval","text":"Approve cross-window deployment?"}}}' | "$ZENTTY_CLI_BIN" ipc agent-event
            ;;
        agent-running)
            printf '%s' '{"version":1,"event":"agent.running","agent":{"name":"Codex"},"session":{"id":"moved-live-pane"}}' | "$ZENTTY_CLI_BIN" ipc agent-event
            ;;
        agent-progress)
            printf '%s' '{"version":1,"event":"task.progress","session":{"id":"moved-live-pane"},"progress":{"done":2,"total":5}}' | "$ZENTTY_CLI_BIN" ipc agent-event
            ;;
        agent-complete)
            printf '%s' '{"version":1,"event":"task.progress","session":{"id":"moved-live-pane"},"progress":{"done":5,"total":5}}' | "$ZENTTY_CLI_BIN" ipc agent-event
            ;;
        agent-compacting)
            printf '%s' '{"version":1,"event":"agent.running","agent":{"name":"Codex"},"session":{"id":"moved-live-pane"},"state":{"text":"Compacting"}}' | "$ZENTTY_CLI_BIN" ipc agent-event
            ;;
        agent-stop-candidate)
            printf '%s' '{"version":1,"event":"agent.idle","session":{"id":"moved-live-pane"},"state":{"stopCandidate":true}}' | "$ZENTTY_CLI_BIN" ipc agent-event
            ;;
        agent-track-process)
            sleep 300 &
            agent_pid=$!
            printf '%s\n' "{\"version\":1,\"event\":\"agent.running\",\"agent\":{\"name\":\"Codex\",\"pid\":${agent_pid}},\"session\":{\"id\":\"moved-live-pane\"}}" | "$ZENTTY_CLI_BIN" ipc agent-event
            ;;
        agent-kill-process)
            kill "$agent_pid"
            wait "$agent_pid" 2>/dev/null || true
            agent_pid=
            ;;
        agent-session-end)
            printf '%s' '{"version":1,"event":"session.end","session":{"id":"moved-live-pane"}}' | "$ZENTTY_CLI_BIN" ipc agent-event
            ;;
        agent-waiting-end)
            printf '%s' '{"version":1,"event":"session.end","session":{"id":"fleet-waiting"}}' | "$ZENTTY_CLI_BIN" ipc agent-event
            ;;
        tmux-route)
            route="$(tmux display-message -p '#{pane_id}')" && printf '\033]2;tmux:%s\a' "$route"
            ;;
        tmux-stale-claim)
            route="$(ZENTTY_WINDOW_ID=window-1 ZENTTY_WORKLANE_ID=worklane-1 tmux display-message -p '#{pane_id}')" && printf '\033]2;tmux-stale:%s\a' "$route"
            ;;
        capture-move)
            tmux capture-pane -p | grep -Fq before-live-window-move && printf '\033]2;scrollback-preserved\a'
            ;;
        *) printf '\033]2;%s\a' "$value" ;;
    esac
done
EOF
)"
launch_command="${child_command}"

start_product() {
    : >"${log}"
    CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS=1 \
        LD_LIBRARY_PATH="${bundle_lib}${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}" \
        "${product}" \
        --command "${launch_command}" \
        --state-directory "${state_dir}" \
        --async-backend default \
        "${product_args[@]}" >"${log}" 2>&1 &
    product_pid=$!
    zentty_product_wait_for_log "${log}" 'zentty-linux: window-opened id=window-1' \
        "first real product window did not open" || fail "first window missing"
    zentty_product_wait_for_log "${log}" 'zentty-linux: terminal-ready-pane=pane-1' \
        "first real Ghostty surface did not become ready" || fail "first terminal missing"
    zentty_product_wait_for_log "${log}" \
        'zentty-linux: config-projected window=window-1 automatic-clean-copy=true' \
        "first window did not receive the process clipboard config" || fail "first config projection missing"
    [[ "$(grep -Fc 'zentty-linux: config-loaded ' "${log}" || true)" -eq 1 ]] ||
        fail "one process loaded the config more than once"
    zentty_product_prepare_input "${backend}" "${log}" || fail "could not prepare physical input"
}

wait_for_exit() {
    for _ in {1..240}; do
        kill -0 "${product_pid}" 2>/dev/null || break
        sleep 0.05
    done
    kill -0 "${product_pid}" 2>/dev/null && fail "product did not exit after physical quit"
    set +e
    wait "${product_pid}"
    status=$?
    set -e
    product_pid=""
    [[ "${status}" -eq 0 ]] || fail "product exited ${status}"
}

target_second_window() {
    local pane_id="${1:-pane-window-2}"
    if [[ "${backend}" == x11 ]]; then
        local candidate_id
        local -a titled_ids candidate_ids
        mapfile -t titled_ids < <(
            xdotool search --onlyvisible --pid "${product_pid}" --name '^Zentty$' 2>/dev/null
        )
        candidate_ids=()
        for candidate_id in "${titled_ids[@]}"; do
            # GTK popovers are native X11 windows and inherit the application
            # title and PID. They are visible while the fleet chooser is open,
            # but they are not routable product toplevels. Restrict identity
            # discovery to EWMH normal windows instead of counting transients.
            xprop -id "${candidate_id}" _NET_WM_WINDOW_TYPE 2>/dev/null |
                grep -Fq '_NET_WM_WINDOW_TYPE_NORMAL' && candidate_ids+=("${candidate_id}")
        done
        [[ "${#candidate_ids[@]}" -eq 2 ]] ||
            fail "X11 exposed ${#candidate_ids[@]} normal product windows from ${#titled_ids[@]} visible titled windows, expected two"
        route_probe_index=$((route_probe_index + 1))
        for candidate_id in "${candidate_ids[@]}"; do
            [[ "$(xdotool getwindowpid "${candidate_id}" 2>/dev/null || true)" == "${product_pid}" ]] ||
                fail "X11 candidate window is not owned by the product"
            probe="zentty-window-route-probe-${route_probe_index}-${candidate_id}"
            xdotool windowfocus --sync "${candidate_id}"
            xdotool type --delay 5 "${probe}"
            xdotool key Return
            for _ in {1..40}; do
                if grep -Fq "zentty-linux: title-pane=${pane_id} value=${probe}" "${log}"; then
                    ZENTTY_PRODUCT_WINDOW_ID="${candidate_id}"
                    export ZENTTY_PRODUCT_WINDOW_ID
                    return
                fi
                sleep 0.05
            done
        done
        fail "physical route probes could not identify ${pane_id}'s X11 toplevel"
    elif [[ "${ZENTTY_NESTED_WAYLAND_OUTER_X11_INPUT:-}" == 1 ]]; then
        find_pointer_target "zentty-linux: pane-controls pane=${pane_id} state=shown" any ||
            fail "physical Wayland pointer could not identify ${pane_id}'s toplevel"
        xdotool click 1
    fi
}

execute_palette_action() {
    local query="$1"
    local action="$2"
    local shown_before query_before
    shown_before="$(grep -Fc 'zentty-linux: command-palette=shown' "${log}" || true)"
    query_before="$(grep -Fc "zentty-linux: command-palette=query value=\"${query}\" results=1" "${log}" || true)"
    zentty_product_ctrl_shift_key "${backend}" p
    zentty_product_wait_for_log_count "${log}" 'zentty-linux: command-palette=shown' "$((shown_before + 1))" \
        "command palette did not open for ${action}" || fail "${action} palette missing"
    zentty_product_type "${backend}" "${query}"
    zentty_product_wait_for_log_count "${log}" \
        "zentty-linux: command-palette=query value=\"${query}\" results=1" "$((query_before + 1))" \
        "${action} did not resolve uniquely" || fail "${action} palette query failed"
    zentty_product_key "${backend}" Down
    zentty_product_key "${backend}" Return
}

# Resolve a real GTK sidebar or popover hit target from its pointer-enter
# receipt. This avoids hard-coding theme/font-dependent menu row positions
# while still requiring physical XTest input against the rendered product.
find_pointer_target() {
    local receipt="$1"
    local x="$2"
    local before candidate_x candidate_ys y
    local -a candidate_xs
    if [[ "${backend}" == x11 ]]; then
        # The nested X11 fixture deliberately has no window manager, so EWMH
        # _NET_ACTIVE_WINDOW is unavailable. Raise and focus the owned toplevel
        # directly before root-coordinate pointer delivery.
        xdotool windowraise "${ZENTTY_PRODUCT_WINDOW_ID}"
        xdotool windowfocus --sync "${ZENTTY_PRODUCT_WINDOW_ID}"
    elif [[ "${ZENTTY_NESTED_WAYLAND_OUTER_X11_INPUT:-}" != 1 ]]; then
        fail "Wayland pointer target discovery requires controlled outer-X11 input"
    fi
    before="$(grep -Fxc "${receipt}" "${log}" || true)"
    if [[ "${x}" == any ]]; then
        if [[ "${backend}" == wayland ]]; then
            mapfile -t candidate_xs < <(seq 40 40 1240)
        else
            mapfile -t candidate_xs < <(seq 40 30 490)
        fi
    else
        candidate_xs=("${x}")
    fi
    for candidate_x in "${candidate_xs[@]}"; do
        xdotool mousemove --sync --window "${ZENTTY_PRODUCT_WINDOW_ID}" 600 60
        if [[ "${backend}" == wayland ]]; then
            candidate_ys="$(seq 40 30 1000)"
        else
            candidate_ys="$(seq 70 10 680)"
        fi
        for y in ${candidate_ys}; do
            xdotool mousemove --sync --window "${ZENTTY_PRODUCT_WINDOW_ID}" "${candidate_x}" "${y}"
            sleep 0.03
            if (( $(grep -Fxc "${receipt}" "${log}" || true) > before )); then
                return 0
            fi
        done
    done
    return 1
}

# Divider handles span one complete viewport axis. Search only across the
# narrow axis instead of raster-scanning the whole toplevel. The exact GTK
# enter receipt remains the authority, while the bounded one-dimensional scan
# keeps this real-pointer qualification fast on both nested backends.
find_divider_target() {
    local receipt="$1"
    local axis="$2"
    local before width height anchor candidate limit
    local -a anchors
    if [[ "${backend}" == x11 ]]; then
        xdotool windowraise "${ZENTTY_PRODUCT_WINDOW_ID}"
        xdotool windowfocus --sync "${ZENTTY_PRODUCT_WINDOW_ID}"
    elif [[ "${ZENTTY_NESTED_WAYLAND_OUTER_X11_INPUT:-}" != 1 ]]; then
        fail "Wayland divider discovery requires controlled outer-X11 input"
    fi
    width="$(xdotool getwindowgeometry --shell "${ZENTTY_PRODUCT_WINDOW_ID}" | sed -n 's/^WIDTH=//p')"
    height="$(xdotool getwindowgeometry --shell "${ZENTTY_PRODUCT_WINDOW_ID}" | sed -n 's/^HEIGHT=//p')"
    [[ "${width}" =~ ^[0-9]+$ && "${height}" =~ ^[0-9]+$ ]] ||
        fail "could not inspect the controlled product toplevel geometry"
    before="$(grep -Fxc "${receipt}" "${log}" || true)"
    if [[ "${axis}" == horizontal ]]; then
        anchors=($((height / 3)) $((height * 2 / 3)))
        limit=$((width - 20))
        for anchor in "${anchors[@]}"; do
            xdotool mousemove --sync --window "${ZENTTY_PRODUCT_WINDOW_ID}" 10 "${anchor}"
            for candidate in $(seq 20 3 "${limit}"); do
                xdotool mousemove --sync --window "${ZENTTY_PRODUCT_WINDOW_ID}" "${candidate}" "${anchor}"
                sleep 0.02
                if (( $(grep -Fxc "${receipt}" "${log}" || true) > before )); then
                    return 0
                fi
            done
        done
    else
        anchors=($((width * 2 / 3)) $((width * 3 / 4)))
        limit=$((height - 20))
        for anchor in "${anchors[@]}"; do
            xdotool mousemove --sync --window "${ZENTTY_PRODUCT_WINDOW_ID}" "${anchor}" 50
            for candidate in $(seq 70 3 "${limit}"); do
                xdotool mousemove --sync --window "${ZENTTY_PRODUCT_WINDOW_ID}" "${anchor}" "${candidate}"
                sleep 0.02
                if (( $(grep -Fxc "${receipt}" "${log}" || true) > before )); then
                    return 0
                fi
            done
        done
    fi
    return 1
}

drag_divider_physically() {
    local pointer_receipt="$1"
    local axis="$2"
    local resize_receipt="$3"
    local delta_x="$4"
    local delta_y="$5"
    local description="$6"
    local before
    find_divider_target "${pointer_receipt}" "${axis}" ||
        fail "physical pointer could not locate the ${description} divider"
    before="$(grep -Fc "${resize_receipt}" "${log}" || true)"
    xdotool mousedown 1
    xdotool mousemove_relative --sync -- "${delta_x}" "${delta_y}"
    xdotool mouseup 1
    zentty_product_wait_for_log_count "${log}" "${resize_receipt}" "$((before + 1))" \
        "${description} drag did not reach GTK" || fail "physical ${description} divider drag missing"
}

equalize_divider_physically() {
    local pointer_receipt="$1"
    local axis="$2"
    local equalize_receipt="$3"
    local description="$4"
    local before
    find_divider_target "${pointer_receipt}" "${axis}" ||
        fail "physical pointer could not locate the ${description} divider"
    before="$(grep -Fc "${equalize_receipt}" "${log}" || true)"
    xdotool click --repeat 2 --delay 80 1
    zentty_product_wait_for_log_count "${log}" "${equalize_receipt}" "$((before + 1))" \
        "${description} double-click did not equalize" ||
        fail "physical ${description} divider equalization missing"
}

# Search the bounded neighborhood of the pointer that opened a GTK popover.
# The popup is anchored to that real button even when Weston has placed two
# application toplevels within its single outer X11 window. Staying local to
# the anchor avoids crossing the other toplevel; the exact GTK enter receipt,
# not a coordinate assumption, identifies the rendered row.
find_popover_target() {
    local receipt="$1"
    local before pointer_x pointer_y display_width display_height
    local min_x max_x min_y max_y x y replay_before index
    local -a recent_x=() recent_y=()
    before="$(grep -Fxc "${receipt}" "${log}" || true)"
    pointer_x="$(xdotool getmouselocation --shell | sed -n 's/^X=//p')"
    pointer_y="$(xdotool getmouselocation --shell | sed -n 's/^Y=//p')"
    read -r display_width display_height < <(xdotool getdisplaygeometry)
    [[ "${pointer_x}" =~ ^[0-9]+$ && "${pointer_y}" =~ ^[0-9]+$ ]] || return 1
    min_x=$((pointer_x > 450 ? pointer_x - 450 : 0))
    max_x=$((pointer_x + 450 < display_width ? pointer_x + 450 : display_width - 1))
    min_y=$((pointer_y > 650 ? pointer_y - 650 : 0))
    max_y=$((pointer_y + 650 < display_height ? pointer_y + 650 : display_height - 1))
    for y in $(seq "${min_y}" 12 "${max_y}"); do
        for x in $(seq "${min_x}" 24 "${max_x}"); do
            xdotool mousemove --sync "${x}" "${y}"
            recent_x+=("${x}")
            recent_y+=("${y}")
            if (( ${#recent_x[@]} > 128 )); then
                recent_x=("${recent_x[@]:1}")
                recent_y=("${recent_y[@]:1}")
            fi
            sleep 0.005
            if (( $(grep -Fxc "${receipt}" "${log}" || true) > before )); then
                # The receipt may reach the log after the coarse sweep has
                # advanced past its originating coordinate. Replay only the
                # bounded recent path with a GTK scheduling dwell, require a
                # fresh enter receipt, and return while the pointer is still
                # on that exact rendered row so the following click is real.
                xdotool mousemove --sync "${pointer_x}" "${pointer_y}"
                sleep 0.1
                replay_before="$(grep -Fxc "${receipt}" "${log}" || true)"
                for ((index = ${#recent_x[@]} - 1; index >= 0; index--)); do
                    xdotool mousemove --sync "${recent_x[${index}]}" "${recent_y[${index}]}"
                    # Replay newest-first because the coarse detector normally
                    # observes the asynchronous receipt only a few points after
                    # its origin. The dwell is deliberately longer than one
                    # loaded GTK main-loop turn, keeping the pointer on the row
                    # whose fresh receipt is observed.
                    sleep 0.25
                    if (( $(grep -Fxc "${receipt}" "${log}" || true) > replay_before )); then
                        sleep 0.1
                        return 0
                    fi
                done
                return 1
            fi
        done
    done
    return 1
}

focus_outer_wayland_pane() {
    local pane_id="$1"
    [[ "${ZENTTY_NESTED_WAYLAND_OUTER_X11_INPUT:-}" == 1 ]] || return 0
    find_pointer_target "zentty-linux: pane-controls pane=${pane_id} state=shown" any ||
        fail "physical Wayland pointer could not focus ${pane_id}"
    xdotool click 1
}

create_second_window() {
    local route_probe="${1:-true}"
    zentty_product_ctrl_shift_key "${backend}" n
    zentty_product_wait_for_log "${log}" 'zentty-linux: window-opened id=window-2' \
        "physical New Window did not create the second GTK window" || fail "second window missing"
    zentty_product_wait_for_log "${log}" 'zentty-linux: terminal-ready-pane=pane-window-2' \
        "second window did not own a distinct real Ghostty surface" || fail "second terminal missing"
    zentty_product_wait_for_log "${log}" 'zentty-linux: focus-pane pane=pane-window-2' \
        "second window did not settle real terminal focus" || fail "second terminal focus missing"
    zentty_product_wait_for_log "${log}" \
        'zentty-linux: config-projected window=window-2 automatic-clean-copy=true' \
        "second window did not receive the process clipboard config" || fail "second config projection missing"
    if [[ "${backend}" == x11 ]]; then
        visible_count="$(xdotool search --onlyvisible --pid "${product_pid}" --name '^Zentty$' 2>/dev/null | wc -l)"
        [[ "${visible_count}" -eq 2 ]] || fail "X11 exposed ${visible_count} product windows instead of two"
    fi
    if [[ "${route_probe}" == true ]]; then
        target_second_window
    elif [[ "${backend}" == x11 ]]; then
        if [[ "${window_manager_pid}" =~ ^[1-9][0-9]*$ ]]; then
            ZENTTY_PRODUCT_WINDOW_ID="$(xdotool getactivewindow)"
            [[ "$(xdotool getwindowpid "${ZENTTY_PRODUCT_WINDOW_ID}" 2>/dev/null || true)" == "${product_pid}" ]] ||
                fail "controlled window manager did not activate the new product window"
            export ZENTTY_PRODUCT_WINDOW_ID
            return
        fi
        mapfile -t idle_window_ids < <(
            xdotool search --onlyvisible --pid "${product_pid}" --name '^Zentty$' 2>/dev/null |
                while read -r candidate_id; do
                    xprop -id "${candidate_id}" _NET_WM_WINDOW_TYPE 2>/dev/null |
                        grep -Fq '_NET_WM_WINDOW_TYPE_NORMAL' && printf '%s\n' "${candidate_id}"
                done |
                sort -n
        )
        [[ "${#idle_window_ids[@]}" -eq 2 ]] ||
            fail "could not identify two normal idle X11 windows"
        # Xvfb allocates XIDs monotonically; the newly constructed second
        # toplevel therefore has the larger identity without typing a probe
        # command into either otherwise-idle shell.
        ZENTTY_PRODUCT_WINDOW_ID="${idle_window_ids[1]}"
        export ZENTTY_PRODUCT_WINDOW_ID
    fi
}

type_and_expect_title() {
    local value="$1"
    local pane_id="$2"
    if [[ "${backend}" == x11 ]]; then
        # Use XTest against the explicitly focused product window. Xdotool's
        # per-window synthetic-event mode can restore an earlier focus between
        # the text and Return calls when two mapped windows share one PID.
        xdotool windowfocus --sync "${ZENTTY_PRODUCT_WINDOW_ID}"
        xdotool type --delay 5 "${value}"
        xdotool key Return
    else
        zentty_product_type "${backend}" "${value}"
        zentty_product_key "${backend}" Return
    fi
    zentty_product_wait_for_log "${log}" \
        "zentty-linux: title-pane=${pane_id} value=${value}" \
        "input did not route to ${pane_id}" || fail "cross-window input routing failed"
}

resize_second_window_x11() {
    [[ "${backend}" == x11 ]] || return 0
    xdotool windowsize --sync "${ZENTTY_PRODUCT_WINDOW_ID}" 1110 730
    zentty_product_wait_for_log "${log}" 'zentty-linux: window-size=1110x730' \
        "externally resized second X11 window did not report its actual allocation" ||
        fail "second X11 window resize missing"
}

wait_for_frame_restore_requests() {
    local first_size="$1"
    local second_size="$2"
    zentty_product_wait_for_log "${log}" \
        "zentty-linux: window-frame-restore-request id=window-1 size=${first_size} placement=compositor" \
        "first restored window did not request its persisted size" || fail "first frame request missing"
    zentty_product_wait_for_log "${log}" \
        "zentty-linux: window-frame-restore-request id=window-2 size=${second_size} placement=compositor" \
        "second restored window did not request its persisted size" || fail "second frame request missing"
}

close_active_window() {
    if [[ "${backend}" == x11 ]]; then
        if [[ "${window_manager_pid}" =~ ^[1-9][0-9]*$ ]]; then
            xdotool windowactivate --sync "${ZENTTY_PRODUCT_WINDOW_ID}"
            xdotool key ctrl+shift+w
            return
        fi
        # The target is destroyed on key-down, before XTest can deliver every
        # synthetic release to that XID. Product logs and survivor input prove
        # the close; reset global key state against the live root window.
        xdotool key --window "${ZENTTY_PRODUCT_WINDOW_ID}" ctrl+shift+w 2>/dev/null || true
        xdotool keyup Control_L Control_R Shift_L Shift_R w 2>/dev/null || true
    else
        zentty_product_ctrl_shift_key "${backend}" w
    fi
}

reply_to_confirmation() {
    local key="$1"
    if zentty_product_uses_xdotool "${backend}"; then
        xdotool key "${key}"
    else
        wtype -k "${key}"
    fi
}

# Lifecycle confirmation journey: drive both cancellation and acceptance for
# the source's window-close and application-quit contracts against real GTK
# windows and real Ghostty PTYs. The rest of this already-large multi-window
# qualification keeps confirmations disabled so its unrelated transaction and
# restoration assertions remain independently diagnostic.
if [[ "${ZENTTY_MULTI_WINDOW_WINDOW_STATE_ONLY:-false}" == true ]]; then
# Keep native window-state qualification independent from destructive-close
# dialogs. Fullscreen changes compositor geometry and pointer-enter timing; it
# must not contaminate the separate confirmation journey's input targeting.
launch_command="${SHELL:-/bin/bash}"
start_product
create_second_window false
zentty_product_wait_for_log "${log}" \
    'zentty-linux: shell-signal pane=pane-window-2 kind=shell-state state=prompt command-present=false' \
    "window-state shell did not reach its prompt" || fail "window-state idle prompt missing"

# F11 is the standard Linux fullscreen binding. Require the physical shortcut
# to reach the named action and require GTK to report both compositor-accepted
# state transitions.
zentty_product_key "${backend}" F11
zentty_product_wait_for_log "${log}" 'zentty-linux: shortcut=f11 action=toggle-fullscreen' \
    "physical F11 did not route to Toggle Full Screen" || fail "fullscreen shortcut missing"
zentty_product_wait_for_log "${log}" 'zentty-linux: window-state id=window-2 fullscreen=true' \
    "compositor did not acknowledge fullscreen" || fail "fullscreen transition missing"
zentty_product_key "${backend}" F11
zentty_product_wait_for_log_count "${log}" 'zentty-linux: shortcut=f11 action=toggle-fullscreen' 2 \
    "second physical F11 did not route" || fail "fullscreen exit shortcut missing"
zentty_product_wait_for_log "${log}" 'zentty-linux: window-state id=window-2 fullscreen=false' \
    "compositor did not acknowledge leaving fullscreen" || fail "fullscreen exit missing"

# X11 exposes the compositor's minimized state and lets the harness reactivate
# the exact native toplevel. Wayland's xdg-toplevel minimize request has no
# acknowledged minimized state, so product code uses the same GTK request but
# must not fabricate a PASS for an unobservable compositor outcome.
if [[ "${backend}" == x11 ]]; then
    execute_palette_action "Minimize this window through the compositor" "Minimize Window"
    zentty_product_wait_for_log "${log}" \
        'zentty-linux: window-state id=window-2 minimize-requested=true' \
        "Minimize Window did not reach GTK" || fail "minimize request missing"
    for _ in {1..240}; do
        xprop -id "${ZENTTY_PRODUCT_WINDOW_ID}" _NET_WM_STATE 2>/dev/null |
            grep -Fq '_NET_WM_STATE_HIDDEN' && break
        sleep 0.05
    done
    xprop -id "${ZENTTY_PRODUCT_WINDOW_ID}" _NET_WM_STATE 2>/dev/null |
        grep -Fq '_NET_WM_STATE_HIDDEN' || fail "X11 compositor did not minimize the target"
    xdotool windowactivate --sync "${ZENTTY_PRODUCT_WINDOW_ID}"
fi
close_active_window
zentty_product_wait_for_log "${log}" 'zentty-linux: window-closed id=window-2 remaining=1' \
    "window-state target did not close after activation" || fail "window-state close missing"
zentty_product_close_window "${backend}"
wait_for_exit
echo "Rust multi-window state passed: backend=${backend}, fullscreen=roundtrip, minimize=$([[ "${backend}" == x11 ]] && echo native || echo compositor-request-only)"
exit 0
fi

if [[ "${ZENTTY_MULTI_WINDOW_FLEET_ONLY:-false}" != true &&
    "${ZENTTY_MULTI_WINDOW_EXISTING_WORKLANE_ONLY:-false}" != true &&
    "${ZENTTY_MULTI_WINDOW_RESTORE_LAYOUT_ONLY:-false}" != true ]]; then
start_product
create_second_window

# A worklane close uses the same typed live-work authority as pane, window,
# and application close. Exercise its exact target, cancellation, acceptance,
# and survivor PTY before changing window count.
if [[ "${backend}" == wayland ]]; then
    # Creating a surface during Cage's synthetic Control+T key-down can move
    # focus before the matching key-up is delivered. Exercise the same product
    # action through the real command palette so a held `t` cannot be replayed
    # against the survivor later in this destructive-close journey.
    execute_palette_action "Create another worklane" "New Worklane"
else
    zentty_product_ctrl_key "${backend}" t
fi
zentty_product_wait_for_log "${log}" \
    'zentty-linux: action=new-worklane id=worklane-window-2-1 pane=pane-window-2-1' \
    "New Worklane did not create the real close target" || fail "worklane close target missing"
execute_palette_action "Close Worklane" "Close Worklane"
zentty_product_wait_for_log "${log}" 'zentty-linux: confirmation shown title="Close this worklane?"' \
    "Close Worklane did not present its source confirmation" || fail "worklane confirmation missing"
reply_to_confirmation Escape
zentty_product_wait_for_log "${log}" 'zentty-linux: confirmation accepted=false' \
    "Escape did not cancel Close Worklane" || fail "worklane confirmation cancellation missing"
type_and_expect_title "worklane-close-cancelled" "pane-window-2-1"
accepted_before="$(grep -Fc 'zentty-linux: confirmation accepted=true' "${log}" || true)"
execute_palette_action "Close Worklane" "Close Worklane"
zentty_product_wait_for_log_count "${log}" 'zentty-linux: confirmation shown title="Close this worklane?"' 2 \
    "second Close Worklane did not present confirmation" || fail "second worklane confirmation missing"
reply_to_confirmation Return
zentty_product_wait_for_log_count "${log}" 'zentty-linux: confirmation accepted=true' "$((accepted_before + 1))" \
    "Return did not accept Close Worklane" || fail "worklane confirmation acceptance missing"
zentty_product_wait_for_log "${log}" \
    'zentty-linux: action=close-worklane id=worklane-window-2-1 panes=1' \
    "accepted Close Worklane did not remove its exact target" || fail "confirmed worklane close failed"
type_and_expect_title "worklane-close-survivor" "pane-window-2"

close_active_window
zentty_product_wait_for_log "${log}" 'zentty-linux: confirmation shown title="Close this window?"' \
    "Close Window did not present its source confirmation" || fail "window confirmation missing"
reply_to_confirmation Escape
zentty_product_wait_for_log "${log}" 'zentty-linux: confirmation accepted=false' \
    "Escape did not cancel Close Window" || fail "window confirmation cancellation missing"
target_second_window
type_and_expect_title "window-close-cancelled" "pane-window-2"
accepted_before="$(grep -Fc 'zentty-linux: confirmation accepted=true' "${log}" || true)"
close_active_window
zentty_product_wait_for_log_count "${log}" 'zentty-linux: confirmation shown title="Close this window?"' 2 \
    "second Close Window did not present confirmation" || fail "second window confirmation missing"
reply_to_confirmation Return
zentty_product_wait_for_log_count "${log}" 'zentty-linux: confirmation accepted=true' "$((accepted_before + 1))" \
    "Return did not accept Close Window" || fail "window confirmation acceptance missing"
zentty_product_wait_for_log "${log}" 'zentty-linux: window-closed id=window-2 remaining=1' \
    "accepted Close Window did not close only its target" || fail "confirmed window close failed"
if [[ "${backend}" == wayland && "${ZENTTY_NESTED_WAYLAND_OUTER_X11_INPUT:-}" != 1 ]]; then
    # Cage may destroy the shortcut target before its key-up reaches the
    # surviving toplevel. Clear modifier state through whichever controlled
    # physical-input route owns this nested compositor so following text cannot
    # become an unrelated shortcut (for example Control+T / New Worklane).
    wtype -M ctrl -M shift -m shift -m ctrl
fi
zentty_product_prepare_input "${backend}" "${log}" || fail "could not retarget surviving confirmation window"
focus_outer_wayland_pane pane-1
type_and_expect_title "window-close-confirmed-survivor" "pane-1"
zentty_product_close_window "${backend}"
zentty_product_wait_for_log "${log}" 'zentty-linux: confirmation shown title="Quit Zentty?"' \
    "Quit did not present its source confirmation" || fail "quit confirmation missing"
reply_to_confirmation Escape
zentty_product_wait_for_log_count "${log}" 'zentty-linux: confirmation accepted=false' 2 \
    "Escape did not cancel Quit" || fail "quit confirmation cancellation missing"
zentty_product_prepare_input "${backend}" "${log}" || fail "could not refocus after cancelled quit"
focus_outer_wayland_pane pane-1
type_and_expect_title "quit-cancelled" "pane-1"
accepted_before="$(grep -Fc 'zentty-linux: confirmation accepted=true' "${log}" || true)"
zentty_product_close_window "${backend}"
zentty_product_wait_for_log_count "${log}" 'zentty-linux: confirmation shown title="Quit Zentty?"' 2 \
    "second Quit did not present confirmation" || fail "second quit confirmation missing"
reply_to_confirmation Return
zentty_product_wait_for_log_count "${log}" 'zentty-linux: confirmation accepted=true' "$((accepted_before + 1))" \
    "Return did not accept Quit" || fail "quit confirmation acceptance missing"
wait_for_exit

# Source behavior does not nag for an untouched interactive shell merely
# because a PTY child exists. Repeat the same physical window-manager route
# with two real idle shells and prove both closes are immediate.
rm -rf -- "${state_dir}"
state_dir="$(mktemp -d)"
launch_command="${SHELL:-/bin/bash}"
start_product
create_second_window false
zentty_product_wait_for_log "${log}" \
    'zentty-linux: shell-signal pane=pane-1 kind=shell-state state=prompt command-present=false' \
    "first untouched shell did not reach its prompt" || fail "first idle prompt missing"
zentty_product_wait_for_log "${log}" \
    'zentty-linux: shell-signal pane=pane-window-2 kind=shell-state state=prompt command-present=false' \
    "second untouched shell did not reach its prompt" || fail "second idle prompt missing"
confirmation_before="$(grep -Fc 'zentty-linux: confirmation shown title=' "${log}" || true)"
close_active_window
zentty_product_wait_for_log "${log}" 'zentty-linux: window-closed id=window-2 remaining=1' \
    "idle Close Window did not close immediately" || fail "idle window close failed"
[[ "$(grep -Fc 'zentty-linux: confirmation shown title=' "${log}" || true)" == "${confirmation_before}" ]] ||
    fail "idle shell incorrectly presented a close confirmation"
zentty_product_prepare_input "${backend}" "${log}" || fail "could not retarget idle surviving window"
zentty_product_close_window "${backend}"
wait_for_exit
[[ "$(grep -Fc 'zentty-linux: confirmation shown title=' "${log}" || true)" == "${confirmation_before}" ]] ||
    fail "idle final shell incorrectly presented a quit confirmation"
launch_command="${child_command}"
fi

if [[ "${ZENTTY_MULTI_WINDOW_LIFECYCLE_ONLY:-false}" == true ]]; then
    echo "Rust multi-window lifecycle passed: backend=${backend}, real-windows=2, fullscreen=roundtrip, confirmation=cancel+accept, real-ptys=preserved+reaped"
    exit 0
fi

cat >"${config_file}" <<'EOF'
[confirmations]
confirm_before_closing_pane = false
confirm_before_closing_window = false
confirm_before_quitting = false

[clipboard]
always_clean_copies = true

[menu_bar]
show_status_item = true
EOF

# Focused GH3 closure journey. This remains a mode of the canonical real
# multi-window actor so persistence, product startup, compositor input, and PTY
# assertions cannot drift into a second qualification path.
if [[ "${ZENTTY_MULTI_WINDOW_RESTORE_LAYOUT_ONLY:-false}" == true ]]; then
    start_product
    execute_palette_action \
        "Split the focused pane into a visible right column" "Split Right"
    zentty_product_wait_for_log "${log}" 'zentty-linux: terminal-ready-pane=pane-2' \
        "right split did not create pane-2" || fail "restore-layout right pane missing"
    execute_palette_action "Split the focused pane vertically" "New Pane Below"
    zentty_product_wait_for_log "${log}" 'zentty-linux: terminal-ready-pane=pane-3' \
        "vertical split did not create pane-3" || fail "restore-layout lower pane missing"
    zentty_product_wait_for_log "${log}" \
        'zentty-linux: geometry=worklane-1:column-worklane-1[pane-1],column-pane-2[pane-2,pane-3]' \
        "real actions did not create the expected two-axis layout" ||
        fail "restore-layout topology missing"

    horizontal_pointer='zentty-linux: pane-divider-pointer id=pane-divider-column-after-column-worklane-1 state=enter'
    vertical_pointer='zentty-linux: pane-divider-pointer id=pane-divider-column-pane-2-after-pane-2 state=enter'
    horizontal_resize='zentty-linux: pane-divider-resize axis=horizontal after=column-worklane-1 '
    vertical_resize='zentty-linux: pane-divider-resize axis=vertical column=column-pane-2 after=pane-2 '
    horizontal_equalize='zentty-linux: pane-divider-equalize axis=horizontal after=column-worklane-1'
    vertical_equalize='zentty-linux: pane-divider-equalize axis=vertical column=column-pane-2 after=pane-2'

    drag_divider_physically "${horizontal_pointer}" horizontal "${horizontal_resize}" 80 0 horizontal
    drag_divider_physically "${vertical_pointer}" vertical "${vertical_resize}" 0 60 vertical
    equalize_divider_physically \
        "${horizontal_pointer}" horizontal "${horizontal_equalize}" horizontal
    equalize_divider_physically \
        "${vertical_pointer}" vertical "${vertical_equalize}" vertical

    # Persist deliberately non-default final geometry after proving the source
    # double-click behavior. These are again real pointer drags, not model calls.
    drag_divider_physically "${horizontal_pointer}" horizontal "${horizontal_resize}" 70 0 \
        "final horizontal"
    drag_divider_physically "${vertical_pointer}" vertical "${vertical_resize}" 0 50 \
        "final vertical"

    snapshot="${state_dir}/restore-snapshot.json"
    # The product contract deliberately debounces live snapshots for 350 ms.
    # Do not accept the structurally valid snapshot written for the preceding
    # equalized layout; wait past that owned quiet period before inspecting the
    # final two physical drags.
    sleep 0.5
    for _ in {1..240}; do
        if [[ -f "${snapshot}" ]] && jq -e '
            .reason == "liveSnapshot" and
            [.workspace.windows[0].worklanes[0].columns[].id] ==
                ["column-worklane-1", "column-pane-2"] and
            [.workspace.windows[0].worklanes[0].columns[].panes[].id] ==
                ["pane-1", "pane-2", "pane-3"] and
            (.workspace.windows[0].worklanes[0].columns[0].width > 0) and
            (.workspace.windows[0].worklanes[0].columns[1].paneHeights | length) == 2
        ' "${snapshot}" >/dev/null 2>&1; then
            break
        fi
        sleep 0.05
    done
    jq -e '
        .reason == "liveSnapshot" and
        .workspace.schemaVersion == 3 and
        [.workspace.windows[0].worklanes[0].columns[].id] ==
            ["column-worklane-1", "column-pane-2"] and
        [.workspace.windows[0].worklanes[0].columns[].panes[].id] ==
            ["pane-1", "pane-2", "pane-3"] and
        ([.. | objects | keys[]] | any(. == "surface" or . == "pty" or
            . == "transcript" or . == "clipboard" or . == "runtimeHandle") | not)
    ' "${snapshot}" >/dev/null || fail "physical layout live snapshot was incomplete or unsafe"
    stored_left_width="$(jq -r '.workspace.windows[0].worklanes[0].columns[0].width' "${snapshot}")"
    stored_top_weight="$(jq -r '.workspace.windows[0].worklanes[0].columns[1].paneHeights[0]' "${snapshot}")"
    stored_bottom_weight="$(jq -r '.workspace.windows[0].worklanes[0].columns[1].paneHeights[1]' "${snapshot}")"

    zentty_product_close_window "${backend}"
    wait_for_exit
    jq -e --argjson width "${stored_left_width}" \
        --argjson top "${stored_top_weight}" --argjson bottom "${stored_bottom_weight}" '
        .reason == "cleanExit" and
        .workspace.windows[0].worklanes[0].columns[0].width == $width and
        .workspace.windows[0].worklanes[0].columns[1].paneHeights == [$top, $bottom]
    ' "${snapshot}" >/dev/null || fail "clean exit changed physical divider geometry"

    start_product
    zentty_product_wait_for_log "${log}" 'zentty-linux: terminal-ready-pane=pane-3' \
        "relaunch did not restore all three real Ghostty panes" ||
        fail "restored physical layout pane missing"
    zentty_product_wait_for_log "${log}" \
        'zentty-linux: geometry=worklane-1:column-worklane-1[pane-1],column-pane-2[pane-2,pane-3]' \
        "relaunch did not restore exact pane/column topology" ||
        fail "restored physical layout topology missing"
    for _ in {1..240}; do
        if [[ -f "${snapshot}" ]] && jq -e \
            --argjson width "${stored_left_width}" \
            --argjson top "${stored_top_weight}" --argjson bottom "${stored_bottom_weight}" '
            def near($actual; $expected): (($actual - $expected) | abs) < 0.000000001;
            .reason == "liveSnapshot" and
            near(.workspace.windows[0].worklanes[0].columns[0].width; $width) and
            near(.workspace.windows[0].worklanes[0].columns[1].paneHeights[0]; $top) and
            near(.workspace.windows[0].worklanes[0].columns[1].paneHeights[1]; $bottom)
        ' "${snapshot}" >/dev/null 2>&1; then
            break
        fi
        sleep 0.05
    done
    if ! jq -e --argjson width "${stored_left_width}" \
        --argjson top "${stored_top_weight}" --argjson bottom "${stored_bottom_weight}" '
        def near($actual; $expected): (($actual - $expected) | abs) < 0.000000001;
        near(.workspace.windows[0].worklanes[0].columns[0].width; $width) and
        near(.workspace.windows[0].worklanes[0].columns[1].paneHeights[0]; $top) and
        near(.workspace.windows[0].worklanes[0].columns[1].paneHeights[1]; $bottom)
    ' "${snapshot}" >/dev/null; then
        printf 'rust-multi-window: expected restored geometry width=%s pane-heights=%s,%s; actual=' \
            "${stored_left_width}" "${stored_top_weight}" "${stored_bottom_weight}" >&2
        jq -c '[.workspace.windows[0].worklanes[0].columns[0].width,
            .workspace.windows[0].worklanes[0].columns[1].paneHeights]' "${snapshot}" >&2
        fail "relaunch changed exact physical divider geometry"
    fi
    type_and_expect_title "restored-physical-divider-layout" "pane-3"
    zentty_product_close_window "${backend}"
    wait_for_exit
    echo "Rust workspace layout restore passed: ${backend}, pointer=drag+double-click, geometry=pixel-exact, relaunch=real-pty"
    exit 0
fi

if [[ "${ZENTTY_STATUS_NOTIFIER:-false}" == true ]]; then
    [[ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ]] || fail "status-notifier journey requires a private session bus"
    status_notifier_fixture="${repo_root}/target/release-safe/status_notifier_watcher"
    [[ -x "${status_notifier_fixture}" ]] || fail "status-notifier watcher fixture is not built"
    status_notifier_receipt="${state_dir}/status-notifier.jsonl"
    "${status_notifier_fixture}" --receipt "${status_notifier_receipt}" &
    status_notifier_pid=$!
    for _ in {1..100}; do
        grep -Fq '"event":"ready"' "${status_notifier_receipt}" 2>/dev/null && break
        kill -0 "${status_notifier_pid}" 2>/dev/null || fail "status-notifier watcher exited before readiness"
        sleep 0.02
    done
    grep -Fq '"event":"ready"' "${status_notifier_receipt}" || fail "status-notifier watcher did not become ready"
fi

# Journey 0: split a second real pane, then invoke the source-named window move
# through the real command palette. The exact PTY child set, terminal-ready
# count, post-move physical input, and authenticated event route prove this is
# a live reparent rather than a reconstructed terminal or model-only move.
if [[ "${ZENTTY_MULTI_WINDOW_EXISTING_WORKLANE_ONLY:-false}" != true ]]; then
start_product
if [[ "${ZENTTY_MULTI_WINDOW_FLEET_ONLY:-false}" == true ]]; then
if [[ "${ZENTTY_MULTI_WINDOW_SKIP_FOOTER_JOURNEYS:-false}" != true ]]; then
zentty_product_wait_for_log "${log}" 'zentty-linux: focus-pane pane=pane-1' \
    "initial terminal focus did not settle before footer input" || fail "fleet footer focus barrier missing"
zentty_product_wait_for_log "${log}" 'zentty-linux: project-context pane=pane-1 ' \
    "initial project-context refresh did not settle before footer input" || fail "fleet footer project barrier missing"
execute_palette_action "agent activity across every Zentty window" "Agent Status"
zentty_product_wait_for_log "${log}" 'zentty-linux: fleet-footer-focus action=settings' \
    "empty fleet did not focus its Settings footer" || fail "fleet Settings focus missing"
zentty_product_alt_key "${backend}" q
zentty_product_wait_for_log "${log}" 'zentty-linux: fleet-footer-activate action=quit' \
    "physical footer activation did not invoke Quit" || fail "fleet Quit activation missing"
wait_for_exit
if [[ "${ZENTTY_STATUS_NOTIFIER:-false}" == true ]]; then
    first_item_service="$(jq -r 'select(.event == "registered") | .service' "${status_notifier_receipt}" | tail -1)"
    [[ "${first_item_service}" == org.kde.StatusNotifierItem-* ]] || fail "watcher receipt omitted the first item service"
    for _ in {1..100}; do
        owner_reply="$(gdbus call --session --dest org.freedesktop.DBus \
            --object-path /org/freedesktop/DBus --method org.freedesktop.DBus.NameHasOwner \
            "${first_item_service}" 2>/dev/null || true)"
        [[ "${owner_reply}" == '(false,)' ]] && break
        sleep 0.02
    done
    [[ "${owner_reply:-}" == '(false,)' ]] || fail "Quit leaked the first status-item bus name"
fi
start_product
execute_palette_action "agent activity across every Zentty window" "Agent Status"
zentty_product_wait_for_log "${log}" 'zentty-linux: fleet-footer-focus action=settings' \
    "reopened empty fleet did not restore footer focus" || fail "fleet footer reopen missing"
zentty_product_alt_key "${backend}" s
zentty_product_wait_for_log "${log}" 'zentty-linux: fleet-footer-activate action=settings' \
    "physical footer activation did not invoke Settings" || fail "fleet Settings activation missing"
zentty_product_wait_for_log "${log}" 'zentty-linux: settings-section selected=agents' \
    "fleet footer did not deep-link to Agents settings" || fail "fleet Settings route missing"
zentty_product_wait_for_log "${log}" 'status-item-available=true' \
    "Agents settings did not discover the controlled watcher" || fail "status-item setting unavailable"
# The settings route has now been proven through physical input. Restart for
# the independent multi-window fleet lifecycle instead of coupling it to a
# transient-toplevel close operation in the deliberately WM-free X11 fixture.
kill -TERM "${product_pid}"
wait "${product_pid}" 2>/dev/null || true
product_pid=""
start_product
if [[ "${ZENTTY_STATUS_NOTIFIER:-false}" == true ]]; then
    sed -i 's/show_status_item = true/show_status_item = false/' "${config_file}"
    zentty_product_wait_for_log "${log}" 'zentty-linux: status-notifier state=disabled reason=setting-disabled' \
        "live disabled setting did not withdraw publication" || fail "status-item disabled setting missing"
    sed -i 's/show_status_item = false/show_status_item = true/' "${config_file}"
    zentty_product_wait_for_log_count "${log}" 'zentty-linux: status-notifier state=registered service=' 2 \
        "live enabled setting did not restore publication" || fail "status-item enabled setting missing"
fi
fi
zentty_product_type "${backend}" "agent-waiting"
zentty_product_key "${backend}" Return
zentty_product_wait_for_log "${log}" \
    'zentty-linux: agent-event pane=pane-1 worklane=worklane-1 kind=agent.needs-input session=fleet-waiting' \
    "first-window pane did not publish controlled waiting state" || fail "fleet waiting state missing"
fi
mapfile -t children_before_split < <(pgrep -P "${product_pid}" | sort -n)
[[ "${#children_before_split[@]}" -eq 1 ]] || fail "fresh window did not own exactly one PTY child"
original_child="${children_before_split[0]}"
execute_palette_action "Split the focused pane into a visible right column" "Split Right"
zentty_product_wait_for_log "${log}" 'zentty-linux: terminal-ready-pane=pane-2' \
    "Split Right did not create pane-2's real Ghostty surface" || fail "second pane missing"
children_after_split=()
for _ in {1..200}; do
    mapfile -t children_after_split < <(pgrep -P "${product_pid}" | sort -n)
    [[ "${#children_after_split[@]}" -eq 2 ]] && break
    sleep 0.05
done
[[ "${#children_after_split[@]}" -eq 2 ]] || fail "split did not produce exactly two PTY children"
printf '%s\n' "${children_after_split[@]}" | grep -Fxq "${original_child}" ||
    fail "split replaced the original PTY child"
type_and_expect_title "before-live-window-move" "pane-2"
focus_count_before_move="$(grep -Fc 'zentty-linux: focus-pane pane=pane-2' "${log}" || true)"
execute_palette_action "Move Pane to New Window" "Move Pane to New Window"
