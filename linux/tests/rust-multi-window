    "failed move did not preserve the source authenticated agent route" ||
    fail "source agent route rollback missing"
zentty_product_type "${backend}" "tmux-route"
zentty_product_key "${backend}" Return
zentty_product_wait_for_log "${log}" \
    'zentty-linux: tmux-command pane=pane-2 worklane=worklane-1 command=DisplayMessage' \
    "failed move did not preserve the source tmux route" ||
    fail "source tmux route rollback missing"
zentty_product_wait_for_log "${log}" 'zentty-linux: title-pane=pane-2 value=tmux:%pane-2' \
    "failed move did not return its tmux reply through the same PTY" ||
    fail "source tmux response after rollback missing"
for _ in {1..240}; do
    [[ -f "${state_dir}/restore-snapshot.json" ]] && jq -e '
        (.workspace.windows | map(.id)) == ["window-1"] and
        [.workspace.windows[0].worklanes[].columns[].panes[].id] == ["pane-1", "pane-2"] and
        .workspace.activeWindowID == "window-1"
    ' "${state_dir}/restore-snapshot.json" >/dev/null 2>&1 && break
    sleep 0.05
done
jq -e '
    (.workspace.windows | map(.id)) == ["window-1"] and
    [.workspace.windows[0].worklanes[].columns[].panes[].id] == ["pane-1", "pane-2"] and
    .workspace.activeWindowID == "window-1"
' "${state_dir}/restore-snapshot.json" >/dev/null ||
    fail "live snapshot published duplicate or missing ownership after rollback"
zentty_product_close_window "${backend}"
wait_for_exit
fi

# Journey 0c: move the only pane in one existing window into an existing
# worklane in another. X11 clicks the exact contextual rows resolved from GTK
# pointer receipts; nested Wayland sends the same real pointer input through
# its controlled outer-X11 compositor window. The source toplevel must close, while both original PTY
# children and the moved pane's authenticated routes continue in the existing
# destination without constructing a replacement surface.
if [[ "${ZENTTY_MULTI_WINDOW_SKIP_EXISTING_WORKLANE:-false}" != true ]]; then
rm -rf -- "${state_dir}"
state_dir="$(mktemp -d)"
start_product
create_second_window
mapfile -t existing_transfer_children_before < <(pgrep -P "${product_pid}" | sort -n)
[[ "${#existing_transfer_children_before[@]}" -eq 2 ]] ||
    fail "existing-worklane journey did not begin with two real PTY children"
if [[ "${backend}" == x11 ]]; then
    source_window=window-1
    source_pane=pane-1
    destination_window=window-2
    destination_worklane=worklane-window-2
    destination_existing_pane=pane-window-2
    target_second_window "${source_pane}"
    find_pointer_target \
        "zentty-linux: pane-context-pointer action=open pane=${source_pane}" 250 ||
        fail "physical pointer could not locate ${source_pane}'s rendered action button"
    xdotool click 1
    sleep 0.1
    find_pointer_target \
        "zentty-linux: pane-context-pointer action=move-pane-to-worklane pane=${source_pane}" any ||
        fail "physical pointer could not locate Move Pane to Worklane"
    xdotool click 1
    sleep 0.1
    find_pointer_target \
        "zentty-linux: pane-context-pointer action=move-pane-to-worklane window=${destination_window} target=${destination_worklane}" any ||
        fail "foreign window worklane destination was not rendered in the source menu"
    xdotool click 1
else
    source_window=window-2
    source_pane=pane-window-2
    destination_window=window-1
    destination_worklane=worklane-1
    destination_existing_pane=pane-1
    find_pointer_target \
        "zentty-linux: pane-context-pointer action=open pane=${source_pane}" any ||
        fail "physical pointer could not locate ${source_pane}'s rendered action button"
    xdotool click 1
    sleep 0.1
    find_popover_target \
        "zentty-linux: pane-context-pointer action=move-pane-to-worklane pane=${source_pane}" ||
        fail "physical pointer could not locate Move Pane to Worklane near its rendered anchor"
    xdotool click 1
    sleep 0.1
    zentty_product_wait_for_log "${log}" \
        "zentty-linux: pane-context-focus action=move-pane-to-worklane window=${destination_window} target=${destination_worklane}" \
        "foreign worklane destination did not receive GTK focus" ||
        fail "foreign worklane destination was not focused when its rendered submenu opened"
    # GTK focuses the sole rendered foreign destination when the submenu is
    # installed. Activate that real button with one physical key event; unlike
    # the source-menu traversal, no queued navigation event can move focus
    # after the exact receipt. Clear only synthetic modifier state inherited
    # from earlier XTest chords before delivery.
    xdotool key --clearmodifiers Return
fi
zentty_product_wait_for_log "${log}" \
    "zentty-linux: action=move-pane-to-window-worklane pane=${source_pane} source=${source_window} destination-window=${destination_window} destination-worklane=${destination_worklane}" \
    "existing-worklane transfer did not commit" || fail "existing-worklane transaction missing"
zentty_product_wait_for_log "${log}" "zentty-linux: window-closed id=${source_window} remaining=1" \
    "moving the final source pane did not close its empty window" ||
    fail "empty transfer source survived"
zentty_product_wait_for_log "${log}" \
    "zentty-linux: topology=${destination_worklane}[title=none,color=none]:${destination_existing_pane},${source_pane}*" \
    "destination did not append and focus the moved pane" ||
    fail "existing-worklane destination topology missing"
[[ "$(grep -Fc "zentty-linux: terminal-ready-pane=${source_pane}" "${log}")" -eq 1 ]] ||
    fail "existing-worklane transfer recreated ${source_pane}'s Ghostty surface"
mapfile -t existing_transfer_children_after < <(pgrep -P "${product_pid}" | sort -n)
[[ "${existing_transfer_children_after[*]}" == "${existing_transfer_children_before[*]}" ]] ||
    fail "existing-worklane transfer changed the real PTY child set"
zentty_product_prepare_input "${backend}" "${log}" || fail "could not focus transfer destination"
if [[ "${backend}" == wayland ]]; then
    hover_before="$(grep -Fc "zentty-linux: pane-controls pane=${source_pane} state=shown" "${log}" || true)"
    moved_pane_found=false
    for focus_y in 300 450 600 750; do
        for focus_x in 600 800 1000 1200; do
            xdotool mousemove --sync --window "${ZENTTY_PRODUCT_WINDOW_ID}" "${focus_x}" "${focus_y}"
            sleep 0.05
            if (( $(grep -Fc "zentty-linux: pane-controls pane=${source_pane} state=shown" "${log}" || true) > hover_before )); then
                xdotool click 1
                moved_pane_found=true
                break 2
            fi
        done
    done
    [[ "${moved_pane_found}" == true ]] ||
        fail "physical Wayland pointer could not locate the moved destination pane"
fi
type_and_expect_title "existing-worklane-live-pty" "${source_pane}"
zentty_product_type "${backend}" "agent-running"
zentty_product_key "${backend}" Return
zentty_product_wait_for_log "${log}" \
    "zentty-linux: agent-event pane=${source_pane} worklane=${destination_worklane} kind=agent.running session=moved-live-pane" \
    "moved pane agent route did not adopt the destination worklane" ||
    fail "existing-worklane agent route missing"
zentty_product_close_window "${backend}"
wait_for_exit
if [[ "${ZENTTY_MULTI_WINDOW_EXISTING_WORKLANE_ONLY:-false}" == true ]]; then
    echo "Rust existing-worklane live transfer passed: ${backend}, source=closed, destination=existing, pty=preserved, route=adopted"
    exit 0
fi
fi

# Journey 1: create two windows through the real shortcut, prove the active
# second PTY receives input, save both through the one real persistence path,
# and relaunch the exact two-window recipe.
rm -rf -- "${state_dir}"
state_dir="$(mktemp -d)"
start_product
create_second_window
type_and_expect_title "second-window-marker" "pane-window-2"
resize_second_window_x11
for _ in {1..240}; do
    [[ -f "${state_dir}/restore-snapshot.json" ]] &&
        jq -e '
            (.workspace.windows | map(.id)) == ["window-1", "window-2"] and
            .workspace.activeWindowID == "window-2" and
            all(.workspace.windows[]; .frame.width >= 320 and .frame.height >= 240)
        ' "${state_dir}/restore-snapshot.json" >/dev/null 2>&1 && break
    sleep 0.05
done
jq -e '
    (.workspace.windows | map(.id)) == ["window-1", "window-2"] and
    .workspace.activeWindowID == "window-2" and
    all(.workspace.windows[]; .frame.width >= 320 and .frame.height >= 240) and
    (.restoreDraftWindows | length) == 0
' "${state_dir}/restore-snapshot.json" >/dev/null || fail "live snapshot lost multi-window order or active identity"
first_frame_size="$(jq -r '.workspace.windows[0].frame | "\(.width | round)x\(.height | round)"' "${state_dir}/restore-snapshot.json")"
second_frame_size="$(jq -r '.workspace.windows[1].frame | "\(.width | round)x\(.height | round)"' "${state_dir}/restore-snapshot.json")"
zentty_product_close_window "${backend}"
wait_for_exit
jq -e '
    .reason == "cleanExit" and
    (.workspace.windows | map(.id)) == ["window-1", "window-2"] and
    .workspace.activeWindowID == "window-2" and
    all(.workspace.windows[]; .frame.width >= 320 and .frame.height >= 240)
' "${state_dir}/restore-snapshot.json" >/dev/null || fail "clean exit did not preserve both windows"

start_product
wait_for_frame_restore_requests "${first_frame_size}" "${second_frame_size}"
zentty_product_wait_for_log "${log}" 'zentty-linux: window-opened id=window-2' \
    "clean relaunch did not restore the second GTK window" || fail "second restore window missing"
zentty_product_wait_for_log "${log}" 'zentty-linux: terminal-ready-pane=pane-window-2' \
    "clean relaunch did not restore the second Ghostty surface" || fail "second restore terminal missing"
zentty_product_wait_for_log "${log}" 'zentty-linux: focus-pane pane=pane-window-2' \
    "clean relaunch did not settle focus in the restored active window" || fail "restored active focus missing"
target_second_window
if [[ "${backend}" == x11 ]]; then
    restored_geometry="$(xdotool getwindowgeometry --shell "${ZENTTY_PRODUCT_WINDOW_ID}")"
    restored_width="$(sed -n 's/^WIDTH=//p' <<<"${restored_geometry}")"
    restored_height="$(sed -n 's/^HEIGHT=//p' <<<"${restored_geometry}")"
    [[ "${restored_width}x${restored_height}" == "${second_frame_size}" ]] ||
        fail "restored X11 window is ${restored_width}x${restored_height}, expected ${second_frame_size}"
fi
type_and_expect_title "restored-second-marker" "pane-window-2"
zentty_product_close_window "${backend}"
wait_for_exit

# Journey 2: close only the active second window, then prove the surviving
# first window's real PTY remains independently responsive before final quit.
rm -rf -- "${state_dir}"
state_dir="$(mktemp -d)"
start_product
create_second_window
close_active_window
zentty_product_wait_for_log "${log}" 'zentty-linux: window-closed id=window-2 remaining=1' \
    "Close Window did not remove only the active second window" || fail "non-final close failed"
kill -0 "${product_pid}" 2>/dev/null || fail "closing the second window terminated the application"
zentty_product_prepare_input "${backend}" "${log}" || fail "could not retarget the surviving window"
focus_outer_wayland_pane pane-1
type_and_expect_title "surviving-first-marker" "pane-1"
zentty_product_close_window "${backend}"
wait_for_exit

# Journey 3: prove the same aggregate live snapshot is authoritative crash
# recovery, not merely normal restore. Explicitly disable normal restoration
# on relaunch: the unclean lifecycle must override that preference once.
rm -rf -- "${state_dir}"
state_dir="$(mktemp -d)"
product_args=()
start_product
create_second_window
type_and_expect_title "crash-second-marker" "pane-window-2"
snapshot="${state_dir}/restore-snapshot.json"
lifecycle="${state_dir}/restore-lifecycle.json"
for _ in {1..240}; do
    if [[ -f "${snapshot}" ]] && jq -e '
        .reason == "liveSnapshot" and
        (.workspace.windows | map(.id)) == ["window-1", "window-2"] and
        .workspace.activeWindowID == "window-2"
    ' "${snapshot}" >/dev/null 2>&1; then
        break
    fi
    kill -0 "${product_pid}" 2>/dev/null || fail "product exited before the aggregate live snapshot"
    sleep 0.05
done
jq -e '
    .reason == "liveSnapshot" and
    (.workspace.windows | map(.id)) == ["window-1", "window-2"] and
    .workspace.activeWindowID == "window-2" and
    (.restoreDraftWindows | length) == 0
' "${snapshot}" >/dev/null || fail "crash candidate lost aggregate live state"
jq -e '.cleanExit == false' "${lifecycle}" >/dev/null ||
    fail "running multi-window product was not marked unclean"

crashed_pid="${product_pid}"
mapfile -t crashed_children < <(pgrep -P "${crashed_pid}" || true)
kill -KILL "${crashed_pid}"
set +e
wait "${crashed_pid}"
crash_status=$?
set -e
product_pid=""
((crash_status == 137)) || fail "SIGKILL crash exited with unexpected status ${crash_status}"
for child in "${crashed_children[@]}"; do
    for _ in {1..100}; do
        kill -0 "${child}" 2>/dev/null || break
        sleep 0.05
    done
    kill -0 "${child}" 2>/dev/null && fail "crashed product left PTY child ${child} alive"
done
jq -e '.cleanExit == false' "${lifecycle}" >/dev/null ||
    fail "abnormal multi-window termination was marked clean"

product_args=(--no-session-restore)
start_product
zentty_product_wait_for_log "${log}" 'zentty-linux: window-opened id=window-2' \
    "crash relaunch did not restore the second GTK window" || fail "second crash window missing"
zentty_product_wait_for_log "${log}" 'zentty-linux: terminal-ready-pane=pane-window-2' \
    "crash relaunch did not restore the second Ghostty PTY" || fail "second crash terminal missing"
zentty_product_wait_for_log "${log}" 'zentty-linux: focus-pane pane=pane-window-2' \
    "crash relaunch did not settle the recorded active window" || fail "crash active focus missing"
target_second_window
type_and_expect_title "recovered-second-marker" "pane-window-2"
zentty_product_close_window "${backend}"
wait_for_exit
[[ ! -e "${snapshot}" ]] || fail "disabled normal restoration retained the recovered snapshot"
jq -e '.cleanExit == true' "${lifecycle}" >/dev/null ||
    fail "recovered multi-window clean exit did not mark the lifecycle clean"

echo "Rust multi-window passed: backend=${backend}, real-windows=2, transfer=live+real-construction-rollback, restore=clean+SIGKILL+size, non-final-close=survived"
