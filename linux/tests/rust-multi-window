#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
product="${ZENTTY_LINUX_BINARY:-${repo_root}/build/linux/bin/zentty-linux}"
backend="${GDK_BACKEND:-}"
bundle_root="$(cd "$(dirname "${product}")/.." 2>/dev/null && pwd)" || bundle_root=""
bundle_lib="${bundle_root}/lib"
state_dir=""
log=""
product_pid=""
route_probe_index=0
product_args=()
config_file=""

# shellcheck source=linux/tests/lib/product-input
source "${repo_root}/linux/tests/lib/product-input"

fail() {
    [[ -z "${log}" || ! -f "${log}" ]] || cat "${log}" >&2
    echo "rust-multi-window: error: $*" >&2
    exit 1
}

cleanup() {
    if [[ "${product_pid}" =~ ^[1-9][0-9]*$ ]]; then
        kill -TERM "${product_pid}" 2>/dev/null || true
        wait "${product_pid}" 2>/dev/null || true
    fi
    [[ -z "${state_dir}" ]] || rm -rf -- "${state_dir}"
    [[ -z "${log}" ]] || rm -f -- "${log}"
    [[ -z "${config_file}" ]] || rm -f -- "${config_file}"
}
trap cleanup EXIT

case "${backend}" in
    x11)
        [[ "${ZENTTY_NESTED_X11_SESSION_ID:-}" =~ ^[0-9a-f]{64}$ ]] ||
            fail "X11 journey must run through linux/tests/nested-x11"
        ;;
    wayland)
        [[ "${ZENTTY_NESTED_WAYLAND_INPUT_SESSION_ID:-}" =~ ^[0-9a-f]{64}$ ]] ||
            fail "Wayland journey must run through linux/tests/nested-wayland-input"
        ;;
    *) fail "GDK_BACKEND must be x11 or wayland" ;;
esac
for dependency in cmp dirname jq mkdir readelf timeout mktemp grep; do
    command -v "${dependency}" >/dev/null || fail "${dependency} is required"
done
[[ -x "${product}" ]] || fail "staged product is not built: ${product}"
[[ -f "${bundle_lib}/libghostty-gtk-embed.so" ]] ||
    fail "selected product bundle has no Ghostty library"
[[ -f "${bundle_lib}/libgtk4-layer-shell.so" ]] ||
    fail "selected product bundle has no GTK layer-shell library"

layer_runpath="$(
    readelf -d "${bundle_lib}/libghostty-gtk-embed.so" |
        sed -n 's/.*Library runpath: \[\([^]]*\)\].*/\1/p' |
        cut -d: -f1
)"
[[ "${layer_runpath}" == .zig-cache/* ]] || fail "Ghostty layer-shell runpath is missing"

state_dir="$(mktemp -d)"
log="$(mktemp)"
config_file="${XDG_CONFIG_HOME:?}/zentty/config.toml"
mkdir -p "$(dirname "${config_file}")"
cat >"${config_file}" <<'EOF'
[clipboard]
always_clean_copies = true
EOF
# Single quotes intentionally defer every expansion to the real PTY child.
# shellcheck disable=SC2016
child_command='while IFS= read -r value; do if [ "$value" = agent-waiting ]; then printf '\''%s'\'' '\''{"version":1,"event":"agent.needs-input","agent":{"name":"Claude Code"},"session":{"id":"fleet-waiting"},"state":{"text":"Approve cross-window deployment?","interaction":{"kind":"approval","text":"Approve cross-window deployment?"}}}'\'' | "$ZENTTY_CLI_BIN" ipc agent-event; elif [ "$value" = agent-running ]; then printf '\''%s'\'' '\''{"version":1,"event":"agent.running","agent":{"name":"Codex"},"session":{"id":"moved-live-pane"}}'\'' | "$ZENTTY_CLI_BIN" ipc agent-event; elif [ "$value" = tmux-route ]; then route="$(tmux display-message -p '\''#{pane_id}'\'')" && printf '\''\033]2;tmux:%s\a'\'' "$route"; elif [ "$value" = tmux-stale-claim ]; then route="$(ZENTTY_WINDOW_ID=window-1 ZENTTY_WORKLANE_ID=worklane-1 tmux display-message -p '\''#{pane_id}'\'')" && printf '\''\033]2;tmux-stale:%s\a'\'' "$route"; elif [ "$value" = capture-move ]; then tmux capture-pane -p | grep -Fq before-live-window-move && printf '\''\033]2;scrollback-preserved\a'\''; else printf '\''\033]2;%s\a'\'' "$value"; fi; done'

start_product() {
    : >"${log}"
    CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS=1 \
        LD_LIBRARY_PATH="${bundle_lib}${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}" \
        "${product}" \
        --command "${child_command}" \
        --state-directory "${state_dir}" \
        --async-backend default \
        "${product_args[@]}" >"${log}" 2>&1 &
    product_pid=$!
    zentty_product_wait_for_log "${log}" 'zentty-linux: window-opened id=window-1' \
        "first real product window did not open" || fail "first window missing"
    zentty_product_wait_for_log "${log}" 'zentty-linux: terminal-ready-pane=pane-1' \
        "first real Ghostty surface did not become ready" || fail "first terminal missing"
    zentty_product_wait_for_log "${log}" \
        'zentty-linux: config-projected window=window-1 automatic-clean-copy=true' \
        "first window did not receive the process clipboard config" || fail "first config projection missing"
    [[ "$(grep -Fc 'zentty-linux: config-loaded ' "${log}" || true)" -eq 1 ]] ||
        fail "one process loaded the config more than once"
    zentty_product_prepare_input "${backend}" "${log}" || fail "could not prepare physical input"
}

wait_for_exit() {
    for _ in {1..240}; do
        kill -0 "${product_pid}" 2>/dev/null || break
        sleep 0.05
    done
    kill -0 "${product_pid}" 2>/dev/null && fail "product did not exit after physical quit"
    set +e
    wait "${product_pid}"
    status=$?
    set -e
    product_pid=""
    [[ "${status}" -eq 0 ]] || fail "product exited ${status}"
}

target_second_window() {
    local pane_id="${1:-pane-window-2}"
    if [[ "${backend}" == x11 ]]; then
        mapfile -t candidate_ids < <(
            xdotool search --onlyvisible --pid "${product_pid}" --name '^Zentty$' 2>/dev/null
        )
        [[ "${#candidate_ids[@]}" -eq 2 ]] ||
            fail "X11 did not expose exactly two product window identities"
        route_probe_index=$((route_probe_index + 1))
        for candidate_id in "${candidate_ids[@]}"; do
            [[ "$(xdotool getwindowpid "${candidate_id}" 2>/dev/null || true)" == "${product_pid}" ]] ||
                fail "X11 candidate window is not owned by the product"
            probe="zentty-window-route-probe-${route_probe_index}-${candidate_id}"
            xdotool windowfocus --sync "${candidate_id}"
            xdotool type --delay 5 "${probe}"
            xdotool key Return
            for _ in {1..40}; do
                if grep -Fq "zentty-linux: title-pane=${pane_id} value=${probe}" "${log}"; then
                    ZENTTY_PRODUCT_WINDOW_ID="${candidate_id}"
                    export ZENTTY_PRODUCT_WINDOW_ID
                    return
                fi
                sleep 0.05
            done
        done
        fail "physical route probes could not identify ${pane_id}'s X11 toplevel"
    fi
}

execute_palette_action() {
    local query="$1"
    local action="$2"
    zentty_product_ctrl_shift_key "${backend}" p
    zentty_product_wait_for_log "${log}" 'zentty-linux: command-palette=shown' \
        "command palette did not open for ${action}" || fail "${action} palette missing"
    zentty_product_type "${backend}" "${query}"
    zentty_product_wait_for_log "${log}" \
        "zentty-linux: command-palette=query value=\"${query}\" results=1" \
        "${action} did not resolve uniquely" || fail "${action} palette query failed"
    zentty_product_key "${backend}" Down
    zentty_product_key "${backend}" Return
}

create_second_window() {
    zentty_product_ctrl_shift_key "${backend}" n
    zentty_product_wait_for_log "${log}" 'zentty-linux: window-opened id=window-2' \
        "physical New Window did not create the second GTK window" || fail "second window missing"
    zentty_product_wait_for_log "${log}" 'zentty-linux: terminal-ready-pane=pane-window-2' \
        "second window did not own a distinct real Ghostty surface" || fail "second terminal missing"
    zentty_product_wait_for_log "${log}" 'zentty-linux: focus-pane pane=pane-window-2' \
        "second window did not settle real terminal focus" || fail "second terminal focus missing"
    zentty_product_wait_for_log "${log}" \
        'zentty-linux: config-projected window=window-2 automatic-clean-copy=true' \
        "second window did not receive the process clipboard config" || fail "second config projection missing"
    if [[ "${backend}" == x11 ]]; then
        visible_count="$(xdotool search --onlyvisible --pid "${product_pid}" --name '^Zentty$' 2>/dev/null | wc -l)"
        [[ "${visible_count}" -eq 2 ]] || fail "X11 exposed ${visible_count} product windows instead of two"
    fi
    target_second_window
}

type_and_expect_title() {
    local value="$1"
    local pane_id="$2"
    if [[ "${backend}" == x11 ]]; then
        # Use XTest against the explicitly focused product window. Xdotool's
        # per-window synthetic-event mode can restore an earlier focus between
        # the text and Return calls when two mapped windows share one PID.
        xdotool windowfocus --sync "${ZENTTY_PRODUCT_WINDOW_ID}"
        xdotool type --delay 5 "${value}"
        xdotool key Return
    else
        zentty_product_type "${backend}" "${value}"
        zentty_product_key "${backend}" Return
    fi
    zentty_product_wait_for_log "${log}" \
        "zentty-linux: title-pane=${pane_id} value=${value}" \
        "input did not route to ${pane_id}" || fail "cross-window input routing failed"
}

resize_second_window_x11() {
    [[ "${backend}" == x11 ]] || return 0
    xdotool windowsize --sync "${ZENTTY_PRODUCT_WINDOW_ID}" 1110 730
    zentty_product_wait_for_log "${log}" 'zentty-linux: window-size=1110x730' \
        "externally resized second X11 window did not report its actual allocation" ||
        fail "second X11 window resize missing"
}

wait_for_frame_restore_requests() {
    local first_size="$1"
    local second_size="$2"
    zentty_product_wait_for_log "${log}" \
        "zentty-linux: window-frame-restore-request id=window-1 size=${first_size} placement=compositor" \
        "first restored window did not request its persisted size" || fail "first frame request missing"
    zentty_product_wait_for_log "${log}" \
        "zentty-linux: window-frame-restore-request id=window-2 size=${second_size} placement=compositor" \
        "second restored window did not request its persisted size" || fail "second frame request missing"
}

close_active_window() {
    if [[ "${backend}" == x11 ]]; then
        # The target is destroyed on key-down, before XTest can deliver every
        # synthetic release to that XID. Product logs and survivor input prove
        # the close; reset global key state against the live root window.
        xdotool key --window "${ZENTTY_PRODUCT_WINDOW_ID}" ctrl+shift+w 2>/dev/null || true
        xdotool keyup Control_L Control_R Shift_L Shift_R w 2>/dev/null || true
    else
        zentty_product_ctrl_shift_key "${backend}" w
    fi
}

reply_to_confirmation() {
    local key="$1"
    if zentty_product_uses_xdotool "${backend}"; then
        xdotool key "${key}"
    else
        wtype -k "${key}"
    fi
}

# Lifecycle confirmation journey: drive both cancellation and acceptance for
# the source's window-close and application-quit contracts against real GTK
# windows and real Ghostty PTYs. The rest of this already-large multi-window
# qualification keeps confirmations disabled so its unrelated transaction and
# restoration assertions remain independently diagnostic.
if [[ "${ZENTTY_MULTI_WINDOW_FLEET_ONLY:-false}" != true ]]; then
start_product
create_second_window
close_active_window
zentty_product_wait_for_log "${log}" 'zentty-linux: confirmation shown title="Close this window?"' \
    "Close Window did not present its source confirmation" || fail "window confirmation missing"
reply_to_confirmation Escape
zentty_product_wait_for_log "${log}" 'zentty-linux: confirmation accepted=false' \
    "Escape did not cancel Close Window" || fail "window confirmation cancellation missing"
target_second_window
type_and_expect_title "window-close-cancelled" "pane-window-2"
accepted_before="$(grep -Fc 'zentty-linux: confirmation accepted=true' "${log}" || true)"
close_active_window
zentty_product_wait_for_log_count "${log}" 'zentty-linux: confirmation shown title="Close this window?"' 2 \
    "second Close Window did not present confirmation" || fail "second window confirmation missing"
reply_to_confirmation Return
zentty_product_wait_for_log_count "${log}" 'zentty-linux: confirmation accepted=true' "$((accepted_before + 1))" \
    "Return did not accept Close Window" || fail "window confirmation acceptance missing"
zentty_product_wait_for_log "${log}" 'zentty-linux: window-closed id=window-2 remaining=1' \
    "accepted Close Window did not close only its target" || fail "confirmed window close failed"
zentty_product_prepare_input "${backend}" "${log}" || fail "could not retarget surviving confirmation window"
type_and_expect_title "window-close-confirmed-survivor" "pane-1"
zentty_product_close_window "${backend}"
zentty_product_wait_for_log "${log}" 'zentty-linux: confirmation shown title="Quit Zentty?"' \
    "Quit did not present its source confirmation" || fail "quit confirmation missing"
reply_to_confirmation Escape
zentty_product_wait_for_log_count "${log}" 'zentty-linux: confirmation accepted=false' 2 \
    "Escape did not cancel Quit" || fail "quit confirmation cancellation missing"
zentty_product_prepare_input "${backend}" "${log}" || fail "could not refocus after cancelled quit"
type_and_expect_title "quit-cancelled" "pane-1"
accepted_before="$(grep -Fc 'zentty-linux: confirmation accepted=true' "${log}" || true)"
zentty_product_close_window "${backend}"
zentty_product_wait_for_log_count "${log}" 'zentty-linux: confirmation shown title="Quit Zentty?"' 2 \
    "second Quit did not present confirmation" || fail "second quit confirmation missing"
reply_to_confirmation Return
zentty_product_wait_for_log_count "${log}" 'zentty-linux: confirmation accepted=true' "$((accepted_before + 1))" \
    "Return did not accept Quit" || fail "quit confirmation acceptance missing"
wait_for_exit
fi

cat >"${config_file}" <<'EOF'
[confirmations]
confirm_before_closing_pane = false
confirm_before_closing_window = false
confirm_before_quitting = false

[clipboard]
always_clean_copies = true
EOF

# Journey 0: split a second real pane, then invoke the source-named window move
# through the real command palette. The exact PTY child set, terminal-ready
# count, post-move physical input, and authenticated event route prove this is
# a live reparent rather than a reconstructed terminal or model-only move.
start_product
if [[ "${ZENTTY_MULTI_WINDOW_FLEET_ONLY:-false}" == true ]]; then
zentty_product_type "${backend}" "agent-waiting"
if [[ "${backend}" == wayland ]]; then
    wtype -k Return
else
    zentty_product_key "${backend}" Return
fi
zentty_product_wait_for_log "${log}" \
    'zentty-linux: agent-event pane=pane-1 worklane=worklane-1 kind=agent.needs-input session=fleet-waiting' \
    "first-window pane did not publish controlled waiting state" || fail "fleet waiting state missing"
fi
mapfile -t children_before_split < <(pgrep -P "${product_pid}" | sort -n)
[[ "${#children_before_split[@]}" -eq 1 ]] || fail "fresh window did not own exactly one PTY child"
original_child="${children_before_split[0]}"
execute_palette_action "Split the focused pane into a visible right column" "Split Right"
zentty_product_wait_for_log "${log}" 'zentty-linux: terminal-ready-pane=pane-2' \
    "Split Right did not create pane-2's real Ghostty surface" || fail "second pane missing"
children_after_split=()
for _ in {1..200}; do
    mapfile -t children_after_split < <(pgrep -P "${product_pid}" | sort -n)
    [[ "${#children_after_split[@]}" -eq 2 ]] && break
    sleep 0.05
done
[[ "${#children_after_split[@]}" -eq 2 ]] || fail "split did not produce exactly two PTY children"
printf '%s\n' "${children_after_split[@]}" | grep -Fxq "${original_child}" ||
    fail "split replaced the original PTY child"
type_and_expect_title "before-live-window-move" "pane-2"
focus_count_before_move="$(grep -Fc 'zentty-linux: focus-pane pane=pane-2' "${log}" || true)"
execute_palette_action "Move Pane to New Window" "Move Pane to New Window"
zentty_product_wait_for_log "${log}" \
    'zentty-linux: action=move-pane-to-new-window pane=pane-2 source=window-1 destination=window-2' \
    "live pane move did not complete" || fail "pane-to-window transaction missing"
zentty_product_wait_for_log "${log}" 'zentty-linux: window-opened id=window-2' \
    "live pane move did not present its destination window" || fail "move destination missing"
zentty_product_wait_for_log "${log}" \
    'zentty-linux: topology=worklane-1[title=none,color=none]:pane-1*' \
    "live pane move did not leave the source topology authoritative" ||
    fail "move source topology missing"
zentty_product_wait_for_log "${log}" \
    'zentty-linux: topology=window-2-worklane-1[title=none,color=none]:pane-2*' \
    "live pane move did not project the destination topology" ||
    fail "move destination topology missing"
zentty_product_wait_for_log_count "${log}" 'zentty-linux: focus-pane pane=pane-2' \
    "$((focus_count_before_move + 1))" "moved pane did not settle compositor focus" ||
    fail "move destination focus missing"
[[ "$(grep -Fc 'zentty-linux: terminal-ready-pane=pane-2' "${log}")" -eq 1 ]] ||
    fail "live pane move recreated pane-2's Ghostty surface"
children_after_move=()
for _ in {1..40}; do
    mapfile -t children_after_move < <(pgrep -P "${product_pid}" | sort -n)
    [[ "${children_after_move[*]}" == "${children_after_split[*]}" ]] && break
    sleep 0.05
done
[[ "${children_after_move[*]}" == "${children_after_split[*]}" ]] ||
    fail "live pane move changed the real PTY child set"
target_second_window "pane-2"
type_and_expect_title "after-live-window-move" "pane-2"
zentty_product_type "${backend}" "agent-running"
zentty_product_key "${backend}" Return
zentty_product_wait_for_log "${log}" \
    'zentty-linux: agent-event pane=pane-2 worklane=window-2-worklane-1 kind=agent.running session=moved-live-pane' \
    "moved pane capability did not retarget through the shared real socket" ||
    fail "post-move authenticated agent route missing"
if [[ "${ZENTTY_MULTI_WINDOW_FLEET_ONLY:-false}" == true ]]; then
zentty_product_wait_for_log "${log}" 'zentty-linux: fleet-refresh windows=2 agents=2' \
    "both real-window agent projections did not reach one fleet" || fail "cross-window fleet missing"
execute_palette_action "agent activity across every Zentty window" "Agent Status"
zentty_product_wait_for_log "${log}" 'zentty-linux: chrome-popover=agent-fleet state=open' \
    "keyboard-accessible fleet control did not open" || fail "fleet popover missing"
# The source-priority model places the waiting pane first. Opening the popover
# gives that first real row keyboard focus without relying on backend coordinates.
zentty_product_wait_for_log "${log}" \
    'zentty-linux: fleet-row-focus window=window-1 worklane=worklane-1 pane=pane-1' \
    "fleet did not focus its highest-priority real row" || fail "fleet priority focus missing"
# The same typed fleet target is projected into Zentty's real command palette,
# keeping exact cross-window routing keyboard accessible without compositor-
# specific coordinates. The opened popover and priority-focus receipt above
# independently prove the grouped fleet projection itself.
zentty_product_key "${backend}" Escape
execute_palette_action "Requires approval" "waiting fleet pane"
zentty_product_wait_for_log "${log}" \
    'zentty-linux: fleet-activate window=window-1 worklane=worklane-1 pane=pane-1 result=targeted' \
    "fleet did not route to the urgent pane in the other real window" || fail "fleet route missing"
if [[ "${backend}" == x11 ]]; then
    target_second_window "pane-1"
    type_and_expect_title "fleet-routed-exact-pty" "pane-1"
else
    zentty_product_prepare_input "${backend}" "${log}" || fail "could not retarget fleet destination"
    zentty_product_type "${backend}" "fleet-routed-exact-pty"
    zentty_product_key "${backend}" Return
    if ! zentty_product_wait_for_log "${log}" \
        'zentty-linux: title-pane=pane-1 value=fleet-routed-exact-pty' \
        "Wayland compositor did not grant focus to the fleet target"; then
        echo "rust-multi-window: XFAIL Wayland cross-window fleet activation lacks a compositor-granted activation token" >&2
        exit 98
    fi
fi
zentty_product_close_window "${backend}"
wait_for_exit
echo "Rust agent fleet passed: ${backend}, windows=2, statuses=2, route=exact-real-pty"
exit 0
fi
target_second_window "pane-2"
zentty_product_type "${backend}" "tmux-route"
zentty_product_key "${backend}" Return
zentty_product_wait_for_log "${log}" \
    'zentty-linux: tmux-command pane=pane-2 worklane=window-2-worklane-1 command=DisplayMessage' \
    "moved pane tmux command did not reach the destination workspace" ||
    fail "post-move tmux destination route missing"
zentty_product_wait_for_log "${log}" 'zentty-linux: title-pane=pane-2 value=tmux:%pane-2' \
    "moved pane did not receive its real tmux response" || fail "post-move tmux response missing"
tmux_destination_count="$(grep -Fc 'zentty-linux: tmux-command pane=pane-2 worklane=window-2-worklane-1 command=DisplayMessage' "${log}" || true)"
zentty_product_type "${backend}" "tmux-stale-claim"
zentty_product_key "${backend}" Return
zentty_product_wait_for_log_count "${log}" \
    'zentty-linux: tmux-command pane=pane-2 worklane=window-2-worklane-1 command=DisplayMessage' \
    "$((tmux_destination_count + 1))" "stale source claim did not remain canonicalized to the destination" ||
    fail "stale source tmux claim escaped canonical routing"
zentty_product_wait_for_log "${log}" 'zentty-linux: title-pane=pane-2 value=tmux-stale:%pane-2' \
    "stale source claim did not return through the moved pane" || fail "stale-claim tmux response missing"
! grep -Fq 'zentty-linux: tmux-command pane=pane-2 worklane=worklane-1' "${log}" ||
    fail "tmux accepted stale source worklane targeting after the move"
zentty_product_type "${backend}" "capture-move"
zentty_product_key "${backend}" Return
zentty_product_wait_for_log "${log}" 'zentty-linux: title-pane=pane-2 value=scrollback-preserved' \
    "real Ghostty capture lost pre-move terminal contents" || fail "pre-move scrollback was not preserved"
for _ in {1..240}; do
    [[ -f "${state_dir}/restore-snapshot.json" ]] && jq -e '
        (.workspace.windows | map(.id)) == ["window-1", "window-2"] and
        [.workspace.windows[0].worklanes[].columns[].panes[].id] == ["pane-1"] and
        [.workspace.windows[1].worklanes[].columns[].panes[].id] == ["pane-2"] and
        .workspace.activeWindowID == "window-2"
    ' "${state_dir}/restore-snapshot.json" >/dev/null 2>&1 && break
    sleep 0.05
done
jq -e '
    (.workspace.windows | map(.id)) == ["window-1", "window-2"] and
    [.workspace.windows[0].worklanes[].columns[].panes[].id] == ["pane-1"] and
    [.workspace.windows[1].worklanes[].columns[].panes[].id] == ["pane-2"] and
    .workspace.activeWindowID == "window-2"
' "${state_dir}/restore-snapshot.json" >/dev/null || fail "live snapshot lost transferred pane ownership"
zentty_product_close_window "${backend}"
wait_for_exit
jq -e '
    .reason == "cleanExit" and
    (.workspace.windows | map(.id)) == ["window-1", "window-2"] and
    [.workspace.windows[0].worklanes[].columns[].panes[].id] == ["pane-1"] and
    [.workspace.windows[1].worklanes[].columns[].panes[].id] == ["pane-2"] and
    .workspace.activeWindowID == "window-2"
' "${state_dir}/restore-snapshot.json" >/dev/null || fail "clean exit lost transferred pane ownership"

start_product
zentty_product_wait_for_log "${log}" 'zentty-linux: window-opened id=window-2' \
    "clean relaunch did not restore the transfer destination" || fail "clean transfer restore window missing"
zentty_product_wait_for_log "${log}" 'zentty-linux: terminal-ready-pane=pane-2' \
    "clean relaunch did not restore the transferred pane" || fail "clean transfer restore pane missing"
zentty_product_wait_for_log "${log}" 'zentty-linux: focus-pane pane=pane-2' \
    "clean relaunch did not focus the transfer destination" || fail "clean transfer restore focus missing"
target_second_window "pane-2"
type_and_expect_title "clean-restored-live-window-move" "pane-2"
for _ in {1..240}; do
    jq -e '
        .reason == "liveSnapshot" and
        (.workspace.windows | map(.id)) == ["window-1", "window-2"] and
        [.workspace.windows[0].worklanes[].columns[].panes[].id] == ["pane-1"] and
        [.workspace.windows[1].worklanes[].columns[].panes[].id] == ["pane-2"] and
        .workspace.activeWindowID == "window-2"
    ' "${state_dir}/restore-snapshot.json" >/dev/null 2>&1 && break
    sleep 0.05
done
jq -e '
    .reason == "liveSnapshot" and
    (.workspace.windows | map(.id)) == ["window-1", "window-2"] and
