#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
product="${ZENTTY_LINUX_BINARY:-${repo_root}/build/linux/bin/zentty-linux}"
backend="${GDK_BACKEND:-}"
log=""
state_directory=""
product_pid=""
window_id=""
clipboard_actual=""
clipboard_expected=""

fail() {
    [[ -z "${log}" || ! -f "${log}" ]] || cat "${log}" >&2
    echo "rust-pane-search: error: $*" >&2
    exit 1
}

cleanup() {
    if [[ "${product_pid}" =~ ^[1-9][0-9]*$ ]]; then
        kill -TERM "${product_pid}" 2>/dev/null || true
        wait "${product_pid}" 2>/dev/null || true
    fi
    [[ -z "${log}" ]] || rm -f -- "${log}"
    [[ -z "${state_directory}" ]] || rm -rf -- "${state_directory}"
    [[ -z "${clipboard_actual}" ]] || rm -f -- "${clipboard_actual}"
    [[ -z "${clipboard_expected}" ]] || rm -f -- "${clipboard_expected}"
}
trap cleanup EXIT

case "${backend}" in
    x11)
        [[ "${ZENTTY_NESTED_X11_SESSION_ID:-}" =~ ^[0-9a-f]{64}$ ]] ||
            fail "X11 search must run through linux/tests/nested-x11"
        command -v xdotool >/dev/null || fail "xdotool is required for X11 search"
        command -v xclip >/dev/null || fail "xclip is required for X11 clipboard proof"
        ;;
    wayland)
        [[ "${ZENTTY_NESTED_WAYLAND_INPUT_SESSION_ID:-}" =~ ^[0-9a-f]{64}$ ]] ||
            fail "Wayland search must run through linux/tests/nested-wayland-input"
        command -v wtype >/dev/null || fail "wtype is required for Wayland search"
        command -v wl-paste >/dev/null || fail "wl-paste is required for Wayland clipboard proof"
        command -v wl-copy >/dev/null || fail "wl-copy is required for Wayland clipboard proof"
        ;;
    *) fail "GDK_BACKEND must be x11 or wayland" ;;
esac
for dependency in awk cmp grep mktemp seq sha256sum sleep tail wc; do
    command -v "${dependency}" >/dev/null || fail "${dependency} is required"
done
[[ -x "${product}" ]] || fail "staged product is not built: ${product}"

press_ctrl_shift() {
    local key="$1"
    if [[ "${backend}" == x11 ]]; then
        xdotool key --window "${window_id}" "ctrl+shift+${key}"
        xdotool keyup Control_L Control_R Shift_L Shift_R "${key}" 2>/dev/null || true
    else
        wtype -M ctrl -M shift -k "${key}" -m shift -m ctrl
    fi
}

press_ctrl_alt_shift() {
    local key="$1"
    if [[ "${backend}" == x11 ]]; then
        xdotool key --window "${window_id}" "ctrl+alt+shift+${key}"
        xdotool keyup Control_L Control_R Alt_L Alt_R Shift_L Shift_R "${key}" 2>/dev/null || true
    else
        wtype -M ctrl -M alt -M shift -k "${key}" -m shift -m alt -m ctrl
    fi
}

press_key() {
    local key="$1"
    if [[ "${backend}" == x11 ]]; then
        xdotool key --window "${window_id}" "${key}"
    else
        wtype -k "${key}"
    fi
}

type_text() {
    local value="$1"
    if [[ "${backend}" == x11 ]]; then
        xdotool type --window "${window_id}" --delay 10 "${value}"
    else
        wtype "${value}"
    fi
}

clear_text() {
    if [[ "${backend}" == x11 ]]; then
        xdotool key --window "${window_id}" ctrl+a BackSpace
        xdotool keyup Control_L Control_R a BackSpace 2>/dev/null || true
    else
        wtype -M ctrl -k a -m ctrl -k BackSpace
    fi
}

clear_global_find() {
    local cleared_before
    cleared_before="$(grep -Fc 'zentty-linux: global-find-state visible=true remembered=false selected=None total=0' "${log}" || true)"
    clear_text
    for _ in $(seq 1 160); do
        [[ "$(grep -Fc 'zentty-linux: global-find-state visible=true remembered=false selected=None total=0' "${log}" || true)" -gt "${cleared_before}" ]] && return
        sleep 0.05
    done
    fail "clearing Global Find did not publish a fresh cleared-state receipt"
}

wait_for_fixed() {
    local receipt="$1"
    local message="$2"
    for _ in $(seq 1 160); do
        grep -Fxq "${receipt}" "${log}" && return
        sleep 0.05
    done
    fail "${message}"
}

wait_for_count_greater() {
    local receipt="$1"
    local baseline="$2"
    local message="$3"
    for _ in $(seq 1 160); do
        [[ "$(grep -Fc "${receipt}" "${log}" || true)" -gt "${baseline}" ]] && return
        sleep 0.05
    done
    fail "${message}"
}

run_palette_action() {
    local query="$1"
    local action_receipt="$2"
    local expected_results="${3:-1}"
    local query_before action_before
    query_before="$(grep -Fc "zentty-linux: command-palette=query value=\"${query}\" results=${expected_results}" "${log}" || true)"
    action_before="$(grep -Fc "${action_receipt}" "${log}" || true)"
    press_ctrl_shift p
    type_text "${query}"
    wait_for_count_greater \
        "zentty-linux: command-palette=query value=\"${query}\" results=${expected_results}" \
        "${query_before}" \
        "command palette did not resolve ${query}"
    press_key Return
    wait_for_count_greater "${action_receipt}" "${action_before}" \
        "command palette did not execute ${query}"
}

assert_standard_clipboard() {
    local expected="$1"
    printf '%s' "${expected}" >"${clipboard_expected}"
    if [[ "${backend}" == x11 ]]; then
        xclip -selection clipboard -out >"${clipboard_actual}"
    else
        wl-paste --no-newline >"${clipboard_actual}"
    fi
    cmp -s "${clipboard_expected}" "${clipboard_actual}" || {
        printf 'expected clipboard sha256=%s bytes=%s\n' \
            "$(sha256sum "${clipboard_expected}" | awk '{print $1}')" \
            "$(wc -c <"${clipboard_expected}")" >&2
        printf 'actual clipboard sha256=%s bytes=%s\n' \
            "$(sha256sum "${clipboard_actual}" | awk '{print $1}')" \
            "$(wc -c <"${clipboard_actual}")" >&2
        fail "external ${backend} standard clipboard bytes differed"
    }
}

set_standard_clipboard() {
    local value="$1"
    if [[ "${backend}" == x11 ]]; then
        printf '%s' "${value}" | xclip -selection clipboard -in
    else
        printf '%s' "${value}" | wl-copy
    fi
}

log="$(mktemp)"
state_directory="$(mktemp -d)"
clipboard_actual="$(mktemp)"
clipboard_expected="$(mktemp)"
# The single quotes intentionally defer PTY-child expansion.
# shellcheck disable=SC2016
GDK_SCALE=1 GDK_DPI_SCALE=1 \
    "${product}" \
    --command 'printf "https://example.com/reset?token=noisegamma&utm_source=mail"; while IFS= read -r line; do case "$line" in markdown) printf "\033[2J\033[3J\033[H## Clipboard Notes\n\nOne wrapped\nparagraph"; printf "\033]2;focus:markdown-ready\a" ;; search-corpus) printf "\033[2J\033[3J\033[Hselectable alpha\nnoise\nselectable beta\nselectable gamma\n"; printf "\033]2;focus:search-ready\a" ;; *) printf "\033]2;focus:%s\a" "$line" ;; esac; done' \
    --state-directory "${state_directory}" \
    --no-session-restore >"${log}" 2>&1 &
product_pid=$!

wait_for_fixed 'zentty-linux: terminal-ready-pane=pane-1' \
    "real Ghostty search surface did not initialize"
for _ in $(seq 1 160); do
    grep -Fq 'zentty-linux: search-state pane=pane-1 active=false total=None selected=None' "${log}" && break
    sleep 0.05
done
grep -Fq 'zentty-linux: search-state pane=pane-1 active=false total=None selected=None' "${log}" ||
    fail "Ghostty search overlay was not observed"

if [[ "${backend}" == x11 ]]; then
    for _ in $(seq 1 160); do
        window_id="$(xdotool search --name '^Zentty$' 2>/dev/null | head -1 || true)"
        [[ "${window_id}" =~ ^[1-9][0-9]*$ ]] && break
        sleep 0.05
    done
    [[ "${window_id}" =~ ^[1-9][0-9]*$ ]] || fail "real X11 Zentty window did not appear"
    xdotool windowfocus --sync "${window_id}"
else
    # Zentty is the only client in the private Weston session and is focused
    # when its first real terminal reports ready.
    sleep 0.2
fi

# Use the source Select All command to create a real Ghostty selection, then
# drive every source copy action through the command palette. The assertion is
# made by an independent compositor client, not an in-process GTK receipt.
set_standard_clipboard 'sentinel-existing-owner'
run_palette_action 'Clean Copy' \
    'zentty-linux: action=clean-copy pane=pane-1 error=selection-unavailable'
assert_standard_clipboard 'sentinel-existing-owner'
run_palette_action 'Select All' \
    'zentty-linux: action=select-all pane=pane-1 binding="select_all"'
run_palette_action 'Copy' 'zentty-linux: action=copy pane=pane-1' 4
assert_standard_clipboard 'https://example.com/reset?token=noisegamma&utm_source=mail'
run_palette_action 'Clean Copy' 'zentty-linux: action=clean-copy pane=pane-1 bytes='
grep -F 'zentty-linux: action=clean-copy pane=pane-1 bytes=' "${log}" | tail -1 |
    grep -Fq 'modified=true' || fail "Clean Copy did not transform the selected tracking URL"
assert_standard_clipboard 'https://example.com/reset?token=noisegamma'

run_palette_action 'Copy Raw' 'zentty-linux: action=copy-raw pane=pane-1'
assert_standard_clipboard 'https://example.com/reset?token=noisegamma&utm_source=mail'

# Copy the same live selection cleanly again, then use Ghostty's ordinary
# physical paste binding to deliver the externally verified compositor bytes
# back through the real PTY. The child title is the round-trip acknowledgement.
run_palette_action 'Clean Copy' 'zentty-linux: action=clean-copy pane=pane-1 bytes='
assert_standard_clipboard 'https://example.com/reset?token=noisegamma'
press_ctrl_shift v
press_key Return
wait_for_fixed \
    'zentty-linux: title-pane=pane-1 value=focus:https://example.com/reset?token=noisegamma' \
    "cleaned compositor clipboard bytes did not paste back through the real PTY"

type_text markdown
press_key Return
wait_for_fixed 'zentty-linux: title-pane=pane-1 value=focus:markdown-ready' \
    "the real PTY did not present the Markdown fixture"
run_palette_action 'Select All' \
    'zentty-linux: action=select-all pane=pane-1 binding="select_all"'
run_palette_action 'Copy as Markdown' \
    'zentty-linux: action=copy-as-markdown pane=pane-1 bytes='
grep -F 'zentty-linux: action=copy-as-markdown pane=pane-1 bytes=' "${log}" | tail -1 |
    grep -Fq 'modified=true' || fail "Copy as Markdown did not reflow selected Markdown"
assert_standard_clipboard $'## Clipboard Notes\n\nOne wrapped paragraph'

type_text search-corpus
press_key Return
wait_for_fixed 'zentty-linux: title-pane=pane-1 value=focus:search-ready' \
    "the real PTY did not restore the search corpus after clipboard proof"

# Physical Linux shortcut -> named Zentty action -> generic Ghostty binding
# parser -> real scrollback search -> Ghostty-owned draggable HUD and counts.
press_ctrl_shift f
wait_for_fixed 'zentty-linux: action=find pane=pane-1 binding="start_search"' \
    "Ctrl+Shift+F did not route through the focused real surface"
for _ in $(seq 1 160); do
    grep -Fq 'zentty-linux: search-state pane=pane-1 active=true' "${log}" && break
    sleep 0.05
done
grep -Fq 'zentty-linux: search-state pane=pane-1 active=true' "${log}" ||
    fail "Ghostty search HUD did not become active"
type_text selectable
for _ in $(seq 1 200); do
    grep -Fq 'zentty-linux: search-state pane=pane-1 active=true total=Some(3)' "${log}" && break
    sleep 0.05
done
grep -Fq 'zentty-linux: search-state pane=pane-1 active=true total=Some(3)' "${log}" ||
    fail "real Ghostty scrollback did not report all three matches"

selected_receipts="$(grep -Ec 'zentty-linux: search-state pane=pane-1 active=true total=Some\(3\) selected=Some\([0-9]+\)' "${log}" || true)"
press_key F3
for _ in $(seq 1 160); do
    grep -Fq 'zentty-linux: action=find-next pane=' "${log}" && break
    sleep 0.05
done
grep -Fq 'zentty-linux: action=find-next pane=' "${log}" ||
    fail "F3 did not invoke Find Next"
for _ in $(seq 1 160); do
    [[ "$(grep -Ec 'zentty-linux: search-state pane=pane-1 active=true total=Some\(3\) selected=Some\([0-9]+\)' "${log}" || true)" -gt "${selected_receipts}" ]] && break
    sleep 0.05
done
[[ "$(grep -Ec 'zentty-linux: search-state pane=pane-1 active=true total=Some\(3\) selected=Some\([0-9]+\)' "${log}" || true)" -gt "${selected_receipts}" ]] ||
    fail "Find Next did not move the real Ghostty match"

if [[ "${backend}" == x11 ]]; then
    xdotool key --window "${window_id}" shift+F3
else
    wtype -M shift -k F3 -m shift
fi
for _ in $(seq 1 160); do
    grep -Fq 'zentty-linux: action=find-previous pane=' "${log}" && break
    sleep 0.05
done
grep -Fq 'zentty-linux: action=find-previous pane=' "${log}" ||
    fail "Shift+F3 did not invoke Find Previous"

hidden_receipts="$(grep -Fc 'zentty-linux: action=hide-search pane=pane-1' "${log}" || true)"
press_key Escape
for _ in $(seq 1 160); do
    [[ "$(grep -Fc 'zentty-linux: action=hide-search pane=pane-1' "${log}" || true)" -gt "${hidden_receipts}" ]] &&
        grep -Fq 'zentty-linux: search-state pane=pane-1 active=false total=Some(3)' "${log}" && break
    sleep 0.05
done
[[ "$(grep -Fc 'zentty-linux: action=hide-search pane=pane-1' "${log}" || true)" -gt "${hidden_receipts}" ]] ||
    fail "Escape did not hide the populated search HUD"
grep -Fq 'zentty-linux: search-state pane=pane-1 active=false total=Some(3)' "${log}" ||
    fail "hiding search incorrectly discarded the live pane query"
type_text search-focus
press_key Return
wait_for_fixed 'zentty-linux: title-pane=pane-1 value=focus:search-focus' \
    "search dismissal did not restore input to the same real PTY"

if [[ "${backend}" == x11 ]]; then
    # Select the first rendered word with a real pointer gesture, then route
    # Ctrl+Shift+E through Ghostty's own selection-to-search implementation.
    xdotool mousemove --window "${window_id}" 330 50 click --repeat 2 --delay 80 1
    press_ctrl_shift e
    wait_for_fixed 'zentty-linux: action=use-selection-for-find pane=pane-1 binding="search_selection"' \
        "physical selection-to-find did not route to Ghostty"
    for _ in $(seq 1 200); do
        grep -Eq 'zentty-linux: search-state pane=pane-1 active=true total=Some\(3\)' "${log}" && break
        sleep 0.05
    done
    grep -Eq 'zentty-linux: search-state pane=pane-1 active=true total=Some\(3\)' "${log}" ||
        fail "real terminal selection did not become the three-match search query"

    # Ghostty's GTK HUD is genuinely draggable. Move it across both midpoints,
    # require the real overlay properties to snap to the opposite corner, then
    # close/reopen and prove both the corner and live-pane query are remembered.
    xdotool mousemove --window "${window_id}" 800 70 mousedown 1 \
        mousemove --window "${window_id}" --sync 350 630 mouseup 1
    for _ in $(seq 1 160); do
        grep -Fq 'halign=Start valign=End' "${log}" && break
        sleep 0.05
    done
    grep -Fq 'halign=Start valign=End' "${log}" ||
        fail "dragged search HUD did not snap to the opposite pane corner"
    press_key Escape
    active_receipts="$(grep -Fc 'zentty-linux: search-state pane=pane-1 active=true' "${log}" || true)"
    press_ctrl_shift f
    for _ in $(seq 1 160); do
        [[ "$(grep -Fc 'zentty-linux: search-state pane=pane-1 active=true' "${log}" || true)" -gt "${active_receipts}" ]] && break
        sleep 0.05
    done
    tail -40 "${log}" | grep -Fq 'active=true total=Some(3)' ||
        fail "reopened HUD did not remember the live pane query"
    tail -40 "${log}" | grep -Fq 'halign=Start valign=End' ||
        fail "reopened HUD did not remember its live-pane corner"
    press_key Escape
fi

# Create a second real Ghostty surface through the user-facing command palette,
# not a model fixture or test API, so Global Find must aggregate and navigate
# across two independently running PTYs on both compositors.
press_ctrl_shift p
type_text 'Split Right'
wait_for_fixed 'zentty-linux: command-palette=query value="Split Right" results=1' \
    "command palette did not resolve Split Right before activation"
press_key Return
wait_for_fixed 'zentty-linux: terminal-ready-pane=pane-2' \
    "command-palette Split Right did not create the second real search pane"
type_text search-corpus
press_key Return
wait_for_fixed 'zentty-linux: title-pane=pane-2 value=focus:search-ready' \
    "the second real PTY did not receive its search corpus"
press_ctrl_shift p
type_text 'New Worklane'
wait_for_fixed 'zentty-linux: command-palette=query value="New Worklane" results=1' \
    "command palette did not resolve New Worklane before activation"
press_key Return
wait_for_fixed 'zentty-linux: terminal-ready-pane=pane-3' \
    "command-palette New Worklane did not create the hidden-worklane search pane"
type_text search-corpus
press_key Return
wait_for_fixed 'zentty-linux: title-pane=pane-3 value=focus:search-ready' \
    "the hidden-worklane PTY did not receive its search corpus"

# Source Global Find uses every live pane's real Ghostty search rather than a
# copied scrollback index. The Linux-native chord is Ctrl+Alt+Shift+F because
# Ctrl+Shift+F remains the pane-local Find command above.
if [[ "${backend}" == x11 ]]; then
    # Exercise the real sidebar Global Find icon as a pointer surface in the
    # controlled X11 window. Wayland uses the same action through the physical
    # chord because its compositor deliberately exposes no global coordinates.
    xdotool mousemove --window "${window_id}" 257 65 click 1
else
    press_ctrl_alt_shift f
fi
wait_for_fixed 'zentty-linux: global-find shown targets=3' \
    "physical Global Find shortcut did not present the window search"
# A two-character query must remain pending until explicit navigation flushes
# it. Enter is sent immediately, without waiting for a timer receipt, and the
# actor then requires all three real Ghostty totals plus the selected match.
type_text ga
for _ in $(seq 1 160); do
    grep -Fq 'zentty-linux: global-find-state visible=true remembered=true selected=None total=0' "${log}" && break
    sleep 0.01
done
grep -Fq 'zentty-linux: global-find-state visible=true remembered=true selected=None total=0' "${log}" ||
    fail "the real Global Find field did not publish its pending short query before debounce"
press_key Return
for _ in $(seq 1 200); do
    grep -Fq 'zentty-linux: global-find-state visible=true remembered=true selected=Some(0) total=3' "${log}" && break
    sleep 0.05
done
grep -Fq 'zentty-linux: global-find-state visible=true remembered=true selected=Some(0) total=3' "${log}" ||
    fail "Global Find navigation did not flush the short query and wait for all real totals"
press_key Return
for _ in $(seq 1 160); do
    grep -Fq 'zentty-linux: global-find-state visible=true remembered=true selected=Some(1) total=3' "${log}" && break
    sleep 0.05
done
grep -Fq 'zentty-linux: global-find navigate pane=pane-2 selected=0' "${log}" ||
    fail "Global Find did not cross from pane 1 into pane 2"
grep -Fq 'zentty-linux: global-find-state visible=true remembered=true selected=Some(1) total=3' "${log}" ||
    fail "Global Find did not report pane 2's aggregate ordinal"
press_key Return
for _ in $(seq 1 160); do
    grep -Fq 'zentty-linux: global-find navigate pane=pane-3 selected=0' "${log}" &&
        grep -Fq 'zentty-linux: global-find-state visible=true remembered=true selected=Some(2) total=3' "${log}" && break
    sleep 0.05
done
grep -Fq 'zentty-linux: global-find navigate pane=pane-3 selected=0' "${log}" ||
    fail "Global Find did not cross into the inactive worklane"
grep -Fq 'zentty-linux: global-find-state visible=true remembered=true selected=Some(2) total=3' "${log}" ||
    fail "Global Find did not report the inactive worklane's aggregate ordinal"

# Keep window 1's three-result search live while creating a real second window.
# Its fresh coordinator must not inherit the first window's query, target set,
# totals, or selection; returning to window 1 must resume the original search.
single_target_before="$(grep -Fc 'zentty-linux: global-find shown targets=1' "${log}" || true)"
first_window_id="${window_id}"
press_ctrl_shift n
wait_for_fixed 'zentty-linux: terminal-ready-pane=pane-window-2' \
    "New Window did not initialize its independent real Ghostty surface"
if [[ "${backend}" == x11 ]]; then
    second_window_id=""
    for _ in $(seq 1 160); do
        while IFS= read -r candidate; do
            if [[ "${candidate}" =~ ^[1-9][0-9]*$ && "${candidate}" != "${first_window_id}" ]]; then
                second_window_id="${candidate}"
                break
            fi
        done < <(xdotool search --onlyvisible --pid "${product_pid}" --name '^Zentty$' 2>/dev/null || true)
        [[ "${second_window_id}" =~ ^[1-9][0-9]*$ ]] && break
        sleep 0.05
    done
    [[ "${second_window_id}" =~ ^[1-9][0-9]*$ ]] || fail "second X11 window identity was unavailable"
    window_id="${second_window_id}"
    xdotool windowfocus --sync "${window_id}"
else
    wtype -M alt -k Tab -m alt
fi
for _ in $(seq 1 160); do
    grep -Fq 'zentty-linux: focus-pane pane=pane-window-2' "${log}" && break
    sleep 0.05
done
grep -Fq 'zentty-linux: focus-pane pane=pane-window-2' "${log}" ||
    fail "physical window targeting did not focus window 2's real terminal"
type_text search-corpus
press_key Return
wait_for_fixed 'zentty-linux: title-pane=pane-window-2 value=focus:search-ready' \
    "window 2's real PTY did not receive its independent search corpus"
press_ctrl_alt_shift f
for _ in $(seq 1 160); do
    [[ "$(grep -Fc 'zentty-linux: global-find shown targets=1' "${log}" || true)" -gt "${single_target_before}" ]] && break
    sleep 0.05
done
[[ "$(grep -Fc 'zentty-linux: global-find shown targets=1' "${log}" || true)" -gt "${single_target_before}" ]] ||
    fail "window 2 Global Find did not start with its independent target set"
window_two_total_before="$(grep -Fc 'zentty-linux: global-find-state visible=true remembered=true selected=None total=1' "${log}" || true)"
type_text noise
wait_for_count_greater \
    'zentty-linux: global-find-state visible=true remembered=true selected=None total=1' \
    "${window_two_total_before}" \
    "window 2 Global Find inherited or contaminated window 1's totals"
# Close window 2 while its search remains active. This exercises the real
# window teardown contract rather than requiring the HUD to be dismissed first.
if [[ "${backend}" == x11 ]]; then
    xdotool windowfocus --sync "${window_id}"
    xdotool key ctrl+shift+w 2>/dev/null || true
    xdotool keyup Control_L Control_R Shift_L Shift_R w 2>/dev/null || true
else
    press_ctrl_shift w
fi
wait_for_fixed 'zentty-linux: window-closed id=window-2 remaining=1' \
    "the independent search window did not close"
if [[ "${backend}" == x11 ]]; then
    window_id="${first_window_id}"
    xdotool windowfocus --sync "${window_id}"
fi
window_one_wrap_before="$(grep -Fc 'zentty-linux: global-find-state visible=true remembered=true selected=Some(0) total=3' "${log}" || true)"
press_key Return
wait_for_count_greater \
    'zentty-linux: global-find-state visible=true remembered=true selected=Some(0) total=3' \
    "${window_one_wrap_before}" \
    "window 1 Global Find did not retain its independent query and selection"

# Create pane 4 while the query's target set is frozen. It runs the same real
# command and would contribute one match if silently admitted, so retaining
# total=3 proves exclusion. Navigate back to searched pane 3, close it through
# the real palette command, then require reconciliation to total=2 without
# admitting pane 4.
press_ctrl_shift p
split_right_query_before="$(grep -Fc 'zentty-linux: command-palette=query value="Split Right" results=1' "${log}" || true)"
type_text 'Split Right'
wait_for_count_greater \
    'zentty-linux: command-palette=query value="Split Right" results=1' \
    "${split_right_query_before}" \
    "command palette did not resolve Split Right during Global Find"
press_key Return
wait_for_fixed 'zentty-linux: terminal-ready-pane=pane-4' \
    "creating a pane during Global Find did not produce a fourth real PTY"
selected_one_before="$(grep -Fc 'zentty-linux: global-find-state visible=true remembered=true selected=Some(1) total=3' "${log}" || true)"
press_key Return
wait_for_count_greater \
    'zentty-linux: global-find-state visible=true remembered=true selected=Some(1) total=3' \
    "${selected_one_before}" \
    "Global Find admitted the new pane or did not return to its searched selection anchor"
selected_two_before="$(grep -Fc 'zentty-linux: global-find-state visible=true remembered=true selected=Some(2) total=3' "${log}" || true)"
press_key Return
wait_for_count_greater \
    'zentty-linux: global-find-state visible=true remembered=true selected=Some(2) total=3' \
    "${selected_two_before}" \
    "Global Find did not navigate back to searched pane 3"
press_ctrl_shift p
type_text 'Close Pane'
wait_for_fixed 'zentty-linux: command-palette=query value="Close Pane" results=2' \
    "command palette did not resolve Close Pane during Global Find"
press_key Return
wait_for_fixed 'zentty-linux: action=close-pane pane=pane-3' \
    "closing a searched pane did not complete through the real product action"
press_key Return
for _ in $(seq 1 200); do
    grep -Fq 'zentty-linux: global-find-state visible=true remembered=true selected=Some(0) total=2' "${log}" && break
    sleep 0.05
done
grep -Fq 'zentty-linux: global-find-state visible=true remembered=true selected=Some(0) total=2' "${log}" ||
    fail "Global Find did not reconcile the closed searched pane without admitting pane 4"
clear_global_find
hidden_before="$(grep -Fc 'zentty-linux: global-find-state visible=false remembered=false selected=None total=0' "${log}" || true)"
press_key Escape
wait_for_count_greater \
    'zentty-linux: global-find-state visible=false remembered=false selected=None total=0' \
    "${hidden_before}" \
    "Escape did not close Global Find"
focus_title_before="$(grep -Fc 'zentty-linux: title-pane=pane-1 value=focus:global-search-focus' "${log}" || true)"
type_text global-search-focus
press_key Return
wait_for_count_greater \
    'zentty-linux: title-pane=pane-1 value=focus:global-search-focus' \
    "${focus_title_before}" \
    "closing Global Find did not restore the real terminal focus"

echo "Rust pane search passed: ${backend}, pane-and-global=real-ghostty, navigation=physical, focus=real-pty"
