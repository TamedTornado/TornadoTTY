        sleep 0.2
        viewport_line_after="$(read_primary_clipboard)"
        [[ "${viewport_line_after}" == "${viewport_line_before}" ]] ||
            fail "background pane activation reset the Ghostty viewport"

        # Keep the real left-button drag at the first terminal row long enough
        # for Ghostty's termio selection timer to advance several rows. The
        # externally owned primary selection must then span multiple corpus
        # lines; a static drag or a Zentty-side fake cannot satisfy this.
