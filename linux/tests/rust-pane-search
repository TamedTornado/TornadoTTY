        sleep 0.3
        xdotool mousemove --window "${window_id}" 360 240 click --repeat 3 --delay 60 1
        sleep 0.2
        viewport_line_before="$(read_primary_clipboard)"
        [[ "${viewport_line_before}" =~ ^AUTOSCROLL-[0-9][0-9][0-9]$ ]] ||
            fail "ordinary vertical scroll did not expose selectable Ghostty scrollback"

