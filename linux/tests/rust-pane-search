#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
product="${ZENTTY_LINUX_BINARY:-${repo_root}/build/linux/bin/zentty-linux}"
backend="${GDK_BACKEND:-}"
log=""
state_directory=""
product_pid=""
window_id=""
clipboard_actual=""
clipboard_expected=""
clipboard_non_text=""
config_file=""
drag_source_pid=""
drag_receipt=""

# shellcheck source=linux/tests/lib/product-input
source "${repo_root}/linux/tests/lib/product-input"
# shellcheck source=linux/tests/lib/visual-evidence
# shellcheck disable=SC1091
source "${repo_root}/linux/tests/lib/visual-evidence"

fail() {
    [[ -z "${log}" || ! -f "${log}" ]] || cat "${log}" >&2
    echo "rust-pane-search: error: $*" >&2
    exit 1
}

cleanup() {
    if [[ "${product_pid}" =~ ^[1-9][0-9]*$ ]]; then
        kill -TERM "${product_pid}" 2>/dev/null || true
        wait "${product_pid}" 2>/dev/null || true
    fi
    if [[ "${drag_source_pid}" =~ ^[1-9][0-9]*$ ]]; then
        kill -TERM "${drag_source_pid}" 2>/dev/null || true
        wait "${drag_source_pid}" 2>/dev/null || true
    fi
    [[ -z "${log}" ]] || rm -f -- "${log}"
    [[ -z "${state_directory}" ]] || rm -rf -- "${state_directory}"
    [[ -z "${clipboard_actual}" ]] || rm -f -- "${clipboard_actual}"
    [[ -z "${clipboard_expected}" ]] || rm -f -- "${clipboard_expected}"
    [[ -z "${clipboard_non_text}" ]] || rm -f -- "${clipboard_non_text}"
    [[ -z "${config_file}" ]] || rm -f -- "${config_file}"
    [[ -z "${drag_receipt}" ]] || rm -f -- "${drag_receipt}"
}
trap cleanup EXIT

case "${backend}" in
    x11)
        [[ "${ZENTTY_NESTED_X11_SESSION_ID:-}" =~ ^[0-9a-f]{64}$ ]] ||
            fail "X11 search must run through linux/tests/nested-x11"
        command -v xdotool >/dev/null || fail "xdotool is required for X11 search"
        command -v xclip >/dev/null || fail "xclip is required for X11 clipboard proof"
        ;;
    wayland)
        [[ "${ZENTTY_NESTED_WAYLAND_INPUT_SESSION_ID:-}" =~ ^[0-9a-f]{64}$ ]] ||
            fail "Wayland search must run through linux/tests/nested-wayland-input"
        if [[ "${ZENTTY_NESTED_WAYLAND_OUTER_X11_INPUT:-}" == 1 ]]; then
            command -v xdotool >/dev/null || fail "xdotool is required for nested Wayland outer input"
        else
            command -v wtype >/dev/null || fail "wtype is required for Wayland search"
        fi
        command -v wl-paste >/dev/null || fail "wl-paste is required for Wayland clipboard proof"
        command -v wl-copy >/dev/null || fail "wl-copy is required for Wayland clipboard proof"
        ;;
    *) fail "GDK_BACKEND must be x11 or wayland" ;;
esac
for dependency in awk base64 cmp compare cp dirname grep identify import jq mkdir mktemp readlink seq sha256sum sleep tail wc; do
    command -v "${dependency}" >/dev/null || fail "${dependency} is required"
done
[[ -x "${product}" ]] || fail "staged product is not built: ${product}"
product="$(readlink -f -- "${product}")"
config_file="${XDG_CONFIG_HOME:?}/zentty/config.toml"
mkdir -p "$(dirname "${config_file}")"
mkdir -p "${XDG_CONFIG_HOME}/ghostty" "${XDG_CONFIG_HOME}/gtk-4.0"
cat >"${XDG_CONFIG_HOME}/ghostty/config" <<'EOF'
resize-overlay = never
cursor-opacity = 0
EOF
cat >"${XDG_CONFIG_HOME}/gtk-4.0/settings.ini" <<'EOF'
[Settings]
gtk-enable-animations=false
gtk-cursor-blink=false
EOF
cat >"${config_file}" <<'EOF'
[confirmations]
confirm_before_closing_pane = false
confirm_before_closing_window = false
confirm_before_quitting = false
EOF

uses_xdotool() {
    [[ "${backend}" == x11 || "${ZENTTY_NESTED_WAYLAND_OUTER_X11_INPUT:-}" == 1 ]]
}

press_ctrl_shift() {
    local key="$1"
    zentty_product_ctrl_shift_key "${backend}" "${key}"
}

close_current_window() {
    if [[ "${backend}" == x11 ]]; then
        # The target is destroyed on key-down, before XTest can deliver every
        # synthetic release to that XID. The owned window-closed receipt below
        # remains authoritative; clear global modifier state on the live root.
        xdotool key --window "${window_id}" ctrl+shift+w 2>/dev/null || true
        xdotool keyup Control_L Control_R Shift_L Shift_R w 2>/dev/null || true
    else
        press_ctrl_shift w
    fi
}

press_ctrl() {
    local key="$1"
    zentty_product_ctrl_key "${backend}" "${key}"
}

press_ctrl_alt_shift() {
    local key="$1"
    if uses_xdotool; then
        zentty_product_xdotool_key "ctrl+alt+shift+${key}"
    else
        wtype -M ctrl -M alt -M shift -k "${key}" -m shift -m alt -m ctrl
    fi
}

press_key() {
    local key="$1"
    zentty_product_key "${backend}" "${key}"
}

type_text() {
    local value="$1"
    zentty_product_type "${backend}" "${value}"
}

reactivate_wayland_product_without_terminal_click() {
    [[ "${backend}" == wayland &&
        "${ZENTTY_NESTED_WAYLAND_OUTER_X11_INPUT:-}" == 1 ]] || return 0
    # The controlled Weston profile places this coordinate in Zentty's
    # non-terminal title/header band. Clipboard clients that use
    # wl_data_device may otherwise leave compositor keyboard focus on their
    # transient surface, while a terminal click would destroy the real Ghostty
    # selection this journey is qualifying.
    xdotool windowfocus --sync "${ZENTTY_PRODUCT_WINDOW_ID}"
    xdotool mousemove --sync --window "${ZENTTY_PRODUCT_WINDOW_ID}" 700 180
    xdotool click 1
}

clear_text() {
    if uses_xdotool; then
        zentty_product_xdotool_key ctrl+a BackSpace
    else
        wtype -M ctrl -k a -m ctrl -k BackSpace
    fi
}

clear_global_find() {
    local cleared_before
    cleared_before="$(grep -Fc 'zentty-linux: global-find-state visible=true remembered=false selected=None total=0' "${log}" || true)"
    clear_text
    for _ in $(seq 1 160); do
        [[ "$(grep -Fc 'zentty-linux: global-find-state visible=true remembered=false selected=None total=0' "${log}" || true)" -gt "${cleared_before}" ]] && return
        sleep 0.05
    done
    fail "clearing Global Find did not publish a fresh cleared-state receipt"
}

wait_for_fixed() {
    local receipt="$1"
    local message="$2"
    for _ in $(seq 1 400); do
        grep -Fxq "${receipt}" "${log}" && return
        sleep 0.05
    done
    fail "${message}"
}

wait_for_count_greater() {
    local receipt="$1"
    local baseline="$2"
    local message="$3"
    for _ in $(seq 1 400); do
        [[ "$(grep -Fc "${receipt}" "${log}" || true)" -gt "${baseline}" ]] && return
        sleep 0.05
    done
    fail "${message}"
}

run_palette_action() {
    local query="$1"
    local action_receipt="$2"
    local expected_results="${3:-1}"
    local shown_before focus_before hidden_before query_before action_before
    shown_before="$(grep -Fxc 'zentty-linux: command-palette=shown' "${log}" || true)"
    focus_before="$(grep -Fxc 'zentty-linux: command-palette-focus=confirmed result=true' "${log}" || true)"
    query_before="$(grep -Fc "zentty-linux: command-palette=query value=\"${query}\" results=${expected_results}" "${log}" || true)"
    action_before="$(grep -Fc "${action_receipt}" "${log}" || true)"
    press_ctrl_shift p
    wait_for_count_greater 'zentty-linux: command-palette=shown' "${shown_before}" \
        "physical command-palette shortcut did not open for ${query}"
    wait_for_count_greater 'zentty-linux: command-palette-focus=confirmed result=true' \
        "${focus_before}" \
        "command palette did not focus its search entry for ${query}"
    type_text "${query}"
    wait_for_count_greater \
        "zentty-linux: command-palette=query value=\"${query}\" results=${expected_results}" \
        "${query_before}" \
        "command palette did not resolve ${query}"
    hidden_before="$(grep -Fxc 'zentty-linux: command-palette=hidden' "${log}" || true)"
    focus_before="$(grep -Fc 'zentty-linux: focus-pane pane=' "${log}" || true)"
    press_key Return
    wait_for_count_greater "${action_receipt}" "${action_before}" \
        "command palette did not execute ${query}"
    wait_for_count_greater 'zentty-linux: command-palette=hidden' "${hidden_before}" \
        "command palette did not hide after executing ${query}"
    wait_for_count_greater 'zentty-linux: focus-pane pane=' "${focus_before}" \
        "terminal focus did not settle after executing ${query}"
}

assert_standard_clipboard() {
    local expected="$1"
    printf '%s' "${expected}" >"${clipboard_expected}"
    if [[ "${backend}" == x11 ]]; then
        xclip -selection clipboard -out >"${clipboard_actual}"
    else
        wl-paste --no-newline >"${clipboard_actual}"
        reactivate_wayland_product_without_terminal_click
    fi
    cmp -s "${clipboard_expected}" "${clipboard_actual}" || {
        printf 'expected clipboard sha256=%s bytes=%s\n' \
            "$(sha256sum "${clipboard_expected}" | awk '{print $1}')" \
            "$(wc -c <"${clipboard_expected}")" >&2
        printf 'actual clipboard sha256=%s bytes=%s\n' \
            "$(sha256sum "${clipboard_actual}" | awk '{print $1}')" \
            "$(wc -c <"${clipboard_actual}")" >&2
        fail "external ${backend} standard clipboard bytes differed"
    }
}

assert_primary_clipboard() {
    local expected="$1"
    printf '%s' "${expected}" >"${clipboard_expected}"
    if [[ "${backend}" == x11 ]]; then
        xclip -selection primary -out >"${clipboard_actual}"
    else
        wl-paste --primary --no-newline >"${clipboard_actual}"
        reactivate_wayland_product_without_terminal_click
    fi
    cmp -s "${clipboard_expected}" "${clipboard_actual}" || {
        printf 'expected primary clipboard sha256=%s bytes=%s\n' \
            "$(sha256sum "${clipboard_expected}" | awk '{print $1}')" \
            "$(wc -c <"${clipboard_expected}")" >&2
        printf 'actual primary clipboard sha256=%s bytes=%s\n' \
            "$(sha256sum "${clipboard_actual}" | awk '{print $1}')" \
            "$(wc -c <"${clipboard_actual}")" >&2
        fail "external ${backend} primary clipboard bytes differed"
    }
}

set_primary_clipboard() {
    local value="$1"
    if [[ "${backend}" == x11 ]]; then
        printf '%s' "${value}" | xclip -selection primary -in
        for _ in $(seq 1 200); do
            [[ "$(xclip -selection primary -out 2>/dev/null || true)" == "${value}" ]] && return
            sleep 0.05
        done
    else
        printf '%s' "${value}" | wl-copy --primary
        for _ in $(seq 1 200); do
            [[ "$(wl-paste --primary --no-newline 2>/dev/null || true)" == "${value}" ]] && return
            sleep 0.05
        done
    fi
    fail "${backend} primary clipboard owner did not publish exact bytes"
}

read_primary_clipboard() {
    if [[ "${backend}" == x11 ]]; then
        xclip -selection primary -out
    else
        wl-paste --primary --no-newline
        reactivate_wayland_product_without_terminal_click
    fi
}

set_standard_clipboard() {
    local value="$1"
    if [[ "${backend}" == x11 ]]; then
        printf '%s' "${value}" | xclip -selection clipboard -in
    else
        printf '%s' "${value}" | wl-copy
        reactivate_wayland_product_without_terminal_click
    fi
}

set_non_text_clipboard() {
    if [[ "${backend}" == x11 ]]; then
        xclip -selection clipboard -target image/png -in <"${clipboard_non_text}"
    else
        wl-copy --type image/png <"${clipboard_non_text}"
        reactivate_wayland_product_without_terminal_click
    fi
}

assert_non_text_clipboard() {
    if [[ "${backend}" == x11 ]]; then
        xclip -selection clipboard -target image/png -out >"${clipboard_actual}"
    else
        wl-paste --type image/png >"${clipboard_actual}"
        reactivate_wayland_product_without_terminal_click
    fi
    cmp -s "${clipboard_non_text}" "${clipboard_actual}" ||
        fail "no-selection copy replaced the existing ${backend} non-text clipboard owner"
}

log="$(mktemp)"
state_directory="$(mktemp -d)"
mkdir -p "${state_directory}/working-directory"
clipboard_actual="$(mktemp)"
clipboard_expected="$(mktemp)"
clipboard_non_text="$(mktemp)"
printf '%s' \
    'iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNk+A8AAQUBAScY42YAAAAASUVORK5CYII=' |
    base64 --decode >"${clipboard_non_text}"
config_file="${XDG_CONFIG_HOME:?}/zentty/config.toml"
mkdir -p "$(dirname "${config_file}")"
cat >"${config_file}" <<'EOF'
[confirmations]
confirm_before_closing_pane = false
confirm_before_closing_window = false
confirm_before_quitting = false

[clipboard]
always_clean_copies = true
EOF
if [[ "${ZENTTY_TERMINAL_INPUT_ONLY:-false}" == true ]]; then
    # File-list drops intentionally include a trailing newline and therefore
    # exercise Ghostty's unsafe-paste dialog by default. That dialog is owned
    # and tested upstream; disable it only in this insertion/routing scenario
    # so compositor automation can observe the resulting PTY bytes directly.
    mkdir -p "${XDG_CONFIG_HOME}/ghostty"
    printf 'clipboard-paste-protection = false\n' >"${XDG_CONFIG_HOME}/ghostty/config.ghostty"
fi
product_environment=(GDK_SCALE=1 GDK_DPI_SCALE=1)
if [[ "${backend}" == wayland ]]; then
    # Evidence must represent the settled real GTK state rather than a
    # scheduler-dependent frame of its focus transition. This is scoped to
    # the Wayland visual profile; X11 retains its qualified interaction path.
    mkdir -p "${XDG_CONFIG_HOME}/gtk-4.0"
    cat >"${XDG_CONFIG_HOME}/gtk-4.0/settings.ini" <<'EOF'
[Settings]
gtk-enable-animations=false
EOF
    product_environment+=(GSK_RENDERER=cairo)
fi
# The single quotes intentionally defer PTY-child expansion.
# shellcheck disable=SC2016
(
    cd "${state_directory}/working-directory"
    exec env "${product_environment[@]}" \
    "${product}" \
    --command 'printf "https://example.com/reset?token=noisegamma&utm_source=mail"; while IFS= read -r line; do case "$line" in markdown) printf "\033[2J\033[3J\033[H## Clipboard Notes\n\nOne wrapped\nparagraph"; printf "\033]2;focus:markdown-ready\a" ;; clipboard-second) printf "\033[2J\033[3J\033[Hhttps://second.example/reset?utm_source=other-window"; printf "\033]2;focus:clipboard-second-ready\a" ;; search-corpus) printf "\033[2J\033[3J\033[Hselectable alpha\nnoise\nselectable beta\nselectable gamma\n"; printf "\033]2;focus:search-ready\a" ;; terminal-input-corpus) printf "\033[2J\033[3J\033[H"; for row in $(seq -w 1 160); do printf "AUTOSCROLL-%s\n" "$row"; done; printf "\033]2;focus:terminal-input-ready\a" ;; *) printf "\033]2;focus:%s\a" "$line" ;; esac; done' \
    --state-directory "${state_directory}" \
    --no-session-restore
) >"${log}" 2>&1 &
product_pid=$!

wait_for_fixed 'zentty-linux: terminal-ready-pane=pane-1' \
    "real Ghostty search surface did not initialize"
wait_for_fixed \
    "zentty-linux: config-loaded path=${config_file} automatic-clean-copy=true" \
    "the single process config owner did not load automatic Clean Copy"
for _ in $(seq 1 160); do
    grep -Fq 'zentty-linux: search-state pane=pane-1 active=false total=None selected=None' "${log}" && break
    sleep 0.05
done
grep -Fq 'zentty-linux: search-state pane=pane-1 active=false total=None selected=None' "${log}" ||
    fail "Ghostty search overlay was not observed"

if [[ "${backend}" == x11 ]]; then
    window_id="$(zentty_product_find_x11_window "${product_pid}" 160)" ||
        fail "real mapped X11 Zentty window did not appear"
    xdotool windowfocus --sync "${window_id}"
else
    if [[ "${ZENTTY_NESTED_WAYLAND_OUTER_X11_INPUT:-}" == 1 ]]; then
        window_id="${ZENTTY_NESTED_WAYLAND_OUTER_X11_WINDOW:?}"
        xdotool windowfocus --sync "${window_id}"
        xdotool mousemove --sync --window "${window_id}" 700 350 click 1
    else
        # Zentty is the only client in the private Cage session and is focused
        # when its first real terminal reports ready.
        sleep 0.2
    fi
fi
if uses_xdotool; then
    ZENTTY_PRODUCT_WINDOW_ID="${window_id}"
    export ZENTTY_PRODUCT_WINDOW_ID
fi

if [[ "${backend}" == wayland ]]; then
    zentty_product_establish_palette_input "${backend}" "${log}" ||
        fail "controlled Wayland compositor did not establish physical palette input"
fi

if [[ "${ZENTTY_SIDEBAR_RESIZE_ONLY:-false}" == true ]]; then
    [[ "${backend}" == wayland && "${ZENTTY_NESTED_WAYLAND_OUTER_X11_INPUT:-}" == 1 ]] ||
        fail "Wayland sidebar resize requires the controlled outer-pointer compositor profile"
    type_text sidebar-resize-before
    press_key Return
    wait_for_fixed 'zentty-linux: title-pane=pane-1 value=focus:sidebar-resize-before' \
        "pre-resize input did not reach the real PTY"

    resize_persist_before="$(grep -Fc 'zentty-linux: sidebar-persist origin=resize ' "${log}" || true)"
    xdotool mousemove --sync --window "${window_id}" 293 400
    sleep 0.2
    xdotool mousedown 1
    sleep 0.2
    xdotool mousemove --sync --window "${window_id}" 373 400
    sleep 0.2
    xdotool mouseup 1
    sleep 0.1
    dragged_sidebar_width="$(grep -F 'zentty-linux: sidebar-width=' "${log}" | tail -1 | cut -d= -f2)"
    if [[ ! "${dragged_sidebar_width:-}" =~ ^[0-9]+$ ]] ||
        (( dragged_sidebar_width < 325 || dragged_sidebar_width > 335 )); then
        fail "real Wayland pointer drag did not resize the sidebar"
    fi
    wait_for_count_greater 'zentty-linux: sidebar-persist origin=resize ' \
        "${resize_persist_before}" \
        "Wayland divider width did not persist through ConfigStore"
    grep -Eq "^width = ${dragged_sidebar_width}$" "${config_file}" ||
        fail "persisted Wayland sidebar width did not equal the live allocation"

    sidebar_resize_image="${state_directory}/sidebar-resize-wayland.png"
    zentty_product_wait_for_log "${log}" \
        'zentty-linux: project-icon-projected owner=window-chrome fallback=folder-symbolic decoded=true' \
        "Wayland sidebar resize chrome did not settle its project-icon fallback" ||
        fail "Wayland sidebar resize project icon missing"
    zentty_visual_capture_stable "${sidebar_resize_image}" \
        import -silent -window "${window_id}" ||
        fail "Wayland sidebar resize compositor frame did not settle"
    zentty_visual_publish sidebar-resize-wayland linux/tests/rust-pane-search \
        "${sidebar_resize_image}" - ||
        fail "sidebar-resize-wayland visual evidence did not match"

    hidden_before="$(grep -Fc 'zentty-linux: sidebar-visibility=hidden' "${log}" || true)"
    press_ctrl s
    wait_for_count_greater 'zentty-linux: sidebar-visibility=hidden' "${hidden_before}" \
        "Wayland sidebar did not hide after resize"
    pinned_before="$(grep -Fc 'zentty-linux: sidebar-visibility=pinned-open' "${log}" || true)"
    press_ctrl s
    wait_for_count_greater 'zentty-linux: sidebar-visibility=pinned-open' "${pinned_before}" \
        "Wayland sidebar did not return to pinned mode after resize"
    for _ in $(seq 1 100); do
        [[ "$(grep -F 'zentty-linux: sidebar-width=' "${log}" | tail -1)" == \
            "zentty-linux: sidebar-width=${dragged_sidebar_width}" ]] && break
        sleep 0.05
    done
    [[ "$(grep -F 'zentty-linux: sidebar-width=' "${log}" | tail -1)" == \
        "zentty-linux: sidebar-width=${dragged_sidebar_width}" ]] ||
        fail "hide/show did not preserve the exact Wayland sidebar width"

    zentty_product_move_pointer_to_terminal wayland ||
        fail "controlled Wayland pointer did not return to the terminal"
    xdotool click 1
    type_text sidebar-resize-after
    press_key Return
    wait_for_fixed 'zentty-linux: title-pane=pane-1 value=focus:sidebar-resize-after' \
        "post-resize input did not return to the same real PTY"
    [[ "$(grep -Fc 'info(opengl): loaded OpenGL' "${log}" || true)" -eq 1 ]] ||
        fail "Wayland sidebar resize recreated the Ghostty renderer"
    [[ "$(grep -Fc 'info(io_exec): started subcommand' "${log}" || true)" -eq 1 ]] ||
        fail "Wayland sidebar resize restarted the PTY child"

    zentty_product_close_window wayland
    set +e
    timeout --foreground --kill-after=2s 7s tail --pid="${product_pid}" -f /dev/null
    wait_status=$?
    wait "${product_pid}"
    product_status=$?
    set -e
    product_pid=""
    (( wait_status == 0 && product_status == 0 )) ||
        fail "Wayland sidebar resize profile did not close cleanly"
    echo "Rust sidebar resize passed: wayland, width=${dragged_sidebar_width}, real-pointer=true, live-pty-preserved=true"
    exit 0
fi

if [[ "${ZENTTY_TERMINAL_INPUT_ONLY:-false}" == true ]]; then
    uses_xdotool || fail "terminal interaction proof requires controlled pointer input"
    terminal_input_scenario="${ZENTTY_TERMINAL_INPUT_SCENARIO:-all}"
    case "${terminal_input_scenario}" in
        all | primary-scroll | local-drop) ;;
        *) fail "unknown terminal input scenario: ${terminal_input_scenario}" ;;
    esac
    ZENTTY_PRODUCT_WINDOW_ID="${window_id}"
    export ZENTTY_PRODUCT_WINDOW_ID

    # GTK's primary-selection owner is independent of the ordinary clipboard.
    # Drive a real middle button through the compositor and require the bytes
    # to emerge from the real PTY child, not an application-side callback.
    if [[ "${terminal_input_scenario}" != local-drop ]]; then
        set_primary_clipboard 'middle-click-real-pty'
        xdotool mousemove --sync --window "${window_id}" 700 350 click 2
        press_key Return
        wait_for_fixed 'zentty-linux: title-pane=pane-1 value=focus:middle-click-real-pty' \
            "middle-click did not paste the compositor primary selection through Ghostty"
    fi

    # A separate GTK application offers an actual GDK text/uri-list drag. The
    # local pane must leave ownership with Ghostty, preserve shell escaping,
    # and never enter Zentty's remote-transfer policy.
    if [[ "${terminal_input_scenario}" != primary-scroll ]]; then
        local_drop_path="${state_directory}/local drop\$(proof).txt"
        printf 'local drop bytes\n' >"${local_drop_path}"
        drag_source="${repo_root}/target/release-safe/file_drag_source"
        [[ -x "${drag_source}" ]] || fail "real GTK file drag source is missing: ${drag_source}"
        drag_receipt="${state_directory}/file-drag-source.ready"
        "${drag_source}" "${local_drop_path}" "${drag_receipt}" >>"${log}" 2>&1 &
        drag_source_pid=$!
        for _ in $(seq 1 250); do
            [[ -s "${drag_receipt}" ]] && break
            kill -0 "${drag_source_pid}" 2>/dev/null || fail "real GTK drag source exited before readiness"
            sleep 0.02
        done
        [[ -s "${drag_receipt}" ]] || fail "real GTK drag source did not become ready"
        if [[ "${backend}" == x11 ]]; then
            zentty_product_drag_from_x11_window 'Zentty File Drag Source' "${drag_receipt}" ||
                fail "physical X11 local-file drag could not be completed"
        else
            ZENTTY_NESTED_WAYLAND_DRAG_TARGET_X=800 \
                ZENTTY_NESTED_WAYLAND_DRAG_TARGET_Y=500 \
                zentty_product_drag_in_nested_wayland "${drag_receipt}" ||
                fail "physical nested-Wayland local-file drag could not be completed"
        fi
        escaped_drop_path="${state_directory}/local\\ drop\\\$\\(proof\\).txt"
        wait_for_fixed "zentty-linux: title-pane=pane-1 value=focus:${escaped_drop_path}" \
            "local file drop did not insert Ghostty's shell-escaped path into the PTY"
        ! grep -Fq 'zentty-linux: remote-paste pane=pane-1' "${log}" ||
            fail "local file drop incorrectly entered remote-transfer policy"
        grep -F 'drag-begin:' "${drag_receipt}" | grep -Fq 'text/uri-list' ||
            fail "desktop drag did not advertise its real URI-list format"
        kill -TERM "${drag_source_pid}" 2>/dev/null || true
        wait "${drag_source_pid}" 2>/dev/null || true
        drag_source_pid=""
    fi

    # Populate real scrollback, scroll it with ordinary vertical wheel events,
    # and select one visible line. If Zentty's capture controller steals those
    # events, the selected line will not be from the corpus. Keep the pane in
    # the background, return, and select the same screen position again: exact
    # primary-selection bytes prove that the native viewport did not reset.
    if [[ "${terminal_input_scenario}" != local-drop ]]; then
        xdotool windowfocus --sync "${window_id}"
        type_text terminal-input-corpus
        press_key Return
        wait_for_fixed 'zentty-linux: title-pane=pane-1 value=focus:terminal-input-ready' \
            "real PTY did not publish the terminal input corpus"
