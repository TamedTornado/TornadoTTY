#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
product="${ZENTTY_LINUX_BINARY:-${repo_root}/build/linux/bin/zentty-linux}"
backend="${GDK_BACKEND:-}"
scenario="${ZENTTY_AGENT_IPC_SCENARIO:-full}"
log=""
state_directory=""
product_pid=""
server_pid=""
fake_bin=""
real_gemini_bin=""
private_home=""
start_receipt=""
model_log=""
amp_audit_receipt=""
burst_gate=""
burst_receipt=""
burst_finish_gate=""
actor="${repo_root}/linux/tests/fixtures/controlled-agent"
# shellcheck disable=SC1091
source "${repo_root}/linux/tests/lib/product-input"

fail() {
    [[ -z "${log}" || ! -f "${log}" ]] || cat "${log}" >&2
    if [[ -n "${start_receipt}" && -f "${start_receipt}" ]]; then
        sed -E 's#socket:[^ ]+ token:[^ ]+#socket:<redacted> token:<redacted>#' \
            "${start_receipt}" >&2
    fi
    [[ -z "${amp_audit_receipt}" || ! -f "${amp_audit_receipt}" ]] ||
        cat "${amp_audit_receipt}" >&2
    echo "rust-agent-ipc: error: $*" >&2
    exit 1
}

terminate_owned_process() {
    local pid="$1"
    local label="$2"
    local status

    [[ "${pid}" =~ ^[1-9][0-9]*$ ]] || return
    if zentty_process_is_running "${pid}"; then
        kill -TERM "${pid}" 2>/dev/null || true
    fi
    status=0
    zentty_wait_for_owned_process "${pid}" "${label}" 20 0.05 || status=$?
    if (( status == 124 )); then
        kill -KILL "${pid}" 2>/dev/null || true
        zentty_wait_for_owned_process "${pid}" "${label} after SIGKILL" 20 0.05 || true
    fi
}

wait_for_product() {
    local label="$1"
    local attempts="${2:-200}"

    zentty_wait_for_owned_process "${product_pid}" "${label}" "${attempts}" 0.05 ||
        fail "${label} failed or missed its exit deadline"
    product_pid=""
}

wait_for_server() {
    local label="$1"
    local attempts="${2:-200}"

    if ! zentty_wait_for_owned_process "${server_pid}" "${label}" "${attempts}" 0.05; then
        [[ -z "${model_log}" || ! -f "${model_log}" ]] || cat "${model_log}" >&2
        fail "${label} failed or missed its exit deadline"
    fi
    server_pid=""
}

cleanup() {
    if [[ "${product_pid}" =~ ^[1-9][0-9]*$ ]]; then
        terminate_owned_process "${product_pid}" "cleanup product"
    fi
    if [[ "${server_pid}" =~ ^[1-9][0-9]*$ ]]; then
        terminate_owned_process "${server_pid}" "cleanup controlled endpoint"
    fi
    [[ -z "${log}" ]] || rm -f -- "${log}"
    [[ -z "${state_directory}" ]] || rm -rf -- "${state_directory}"
    [[ -z "${fake_bin}" ]] || rm -rf -- "${fake_bin}"
    [[ -z "${private_home}" ]] || rm -rf -- "${private_home}"
    [[ -z "${start_receipt}" ]] || rm -f -- "${start_receipt}"
    [[ -z "${amp_audit_receipt}" ]] || rm -f -- "${amp_audit_receipt}"
    [[ -z "${burst_gate}" ]] || rm -f -- "${burst_gate}"
    [[ -z "${burst_receipt}" ]] || rm -f -- "${burst_receipt}"
    [[ -z "${burst_finish_gate}" ]] || rm -f -- "${burst_finish_gate}"
}
trap cleanup EXIT

case "${scenario}" in
    full | installed-gemini | codex-review-routing | copilot-presentation | amp-plugin | cursor-hooks | droid-hooks | kimi-hooks | remaining-hooks | event-coalescing) ;;
    *) fail "ZENTTY_AGENT_IPC_SCENARIO must be full, installed-gemini, codex-review-routing, copilot-presentation, amp-plugin, cursor-hooks, droid-hooks, kimi-hooks, remaining-hooks, or event-coalescing" ;;
esac

case "${backend}" in
    x11)
        [[ "${ZENTTY_NESTED_X11_SESSION_ID:-}" =~ ^[0-9a-f]{64}$ ]] ||
            fail "X11 agent IPC must run through linux/tests/nested-x11"
        ;;
    wayland)
        if [[ ! "${ZENTTY_NESTED_WAYLAND_SESSION_ID:-}" =~ ^[0-9a-f]{64}$ &&
            ! "${ZENTTY_NESTED_WAYLAND_INPUT_SESSION_ID:-}" =~ ^[0-9a-f]{64}$ ]]; then
            fail "Wayland agent IPC must run through a controlled Wayland harness"
        fi
        ;;
    *) fail "GDK_BACKEND must be x11 or wayland" ;;
esac
case "${ZENTTY_REQUIRE_REAL_GEMINI:-false}" in
    true)
        [[ -n "${ZENTTY_REAL_GEMINI_BIN:-}" ]] ||
            fail "required real Gemini executable must be selected explicitly"
        [[ -n "${ZENTTY_EXPECTED_GEMINI_VERSION:-}" ]] ||
            ZENTTY_EXPECTED_GEMINI_VERSION=0.53.0
        export ZENTTY_EXPECTED_GEMINI_VERSION
        ;;
    false) ;;
    *) fail "ZENTTY_REQUIRE_REAL_GEMINI must be true or false" ;;
esac
if [[ "${scenario}" == installed-gemini && "${ZENTTY_REQUIRE_REAL_GEMINI:-false}" != true ]]; then
    fail "installed-gemini scenario requires the reviewed real Gemini prerequisite"
fi
for dependency in cut date find grep jq mkfifo mktemp pgrep ps sed sha256sum sleep stat wc; do
    command -v "${dependency}" >/dev/null || fail "${dependency} is required"
done
[[ -x "${product}" ]] || fail "staged product is not built: ${product}"
[[ -x "${actor}" ]] || fail "controlled agent actor is missing: ${actor}"
zentty_product_disable_lifecycle_confirmations
helper="$(dirname "${product}")/tornadotty-cli"
if [[ ! -x "${helper}" ]]; then
    helper="$(dirname "${product}")/zentty"
fi
[[ -x "${helper}" ]] || fail "product agent helper is not built: ${helper}"
wrapper_root="$(cd "$(dirname "${product}")/.." && pwd)/libexec/zentty/agent-wrappers"
[[ -x "${wrapper_root}/codex/codex" ]] || fail "staged Codex wrapper is missing"
[[ -x "${wrapper_root}/claude/claude" ]] || fail "staged Claude wrapper is missing"
[[ -x "${wrapper_root}/gemini/gemini" ]] || fail "staged Gemini wrapper is missing"
for wrapper in \
    copilot/copilot opencode/opencode pi/pi omp/omp small-harness/small-harness \
    cursor/cursor-agent droid/droid kimi/kimi grok/grok agy/agy hermes/hermes vibe/vibe; do
    [[ -x "${wrapper_root}/${wrapper}" ]] || fail "staged ${wrapper} wrapper is missing"
done

qualify_staged_integration_cli() (
    local home config
    home="$(mktemp -d)"
    trap 'rm -rf -- "${home}"' EXIT
    config="${home}/.cursor/hooks.json"
    mkdir -p "$(dirname "${config}")"
    printf '%s\n' '{"version":1,"hooks":{"sessionStart":[{"command":"user-owned"}]}}' \
        >"${config}"

    HOME="${home}" XDG_CONFIG_HOME="${home}/xdg-config" \
        "${helper}" install cursor-hooks >/dev/null
    jq -e --arg helper "${helper}" '
        any(.hooks.sessionStart[]; .command == "user-owned") and
        any(.hooks.sessionStart[];
            (.command | contains($helper) and contains("ipc agent-event --adapter=cursor")))
    ' "${config}" >/dev/null || fail "staged CLI did not install its owned Cursor hook"

    HOME="${home}" XDG_CONFIG_HOME="${home}/xdg-config" \
        "${helper}" uninstall cursor-hooks >/dev/null
    jq -e '
        .hooks.sessionStart == [{"command":"user-owned"}] and
        ([.hooks[][]?.command // empty] | all(contains("zentty ipc") | not))
    ' "${config}" >/dev/null ||
        fail "staged CLI uninstall damaged user hooks or retained its own hook"
)

qualify_staged_integration_cli

fake_bin="$(mktemp -d)"
ln -s "${actor}" "${fake_bin}/codex"
ln -s "${actor}" "${fake_bin}/claude"
ln -s "${actor}" "${fake_bin}/gemini"
ln -s "${actor}" "${fake_bin}/plain-title"
for binary in amp copilot opencode pi omp small-harness cursor-agent droid kimi grok agy hermes vibe; do
    ln -s "${actor}" "${fake_bin}/${binary}"
done

run_adapter() {
    local name="$1"
    local command="$2"
    local profile="$3"
    local expected="$4"
    local forbidden="${5:-}"
    local socket=""
    local finish_gate=""
    local kimi_question_gate=""
    local kimi_approval_gate=""
    local codex_permission_gate=""

    log="$(mktemp)"
    start_receipt="$(mktemp)"
    state_directory="$(mktemp -d)"
    private_home="$(mktemp -d)"
    XDG_CONFIG_HOME="${private_home}/xdg-config" \
        zentty_product_disable_lifecycle_confirmations
    if [[ "${name}" == cursor || "${name}" == droid || "${name}" == kimi ||
        "${name}" == grok || "${name}" == agy || "${name}" == hermes ||
        "${name}" == vibe ]]; then
        finish_gate="${state_directory}/controlled-agent-finish.fifo"
        mkfifo "${finish_gate}"
    fi
    if [[ "${name}" == kimi ]]; then
        kimi_question_gate="${state_directory}/kimi-question.fifo"
        kimi_approval_gate="${state_directory}/kimi-approval.fifo"
        mkfifo "${kimi_question_gate}" "${kimi_approval_gate}"
    fi
    if [[ "${profile}" == codex-permission ]]; then
        codex_permission_gate="${state_directory}/codex-permission.fifo"
        mkfifo "${codex_permission_gate}"
    fi
    PATH="${fake_bin}:${PATH}" GDK_SCALE=1 GDK_DPI_SCALE=1 \
        HOME="${private_home}" XDG_CONFIG_HOME="${private_home}/xdg-config" \
        ZENTTY_CLI_DEBUG=1 \
        ZENTTY_CONTROLLED_AGENT_START_RECEIPT="${start_receipt}" \
        ZENTTY_CONTROLLED_AGENT_FINISH_GATE="${finish_gate}" \
        ZENTTY_CONTROLLED_CODEX_PERMISSION_GATE="${codex_permission_gate}" \
        ZENTTY_CONTROLLED_AGENT_STATE_DIRECTORY="${state_directory}" \
        ZENTTY_CONTROLLED_AGENT_PROFILE="${profile}" \
        "${product}" \
        --command "${command}" \
        --state-directory "${state_directory}" \
        --no-session-restore >"${log}" 2>&1 &
    product_pid=$!

    if [[ "${profile}" == codex-permission ]]; then
        for _ in {1..600}; do
            grep -Fq 'permission-request-emitted' "${start_receipt}" 2>/dev/null && break
            sleep 0.05
        done
        grep -Fq 'permission-request-emitted' "${start_receipt}" 2>/dev/null ||
            fail "controlled Codex did not emit its pre-policy PermissionRequest"
        zentty_product_wait_for_log "${log}" \
            'sidebar-agent-status pane=pane-1 phase=Running interaction=None attention=false' \
            "Codex did not remain running while its approval reviewer was unresolved" 600
        if grep -Fq 'kind=agent.needs-input session=codex-e2e' "${log}" ||
            grep -Fq 'sidebar-agent-status pane=pane-1 phase=NeedsInput' "${log}" ||
            grep -Fq 'desktop-attention id=' "${log}"; then
            fail "pre-policy Codex PermissionRequest incorrectly escaped as human attention"
        fi
        printf 'route-review-to-user\n' >"${codex_permission_gate}"
    fi

    if [[ "${name}" == kimi ]]; then
        zentty_product_wait_for_log "${log}" \
            'sidebar-agent-status pane=pane-1 phase=NeedsInput interaction=Question attention=true' \
            "Kimi question did not reach visible sidebar presentation" 600
        printf 'observed\n' >"${kimi_question_gate}"
        zentty_product_wait_for_log "${log}" \
            'sidebar-agent-status pane=pane-1 phase=NeedsInput interaction=Approval attention=true' \
            "Kimi approval did not reach visible sidebar presentation" 600
        printf 'observed\n' >"${kimi_approval_gate}"
    fi

    for _ in {1..600}; do
        grep -Fq "completed pid:" "${start_receipt}" 2>/dev/null &&
            grep -Fq "profile:${profile}" "${start_receipt}" 2>/dev/null && break
        sleep 0.05
    done
    if ! grep -Fq "completed pid:" "${start_receipt}" 2>/dev/null ||
        ! grep -Fq "profile:${profile}" "${start_receipt}" 2>/dev/null; then
        cat "${start_receipt}" >>"${log}"
        fail "${name} controlled child did not finish emitting its real lifecycle"
    fi
    for _ in {1..200}; do
        grep -Fq "${expected}" "${log}" && break
        sleep 0.05
    done
    if ! grep -Fq 'zentty-linux: agent-event pane=pane-1 worklane=worklane-1' "${log}"; then
        cat "${start_receipt}" >>"${log}"
        fail "${name} terminal child did not deliver an authenticated event"
    fi
    grep -Fq "${expected}" "${log}" ||
        fail "${name} event was not reduced and rendered as an attention state"
    if [[ -n "${forbidden}" ]] && grep -Fq "${forbidden}" "${log}"; then
        fail "${name} rendered forbidden stale state: ${forbidden}"
    fi
    if [[ "${name}" == opencode ]]; then
        local overlay
        overlay="$(sed -n 's/^opencode-config://p' "${start_receipt}" | tail -1)"
        [[ -d "${overlay}" ]] || fail "OpenCode did not receive its real managed overlay"
        [[ "$(stat -c '%a' "${overlay}")" == 700 ]] ||
            fail "OpenCode managed overlay was not private"
        jq -e '.theme == "zentty-synced"' "${overlay}/tui.json" >/dev/null ||
            fail "OpenCode managed overlay did not select the synchronized terminal theme"
        jq -e '."$schema" == "https://opencode.ai/theme.json" and (.theme.background.dark | startswith("#"))' \
            "${overlay}/themes/zentty-synced.json" >/dev/null ||
            fail "OpenCode synchronized theme did not contain the real terminal palette"
        [[ "$(stat -c '%a' "${overlay}/themes/zentty-synced.json")" == 600 ]] ||
            fail "OpenCode synchronized theme was not private"
    fi
    if [[ "${name}" == cursor ]]; then
        grep -Fq 'cursor-hooks:10' "${start_receipt}" ||
            fail "Cursor controlled child did not audit all generated hooks"
        grep -Fq 'cursor-negative-control:rejected' "${start_receipt}" ||
            fail "Cursor controlled child did not reject the bad pane token"
        grep -Fq 'kind=agent.running session=123e4567-e89b-12d3-a456-426614174000' "${log}" ||
            fail "Cursor Running event did not cross the authenticated product boundary"
        grep -Fq 'kind=task.snapshot session=123e4567-e89b-12d3-a456-426614174000' "${log}" ||
            fail "Cursor merged TodoWrite snapshot did not cross the authenticated product boundary"
    fi
    if [[ "${name}" == droid ]]; then
        grep -Fq 'droid-hooks:8' "${start_receipt}" ||
            fail "Droid controlled child did not audit all installed hooks"
        grep -Fq 'droid-negative-control:rejected' "${start_receipt}" ||
            fail "Droid controlled child did not reject the bad pane token"
        grep -Fq 'kind=agent.needs-input session=session.safe:droid-42' "${log}" ||
            fail "Droid decision did not cross the authenticated product boundary"
        grep -Fq 'kind=task.progress session=session.safe:droid-42' "${log}" ||
            fail "Droid TodoWrite progress did not cross the authenticated product boundary"
        grep -Fq 'kind=task.delta session=session.safe:droid-42' "${log}" ||
            fail "Droid anonymous subagent counter did not cross the authenticated product boundary"
    fi
    if [[ "${name}" == kimi ]]; then
        local kimi_session="session_a8098c1a-3a71-4e50-b36b-f17ab79e6a90"
        [[ "${profile}" == kimi-legacy-hooks ]] &&
            kimi_session="a8098c1a-3a71-4e50-b36b-f17ab79e6a90"
        grep -Fq "${profile}:7" "${start_receipt}" ||
            fail "Kimi controlled child did not audit all installed hooks"
        grep -Fq 'kimi-negative-control:rejected' "${start_receipt}" ||
            fail "Kimi controlled child did not reject the bad pane token"
        grep -Fq "kind=agent.needs-input session=${kimi_session}" "${log}" ||
            fail "Kimi input events did not cross the authenticated product boundary"
        grep -Fq 'interaction=Question attention=true' "${log}" ||
            fail "Kimi question did not reach visible sidebar presentation"
        grep -Fq 'interaction=Approval attention=true' "${log}" ||
            fail "Kimi approval did not reach visible sidebar presentation"
    fi
    if [[ "${name}" == grok ]]; then
        grep -Fq 'grok-hooks:9' "${start_receipt}" ||
            fail "Grok controlled child did not audit all installed hooks"
    fi
    if [[ "${name}" == agy ]]; then
        grep -Fq 'agy-hooks:8' "${start_receipt}" ||
            fail "Antigravity controlled child did not audit all installed hooks"
    fi
    if [[ "${name}" == hermes ]]; then
        grep -Fq 'hermes-hooks:10' "${start_receipt}" ||
            fail "Hermes controlled child did not audit all installed hooks"
        for phase in Running NeedsInput Idle; do
            grep -Fq "zentty-linux: sidebar-agent-status pane=pane-1 phase=${phase}" "${log}" ||
                fail "Hermes PTY title/hook lifecycle did not render ${phase}"
        done
    fi
    if [[ "${name}" == vibe ]]; then
        grep -Fq 'vibe-hooks:3' "${start_receipt}" ||
            fail "Vibe controlled child did not audit all installed hooks"
    fi

    socket="$(sed -n 's/^zentty-linux: agent-runtime socket=//p' "${log}" | head -1)"
    [[ -S "${socket}" ]] || fail "private product socket was not live during ${name}"
    [[ "$(stat -c '%a' "${socket}")" == 600 ]] || fail "product socket mode was not 0600"
    [[ "$(stat -c '%a' "$(dirname "${socket}")")" == 700 ]] ||
        fail "product socket directory mode was not 0700"

    if [[ "${name}" == cursor || "${name}" == droid || "${name}" == kimi ||
        "${name}" == grok || "${name}" == agy || "${name}" == hermes ||
        "${name}" == vibe ]]; then
        zentty_product_prepare_input "${backend}" "${log}"
        zentty_product_close_window "${backend}"
    fi
    wait_for_product "${name} product run" 200
    [[ ! -e "${socket}" ]] || fail "${name} product left its agent socket behind"
    [[ ! -e "$(dirname "${socket}")" ]] ||
        fail "${name} product left its private runtime directory behind"
    if [[ "${name}" == cursor ]]; then
        jq -e '
            .restoreDraftWindows[0].paneDrafts[0] |
            .toolName == "Cursor" and
            .sessionID == "123e4567-e89b-12d3-a456-426614174000" and
            (.workingDirectory | type == "string" and length > 0)
        ' "${state_directory}/restore-snapshot.json" >/dev/null ||
            fail "Cursor UUID and working directory were not durable restore state"
    fi
    if [[ "${name}" == droid ]]; then
        jq -e '
            .restoreDraftWindows[0].paneDrafts[0] |
            .toolName == "Droid" and
            .sessionID == "session.safe:droid-42" and
            (.workingDirectory | type == "string" and length > 0)
        ' "${state_directory}/restore-snapshot.json" >/dev/null ||
            fail "Droid session and working directory were not durable restore state"
    fi
    if [[ "${name}" == kimi ]]; then
        local kimi_session="session_a8098c1a-3a71-4e50-b36b-f17ab79e6a90"
        [[ "${profile}" == kimi-legacy-hooks ]] &&
            kimi_session="a8098c1a-3a71-4e50-b36b-f17ab79e6a90"
        jq -e --arg session "${kimi_session}" '
            .restoreDraftWindows[0].paneDrafts[0] |
            .toolName == "Kimi" and
            .sessionID == $session and
            (.workingDirectory | type == "string" and length > 0)
        ' "${state_directory}/restore-snapshot.json" >/dev/null ||
            fail "Kimi modern session and working directory were not durable restore state"
    fi
    if [[ "${name}" == grok || "${name}" == agy || "${name}" == hermes ||
        "${name}" == vibe ]]; then
        local expected_tool expected_session
        case "${name}" in
            grok) expected_tool=Grok; expected_session=grok-e2e ;;
            agy) expected_tool=Antigravity; expected_session=agy-e2e ;;
            hermes) expected_tool='Hermes Agent'; expected_session=hermes-e2e ;;
            vibe) expected_tool='Mistral Vibe'; expected_session=vibe-e2e ;;
        esac
        jq -e --arg tool "${expected_tool}" --arg session "${expected_session}" '
            .restoreDraftWindows[0].paneDrafts[0] |
            .toolName == $tool and
            .sessionID == $session and
            (.workingDirectory | type == "string" and length > 0)
        ' "${state_directory}/restore-snapshot.json" >/dev/null ||
            fail "${name} session and working directory were not durable restore state"
    fi
    rm -f -- "${log}"
    rm -f -- "${start_receipt}"
    start_receipt=""
    rm -rf -- "${state_directory}" "${private_home}"
    log=""
    state_directory=""
    private_home=""
}

run_opencode_live_theme() {
    local overlay receipt before after
    log="$(mktemp)"
    start_receipt="$(mktemp)"
    receipt="$(mktemp)"
    rm -f -- "${receipt}"
    state_directory="$(mktemp -d)"
    PATH="${fake_bin}:${PATH}" GDK_SCALE=1 GDK_DPI_SCALE=1 \
        ZENTTY_CLI_DEBUG=1 \
        ZENTTY_CONTROLLED_AGENT_START_RECEIPT="${start_receipt}" \
        ZENTTY_CONTROLLED_AGENT_PROFILE=opencode-live-theme \
        ZENTTY_CONTROLLED_OPENCODE_THEME_RECEIPT="${receipt}" \
        "${product}" --command opencode --state-directory "${state_directory}" \
        --no-session-restore >"${log}" 2>&1 &
    product_pid=$!
    zentty_product_wait_for_log "${log}" \
        'zentty-linux: agent-event pane=pane-1 worklane=worklane-1 kind=session.start' \
        "OpenCode prelaunch identity did not reach the real product"
    for _ in {1..200}; do
        overlay="$(sed -n 's/^opencode-config://p' "${start_receipt}" | tail -1)"
        [[ -f "${overlay}/themes/zentty-synced.json" ]] && break
        sleep 0.05
    done
    [[ -f "${overlay}/themes/zentty-synced.json" ]] ||
        fail "OpenCode live-theme run had no managed synchronized theme"
    before="$(sha256sum "${overlay}/themes/zentty-synced.json" | cut -d' ' -f1)"
    mkdir -p "${XDG_CONFIG_HOME}/zentty"
    cat >"${XDG_CONFIG_HOME}/zentty/config.toml" <<'EOF'
[confirmations]
confirm_before_closing_pane = false
confirm_before_closing_window = false
confirm_before_quitting = false

[appearance]
preferred_dark_theme_name = "Abernathy"
sync_opencode_theme_with_terminal = true
EOF
    grep -Fq 'confirm_before_quitting = false' \
        "${XDG_CONFIG_HOME}/zentty/config.toml" ||
        fail "OpenCode theme fixture removed lifecycle confirmation policy"
    zentty_product_wait_for_log "${log}" \
        'zentty-linux: opencode-theme-live pane=pane-1' \
        "OpenCode live theme did not cross the managed overlay boundary"
    for _ in {1..200}; do [[ -s "${receipt}" ]] && break; sleep 0.05; done
    [[ -s "${receipt}" ]] || fail "verified OpenCode process did not receive SIGUSR2"
    grep -Fq 'signal=USR2' "${receipt}" || fail "OpenCode signal receipt was malformed"
    after="$(sha256sum "${overlay}/themes/zentty-synced.json" | cut -d' ' -f1)"
    [[ "${after}" != "${before}" ]] || fail "OpenCode managed theme bytes did not change"
    wait_for_product "OpenCode live-theme product run" 400
    rm -f -- "${log}" "${start_receipt}" "${receipt}"
    rm -rf -- "${state_directory}"
    log=""
    start_receipt=""
    state_directory=""
}

run_codex_lifecycle() {
    local socket=""

    log="$(mktemp)"
    state_directory="$(mktemp -d)"
    PATH="${fake_bin}:${PATH}" GDK_SCALE=1 GDK_DPI_SCALE=1 \
        ZENTTY_CONTROLLED_AGENT_PROFILE=codex-lifecycle \
        "${product}" \
        --command codex \
        --state-directory "${state_directory}" \
        --no-session-restore >"${log}" 2>&1 &
    product_pid=$!

    zentty_product_wait_for_log "${log}" \
        'sidebar-agent-status pane=pane-1 phase=NeedsInput interaction=GenericInput attention=true' \
        "Codex lifecycle did not establish its first question"
    zentty_product_prepare_input "${backend}" "${log}"
    # Source behavior intentionally protects a newly arrived question for
    # 350 ms from the Return that accepted an earlier terminal interaction.
    sleep 0.4
    zentty_product_key "${backend}" Return
    zentty_product_wait_for_log "${log}" \
        'zentty-linux: codex-terminal-gesture=InputSubmitted' \
        "physical Return was not observed by the product"
    for _ in {1..200}; do
        [[ "$(grep -Fc 'kind=agent.needs-input session=codex-lifecycle-e2e' "${log}")" -ge 2 ]] && break
        sleep 0.05
    done
    [[ "$(grep -Fc 'kind=agent.needs-input session=codex-lifecycle-e2e' "${log}")" -ge 2 ]] ||
        fail "the real PTY child did not receive submitted input"

    zentty_product_ctrl_key "${backend}" c
    zentty_product_wait_for_log "${log}" \
        'zentty-linux: codex-terminal-gesture=Interrupted' \
        "physical Ctrl-C was not observed by the product"
    zentty_product_wait_for_log "${log}" \
        'kind=agent.idle session=codex-lifecycle-e2e' \
        "controlled Codex did not deliver the late idle event"
    if grep -Fq 'Codex · Idle' "${log}"; then
        fail "late Codex idle escaped interrupt suppression"
    fi
