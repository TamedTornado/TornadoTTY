#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
product="${ZENTTY_LINUX_BINARY:-${repo_root}/build/linux/bin/zentty-linux}"
backend="${GDK_BACKEND:-}"
log=""
state_directory=""
product_pid=""
server_pid=""
fake_bin=""
real_gemini_bin=""
private_home=""
actor="${repo_root}/linux/tests/fixtures/controlled-agent"
# shellcheck disable=SC1091
source "${repo_root}/linux/tests/lib/product-input"

fail() {
    [[ -z "${log}" || ! -f "${log}" ]] || cat "${log}" >&2
    echo "rust-agent-ipc: error: $*" >&2
    exit 1
}

cleanup() {
    if [[ "${product_pid}" =~ ^[1-9][0-9]*$ ]]; then
        kill -TERM "${product_pid}" 2>/dev/null || true
        wait "${product_pid}" 2>/dev/null || true
    fi
    if [[ "${server_pid}" =~ ^[1-9][0-9]*$ ]]; then
        kill -TERM "${server_pid}" 2>/dev/null || true
        wait "${server_pid}" 2>/dev/null || true
    fi
    [[ -z "${log}" ]] || rm -f -- "${log}"
    [[ -z "${state_directory}" ]] || rm -rf -- "${state_directory}"
    [[ -z "${fake_bin}" ]] || rm -rf -- "${fake_bin}"
    [[ -z "${private_home}" ]] || rm -rf -- "${private_home}"
}
trap cleanup EXIT

case "${backend}" in
    x11)
        [[ "${ZENTTY_NESTED_X11_SESSION_ID:-}" =~ ^[0-9a-f]{64}$ ]] ||
            fail "X11 agent IPC must run through linux/tests/nested-x11"
        ;;
    wayland)
        if [[ ! "${ZENTTY_NESTED_WAYLAND_SESSION_ID:-}" =~ ^[0-9a-f]{64}$ &&
            ! "${ZENTTY_NESTED_WAYLAND_INPUT_SESSION_ID:-}" =~ ^[0-9a-f]{64}$ ]]; then
            fail "Wayland agent IPC must run through a controlled Wayland harness"
        fi
        ;;
    *) fail "GDK_BACKEND must be x11 or wayland" ;;
esac
case "${ZENTTY_REQUIRE_REAL_GEMINI:-false}" in
    true)
        if [[ -z "${ZENTTY_REAL_GEMINI_BIN:-}" ]]; then
            ZENTTY_REAL_GEMINI_BIN="$(command -v gemini || true)"
            export ZENTTY_REAL_GEMINI_BIN
        fi
        [[ -n "${ZENTTY_EXPECTED_GEMINI_VERSION:-}" ]] ||
            ZENTTY_EXPECTED_GEMINI_VERSION=0.53.0
        export ZENTTY_EXPECTED_GEMINI_VERSION
        ;;
    false) ;;
    *) fail "ZENTTY_REQUIRE_REAL_GEMINI must be true or false" ;;
esac
for dependency in grep mktemp sed sleep stat; do
    command -v "${dependency}" >/dev/null || fail "${dependency} is required"
done
[[ -x "${product}" ]] || fail "staged product is not built: ${product}"
[[ -x "${actor}" ]] || fail "controlled agent actor is missing: ${actor}"
zentty_product_disable_lifecycle_confirmations
helper="$(dirname "${product}")/zentty"
[[ -x "${helper}" ]] || fail "staged agent helper is not built: ${helper}"
wrapper_root="$(cd "$(dirname "${product}")/.." && pwd)/libexec/zentty/agent-wrappers"
[[ -x "${wrapper_root}/codex/codex" ]] || fail "staged Codex wrapper is missing"
[[ -x "${wrapper_root}/claude/claude" ]] || fail "staged Claude wrapper is missing"
[[ -x "${wrapper_root}/gemini/gemini" ]] || fail "staged Gemini wrapper is missing"
for wrapper in \
    cursor/cursor-agent droid/droid kimi/kimi grok/grok agy/agy hermes/hermes vibe/vibe; do
    [[ -x "${wrapper_root}/${wrapper}" ]] || fail "staged ${wrapper} wrapper is missing"
done

fake_bin="$(mktemp -d)"
ln -s "${actor}" "${fake_bin}/codex"
ln -s "${actor}" "${fake_bin}/claude"
ln -s "${actor}" "${fake_bin}/gemini"
for binary in cursor-agent droid kimi grok agy hermes vibe; do
    ln -s "${actor}" "${fake_bin}/${binary}"
done

run_adapter() {
    local name="$1"
    local command="$2"
    local profile="$3"
    local expected="$4"
    local forbidden="${5:-}"
    local socket=""

    log="$(mktemp)"
    state_directory="$(mktemp -d)"
    PATH="${fake_bin}:${PATH}" GDK_SCALE=1 GDK_DPI_SCALE=1 \
        ZENTTY_CONTROLLED_AGENT_PROFILE="${profile}" \
        "${product}" \
        --command "${command}" \
        --state-directory "${state_directory}" \
        --no-session-restore >"${log}" 2>&1 &
    product_pid=$!

    for _ in {1..200}; do
        grep -Fq "${expected}" "${log}" && break
        sleep 0.05
    done
    grep -Fq 'zentty-linux: agent-event pane=pane-1 worklane=worklane-1' "${log}" ||
        fail "${name} terminal child did not deliver an authenticated event"
    grep -Fq "${expected}" "${log}" ||
        fail "${name} event was not reduced and rendered as an attention state"
    if [[ -n "${forbidden}" ]] && grep -Fq "${forbidden}" "${log}"; then
        fail "${name} rendered forbidden stale state: ${forbidden}"
    fi

    socket="$(sed -n 's/^zentty-linux: agent-runtime socket=//p' "${log}" | head -1)"
    [[ -S "${socket}" ]] || fail "private product socket was not live during ${name}"
    [[ "$(stat -c '%a' "${socket}")" == 600 ]] || fail "product socket mode was not 0600"
    [[ "$(stat -c '%a' "$(dirname "${socket}")")" == 700 ]] ||
        fail "product socket directory mode was not 0700"

    for _ in {1..200}; do
        if ! kill -0 "${product_pid}" 2>/dev/null; then
            wait "${product_pid}" || fail "${name} product run failed"
            product_pid=""
            break
        fi
        sleep 0.05
    done
    [[ -z "${product_pid}" ]] || fail "${name} product did not exit after its real child"
    [[ ! -e "${socket}" ]] || fail "${name} product left its agent socket behind"
    [[ ! -e "$(dirname "${socket}")" ]] ||
        fail "${name} product left its private runtime directory behind"
    rm -f -- "${log}"
    rm -rf -- "${state_directory}"
    log=""
    state_directory=""
}

run_codex_lifecycle() {
    local socket=""

    log="$(mktemp)"
    state_directory="$(mktemp -d)"
    PATH="${fake_bin}:${PATH}" GDK_SCALE=1 GDK_DPI_SCALE=1 \
        ZENTTY_CONTROLLED_AGENT_PROFILE=codex-lifecycle \
        "${product}" \
        --command codex \
        --state-directory "${state_directory}" \
        --no-session-restore >"${log}" 2>&1 &
    product_pid=$!

    zentty_product_wait_for_log "${log}" \
        'sidebar-agent-status pane=pane-1 phase=NeedsInput interaction=GenericInput attention=true' \
        "Codex lifecycle did not establish its first question"
    zentty_product_prepare_input "${backend}" "${log}"
    # Source behavior intentionally protects a newly arrived question for
    # 350 ms from the Return that accepted an earlier terminal interaction.
    sleep 0.4
    zentty_product_key "${backend}" Return
    zentty_product_wait_for_log "${log}" \
        'zentty-linux: codex-terminal-gesture=InputSubmitted' \
        "physical Return was not observed by the product"
    for _ in {1..200}; do
        [[ "$(grep -Fc 'kind=agent.needs-input session=codex-lifecycle-e2e' "${log}")" -ge 2 ]] && break
        sleep 0.05
    done
    [[ "$(grep -Fc 'kind=agent.needs-input session=codex-lifecycle-e2e' "${log}")" -ge 2 ]] ||
        fail "the real PTY child did not receive submitted input"

    zentty_product_ctrl_key "${backend}" c
    zentty_product_wait_for_log "${log}" \
        'zentty-linux: codex-terminal-gesture=Interrupted' \
        "physical Ctrl-C was not observed by the product"
    zentty_product_wait_for_log "${log}" \
        'kind=agent.idle session=codex-lifecycle-e2e' \
        "controlled Codex did not deliver the late idle event"
    if grep -Fq 'Codex · Idle' "${log}"; then
        fail "late Codex idle escaped interrupt suppression"
    fi
    zentty_product_wait_for_log "${log}" \
        'kind=agent.running session=codex-lifecycle-e2e' \
        "controlled Codex did not deliver recovery activity"
    zentty_product_wait_for_log "${log}" \
        'sidebar-agent-status pane=pane-1 phase=Running interaction=None attention=false' \
        "new Codex activity did not clear interrupt suppression"

    socket="$(sed -n 's/^zentty-linux: agent-runtime socket=//p' "${log}" | head -1)"
    [[ -S "${socket}" ]] || fail "private product socket was not live during lifecycle"
    zentty_product_close_window "${backend}"
    for _ in {1..200}; do
        ! kill -0 "${product_pid}" 2>/dev/null && break
        sleep 0.05
    done
    wait "${product_pid}" || fail "Codex lifecycle product run failed"
    product_pid=""
    [[ ! -e "${socket}" && ! -e "$(dirname "${socket}")" ]] ||
        fail "Codex lifecycle left its socket or runtime directory behind"
    rm -f -- "${log}"
    rm -rf -- "${state_directory}"
    log=""
    state_directory=""
}

run_agent_status_lifecycle() {
    log="$(mktemp)"
    state_directory="$(mktemp -d)"
    PATH="${fake_bin}:${PATH}" GDK_SCALE=1 GDK_DPI_SCALE=1 \
        ZENTTY_CONTROLLED_AGENT_PROFILE=agent-status-lifecycle \
        "${product}" \
        --command codex \
        --state-directory "${state_directory}" \
        --no-session-restore >"${log}" 2>&1 &
    product_pid=$!

    zentty_product_wait_for_log "${log}" \
        'zentty-linux: agent-signal pane=pane-1 kind=lifecycle' \
        "source-compatible agent-status did not reach the product lifecycle route"
    zentty_product_wait_for_log "${log}" \
        'sidebar-agent-status pane=pane-1 phase=Running interaction=None attention=false' \
        "agent-status running did not reach the visible sidebar"
    zentty_product_wait_for_log "${log}" \
        'zentty-linux: agent-signal pane=pane-1 kind=pid event=attach pid=' \
        "agent-signal did not attach the real controlled child PID"
    zentty_product_wait_for_log "${log}" \
        'sidebar-agent-status pane=pane-1 phase=NeedsInput interaction=GenericInput attention=true' \
        "agent-status needs-input did not reach the visible sidebar"
    zentty_product_wait_for_log "${log}" \
        'zentty-linux: fleet-refresh windows=1 agents=1 waiting=1 stopped=0 compacting=0 active=0 idle=0 progress=0' \
        "agent-status needs-input did not reach the canonical fleet"
    zentty_product_wait_for_log "${log}" \
        'sidebar-agent-status pane=pane-1 phase=Idle interaction=None attention=false' \
        "the completed compatibility alias did not reach the visible sidebar"
    zentty_product_wait_for_log "${log}" \
        'zentty-linux: fleet-refresh windows=1 agents=0 waiting=0 stopped=0 compacting=0 active=0 idle=0 progress=0' \
        "agent-status clear did not remove the canonical fleet row"
    if grep -Fq 'Choose λ mode --literal [Safe] [Fast]' "${log}"; then
        fail "hostile lifecycle text escaped into product receipts"
    fi

    for _ in {1..200}; do
        ! kill -0 "${product_pid}" 2>/dev/null && break
        sleep 0.05
    done
    wait "${product_pid}" || fail "agent-status lifecycle product run failed"
    product_pid=""
    rm -f -- "${log}"
    rm -rf -- "${state_directory}"
    log=""
    state_directory=""
}

run_codex_title_transcript_enrichment() {
    local transcript=""

    log="$(mktemp)"
    state_directory="$(mktemp -d)"
    private_home="$(mktemp -d)"
    transcript="${private_home}/.codex/sessions/2026/08/07/rollout.jsonl"
    mkdir -p "$(dirname "${transcript}")"
    PATH="${fake_bin}:${PATH}" GDK_SCALE=1 GDK_DPI_SCALE=1 \
        HOME="${private_home}" CODEX_HOME="${private_home}/.codex" \
        ZENTTY_CONTROLLED_AGENT_PROFILE=codex-title-transcript \
        ZENTTY_CONTROLLED_CODEX_TRANSCRIPT="${transcript}" \
        "${product}" \
        --command codex \
        --state-directory "${state_directory}" \
        --no-session-restore >"${log}" 2>&1 &
    product_pid=$!

    zentty_product_wait_for_log "${log}" \
        'sidebar-agent-status pane=pane-1 phase=NeedsInput interaction=GenericInput attention=true' \
        "Codex title did not establish generic title-inferred attention"
    zentty_product_wait_for_log "${log}" \
        'zentty-linux: codex-transcript-enriched pane=pane-1 session=codex-title-transcript-e2e' \
        "delayed Codex transcript was not enriched asynchronously"
    zentty_product_wait_for_log "${log}" \
        'sidebar-agent-status pane=pane-1 phase=NeedsInput interaction=Decision attention=true' \
        "transcript question did not replace the generic title presentation"
    if grep -Fq 'Choose the integration scope' "${log}" ||
        grep -Fq '[Minimal] [Complete]' "${log}" ||
        grep -Fq "${transcript}" "${log}"; then
        fail "transcript body or path escaped into product receipts"
    fi

    for _ in {1..200}; do
        ! kill -0 "${product_pid}" 2>/dev/null && break
        sleep 0.05
    done
    wait "${product_pid}" || fail "Codex transcript-enrichment product run failed"
    product_pid=""
    rm -f -- "${log}"
    rm -rf -- "${state_directory}" "${private_home}"
    log=""
    state_directory=""
    private_home=""
}

run_codex_enrichment_shutdown() {
    local transcript=""

    log="$(mktemp)"
    state_directory="$(mktemp -d)"
    private_home="$(mktemp -d)"
    transcript="${private_home}/.codex/sessions/2026/08/07/never-created.jsonl"
    PATH="${fake_bin}:${PATH}" GDK_SCALE=1 GDK_DPI_SCALE=1 \
        HOME="${private_home}" CODEX_HOME="${private_home}/.codex" \
        ZENTTY_CONTROLLED_AGENT_PROFILE=codex-title-transcript-pending \
        ZENTTY_CONTROLLED_CODEX_TRANSCRIPT="${transcript}" \
        "${product}" \
        --command codex \
        --state-directory "${state_directory}" \
        --no-session-restore >"${log}" 2>&1 &
    product_pid=$!

    zentty_product_wait_for_log "${log}" \
        'codex-transcript-enrichment-scheduled pane=pane-1 session=codex-title-transcript-pending-e2e' \
        "pending transcript enrichment was not scheduled"
    [[ ! -e "${transcript}" ]] || fail "pending transcript fixture unexpectedly existed"
    zentty_product_prepare_input "${backend}" "${log}"
    zentty_product_close_window "${backend}"
    for _ in {1..40}; do
        ! kill -0 "${product_pid}" 2>/dev/null && break
        sleep 0.05
    done
    ! kill -0 "${product_pid}" 2>/dev/null ||
        fail "window close did not bound in-flight transcript cancellation"
    wait "${product_pid}" || fail "pending-enrichment shutdown product run failed"
    product_pid=""
    if grep -Fq 'codex-transcript-enriched' "${log}" || grep -Fq "${transcript}" "${log}"; then
        fail "cancelled enrichment completed late or exposed its transcript path"
    fi
    rm -f -- "${log}"
    rm -rf -- "${state_directory}" "${private_home}"
    log=""
    state_directory=""
    private_home=""
}

