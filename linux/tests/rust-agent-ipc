if [[ "${ZENTTY_REQUIRE_REAL_GEMINI:-false}" == true ]]; then
    reviewed_gemini="${repo_root}/linux/ci/node-tools/node_modules/.bin/gemini"
    for dependency in jq node pgrep readlink; do
        command -v "${dependency}" >/dev/null ||
            fail "${dependency} is required for the real Gemini journey"
    done
    [[ -x "${ZENTTY_REAL_GEMINI_BIN}" ]] || fail "real Gemini executable is not executable"
    [[ -x "${reviewed_gemini}" ]] || fail "repository-owned Gemini prerequisite is missing"
    [[ "$(readlink -f "${ZENTTY_REAL_GEMINI_BIN}")" == "$(readlink -f "${reviewed_gemini}")" ]] ||
        fail "real Gemini executable is not the repository-owned reviewed prerequisite"
    ZENTTY_REAL_GEMINI_BIN="${reviewed_gemini}"
    [[ "${ZENTTY_EXPECTED_GEMINI_VERSION:-}" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] ||
        fail "ZENTTY_EXPECTED_GEMINI_VERSION must pin the reviewed real CLI version"
    [[ "$(basename "${ZENTTY_REAL_GEMINI_BIN}")" == gemini ]] ||
        fail "real Gemini executable must retain its installed basename"
    real_gemini_bin="$(dirname "${ZENTTY_REAL_GEMINI_BIN}")"
    node_installation="$(cd "$(dirname "$(readlink -f "$(command -v node)")")/.." && pwd)"
    [[ -d "${node_installation}/include/node" ]] ||
        fail "installed Node headers are required for the real Gemini native loader"
    state_directory="$(mktemp -d)"
    private_home="$(mktemp -d)"
    gemini_source="${private_home}/system-settings.json"
    gemini_receipt="${private_home}/version.receipt"
    printf '%s\n' '{"theme":"Dracula","general":{"enableNotifications":false},"security":{"auth":{"selectedType":"gemini-api-key"}}}' >"${gemini_source}"
    source_sha="$(sha256sum "${gemini_source}" | awk '{print $1}')"
    log="$(mktemp)"
    PATH="${real_gemini_bin}:${PATH}" GDK_SCALE=1 GDK_DPI_SCALE=1 \
        HOME="${private_home}" NODE_DISABLE_COMPILE_CACHE=1 \
        GEMINI_CLI_SYSTEM_SETTINGS_PATH="${gemini_source}" \
        "${product}" \
        --command "gemini --version >${gemini_receipt} 2>&1" \
        --state-directory "${state_directory}" \
        --no-session-restore >"${log}" 2>&1 &
    product_pid=$!
    for _ in {1..400}; do
        [[ -s "${gemini_receipt}" ]] && break
        sleep 0.05
    done
    [[ -s "${gemini_receipt}" ]] || fail "real Gemini version receipt was not written"
    wait_for_product "real Gemini version run" 400
    gemini_output="$(tr -d '\r\n' <"${gemini_receipt}")"
    [[ "${gemini_output}" == "${ZENTTY_EXPECTED_GEMINI_VERSION}" ]] ||
        fail "real Gemini version receipt did not match the reviewed executable: ${gemini_output}"
    [[ "$(sha256sum "${gemini_source}" | awk '{print $1}')" == "${source_sha}" ]] ||
        fail "real Gemini launch modified the source system settings"
    grep -Fq 'zentty-linux: child-exited-pane=pane-1' "${log}" ||
        fail "real Gemini did not execute and exit through the Ghostty PTY"
    socket="$(sed -n 's/^zentty-linux: agent-runtime socket=//p' "${log}" | head -1)"
    [[ -n "${socket}" && ! -e "${socket}" && ! -e "$(dirname "${socket}")" ]] ||
        fail "real Gemini run left its socket or overlay runtime behind"

    product_profile="$(sed -n 's/^product_profile=//p' "$(dirname "${product}")/../build-metadata")"
    controlled_gemini="${repo_root}/target/${product_profile}/controlled_gemini"
    [[ -x "${controlled_gemini}" ]] ||
        fail "controlled Gemini endpoint is not built: ${controlled_gemini}"
    model_receipt="${private_home}/model-receipt.jsonl"
    model_log="${private_home}/model.log"
    "${controlled_gemini}" --receipt "${model_receipt}" >"${model_log}" 2>&1 &
    server_pid=$!
    for _ in {1..200}; do
        grep -q '^CONTROLLED_GEMINI_READY=' "${model_log}" && break
        kill -0 "${server_pid}" 2>/dev/null ||
            fail "controlled Gemini endpoint exited before readiness"
        sleep 0.01
    done
    endpoint="$(sed -n 's/^CONTROLLED_GEMINI_READY=//p' "${model_log}")"
    [[ "${endpoint}" =~ ^http://127\.0\.0\.1:[1-9][0-9]*$ ]] ||
        fail "controlled Gemini endpoint did not publish a loopback address"

    rm -rf -- "${state_directory}"
    state_directory="$(mktemp -d)"
    : >"${log}"
    PATH="${real_gemini_bin}:${PATH}" GDK_SCALE=1 GDK_DPI_SCALE=1 \
        HOME="${private_home}" GEMINI_API_KEY=zentty-controlled-key \
        GOOGLE_GEMINI_BASE_URL="${endpoint}" \
        NODE_DISABLE_COMPILE_CACHE=1 \
        npm_config_nodedir="${node_installation}" \
        GEMINI_CLI_SYSTEM_SETTINGS_PATH="${gemini_source}" \
        "${product}" \
        --command "gemini --skip-trust --model gemini-2.5-flash --prompt-interactive 'Zentty installed Gemini integration probe'" \
        --state-directory "${state_directory}" >"${log}" 2>&1 &
    product_pid=$!
    zentty_product_wait_for_log "${log}" \
        'kind=agent.running session=' \
        "installed Gemini BeforeAgent hook did not reach the reducer" 1200 ||
        fail "installed Gemini BeforeAgent hook did not reach the reducer"
    zentty_product_wait_for_log "${log}" \
        'kind=agent.idle session=' \
        "installed Gemini AfterAgent hook did not reach the reducer" 1200 ||
        fail "installed Gemini AfterAgent hook did not reach the reducer"
    grep -Fq '"containsProbe":true' "${model_receipt}" ||
        fail "controlled endpoint did not retain a sanitized Gemini receipt"
    wait_for_server "controlled Gemini endpoint" 200
    zentty_product_prepare_input "${backend}" "${log}"
    zentty_product_close_window "${backend}"
    wait_for_product "installed Gemini product turn" 240
    jq -e '
        .restoreDraftWindows[0].paneDrafts[0] |
        .toolName == "Gemini" and
        .agentLaunchSnapshot.arguments == ["gemini", "--resume"]
    ' "${state_directory}/restore-snapshot.json" >/dev/null ||
        fail "installed Gemini turn was not persisted as a source-compatible resume draft"

    : >"${log}"
    PATH="${real_gemini_bin}:${PATH}" GDK_SCALE=1 GDK_DPI_SCALE=1 \
        HOME="${private_home}" GEMINI_API_KEY=zentty-controlled-key \
        GOOGLE_GEMINI_BASE_URL="${endpoint}" \
        NODE_DISABLE_COMPILE_CACHE=1 \
        npm_config_nodedir="${node_installation}" \
        GEMINI_CLI_SYSTEM_SETTINGS_PATH="${gemini_source}" \
        "${product}" --state-directory "${state_directory}" >"${log}" 2>&1 &
    product_pid=$!
    zentty_product_wait_for_log "${log}" \
        'zentty-linux: agent-resume-launch pane=pane-1 command=gemini --resume' \
        "installed Gemini relaunch did not use the source-compatible resume command" 1200 ||
        fail "installed Gemini relaunch did not use the source-compatible resume command"
    zentty_product_wait_for_log "${log}" \
        'sidebar-agent-status pane=pane-1 phase=Starting interaction=None attention=false' \
        "persisted Gemini restore state did not reach the sidebar" 1200 ||
        fail "persisted Gemini restore state did not reach the sidebar"
    zentty_product_wait_for_log "${log}" 'zentty-linux: title=◇  Ready (zentty)' \
        "resumed real Gemini TUI did not render" 1200 ||
        fail "resumed real Gemini TUI did not render"
    zentty_product_prepare_input "${backend}" "${log}"
    zentty_product_close_window "${backend}"
    wait_for_product "resumed installed Gemini product" 240

    # Gemini's native dependency loader may briefly finish a node-gyp header
    # cache subprocess after the TUI has acknowledged termination. Do not let
    # that external process race the controlled compositor's TMPDIR removal,
    # and do not silently accept a process that remains alive.
    if [[ -n "${TMPDIR:-}" ]]; then
        for _ in {1..100}; do
            ! pgrep -f -- "${TMPDIR}/node-gyp-tmp-" >/dev/null && break
            sleep 0.05
        done
        ! pgrep -f -- "${TMPDIR}/node-gyp-tmp-" >/dev/null ||
            fail "real Gemini left a node-gyp cache subprocess alive"
        # The detached process can disappear from the process table just
        # before its final filesystem writes become visible. Give those
        # writes a bounded quiescence interval before the owning compositor
        # removes its private TMPDIR.
        sleep 1
    fi

    rm -rf -- "${private_home}" "${state_directory}"
    rm -f -- "${log}"
    private_home=""
    state_directory=""
    real_gemini_bin=""
    log=""
fi

