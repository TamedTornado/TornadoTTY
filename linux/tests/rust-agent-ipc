#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
product="${ZENTTY_LINUX_BINARY:-${repo_root}/build/linux/bin/zentty-linux}"
backend="${GDK_BACKEND:-}"
log=""
state_directory=""
product_pid=""
fake_bin=""
real_gemini_bin=""
private_home=""
actor="${repo_root}/linux/tests/fixtures/controlled-agent"

fail() {
    [[ -z "${log}" || ! -f "${log}" ]] || cat "${log}" >&2
    echo "rust-agent-ipc: error: $*" >&2
    exit 1
}

cleanup() {
    if [[ "${product_pid}" =~ ^[1-9][0-9]*$ ]]; then
        kill -TERM "${product_pid}" 2>/dev/null || true
        wait "${product_pid}" 2>/dev/null || true
    fi
    [[ -z "${log}" ]] || rm -f -- "${log}"
    [[ -z "${state_directory}" ]] || rm -rf -- "${state_directory}"
    [[ -z "${fake_bin}" ]] || rm -rf -- "${fake_bin}"
    [[ -z "${private_home}" ]] || rm -rf -- "${private_home}"
}
trap cleanup EXIT

case "${backend}" in
    x11)
        [[ "${ZENTTY_NESTED_X11_SESSION_ID:-}" =~ ^[0-9a-f]{64}$ ]] ||
            fail "X11 agent IPC must run through linux/tests/nested-x11"
        ;;
    wayland)
        if [[ ! "${ZENTTY_NESTED_WAYLAND_SESSION_ID:-}" =~ ^[0-9a-f]{64}$ &&
            ! "${ZENTTY_NESTED_WAYLAND_INPUT_SESSION_ID:-}" =~ ^[0-9a-f]{64}$ ]]; then
            fail "Wayland agent IPC must run through a controlled Wayland harness"
        fi
        ;;
    *) fail "GDK_BACKEND must be x11 or wayland" ;;
esac
for dependency in grep mktemp sed sleep stat; do
    command -v "${dependency}" >/dev/null || fail "${dependency} is required"
done
[[ -x "${product}" ]] || fail "staged product is not built: ${product}"
[[ -x "${actor}" ]] || fail "controlled agent actor is missing: ${actor}"
helper="$(dirname "${product}")/zentty"
[[ -x "${helper}" ]] || fail "staged agent helper is not built: ${helper}"
wrapper_root="$(cd "$(dirname "${product}")/.." && pwd)/libexec/zentty/agent-wrappers"
[[ -x "${wrapper_root}/codex/codex" ]] || fail "staged Codex wrapper is missing"
[[ -x "${wrapper_root}/claude/claude" ]] || fail "staged Claude wrapper is missing"
[[ -x "${wrapper_root}/gemini/gemini" ]] || fail "staged Gemini wrapper is missing"

fake_bin="$(mktemp -d)"
ln -s "${actor}" "${fake_bin}/codex"
ln -s "${actor}" "${fake_bin}/claude"
ln -s "${actor}" "${fake_bin}/gemini"

run_adapter() {
    local name="$1"
    local command="$2"
    local profile="$3"
    local expected="$4"
    local socket=""

    log="$(mktemp)"
    state_directory="$(mktemp -d)"
    PATH="${fake_bin}:${PATH}" GDK_SCALE=1 GDK_DPI_SCALE=1 \
        ZENTTY_CONTROLLED_AGENT_PROFILE="${profile}" \
        "${product}" \
        --command "${command}" \
        --state-directory "${state_directory}" \
        --no-session-restore >"${log}" 2>&1 &
    product_pid=$!

    for _ in {1..200}; do
        grep -Fq "${expected}" "${log}" && break
        sleep 0.05
    done
    grep -Fq 'zentty-linux: agent-event pane=pane-1 worklane=worklane-1' "${log}" ||
        fail "${name} terminal child did not deliver an authenticated event"
    grep -Fq "${expected}" "${log}" ||
        fail "${name} event was not reduced and rendered as an attention state"

    socket="$(sed -n 's/^zentty-linux: agent-runtime socket=//p' "${log}" | head -1)"
    [[ -S "${socket}" ]] || fail "private product socket was not live during ${name}"
    [[ "$(stat -c '%a' "${socket}")" == 600 ]] || fail "product socket mode was not 0600"
    [[ "$(stat -c '%a' "$(dirname "${socket}")")" == 700 ]] ||
        fail "product socket directory mode was not 0700"

    for _ in {1..200}; do
        if ! kill -0 "${product_pid}" 2>/dev/null; then
            wait "${product_pid}" || fail "${name} product run failed"
            product_pid=""
            break
        fi
        sleep 0.05
    done
    [[ -z "${product_pid}" ]] || fail "${name} product did not exit after its real child"
    [[ ! -e "${socket}" ]] || fail "${name} product left its agent socket behind"
    [[ ! -e "$(dirname "${socket}")" ]] ||
        fail "${name} product left its private runtime directory behind"
    rm -f -- "${log}"
    rm -rf -- "${state_directory}"
    log=""
    state_directory=""
}

run_adapter \
    codex \
    'codex' \
    codex-permission \
    'zentty-linux: sidebar-agent-status pane=pane-1 text="Codex · Needs input: Run integration tests?" attention=true'
run_adapter \
    codex-notify \
    'codex' \
    codex-notify \
    'zentty-linux: sidebar-agent-status pane=pane-1 text="Codex · Needs input: Choose execution mode?\n[Sandboxed] [Elevated]" attention=true'
run_adapter \
    codex-title \
    'codex' \
    codex-title \
    'zentty-linux: sidebar-agent-status pane=pane-1 text="Codex · Needs input: [ ! ] Action Required | codex-title | Tasks 1/3" attention=true'
run_adapter \
    claude \
    'claude' \
    claude-question \
    'zentty-linux: sidebar-agent-status pane=pane-1 text="Claude Code · Needs input: Deploy now?" attention=true'
run_adapter \
    gemini \
    'gemini' \
    gemini-permission \
    'zentty-linux: sidebar-agent-status pane=pane-1 text="Gemini · Needs input: Allow write_file on README.md?" attention=true'

if [[ -n "${ZENTTY_REAL_GEMINI_BIN:-}" ]]; then
    [[ -x "${ZENTTY_REAL_GEMINI_BIN}" ]] || fail "real Gemini executable is not executable"
    [[ "${ZENTTY_EXPECTED_GEMINI_VERSION:-}" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] ||
        fail "ZENTTY_EXPECTED_GEMINI_VERSION must pin the reviewed real CLI version"
    [[ "$(basename "${ZENTTY_REAL_GEMINI_BIN}")" == gemini ]] ||
        fail "real Gemini executable must retain its installed basename"
    real_gemini_bin="$(dirname "${ZENTTY_REAL_GEMINI_BIN}")"
    state_directory="$(mktemp -d)"
    private_home="$(mktemp -d)"
    gemini_source="${private_home}/system-settings.json"
    gemini_receipt="${private_home}/version.receipt"
    printf '%s\n' '{"theme":"Dracula","general":{"enableNotifications":false}}' >"${gemini_source}"
    source_sha="$(sha256sum "${gemini_source}" | awk '{print $1}')"
    log="$(mktemp)"
    PATH="${real_gemini_bin}:${PATH}" GDK_SCALE=1 GDK_DPI_SCALE=1 \
        HOME="${private_home}" \
        GEMINI_CLI_SYSTEM_SETTINGS_PATH="${gemini_source}" \
        "${product}" \
        --command "gemini --version >${gemini_receipt} 2>&1" \
        --state-directory "${state_directory}" \
        --no-session-restore >"${log}" 2>&1 &
    product_pid=$!
    for _ in {1..400}; do
        [[ -s "${gemini_receipt}" ]] && ! kill -0 "${product_pid}" 2>/dev/null && break
        sleep 0.05
    done
    wait "${product_pid}" || fail "real Gemini version run failed"
    product_pid=""
    gemini_output="$(tr -d '\r\n' <"${gemini_receipt}")"
    [[ "${gemini_output}" == "${ZENTTY_EXPECTED_GEMINI_VERSION}" ]] ||
        fail "real Gemini version receipt did not match the reviewed executable: ${gemini_output}"
    [[ "$(sha256sum "${gemini_source}" | awk '{print $1}')" == "${source_sha}" ]] ||
        fail "real Gemini launch modified the source system settings"
    grep -Fq 'zentty-linux: child-exited-pane=pane-1' "${log}" ||
        fail "real Gemini did not execute and exit through the Ghostty PTY"
    socket="$(sed -n 's/^zentty-linux: agent-runtime socket=//p' "${log}" | head -1)"
    [[ -n "${socket}" && ! -e "${socket}" && ! -e "$(dirname "${socket}")" ]] ||
        fail "real Gemini run left its socket or overlay runtime behind"
    rm -rf -- "${private_home}" "${state_directory}"
    rm -f -- "${log}"
    private_home=""
    state_directory=""
    real_gemini_bin=""
    log=""
fi

echo "Rust agent launch passed: ${backend}, wrapper=real-process, child=real-pty, helper=real-process, transport=real-unix-socket, adapters=codex+claude+gemini, real-gemini=$([[ -n "${ZENTTY_REAL_GEMINI_BIN:-}" ]] && echo true || echo prerequisite-not-requested)"
