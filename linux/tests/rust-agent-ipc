        "${product}" \
        --command "amp threads continue T-old --mode smart --label discard" \
        --state-directory "${state_directory}" \
        --no-session-restore >"${log}" 2>&1 &
    product_pid=$!

    zentty_product_wait_for_log "${log}" \
        'kind=session.start session=T-ZenttyAmpE2E' \
        "real staged Amp plugin did not emit authenticated session identity" ||
        fail "real staged Amp plugin did not emit authenticated session identity"
    zentty_product_wait_for_log "${log}" \
        'sidebar-agent-status pane=pane-1 phase=Running interaction=None attention=false' \
        "real staged Amp plugin did not project running state" ||
