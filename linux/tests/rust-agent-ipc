    # and do not silently accept a process that remains alive.
    if [[ -n "${TMPDIR:-}" ]]; then
        for _ in {1..100}; do
            ! pgrep -f -- "${TMPDIR}/node-gyp-tmp-" >/dev/null && break
            sleep 0.05
        done
