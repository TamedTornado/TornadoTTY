#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
subject="${repo_root}/linux/tests/arch-package-audit"
policy="${repo_root}/linux/packaging/arch-policy-v1.json"
temporary="$(mktemp -d)"
trap 'rm -rf -- "${temporary}"' EXIT

fail() {
    echo "arch-package-audit-test: error: $*" >&2
    exit 1
}

make_fixture() {
    local name="$1" mode="${2:-valid}"
    local root="${temporary}/${name}/root"
    local artifact="${temporary}/${name}/zentty-0.1.0-1-x86_64.pkg.tar.zst"
    local manifest="${temporary}/${name}/zentty-0.1.0-1-x86_64.manifest.json"
    local provenance="${temporary}/${name}/zentty-0.1.0-1-x86_64.provenance.json"
    mkdir -p "${root}/usr/lib/zentty/lib" "${root}/usr/bin"
    cp /bin/true "${root}/usr/lib/zentty/lib/libghostty-gtk-embed.so"
    # The loader token is intentionally literal.
    # shellcheck disable=SC2016
    patchelf --set-rpath '$ORIGIN' "${root}/usr/lib/zentty/lib/libghostty-gtk-embed.so"
    if [[ "${mode}" == legitimate-home-pattern ]]; then
        printf '/home//Users/unsafe\n' >>"${root}/usr/lib/zentty/lib/libghostty-gtk-embed.so"
    elif [[ "${mode}" == leaked-build-path ]]; then
        printf '/home/jason/Projects/zentty-release\n' \
            >>"${root}/usr/lib/zentty/lib/libghostty-gtk-embed.so"
        # Keep substantial output after the match so grep -q under pipefail
        # would reproduce the false-negative behavior found on Omarchy.
        head -c 1048576 /dev/zero | tr '\0' x \
            >>"${root}/usr/lib/zentty/lib/libghostty-gtk-embed.so"
    fi
    chmod 0644 "${root}/usr/lib/zentty/lib/libghostty-gtk-embed.so"
    ln -s ../lib/zentty/lib/libghostty-gtk-embed.so "${root}/usr/bin/zentty-linux"
    [[ "${mode}" != extra ]] || printf 'undeclared\n' >"${root}/usr/extra"
    {
        printf 'pkgname = zentty\n'
        printf 'pkgver = 0.1.0-1\n'
        printf 'arch = x86_64\n'
        jq -r '.required_runtime_packages[] | "depend = " + .' "${policy}"
    } >"${root}/.PKGINFO"
    if [[ "${mode}" == missing-dependency ]]; then
        sed -i '/depend = gtk4/d' "${root}/.PKGINFO"
    fi
    (
        cd "${root}"
        bsdtar -cf - .PKGINFO usr | zstd -q -T1 -o "${artifact}"
    )
    jq -n \
        --arg file_sha "$(sha256sum "${root}/usr/lib/zentty/lib/libghostty-gtk-embed.so" | awk '{print $1}')" '
      {schema_version:1,package:"zentty",version:"0.1.0",architecture:"x86_64",
       package_family:"arch",zentty_revision:("a" * 40),files:[
        {path:"/usr/bin/zentty-linux",type:"symlink",mode:"0777",
         owner_component:"entry-points",target:"../lib/zentty/lib/libghostty-gtk-embed.so"},
        {path:"/usr/lib/zentty/lib/libghostty-gtk-embed.so",type:"file",mode:"644",
         owner_component:"ghostty-embedding",sha256:$file_sha}
       ]}' >"${manifest}"
    jq -n \
        --arg artifact "$(basename "${artifact}")" \
        --arg artifact_sha "$(sha256sum "${artifact}" | awk '{print $1}')" \
        --arg manifest "$(basename "${manifest}")" \
        --arg manifest_sha "$(sha256sum "${manifest}" | awk '{print $1}')" \
        --argjson dependencies "$(jq '.required_runtime_packages' "${policy}")" '
      {schema_version:1,package:"zentty",package_version:"0.1.0",
       architecture:"x86_64",baseline:"omarchy-4-x86_64",
       zentty_revision:("a" * 40),ghostty_revision:("b" * 40),source_date_epoch:1,
       artifact:{file:$artifact,sha256:$artifact_sha},
       manifest:{file:$manifest,sha256:$manifest_sha},
       dependencies:{arch_runtime:$dependencies,direct_elf_owners:$dependencies},
       environment:{os_id:"omarchy",os_version:"4.0.2",
        installed_packages_sha256:("c" * 64)},
       toolchain:{rustc:"fixture",cargo:"fixture",zig:"fixture",makepkg:"fixture"}}' \
        >"${provenance}"
}

expect_failure() {
    local name="$1" expected="$2"
    if "${subject}" \
        "${temporary}/${name}/zentty-0.1.0-1-x86_64.pkg.tar.zst" \
        "${temporary}/${name}/zentty-0.1.0-1-x86_64.manifest.json" \
        "${temporary}/${name}/zentty-0.1.0-1-x86_64.provenance.json" \
        >"${temporary}/${name}.log" 2>&1; then
        fail "${name} unexpectedly passed"
    fi
    grep -Fq "${expected}" "${temporary}/${name}.log" ||
        fail "${name} did not report ${expected}"
}

make_fixture valid
"${subject}" \
    "${temporary}/valid/zentty-0.1.0-1-x86_64.pkg.tar.zst" \
    "${temporary}/valid/zentty-0.1.0-1-x86_64.manifest.json" \
    "${temporary}/valid/zentty-0.1.0-1-x86_64.provenance.json" >/dev/null

make_fixture legitimate-home-pattern legitimate-home-pattern
"${subject}" \
    "${temporary}/legitimate-home-pattern/zentty-0.1.0-1-x86_64.pkg.tar.zst" \
    "${temporary}/legitimate-home-pattern/zentty-0.1.0-1-x86_64.manifest.json" \
    "${temporary}/legitimate-home-pattern/zentty-0.1.0-1-x86_64.provenance.json" \
    >/dev/null
make_fixture leaked-build-path leaked-build-path
expect_failure leaked-build-path 'build path leaked into ELF'

make_fixture extra extra
expect_failure extra 'undeclared payload files'
make_fixture missing-dependency missing-dependency
expect_failure missing-dependency 'dependencies do not match'
make_fixture stale
jq '.artifact.sha256 = ("0" * 64)' \
    "${temporary}/stale/zentty-0.1.0-1-x86_64.provenance.json" \
    >"${temporary}/stale/provenance.tmp"
mv "${temporary}/stale/provenance.tmp" \
    "${temporary}/stale/zentty-0.1.0-1-x86_64.provenance.json"
expect_failure stale 'provenance is incomplete or stale'

echo "arch-package-audit-test: PASS"
