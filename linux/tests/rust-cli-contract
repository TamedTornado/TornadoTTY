#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
# shellcheck source=linux/tests/lib/product-input
source "${repo_root}/linux/tests/lib/product-input"
# shellcheck source=linux/tests/lib/shell-binaries
source "${repo_root}/linux/tests/lib/shell-binaries"
# shellcheck source=linux/tests/lib/cli-shell-scenario
source "${repo_root}/linux/tests/lib/cli-shell-scenario"
product="${ZENTTY_LINUX_BINARY:-${repo_root}/build/linux/bin/zentty-linux}"
backend="${GDK_BACKEND:-}"
ghostty_root="${GHOSTTY_SOURCE_DIR:-${repo_root}/build/linux-deps/ghostty}"
run_root="$(mktemp -d)"
state_directory="${run_root}/state"
receipts="${run_root}/receipts"
child="${run_root}/cli-child"
log="${run_root}/product.log"
product_pid=""
second_product_pid=""

fail() {
    [[ ! -f "${log}" ]] || cat "${log}" >&2
    [[ ! -f "${receipts}/child.stderr" ]] || cat "${receipts}/child.stderr" >&2
    [[ ! -f "${receipts}/done" ]] || cat "${receipts}/done" >&2
    echo "rust-cli-contract: error: $*" >&2
    exit 1
}

cleanup() {
    if [[ "${product_pid}" =~ ^[1-9][0-9]*$ ]]; then
        kill -TERM "${product_pid}" 2>/dev/null || true
        wait "${product_pid}" 2>/dev/null || true
    fi
    if [[ "${second_product_pid}" =~ ^[1-9][0-9]*$ ]]; then
        kill -TERM "${second_product_pid}" 2>/dev/null || true
        wait "${second_product_pid}" 2>/dev/null || true
    fi
    rm -rf -- "${run_root}"
}
trap cleanup EXIT

case "${backend}" in
    x11) [[ "${ZENTTY_NESTED_X11_SESSION_ID:-}" =~ ^[0-9a-f]{64}$ ]] || fail "X11 requires nested-x11" ;;
    wayland) [[ "${ZENTTY_NESTED_WAYLAND_INPUT_SESSION_ID:-}" =~ ^[0-9a-f]{64}$ ]] || fail "Wayland requires nested-wayland-input" ;;
    *) fail "GDK_BACKEND must be x11 or wayland" ;;
esac
for dependency in awk cmp diff dirname find grep head jq jsonschema readelf readlink \
    script sed sha256sum sort stat xargs; do
    command -v "${dependency}" >/dev/null || fail "${dependency} is required"
done
[[ -x "${product}" ]] || fail "staged product is missing: ${product}"

layer_runpath="$(
    readelf -d "${ghostty_root}/zig-out/lib/libghostty-gtk-embed.so" |
        sed -n 's/.*Library runpath: \[\([^]]*\)\].*/\1/p' |
        head -1
)"
[[ "${layer_runpath}" == .zig-cache/* ]] || fail "Ghostty runpath is not pinned"
layer_directory="${ghostty_root}/${layer_runpath}"
mkdir -p "${state_directory}" "${receipts}"

if [[ -n "${ZENTTY_CLI_SHELL_SCENARIO:-}" ]]; then
    zentty_cli_shell_scenario
    exit 0
fi

cat >"${child}" <<'CHILD'
#!/usr/bin/env bash
set -euo pipefail
if [[ "${ZENTTY_PANE_ID}" != pane-1 ]]; then
    umask 077
    {
        printf 'cli=%s\n' "${ZENTTY_CLI_BIN}"
        printf 'socket=%s\n' "${ZENTTY_INSTANCE_SOCKET}"
        printf 'instance=%s\n' "${ZENTTY_INSTANCE_ID}"
        printf 'window=%s\n' "${ZENTTY_WINDOW_ID}"
        printf 'worklane=%s\n' "${ZENTTY_WORKLANE_ID}"
        printf 'pane=%s\n' "${ZENTTY_PANE_ID}"
        printf 'token=%s\n' "${ZENTTY_PANE_TOKEN}"
        printf 'hook=%s\n' "${ZENTTY_AGENT_EVENT_COMMAND}"
        printf 'integration=%s\n' "${ZENTTY_SHELL_INTEGRATION_DIR:-}"
    } >"${ZENTTY_CLI_CONTRACT_RECEIPTS}/pane-env-${ZENTTY_PANE_ID}"
    sleep 30
    exit 0
fi
exec 2>"${ZENTTY_CLI_CONTRACT_RECEIPTS}/child.stderr"
trap 'status=$?; printf "FAIL line=%s status=%s\n" "${LINENO}" "${status}" >"${ZENTTY_CLI_CONTRACT_RECEIPTS}/done"; exit "${status}"' ERR
cli="${ZENTTY_CLI_BIN}"
out="${ZENTTY_CLI_CONTRACT_RECEIPTS}"

"${cli}" version >"${out}/version.txt"
"${cli}" worklane color --list >"${out}/colors.txt"
"${cli}" list --json --output-version 1 >"${out}/overview.json"
"${cli}" list >"${out}/overview.txt"
"${cli}" list windows --json --output-version 1 >"${out}/windows.json"
"${cli}" list windows >"${out}/windows.txt"
"${cli}" window list --json --output-version 1 >"${out}/window-alias.json"
"${cli}" list worklanes --json --output-version 1 >"${out}/worklanes.json"
"${cli}" list worklanes >"${out}/worklanes.txt"
"${cli}" worklane list --json --output-version 1 >"${out}/worklane-alias.json"
"${cli}" list panes --json --output-version 1 >"${out}/panes.json"
"${cli}" list panes --json --include-control-token --output-version 1 >"${out}/panes-authenticated.json"
! grep -Fq -- "${ZENTTY_PANE_TOKEN}" "${out}/panes-authenticated.json"
"${cli}" list panes >"${out}/panes.txt"
"${cli}" pane list --json --output-version 1 >"${out}/pane-alias.json"
"${cli}" select pane --pane-index 1 --shell --include-control-token --output-version 1 >"${out}/selected.shell"
! grep -Fq -- "${ZENTTY_PANE_TOKEN}" "${out}/selected.shell"
"${cli}" select pane --pane-index 1 >"${out}/selected.txt"
env -u ZENTTY_INSTANCE_SOCKET -u ZENTTY_PANE_TOKEN -u ZENTTY_INSTANCE_ID \
    "${cli}" list panes --json --output-version 1 >"${out}/discovered-panes.json"
cmp -s "${out}/panes.json" "${out}/discovered-panes.json"
if env -u ZENTTY_INSTANCE_SOCKET -u ZENTTY_PANE_TOKEN -u ZENTTY_INSTANCE_ID \
    "${cli}" split right >"${out}/discovered-mutation.stdout" \
    2>"${out}/discovered-mutation.stderr"; then exit 1; fi

# Discovery is authenticated but read-only. Capabilities are absent by
# default, explicit forged topology claims cannot redirect the token, and a
# wrong capability never reaches product dispatch.
jq -e 'all(.[]; has("controlToken") | not)' "${out}/panes.json" >/dev/null
env ZENTTY_WINDOW_ID=forged-window ZENTTY_WORKLANE_ID=forged-worklane \
    ZENTTY_PANE_ID=forged-pane "${cli}" list panes --json >"${out}/forged-claims.json"
cmp -s "${out}/panes.json" "${out}/forged-claims.json"
if env ZENTTY_PANE_TOKEN="$(printf '0%.0s' {1..64})" "${cli}" list panes --json \
    >"${out}/wrong-token.stdout" 2>"${out}/wrong-token.stderr"; then exit 1; fi
focused_before="$(jq -r '.[] | select(.isFocused) | .id' "${out}/panes.json")"
if "${cli}" pane focus --pane-id stale-pane \
    >"${out}/stale-mutation.stdout" 2>"${out}/stale-mutation.stderr"; then exit 1; fi
focused_after="$("${cli}" list panes --json | jq -r '.[] | select(.isFocused) | .id')"
[[ "${focused_after}" == "${focused_before}" ]]

cmp -s "${out}/windows.json" "${out}/window-alias.json"
cmp -s "${out}/worklanes.json" "${out}/worklane-alias.json"
cmp -s "${out}/panes.json" "${out}/pane-alias.json"
cmp -s "${out}/colors.txt" "${ZENTTY_REPO_ROOT}/docs/design/cli-goldens/colors-v1.txt"

if "${cli}" list panes --json --json >"${out}/duplicate.stdout" 2>"${out}/duplicate.stderr"; then exit 1; fi
if "${cli}" list panes --output-version 2 >"${out}/version-2.stdout" 2>"${out}/version-2.stderr"; then exit 1; fi
if "${cli}" select pane --pane-id stale-explicit-id >"${out}/stale.stdout" 2>"${out}/stale.stderr"; then exit 1; fi
if "${cli}" select pane --pane-index 1 --pane-index 2 >"${out}/ambiguous.stdout" 2>"${out}/ambiguous.stderr"; then exit 1; fi

# Exercise both source aliases through the authenticated real product and
# remove only the panes created by each alias.
"${cli}" hsplit --equal
for _ in {1..100}; do
    "${cli}" list panes --include-control-token --json >"${out}/after-hsplit.json"
    [[ "$(jq 'length' "${out}/after-hsplit.json")" -eq 2 ]] && break
    sleep 0.02
done
split_id="$(jq -r '.[] | select(.id != env.ZENTTY_PANE_ID) | .id' "${out}/after-hsplit.json")"
for _ in {1..100}; do
    [[ -s "${out}/pane-env-${split_id}" ]] && break
    sleep 0.02
done
[[ -s "${out}/pane-env-${split_id}" ]]
jq -r '.[] | select(.id != env.ZENTTY_PANE_ID) | [.id,.controlToken] | @tsv' "${out}/after-hsplit.json" |
while IFS=$'\t' read -r id token; do
    env ZENTTY_PANE_TOKEN="${token}" "${cli}" pane close --pane-id "${id}"
done
for _ in {1..100}; do
    [[ "$("${cli}" list panes --json | jq 'length')" -eq 1 ]] && break
    sleep 0.02
done
"${cli}" vsplit --golden
for _ in {1..100}; do
    "${cli}" list panes --include-control-token --json >"${out}/after-vsplit.json"
    [[ "$(jq 'length' "${out}/after-vsplit.json")" -eq 2 ]] && break
    sleep 0.02
done
jq -r '.[] | select(.id != env.ZENTTY_PANE_ID) | [.id,.controlToken] | @tsv' "${out}/after-vsplit.json" |
while IFS=$'\t' read -r id token; do
    env ZENTTY_PANE_TOKEN="${token}" "${cli}" pane close --pane-id "${id}"
done

"${cli}" theme toggle >"${out}/theme-toggle.txt"
"${cli}" theme light >"${out}/theme-light.txt"
"${cli}" theme auto >"${out}/theme-auto.txt"

printf 'PASS\n' >"${out}/done"
for _ in {1..200}; do
    [[ -e "${out}/release" ]] && exit 0
    sleep 0.05
done
exit 1
CHILD
chmod 700 "${child}"

GDK_SCALE=1 GDK_DPI_SCALE=1 \
ZENTTY_CLI_CONTRACT_RECEIPTS="${receipts}" \
ZENTTY_REPO_ROOT="${repo_root}" \
LD_LIBRARY_PATH="${ghostty_root}/zig-out/lib:${layer_directory}${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}" \
    "${product}" --command "${child}" --state-directory "${state_directory}" --no-session-restore \
    >"${log}" 2>&1 &
product_pid=$!

for _ in {1..600}; do
    [[ -s "${receipts}/done" ]] && break
    kill -0 "${product_pid}" 2>/dev/null || fail "product exited before CLI receipts"
    sleep 0.05
done
[[ "$(cat "${receipts}/done" 2>/dev/null || true)" == PASS ]] || fail "staged CLI child failed"

jsonschema -i "${receipts}/overview.json" "${repo_root}/docs/design/cli-schemas/topology-overview-v1.schema.json"
jsonschema -i "${receipts}/windows.json" "${repo_root}/docs/design/cli-schemas/windows-v1.schema.json"
jsonschema -i "${receipts}/worklanes.json" "${repo_root}/docs/design/cli-schemas/worklanes-v1.schema.json"
jsonschema -i "${receipts}/panes.json" "${repo_root}/docs/design/cli-schemas/panes-v1.schema.json"

grep -Eq '^zentty [0-9]+\.[0-9]+\.[0-9]+ \([0-9a-f]{12}|unknown\)$' "${receipts}/version.txt" ||
    fail "version text contract changed"
[[ "$(head -1 "${receipts}/windows.txt")" == "$(head -1 "${repo_root}/docs/design/cli-goldens/windows-v1.txt")" ]] || fail "windows header changed"
[[ "$(head -1 "${receipts}/worklanes.txt")" == "$(head -1 "${repo_root}/docs/design/cli-goldens/worklanes-v1.txt")" ]] || fail "worklanes header changed"
[[ "$(head -1 "${receipts}/panes.txt")" == "$(head -1 "${repo_root}/docs/design/cli-goldens/panes-v1.txt")" ]] || fail "panes header changed"
grep -Fq 'unsupported output version "2"' "${receipts}/version-2.stderr" || fail "output version failure changed"
grep -Fq 'duplicate option --json' "${receipts}/duplicate.stderr" || fail "duplicate option failure changed"
grep -Fq 'could not resolve a pane for the requested selectors' "${receipts}/stale.stderr" || fail "stale selector did not fail closed"
grep -Fq 'duplicate option --pane-index' "${receipts}/ambiguous.stderr" || fail "ambiguous selector did not fail closed"
grep -Fq 'application capability rejected: pane token is invalid' \
    "${receipts}/wrong-token.stderr" || fail "wrong capability failure changed"
grep -Fq 'unauthorized_target' "${receipts}/stale-mutation.stderr" || fail "stale mutation did not fail closed"

# A split is a real Ghostty/PTY child, not a model-only row. Compare its
# inherited product resources with independently discovered topology.
split_id="$(jq -r '.[] | select(.id != "pane-1") | .id' "${receipts}/after-hsplit.json")"
split_token="$(jq -r --arg id "${split_id}" '.[] | select(.id == $id) | .controlToken' "${receipts}/after-hsplit.json")"
split_env="${receipts}/pane-env-${split_id}"
staged_cli="$(readlink -f "${product%/*}/zentty")"
[[ "$(sed -n 's/^cli=//p' "${split_env}")" == "${staged_cli}" ]] || fail "child CLI path is not staged"
[[ -S "$(sed -n 's/^socket=//p' "${split_env}")" ]] || fail "child socket is not live"
[[ "$(stat -c %a "$(sed -n 's/^socket=//p' "${split_env}")")" == 600 ]] || fail "child socket is not private"
[[ "$(stat -c %a "$(dirname "$(sed -n 's/^socket=//p' "${split_env}")")")" == 700 ]] || fail "child runtime directory is not private"
[[ "$(sed -n 's/^instance=//p' "${split_env}")" =~ ^[0-9a-f]{64}$ ]] || fail "child instance identity is invalid"
[[ "$(sed -n 's/^window=//p' "${split_env}")" == window-1 ]] || fail "child window identity drifted"
[[ "$(sed -n 's/^worklane=//p' "${split_env}")" == worklane-1 ]] || fail "child worklane identity drifted"
[[ "$(sed -n 's/^pane=//p' "${split_env}")" == "${split_id}" ]] || fail "child pane identity drifted"
[[ "${split_token}" == @file:/* ]] || fail "discovery exposed a capability instead of a credential reference"
[[ "$(sed -n 's/^token=//p' "${split_env}")" == "$(cat -- "${split_token#@file:}")" ]] ||
    fail "child capability differs from its authenticated credential file"
[[ "$(sed -n 's/^hook=//p' "${split_env}")" == "${staged_cli} ipc agent-event" ]] || fail "child hook command is not staged"
integration="$(sed -n 's/^integration=//p' "${split_env}")"
[[ -f "${integration}/zentty-bash-integration.bash" && -f "${integration}/zentty-zsh-integration.zsh" ]] || fail "child shell integration resources are missing"

# Evaluate the actual emitted shell program in an empty subshell and compare
# its exact exports to independently discovered JSON rather than trusting the
# renderer that wrote it.
# The single-quoted program is intentionally expanded by the child shell.
# shellcheck disable=SC2016
env -i bash -c 'source "$1"; printf "%s\n%s\n%s\n%s\n%s\n" "$ZENTTY_INSTANCE_SOCKET" "$ZENTTY_WINDOW_ID" "$ZENTTY_WORKLANE_ID" "$ZENTTY_PANE_ID" "$ZENTTY_PANE_TOKEN"' \
    bash "${receipts}/selected.shell" >"${receipts}/selected-evaluated.txt"
# The socket path is per-process and intentionally opaque. Check that it is a
# live Unix socket, then compare every topology value and the capability token
# against a separate authenticated discovery response.
[[ -S "$(head -1 "${receipts}/selected-evaluated.txt")" ]] ||
    fail "selected-pane shell exported a non-socket path"
tail -n +2 "${receipts}/selected-evaluated.txt" | cmp -s - <(jq -r '.[0] | [.windowID,.worklaneID,.id,.controlToken] | .[]' "${receipts}/panes-authenticated.json") ||
    fail "selected-pane shell exports changed values"

# Keep the first real application alive while starting a second staged
# process. Identical topology IDs are intentionally possible across processes;
# private sockets and pane capabilities must still isolate their authorities.
second_receipts="${run_root}/second-receipts"
second_state="${run_root}/second-state"
second_child="${run_root}/second-child"
second_log="${run_root}/second-product.log"
mkdir -p "${second_receipts}" "${second_state}"
cat >"${second_child}" <<'SECOND_CHILD'
#!/usr/bin/env bash
set -euo pipefail
{
    printf 'socket=%s\n' "${ZENTTY_INSTANCE_SOCKET}"
    printf 'instance=%s\n' "${ZENTTY_INSTANCE_ID}"
    printf 'token=%s\n' "${ZENTTY_PANE_TOKEN}"
} >"${ZENTTY_SECOND_RECEIPTS}/endpoint"
for _ in {1..400}; do
    [[ -e "${ZENTTY_SECOND_RECEIPTS}/release" ]] && exit 0
    sleep 0.05
done
exit 1
SECOND_CHILD
chmod 700 "${second_child}"
GDK_SCALE=1 GDK_DPI_SCALE=1 \
ZENTTY_SECOND_RECEIPTS="${second_receipts}" \
LD_LIBRARY_PATH="${ghostty_root}/zig-out/lib:${layer_directory}${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}" \
    "${product}" --command "${second_child}" --state-directory "${second_state}" --no-session-restore \
    >"${second_log}" 2>&1 &
second_product_pid=$!
for _ in {1..400}; do
    [[ -s "${second_receipts}/endpoint" ]] && break
    kill -0 "${second_product_pid}" 2>/dev/null || fail "second staged instance exited before endpoint publication"
    sleep 0.05
done
[[ -s "${second_receipts}/endpoint" ]] || fail "second staged instance did not publish its endpoint"
first_socket="$(head -1 "${receipts}/selected-evaluated.txt")"
first_token="$(tail -1 "${receipts}/selected-evaluated.txt")"
second_socket="$(sed -n 's/^socket=//p' "${second_receipts}/endpoint")"
second_instance="$(sed -n 's/^instance=//p' "${second_receipts}/endpoint")"
second_token="$(sed -n 's/^token=//p' "${second_receipts}/endpoint")"
[[ "${second_socket}" != "${first_socket}" && -S "${second_socket}" ]] || fail "concurrent instances shared a socket"
[[ "$(stat -c %a "${second_socket}")" == 600 && "$(stat -c %a "$(dirname "${second_socket}")")" == 700 ]] || fail "second instance endpoint is not private"
[[ "${second_instance}" =~ ^[0-9a-f]{64}$ && "${second_instance}" != "$(sed -n 's/^instance=//p' "${split_env}")" ]] || fail "concurrent instances shared an identity"
[[ "${second_token}" =~ ^[0-9a-f]{64}$ && "${second_token}" != "${first_token}" ]] || fail "concurrent instances shared a pane capability"
if env ZENTTY_INSTANCE_SOCKET="${second_socket}" ZENTTY_PANE_TOKEN="${first_token}" \
    "${staged_cli}" list panes --json >/dev/null 2>&1; then fail "first capability crossed into second instance"; fi
if env ZENTTY_INSTANCE_SOCKET="${first_socket}" ZENTTY_PANE_TOKEN="${second_token}" \
    "${staged_cli}" list panes --json >/dev/null 2>&1; then fail "second capability crossed into first instance"; fi
env ZENTTY_INSTANCE_SOCKET="${second_socket}" ZENTTY_PANE_TOKEN="${second_token}" \
    "${staged_cli}" worklane rename "Second isolated"
env ZENTTY_INSTANCE_SOCKET="${second_socket}" ZENTTY_PANE_TOKEN="${second_token}" \
    "${staged_cli}" list worklanes --json >"${second_receipts}/worklanes.json"
if env -u ZENTTY_INSTANCE_SOCKET -u ZENTTY_PANE_TOKEN -u ZENTTY_INSTANCE_ID \
    "${staged_cli}" list worklanes --json >/dev/null 2>&1; then
    fail "ambient discovery silently selected one of multiple instances"
fi
env -u ZENTTY_INSTANCE_SOCKET -u ZENTTY_PANE_TOKEN \
    ZENTTY_INSTANCE_ID="${second_instance}" \
    "${staged_cli}" list worklanes --json >"${second_receipts}/discovered-worklanes.json"
cmp -s "${second_receipts}/worklanes.json" "${second_receipts}/discovered-worklanes.json" ||
    fail "explicit instance discovery selected the wrong product"
env ZENTTY_INSTANCE_SOCKET="${first_socket}" ZENTTY_PANE_TOKEN="${first_token}" \
    "${staged_cli}" list worklanes --json >"${receipts}/first-after-second-mutation.json"
jq -e '.[0].title == "Second isolated"' "${second_receipts}/worklanes.json" >/dev/null || fail "second instance mutation missed its authority"
jq -e 'all(.[]; (.title // "") != "Second isolated")' "${receipts}/first-after-second-mutation.json" >/dev/null || fail "second instance mutation crossed into first instance"
touch "${second_receipts}/release"
wait "${second_product_pid}" || fail "second staged instance did not exit cleanly"
second_product_pid=""

touch "${receipts}/release"
echo "rust-cli-contract-${backend}: PASS staged-cli=true real-product=true authenticated-socket=true concurrent-instances=true aliases=true schemas=4 text-goldens=true hostile-shell-unit=true fail-closed=true"
