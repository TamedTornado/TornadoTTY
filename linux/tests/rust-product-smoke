#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
product="${ZENTTY_LINUX_BINARY:-${repo_root}/build/linux/bin/zentty-linux}"
backend="${GDK_BACKEND:-}"
bundle_root="$(cd "$(dirname "${product}")/.." 2>/dev/null && pwd)" || bundle_root=""
bundle_lib="${bundle_root}/lib"
build_metadata="${bundle_root}/build-metadata"
fixture="${repo_root}/crates/zentty-core/tests/fixtures/session-restore-v3.json"
scenario="${ZENTTY_RUST_SCENARIO:-single}"
terminal_count="${ZENTTY_RUST_TERMINALS:-1}"
lifecycle_cycles="${ZENTTY_RUST_CYCLES:-1}"
startup_attempts="${ZENTTY_RUST_STARTUP_ATTEMPTS:-200}"
async_backend="${ZENTTY_LINUX_ASYNC_BACKEND:-default}"
physical_input="${ZENTTY_RUST_PHYSICAL_INPUT:-false}"
x11_physical_input="${ZENTTY_RUST_X11_PHYSICAL_INPUT:-true}"
[[ "${async_backend}" == auto ]] && async_backend=default

# shellcheck source=linux/tests/lib/product-input
source "${repo_root}/linux/tests/lib/product-input"

fail() {
    echo "rust-product-smoke: error: $*" >&2
    exit 1
}

[[ "${backend}" == wayland || "${backend}" == x11 ]] ||
    fail "GDK_BACKEND must be wayland or x11"
[[ "${scenario}" == single || "${scenario}" == lifecycle || "${scenario}" == opener || "${scenario}" == activation || "${scenario}" == shell-startup || "${scenario}" == worklane-switch ]] ||
    fail "unknown ZENTTY_RUST_SCENARIO: ${scenario}"
[[ "${terminal_count}" =~ ^[1-9][0-9]*$ ]] || fail "invalid terminal count"
[[ "${lifecycle_cycles}" =~ ^[1-9][0-9]*$ ]] || fail "invalid lifecycle cycle count"
[[ "${startup_attempts}" =~ ^[1-9][0-9]*$ ]] || fail "invalid startup attempt count"
[[ "${async_backend}" == default || "${async_backend}" == epoll ||
    "${async_backend}" == io_uring ]] || fail "invalid async backend"
[[ "${physical_input}" == true || "${physical_input}" == false ]] ||
    fail "ZENTTY_RUST_PHYSICAL_INPUT must be true or false"
[[ "${x11_physical_input}" == true || "${x11_physical_input}" == false ]] ||
    fail "ZENTTY_RUST_X11_PHYSICAL_INPUT must be true or false"
physical_journey=false
if [[ ("${backend}" == x11 && "${x11_physical_input}" == true) ||
    "${physical_input}" == true ]]; then
    physical_journey=true
fi
[[ -x "${product}" ]] || fail "delivered Rust product is not built: ${product}"
product_command=("${product}")
if (($# > 0)); then
    product_command=("$@")
    [[ " ${product_command[*]} " == *" ${product} "* ]] ||
        fail "custom product command must contain the selected product binary"
fi
[[ -f "${bundle_lib}/libghostty-gtk-embed.so" ]] ||
    fail "selected product bundle has no Ghostty library"
[[ -f "${bundle_lib}/libgtk4-layer-shell.so" ]] ||
    fail "selected product bundle has no GTK layer-shell library"
if [[ -n "${ZENTTY_EXPECTED_PRODUCT_PROFILE:-}" ]]; then
    [[ -f "${build_metadata}" ]] || fail "selected product bundle has no build metadata"
    actual_profile="$(sed -n 's/^product_profile=//p' "${build_metadata}")"
    [[ "${actual_profile}" == "${ZENTTY_EXPECTED_PRODUCT_PROFILE}" ]] ||
        fail "selected product profile is ${actual_profile}; expected ${ZENTTY_EXPECTED_PRODUCT_PROFILE}"
fi
command -v readelf >/dev/null || fail "readelf is required"
layer_runpath="$(
    readelf -d "${bundle_lib}/libghostty-gtk-embed.so" |
        sed -n 's/.*Library runpath: \[\([^]]*\)\].*/\1/p' |
        cut -d: -f1
)"
[[ "${layer_runpath}" == .zig-cache/* ]] ||
    fail "Ghostty library has no pinned relative layer-shell runpath"

log_owned=true
if [[ -n "${ZENTTY_RUST_PRODUCT_LOG_PATH:-}" ]]; then
    log="${ZENTTY_RUST_PRODUCT_LOG_PATH}"
    [[ ! -L "${log}" ]] || fail "product log path may not be a symbolic link"
    : >"${log}"
    log_owned=false
else
    log="$(mktemp)"
fi
barrier="$(mktemp -d)"
state_directory=""
product_pid=""
final_status=0
cleanup() {
    if [[ "${product_pid}" =~ ^[1-9][0-9]*$ ]]; then
        kill -TERM "${product_pid}" 2>/dev/null || true
        wait "${product_pid}" 2>/dev/null || true
    fi
    [[ "${log_owned}" == false ]] || rm -f -- "${log}"
    rm -rf -- "${barrier}"
    [[ -z "${state_directory}" ]] || rm -rf -- "${state_directory}"
}
trap cleanup EXIT

if [[ "${scenario}" == worklane-switch ]]; then
    # shellcheck source=linux/tests/lib/product-worklane-switch
    source "${repo_root}/linux/tests/lib/product-worklane-switch"
    zentty_check_worklane_switch
    exit 0
fi

if [[ "${scenario}" == shell-startup ]]; then
    # shellcheck source=linux/tests/lib/product-shell-startup
    source "${repo_root}/linux/tests/lib/product-shell-startup"
    zentty_check_shell_startup
    exit 0
fi

if [[ "${scenario}" == activation ]]; then
    # shellcheck source=linux/tests/lib/product-desktop-activation
    source "${repo_root}/linux/tests/lib/product-desktop-activation"
    zentty_check_desktop_activation
    exit 0
fi

if [[ "${scenario}" == opener ]]; then
    [[ "${physical_journey}" == true ]] || fail "opener regression requires physical input"
    mkdir -p "${barrier}/bin" "${XDG_CONFIG_HOME:?}/ghostty"
    printf '\nkeybind = f8=write_screen_file:open\n' >>"${XDG_CONFIG_HOME}/ghostty/config"
    export ZENTTY_OPENER_RECEIPTS="${barrier}/opener-pids"
    cat >"${barrier}/bin/xdg-open" <<'EOF'
#!/bin/sh
set -eu
test -f "$1"
grep -q GH183-SCREEN "$1"
printf '%s\n' "$$" >>"$ZENTTY_OPENER_RECEIPTS"
printf 'GH183-first\n\n' >&2
i=0
while [ "$i" -lt 600 ]; do printf x >&2; i=$((i+1)); done
printf '\nGH183-last' >&2
EOF
    chmod +x "${barrier}/bin/xdg-open"
    export PATH="${barrier}/bin:${PATH}"
fi

if [[ "${scenario}" == lifecycle ]]; then
    child_command="printf '\\033]2;zentty-rust-smoke-${backend}\\a'; sleep 0.1"
elif [[ "${physical_journey}" == true ]]; then
    if [[ "${backend}" == x11 ]]; then
        command -v xdotool >/dev/null || fail "xdotool is required for real X11 input and resize"
    fi
    # The escaped dollar intentionally defers child-shell expansion.
    # shellcheck disable=SC2016
    child_command="IFS= read -r value; [ \"\$value\" = zentty-rust-input ] || exit 44; printf '\\033]2;zentty-rust-smoke-${backend}\\a'; sleep 0.1"
else
    child_command="printf '\\033]2;zentty-rust-smoke-${backend}\\a'; sleep 0.1"
fi
if [[ "${scenario}" == opener ]]; then
    child_command="printf 'GH183-SCREEN\\n'; ${child_command}"
fi

run_cycle() {
    local product_args
    state_directory="$(mktemp -d)"
    if ((terminal_count > 1)); then
        jq '.restoreDraftWindows = []' "${fixture}" >"${state_directory}/restore-snapshot.json"
    fi
    [[ "${scenario}" == opener ]] || find "${barrier}" -type f -delete
    product_args=(
        --command "${child_command}"
        --state-directory "${state_directory}"
        --async-backend "${async_backend}"
    )
    ((terminal_count > 1)) || product_args+=(--no-session-restore)
    set +e
    LD_LIBRARY_PATH="${bundle_lib}${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}" \
    "${product_command[@]}" "${product_args[@]}" >>"${log}" 2>&1 &
    product_pid=$!
    set -e
}

run_cycle
if [[ ("${scenario}" == single || "${scenario}" == opener) && "${physical_journey}" == true ]]; then
    zentty_product_prepare_input "${backend}" "${log}" "${startup_attempts}" ||
        fail "controlled ${backend} input did not become ready"
    if [[ "${backend}" == x11 ]]; then
        xdotool windowsize --sync "${ZENTTY_PRODUCT_WINDOW_ID}" 820 640
    fi
    sleep 0.1
    if [[ "${scenario}" == opener ]]; then
        # The real Ghostty screen-file action uses the same fallback opener as
        # URL clicks, without depending on font-specific link coordinates.
        for invocation in 1 2 3; do
            zentty_product_key "${backend}" F8
            for ((attempt = 0; attempt < 100; attempt++)); do
                count="$(grep -Fc 'warning(os-open): open stderr=GH183-last' "${log}" || true)"
                [[ "${count}" -eq "${invocation}" ]] && break
                [[ "$(stat -c %s "${log}")" -lt 1048576 ]] || fail "opener flooded the product log"
                sleep 0.05
            done
            [[ "${count}" -eq "${invocation}" ]] || fail "opener did not finish reading stderr"
        done
        [[ "$(wc -l <"${ZENTTY_OPENER_RECEIPTS}")" -eq 3 ]] || fail "controlled opener was not invoked three times"
        while read -r opener_pid; do
            for ((attempt = 0; attempt < 100; attempt++)); do
                [[ -e "/proc/${opener_pid}" ]] || break
                sleep 0.05
            done
            [[ ! -e "/proc/${opener_pid}" ]] || fail "opener child was not reaped"
        done <"${ZENTTY_OPENER_RECEIPTS}"
        [[ "$(grep -Fxc 'warning(os-open): open stderr=' "${log}" || true)" -eq 3 ]] ||
            fail "blank stderr records were repeated or lost"
    fi
    zentty_product_type "${backend}" zentty-rust-input
    zentty_product_key "${backend}" Return
fi

wait_for_cycle() {
    set +e
    wait "${product_pid}"
    status=$?
    set -e
    product_pid=""
    if [[ "${status}" -eq 99 ]]; then
        # Valgrind's governed --error-exitcode preserves a completed product
        # lifecycle while marking post-suppression findings. Finish the actor's
        # semantic assertions, then propagate the instrumentation status.
        final_status=99
    elif [[ "${status}" -ne 0 ]]; then
        cat "${log}" >&2
        fail "product exited ${status} before terminal lifecycle completed"
    fi
    rm -rf -- "${state_directory}"
    state_directory=""
}

wait_for_cycle
for ((cycle = 2; cycle <= lifecycle_cycles; cycle++)); do
    run_cycle
    wait_for_cycle
done
expected_events=$((terminal_count * lifecycle_cycles))
assert_log_count() {
    local expected="$1"
    local line="$2"
    local failure="$3"
    if [[ "$(grep -Fxc "${line}" "${log}" || true)" -ne "${expected}" ]]; then
        cat "${log}" >&2
        fail "${failure}"
    fi
}
assert_log_occurrences() {
    local expected="$1"
    local marker="$2"
    local failure="$3"
    local actual
    actual="$(grep -Fo -- "${marker}" "${log}" | wc -l || true)"
    if [[ "${actual}" -ne "${expected}" ]]; then
        cat "${log}" >&2
        fail "${failure}"
    fi
}
assert_log_occurrences "${expected_events}" 'zentty-linux: terminal-ready-pane=' \
    "product did not acknowledge every real Ghostty terminal"
assert_log_count "${expected_events}" "zentty-linux: title=zentty-rust-smoke-${backend}" \
    "PTY output did not reach every real Ghostty title property"
assert_log_count "${expected_events}" 'zentty-linux: child-exited' \
    "product did not acknowledge every child exit"
assert_log_count "${lifecycle_cycles}" 'zentty-linux: lifecycle complete' \
    "product did not complete every lifecycle cycle"
if [[ "${backend}" == x11 && "${scenario}" == single &&
    "${physical_journey}" == true ]]; then
    grep -Fx 'zentty-linux: window-size=820x640' "${log}" >/dev/null || {
        cat "${log}" >&2
        fail "externally driven X11 resize did not reach the delivered product"
    }
fi

if [[ "${ZENTTY_RUST_EMIT_PRODUCT_LOG:-0}" == 1 ]]; then
    cat "${log}"
fi

echo "Rust product smoke passed: ${backend}, scenario=${scenario}, terminals=${terminal_count}, cycles=${lifecycle_cycles}"
exit "${final_status}"
