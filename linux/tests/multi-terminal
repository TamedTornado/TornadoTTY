#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
binary="${repo_root}/build/linux/bin/zentty-linux"
backend="${GDK_BACKEND:-wayland}"
receipt="${repo_root}/build/linux/multi-terminal-${backend}.log"

if [[ ! -x "${binary}" ]]; then
    echo "error: ${binary} does not exist; run linux/scripts/build-local" >&2
    exit 1
fi

GDK_BACKEND="${backend}" \
ZENTTY_LINUX_INTEGRATION_TEST=1 \
ZENTTY_LINUX_INTEGRATION_SURFACES=4 \
timeout 20s "${binary}" >"${receipt}" 2>&1

grep -F "zentty-linux: focus transitions confirmed=4" "${receipt}" >/dev/null
grep -F "zentty-linux: resize observed" "${receipt}" >/dev/null
grep -F "zentty-linux: integration PASS surfaces=4 initialized=4 titles=4 children=4 focus=4 resize=1 keyboard=0 clipboard=0/0 tick_failed=0" \
    "${receipt}" >/dev/null

echo "Zentty Linux multi-terminal integration passed (${backend})"
