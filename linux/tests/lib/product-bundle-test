#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)"
# shellcheck source=linux/tests/lib/product-bundle
source "${repo_root}/linux/tests/lib/product-bundle"
temporary="$(mktemp -d)"
trap 'rm -rf -- "${temporary}"' EXIT

mkdir -p "${temporary}/bundle/bin" "${temporary}/bundle/lib" "${temporary}/bin"
cat >"${temporary}/readelf" <<'EOF'
#!/usr/bin/env bash
printf ' 0x000000000000001d (RUNPATH) Library runpath: [.zig-cache/o/example]\n'
EOF
chmod +x "${temporary}/readelf"
printf '#!/usr/bin/env bash\n' >"${temporary}/bundle/bin/zentty-linux"
chmod +x "${temporary}/bundle/bin/zentty-linux"
: >"${temporary}/bundle/lib/libghostty-gtk-embed.so"
: >"${temporary}/bundle/lib/libgtk4-layer-shell.so"

PATH="${temporary}:${PATH}" \
    zentty_product_bundle_resolve "${temporary}/bundle/bin/zentty-linux"
[[ "${ZENTTY_PRODUCT_BINARY}" == "${temporary}/bundle/bin/zentty-linux" ]]
[[ "${ZENTTY_PRODUCT_BUNDLE_ROOT}" == "${temporary}/bundle" ]]
[[ "${ZENTTY_PRODUCT_BUNDLE_LIB}" == "${temporary}/bundle/lib" ]]

rm "${temporary}/bundle/lib/libgtk4-layer-shell.so"
if PATH="${temporary}:${PATH}" \
    zentty_product_bundle_resolve "${temporary}/bundle/bin/zentty-linux" \
    >/dev/null 2>&1; then
    echo "product-bundle-test: missing layer-shell library was accepted" >&2
    exit 1
fi

echo "Product bundle resolver tests passed"
