#!/usr/bin/env bash

zentty_product_wait_for_log() {
    local log="$1"
    local pattern="$2"
    local message="$3"
    local attempts="${4:-200}"
    local index
    for ((index = 0; index < attempts; index++)); do
        grep -Fq "${pattern}" "${log}" 2>/dev/null && return 0
        sleep 0.05
    done
    echo "product-input: ${message}" >&2
    return 1
}

zentty_product_wait_for_log_count() {
    local log="$1"
    local pattern="$2"
    local minimum="$3"
    local message="$4"
    local attempts="${5:-200}"
    local index count
    for ((index = 0; index < attempts; index++)); do
        count="$(grep -Fc "${pattern}" "${log}" 2>/dev/null || true)"
        [[ "${count}" -ge "${minimum}" ]] && return 0
        sleep 0.05
    done
    echo "product-input: ${message}" >&2
    return 1
}

zentty_process_is_running() {
    local pid="$1"
    local state

    [[ "${pid}" =~ ^[1-9][0-9]*$ ]] || return 1
    kill -0 "${pid}" 2>/dev/null || return 1
    state="$(ps -o stat= -p "${pid}" 2>/dev/null || true)"
    [[ -n "${state}" && "${state}" != Z* ]]
}

zentty_wait_for_owned_process() {
    local pid="$1"
    local label="$2"
    local attempts="${3:-200}"
    local interval="${4:-0.05}"
    local index status

    [[ "${pid}" =~ ^[1-9][0-9]*$ ]] || {
        echo "product-input: ${label} has an invalid PID" >&2
        return 64
    }
    [[ "${attempts}" =~ ^[1-9][0-9]*$ ]] || {
        echo "product-input: ${label} exit attempts must be a positive integer" >&2
        return 64
    }
    for ((index = 0; index < attempts; index++)); do
        if ! zentty_process_is_running "${pid}"; then
            if wait "${pid}"; then
                return 0
            else
                status=$?
                echo "product-input: ${label} exited with status ${status}" >&2
                return "${status}"
            fi
        fi
        sleep "${interval}"
    done
    echo "product-input: timed out waiting for ${label} (pid=${pid})" >&2
    return 124
}

zentty_product_uses_xdotool() {
    [[ "$1" == x11 || "${ZENTTY_NESTED_WAYLAND_OUTER_X11_INPUT:-}" == 1 ]]
}

zentty_product_find_x11_window() {
    local pid="$1"
    local attempts="${2:-200}"
    local attempt candidate owner

    [[ "${pid}" =~ ^[1-9][0-9]*$ ]] || {
        echo "product-input: X11 window lookup requires the real product PID" >&2
        return 1
    }
    [[ "${attempts}" =~ ^[1-9][0-9]*$ ]] || {
        echo "product-input: X11 window lookup attempts must be a positive integer" >&2
        return 1
    }
    for ((attempt = 0; attempt < attempts; attempt++)); do
        candidate="$(
            xdotool search --onlyvisible --pid "${pid}" --name '^Zentty$' \
                2>/dev/null | head -1 || true
        )"
        if [[ "${candidate}" =~ ^[1-9][0-9]*$ ]]; then
            owner="$(xdotool getwindowpid "${candidate}" 2>/dev/null || true)"
            if [[ "${owner}" == "${pid}" ]]; then
                printf '%s\n' "${candidate}"
                return 0
            fi
        fi
        sleep 0.05
    done
    echo "product-input: mapped X11 window owned by product ${pid} did not appear" >&2
    return 1
}

zentty_product_xdotool_key() {
    # Keep these as compositor-visible XTEST events. `xdotool key --window`
    # falls back to XSendEvent when the target does not already own focus;
    # GTK popovers correctly ignore that synthetic delivery even though a
    # terminal surface may happen to accept it. Qualification must exercise
    # the same focus and key path as physical input.
    xdotool windowfocus --sync "${ZENTTY_PRODUCT_WINDOW_ID}"
    xdotool key "$@"
}

zentty_product_prepare_input() {
    local backend="$1"
    local log="$2"
    local attempts="${3:-200}"
    [[ "${attempts}" =~ ^[1-9][0-9]*$ ]] || {
        echo "product-input: input readiness attempts must be a positive integer" >&2
        return 1
    }
    case "${backend}" in
        x11)
            command -v xdotool >/dev/null || {
                echo "product-input: xdotool is required" >&2
                return 1
            }
            [[ "${product_pid:-}" =~ ^[1-9][0-9]*$ ]] || {
                echo "product-input: X11 input requires the real product PID" >&2
                return 1
            }
            # A name-only search can race a withdrawing window from a previous
            # journey. Bind input to this caller's mapped, PID-owned window.
            ZENTTY_PRODUCT_WINDOW_ID="$(
                zentty_product_find_x11_window "${product_pid}" "${attempts}"
            )" || return 1
            xdotool windowfocus --sync "${ZENTTY_PRODUCT_WINDOW_ID}"
            xdotool mousemove --window "${ZENTTY_PRODUCT_WINDOW_ID}" 700 400 click 1
            # The initially selected pane does not emit `focus-pane` when it
            # receives focus because product selection did not change. Prove
            # the real X server focused this product instead; the journey's
            # exact PTY acknowledgement then proves terminal-child focus.
            local focused_window focused_pid
            focused_window="$(xdotool getwindowfocus 2>/dev/null || true)"
            focused_pid="$(xdotool getwindowpid "${focused_window}" 2>/dev/null || true)"
            if [[ "${focused_pid}" != "${product_pid}" ]]; then
                if [[ "${ZENTTY_NESTED_WAYLAND_XWAYLAND_PROFILE:-0}" == 1 &&
                    "${ZENTTY_NESTED_XWAYLAND_PID:-}" =~ ^[1-9][0-9]*$ &&
                    "${ZENTTY_NESTED_WAYLAND_INPUT_SESSION_ID:-}" =~ ^[0-9a-f]{64}$ &&
                    "${DISPLAY:-}" == "${ZENTTY_NESTED_XWAYLAND_DISPLAY:-missing}" &&
                    -z "${focused_window}" ]]; then
                    : # Rootless Xwayland reports PointerRoot; PTY input proves focus below.
                else
                    echo "product-input: real X11 focus is not owned by the product (window=${focused_window:-missing} focused-pid=${focused_pid:-missing} product-window=${ZENTTY_PRODUCT_WINDOW_ID} product-pid=${product_pid})" >&2
                    return 1
                fi
            fi
            ;;
        wayland)
            [[ "${ZENTTY_NESTED_WAYLAND_INPUT_SESSION_ID:-}" =~ ^[0-9a-f]{64}$ ]] || {
                echo "product-input: Wayland input is not in the private input-capable session" >&2
                return 1
            }
            zentty_product_wait_for_log "${log}" 'zentty-linux: window-size=' \
                "Wayland product window did not report presentation readiness" \
                "${attempts}"
            if [[ "${ZENTTY_NESTED_WAYLAND_OUTER_X11_INPUT:-}" == 1 ]]; then
                command -v xdotool >/dev/null || {
                    echo "product-input: xdotool is required for outer-X11 Wayland input" >&2
                    return 1
                }
                ZENTTY_PRODUCT_WINDOW_ID=""
                for ((attempt = 0; attempt < attempts; attempt++)); do
                    if [[ "${ZENTTY_NESTED_WAYLAND_OUTER_X11_WINDOW:-}" =~ ^[1-9][0-9]*$ ]]; then
                        ZENTTY_PRODUCT_WINDOW_ID="${ZENTTY_NESTED_WAYLAND_OUTER_X11_WINDOW}"
                    elif [[ "${ZENTTY_NESTED_WAYLAND_OUTER_X11_PID:-}" =~ ^[1-9][0-9]*$ ]]; then
                        ZENTTY_PRODUCT_WINDOW_ID="$(
                            xdotool search --onlyvisible \
                                --pid "${ZENTTY_NESTED_WAYLAND_OUTER_X11_PID}" \
                                2>/dev/null | head -1 || true
                        )"
                    else
                        ZENTTY_PRODUCT_WINDOW_ID="$(
                            xdotool search --onlyvisible --class '^Weston Compositor$' \
                                2>/dev/null | head -1 || true
                        )"
                    fi
                    [[ "${ZENTTY_PRODUCT_WINDOW_ID}" =~ ^[1-9][0-9]*$ ]] && break
                    sleep 0.05
                done
                [[ "${ZENTTY_PRODUCT_WINDOW_ID}" =~ ^[1-9][0-9]*$ ]] || {
                    echo "product-input: outer Wayland compositor window did not appear" >&2
                    return 1
                }
                xdotool windowfocus --sync "${ZENTTY_PRODUCT_WINDOW_ID}"
            else
                command -v wtype >/dev/null || {
                    echo "product-input: wtype is required" >&2
                    return 1
                }
                ZENTTY_PRODUCT_WINDOW_ID=""
            fi
            ;;
        *)
            echo "product-input: unsupported backend: ${backend}" >&2
            return 1
            ;;
    esac
    export ZENTTY_PRODUCT_WINDOW_ID
}

zentty_product_key() {
    local backend="$1"
    local key="$2"
    if zentty_product_uses_xdotool "${backend}"; then
        zentty_product_xdotool_key "${key}"
    else
        wtype -k "${key}"
    fi
}

zentty_product_ctrl_key() {
    local backend="$1"
    local key="$2"
    if zentty_product_uses_xdotool "${backend}"; then
        zentty_product_xdotool_key "ctrl+${key}"
    else
        wtype -M ctrl -k "${key}" -m ctrl
    fi
}

zentty_product_ctrl_alt_key() {
    local backend="$1"
    local key="$2"
    if zentty_product_uses_xdotool "${backend}"; then
        zentty_product_xdotool_key "ctrl+alt+${key}"
    else
        wtype -M ctrl -M alt -k "${key}" -m alt -m ctrl
    fi
}

zentty_product_shift_key() {
    local backend="$1"
    local key="$2"
    if zentty_product_uses_xdotool "${backend}"; then
        zentty_product_xdotool_key "shift+${key}"
    else
        wtype -M shift -k "${key}" -m shift
    fi
}

zentty_product_ctrl_shift_key() {
    local backend="$1"
    local key="$2"
    if zentty_product_uses_xdotool "${backend}"; then
        zentty_product_xdotool_key "ctrl+shift+${key}"
    else
        wtype -M ctrl -M shift -k "${key}" -m shift -m ctrl
    fi
}

zentty_product_move_pointer_to_terminal() {
    local backend="$1"
    if zentty_product_uses_xdotool "${backend}"; then
        [[ "${ZENTTY_PRODUCT_WINDOW_ID:-}" =~ ^[1-9][0-9]*$ ]] || {
            echo "product-input: pointer move requires a prepared product window" >&2
            return 1
        }
        xdotool windowfocus --sync "${ZENTTY_PRODUCT_WINDOW_ID}"
        xdotool mousemove --window "${ZENTTY_PRODUCT_WINDOW_ID}" 700 400
        return
    fi
    echo "product-input: controlled terminal pointer movement is unavailable for backend ${backend}" >&2
    return 1
}

zentty_product_set_file_clipboard() {
    local backend="$1"
    shift
    (( $# > 0 )) || {
        echo "product-input: file clipboard requires at least one file" >&2
        return 1
    }
    local path
    for path in "$@"; do
        [[ "${path}" == /* && -f "${path}" ]] || {
            echo "product-input: file clipboard requires absolute file paths" >&2
            return 1
        }
    done
    case "${backend}" in
        x11)
            command -v xclip >/dev/null || {
                echo "product-input: xclip is required" >&2
                return 1
            }
            for path in "$@"; do
                printf 'file://%s\r\n' "${path}"
            done | xclip -selection clipboard -target text/uri-list -in
            # xclip owns the X selection asynchronously. Under parallel real-
            # compositor qualification, an immediate Ctrl+Shift+V can precede
            # ownership publication even though xclip has returned success.
            # Read the real TARGETS selection before allowing physical paste.
            for _ in {1..200}; do
                if xclip -selection clipboard -target TARGETS -out 2>/dev/null |
                    grep -Fxq 'text/uri-list'; then
                    return 0
                fi
                sleep 0.05
            done
            echo "product-input: X11 file clipboard did not publish text/uri-list" >&2
            return 1
            ;;
        wayland)
            command -v wl-copy >/dev/null || {
                echo "product-input: wl-copy is required" >&2
                return 1
            }
            for path in "$@"; do
                printf 'file://%s\r\n' "${path}"
            done | wl-copy --type text/uri-list
            ;;
        *)
            echo "product-input: unsupported backend: ${backend}" >&2
            return 1
            ;;
    esac
}

zentty_product_set_png_clipboard() {
    local backend="$1"
    local path="$2"
    [[ "${path}" == /* && -f "${path}" ]] || {
        echo "product-input: image clipboard requires one absolute PNG file" >&2
        return 1
    }
    case "${backend}" in
        x11)
            command -v xclip >/dev/null || {
                echo "product-input: xclip is required" >&2
                return 1
            }
            xclip -selection clipboard -target image/png -in <"${path}"
            ;;
        wayland)
            command -v wl-copy >/dev/null || {
                echo "product-input: wl-copy is required" >&2
                return 1
            }
            wl-copy --type image/png <"${path}"
            ;;
        *)
            echo "product-input: unsupported backend: ${backend}" >&2
            return 1
            ;;
    esac
}

zentty_product_drag_from_x11_window() {
    local source_title="$1"
    local source_receipt="$2"
    local source_window
    [[ -n "${ZENTTY_PRODUCT_WINDOW_ID:-}" ]] || {
        echo "product-input: product window is not initialized" >&2
        return 1
    }
    source_window=""
    for _ in {1..250}; do
        source_window="$(xdotool search --onlyvisible --name "^${source_title}$" 2>/dev/null | tail -1 || true)"
        [[ "${source_window}" =~ ^[1-9][0-9]*$ ]] && break
        sleep 0.02
    done
    [[ "${source_window}" =~ ^[1-9][0-9]*$ ]] || {
        echo "product-input: drag source window was not found" >&2
        return 1
    }
    xdotool windowmove "${source_window}" 1040 100
    xdotool windowsize "${source_window}" 220 100
    xdotool mousemove --sync --window "${ZENTTY_PRODUCT_WINDOW_ID}" 700 350
    local pointer_before
    pointer_before="$(grep -Fxc pointer-target "${source_receipt}" || true)"
    local pickup_y=""
    for candidate_y in 35 45 55 65 75 85 95 105 115; do
        xdotool mousemove --sync --window "${source_window}" 110 "${candidate_y}"
        sleep 0.03
        if (( $(grep -Fxc pointer-target "${source_receipt}" || true) > pointer_before )); then
            pickup_y="${candidate_y}"
            break
        fi
    done
    [[ -n "${pickup_y}" ]] || {
        echo "product-input: pointer did not enter drag source" >&2
        return 1
    }
    xdotool mousedown 1
    sleep 0.25
    xdotool mousemove_relative --sync -- 30 30
    for _ in {1..100}; do
        grep -Fq 'drag-begin:' "${source_receipt}" && break
        sleep 0.02
    done
    grep -Fq 'drag-begin:' "${source_receipt}" || {
        xdotool mouseup 1
        echo "product-input: GTK drag did not begin" >&2
        return 1
    }
    for target_x in 1000 950 900 850 800 750 700; do
        xdotool mousemove --sync --window "${ZENTTY_PRODUCT_WINDOW_ID}" "${target_x}" 350
        sleep 0.12
    done
    xdotool mouseup 1
}

zentty_product_drag_in_nested_wayland() {
    local source_receipt="$1"
    local pointer_before pickup_x pickup_y candidate_x candidate_y target_x target_y
    [[ "${ZENTTY_NESTED_WAYLAND_OUTER_X11_INPUT:-}" == 1 ]] || {
        echo "product-input: nested Wayland drag lacks outer-X11 input" >&2
        return 1
    }
    [[ "${ZENTTY_PRODUCT_WINDOW_ID:-}" =~ ^[1-9][0-9]*$ ]] || {
        echo "product-input: outer Weston window is not initialized" >&2
        return 1
    }

    pointer_before="$(grep -Fxc pointer-target "${source_receipt}" || true)"
    pickup_x=""
    pickup_y=""
    for candidate_y in 80 140 200 260 320 380 440 500 560 620 680 740 800 860 920; do
        for candidate_x in 80 160 240 320 400 480 560 640 720 800 880 960 1040 1120 1200; do
            xdotool mousemove --sync --window "${ZENTTY_PRODUCT_WINDOW_ID}" \
                "${candidate_x}" "${candidate_y}"
            sleep 0.01
            if (( $(grep -Fxc pointer-target "${source_receipt}" || true) > pointer_before )); then
                pickup_x="${candidate_x}"
                pickup_y="${candidate_y}"
                break 2
            fi
        done
    done
    [[ -n "${pickup_x}" ]] || {
        echo "product-input: pointer did not enter nested Wayland drag source" >&2
        return 1
    }
    if [[ -n "${ZENTTY_NESTED_WAYLAND_DRAG_TARGET_X:-}" ||
        -n "${ZENTTY_NESTED_WAYLAND_DRAG_TARGET_Y:-}" ]]; then
        [[ "${ZENTTY_NESTED_WAYLAND_DRAG_TARGET_X:-}" =~ ^[1-9][0-9]*$ &&
            "${ZENTTY_NESTED_WAYLAND_DRAG_TARGET_Y:-}" =~ ^[1-9][0-9]*$ ]] || {
            echo "product-input: explicit nested Wayland drag target must be positive coordinates" >&2
            return 1
        }
        target_x="${ZENTTY_NESTED_WAYLAND_DRAG_TARGET_X}"
        target_y="${ZENTTY_NESTED_WAYLAND_DRAG_TARGET_Y}"
    else
        if (( pickup_x < 640 )); then target_x=1050; else target_x=230; fi
        if (( pickup_y < 512 )); then target_y=760; else target_y=260; fi
    fi
    xdotool mousedown 1
    sleep 0.25
    xdotool mousemove_relative --sync -- 30 30
    for _ in {1..100}; do
        grep -Fq 'drag-begin:' "${source_receipt}" && break
        sleep 0.02
    done
    grep -Fq 'drag-begin:' "${source_receipt}" || {
        xdotool mouseup 1
        echo "product-input: nested Wayland GTK drag did not begin" >&2
        return 1
    }
    for fraction in 1 2 3 4 5 6 7 8; do
        xdotool mousemove --sync --window "${ZENTTY_PRODUCT_WINDOW_ID}" \
            "$((pickup_x + (target_x - pickup_x) * fraction / 8))" \
            "$((pickup_y + (target_y - pickup_y) * fraction / 8))"
        sleep 0.1
    done
    xdotool mouseup 1
}

zentty_product_alt_key() {
    local backend="$1"
    local key="$2"
    if zentty_product_uses_xdotool "${backend}"; then
        zentty_product_xdotool_key "alt+${key}"
    else
        wtype -M alt -k "${key}" -m alt
    fi
}

zentty_product_close_window() {
    local backend="$1"
    # Ctrl+Q is Zentty's ordinary Linux quit-application shortcut. Driving it
    # through the compositor avoids a test-only lifecycle API and works in the
    # deliberately window-manager-free X11 qualification session.
    if zentty_product_uses_xdotool "${backend}"; then
        # Closing on key-down destroys the target before Xdotool can deliver
        # every synthetic release. The product log and process-exit assertions,
        # not Xdotool's expected asynchronous BadWindow status, prove success.
        zentty_product_xdotool_key ctrl+q 2>/dev/null || true
        sleep 0.1
        zentty_product_xdotool_key ctrl+q 2>/dev/null || true
        # Closing on key-down can also prevent XTest from delivering the
        # synthetic releases. Reset those global key states against the live
        # root window so the next real product in this intentionally reused X
        # server does not inherit a stuck Control/Q chord.
        xdotool keyup Control_L Control_R q 2>/dev/null || true
    else
        wtype -M ctrl -k q -m ctrl
    fi
}

zentty_product_type() {
    local backend="$1"
    local value="$2"
    if zentty_product_uses_xdotool "${backend}"; then
        xdotool windowfocus --sync "${ZENTTY_PRODUCT_WINDOW_ID}"
        xdotool type --delay 5 "${value}"
    else
        wtype "${value}"
    fi
}

zentty_product_establish_palette_input() {
    local backend="$1"
    local log="$2"
    local attempts="${3:-3}"
    local attempt shown_before hidden_before focus_before

    [[ "${attempts}" =~ ^[1-9][0-9]*$ ]] || {
        echo "product-input: palette readiness attempts must be a positive integer" >&2
        return 64
    }
    for ((attempt = 1; attempt <= attempts; attempt++)); do
        shown_before="$(grep -Fxc 'zentty-linux: command-palette=shown' "${log}" 2>/dev/null || true)"
        zentty_product_ctrl_shift_key "${backend}" p
        if zentty_product_wait_for_log_count "${log}" \
            'zentty-linux: command-palette=shown' "$((shown_before + 1))" \
            "physical command-palette shortcut was not delivered" 80; then
            hidden_before="$(grep -Fxc 'zentty-linux: command-palette=hidden' "${log}" 2>/dev/null || true)"
            focus_before="$(grep -Fc 'zentty-linux: focus-pane pane=' "${log}" 2>/dev/null || true)"
            zentty_product_key "${backend}" Escape
            zentty_product_wait_for_log_count "${log}" \
                'zentty-linux: command-palette=hidden' "$((hidden_before + 1))" \
                "command-palette readiness probe could not be dismissed" 80 || return
            zentty_product_wait_for_log_count "${log}" \
                'zentty-linux: focus-pane pane=' "$((focus_before + 1))" \
                "command-palette readiness probe did not restore terminal focus" 80 || return
            printf 'product-input: palette input ready after attempt %s\n' "${attempt}" >&2
            return 0
        fi

        # A nested compositor may map its first client before assigning its
        # keyboard focus. Reset a harmless Escape and explicitly click the
        # already-proven terminal allocation before the bounded retry.
        zentty_product_key "${backend}" Escape
        if zentty_product_uses_xdotool "${backend}"; then
            zentty_product_move_pointer_to_terminal "${backend}" || return
            xdotool click 1
        fi
    done
    echo "product-input: compositor never delivered the bounded palette input readiness probe" >&2
    return 1
}

zentty_product_disable_lifecycle_confirmations() {
    local config_file="${XDG_CONFIG_HOME:?}/zentty/config.toml"
    mkdir -p -- "$(dirname "${config_file}")"
    cat >"${config_file}" <<'EOF'
[confirmations]
confirm_before_closing_pane = false
confirm_before_closing_window = false
confirm_before_quitting = false
EOF
}
