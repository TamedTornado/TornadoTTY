#!/usr/bin/env bash

zentty_product_wait_for_log() {
    local log="$1"
    local pattern="$2"
    local message="$3"
    local attempts="${4:-200}"
    local index
    for ((index = 0; index < attempts; index++)); do
        grep -Fq "${pattern}" "${log}" && return 0
        sleep 0.05
    done
    echo "product-input: ${message}" >&2
    return 1
}

zentty_product_wait_for_log_count() {
    local log="$1"
    local pattern="$2"
    local minimum="$3"
    local message="$4"
    local attempts="${5:-200}"
    local index count
    for ((index = 0; index < attempts; index++)); do
        count="$(grep -Fc "${pattern}" "${log}" 2>/dev/null || true)"
        [[ "${count}" -ge "${minimum}" ]] && return 0
        sleep 0.05
    done
    echo "product-input: ${message}" >&2
    return 1
}

zentty_product_prepare_input() {
    local backend="$1"
    local log="$2"
    case "${backend}" in
        x11)
            command -v xdotool >/dev/null || {
                echo "product-input: xdotool is required" >&2
                return 1
            }
            [[ "${product_pid:-}" =~ ^[1-9][0-9]*$ ]] || {
                echo "product-input: X11 input requires the real product PID" >&2
                return 1
            }
            ZENTTY_PRODUCT_WINDOW_ID=""
            for _ in {1..200}; do
                # The qualification cell deliberately reuses one private X
                # server for several complete product journeys. A name-only
                # search can race a withdrawing window from the preceding
                # journey and produce BadWindow on the first input event.
                # Bind input to this caller's live process and mapped window.
                ZENTTY_PRODUCT_WINDOW_ID="$(
                    xdotool search --onlyvisible --pid "${product_pid}" --name '^Zentty$' \
                        2>/dev/null | head -1 || true
                )"
                [[ "${ZENTTY_PRODUCT_WINDOW_ID}" =~ ^[1-9][0-9]*$ ]] && break
                sleep 0.05
            done
            [[ "${ZENTTY_PRODUCT_WINDOW_ID}" =~ ^[1-9][0-9]*$ ]] || {
                echo "product-input: real X11 Zentty window did not appear" >&2
                return 1
            }
            [[ "$(xdotool getwindowpid "${ZENTTY_PRODUCT_WINDOW_ID}" 2>/dev/null || true)" == "${product_pid}" ]] || {
                echo "product-input: discovered X11 window is not owned by the product" >&2
                return 1
            }
            xdotool windowfocus --sync "${ZENTTY_PRODUCT_WINDOW_ID}"
            ;;
        wayland)
            if ! command -v wtype >/dev/null; then
                echo "product-input: wtype is required" >&2
                return 1
            fi
            [[ "${ZENTTY_NESTED_WAYLAND_INPUT_SESSION_ID:-}" =~ ^[0-9a-f]{64}$ ]] || {
                echo "product-input: Wayland input is not in the private input-capable session" >&2
                return 1
            }
            zentty_product_wait_for_log "${log}" 'zentty-linux: window-size=' \
                "Wayland product window did not report presentation readiness"
            ZENTTY_PRODUCT_WINDOW_ID=""
            ;;
        *)
            echo "product-input: unsupported backend: ${backend}" >&2
            return 1
            ;;
    esac
    export ZENTTY_PRODUCT_WINDOW_ID
}

zentty_product_key() {
    local backend="$1"
    local key="$2"
    if [[ "${backend}" == x11 ]]; then
        xdotool key --window "${ZENTTY_PRODUCT_WINDOW_ID}" "${key}"
    else
        wtype -k "${key}"
    fi
}

zentty_product_ctrl_key() {
    local backend="$1"
    local key="$2"
    if [[ "${backend}" == x11 ]]; then
        xdotool key --window "${ZENTTY_PRODUCT_WINDOW_ID}" "ctrl+${key}"
    else
        wtype -M ctrl -k "${key}" -m ctrl
    fi
}

zentty_product_ctrl_shift_key() {
    local backend="$1"
    local key="$2"
    if [[ "${backend}" == x11 ]]; then
        xdotool key --window "${ZENTTY_PRODUCT_WINDOW_ID}" "ctrl+shift+${key}"
    else
        wtype -M ctrl -M shift -k "${key}" -m shift -m ctrl
    fi
}

zentty_product_set_file_clipboard() {
    local backend="$1"
    local path="$2"
    [[ "${path}" == /* && -f "${path}" ]] || {
        echo "product-input: file clipboard requires one absolute regular file" >&2
        return 1
    }
    case "${backend}" in
        x11)
            command -v xclip >/dev/null || {
                echo "product-input: xclip is required" >&2
                return 1
            }
            printf 'file://%s\r\n' "${path}" |
                xclip -selection clipboard -target text/uri-list -in
            ;;
        wayland)
            command -v wl-copy >/dev/null || {
                echo "product-input: wl-copy is required" >&2
                return 1
            }
            printf 'file://%s\r\n' "${path}" |
                wl-copy --type text/uri-list
            ;;
        *)
            echo "product-input: unsupported backend: ${backend}" >&2
            return 1
            ;;
    esac
}

zentty_product_set_png_clipboard() {
    local backend="$1"
    local path="$2"
    [[ "${path}" == /* && -f "${path}" ]] || {
        echo "product-input: image clipboard requires one absolute PNG file" >&2
        return 1
    }
    case "${backend}" in
        x11)
            command -v xclip >/dev/null || {
                echo "product-input: xclip is required" >&2
                return 1
            }
            xclip -selection clipboard -target image/png -in <"${path}"
            ;;
        wayland)
            command -v wl-copy >/dev/null || {
                echo "product-input: wl-copy is required" >&2
                return 1
            }
            wl-copy --type image/png <"${path}"
            ;;
        *)
            echo "product-input: unsupported backend: ${backend}" >&2
            return 1
            ;;
    esac
}

zentty_product_alt_key() {
    local backend="$1"
    local key="$2"
    if [[ "${backend}" == x11 ]]; then
        xdotool key --window "${ZENTTY_PRODUCT_WINDOW_ID}" "alt+${key}"
    else
        wtype -M alt -k "${key}" -m alt
    fi
}

zentty_product_close_window() {
    local backend="$1"
    # Ctrl+Q is Zentty's ordinary Linux quit-application shortcut. Driving it
    # through the compositor avoids a test-only lifecycle API and works in the
    # deliberately window-manager-free X11 qualification session.
    if [[ "${backend}" == x11 ]]; then
        # Closing on key-down destroys the target before Xdotool can deliver
        # every synthetic release. The product log and process-exit assertions,
        # not Xdotool's expected asynchronous BadWindow status, prove success.
        xdotool key --window "${ZENTTY_PRODUCT_WINDOW_ID}" ctrl+q 2>/dev/null || true
        sleep 0.1
        xdotool key --window "${ZENTTY_PRODUCT_WINDOW_ID}" ctrl+q 2>/dev/null || true
        # Closing on key-down can also prevent XTest from delivering the
        # synthetic releases. Reset those global key states against the live
        # root window so the next real product in this intentionally reused X
        # server does not inherit a stuck Control/Q chord.
        xdotool keyup Control_L Control_R q 2>/dev/null || true
    else
        wtype -M ctrl -k q -m ctrl
    fi
}

zentty_product_type() {
    local backend="$1"
    local value="$2"
    if [[ "${backend}" == x11 ]]; then
        xdotool type --window "${ZENTTY_PRODUCT_WINDOW_ID}" --delay 5 "${value}"
    else
        wtype "${value}"
    fi
}
