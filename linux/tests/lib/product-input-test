#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)"
calls="$(mktemp)"
trap 'rm -f -- "${calls}"' EXIT

xdotool() {
    printf '%s\n' "$*" >>"${calls}"
    if [[ "${1:-}" == search ]]; then
        printf '5151\n'
    elif [[ "${1:-}" == mousemove && "$*" == *'--window 5151'* ]]; then
        printf 'pointer-target\n' >>"${mock_drag_receipt}"
    elif [[ "${1:-}" == mousemove_relative ]]; then
        printf 'drag-begin:text/uri-list\n' >>"${mock_drag_receipt}"
    fi
}

sleep() {
    :
}

# shellcheck disable=SC1091
source "${repo_root}/linux/tests/lib/product-input"

receipt_log="$(mktemp)"
trap 'rm -f -- "${calls}" "${receipt_log}"' EXIT
printf '%s\n%s\n' ready ready >"${receipt_log}"
zentty_product_wait_for_log_count "${receipt_log}" ready 2 \
    "existing receipt count was not recognized"
if zentty_product_wait_for_log_count "${receipt_log}" ready 3 \
    "missing receipt count was not rejected" 1 2>/dev/null; then
    echo "product-input-test: missing receipt count unexpectedly passed" >&2
    exit 1
fi

ZENTTY_PRODUCT_WINDOW_ID=4242
zentty_product_close_window x11

expected=$'key --window 4242 ctrl+q\nkey --window 4242 ctrl+q\nkeyup Control_L Control_R q'
[[ "$(cat "${calls}")" == "${expected}" ]] || {
    echo "product-input-test: X11 close did not reset the complete synthetic chord" >&2
    cat "${calls}" >&2
    exit 1
}

: >"${calls}"
mock_drag_receipt="$(mktemp)"
printf 'ready\n' >"${mock_drag_receipt}"
zentty_product_drag_from_x11_window 'Zentty File Drag Source' "${mock_drag_receipt}"
rm -f -- "${mock_drag_receipt}"
expected=$'search --onlyvisible --name ^Zentty File Drag Source$\nwindowmove 5151 1040 100\nwindowsize 5151 220 100\nmousemove --sync --window 4242 700 350\nmousemove --sync --window 5151 110 35\nmousedown 1\nmousemove_relative --sync -- 30 30\nmousemove --sync --window 4242 1000 350\nmousemove --sync --window 4242 950 350\nmousemove --sync --window 4242 900 350\nmousemove --sync --window 4242 850 350\nmousemove --sync --window 4242 800 350\nmousemove --sync --window 4242 750 350\nmousemove --sync --window 4242 700 350\nmouseup 1'
[[ "$(cat "${calls}")" == "${expected}" ]] || {
    echo "product-input-test: X11 physical file drag sequence changed" >&2
    cat "${calls}" >&2
    exit 1
}

echo "Product input helper tests passed: counted synchronization, X11 key release, and physical drag"
