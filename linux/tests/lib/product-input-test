#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)"
calls="$(mktemp)"
trap 'rm -f -- "${calls}"' EXIT

xdotool() {
    printf '%s\n' "$*" >>"${calls}"
    if [[ "${1:-}" == search ]]; then
        if [[ -v mock_search_window ]]; then
            [[ -z "${mock_search_window}" ]] || printf '%s\n' "${mock_search_window}"
        else
            printf '5151\n'
        fi
    elif [[ "${1:-}" == getwindowfocus ]]; then
        if [[ -v mock_focus_window ]]; then
            printf '%s\n' "${mock_focus_window}"
        else
            printf '5151\n'
        fi
    elif [[ "${1:-}" == getwindowpid ]]; then
        if [[ -v mock_focus_window && -z "${2:-}" ]]; then
            :
        elif [[ -v mock_window_pid ]]; then
            printf '%s\n' "${mock_window_pid}"
        else
            printf '%s\n' "${product_pid:-0}"
        fi
    elif [[ "${1:-}" == mousemove && -n "${mock_drag_receipt:-}" &&
        ("$*" == *'--window 5151'* || "${mock_wayland_drag:-}" == true) ]]; then
        printf 'pointer-target\n' >>"${mock_drag_receipt}"
    elif [[ "${1:-}" == mousemove_relative ]]; then
        printf 'drag-begin:text/uri-list\n' >>"${mock_drag_receipt}"
    fi
}

sleep() {
    :
}

# shellcheck disable=SC1091
source "${repo_root}/linux/tests/lib/product-input"

receipt_log="$(mktemp)"
trap 'rm -f -- "${calls}" "${receipt_log}"' EXIT

bash -c 'sleep 30' &
blocking_pid=$!
set +e
zentty_wait_for_owned_process "${blocking_pid}" "blocking fixture" 2 0 \
    2>"${receipt_log}"
blocking_status=$?
set -e
if (( blocking_status != 124 )); then
    echo "product-input-test: live process escaped its exit deadline" >&2
    exit 1
fi
grep -Fq "timed out waiting for blocking fixture (pid=${blocking_pid})" \
    "${receipt_log}" || {
    echo "product-input-test: process timeout did not identify its owner" >&2
    exit 1
}
kill -KILL "${blocking_pid}"
zentty_wait_for_owned_process "${blocking_pid}" "killed fixture" 2 0 \
    2>/dev/null || [[ "$?" == 137 ]]

bash -c 'exit 0' &
exited_pid=$!
zentty_wait_for_owned_process "${exited_pid}" "exited fixture" 2 0

: >"${calls}"
product_pid=7777
[[ "$(zentty_product_find_x11_window "${product_pid}" 1)" == 5151 ]]
expected=$'search --onlyvisible --pid 7777 --name ^Zentty$\ngetwindowpid 5151'
[[ "$(cat "${calls}")" == "${expected}" ]] || {
    echo "product-input-test: X11 lookup did not require a mapped PID-owned window" >&2
    exit 1
}
mock_search_window=""
if zentty_product_find_x11_window "${product_pid}" 1 2>/dev/null; then
    echo "product-input-test: missing mapped X11 window was accepted" >&2
    exit 1
fi
mock_search_window=5151
mock_window_pid=9999
if zentty_product_find_x11_window "${product_pid}" 1 2>/dev/null; then
    echo "product-input-test: foreign X11 window owner was accepted" >&2
    exit 1
fi
unset mock_search_window mock_window_pid

if zentty_product_prepare_input x11 /dev/null invalid 2>/dev/null; then
    echo "product-input-test: invalid readiness attempt count unexpectedly passed" >&2
    exit 1
fi

: >"${calls}"
: >"${receipt_log}"
zentty_product_prepare_input x11 "${receipt_log}" 3
expected=$'search --onlyvisible --pid 7777 --name ^Zentty$\ngetwindowpid 5151\nwindowfocus --sync 5151\nmousemove --window 5151 700 400 click 1\ngetwindowfocus\ngetwindowpid 5151'
[[ "$(cat "${calls}")" == "${expected}" ]] || {
    echo "product-input-test: X11 readiness did not bind and focus the product-owned window" >&2
    cat "${calls}" >&2
    exit 1
}
unset product_pid

: >"${calls}"
product_pid=8888
mock_focus_window=""
if zentty_product_prepare_input x11 "${receipt_log}" 1 2>/dev/null; then
    echo "product-input-test: PointerRoot focus passed outside controlled Xwayland" >&2
    exit 1
fi
ZENTTY_NESTED_WAYLAND_XWAYLAND_PROFILE=1
ZENTTY_NESTED_XWAYLAND_PID=9999
ZENTTY_NESTED_WAYLAND_INPUT_SESSION_ID="$(printf 'b%.0s' {1..64})"
ZENTTY_NESTED_XWAYLAND_DISPLAY=:77
DISPLAY=:77
zentty_product_prepare_input x11 "${receipt_log}" 1
unset product_pid mock_focus_window ZENTTY_NESTED_WAYLAND_XWAYLAND_PROFILE \
    ZENTTY_NESTED_XWAYLAND_PID ZENTTY_NESTED_WAYLAND_INPUT_SESSION_ID \
    ZENTTY_NESTED_XWAYLAND_DISPLAY DISPLAY

printf '%s\n%s\n' ready ready >"${receipt_log}"
zentty_product_wait_for_log_count "${receipt_log}" ready 2 \
    "existing receipt count was not recognized"
if zentty_product_wait_for_log_count "${receipt_log}" ready 3 \
    "missing receipt count was not rejected" 1 2>/dev/null; then
    echo "product-input-test: missing receipt count unexpectedly passed" >&2
    exit 1
fi

: >"${calls}"
ZENTTY_PRODUCT_WINDOW_ID=4242
zentty_product_close_window x11

expected=$'windowfocus --sync 4242\nkey ctrl+q\nwindowfocus --sync 4242\nkey ctrl+q\nkeyup Control_L Control_R q'
[[ "$(cat "${calls}")" == "${expected}" ]] || {
    echo "product-input-test: X11 close did not use XTEST and reset the complete chord" >&2
    cat "${calls}" >&2
    exit 1
}

: >"${calls}"
printf 'zentty-linux: window-size=1000x700\n' >"${receipt_log}"
ZENTTY_NESTED_WAYLAND_INPUT_SESSION_ID="$(printf 'a%.0s' {1..64})"
ZENTTY_NESTED_WAYLAND_OUTER_X11_INPUT=1
ZENTTY_NESTED_WAYLAND_OUTER_X11_WINDOW=6262
zentty_product_prepare_input wayland "${receipt_log}"
[[ "$(cat "${calls}")" == 'windowfocus --sync 6262' ]] || {
    echo "product-input-test: explicit nested compositor window was not targeted" >&2
    cat "${calls}" >&2
    exit 1
}
unset ZENTTY_NESTED_WAYLAND_INPUT_SESSION_ID \
    ZENTTY_NESTED_WAYLAND_OUTER_X11_INPUT \
    ZENTTY_NESTED_WAYLAND_OUTER_X11_WINDOW
ZENTTY_PRODUCT_WINDOW_ID=4242

: >"${calls}"
mock_drag_receipt="$(mktemp)"
printf 'ready\n' >"${mock_drag_receipt}"
zentty_product_drag_from_x11_window 'Zentty File Drag Source' "${mock_drag_receipt}"
rm -f -- "${mock_drag_receipt}"
expected=$'search --onlyvisible --name ^Zentty File Drag Source$\nwindowmove 5151 1040 100\nwindowsize 5151 220 100\nmousemove --sync --window 4242 700 350\nmousemove --sync --window 5151 110 35\nmousedown 1\nmousemove_relative --sync -- 30 30\nmousemove --sync --window 4242 1000 350\nmousemove --sync --window 4242 950 350\nmousemove --sync --window 4242 900 350\nmousemove --sync --window 4242 850 350\nmousemove --sync --window 4242 800 350\nmousemove --sync --window 4242 750 350\nmousemove --sync --window 4242 700 350\nmouseup 1'
[[ "$(cat "${calls}")" == "${expected}" ]] || {
    echo "product-input-test: X11 physical file drag sequence changed" >&2
    cat "${calls}" >&2
    exit 1
}

: >"${calls}"
mock_drag_receipt="$(mktemp)"
printf 'ready\n' >"${mock_drag_receipt}"
mock_wayland_drag=true
ZENTTY_NESTED_WAYLAND_OUTER_X11_INPUT=1
zentty_product_drag_in_nested_wayland "${mock_drag_receipt}"
unset mock_wayland_drag ZENTTY_NESTED_WAYLAND_OUTER_X11_INPUT
rm -f -- "${mock_drag_receipt}"
expected=$'mousemove --sync --window 4242 80 80\nmousedown 1\nmousemove_relative --sync -- 30 30\nmousemove --sync --window 4242 201 165\nmousemove --sync --window 4242 322 250\nmousemove --sync --window 4242 443 335\nmousemove --sync --window 4242 565 420\nmousemove --sync --window 4242 686 505\nmousemove --sync --window 4242 807 590\nmousemove --sync --window 4242 928 675\nmousemove --sync --window 4242 1050 760\nmouseup 1'
[[ "$(cat "${calls}")" == "${expected}" ]] || {
    echo "product-input-test: nested Wayland physical file drag sequence changed" >&2
    cat "${calls}" >&2
    exit 1
}

: >"${calls}"
mock_drag_receipt="$(mktemp)"
printf 'ready\n' >"${mock_drag_receipt}"
mock_wayland_drag=true
ZENTTY_NESTED_WAYLAND_OUTER_X11_INPUT=1
ZENTTY_NESTED_WAYLAND_DRAG_TARGET_X=800
ZENTTY_NESTED_WAYLAND_DRAG_TARGET_Y=500
zentty_product_drag_in_nested_wayland "${mock_drag_receipt}"
unset mock_wayland_drag ZENTTY_NESTED_WAYLAND_OUTER_X11_INPUT \
    ZENTTY_NESTED_WAYLAND_DRAG_TARGET_X ZENTTY_NESTED_WAYLAND_DRAG_TARGET_Y
rm -f -- "${mock_drag_receipt}"
grep -Fqx 'mousemove --sync --window 4242 800 500' "${calls}" || {
    echo "product-input-test: explicit nested Wayland terminal target was ignored" >&2
    cat "${calls}" >&2
    exit 1
}

mock_drag_receipt="$(mktemp)"
printf 'ready\n' >"${mock_drag_receipt}"
mock_wayland_drag=true
ZENTTY_NESTED_WAYLAND_OUTER_X11_INPUT=1
ZENTTY_NESTED_WAYLAND_DRAG_TARGET_X=800
ZENTTY_NESTED_WAYLAND_DRAG_TARGET_Y=invalid
if zentty_product_drag_in_nested_wayland "${mock_drag_receipt}" 2>/dev/null; then
    echo "product-input-test: malformed explicit Wayland target unexpectedly passed" >&2
    exit 1
fi
unset mock_wayland_drag ZENTTY_NESTED_WAYLAND_OUTER_X11_INPUT \
    ZENTTY_NESTED_WAYLAND_DRAG_TARGET_X ZENTTY_NESTED_WAYLAND_DRAG_TARGET_Y
rm -f -- "${mock_drag_receipt}"

echo "Product input helper tests passed: counted synchronization, bounded owned-process waits, native/Xwayland focus, X11 key release, and physical X11/Wayland drag"
