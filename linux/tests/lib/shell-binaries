#!/usr/bin/env bash

# Resolve qualification-only shell prerequisites without making them product
# dependencies. Explicit operator paths win, then PATH, then the documented
# sibling .tools layout used by controlled development/CI hosts.
zentty_test_shell_binary() {
    local shell_name="$1"
    local repo_root="$2"
    local variable candidate=""
    case "${shell_name}" in
        bash) variable=ZENTTY_TEST_BASH ;;
        zsh) variable=ZENTTY_TEST_ZSH ;;
        fish) variable=ZENTTY_TEST_FISH ;;
        nu) variable=ZENTTY_TEST_NU ;;
        *) return 64 ;;
    esac
    candidate="${!variable:-}"
    if [[ -z "${candidate}" ]]; then
        candidate="$(command -v "${shell_name}" 2>/dev/null || true)"
    fi
    if [[ -z "${candidate}" ]]; then
        case "${shell_name}" in
            fish) candidate="${repo_root}/../.tools/fish-4.8.1/bin/fish" ;;
            nu) candidate="${repo_root}/../.tools/nu-0.114.1/nu" ;;
        esac
    fi
    [[ -x "${candidate}" ]] || return 77
    readlink -f -- "${candidate}"
}

zentty_test_shell_version() {
    "$2" --version | head -1
}

zentty_test_shell_version_supported() {
    case "$1" in
        bash) [[ "$2" =~ ^GNU\ bash,\ version\ ([4-9]|[1-9][0-9])\. ]] ;;
        zsh) [[ "$2" =~ ^zsh\ ([5-9]|[1-9][0-9])\. ]] ;;
        fish) [[ "$2" =~ ^fish,\ version\ ([4-9]|[1-9][0-9])\. ]] ;;
        nu) [[ "$2" =~ ^0\.[1-9][0-9]{2,}\. ]] ;;
        *) return 64 ;;
    esac
}
