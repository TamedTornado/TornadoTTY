#!/usr/bin/env bash

# Choose useful host defaults without consuming every logical CPU. Matrix cells
# include multi-process GTK and Valgrind journeys, while support checks are
# predominantly single-process contracts. Explicit environment overrides remain
# authoritative for constrained hosts.
zentty_qualification_matrix_jobs() {
    local cpu_count available_kib cpu_jobs memory_jobs jobs
    cpu_count="$(nproc)"
    available_kib="$(awk '/^MemAvailable:/ { print $2; exit }' /proc/meminfo)"
    [[ "${cpu_count}" =~ ^[1-9][0-9]*$ ]] || cpu_count=1
    [[ "${available_kib}" =~ ^[1-9][0-9]*$ ]] || available_kib=$((2 * 1024 * 1024))

    # Reserve one quarter of the machine for the desktop, compilers spawned by
    # cells, and operator work. Admit at most one cell per 2 GiB available RAM.
    cpu_jobs=$((cpu_count * 3 / 4))
    (( cpu_jobs >= 1 )) || cpu_jobs=1
    memory_jobs=$((available_kib / (2 * 1024 * 1024)))
    (( memory_jobs >= 1 )) || memory_jobs=1
    jobs="${cpu_jobs}"
    (( memory_jobs < jobs )) && jobs="${memory_jobs}"
    (( jobs > 32 )) && jobs=32
    printf '%s\n' "${jobs}"
}

zentty_qualification_support_jobs() {
    local cpu_count jobs
    cpu_count="$(nproc)"
    [[ "${cpu_count}" =~ ^[1-9][0-9]*$ ]] || cpu_count=1
    jobs=$((cpu_count / 4))
    (( jobs >= 2 )) || jobs=2
    (( jobs > 8 )) && jobs=8
    printf '%s\n' "${jobs}"
}

zentty_qualification_display_jobs() {
    local physical_cores display_cores jobs
    physical_cores="$(lscpu -p=CORE 2>/dev/null | awk -F, '!/^#/ && !seen[$1]++ { count++ } END { print count + 0 }')"
    [[ "${physical_cores}" =~ ^[1-9][0-9]*$ ]] || physical_cores=2
    # A compositor actor is event-driven, but its X server, renderer, portals,
    # PTYs, and input services still need one physical core worth of scheduling
    # headroom. Do not admit eight displays onto the six-core display partition:
    # that faster-looking configuration produced load-only focus and chooser
    # failures in three consecutive otherwise-real qualification runs.
    display_cores=$((physical_cores - (physical_cores * 5 / 8)))
    jobs="${display_cores}"
    (( jobs >= 2 )) || jobs=2
    (( jobs > 8 )) && jobs=8
    printf '%s\n' "${jobs}"
}

zentty_qualification_interactive_jobs() {
    # Most nested-display actors own independent compositors and can drive real
    # input concurrently. Input is isolated inside each cell's private
    # compositor, so it uses the complete display capacity rather than a
    # second, fictitious shared-input limit.
    zentty_qualification_display_jobs
}

# Partition whole physical cores so compiler/Valgrind work cannot starve real
# compositor input and presentation. Logical siblings always remain together.
zentty_qualification_cpu_set() {
    local partition="$1"
    command -v lscpu >/dev/null || return 1
    lscpu -p=CPU,CORE | awk -F, -v partition="${partition}" '
      /^#/ { next }
      !($2 in seen) { seen[$2] = ++core_count; core_order[core_count] = $2 }
      { cpus[$2] = cpus[$2] (cpus[$2] == "" ? "" : ",") $1 }
      END {
        if (core_count < 4 || (partition != "work" && partition != "display")) exit 1
        # Build/package producers need ten physical cores on the 16-core
        # qualification host; six physical cores still provide twelve logical
        # CPUs for eight predominantly event-driven compositor actors.
        split_at = int(core_count * 5 / 8)
        if (split_at < 2) split_at = 2
        if (split_at >= core_count) split_at = core_count - 1
        first = partition == "work" ? 1 : split_at + 1
        last = partition == "work" ? split_at : core_count
        output = ""
        for (i = first; i <= last; i++) {
          core = core_order[i]
          output = output (output == "" ? "" : ",") cpus[core]
        }
        print output
      }
    '
}

zentty_qualification_build_jobs() {
    local cpu_count jobs
    cpu_count="$(nproc)"
    [[ "${cpu_count}" =~ ^[1-9][0-9]*$ ]] || cpu_count=1
    # The matrix may build ReleaseSafe, Debug, and Ghostty regression in
    # parallel. Divide CPU capacity between those producers.
    jobs=$((cpu_count / 3))
    (( jobs >= 2 )) || jobs=2
    printf '%s\n' "${jobs}"
}

zentty_qualification_regression_jobs() {
    local cpu_count jobs
    cpu_count="$(nproc)"
    [[ "${cpu_count}" =~ ^[1-9][0-9]*$ ]] || cpu_count=1
    # This is the longest build graph. Give it half the host while the two
    # product-profile builders share the other half.
    jobs=$((cpu_count / 2))
    (( jobs >= 2 )) || jobs=2
    (( jobs > 16 )) && jobs=16
    printf '%s\n' "${jobs}"
}
