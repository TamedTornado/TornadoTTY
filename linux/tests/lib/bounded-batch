#!/usr/bin/env bash

# Runs opaque work items through a bounded, work-conserving pool. The callback
# receives one work item; failures are returned only after every item has been
# reaped. Dependency barriers remain the caller's responsibility.
zentty_run_bounded_batch() {
    local jobs="$1"
    local callback="$2"
    shift 2
    local item pid completed_pid failed=false
    local -A active=()

    [[ "${jobs}" =~ ^[1-9][0-9]*$ ]] || return 64
    for item in "$@"; do
        while (( ${#active[@]} >= jobs )); do
            completed_pid=""
            if ! zentty_wait_owned_pid completed_pid "${!active[@]}"; then
                failed=true
            fi
            [[ -n "${completed_pid}" ]] || return 70
            unset 'active['"${completed_pid}"']'
        done
        "${callback}" "${item}" &
        active["$!"]=1
    done
    for pid in "${!active[@]}"; do
        wait "${pid}" || failed=true
    done
    ! "${failed}"
}

# `wait -n -p` can reap a completed descendant that is not part of the caller's
# pool when other orchestration is active in the same shell. Restrict it to the
# PIDs owned by this pool so one batch cannot steal another scheduler's result.
zentty_wait_owned_pid() {
    local completed_name="$1"
    shift
    wait -n -p "${completed_name}" "$@"
}
