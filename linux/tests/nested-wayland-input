#!/usr/bin/env bash
set -euo pipefail

readonly compositor="${ZENTTY_NESTED_WAYLAND_INPUT_COMPOSITOR:-cage}"
readonly scaling_profile="${ZENTTY_NESTED_WAYLAND_SCALING_PROFILE:-0}"
readonly xwayland_profile="${ZENTTY_NESTED_WAYLAND_XWAYLAND_PROFILE:-0}"
[[ "${scaling_profile}" == 0 || "${scaling_profile}" == 1 ]] || {
    echo "nested-wayland-input: error: ZENTTY_NESTED_WAYLAND_SCALING_PROFILE must be 0 or 1" >&2
    exit 64
}
[[ "${xwayland_profile}" == 0 || "${xwayland_profile}" == 1 ]] || {
    echo "nested-wayland-input: error: ZENTTY_NESTED_WAYLAND_XWAYLAND_PROFILE must be 0 or 1" >&2
    exit 64
}
case "${compositor}" in
    cage | labwc | weston) ;;
    *)
        echo "nested-wayland-input: error: unsupported compositor: ${compositor}" >&2
        exit 64
        ;;
esac
if [[ "${scaling_profile}" == 1 && "${compositor}" != labwc ]]; then
    echo "nested-wayland-input: error: scaling profile requires labwc" >&2
    exit 64
fi
if [[ "${xwayland_profile}" == 1 &&
    ("${compositor}" != labwc || "${scaling_profile}" != 1) ]]; then
    echo "nested-wayland-input: error: Xwayland profile requires the labwc scaling profile" >&2
    exit 64
fi
case "${compositor}" in
    cage)
        readonly ready_marker="nested-wayland-input: READY private-cage-x11-nested backend=wayland software-renderer=1 virtual-keyboard=1"
        ;;
    labwc)
        if [[ "${scaling_profile}" == 1 ]]; then
            if [[ "${xwayland_profile}" == 1 ]]; then
                readonly ready_marker="nested-wayland-input: READY private-labwc-x11-nested backend=wayland software-renderer=1 outer-x11-input=1 xdg-activation=1 mixed-scale-outputs=2 owned-xwayland=1"
            else
                readonly ready_marker="nested-wayland-input: READY private-labwc-x11-nested backend=wayland software-renderer=1 outer-x11-input=1 xdg-activation=1 mixed-scale-outputs=2"
            fi
        else
            readonly ready_marker="nested-wayland-input: READY private-labwc-x11-nested backend=wayland software-renderer=1 outer-x11-input=1 xdg-activation=1"
        fi
        ;;
    weston)
        readonly ready_marker="nested-wayland-input: READY private-weston-x11-nested backend=wayland software-renderer=1 outer-x11-input=1"
        ;;
esac
wrapper_path="$(readlink -f -- "${BASH_SOURCE[0]}")"
readonly wrapper_path
wrapper_sha256="$(sha256sum "${wrapper_path}" | awk '{print $1}')"
readonly wrapper_sha256

fail() {
    echo "nested-wayland-input: error: $*" >&2
    exit 1
}

pid_is_running() {
    local pid="$1"
    local state
    kill -0 "${pid}" 2>/dev/null || return 1
    state="$(ps -o stat= -p "${pid}" 2>/dev/null || true)"
    [[ -n "${state}" && "${state}" != Z* ]]
}

terminate_process_group() {
    local leader="$1"
    kill -TERM -- "-${leader}" 2>/dev/null || true
    for _ in {1..40}; do
        ps -eo pgid= | awk -v expected="${leader}" '$1 == expected {found=1} END {exit !found}' || break
        sleep 0.05
    done
    kill -KILL -- "-${leader}" 2>/dev/null || true
    wait "${leader}" 2>/dev/null || true
}

if [[ "${1:-}" == --private-wayland-input-inner ]]; then
    shift
    (( $# > 0 )) || fail "missing command"
    run_root="${ZENTTY_NESTED_WAYLAND_INPUT_RUN_ROOT:?}"
    compositor_log="${run_root}/${compositor}.log"
    cage_app_pid_file="${run_root}/cage-app.pid"
    info_log="${run_root}/wayland-info.log"
    compositor_pid=""
    cleanup_inner() {
        trap - EXIT HUP INT TERM
        if [[ -n "${compositor_pid}" ]]; then
            if [[ -s "${cage_app_pid_file}" ]]; then
                read -r cage_app_pid <"${cage_app_pid_file}"
                if [[ "${cage_app_pid}" =~ ^[1-9][0-9]*$ ]]; then
                    kill -TERM "${cage_app_pid}" 2>/dev/null || true
                fi
                for _ in {1..40}; do
                    pid_is_running "${compositor_pid}" || break
                    sleep 0.05
                done
            fi
            if pid_is_running "${compositor_pid}"; then
                terminate_process_group "${compositor_pid}"
            else
                wait "${compositor_pid}" 2>/dev/null || true
            fi
        fi
    }
    trap cleanup_inner EXIT
    trap 'exit 129' HUP
    trap 'exit 130' INT
    trap 'exit 143' TERM

    [[ "${ZENTTY_NESTED_WAYLAND_INPUT_WRAPPER_SHA256:-}" == "${wrapper_sha256}" ]] ||
        fail "wrapper identity changed before private-session startup"
    [[ "${DISPLAY:-}" =~ ^:[0-9]+([.][0-9]+)?$ &&
        "${ZENTTY_NESTED_X11_SESSION_ID:-}" =~ ^[0-9a-f]{64}$ ]] ||
        fail "Cage is not attached to the wrapper-owned Xvfb transport"
    [[ -z "${WAYLAND_DISPLAY:-}" && -z "${MIR_SOCKET:-}" ]] ||
        fail "an ambient Wayland display escaped sanitation"
    [[ -z "${DBUS_SESSION_BUS_ADDRESS:-}" && -z "${AT_SPI_BUS_ADDRESS:-}" &&
        -z "${IBUS_ADDRESS:-}" ]] || fail "an ambient desktop endpoint escaped sanitation"

    if [[ "${compositor}" == cage ]]; then
        # The child shell, not this wrapper, expands its PID and target path.
        # shellcheck disable=SC2016
        setsid env \
            WLR_BACKENDS=x11 \
            WLR_RENDERER=pixman \
            WLR_LOG=1 \
            ZENTTY_CAGE_APP_PID="${cage_app_pid_file}" \
            cage -s -- sh -c 'printf "%s\n" "$$" >"${ZENTTY_CAGE_APP_PID}"; exec sleep 86400' \
            >"${compositor_log}" 2>&1 &
    elif [[ "${compositor}" == weston ]]; then
        setsid weston \
            --backend=x11 \
            --renderer=pixman \
            --socket=wayland-zentty-input \
            --width=1280 \
            --height=1024 \
            --scale=1 \
            --idle-time=0 \
            --no-config \
            --log="${compositor_log}" &
    else
        mkdir -p "${run_root}/labwc-config"
        if [[ "${scaling_profile}" == 1 ]]; then
            cat >"${run_root}/labwc-config/rc.xml" <<'LABWC_CONFIG'
<?xml version="1.0"?>
<labwc_config>
  <keyboard>
    <default />
    <keybind key="F1"><action name="MoveToOutput" direction="left" /></keybind>
    <keybind key="F2"><action name="MoveToOutput" direction="right" /></keybind>
    <keybind key="F3"><action name="Maximize" /></keybind>
    <keybind key="F4"><action name="ToggleMaximize" /></keybind>
  </keyboard>
</labwc_config>
LABWC_CONFIG
        fi
        labwc_command=(labwc --config-dir "${run_root}/labwc-config")
        if [[ "${xwayland_profile}" == 1 ]]; then
            xwayland_binary="$(command -v Xwayland)"
            [[ -x "${xwayland_binary}" ]] || fail "reviewed Xwayland binary is unavailable"
            cat >"${run_root}/Xwayland-shm" <<XWAYLAND_SHM
#!/usr/bin/env bash
exec "${xwayland_binary}" "\$@" -shm
XWAYLAND_SHM
            chmod +x "${run_root}/Xwayland-shm"
            cat >"${run_root}/labwc-xwayland-startup" <<XWAYLAND_STARTUP
#!/usr/bin/env bash
set -euo pipefail
printf '%s\n' "\${DISPLAY:?}" >"${run_root}/xwayland.display"
XWAYLAND_STARTUP
            chmod +x "${run_root}/labwc-xwayland-startup"
            labwc_command+=(--startup "${run_root}/labwc-xwayland-startup")
        fi
        labwc_environment=(WLR_BACKENDS=x11 WLR_RENDERER=pixman)
        [[ "${xwayland_profile}" == 0 ]] ||
            labwc_environment+=(WLR_XWAYLAND="${run_root}/Xwayland-shm")
        [[ "${scaling_profile}" == 0 ]] || labwc_environment+=(WLR_X11_OUTPUTS=2)
        setsid env "${labwc_environment[@]}" \
            "${labwc_command[@]}" \
            >"${compositor_log}" 2>&1 &
    fi
    compositor_pid=$!

    socket_path=""
    for _ in {1..300}; do
        socket_path="$(find "${XDG_RUNTIME_DIR}" -maxdepth 1 -type s -name 'wayland-*' -print -quit)"
        [[ -n "${socket_path}" ]] && break
        if ! pid_is_running "${compositor_pid}"; then
            [[ "${xwayland_profile}" == 0 ]] || tail -80 "${compositor_log}" >&2
            fail "${compositor} exited before creating its private socket"
        fi
        sleep 0.02
    done
    [[ -n "${socket_path}" && -S "${socket_path}" && ! -L "${socket_path}" ]] ||
        fail "${compositor} did not create a safe private socket"
    socket_name="$(basename "${socket_path}")"
    export WAYLAND_DISPLAY="${socket_name}"
    export GDK_BACKEND=wayland

    timeout --foreground --kill-after=1s 3s wayland-info >"${info_log}" 2>&1 ||
        fail "${compositor} protocol inventory was unavailable"
    if [[ "${compositor}" == weston ]]; then
        grep -Fq 'Using Pixman renderer' "${compositor_log}" ||
            fail "Weston did not prove the Pixman software renderer"
    fi
    protocols="$(sed -n "s/^interface: '\([^']*\)'.*/\1/p" "${info_log}" | LC_ALL=C sort -u)"
    required_protocols=(wl_compositor wl_output wl_shm xdg_wm_base)
    if [[ "${compositor}" == cage ]]; then
        required_protocols+=(zwp_virtual_keyboard_manager_v1)
    else
        required_protocols+=(wl_data_device_manager wl_seat)
        [[ "${compositor}" != labwc ]] || required_protocols+=(xdg_activation_v1)
    fi
    if [[ "${scaling_profile}" == 1 ]]; then
        required_protocols+=(wp_fractional_scale_manager_v1 wp_viewporter zwlr_output_manager_v1)
    fi
    for protocol in "${required_protocols[@]}"; do
        grep -Fx "${protocol}" <<<"${protocols}" >/dev/null ||
            fail "${compositor} lacks required protocol ${protocol}"
    done
    width="$(sed -n 's/.*width: \([0-9][0-9]*\) px, height:.*/\1/p' "${info_log}" | head -1)"
    height="$(sed -n 's/.*width: [0-9][0-9]* px, height: \([0-9][0-9]*\) px.*/\1/p' "${info_log}" | head -1)"
    scale="$(sed -n 's/.*scale: \([0-9][0-9]*\),.*/\1/p' "${info_log}" | head -1)"
    [[ "${width}" =~ ^[1-9][0-9]*$ && "${height}" =~ ^[1-9][0-9]*$ &&
        "${scale}" =~ ^[1-9][0-9]*$ ]] || fail "Cage output facts were incomplete"
    outputs_json='[]'
    if [[ "${scaling_profile}" == 1 ]]; then
        wlr-randr --output X11-1 --scale 1 --pos 0,0 \
            --output X11-2 --scale 2 --pos 1024,0 ||
            fail "labwc baseline mixed-scale configuration was rejected"
        wlr-randr >"${run_root}/outputs.info" ||
            fail "labwc output-management inventory was unavailable"
        outputs_json="$(awk '
            /^[^ ]/ { name=$1; mode="" }
            /^  Modes:/ { in_modes=1; next }
            in_modes && /\(current\)/ { mode=$1; in_modes=0 }
            /^  Position:/ { position=$2 }
            /^  Scale:/ { print name "\t" position "\t" $2 "\t" mode }
        ' "${run_root}/outputs.info" | jq -Rn '
            [inputs | split("\t") |
             {name:.[0],position:.[1],scale:(.[2] | tonumber),mode:.[3]}]
        ')"
        jq -e '
            length == 2 and
            any(.[]; .name == "X11-1" and .position == "0,0" and .scale == 1) and
            any(.[]; .name == "X11-2" and .position == "1024,0" and .scale == 2)
        ' <<<"${outputs_json}" >/dev/null ||
            fail "labwc did not expose the exact owned 1x/2x output baseline"
    fi
    xwayland_json='null'
    if [[ "${xwayland_profile}" == 1 ]]; then
        for _ in {1..200}; do
            [[ -s "${run_root}/xwayland.display" ]] && break
            pid_is_running "${compositor_pid}" || break
            sleep 0.02
        done
        [[ -s "${run_root}/xwayland.display" ]] ||
            fail "labwc did not publish its owned Xwayland display"
        read -r xwayland_display <"${run_root}/xwayland.display"
        [[ "${xwayland_display}" =~ ^:[0-9]+$ && "${xwayland_display}" != "${DISPLAY}" ]] ||
            fail "labwc Xwayland display identity was invalid or reused outer Xvfb"
        for _ in {1..200}; do
            if DISPLAY="${xwayland_display}" xdpyinfo \
                >"${run_root}/xwayland-xdpyinfo.log" 2>/dev/null; then
                break
            fi
            pid_is_running "${compositor_pid}" || break
            sleep 0.02
        done
        [[ -s "${run_root}/xwayland-xdpyinfo.log" ]] ||
            fail "owned Xwayland display rejected authenticated X11 inspection"
        xwayland_pid="$(ps -eo pid=,pgid=,comm= | awk -v owned="${compositor_pid}" \
            '$2 == owned && $3 == "Xwayland" {print $1}')"
        [[ "${xwayland_pid}" =~ ^[1-9][0-9]*$ ]] ||
            fail "owned Xwayland process-group identity was unavailable"
        xwayland_executable="$(readlink -f "/proc/${xwayland_pid}/exe")"
        [[ "${xwayland_executable}" == "$(readlink -f "${xwayland_binary}")" ]] ||
            fail "owned Xwayland executable identity did not match the reviewed binary"
        tr '\0' ' ' <"/proc/${xwayland_pid}/cmdline" >"${run_root}/xwayland-command.log"
        grep -Eq '(^| )-shm( |$)' "${run_root}/xwayland-command.log" ||
            fail "owned Xwayland did not use the reviewed shared-memory transport"
        DISPLAY="${xwayland_display}" xrandr --current >"${run_root}/xwayland-randr.log" ||
            fail "owned Xwayland RANDR state was unavailable"
        xwayland_version="$(Xwayland -version 2>&1 | sed -n 's/^The X.Org Foundation Xwayland Version //p')"
        xwayland_root="$(sed -n 's/^  dimensions:[[:space:]]*\([0-9][0-9]*x[0-9][0-9]*\).*/\1/p' "${run_root}/xwayland-xdpyinfo.log")"
        [[ -n "${xwayland_version}" && "${xwayland_root}" =~ ^[0-9]+x[0-9]+$ ]] ||
            fail "owned Xwayland version or root geometry was unavailable"
        xwayland_json="$(jq -n \
            --arg display "${xwayland_display}" \
            --argjson pid "${xwayland_pid}" \
            --argjson process_group "${compositor_pid}" \
            --arg version "${xwayland_version}" \
            --arg binary_path "${xwayland_executable}" \
            --arg binary_sha "$(sha256sum "${xwayland_executable}" | awk '{print $1}')" \
            --arg command_sha "$(sha256sum "${run_root}/xwayland-command.log" | awk '{print $1}')" \
            --arg root_geometry "${xwayland_root}" \
            --arg xdpyinfo_sha "$(sha256sum "${run_root}/xwayland-xdpyinfo.log" | awk '{print $1}')" \
            --arg randr_sha "$(sha256sum "${run_root}/xwayland-randr.log" | awk '{print $1}')" \
            '{display:$display,pid:$pid,process_group:$process_group,version:$version,
              binary_path:$binary_path,binary_sha256:$binary_sha,
              command_sha256:$command_sha,transport:"shm",
              root_geometry:$root_geometry,xdpyinfo_sha256:$xdpyinfo_sha,
              randr_sha256:$randr_sha}')"
    fi
    protocols_json="$(jq -Rn '[inputs | select(length > 0)] | sort' <<<"${protocols}")"
    case "${compositor}" in
        cage) compositor_name="Cage" ;;
        labwc) compositor_name="labwc" ;;
        weston) compositor_name="Weston" ;;
    esac
    jq -n \
        --arg endpoint "${socket_name}" \
        --arg name "${compositor_name}" \
        --arg version "${ZENTTY_NESTED_WAYLAND_INPUT_COMPOSITOR_VERSION:?}" \
        --argjson width "${width}" \
        --argjson height "${height}" \
        --argjson scale "${scale}" \
        --argjson protocols "${protocols_json}" \
        --argjson outputs "${outputs_json}" \
        --argjson xwayland "${xwayland_json}" \
        --arg info_sha "$(sha256sum "${info_log}" | awk '{print $1}')" \
        '{name:$name,endpoint:$endpoint,version:$version,width:$width,height:$height,scale:$scale,protocols:$protocols,outputs:$outputs,xwayland:$xwayland,wayland_info_sha256:$info_sha}' \
        >"${run_root}/session-facts.json"

    printf '%s\n' "${ready_marker}"
    printf 'nested-wayland-input: SESSION %s\n' "${ZENTTY_NESTED_WAYLAND_INPUT_SESSION_ID}"
    export ZENTTY_NESTED_WAYLAND_OUTER_X11_PID="${compositor_pid}"
    mapfile -t all_outer_x11_windows < <({
        xdotool search --onlyvisible --pid "${compositor_pid}" --name '.*' 2>/dev/null || true
    } | sort -n)
    ZENTTY_NESTED_WAYLAND_OUTER_X11_WINDOW="${all_outer_x11_windows[-1]:-}"
    export ZENTTY_NESTED_WAYLAND_OUTER_X11_WINDOW
    [[ "${ZENTTY_NESTED_WAYLAND_OUTER_X11_WINDOW}" =~ ^[1-9][0-9]*$ ]] ||
        fail "${compositor} outer X11 window identity was unavailable"
    if [[ "${compositor}" != cage ]]; then
        export ZENTTY_NESTED_WAYLAND_OUTER_X11_INPUT=1
    fi
    if [[ "${scaling_profile}" == 1 ]]; then
        export ZENTTY_NESTED_WAYLAND_COMPOSITOR_LOG="${compositor_log}"
        mapfile -t outer_x11_windows < <(
            printf '%s\n' "${all_outer_x11_windows[@]}" |
                while read -r window; do
                    geometry="$(xdotool getwindowgeometry --shell "${window}")"
                    [[ "${geometry}" == *$'WIDTH=1024\n'* &&
                        "${geometry}" == *$'HEIGHT=768\n'* ]] && printf '%s\n' "${window}"
                done
        )
        [[ "${#outer_x11_windows[@]}" -eq 2 ]] ||
            fail "labwc mixed-scale outer X11 window count was not two"
        # wlroots' X11 backend initially overlaps its two top-level output
        # windows. Separate them on the private Xvfb desktop so XTEST pointer
        # events can address each real Wayland output deterministically.
        xdotool windowmove "${outer_x11_windows[0]}" 0 0
        xdotool windowmove "${outer_x11_windows[1]}" 1100 0
        export ZENTTY_NESTED_WAYLAND_OUTER_X11_OUTPUT_1="${outer_x11_windows[0]}"
        export ZENTTY_NESTED_WAYLAND_OUTER_X11_OUTPUT_2="${outer_x11_windows[1]}"
    fi
    if [[ "${xwayland_profile}" == 1 ]]; then
        export ZENTTY_NESTED_WAYLAND_OUTER_DISPLAY="${DISPLAY}"
        export ZENTTY_NESTED_XWAYLAND_PID="${xwayland_pid}"
        export ZENTTY_NESTED_XWAYLAND_DISPLAY="${xwayland_display}"
        DISPLAY="${xwayland_display}"
        export DISPLAY
    fi
    set +e
    "$@"
    status=$?
    set -e
    cleanup_inner
    compositor_pid=""
    exit "${status}"
fi

(( $# > 0 )) || {
    echo "usage: nested-wayland-input COMMAND [ARG ...]" >&2
    exit 64
}
for dependency in wayland-info jq grep sed awk sort sha256sum readlink tr \
    date setsid ps kill sleep timeout mktemp mkdir chmod rm env find basename stat; do
    command -v "${dependency}" >/dev/null || {
        echo "nested-wayland-input: SKIP missing runtime dependency: ${dependency}" >&2
        exit 77
    }
done
if [[ "${compositor}" == cage ]]; then
    if ! command -v cage >/dev/null || ! command -v wtype >/dev/null; then
        echo "nested-wayland-input: SKIP missing Cage input dependency" >&2
        exit 77
    fi
elif [[ "${compositor}" == weston ]]; then
    if ! command -v weston >/dev/null || ! command -v xdotool >/dev/null; then
        echo "nested-wayland-input: SKIP missing Weston input dependency" >&2
        exit 77
    fi
else
    if ! command -v labwc >/dev/null || ! command -v xdotool >/dev/null; then
        echo "nested-wayland-input: SKIP missing labwc input dependency" >&2
        exit 77
    fi
    if [[ "${scaling_profile}" == 1 ]] && ! command -v wlr-randr >/dev/null; then
        echo "nested-wayland-input: SKIP missing reviewed wlr-randr scaling dependency" >&2
        exit 77
    fi
    if [[ "${xwayland_profile}" == 1 ]]; then
        for dependency in Xwayland xdpyinfo xrandr; do
            command -v "${dependency}" >/dev/null || {
                echo "nested-wayland-input: SKIP missing reviewed Xwayland dependency: ${dependency}" >&2
                exit 77
            }
        done
    fi
fi

report="${ZENTTY_NESTED_WAYLAND_INPUT_REPORT:-}"
[[ -z "${report}" || "${report}" == /* ]] || report="$(pwd)/${report}"
[[ -z "${report}" || ! -L "${report}" ]] || fail "environment report may not be a symlink"
[[ -z "${report}" || -d "$(dirname "${report}")" ]] || fail "report parent does not exist"
[[ -z "${report}" ]] || rm -f -- "${report}"

# Keep enough SUN_LEN budget for the product's per-instance agent socket under
# this isolated TMPDIR; descriptive long roots make real IPC startup fail.
run_root="$(mktemp -d /tmp/zwi.XXXXXX)"
started_at_epoch="$(date +%s)"
session_id="$(printf '%s\n' "${run_root}" "${started_at_epoch}" "$$" | sha256sum | awk '{print $1}')"
case "${compositor}" in
    cage) compositor_version="$(cage -v 2>&1 | sed -n 's/^Cage version //p')" ;;
    labwc) compositor_version="$(labwc --version 2>&1 | sed -n 's/^labwc[[:space:]]\+//p')" ;;
    weston) compositor_version="$(weston --version | sed -n 's/^weston[[:space:]]\+//p')" ;;
esac
[[ -n "${compositor_version}" ]] || fail "${compositor} version could not be identified"
session_pid=""
# ShellCheck cannot see that this function is invoked by the EXIT/signal traps.
# shellcheck disable=SC2317
cleanup() {
    trap - EXIT HUP INT TERM
    if [[ "${session_pid}" =~ ^[1-9][0-9]*$ ]]; then
        kill -TERM "${session_pid}" 2>/dev/null || true
        wait "${session_pid}" 2>/dev/null || true
    fi
    rm -rf -- "${run_root}"
}
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

export ZENTTY_NESTED_WAYLAND_INPUT_SESSION_ID="${session_id}"
export ZENTTY_NESTED_WAYLAND_INPUT_WRAPPER_SHA256="${wrapper_sha256}"

set +e
"$(dirname "${wrapper_path}")/nested-x11" env \
    ZENTTY_NESTED_WAYLAND_INPUT_RUN_ROOT="${run_root}" \
    ZENTTY_NESTED_WAYLAND_INPUT_COMPOSITOR_VERSION="${compositor_version}" \
    "${wrapper_path}" --private-wayland-input-inner "$@" &
session_pid=$!
wait "${session_pid}"
status=$?
set -e

facts=""
[[ ! -f "${run_root}/session-facts.json" ]] || facts="$(jq -c . "${run_root}/session-facts.json")"
[[ "$(sha256sum "${wrapper_path}" | awk '{print $1}')" == "${wrapper_sha256}" ]] ||
    fail "wrapper identity changed during execution"

if [[ -n "${report}" && -n "${facts}" ]]; then
    finished_at_epoch="$(date +%s)"
    command_json="$(printf '%s\0' "$@" | jq -Rs 'split("\u0000")[:-1]')"
    if [[ "${compositor}" == cage || "${compositor}" == labwc ]]; then
        renderer_proof="WLR_RENDERER=pixman"
    else
        renderer_proof="Using Pixman renderer"
    fi
    jq -n \
        --arg session_id "${session_id}" \
        --arg wrapper_path "${wrapper_path}" \
        --arg wrapper_sha256 "${wrapper_sha256}" \
        --argjson process_group "${session_pid}" \
        --argjson started_at_epoch "${started_at_epoch}" \
        --argjson finished_at_epoch "${finished_at_epoch}" \
        --argjson command "${command_json}" \
        --argjson command_exit_code "${status}" \
        --arg renderer_proof "${renderer_proof}" \
        --argjson facts "${facts}" '
        {
          schema_version:1,session_id:$session_id,backend:"wayland",
          wrapper:{path:$wrapper_path,sha256:$wrapper_sha256},
          started_at_epoch:$started_at_epoch,finished_at_epoch:$finished_at_epoch,
          command:$command,command_exit_code:$command_exit_code,
          server:({name:$facts.name,version:$facts.version,backend:"x11-nested",
            endpoint:$facts.endpoint,width:$facts.width,height:$facts.height,
            scale:$facts.scale,protocols:$facts.protocols,
            wayland_info_sha256:$facts.wayland_info_sha256} +
            (if ($facts.outputs | length) > 0 then {outputs:$facts.outputs} else {} end) +
            (if $facts.xwayland != null then {xwayland:$facts.xwayland} else {} end)),
          renderer:{software:true,name:"Pixman",proof:$renderer_proof},
          isolation:{ambient_display_sanitized:true,ambient_dbus_sanitized:true,
            process_group:$process_group,run_root_removed:true,
            display_unreachable_after:true,remaining_processes:[]}
        }' >"${report}"
fi

rm -rf -- "${run_root}"
trap - EXIT HUP INT TERM
exit "${status}"
