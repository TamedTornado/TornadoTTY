#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
product="${ZENTTY_LINUX_BINARY:-${repo_root}/build/linux/bin/zentty-linux}"
log=""
state_directory=""

fail() {
    [[ -z "${log}" || ! -f "${log}" ]] || cat "${log}" >&2
    echo "rust-pane-search-wayland: error: $*" >&2
    exit 1
}

cleanup() {
    [[ -z "${log}" ]] || rm -f -- "${log}"
    [[ -z "${state_directory}" ]] || rm -rf -- "${state_directory}"
}
trap cleanup EXIT

[[ "${GDK_BACKEND:-}" == wayland ]] || fail "GDK_BACKEND must be wayland"
[[ "${ZENTTY_NESTED_WAYLAND_SESSION_ID:-}" =~ ^[0-9a-f]{64}$ ]] ||
    fail "scenario must run through linux/tests/nested-wayland"
[[ -x "${product}" ]] || fail "staged product is not built: ${product}"

log="$(mktemp)"
state_directory="$(mktemp -d)"
GDK_SCALE=1 GDK_DPI_SCALE=1 \
    "${product}" \
    --command 'printf "selectable alpha\nnoise\nselectable beta\nselectable gamma\n"; while IFS= read -r line; do printf "\033]2;focus:%s\a" "$line"; done' \
    --state-directory "${state_directory}" \
    --no-session-restore \
    --exercise-pane-search \
    --quit-after-pane-search >"${log}" 2>&1 ||
    fail "staged product search scenario failed"

grep -Fxq 'zentty-linux: action=find pane=pane-1 binding="start_search"' "${log}" ||
    fail "named Find action did not reach Ghostty"
grep -Fxq 'zentty-linux: pane-search-action-scenario invalid-binding=rejected' "${log}" ||
    fail "embedding boundary did not reject an invalid binding action"
grep -Fxq 'zentty-linux: action=search-scenario-query pane=pane-1 binding="search:selectable"' "${log}" ||
    fail "real scrollback query did not reach Ghostty"
grep -Fxq 'zentty-linux: pane-search-action-scenario verified active=true total=Some(3) selected=false' "${log}" ||
    fail "Ghostty did not report all three Wayland matches"
grep -Fxq 'zentty-linux: pane-search-action-scenario verified active=true total=Some(3) selected=true' "${log}" ||
    fail "Ghostty did not select a Wayland search match"
grep -Fxq 'zentty-linux: action=find-next pane=pane-1 binding="navigate_search:next"' "${log}" ||
    fail "Find Next did not route through the named action"
grep -Fxq 'zentty-linux: action=find-previous pane=pane-1 binding="navigate_search:previous"' "${log}" ||
    fail "Find Previous did not route through the named action"
grep -Fxq 'zentty-linux: pane-search-action-scenario verified active=false total=None selected=false' "${log}" ||
    fail "End Search did not clear the real Ghostty search state"
grep -Fxq 'zentty-linux: pane-search-action-scenario complete' "${log}" ||
    fail "Wayland pane-search scenario did not complete"

echo "Rust pane search passed: wayland, scrollback=real-ghostty, routing=named-actions, compositor=controlled"
