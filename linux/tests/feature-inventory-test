#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
runner="${repo_root}/linux/tests/feature-inventory"
source_inventory="${repo_root}/docs/design/zentty-linux-feature-inventory.json"
source_evidence="${repo_root}/docs/design/zentty-feature-evidence-2026-08-04.json"
temp_dir="$(mktemp -d)"
trap 'rm -rf -- "${temp_dir}"' EXIT

expect_rejected() {
    local name="$1"
    local expected="$2"
    local receipt="${temp_dir}/${name}.log"
    if "${runner}" "${temp_dir}/${name}.json" >"${receipt}" 2>&1; then
        echo "feature-inventory-test: ${name} unexpectedly passed" >&2
        exit 1
    fi
    grep -F "${expected}" "${receipt}" >/dev/null || {
        cat "${receipt}" >&2
        echo "feature-inventory-test: ${name} lacked expected failure" >&2
        exit 1
    }
}

expect_evidence_rejected() {
    local name="$1"
    local expected="$2"
    local receipt="${temp_dir}/${name}.log"
    if "${runner}" "${source_inventory}" "${temp_dir}/${name}.json" >"${receipt}" 2>&1; then
        echo "feature-inventory-test: ${name} unexpectedly passed" >&2
        exit 1
    fi
    grep -F "${expected}" "${receipt}" >/dev/null || {
        cat "${receipt}" >&2
        echo "feature-inventory-test: ${name} lacked expected failure" >&2
        exit 1
    }
}

"${runner}" "${source_inventory}" "${source_evidence}" "${temp_dir}/summary.json" >/dev/null
jq -e '
    .schema_version == 1 and
    .result == "PASS" and
    .entry_count == 60 and
    .classifications.REQUIRED_INITIAL_RELEASE == 34 and
    .implementation_statuses.IMPLEMENTED == 26 and
    .implementation_statuses.PARTIAL == 22 and
    .implementation_statuses.NOT_IMPLEMENTED == 12 and
    .evidence.app_commands == 70 and
    .evidence.pane_commands == 33 and
    .evidence.settings_sections == 9 and
    .evidence.cli_commands == 47 and
    .evidence.swift_product_files == 362 and
    .evidence.swift_test_files == 200
' "${temp_dir}/summary.json" >/dev/null || {
    cat "${temp_dir}/summary.json" >&2
    echo "feature-inventory-test: machine summary is incomplete or incorrect" >&2
    exit 1
}
jq -e '
    [.entries[] | select(.linux_owner_issue == 22)] |
    length == 2 and all(.[]; .implementation_status == "IMPLEMENTED") and
    (map(select(.id == "cli.topology-control-grid-notify"))[0].test_plan |
        contains("All 40 source commands")) and
    (map(select(.id == "shell.environment-integration"))[0].test_plan |
        contains("byte-identical user files"))
' "${source_inventory}" >/dev/null || {
    echo "feature-inventory-test: GH22 CLI/shell closeout evidence regressed" >&2
    exit 1
}
jq -e '
    .entries[] | select(.id == "agent.claude-teams-tmux-compat") |
    .implementation_status == "IMPLEMENTED" and
    (.test_plan | contains("two real GTK windows")) and
    (.test_plan | contains("reject cross-window explicit pane targets")) and
    (.test_plan | contains("application-instance scope"))
' "${source_inventory}" >/dev/null || {
    echo "feature-inventory-test: tmux multi-window closeout evidence regressed" >&2
    exit 1
}
jq -e '
    .entries[] | select(.id == "terminal.remote-ssh-transfer") |
    .implementation_status == "IMPLEMENTED" and
    (.test_plan | contains("multi-window Weston/Wayland"))
' "${source_inventory}" >/dev/null || {
    echo "feature-inventory-test: remote-transfer parity evidence regressed" >&2
    exit 1
}
jq -e '
    .entries[] | select(.id == "clipboard.clean-raw-markdown") |
    .implementation_status == "IMPLEMENTED" and
    (.test_plan | contains("non-text owner")) and
    (.test_plan | contains("two real windows"))
' "${source_inventory}" >/dev/null || {
    echo "feature-inventory-test: clipboard closeout evidence regressed" >&2
    exit 1
}
jq -e '
    .entries[] | select(.id == "desktop.notifications-inbox-routing") |
    .implementation_status == "IMPLEMENTED" and
    (.test_plan | contains("two real Zentty windows")) and
    (.test_plan | contains("targeted mutation testing kills every viable reducer mutant"))
' "${source_inventory}" >/dev/null || {
    echo "feature-inventory-test: attention delivery evidence regressed" >&2
    exit 1
}
jq -e '
    .entries[] | select(.id == "desktop.fleet-status") |
    .implementation_status == "IMPLEMENTED" and
    (.test_plan | contains("real private D-Bus watcher")) and
    (.alternative_or_blocker | contains("always-available in-window fleet"))
' "${source_inventory}" >/dev/null || {
    echo "feature-inventory-test: fleet StatusNotifierItem evidence regressed" >&2
    exit 1
}
jq -e '
    .entries[] | select(.id == "project.git-review-icons") |
    .implementation_status == "IMPLEMENTED" and
    (.test_plan | contains("authenticated agent-completion")) and
    (.test_plan | contains("bounded filesystem"))
' "${source_inventory}" >/dev/null || {
    echo "feature-inventory-test: Git/review event-refresh evidence regressed" >&2
    exit 1
}
jq -e '
    .entries[] | select(.id == "trust.about-licenses-privacy-errors") |
    .implementation_status == "PARTIAL" and
    (.product_scenarios | index("linux/tests/rust-about-licenses")) != null and
    (.product_scenarios | index("linux/tests/debian-package-installed-product")) != null and
    (.test_plan | contains("GH-76"))
' "${source_inventory}" >/dev/null || {
    echo "feature-inventory-test: GH74 About/license evidence regressed" >&2
    exit 1
}
jq -e '
    .entries[] | select(.id == "lifecycle.windows-confirmations") |
    .implementation_status == "IMPLEMENTED" and
    (.focused_tests | index("crates/zentty-core/src/close_decision.rs")) != null and
    (.product_scenarios | index("linux/tests/rust-multi-window")) != null and
    (.test_plan | contains("real Ghostty foreground PID")) and
    (.test_plan | contains("controlled X11 and Wayland"))
' "${source_inventory}" >/dev/null || {
    echo "feature-inventory-test: GH73 lifecycle closeout evidence regressed" >&2
    exit 1
}

jq '.entries += [.entries[0]]' "${source_inventory}" >"${temp_dir}/duplicate.json"
expect_rejected duplicate "duplicate IDs"

jq '.entries[0].classification = "MAYBE"' "${source_inventory}" >"${temp_dir}/unknown-classification.json"
expect_rejected unknown-classification "schema or enum contract failed"

jq '.entries[0].source = ["Zentty/DoesNotExist.swift"]' "${source_inventory}" >"${temp_dir}/missing-source.json"
expect_rejected missing-source "referenced file is missing"

jq 'del(.entries[] | select(.id == "agent.codex"))' "${source_inventory}" >"${temp_dir}/missing-agent.json"
expect_rejected missing-agent "agent codex must have exactly one individual inventory entry"

jq '(.entries[] | select(.classification == "PLATFORM_ALTERNATIVE") | .alternative_or_blocker) = null' \
    "${source_inventory}" >"${temp_dir}/missing-alternative.json"
expect_rejected missing-alternative "schema or enum contract failed"

jq '(.entries[] | select(.id == "workspace.recipe-v3") | .linux_owner_issue) = 4' \
    "${source_inventory}" >"${temp_dir}/owner-swap.json"
expect_rejected owner-swap "feature owner assignment drifted from the reviewed issue ledger"

jq '(.entries[] | select(.id == "workspace.bookmarks-presets")) |=
    (.implementation_status = "IMPLEMENTED" | .product_scenarios = [])' \
    "${source_inventory}" >"${temp_dir}/false-implemented-status.json"
expect_rejected false-implemented-status "schema or enum contract failed"

jq '.entries[0].test_plan = ""' \
    "${source_inventory}" >"${temp_dir}/removed-acceptance-evidence.json"
expect_rejected removed-acceptance-evidence "schema or enum contract failed"

jq '.first_party_documents[0].features += ["missing.feature"]' \
    "${source_evidence}" >"${temp_dir}/unknown-evidence-feature.json"
expect_evidence_rejected unknown-evidence-feature "evidence references unknown feature"

jq 'del(.linux_issues[] | select(.number == 23))' \
    "${source_evidence}" >"${temp_dir}/missing-owner-issue.json"
expect_evidence_rejected missing-owner-issue "feature references nonexistent owner issue"

jq '(.linux_issues[] | select(.number == 4) | .state) = "CLOSED"' \
    "${source_evidence}" >"${temp_dir}/closed-owner-issue.json"
expect_evidence_rejected closed-owner-issue "feature references closed owner issue"

jq '(.linux_issues[] | select(.number == 3) | .depends_on) += [999]' \
    "${source_evidence}" >"${temp_dir}/missing-dependency-issue.json"
expect_evidence_rejected missing-dependency-issue "issue dependency is absent from the reviewed ledger"

jq '.linux_issues += [.linux_issues[0]]' \
    "${source_evidence}" >"${temp_dir}/duplicate-issue.json"
expect_evidence_rejected duplicate-issue "duplicate Linux issue numbers"

jq '.public_release_tags |= .[:-1]' \
    "${source_evidence}" >"${temp_dir}/missing-release.json"
expect_evidence_rejected missing-release "public release ledger must contain all 39 releases"

jq '.release_feature_map |= .[:-1]' \
    "${source_evidence}" >"${temp_dir}/unmapped-release.json"
expect_evidence_rejected unmapped-release "release feature map must cover every public release"

jq '.release_feature_map[0].features = []' \
    "${source_evidence}" >"${temp_dir}/empty-release-evidence.json"
expect_evidence_rejected empty-release-evidence "evidence ledger schema failed"

jq 'del(.command_registry.commands["pane.close_focused"])' \
    "${source_evidence}" >"${temp_dir}/stale-command-registry.json"
expect_evidence_rejected stale-command-registry "command registry coverage is stale or incomplete"

jq 'del(.settings_registry.sections.agents)' \
    "${source_evidence}" >"${temp_dir}/stale-settings-registry.json"
expect_evidence_rejected stale-settings-registry "settings registry coverage is stale"

jq '.command_registry.commands["pane.close_focused"] = "missing.feature"' \
    "${source_evidence}" >"${temp_dir}/unknown-command-owner.json"
expect_evidence_rejected unknown-command-owner "evidence references unknown feature"

jq 'del(.pane_command_registry.commands.closeFocusedPane)' \
    "${source_evidence}" >"${temp_dir}/stale-pane-command-registry.json"
expect_evidence_rejected stale-pane-command-registry "pane command registry coverage is stale or incomplete"

jq '.pane_command_registry.commands.closeFocusedPane = "missing.feature"' \
    "${source_evidence}" >"${temp_dir}/unknown-pane-command-owner.json"
expect_evidence_rejected unknown-pane-command-owner "evidence references unknown feature"

jq '.settings_registry.sections.agents = "missing.feature"' \
    "${source_evidence}" >"${temp_dir}/unknown-settings-owner.json"
expect_evidence_rejected unknown-settings-owner "evidence references unknown feature"

jq 'del(.cli_registry.commands.TmuxCompatCommand)' \
    "${source_evidence}" >"${temp_dir}/stale-cli-registry.json"
expect_evidence_rejected stale-cli-registry "CLI command registry coverage is stale or incomplete"

jq '.cli_registry.commands.TmuxCompatCommand = "missing.feature"' \
    "${source_evidence}" >"${temp_dir}/unknown-cli-owner.json"
expect_evidence_rejected unknown-cli-owner "evidence references unknown feature"

jq 'del(.source_coverage[] | select(.directory == "Zentty/Servers"))' \
    "${source_evidence}" >"${temp_dir}/uncovered-source.json"
expect_evidence_rejected uncovered-source "product source file has no feature coverage"

jq '.source_coverage += [{"directory":"Zentty/UI","recursive":true,"features":["application.sidebar-chrome-source-ux"]}]' \
    "${source_evidence}" >"${temp_dir}/broad-source-rule.json"
expect_evidence_rejected broad-source-rule "evidence ledger schema failed"

jq '.screenshots = []' \
    "${source_evidence}" >"${temp_dir}/missing-screenshot.json"
expect_evidence_rejected missing-screenshot "evidence ledger schema failed"

jq 'del(.first_party_documents[] | select(.id == "site-tmux"))' \
    "${source_evidence}" >"${temp_dir}/missing-required-document.json"
expect_evidence_rejected missing-required-document "required first-party document evidence is missing"

jq '.source_head = "0000000000000000000000000000000000000000"' \
    "${source_evidence}" >"${temp_dir}/stale-source-head.json"
expect_evidence_rejected stale-source-head "audited source head is absent"

jq 'del(.test_coverage[] | select(.path == "ZenttyLogicTests/TmuxFormatRendererTests.swift"))' \
    "${source_evidence}" >"${temp_dir}/uncovered-test.json"
expect_evidence_rejected uncovered-test "test file has no feature coverage or reviewed exclusion"

jq '.test_infrastructure_exclusions[0].reason = "short"' \
    "${source_evidence}" >"${temp_dir}/unreviewed-test-exclusion.json"
expect_evidence_rejected unreviewed-test-exclusion "evidence ledger schema failed"

jq '.test_coverage += [.test_coverage[0]]' \
    "${source_evidence}" >"${temp_dir}/duplicate-test-evidence.json"
expect_evidence_rejected duplicate-test-evidence "duplicate test evidence paths"

echo "feature-inventory runner tests passed"
