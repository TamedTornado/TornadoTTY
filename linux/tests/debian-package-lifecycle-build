#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
output_root="${ZENTTY_PACKAGE_OUTPUT_DIR:-${repo_root}/build/linux-package}"
revision="$(git -C "${repo_root}" rev-parse HEAD)"
source "${repo_root}/linux/tests/lib/exact-package-artifact"

[[ -z "$(git -C "${repo_root}" status --porcelain=v1)" ]] || {
    echo "debian-package-lifecycle-build: error: Zentty checkout must be clean" >&2
    exit 1
}

ZENTTY_GHOSTTY_PREPARED=true "${repo_root}/linux/scripts/build-deb"
zentty_exact_package_artifact "${repo_root}" "${output_root}" || {
    echo "debian-package-lifecycle-build: error: exact-revision package was not produced" >&2
    exit 1
}

"${repo_root}/linux/tests/debian-package-lifecycle" \
    "${ZENTTY_PACKAGE_ARTIFACT}" "${ZENTTY_PACKAGE_MANIFEST}"
echo "debian-package-lifecycle-build: PASS revision=${revision}"
