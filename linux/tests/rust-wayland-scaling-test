#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
subject="${repo_root}/linux/tests/rust-wayland-scaling"

fail() {
    echo "rust-wayland-scaling-test: error: $*" >&2
    exit 1
}

output="$(
    set +e
    env -u ZENTTY_NESTED_WAYLAND_INPUT_SESSION_ID \
        -u ZENTTY_NESTED_WAYLAND_SCALING_PROFILE \
        GDK_BACKEND=wayland ZENTTY_RELEASE_SAFE_BINARY=/bin/true \
        ZENTTY_DEBUG_BINARY=/bin/true "${subject}" 2>&1 || true
)"
grep -Fq 'controlled mixed-scale Wayland session is required' <<<"${output}" ||
    grep -Fq 'controlled mixed-scale compositor session is required' <<<"${output}" ||
        fail "ambient compositor rejection is absent"

# These are literal source-contract fragments, not shell expansions.
# shellcheck disable=SC2016
for contract in \
    'wlr-randr --output X11-1 --scale 1.5' \
    'X11-1 scale ${scale_one} did not retain the controlled output order' \
    'send_compositor_key "${presented_outer}" F1' \
    'wait_for_log_count_greater' \
    'preferred_scale(180)' \
    'preferred_scale(240)' \
    'owned Xwayland scaling session' \
    'X11-1 connected 682x512' \
    'No current owner for _XSETTINGS_S0 selection' \
    'unexpectedly published X resource DPI' \
    'backend=${scaling_backend}' \
    'cd "${run_root}"' \
    'gtk-enable-animations=false' \
    'pointer-proven compositor output' \
    'VISUAL_OUTPUT' \
    'compositor frame did not settle' \
    'single-baseline' \
    'multi-baseline' \
    'fractional-1.5' \
    'Both scaled outputs have smaller logical geometry' \
    'wait_for_changed_stable_geometry' \
    'usable 12-cell-width terminal' \
    'integer-2' \
    'SIGWINCH' \
    'mouse-coordinate'; do
    grep -Fq "${contract}" "${subject}" ||
        fail "missing scaling contract: ${contract}"
done

echo "Rust compositor scaling harness tests passed: Wayland/Xwayland isolation, 1x/1.5x/2x, Debug/ReleaseSafe, single/multi, PTY, SIGWINCH, pointer"
