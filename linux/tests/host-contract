#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
binary="${repo_root}/build/linux/bin/zentty-linux"
options_test="${repo_root}/build/linux/bin/host-options-test"
receipt="${repo_root}/build/linux/host-contract.log"
backend="${GDK_BACKEND:-wayland}"

if [[ ! -x "${binary}" ]]; then
    echo "error: ${binary} does not exist; run linux/scripts/build-local" >&2
    exit 1
fi
if [[ ! -x "${options_test}" ]]; then
    echo "error: ${options_test} does not exist; run linux/scripts/build-local" >&2
    exit 1
fi

"${options_test}" | grep -Fx "host-options-test: PASS" >/dev/null
for invalid_count in 0 5 -1 alphabetic; do
    set +e
    ZENTTY_LINUX_INTEGRATION_TEST=1 \
    ZENTTY_LINUX_INTEGRATION_SURFACES="${invalid_count}" \
        "${binary}" >"${receipt}" 2>&1
    status=$?
    set -e

    if [[ "${status}" -ne 64 ]]; then
        echo "error: invalid surface count ${invalid_count} exited ${status}, expected 64" >&2
        cat "${receipt}" >&2
        exit 1
    fi
    grep -Fx "zentty-linux: invalid integration surface count" \
        "${receipt}" >/dev/null
done

set +e
ZENTTY_LINUX_ASYNC_BACKEND=invalid \
    "${binary}" >"${receipt}" 2>&1
status=$?
set -e
if [[ "${status}" -ne 64 ]]; then
    echo "error: invalid async backend exited ${status}, expected 64" >&2
    cat "${receipt}" >&2
    exit 1
fi
grep -Fx "zentty-linux: invalid async backend" "${receipt}" >/dev/null

echo "Zentty Linux host contract checks passed (${backend})"
