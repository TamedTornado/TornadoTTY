#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
runner="${repo_root}/linux/tests/controlled-x11"
temp_dir="$(mktemp -d)"
trap 'rm -rf -- "${temp_dir}"' EXIT

fail() {
    echo "controlled-x11-test: error: $*" >&2
    exit 1
}

cat >"${temp_dir}/nested" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
printf 'nested\n' >>"${ZENTTY_CONTROLLED_X11_CAPTURE}"
export ZENTTY_NESTED_X11_SESSION_ID="$(printf fixture | sha256sum | awk '{print $1}')"
export DISPLAY=:4242
exec "$@"
EOF

cat >"${temp_dir}/resize" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
[[ "${DISPLAY:-}" == :4242 ]]
[[ "${ZENTTY_NESTED_X11_SESSION_ID:-}" =~ ^[0-9a-f]{64}$ ]]
printf 'resize\n' >>"${ZENTTY_CONTROLLED_X11_CAPTURE}"
EOF

cat >"${temp_dir}/key" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
[[ "${DISPLAY:-}" == :4242 ]]
[[ "${ZENTTY_NESTED_X11_SESSION_ID:-}" =~ ^[0-9a-f]{64}$ ]]
printf 'key\n' >>"${ZENTTY_CONTROLLED_X11_CAPTURE}"
EOF
chmod +x "${temp_dir}/nested" "${temp_dir}/resize" "${temp_dir}/key"

export ZENTTY_NESTED_X11_WRAPPER="${temp_dir}/nested"
export ZENTTY_EXTERNAL_RESIZE_DRIVER="${temp_dir}/resize"
export ZENTTY_PHYSICAL_KEY_DRIVER="${temp_dir}/key"
export ZENTTY_CONTROLLED_X11_CAPTURE="${temp_dir}/capture"

: >"${ZENTTY_CONTROLLED_X11_CAPTURE}"
ZENTTY_CONTROLLED_X11_SCENARIO=all \
ZENTTY_CONTROLLED_X11_ITERATIONS=2 \
    "${runner}" >/dev/null
[[ "$(grep -c '^nested$' "${ZENTTY_CONTROLLED_X11_CAPTURE}")" -eq 1 ]] ||
    fail "standalone all scenario did not allocate exactly one nested session"
[[ "$(grep -c '^resize$' "${ZENTTY_CONTROLLED_X11_CAPTURE}")" -eq 2 ]] ||
    fail "all scenario did not run both resize iterations"
[[ "$(grep -c '^key$' "${ZENTTY_CONTROLLED_X11_CAPTURE}")" -eq 2 ]] ||
    fail "all scenario did not run both key iterations"

: >"${ZENTTY_CONTROLLED_X11_CAPTURE}"
ZENTTY_NESTED_X11_SESSION_ID="$(printf outer | sha256sum | awk '{print $1}')" \
DISPLAY=:4242 \
ZENTTY_CONTROLLED_X11_SCENARIO=physical-key \
ZENTTY_CONTROLLED_X11_ITERATIONS=3 \
    "${runner}" >/dev/null
! grep -q '^nested$' "${ZENTTY_CONTROLLED_X11_CAPTURE}" ||
    fail "matrix-owned nested session was nested a second time"
[[ "$(grep -c '^key$' "${ZENTTY_CONTROLLED_X11_CAPTURE}")" -eq 3 ]] ||
    fail "physical-key scenario did not preserve its iteration count"
! grep -q '^resize$' "${ZENTTY_CONTROLLED_X11_CAPTURE}" ||
    fail "physical-key scenario unexpectedly ran resize"

set +e
ZENTTY_CONTROLLED_X11_SCENARIO=invalid "${runner}" >"${temp_dir}/invalid.log" 2>&1
invalid_status=$?
set -e
[[ "${invalid_status}" -eq 64 ]] || fail "invalid scenario did not exit 64"

set +e
ZENTTY_NESTED_X11_WRAPPER="${temp_dir}/missing" "${runner}" \
    >"${temp_dir}/missing.log" 2>&1
missing_status=$?
set -e
[[ "${missing_status}" -eq 77 ]] || fail "missing nested wrapper did not exit 77"

echo "Controlled X11 orchestration tests passed"
