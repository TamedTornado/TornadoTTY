#!/usr/bin/env bash
set -euo pipefail

fail() {
    echo "arch-package-lifecycle: error: $*" >&2
    exit 1
}

[[ "$#" -eq 3 || "$#" -eq 4 ]] ||
    fail "usage: $0 PACKAGE MANIFEST PROVENANCE [PREVIOUS_PACKAGE]"

package="$(readlink -f -- "$1")"
manifest="$(readlink -f -- "$2")"
provenance="$(readlink -f -- "$3")"
previous_package="${4:-}"
[[ -z "${previous_package}" ]] || previous_package="$(readlink -f -- "${previous_package}")"

for dependency in awk bsdtar cp find grep head jq mktemp pacman readlink sed \
    sha256sum sort unshare vercmp xargs; do
    command -v "${dependency}" >/dev/null || fail "${dependency} is required"
done
for input in "${package}" "${manifest}" "${provenance}"; do
    [[ -f "${input}" ]] || fail "input is missing: ${input}"
done
[[ -z "${previous_package}" || -f "${previous_package}" ]] ||
    fail "previous package is missing: ${previous_package}"
repo_root="${ZENTTY_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)}"

if [[ "${ZENTTY_ARCH_LIFECYCLE_NAMESPACE_ROOT:-false}" != true ]]; then
    lifecycle_arguments=("${package}" "${manifest}" "${provenance}")
    [[ -z "${previous_package}" ]] || lifecycle_arguments+=("${previous_package}")
    exec unshare -Ur -- env ZENTTY_ARCH_LIFECYCLE_NAMESPACE_ROOT=true \
        ZENTTY_ARCH_LIFECYCLE_RECEIPT="${ZENTTY_ARCH_LIFECYCLE_RECEIPT:-}" \
        ZENTTY_REPO_ROOT="${repo_root}" \
        "${BASH_SOURCE[0]}" "${lifecycle_arguments[@]}"
fi

[[ -d "${repo_root}/.git" ]] || fail "Zentty repository root is invalid: ${repo_root}"
# shellcheck disable=SC1091
source /etc/os-release
[[ "${ID:-}" == omarchy || "${ID:-}" == arch ]] ||
    fail "Arch or Omarchy host is required"

"${repo_root}/linux/tests/arch-package-audit" \
    "${package}" "${manifest}" "${provenance}" >/dev/null

temporary="$(mktemp -d)"
trap 'rm -rf -- "${temporary}"' EXIT
root="${temporary}/root"
database="${root}/var/lib/pacman"
cache="${root}/var/cache/pacman/pkg"
config="${temporary}/pacman.conf"
log="${temporary}/pacman.log"
mkdir -p -- "${database}" "${cache}"
cp -a --no-preserve=ownership -- /var/lib/pacman/local "${database}/"
cat >"${config}" <<'EOF'
[options]
Architecture = auto
SigLevel = Required DatabaseOptional
LocalFileSigLevel = Optional
EOF

database_fingerprint() {
    find /var/lib/pacman/local -type f -print0 |
        LC_ALL=C sort -z |
        xargs -0 sha256sum |
        sha256sum |
        awk '{print $1}'
}

package_version() {
    bsdtar -xOf "$1" .PKGINFO |
        sed -n 's/^pkgver = //p' |
        head -1
}

pacman_root() {
    pacman --config "${config}" --root "${root}" --dbpath "${database}" \
        --cachedir "${cache}" "$@"
}

pacman_root_logged() {
    local operation="$1"
    shift
    if ! pacman_root "$@" >>"${log}" 2>&1; then
        cat "${log}" >&2
        fail "${operation} failed"
    fi
}

host_database_before="$(database_fingerprint)"
previous_version=null
current_archive_version="$(package_version "${package}")"
if [[ -n "${previous_package}" ]]; then
    previous_version="$(package_version "${previous_package}")"
    version_order="$(vercmp "${current_archive_version}" "${previous_version}")"
    (( version_order > 0 )) ||
        fail "current package does not sort newer than upgrade fixture"
    pacman_root_logged "previous package install" \
        --noconfirm -U "${previous_package}"
    previous_name="$(bsdtar -xOf "${previous_package}" .PKGINFO | sed -n 's/^pkgname = //p' | head -1)"
    [[ "$(pacman_root -Q "${previous_name}" | awk '{print $2}')" == "${previous_version}" ]] ||
        fail "previous package did not install at its declared version"
fi

current_install_arguments=(--noconfirm -U "${package}")
if [[ -n "${previous_package}" ]]; then
    # Pacman's --noconfirm retains the safe default of "no" for removing a
    # conflicting package. Question mask 4 explicitly answers only the package
    # conflict prompt so the reviewed Conflicts/Replaces migration is exercised.
    current_install_arguments=(--noconfirm --ask 4 -U "${package}")
fi
pacman_root_logged "current package install or upgrade" \
    "${current_install_arguments[@]}"
current_version="$(jq -r '.package_version + "-1"' "${provenance}")"
[[ "$(pacman_root -Q tornadotty | awk '{print $2}')" == "${current_version}" ]] ||
    fail "current package did not install at its provenance version"
pacman_root_logged "installed payload verification" -Qkk tornadotty
grep -Fq '0 altered files' "${log}" || fail "installed package payload differs"
for legacy_path in /usr/bin/zentty /usr/bin/zentty-linux /usr/lib/zentty; do
    [[ ! -e "${root}${legacy_path}" && ! -L "${root}${legacy_path}" ]] ||
        fail "legacy installed path remains after upgrade: ${legacy_path}"
done

help_output="${temporary}/help"
LD_LIBRARY_PATH="${root}/usr/lib/tornadotty/lib" \
    "${root}/usr/lib/tornadotty/bin/tornadotty" --help >"${help_output}"
grep -Fxq 'Usage: tornadotty [OPTIONS]' "${help_output}" ||
    fail "installed application help contract failed"

pacman_root_logged "current package uninstall" --noconfirm -R tornadotty
if pacman_root -Q tornadotty >/dev/null 2>&1; then
    fail "package remains registered after uninstall"
fi
while IFS= read -r path; do
    [[ ! -e "${root}${path}" && ! -L "${root}${path}" ]] ||
        fail "owned path remains after uninstall: ${path}"
done < <(jq -r '.files[].path' "${manifest}")
host_database_after="$(database_fingerprint)"
[[ "${host_database_before}" == "${host_database_after}" ]] ||
    fail "host pacman database changed during disposable lifecycle"

receipt="${ZENTTY_ARCH_LIFECYCLE_RECEIPT:-${package%.pkg.tar.zst}.lifecycle.json}"
jq -n \
    --arg package "$(basename "${package}")" \
    --arg package_sha256 "$(sha256sum "${package}" | awk '{print $1}')" \
    --arg current_version "${current_version}" \
    --arg previous_version "${previous_version}" \
    --arg help_sha256 "$(sha256sum "${help_output}" | awk '{print $1}')" \
    --arg host_database_sha256 "${host_database_after}" \
    --arg os_id "${ID}" --arg os_version "${VERSION_ID:-rolling}" \
    '{schema_version:1,claim:"PASS",
      environment:{kind:"unprivileged-user-namespace",pacman_root:"disposable",
        pacman_database:"copy-of-real-host",host_root_mutated:false,
        os_id:$os_id,os_version:$os_version},
      package:{file:$package,sha256:$package_sha256,version:$current_version},
      previous_version:(if $previous_version == "null" then null else $previous_version end),
      upgrade_direction_verified:($previous_version != "null"),
      transitions:(if $previous_version == "null"
        then ["install","installed-help","uninstall"]
        else ["install-previous","upgrade","installed-help","uninstall"] end),
      evidence:{help_sha256:$help_sha256,
        host_pacman_database_sha256:$host_database_sha256}}' >"${receipt}"

echo "arch-package-lifecycle: PASS version=${current_version} upgrade=$([[ "${previous_version}" == null ]] && echo no || echo yes)"
