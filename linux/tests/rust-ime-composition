#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
product="${ZENTTY_LINUX_BINARY:-${repo_root}/build/linux/bin/zentty-linux}"
backend="${GDK_BACKEND:-}"
ime_provider="${ZENTTY_CONTROLLED_IME_PROVIDER:-ibus}"
run_root="$(mktemp -d)"
state_directory="${run_root}/state"
receipt="${run_root}/pty.receipt"
close_marker="${run_root}/close-pane-2"
focus_marker="${run_root}/focus-pane-1"
return_marker="${run_root}/focus-pane-2"
child="${run_root}/child"
log="${run_root}/product.log"
product_pid=""
focus_helper_pid=""

# shellcheck source=linux/tests/lib/product-input
source "${repo_root}/linux/tests/lib/product-input"
# shellcheck source=linux/tests/lib/product-bundle
source "${repo_root}/linux/tests/lib/product-bundle"

fail() {
    [[ ! -f "${log}" ]] || cat "${log}" >&2
    [[ ! -f "${receipt}" ]] || sed 's/^/pty-receipt: /' "${receipt}" >&2
    echo "rust-ime-composition: error: $*" >&2
    exit 1
}

cleanup() {
    if [[ "${focus_helper_pid}" =~ ^[1-9][0-9]*$ ]]; then
        kill -TERM "${focus_helper_pid}" 2>/dev/null || true
        wait "${focus_helper_pid}" 2>/dev/null || true
    fi
    if [[ "${product_pid}" =~ ^[1-9][0-9]*$ ]]; then
        kill -TERM "${product_pid}" 2>/dev/null || true
        wait "${product_pid}" 2>/dev/null || true
    fi
    rm -rf -- "${run_root}"
}
trap cleanup EXIT

[[ "${backend}" == x11 || "${backend}" == wayland ]] ||
    fail "GDK_BACKEND must be x11 or wayland"
case "${ime_provider}" in
    ibus)
        [[ "${ZENTTY_CONTROLLED_IBUS_ACTOR_SESSION_ID:-}" =~ ^[0-9]+-[A-Za-z0-9]+$ ]] ||
            fail "composition must run in the controlled private IBus session"
        [[ "${GTK_IM_MODULE:-}" == ibus && -n "${IBUS_ADDRESS:-}" ]] ||
            fail "composition requires the wrapper-owned IBus GTK context"
        [[ "$(ibus engine 2>/dev/null || true)" == table:cangjie5 ]] ||
            fail "composition requires the pinned table:cangjie5 engine"
        dependencies=(ibus grep sed)
        ;;
    fcitx)
        [[ "${ZENTTY_CONTROLLED_FCITX_SESSION_ID:-}" =~ ^[0-9a-f]{64}$ ]] ||
            fail "composition must run in the controlled private fcitx session"
        [[ "${GTK_IM_MODULE:-}" == fcitx && "${XMODIFIERS:-}" == @im=fcitx ]] ||
            fail "composition requires the wrapper-owned fcitx GTK context"
        dependencies=(busctl fcitx5-remote grep readlink sed)
        ;;
    *) fail "unsupported input-method provider: ${ime_provider}" ;;
esac
dependencies+=(dd od stty tr)
if [[ "${backend}" == x11 ]]; then
    dependencies+=(xdotool)
else
    dependencies+=(wtype)
    if [[ "${ZENTTY_NESTED_WAYLAND_OUTER_X11_INPUT:-}" == 1 ]]; then
        dependencies+=(xdotool)
    fi
fi
for dependency in "${dependencies[@]}"; do
    command -v "${dependency}" >/dev/null || fail "${dependency} is required"
done

activate_fcitx() {
    [[ "${ime_provider}" == fcitx ]] || return 0
    # The public focus receipt is emitted when Zentty selects the surface;
    # fcitx publishes the replacement GTK input context asynchronously on the
    # next compositor/GLib turns. State 0 means the focused context is closed,
    # not that it is absent, so activation itself is the bounded readiness
    # handshake; the exact PTY receipt proves which context received input.
    sleep 0.1
    for _ in {1..100}; do
        # Context construction is asynchronous. Reissue the idempotent open
        # and switch requests until the currently focused context can accept
        # them instead of losing a one-shot request sent before publication.
        fcitx5-remote -o >/dev/null 2>&1 || true
        fcitx5-remote -s cangjie5 >/dev/null 2>&1 || true
        if [[ "$(fcitx5-remote)" == 2 && "$(fcitx5-remote -n)" == cangjie5 ]]; then
            # The controller acknowledgement can precede delivery of the
            # activation signal to the focused GTK module. Give that real
            # D-Bus/GLib transition one bounded turn before physical input.
            sleep 0.1
            return 0
        fi
        sleep 0.05
    done
    printf 'rust-ime-composition: fcitx-state=%s engine=%s\n' \
        "$(fcitx5-remote 2>/dev/null || true)" \
        "$(fcitx5-remote -n 2>/dev/null || true)" >&2
    busctl --user tree org.fcitx.Fcitx5 2>&1 |
        sed 's/^/rust-ime-composition: fcitx-tree: /' >&2 || true
    fail "focused pane did not activate the pinned fcitx engine"
}

reactivate_fcitx_for_selected_pane() {
    [[ "${ime_provider}" == fcitx ]] || return 0
    local transition_log transition_pid transition_window=""
    transition_log="$(mktemp "${run_root}/focus-transition.XXXXXX.log")"
    GTK_IM_MODULE=gtk-im-context-simple XMODIFIERS='' \
        "${focus_helper}" >"${transition_log}" 2>&1 &
    transition_pid=$!
    zentty_product_wait_for_log "${transition_log}" \
        'zentty-focus-steal-helper: ACTIVE compositor-focus-owned' \
        'selected-pane focus transition helper did not become active' ||
        fail "selected-pane focus transition helper failed"
    if [[ "${backend}" == x11 ]]; then
        for _ in {1..100}; do
            transition_window="$(
                xdotool search --onlyvisible --pid "${transition_pid}" \
                    --name '^Zentty controlled IME focus helper$' 2>/dev/null |
                    head -1 || true
            )"
            [[ "${transition_window}" =~ ^[1-9][0-9]*$ ]] && break
            sleep 0.02
        done
        [[ "${transition_window}" =~ ^[1-9][0-9]*$ ]] ||
            fail "selected-pane X11 focus transition was not observable"
        xdotool windowfocus --sync "${transition_window}"
        xdotool windowfocus --sync "${ZENTTY_PRODUCT_WINDOW_ID}"
        xdotool mousemove --window "${ZENTTY_PRODUCT_WINDOW_ID}" 700 400 click 1
    else
        # Cage gives the newly mapped helper compositor focus. Destroy it and
        # use a real outer-seat click to generate a fresh keyboard enter for
        # the already-selected terminal surface.
        kill -TERM "${transition_pid}"
        wait "${transition_pid}" || true
        transition_pid=""
        xdotool mousemove --sync --window "${ZENTTY_PRODUCT_WINDOW_ID}" 700 400 click 1
    fi
    activate_fcitx
    if [[ "${transition_pid}" =~ ^[1-9][0-9]*$ ]]; then
        kill -TERM "${transition_pid}"
        wait "${transition_pid}" || true
    fi
}

ime_type() {
    local value="$1"
    if zentty_product_uses_xdotool "${backend}"; then
        # IM context focus is itself the behavior under test. Re-applying X11
        # focus to the parent before every synthetic physical event can emit a
        # spurious GTK focus cycle and cancel the controlled preedit.
        xdotool type --delay 5 -- "${value}"
    else
        wtype "${value}"
    fi
}

ime_key() {
    local key="$1"
    if zentty_product_uses_xdotool "${backend}"; then
        xdotool key "${key}"
    else
        wtype -k "${key}"
    fi
}

ime_ctrl_key() {
    local key="$1"
    if zentty_product_uses_xdotool "${backend}"; then
        xdotool key "ctrl+${key}"
    else
        wtype -M ctrl -k "${key}" -m ctrl
    fi
}

wait_fcitx_context_published() {
    [[ "${ime_provider}" == fcitx ]] || return 0
    for _ in {1..250}; do
        if busctl --user tree org.fcitx.Fcitx5 2>/dev/null |
            grep -Eq '/(org/freedesktop/portal/)?inputcontext(/|_)'; then
            echo 'rust-ime-composition: fcitx-context=published-before-focus-transfer'
            return 0
        fi
        sleep 0.02
    done
    fail "fcitx GTK context was not published before focus transfer"
}

[[ -x "${product}" ]] || fail "staged Zentty product is missing: ${product}"
zentty_product_bundle_resolve "${product}" || fail "staged product bundle is invalid"
product="${ZENTTY_PRODUCT_BINARY}"
bundle_lib="${ZENTTY_PRODUCT_BUNDLE_LIB}"
focus_helper="$(dirname "${product}")/zentty-focus-steal-helper"
if [[ "${ime_provider}" == fcitx && ! -x "${focus_helper}" ]]; then
    fail "staged fcitx focus helper is missing: ${focus_helper}"
fi
mkdir -p "${state_directory}" "${XDG_CONFIG_HOME}/zentty"
cat >"${XDG_CONFIG_HOME}/zentty/config.toml" <<'CONFIG'
[confirmations]
confirm_before_closing_pane = false
confirm_before_closing_worklane = false
confirm_before_closing_window = false
confirm_before_quitting = false
CONFIG

cat >"${child}" <<'CHILD'
#!/usr/bin/env bash
set -euo pipefail
trap 'status=$?; printf "%s:ERROR:%s:%s\n" "${ZENTTY_PANE_ID}" "${LINENO}" "${status}" >>"${ZENTTY_IME_RECEIPT}"; exit "${status}"' ERR

record() {
    printf '%s:%s\n' "${ZENTTY_PANE_ID}" "$1" >>"${ZENTTY_IME_RECEIPT}"
}

case "${ZENTTY_PANE_ID}" in
    pane-1)
        while [[ ! -e "${ZENTTY_IME_FOCUS_MARKER}" ]]; do sleep 0.02; done
        "${ZENTTY_CLI_BIN}" pane focus --pane-id pane-1
        IFS= read -r after_focus
        if [[ "${after_focus}" != 1 ]]; then
            record "MISMATCH:${after_focus@Q}"
        fi
        [[ "${after_focus}" == 1 ]]
        record "${after_focus}"
        : >"${ZENTTY_IME_RETURN_MARKER}"
        IFS= read -r after_destroy
        [[ "${after_destroy}" == 日 ]]
        record "${after_destroy}"
        sleep 30
        ;;
    pane-2)
        (
            while [[ ! -e "${ZENTTY_IME_RETURN_MARKER}" ]]; do sleep 0.02; done
            "${ZENTTY_CLI_BIN}" pane focus --pane-id pane-2
            while [[ ! -e "${ZENTTY_IME_CLOSE_MARKER}" ]]; do sleep 0.02; done
            "${ZENTTY_CLI_BIN}" pane close --pane-id pane-2
        ) &
        original_stty="$(stty -g)"
        stty raw -echo
        backspace_raw="$(dd bs=1 count=7 2>/dev/null | od -An -tx1 | tr -d ' \n')"
        stty "${original_stty}"
        [[ "${backspace_raw}" == e697a5e697a50d ]]
        record "BACKSPACE-RAW:${backspace_raw}"
        IFS= read -r after_transfer
        if [[ "${after_transfer}" != 日 ]]; then
            record "MISMATCH:${after_transfer@Q}"
        fi
        [[ "${after_transfer}" == 日 ]]
        record "${after_transfer}"
        sleep 30
        ;;
    *) exit 64 ;;
esac
CHILD
chmod +x "${child}"

ZENTTY_IME_RECEIPT="${receipt}" \
ZENTTY_IME_CLOSE_MARKER="${close_marker}" \
ZENTTY_IME_FOCUS_MARKER="${focus_marker}" \
ZENTTY_IME_RETURN_MARKER="${return_marker}" \
LD_LIBRARY_PATH="${bundle_lib}${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}" \
    "${product}" --command "${child}" --state-directory "${state_directory}" \
    --no-session-restore >"${log}" 2>&1 &
product_pid=$!
zentty_product_prepare_input "${backend}" "${log}" ||
    fail "physical ${backend} input unavailable"

if [[ "${ime_provider}" == fcitx && -n "${ZENTTY_CONTROLLED_FCITX_GTK4_MODULE:-}" ]]; then
    expected_fcitx_module="$(readlink -f -- "${ZENTTY_CONTROLLED_FCITX_GTK4_MODULE}")"
    [[ -f "${expected_fcitx_module}" ]] || fail "pinned fcitx GTK4 module is missing"
    module_loaded=false
    for _ in {1..200}; do
        if grep -Fq "${expected_fcitx_module}" "/proc/${product_pid}/maps" 2>/dev/null; then
            module_loaded=true
            break
        fi
        sleep 0.02
    done
    [[ "${module_loaded}" == true ]] ||
        fail "product did not load the pinned fcitx GTK4 module"
    printf 'rust-ime-composition: fcitx-gtk-module version=%s path=%s\n' \
        "${ZENTTY_CONTROLLED_FCITX_GTK4_VERSION:?}" "${expected_fcitx_module}"
fi

if [[ "${ime_provider}" == fcitx ]]; then
    helper_log="${run_root}/focus-helper.log"
    initial_focus_before="$(grep -Fc 'focus-pane pane=pane-1' "${log}" || true)"
    # Wait for asynchronous client publication, then drive a real compositor
    # transition. The helper deliberately uses GTK's simple context so the only
    # fcitx context in this phase belongs to the product under test.
    wait_fcitx_context_published
    GTK_IM_MODULE=gtk-im-context-simple XMODIFIERS='' \
        "${focus_helper}" >"${helper_log}" 2>&1 &
    focus_helper_pid=$!
    zentty_product_wait_for_log "${helper_log}" \
        'zentty-focus-steal-helper: ACTIVE compositor-focus-owned' \
        "real GTK focus helper did not receive compositor focus" ||
        fail "fcitx focus helper failed"
    if [[ "${backend}" == x11 ]]; then
        helper_window=""
        for _ in {1..100}; do
            helper_window="$(
                xdotool search --onlyvisible --pid "${focus_helper_pid}" \
                    --name '^Zentty controlled IME focus helper$' 2>/dev/null |
                    head -1 || true
            )"
            [[ "${helper_window}" =~ ^[1-9][0-9]*$ ]] && break
            sleep 0.02
        done
        [[ "${helper_window}" =~ ^[1-9][0-9]*$ ]] ||
            fail "controlled X11 focus helper window was not observable"
        xdotool windowfocus --sync "${helper_window}"
    fi
    sleep 0.25
    if [[ "${backend}" == x11 ]]; then
        # Keep the inactive helper alive until both GTK and fcitx acknowledge
        # the product focus. Destroying the helper first lets X11 window-manager
        # fallback and its later focus-out race the explicit product activation.
        xdotool windowfocus --sync "${ZENTTY_PRODUCT_WINDOW_ID}"
        xdotool mousemove --window "${ZENTTY_PRODUCT_WINDOW_ID}" 700 400 click 1
    else
        # Destroying the helper makes the product eligible for activation, but
        # nested Cage does not always deliver keyboard focus to its terminal
        # child without a compositor gesture. Click the real product surface
        # through the wrapper-owned outer X11 input path before asking fcitx to
        # open the newly focused context.
        kill -TERM "${focus_helper_pid}"
        wait "${focus_helper_pid}" || true
        focus_helper_pid=""
        if [[ "${ZENTTY_NESTED_WAYLAND_OUTER_X11_INPUT:-}" == 1 ]]; then
            xdotool mousemove --sync --window "${ZENTTY_PRODUCT_WINDOW_ID}" 700 400 click 1
        fi
    fi
    zentty_product_wait_for_log_count "${log}" 'focus-pane pane=pane-1' \
        "$((initial_focus_before + 1))" \
        "product did not regain compositor focus after the real GTK transition" ||
        fail "fcitx product focus transition failed"
    activate_fcitx
    if [[ "${backend}" == x11 ]]; then
        kill -TERM "${focus_helper_pid}"
        wait "${focus_helper_pid}" || true
        focus_helper_pid=""
    fi
fi
pane_2_focus_before="$(grep -Fc 'focus-pane pane=pane-2' "${log}" || true)"
ime_ctrl_key t
zentty_product_wait_for_log "${log}" 'terminal-ready-pane=pane-2' \
    "second real pane was not created" || fail "IME multi-pane setup failed"
zentty_product_wait_for_log_count "${log}" 'focus-pane pane=pane-2' \
    "$((pane_2_focus_before + 1))" \
    "second terminal surface did not receive initial focus" ||
    fail "IME initial compositor-focus barrier failed"
activate_fcitx

# A Cangjie `a`, Space commits 日 without a newline. A second `a` starts a new
# preedit and physical Backspace must be consumed by that input context. The
# final `a`, Space, Return commits another 日 and sends CR. Pane 2 is in raw
# mode for this probe: its exact seven-byte receipt proves the earlier composed
# text survived and neither DEL (7f) nor BS (08) leaked into the real PTY.
ime_type a
ime_key space
ime_type a
ime_key BackSpace
ime_type a
ime_key space
ime_key Return
zentty_product_wait_for_log "${receipt}" 'pane-2:BACKSPACE-RAW:e697a5e697a50d' \
    "active-preedit Backspace leaked or corrupted composed PTY bytes" ||
    fail "preedit Backspace byte journey failed"

# Move focus through the public application API while `a` is still preedit.
# Plain `1` in pane 1 proves the pending pane-2 preedit stays owned by pane 2.
ime_type a
pane_1_focus_before="$(grep -Fc 'focus-pane pane=pane-1' "${log}" || true)"
: >"${focus_marker}"
zentty_product_wait_for_log_count "${log}" 'focus-pane pane=pane-1' \
    "$((pane_1_focus_before + 1))" \
    "public API did not restore focus to the first pane" ||
    fail "IME focus restoration failed"
reactivate_fcitx_for_selected_pane
pane_2_focus_before="$(grep -Fc 'focus-pane pane=pane-2' "${log}" || true)"
ime_type 1
ime_key Return
zentty_product_wait_for_log "${receipt}" 'pane-1:1' \
    "focus transfer retained or leaked pending preedit text" ||
    fail "IME focus reset failed"
zentty_product_wait_for_log_count "${log}" 'focus-pane pane=pane-2' \
    "$((pane_2_focus_before + 1))" \
    "first pane did not restore focus to the second pane" ||
    fail "IME second focus restoration failed"
reactivate_fcitx_for_selected_pane
ime_type a
ime_key space
ime_key Return
zentty_product_wait_for_log_count "${receipt}" 'pane-2:日' 1 \
    "refocused second pane did not receive an independent composition" ||
    fail "IME post-focus composition failed"

# Destroy pane 2 from pane 1's authenticated CLI while pane 2 has active
# preedit. The exact close receipt, continued product life, and a fresh
# composition in pane 1 jointly guard the surface/IM-context teardown path.
ime_type a
pane_1_focus_before="$(grep -Fc 'focus-pane pane=pane-1' "${log}" || true)"
: >"${close_marker}"
zentty_product_wait_for_log "${log}" 'action=close-pane pane=pane-2' \
    "active-preedit pane was not destroyed through the product lifecycle" ||
    fail "IME destruction action failed"
zentty_product_wait_for_log_count "${log}" 'focus-pane pane=pane-1' \
    "$((pane_1_focus_before + 1))" \
    "surviving terminal did not regain focus after destruction" ||
    fail "IME post-destruction focus barrier failed"
kill -0 "${product_pid}" 2>/dev/null || fail "product died after active-preedit destruction"
reactivate_fcitx_for_selected_pane
ime_type a
ime_key space
ime_key Return
zentty_product_wait_for_log "${receipt}" 'pane-1:日' \
    "surviving pane could not compose after active-preedit destruction" ||
    fail "IME post-destruction composition failed"

[[ "$(grep -Fxc 'pane-1:日' "${receipt}")" -eq 1 ]] ||
    fail "post-destruction journey produced duplicate or missing commits"
[[ "$(grep -Fxc 'pane-1:1' "${receipt}")" -eq 1 ]] ||
    fail "focus journey produced duplicate or missing plain input"
[[ "$(grep -Fxc 'pane-2:BACKSPACE-RAW:e697a5e697a50d' "${receipt}")" -eq 1 ]] ||
    fail "Backspace journey produced duplicate or incorrect raw bytes"
[[ "$(grep -Fxc 'pane-2:日' "${receipt}")" -eq 1 ]] ||
    fail "post-focus journey produced duplicate or missing commits"

zentty_product_close_window "${backend}"
wait "${product_pid}" || fail "product did not exit cleanly after IME journey"
product_pid=""
echo "rust-ime-composition-${backend}: PASS real-${ime_provider} preedit-backspace exact-bytes commit focus-transfer active-preedit-destruction real-pty"
