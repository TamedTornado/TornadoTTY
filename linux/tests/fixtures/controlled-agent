#!/usr/bin/env bash
set -euo pipefail

profile="${ZENTTY_CONTROLLED_AGENT_PROFILE:-}"
helper="${ZENTTY_CLI_BIN:-}"
fixture_dir="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
sleep_seconds="${ZENTTY_CONTROLLED_AGENT_SLEEP_SECONDS:-2}"
start_delay_seconds="${ZENTTY_CONTROLLED_AGENT_START_DELAY_SECONDS:-0}"
start_gate="${ZENTTY_CONTROLLED_AGENT_START_GATE:-}"
finish_gate="${ZENTTY_CONTROLLED_AGENT_FINISH_GATE:-}"

fail() {
    echo "controlled-agent: $*" >&2
    exit 64
}

[[ -n "${profile}" ]] || fail "ZENTTY_CONTROLLED_AGENT_PROFILE is required"
[[ "${sleep_seconds}" =~ ^[0-9]+([.][0-9]+)?$ ]] ||
    fail "ZENTTY_CONTROLLED_AGENT_SLEEP_SECONDS must be a non-negative number"
[[ "${start_delay_seconds}" =~ ^[0-9]+([.][0-9]+)?$ ]] ||
    fail "ZENTTY_CONTROLLED_AGENT_START_DELAY_SECONDS must be a non-negative number"
if [[ "${start_gate}" == *'{pane}'* ]]; then
    [[ "${ZENTTY_PANE_ID:-}" =~ ^[A-Za-z0-9._-]+$ ]] ||
        fail "pane-scoped start gate requires a safe ZENTTY_PANE_ID"
    start_gate="${start_gate//\{pane\}/${ZENTTY_PANE_ID}}"
fi
[[ -z "${start_gate}" || "${start_gate}" == /* ]] ||
    fail "ZENTTY_CONTROLLED_AGENT_START_GATE must be an absolute path"
[[ -z "${finish_gate}" || "${finish_gate}" == /* ]] ||
    fail "ZENTTY_CONTROLLED_AGENT_FINISH_GATE must be an absolute path"
[[ -z "${finish_gate}" || -p "${finish_gate}" ]] ||
    fail "ZENTTY_CONTROLLED_AGENT_FINISH_GATE must be an existing FIFO"

if [[ "${profile}" == kimi-hooks && "${1:-}" == --help ]]; then
    printf 'Kimi modern controlled help\n'
    exit 0
fi
if [[ "${profile}" == kimi-legacy-hooks && "${1:-}" == --help ]]; then
    printf 'Kimi legacy controlled help --config-file FILE\n'
    exit 0
fi

require_helper() {
    [[ -x "${helper}" ]] || fail "ZENTTY_CLI_BIN must name the staged executable helper"
}

if [[ -n "${ZENTTY_CONTROLLED_AGENT_START_RECEIPT:-}" ]]; then
    printf 'started pid:%s profile:%s\n' "$$" "${profile}" \
        >>"${ZENTTY_CONTROLLED_AGENT_START_RECEIPT}"
    printf 'launch agent:%s canonical:%s socket:%s token:%s lane:%s pane:%s pi-disabled:%s amp-disabled:%s args:<%s>\n' \
        "${ZENTTY_AGENT_TOOL:-}" \
        "${ZENTTY_AGENT_CANONICAL_NAME:-}" "${ZENTTY_INSTANCE_SOCKET:-}" \
        "${ZENTTY_PANE_TOKEN:-}" "${ZENTTY_WORKLANE_ID:-}" "${ZENTTY_PANE_ID:-}" \
        "${ZENTTY_PI_HOOKS_DISABLED:-}" "${ZENTTY_AMP_HOOKS_DISABLED:-}" "$*" \
        >>"${ZENTTY_CONTROLLED_AGENT_START_RECEIPT}"
    if [[ "${ZENTTY_AGENT_TOOL:-}" == opencode ]]; then
        printf 'opencode-config:%s\n' "${OPENCODE_CONFIG_DIR:-}" \
            >>"${ZENTTY_CONTROLLED_AGENT_START_RECEIPT}"
    fi
fi
if [[ -n "${start_gate}" ]]; then
    for _ in {1..400}; do
        [[ -e "${start_gate}" ]] && break
        sleep 0.05
    done
    [[ -e "${start_gate}" ]] || fail "controlled start gate did not open"
else
    sleep "${start_delay_seconds}"
fi

codex_has_hook() {
    local hook="$1"
    local argument
    for argument in "${@:2}"; do
        [[ "${argument}" == "hooks.${hook}="* ]] && return 0
    done
    return 1
}

case "${profile}" in
    event-coalescing)
        require_helper
        burst_gate="${ZENTTY_CONTROLLED_AGENT_BURST_GATE:-}"
        burst_receipt="${ZENTTY_CONTROLLED_AGENT_BURST_RECEIPT:-}"
        burst_count="${ZENTTY_CONTROLLED_AGENT_BURST_COUNT:-500}"
        [[ "${burst_gate}" == /* ]] ||
            fail "ZENTTY_CONTROLLED_AGENT_BURST_GATE must be an absolute path"
        [[ "${burst_receipt}" == /* ]] ||
            fail "ZENTTY_CONTROLLED_AGENT_BURST_RECEIPT must be an absolute path"
        [[ "${burst_count}" =~ ^[1-9][0-9]*$ && "${burst_count}" -le 10000 ]] ||
            fail "ZENTTY_CONTROLLED_AGENT_BURST_COUNT must be between 1 and 10000"
        event="$(jq -cn --argjson pid "$$" --arg directory "${PWD}" \
            '{version:1,event:"agent.running",agent:{name:"Codex",pid:$pid},session:{id:"event-coalescing"},context:{workingDirectory:$directory}}')"
        printf '%s' "${event}" | "${helper}" ipc agent-event
        spinner_frames=('⠋' '⠙' '⠹' '⠸' '⠼' '⠴' '⠦' '⠧' '⠇' '⠏')
        printf '\033]0;Working %s event-coalescing\007' "${spinner_frames[0]}"
        printf 'primed\n' >"${burst_receipt}"
        for _ in {1..400}; do
            [[ -e "${burst_gate}" ]] && break
            sleep 0.05
        done
        [[ -e "${burst_gate}" ]] || fail "event burst gate did not open"
        for ((event_index = 0; event_index < burst_count; event_index++)); do
            printf '%s' "${event}" | "${helper}" ipc agent-event
            frame_index=$((event_index % ${#spinner_frames[@]}))
            printf '\033]0;Working %s event-coalescing\007' "${spinner_frames[frame_index]}"
        done
        printf 'completed=%s\n' "${burst_count}" >>"${burst_receipt}"
        transition="$(jq -cn \
            '{version:1,event:"task.progress",agent:{name:"Codex"},session:{id:"event-coalescing"},progress:{done:1,total:2}}')"
        printf '%s' "${transition}" | "${helper}" ipc agent-event
        printf '%s' "${transition}" | "${helper}" ipc agent-event
        printf 'transition=sent-twice\n' >>"${burst_receipt}"
        ;;
    amp-plugin)
        require_helper
        [[ "${PLUGINS:-}" == all ]] || fail "Amp plugin activation is missing"
        [[ "${ZENTTY_AGENT_TOOL:-}" == amp ]] || fail "Amp tool identity is missing"
        [[ "${ZENTTY_AMP_RESUME_ARGUMENTS_JSON:-}" == '["--mode","smart"]' ]] ||
            fail "Amp sanitized launch snapshot is incorrect"
        plugin_root="${XDG_CONFIG_HOME:-${HOME}/.config}"
        plugin="${plugin_root}/amp/plugins/zentty-amp-zentty.ts"
        [[ -f "${plugin}" ]] || fail "installed Amp plugin is missing"
        [[ -x "${fixture_dir}/amp-cli-audit" ]] || fail "Amp CLI audit fixture is missing"
        [[ -n "${ZENTTY_AMP_AUDIT_RECEIPT:-}" ]] || fail "Amp audit receipt is required"
        AMP_API_KEY="controlled-secret-never-log" \
            ZENTTY_CLI_BIN="${fixture_dir}/amp-cli-audit" \
            ZENTTY_AMP_AUDIT_REAL_HELPER="${helper}" \
            bun "${fixture_dir}/amp-plugin-driver.ts" "${plugin}"
        ;;
    restore-immediate-failure)
        printf 'restore-failure pid:%s pane:%s\n' "$$" "${ZENTTY_PANE_ID:-}" \
            >>"${ZENTTY_CONTROLLED_AGENT_START_RECEIPT}"
        exit 42
        ;;
    attention-inbox)
        require_helper
        receipt="${ZENTTY_CONTROLLED_ATTENTION_RECEIPT:-}"
        [[ -n "${receipt}" ]] || fail "ZENTTY_CONTROLLED_ATTENTION_RECEIPT is required"
        "${helper}" codex-notify \
            '{"type":"question","session_id":"attention-inbox-e2e","message":"Allow the controlled deployment?"}'
        IFS= read -r response
        printf 'response=%s\n' "${response}" >"${receipt}"
        "${helper}" codex-notify \
            '{"type":"agent-turn-complete","session_id":"attention-inbox-e2e"}'
        ;;
    codex-permission)
        require_helper
        codex_has_hook PermissionRequest "$@" || fail "Codex PermissionRequest hook is missing"
        codex_has_hook state "$@" || fail "Codex hook state is missing"
        printf '%s\n' "$@" | grep -Fq 'notify=[' || fail "Codex notify callback is missing"
        printf '%s\n' "$@" | grep -Fq 'tui.notifications=["approval-requested"]' ||
            fail "Codex semantic approval notification filter is missing"
        printf '%s\n' "$@" | grep -Fq 'tui.notification_condition="always"' ||
            fail "Codex semantic approval notification delivery is not focus-independent"
        permission_gate="${ZENTTY_CONTROLLED_CODEX_PERMISSION_GATE:-}"
        [[ "${permission_gate}" == /* && -p "${permission_gate}" ]] ||
            fail "ZENTTY_CONTROLLED_CODEX_PERMISSION_GATE must be an existing absolute FIFO"
        printf '%s' \
            '{"hook_event_name":"PreToolUse","session_id":"codex-e2e","tool_name":"shell"}' |
            "${helper}" ipc agent-event --adapter=codex
        printf '%s' \
            '{"session_id":"codex-e2e","turn_id":"turn-e2e","transcript_path":null,"cwd":"/tmp","hook_event_name":"PermissionRequest","model":"gpt-5.6","permission_mode":"default","tool_name":"shell","tool_input":{"command":"cargo test"}}' |
            "${helper}" ipc agent-event --adapter=codex
        printf 'permission-request-emitted\n' >>"${ZENTTY_CONTROLLED_AGENT_START_RECEIPT}"
        IFS= read -r _ <"${permission_gate}"
        # The runner selects the user-review outcome by releasing the exact
        # semantic OSC 9 channel configured above. Ghostty, not this fixture or
        # TornadoTTY, parses the terminal protocol.
        printf '\033]9;Run cargo test?\007'
        ;;
    codex-notify)
        require_helper
        printf '%s\n' "$@" | grep -Fq 'notify=[' || fail "Codex notify callback is missing"
        "${helper}" codex-notify \
            '{"type":"question","session_id":"codex-notify-e2e","message":"Choose execution mode?\n[Sandboxed] [Elevated]"}'
        ;;
    codex-title)
        require_helper
        codex_has_hook PreToolUse "$@" || fail "Codex PreToolUse hook is missing"
        printf '%s' \
            '{"hook_event_name":"PreToolUse","session_id":"codex-title-e2e","tool_name":"shell"}' |
            "${helper}" ipc agent-event --adapter=codex
        sleep 0.2
        printf '\033]0;[ ! ] Action Required | codex-title | Tasks 1/3\007'
        ;;
    codex-title-transcript)
        require_helper
        [[ -n "${ZENTTY_CONTROLLED_CODEX_TRANSCRIPT:-}" ]] ||
            fail "ZENTTY_CONTROLLED_CODEX_TRANSCRIPT is required"
        codex_has_hook PreToolUse "$@" || fail "Codex PreToolUse hook is missing"
        printf '{"hook_event_name":"PreToolUse","session_id":"codex-title-transcript-e2e","tool_name":"shell","transcript_path":"%s"}' \
            "${ZENTTY_CONTROLLED_CODEX_TRANSCRIPT}" |
            "${helper}" ipc agent-event --adapter=codex
        sleep 0.2
        printf '\033]0;[ ! ] Action Required | plan-mode-prompt\007'
        sleep 0.15
        printf '{"cwd":"%s"}\n' "${PWD}" >"${ZENTTY_CONTROLLED_CODEX_TRANSCRIPT}"
        printf '%s\n' \
            '{"type":"function_call","name":"request_user_input","arguments":{"questions":[{"question":"Choose the integration scope","options":[{"label":"Minimal"},{"label":"Complete"}]}]}}' \
            >>"${ZENTTY_CONTROLLED_CODEX_TRANSCRIPT}"
        ;;
    codex-title-transcript-pending)
        require_helper
        [[ -n "${ZENTTY_CONTROLLED_CODEX_TRANSCRIPT:-}" ]] ||
            fail "ZENTTY_CONTROLLED_CODEX_TRANSCRIPT is required"
        codex_has_hook PreToolUse "$@" || fail "Codex PreToolUse hook is missing"
        printf '{"hook_event_name":"PreToolUse","session_id":"codex-title-transcript-pending-e2e","tool_name":"shell","transcript_path":"%s"}' \
            "${ZENTTY_CONTROLLED_CODEX_TRANSCRIPT}" |
            "${helper}" ipc agent-event --adapter=codex
        sleep 0.2
        printf '\033]0;[ ! ] Action Required | pending-transcript\007'
        if [[ "${ZENTTY_CONTROLLED_AGENT_PENDING_ONESHOT:-false}" != true ]]; then
            while sleep 1; do :; done
        fi
        ;;
    codex-progress)
        require_helper
        codex_has_hook PreToolUse "$@" || fail "Codex PreToolUse hook is missing"
        printf '%s' \
            '{"hook_event_name":"PreToolUse","session_id":"codex-progress-e2e","tool_name":"shell"}' |
            "${helper}" ipc agent-event --adapter=codex
        printf '%s' \
            '{"type":"agent-turn-complete","session_id":"codex-progress-e2e"}' |
            "${helper}" codex-notify
        sleep 0.2
        printf '\033]9;4;3\007'
        sleep 0.2
        ;;
    codex-lifecycle)
        require_helper
        printf '%s\n' "$@" | grep -Fq 'notify=[' || fail "Codex notify callback is missing"
        "${helper}" codex-notify \
            '{"type":"question","session_id":"codex-lifecycle-e2e","message":"Submit this answer?"}'
        IFS= read -r _
        "${helper}" codex-notify \
            '{"type":"question","session_id":"codex-lifecycle-e2e","message":"Interrupt this run?"}'
        if [[ "${ZENTTY_CONTROLLED_AGENT_LIFECYCLE_ONESHOT:-false}" == true ]]; then
            "${helper}" codex-notify \
                '{"type":"agent-turn-complete","session_id":"codex-lifecycle-e2e"}'
            printf '%s' \
                '{"hook_event_name":"PreToolUse","session_id":"codex-lifecycle-e2e","tool_name":"shell"}' |
                "${helper}" ipc agent-event --adapter=codex
        else
            trap ':' INT
            (
                trap '' INT
                sleep 0.5
                "${helper}" codex-notify \
                    '{"type":"agent-turn-complete","session_id":"codex-lifecycle-e2e"}'
                sleep 0.3
                printf '%s' \
                    '{"hook_event_name":"PreToolUse","session_id":"codex-lifecycle-e2e","tool_name":"shell"}' |
                    "${helper}" ipc agent-event --adapter=codex
            ) &
            while sleep 1; do :; done
        fi
        ;;
    agent-status-lifecycle)
        require_helper
        "${helper}" ipc agent-status running \
            --tool 'Review Bot' \
            --session-id agent-status-parent-e2e \
            --text 'Running through the compatibility CLI'
        "${helper}" ipc agent-signal pid attach "$$" \
            --tool 'Review Bot' \
            --session-id agent-status-parent-e2e
        sleep 0.2
        "${helper}" ipc agent-status needs-input \
            --tool 'Review Bot' \
            --session-id agent-status-parent-e2e \
            --text 'Choose λ mode --literal [Safe] [Fast]'
        sleep 0.4
        "${helper}" ipc agent-status completed \
            --tool 'Review Bot' \
            --session-id agent-status-parent-e2e
        sleep 0.2
        "${helper}" ipc agent-status clear \
            --tool 'Review Bot' \
            --session-id agent-status-parent-e2e
        sleep 0.2
        ;;
    claude-question)
        require_helper
        settings=""
        previous=""
        for argument in "$@"; do
            [[ "${previous}" == --settings ]] && settings="${argument}"
            previous="${argument}"
        done
        [[ "${settings}" == *'"PermissionRequest"'* &&
            "${settings}" == *'agent-event --adapter=claude'* ]] ||
            fail "Claude ephemeral hook settings are missing"
        printf '%s' \
            '{"session_id":"claude-e2e","tool_name":"AskUserQuestion","tool_input":{"questions":[{"question":"Deploy now?"}]}}' |
            "${helper}" ipc agent-event --adapter=claude PreToolUse
        ;;
    claude-lifecycle)
        require_helper
        settings=""
        previous=""
        for argument in "$@"; do
            [[ "${previous}" == --settings ]] && settings="${argument}"
            previous="${argument}"
        done
        [[ "${settings}" == *'"SessionStart"'* &&
            "${settings}" == *'"PermissionRequest"'* &&
            "${settings}" == *'agent-event --adapter=claude'* ]] ||
            fail "Claude lifecycle hook settings are missing"
        for payload in \
            '{"hook_event_name":"SessionStart","session_id":"claude-life-e2e"}' \
            '{"hook_event_name":"UserPromptSubmit","session_id":"claude-life-e2e"}' \
            '{"hook_event_name":"PreToolUse","session_id":"claude-life-e2e","tool_name":"AskUserQuestion","tool_input":{"questions":[{"question":"Choose deployment","options":[{"label":"Staging"},{"label":"Production"}]}]}}' \
            '{"hook_event_name":"Stop","session_id":"claude-life-e2e"}' \
            '{"hook_event_name":"Notification","session_id":"claude-life-e2e","message":"Claude is waiting for your input"}' \
            '{"hook_event_name":"PermissionRequest","session_id":"claude-life-e2e","tool_name":"Bash","message":"Allow release command?"}'; do
            printf '%s' "${payload}" |
                "${helper}" ipc agent-event --adapter=claude
            sleep 0.1
        done
        ;;
    claude-task-lifecycle)
        require_helper
        settings=""
        previous=""
        for argument in "$@"; do
            [[ "${previous}" == --settings ]] && settings="${argument}"
            previous="${argument}"
        done
        [[ "${settings}" == *'"TaskCreated"'* &&
            "${settings}" == *'"TaskCompleted"'* ]] ||
            fail "Claude task lifecycle hook settings are missing"
        for payload in \
            '{"hook_event_name":"TaskCompleted","session_id":"claude-task-e2e","task_id":"task-b"}' \
            '{"hook_event_name":"TaskCreated","session_id":"claude-task-e2e","task_id":"task-a"}' \
            '{"hook_event_name":"TaskCreated","session_id":"claude-task-e2e","task_id":"task-b"}' \
            '{"hook_event_name":"TaskCreated","session_id":"claude-task-e2e","task_id":"task-a"}' \
            '{"hook_event_name":"TaskCompleted","session_id":"claude-task-e2e","task_id":"task-a"}'; do
            printf '%s' "${payload}" |
                "${helper}" ipc agent-event --adapter=claude
            sleep 0.1
        done
        ;;
    copilot-question)
        require_helper
        [[ -f "${COPILOT_HOME:-}/config.json" ]] ||
            fail "Copilot config overlay is missing"
        grep -Fq -- '--adapter=copilot' "${COPILOT_HOME}/config.json" ||
            fail "Copilot hook command is missing"
        printf '%s' \
            '{"session_id":"123e4567-e89b-12d3-a456-426614174000","toolName":"AskUserQuestion","toolArgs":"{\"question\":\"Choose the Copilot path?\"}"}' |
            "${helper}" ipc agent-event --adapter=copilot pre-tool-use
        ;;
    copilot-presentation)
        require_helper
        [[ -f "${COPILOT_HOME:-}/config.json" ]] ||
            fail "Copilot config overlay is missing"
        grep -Fq -- '--adapter=copilot' "${COPILOT_HOME}/config.json" ||
            fail "Copilot hook command is missing"
        printf '%s' \
            '{"session_id":"copilot-presentation-e2e","cwd":"/tmp"}' |
            "${helper}" ipc agent-event --adapter=copilot session-start
        printf '\033]9;4;3\007'
        sleep 0.2
        printf '\033]2;Asking user question\007'
        sleep 0.2
        printf '\033]9;4;3\007'
        sleep 0.2
        ;;
    copilot-title-negative)
        printf '\033]2;Asking the oracle\007\033]9;4;3\007'
        sleep 0.2
        ;;
    managed-prelaunch)
        sleep 0.3
        ;;
    opencode-live-theme)
        receipt="${ZENTTY_CONTROLLED_OPENCODE_THEME_RECEIPT:-}"
        [[ -n "${receipt}" ]] || fail "ZENTTY_CONTROLLED_OPENCODE_THEME_RECEIPT is required"
        trap 'printf "signal=USR2 pid=%s\n" "$$" >"${receipt}"; exit 0' USR2
        while sleep 0.1; do :; done
        ;;
    small-harness-adapter)
        require_helper
        hooks_file="${SMALL_HARNESS_MANAGED_HOOKS_FILE:-}"
        [[ -f "${hooks_file}" ]] || fail "Small Harness managed hooks file is missing"
        grep -Fq -- '--adapter=small-harness' "${hooks_file}" ||
            fail "Small Harness hook command is missing"
        for payload in \
            '{"hook_event_name":"SessionStart","session_id":"small-harness-e2e"}' \
            '{"hook_event_name":"PlanUpdated","session_id":"small-harness-e2e","progress":{"doneCount":2,"totalCount":5}}' \
            '{"hook_event_name":"SubagentStart","session_id":"small-harness-e2e","subagent_id":"worker-a"}' \
            '{"hook_event_name":"SubagentStop","session_id":"small-harness-e2e","subagent_id":"worker-a"}'; do
            printf '%s' "${payload}" |
                "${helper}" ipc agent-event --adapter=small-harness
            sleep 0.1
        done
        ;;
    gemini-permission)
        require_helper
        settings="${GEMINI_CLI_SYSTEM_SETTINGS_PATH:-}"
        [[ -f "${settings}" ]] || fail "Gemini system-settings overlay is missing"
        grep -Fq '"enableNotifications": true' "${settings}" ||
            fail "Gemini terminal notifications were not enabled"
        grep -Fq -- '--adapter=gemini' "${settings}" ||
            fail "Gemini hook command is missing"
        printf '%s' \
            '{"hook_event_name":"Notification","session_id":"gemini-e2e","notification_type":"ToolPermission","message":"Action required","details":{"tool_name":"write_file","file_path":"README.md"}}' |
            "${helper}" ipc agent-event --adapter=gemini >/dev/null
        ;;
    gemini-notifications)
        settings="${GEMINI_CLI_SYSTEM_SETTINGS_PATH:-}"
        [[ -f "${settings}" ]] || fail "Gemini system-settings overlay is missing"
        grep -Fq '"enableNotifications": true' "${settings}" ||
            fail "Gemini terminal notifications were not enabled"
        printf '\033]777;notify;Gemini;Action required\a'
        # Ghostty intentionally admits at most one desktop notification per
        # second. Exercise both accepted events rather than weakening or
        # bypassing its product-owned rate limiter.
        sleep 1.2
        printf '\033]777;notify;Gemini;Session complete\a'
        sleep 0.3
        ;;
    cursor-hooks)
        require_helper
        cursor_config="${CURSOR_CONFIG_DIR:-}"
        hooks_file="${cursor_config}/hooks.json"
        session_id="123e4567-e89b-12d3-a456-426614174000"
        [[ -d "${cursor_config}" && -f "${hooks_file}" ]] ||
            fail "Cursor private hook overlay is missing"
        [[ "$(stat -c '%a' "${cursor_config}")" == 700 ]] ||
            fail "Cursor config overlay is not private"
        [[ "$(stat -c '%a' "${hooks_file}")" == 600 ]] ||
            fail "Cursor hook file is not private"
        jq -e '
            .version == 1 and
            (.hooks | length) == 10 and
            .hooks.preToolUse == [{"command":.hooks.preToolUse[0].command,"matcher":"TodoWrite"}] and
            .hooks.postToolUse == [{"command":.hooks.postToolUse[0].command,"matcher":"TodoWrite"}]
        ' "${hooks_file}" >/dev/null || fail "Cursor generated hooks are incomplete"
        cursor_hook() {
            local event="$1"
            local payload="$2"
            local command
            command="$(jq -er --arg event "${event}" '.hooks[$event][0].command' "${hooks_file}")" ||
                fail "Cursor hook command is missing for ${event}"
            printf '%s' "${payload}" | /bin/sh -c "${command}"
        }
        cursor_hook sessionStart \
            "{\"hook_event_name\":\"sessionStart\",\"conversation_id\":\"${session_id}\",\"workspace_roots\":[\"${PWD}\"],\"transcript_path\":\"/tmp/controlled-cursor.jsonl\"}"
        cursor_hook beforeSubmitPrompt \
            "{\"hook_event_name\":\"beforeSubmitPrompt\",\"conversation_id\":\"${session_id}\"}"
        cursor_hook preToolUse \
            "{\"hook_event_name\":\"preToolUse\",\"conversation_id\":\"${session_id}\",\"tool_name\":\"TodoWrite\",\"tool_input\":{\"merge\":false,\"todos\":[{\"id\":\"one\",\"status\":\"pending\"},{\"id\":\"two\",\"status\":\"pending\"},{\"id\":\"three\",\"status\":\"pending\"}]}}"
        cursor_hook postToolUse \
            "{\"hook_event_name\":\"postToolUse\",\"conversation_id\":\"${session_id}\",\"tool_name\":\"TodoWrite\",\"tool_input\":{\"merge\":true,\"todos\":[{\"id\":\"one\",\"status\":\"completed\"},{\"id\":\"three\",\"status\":\"completed\"},{\"id\":\"four\",\"status\":\"pending\"}]}}"
        cursor_hook subagentStart \
            "{\"hook_event_name\":\"subagentStart\",\"parent_conversation_id\":\"${session_id}\",\"subagent_id\":\"worker-one\"}"
        cursor_hook subagentStop \
            "{\"hook_event_name\":\"subagentStop\",\"parent_conversation_id\":\"${session_id}\",\"subagent_id\":\"worker-one\"}"
        if printf '%s' \
            "{\"hook_event_name\":\"stop\",\"conversation_id\":\"${session_id}\",\"status\":\"error\"}" |
            ZENTTY_PANE_TOKEN=bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb \
                "${helper}" ipc agent-event --adapter=cursor >/dev/null 2>&1; then
            fail "Cursor bad-token negative control was accepted"
        fi
        cursor_hook stop \
            "{\"hook_event_name\":\"stop\",\"conversation_id\":\"${session_id}\",\"status\":\"completed\"}"
        {
