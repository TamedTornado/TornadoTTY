#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
product="${ZENTTY_LINUX_BINARY:-${repo_root}/build/linux/bin/zentty-linux}"
if [[ "${product}" != /* ]]; then
    product="${repo_root}/${product}"
fi
run_root="$(mktemp -d)"
project="${run_root}/project"
state_directory="${run_root}/state"
receipt="${run_root}/task.receipt"
make_receipt="${run_root}/make.receipt"
source_receipt="${run_root}/source.receipt"
config_home="${run_root}/config"
fixture_bin="${run_root}/bin"
log="${run_root}/product.log"
product_pid=""
backend="${GDK_BACKEND:-}"

# shellcheck source=linux/tests/lib/product-bundle
source "${repo_root}/linux/tests/lib/product-bundle"
# shellcheck source=linux/tests/lib/product-input
source "${repo_root}/linux/tests/lib/product-input"

fail() {
    [[ ! -f "${log}" ]] || cat "${log}" >&2
    echo "rust-task-runners: error: $*" >&2
    exit 1
}

cleanup() {
    if [[ "${product_pid}" =~ ^[1-9][0-9]*$ ]]; then
        kill -TERM "${product_pid}" 2>/dev/null || true
        wait "${product_pid}" 2>/dev/null || true
    fi
    rm -rf -- "${run_root}"
}
trap cleanup EXIT

case "${backend}" in
    x11)
        [[ "${ZENTTY_NESTED_X11_SESSION_ID:-}" =~ ^[0-9a-f]{64}$ ]] ||
            fail "X11 scenario must run through linux/tests/nested-x11"
        command -v xdotool >/dev/null || fail "xdotool is required"
        ;;
    wayland)
        [[ "${ZENTTY_NESTED_WAYLAND_INPUT_SESSION_ID:-}" =~ ^[0-9a-f]{64}$ ]] ||
            fail "Wayland scenario must run through linux/tests/nested-wayland-input"
        command -v wtype >/dev/null || fail "wtype is required"
        ;;
    *) fail "GDK_BACKEND must be x11 or wayland" ;;
esac
for dependency in grep head mktemp readelf sed seq sleep; do
    command -v "${dependency}" >/dev/null || fail "${dependency} is required"
done
[[ -x "${product}" ]] || fail "staged product is missing: ${product}"
zentty_product_bundle_resolve "${product}" || fail "staged product bundle is invalid"
product="${ZENTTY_PRODUCT_BINARY}"
bundle_lib="${ZENTTY_PRODUCT_BUNDLE_LIB}"

mkdir -p "${project}/.git" "${project}/.vscode" "${project}/tasks" \
    "${state_directory}" "${config_home}/zentty" "${fixture_bin}"
cat >"${fixture_bin}/source-open" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
printf 'argc=%s\narg1=%s\n' "$#" "${1:-}" >"${ZENTTY_TASK_SOURCE_RECEIPT}"
EOF
chmod 700 "${fixture_bin}/source-open"
cat >"${config_home}/zentty/config.toml" <<EOF
[open_with]
primary_target_id = "custom:task-source"
enabled_target_ids = ["custom:task-source"]

[[open_with.custom_apps]]
id = "custom:task-source"
name = "Controlled Task Source"
path = "${fixture_bin}/source-open"
EOF
cat >"${project}/package.json" <<'EOF'
{
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "package-visible": "printf package-task"
  }
}
EOF
cat >"${project}/Taskfile.yml" <<'EOF'
version: '3'
includes:
  api: ./tasks/api.yml
tasks:
  taskfile-visible:
    desc: Source Taskfile task
EOF
cat >"${project}/tasks/api.yml" <<'EOF'
version: '3'
tasks:
  included-visible:
EOF
cat >"${project}/justfile" <<'EOF'
just-visible:
  printf just-task
EOF
cat >"${project}/Makefile" <<EOF
.PHONY: make-integration
make-integration:
	@printf 'cwd=%s\ncommand=make-integration\n' "\$\$(pwd)" >'${make_receipt}'
EOF
cat >"${project}/mise.toml" <<'EOF'
[tasks.mise-visible]
description = "Source mise task"
run = "printf mise-task"
EOF
cat >"${project}/.vscode/tasks.json" <<'EOF'
{
  // The physical product journey proves JSONC and Linux overrides.
  "tasks": [
    {
      "label": "vscode-integration",
      "command": "ignored-on-linux",
      "linux": {
        "command": "./task-fixture",
        "args": ["exact argument"]
      },
      "options": {
        "env": { "ZENTTY_TASK_ENV": "from-vscode" }
      }
    },
    {
      "label": "disabled-parameter",
      "command": "printf ${file}"
    },
  ],
}
EOF
cat >"${project}/task-fixture" <<EOF
#!/usr/bin/env bash
set -euo pipefail
{
    printf 'cwd=%s\n' "\${PWD}"
    printf 'environment=%s\n' "\${ZENTTY_TASK_ENV:-missing}"
    printf 'argument=%s\n' "\${1:-missing}"
} >'${receipt}'
EOF
chmod 700 "${project}/task-fixture"

(
    cd "${project}"
        exec env \
            XDG_CONFIG_HOME="${config_home}" \
            PATH="${fixture_bin}:${PATH}" \
            ZENTTY_TASK_SOURCE_RECEIPT="${source_receipt}" \
        GDK_SCALE=1 \
        GDK_DPI_SCALE=1 \
        LD_LIBRARY_PATH="${bundle_lib}${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}" \
        "${product}" \
        --state-directory "${state_directory}" \
        --no-session-restore
) >"${log}" 2>&1 &
product_pid=$!

window_id=""
if [[ "${backend}" == x11 ]]; then
    window_id="$(zentty_product_find_x11_window "${product_pid}" 300)" ||
        fail "real mapped X11 Zentty window did not appear"
fi
for _ in $(seq 1 300); do
    if [[ "${backend}" == wayland ]]; then
        window_id=wayland-focused
    fi
    if [[ -n "${window_id}" ]] && grep -Fxq 'zentty-linux: terminal-ready' "${log}"; then
        break
    fi
    sleep 0.05
done
[[ -n "${window_id}" ]] || fail "real Zentty window did not appear"
if [[ "${backend}" == wayland ]]; then
    for _ in $(seq 1 100); do
        grep -Fq 'zentty-linux: focus-pane pane=pane-1' "${log}" && break
        sleep 0.05
    done
    grep -Fq 'zentty-linux: focus-pane pane=pane-1' "${log}" ||
        fail "Wayland compositor had not focused the real terminal"
fi
# Terminal readiness only proves that Ghostty created the PTY. Task discovery
# is scoped to the pane's shell-reported working directory, so opening the
# palette before that independent boundary is observable can legitimately
# produce an empty task catalog.
for _ in $(seq 1 200); do
    grep -Fq "zentty-linux: title-pane=pane-1 value=${project}" "${log}" && break
    sleep 0.05
done
grep -Fq "zentty-linux: title-pane=pane-1 value=${project}" "${log}" ||
    fail "real shell did not publish the task project working directory"

open_palette() {
    if [[ "${backend}" == x11 ]]; then
        xdotool windowfocus --sync "${window_id}"
        xdotool key --window "${window_id}" ctrl+shift+p
    else
        wtype -M ctrl -M shift -k p -m shift -m ctrl
    fi
}

type_text() {
    if [[ "${backend}" == x11 ]]; then
        xdotool type --window "${window_id}" --delay 5 -- "$1"
    else
        wtype -- "$1"
    fi
}

activate_first() {
    if [[ "${backend}" == x11 ]]; then
        xdotool key --window "${window_id}" Down Return
    else
        wtype -k Down -k Return
    fi
}

query='Run task: vscode-integration'
open_palette
type_text "${query}"
for _ in $(seq 1 100); do
    grep -Fq "command-palette=query value=\"${query}\" results=1" "${log}" && break
    sleep 0.05
done
grep -Fq "command-palette=query value=\"${query}\" results=1" "${log}" ||
    fail "VS Code task was absent from the real command palette"

# Change the source after discovery but before activation. The opaque GTK
# parameter still identifies the old snapshot, which must not execute.
printf '\n' >>"${project}/.vscode/tasks.json"
activate_first
for _ in $(seq 1 100); do
    grep -Fq 'action=run-task rejected=stale' "${log}" && break
    sleep 0.05
done
grep -Fq 'action=run-task rejected=stale' "${log}" ||
    fail "changed task source was not rejected at activation"
[[ ! -e "${receipt}" ]] || fail "stale task unexpectedly executed"

# Every source-advertised format must cross the real product discovery path;
# parser-only coverage is not sufficient product evidence.
for format_query in \
    'Run task: package-visible' \
    'Run task: taskfile-visible' \
    'Run task: api:included-visible' \
    'Run task: just-visible' \
    'Run task: make-integration' \
    'Run task: mise-visible'; do
    open_palette
    type_text "${format_query}"
    for _ in $(seq 1 100); do
        grep -Fq "command-palette=query value=\"${format_query}\" results=1" "${log}" && break
        sleep 0.05
    done
    grep -Fq "command-palette=query value=\"${format_query}\" results=1" "${log}" ||
        fail "advertised task format was absent from the real palette: ${format_query}"
    if [[ "${backend}" == x11 ]]; then
        xdotool key --window "${window_id}" Escape
    else
        wtype -k Escape
    fi
done

# Source Zentty opens a disabled task's discovered source file. It must not
# execute or guess the unsupported variable.
disabled_query='Run task: disabled-parameter'
open_palette
type_text "${disabled_query}"
for _ in $(seq 1 100); do
    grep -Fq "command-palette=query value=\"${disabled_query}\" results=1" "${log}" && break
    sleep 0.05
done
grep -Fq "command-palette=query value=\"${disabled_query}\" results=1" "${log}" ||
    fail "disabled task source action was absent from the real palette"
activate_first
for _ in $(seq 1 100); do
    [[ -s "${source_receipt}" ]] && break
    sleep 0.05
done
[[ -s "${source_receipt}" ]] || fail "disabled task did not launch its source opener"
grep -Fxq 'argc=1' "${source_receipt}" || fail "disabled task source opener received the wrong argv count"
grep -Fxq "arg1=${project}/.vscode/tasks.json" "${source_receipt}" ||
    fail "disabled task did not open its exact canonical source file"
[[ ! -e "${receipt}" ]] || fail "disabled task unexpectedly executed"

# A fresh palette snapshot may launch the real project task in a real Ghostty
# terminal with its source directory, environment, and quoted argument.
focus_before_task="$(grep -Fc 'zentty-linux: focus-pane pane=pane-1' "${log}" || true)"
open_palette
type_text "${query}"
for _ in $(seq 1 100); do
    [[ "$(grep -Fc "command-palette=query value=\"${query}\" results=1" "${log}" || true)" -ge 2 ]] && break
    sleep 0.05
done
activate_first
for _ in $(seq 1 200); do
    [[ -s "${receipt}" ]] && break
    sleep 0.05
done
[[ -s "${receipt}" ]] || fail "fresh task did not execute in the real Ghostty PTY"
grep -Fxq "cwd=${project}" "${receipt}" || fail "task used the wrong working directory"
grep -Fxq 'environment=from-vscode' "${receipt}" || fail "task environment was not projected"
grep -Fxq 'argument=exact argument' "${receipt}" || fail "task argv was not shell-quoted"
grep -Fq 'zentty-linux: action=run-task pane=' "${log}" || fail "product emitted no task launch receipt"
grep -Fq 'command="./task-fixture '\''exact argument'\''"' "${log}" ||
    fail "product launched a command different from the discovered task"
grep -Fq 'cwd='"${project}" "${log}" || fail "new task pane did not retain its project CWD"

# The short task pane exits after writing its receipt. Wait for the real pane
# lifecycle to return focus before opening another palette; otherwise input can
# correctly land on the surface being removed rather than the new popover.
for _ in $(seq 1 200); do
    if grep -Fq 'zentty-linux: child-exited-pane=pane-2' "${log}" &&
        (( $(grep -Fc 'zentty-linux: focus-pane pane=pane-1' "${log}" || true) > focus_before_task )); then
        break
    fi
    sleep 0.05
done
grep -Fq 'zentty-linux: child-exited-pane=pane-2' "${log}" || fail "completed task pane did not exit"
(( $(grep -Fc 'zentty-linux: focus-pane pane=pane-1' "${log}" || true) > focus_before_task )) ||
    fail "focus did not return after the completed task pane exited"

# Launch one non-VS-Code source through the same real palette and Ghostty pane.
make_query='Run task: make-integration'
make_query_before="$(grep -Fc "command-palette=query value=\"${make_query}\" results=1" "${log}" || true)"
open_palette
type_text "${make_query}"
for _ in $(seq 1 100); do
    (( $(grep -Fc "command-palette=query value=\"${make_query}\" results=1" "${log}" || true) > make_query_before )) && break
    sleep 0.05
done
(( $(grep -Fc "command-palette=query value=\"${make_query}\" results=1" "${log}" || true) > make_query_before )) ||
    fail "make task was absent from the fresh real palette snapshot"
activate_first
for _ in $(seq 1 200); do
    [[ -s "${make_receipt}" ]] && break
    sleep 0.05
done
grep -Fxq "cwd=${project}" "${make_receipt}" || fail "make task used the wrong source directory"
grep -Fxq 'command=make-integration' "${make_receipt}" || fail "make task did not execute the named source target"
grep -Fq 'command="make make-integration"' "${log}" || fail "product launched the wrong make command"

echo "rust-task-runners-${backend}: PASS all-formats disabled-source-open real-palette real-ghostty-pty stale-revalidation cwd environment quoted-argv"
