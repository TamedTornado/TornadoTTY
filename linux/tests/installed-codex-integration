#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
product="${ZENTTY_LINUX_BINARY:-${repo_root}/build/linux/bin/zentty-linux}"
state_directory=""
codex_home_directory=""
log=""
product_pid=""

# shellcheck disable=SC1091
source "${repo_root}/linux/tests/lib/product-input"

fail() {
    [[ -z "${log}" || ! -f "${log}" ]] || cat "${log}" >&2
    echo "installed-codex-integration: error: $*" >&2
    exit 1
}

cleanup() {
    if [[ "${product_pid}" =~ ^[1-9][0-9]*$ ]]; then
        kill -TERM "${product_pid}" 2>/dev/null || true
        wait "${product_pid}" 2>/dev/null || true
    fi
    [[ -z "${log}" ]] || rm -f -- "${log}"
    [[ -z "${state_directory}" ]] || rm -rf -- "${state_directory}"
    [[ -z "${codex_home_directory}" ]] || rm -rf -- "${codex_home_directory}"
}
trap cleanup EXIT

[[ "${GDK_BACKEND:-}" == x11 ]] || fail "GDK_BACKEND must be x11"
[[ "${ZENTTY_NESTED_X11_SESSION_ID:-}" =~ ^[0-9a-f]{64}$ ]] ||
    fail "installed Codex integration must run through linux/tests/nested-x11"
for dependency in codex grep jq mktemp; do
    command -v "${dependency}" >/dev/null || fail "${dependency} is required"
done
[[ -x "${product}" ]] || fail "staged product is not built: ${product}"

codex_version="$(codex --version 2>/dev/null)"
[[ "${codex_version}" == "codex-cli 0.146.0" ]] ||
    fail "review the installed Codex contract before accepting version: ${codex_version}"

state_directory="$(mktemp -d)"
codex_home_directory="$(mktemp -d)"
log="$(mktemp)"
cat >"${codex_home_directory}/config.toml" <<EOF
model_provider = "zentty-test"
model = "gpt-5.6-sol"

[model_providers.zentty-test]
name = "Zentty Test"
base_url = "http://127.0.0.1:1/v1"
env_key = "ZENTTY_TEST_MODEL_KEY"
wire_api = "responses"

[projects."${repo_root}"]
trust_level = "trusted"
EOF

start_product() {
    : >"${log}"
    env CODEX_HOME="${codex_home_directory}" ZENTTY_TEST_MODEL_KEY=not-a-real-key \
        "${product}" "$@" >"${log}" 2>&1 &
    product_pid=$!
}

close_product() {
    zentty_product_prepare_input x11 "${log}" || fail "could not prepare real X11 input"
    zentty_product_close_window x11
    for _ in {1..240}; do
        kill -0 "${product_pid}" 2>/dev/null || break
        sleep 0.05
    done
    kill -0 "${product_pid}" 2>/dev/null && fail "product did not close through Ctrl+Q"
    set +e
    wait "${product_pid}"
    status=$?
    set -e
    product_pid=""
    ((status == 0)) || fail "staged product exited ${status}"
}

start_product \
    --state-directory "${state_directory}" \
    --command "codex 'Zentty installed Codex integration probe'" \
    --no-session-restore
zentty_product_wait_for_log "${log}" 'zentty-linux: agent-event pane=pane-1 worklane=worklane-1' \
    "installed Codex did not deliver authenticated SessionStart" || fail "real Codex event missing"
zentty_product_wait_for_log "${log}" \
    'zentty-linux: sidebar-agent-status pane=pane-1 text="Codex · Running" attention=false' \
    "installed Codex state did not reach the sidebar" || fail "real Codex reducer state missing"
close_product

session_id="$(jq -er '
    .restoreDraftWindows[0].paneDrafts[0] as $draft |
    select(
        ($draft.toolName == "Codex") and
        ($draft.sessionID | test("^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$")) and
        ($draft.agentLaunchSnapshot.arguments == ["codex", "resume", $draft.sessionID])
    ) | $draft.sessionID
' "${state_directory}/restore-snapshot.json")" ||
    fail "real Codex session was not persisted as an exact pane-scoped resume draft"

start_product --state-directory "${state_directory}"
zentty_product_wait_for_log "${log}" \
    "zentty-linux: agent-resume-launch pane=pane-1 command=codex resume ${session_id}" \
    "relaunch did not route exact Codex resume" || fail "real Codex resume launch missing"
zentty_product_wait_for_log "${log}" 'zentty-linux: title=Ready | zentty' \
    "restored Codex TUI did not render its ready state" 400 || fail "real resumed TUI missing"
close_product

echo "Installed Codex integration passed: x11, version=${codex_version#codex-cli }, model-endpoint=controlled-loopback-no-response, wrapper=staged, pty=real, hook=real, ipc=real, relaunch=real-resume-tui, lifecycle=physical"
