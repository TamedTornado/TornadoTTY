#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
product="${ZENTTY_LINUX_BINARY:-${repo_root}/build/linux/bin/zentty-linux}"
endpoint_binary="${repo_root}/target/release-safe/controlled_openai_responses"
notify_observer="${repo_root}/linux/tests/fixtures/codex-notify-observer"
codex_binary="${ZENTTY_REAL_CODEX_BIN:-${repo_root}/linux/ci/node-tools/node_modules/.bin/codex}"
state_directory=""
codex_home_directory=""
log=""
product_pid=""
server_pid=""
endpoint=""
model_receipt=""
notify_receipt=""
login_shell_directory=""
session_working_directory=""
launch_working_directory="$(pwd -P)"

# shellcheck disable=SC1091
source "${repo_root}/linux/tests/lib/product-input"

fail() {
    [[ -z "${log}" || ! -f "${log}" ]] || cat "${log}" >&2
    if [[ -n "${codex_home_directory}" && -f "${codex_home_directory}/model.log" ]]; then
        echo "installed-codex-integration: controlled endpoint log:" >&2
        cat "${codex_home_directory}/model.log" >&2
    fi
    echo "installed-codex-integration: error: $*" >&2
    exit 1
}

cleanup() {
    if [[ "${product_pid}" =~ ^[1-9][0-9]*$ ]]; then
        kill -TERM "${product_pid}" 2>/dev/null || true
        wait "${product_pid}" 2>/dev/null || true
    fi
    if [[ "${server_pid}" =~ ^[1-9][0-9]*$ ]]; then
        kill -TERM "${server_pid}" 2>/dev/null || true
        wait "${server_pid}" 2>/dev/null || true
    fi
    [[ -z "${log}" ]] || rm -f -- "${log}"
    [[ -z "${state_directory}" ]] || rm -rf -- "${state_directory}"
    [[ -z "${codex_home_directory}" ]] || rm -rf -- "${codex_home_directory}"
    [[ -z "${login_shell_directory}" ]] || rm -rf -- "${login_shell_directory}"
    [[ -z "${session_working_directory}" ]] || rm -rf -- "${session_working_directory}"
}
trap cleanup EXIT

start_model_endpoint() {
    : >"${codex_home_directory}/model.log"
    "${endpoint_binary}" --receipt "${model_receipt}" >"${codex_home_directory}/model.log" 2>&1 &
    server_pid=$!
    for _ in {1..200}; do
        grep -q '^CONTROLLED_OPENAI_RESPONSES_READY=' "${codex_home_directory}/model.log" && break
        kill -0 "${server_pid}" 2>/dev/null || fail "controlled Responses endpoint exited before readiness"
        sleep 0.01
    done
    endpoint="$(sed -n 's/^CONTROLLED_OPENAI_RESPONSES_READY=//p' "${codex_home_directory}/model.log")"
    [[ "${endpoint}" =~ ^http://127\.0\.0\.1:[1-9][0-9]*$ ]] ||
        fail "controlled Responses endpoint did not publish a loopback address"
}

[[ "${GDK_BACKEND:-}" == x11 ]] || fail "GDK_BACKEND must be x11"
[[ "${ZENTTY_NESTED_X11_SESSION_ID:-}" =~ ^[0-9a-f]{64}$ ]] ||
    fail "installed Codex integration must run through linux/tests/nested-x11"
for dependency in grep jq mktemp node xclip; do
    command -v "${dependency}" >/dev/null || fail "${dependency} is required"
done
[[ -x "${codex_binary}" ]] || fail "reviewed repository Codex is not executable: ${codex_binary}"
[[ -x "${product}" ]] || fail "staged product is not built: ${product}"
[[ -x "${endpoint_binary}" ]] ||
    fail "controlled Responses endpoint is not built: ${endpoint_binary}"
[[ -x "${notify_observer}" ]] || fail "Codex notify observer is not executable"
zentty_product_disable_lifecycle_confirmations

codex_version="$("${codex_binary}" --version 2>/dev/null)"
[[ "${codex_version}" == "codex-cli 0.147.0" ]] ||
    fail "review the installed Codex contract before accepting version: ${codex_version}"

state_directory="$(mktemp -d)"
codex_home_directory="$(mktemp -d)"
log="$(mktemp)"
model_receipt="${codex_home_directory}/model-receipt.jsonl"
notify_receipt="${codex_home_directory}/notify-receipt.json"
login_shell_directory="$(mktemp -d)"
session_working_directory="$(mktemp -d)"
cat >"${login_shell_directory}/bash" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
export PATH="${ZENTTY_TEST_AGENT_PATH}:${PATH}"
exec /bin/bash "$@"
EOF
chmod 0700 "${login_shell_directory}/bash"
start_model_endpoint

cat >"${codex_home_directory}/config.toml" <<EOF
model_provider = "zentty-test"
model = "gpt-5.6-sol"
check_for_update_on_startup = false

[tui]
resume_cwd = "session"

[model_providers.zentty-test]
name = "Zentty Test"
base_url = "${endpoint}/v1"
env_key = "ZENTTY_TEST_MODEL_KEY"
wire_api = "responses"

[projects."${repo_root}"]
trust_level = "trusted"

[projects."${session_working_directory}"]
trust_level = "trusted"
EOF

start_product() {
    : >"${log}"
    env PATH="$(dirname "${codex_binary}"):${PATH}" \
        CODEX_HOME="${codex_home_directory}" ZENTTY_TEST_MODEL_KEY=not-a-real-key \
        ZENTTY_CODEX_NOTIFY_RECEIPT="${notify_receipt}" \
        "${product}" "$@" >"${log}" 2>&1 &
    product_pid=$!
}

start_product_from_desktop_path() {
    : >"${log}"
    env PATH=/usr/bin:/bin \
        SHELL="${login_shell_directory}/bash" \
        ZENTTY_TEST_AGENT_PATH="$(dirname "${codex_binary}"):$(dirname "$(command -v node)")" \
        CODEX_HOME="${codex_home_directory}" ZENTTY_TEST_MODEL_KEY=not-a-real-key \
        ZENTTY_CODEX_NOTIFY_RECEIPT="${notify_receipt}" \
        "${product}" "$@" >"${log}" 2>&1 &
    product_pid=$!
}

close_product() {
    zentty_product_prepare_input x11 "${log}" || fail "could not prepare real X11 input"
    zentty_product_close_window x11
    for _ in {1..240}; do
        kill -0 "${product_pid}" 2>/dev/null || break
        sleep 0.05
    done
    kill -0 "${product_pid}" 2>/dev/null && fail "product did not close through Ctrl+Q"
    set +e
    wait "${product_pid}"
    status=$?
    set -e
    product_pid=""
    ((status == 0)) || fail "staged product exited ${status}"
}

start_product \
    --state-directory "${state_directory}" \
    --command "codex --cd '${session_working_directory}' -c 'notify=[\"${notify_observer}\"]' 'Zentty installed Codex integration probe'" \
    --no-session-restore
zentty_product_wait_for_log "${log}" 'zentty-linux: agent-event pane=pane-1 worklane=worklane-1' \
    "installed Codex did not deliver authenticated SessionStart" || fail "real Codex event missing"
zentty_product_wait_for_log "${log}" \
    'kind=agent.running session=' \
    "installed Codex running hook did not reach the reducer" || fail "real Codex reducer state missing"
for _ in {1..200}; do
    [[ -s "${notify_receipt}" ]] && break
    sleep 0.01
done
notify_session="$(jq -er 'select(.type == "agent-turn-complete") | .["thread-id"] | select(test("^[0-9a-f-]{36}$"))' "${notify_receipt}")" ||
    fail "installed Codex did not invoke the configured notify observer"
zentty_product_wait_for_log "${log}" "kind=agent.idle session=${notify_session}" \
    "installed Codex did not invoke the notify callback after its completed turn" ||
    fail "real Codex completion callback missing"
grep -Fq '"path":"/v1/responses"' "${model_receipt}" ||
    fail "controlled endpoint did not retain a sanitized Responses receipt"
close_product
wait "${server_pid}" || fail "initial controlled Responses endpoint did not complete cleanly"
server_pid=""
initial_endpoint="${endpoint}"
start_model_endpoint
sed -i \
    "s|base_url = \"${initial_endpoint}/v1\"|base_url = \"${endpoint}/v1\"|" \
    "${codex_home_directory}/config.toml"

session_id="$(jq -er '
    .restoreDraftWindows[0].paneDrafts[0] as $draft |
    select(
        ($draft.toolName == "Codex") and
        ($draft.sessionID | test("^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$")) and
        ($draft.agentLaunchSnapshot.arguments == ["codex", "resume", $draft.sessionID])
    ) | $draft.sessionID
' "${state_directory}/restore-snapshot.json")" ||
    fail "real Codex session was not persisted as an exact pane-scoped resume draft"
[[ "${session_id}" == "${notify_session}" ]] ||
    fail "persisted Codex session differs from the observed notify thread"
jq -e \
    --arg agent_cwd "${session_working_directory}" \
    --arg shell_cwd "${launch_working_directory}" '
    .restoreDraftWindows[0].paneDrafts[0].workingDirectory == $agent_cwd and
    ([.workspace.windows[0].worklanes[].columns[].panes[] |
        select(.id == "pane-1") | .workingDirectory] == [$shell_cwd])
' "${state_directory}/restore-snapshot.json" >/dev/null ||
    fail "persisted restore conflated the Codex session directory with the parent shell directory"

start_product_from_desktop_path --state-directory "${state_directory}"
zentty_product_wait_for_log "${log}" \
    "zentty-linux: agent-resume-launch pane=pane-1 command=codex resume ${session_id}" \
    "relaunch did not route exact Codex resume" || fail "real Codex resume launch missing"
zentty_product_wait_for_log "${log}" \
    "zentty-linux: pane-context-owner pane=pane-1 owner=agent cwd=${session_working_directory} source=restore-draft" \
    "restore did not project the saved Codex session directory before authentication" ||
    fail "restored Codex draft context missing"
zentty_product_wait_for_log "${log}" \
    "zentty-linux: sidebar-working-directory pane=pane-1 cwd=${session_working_directory} visible=true" \
    "restored Codex session directory did not reach the actual GTK pane label" ||
    fail "restored Codex sidebar directory projection missing"
zentty_product_wait_for_log "${log}" 'zentty-linux: terminal-ready-pane=pane-1' \
    "restored Codex surface did not initialize" || fail "real resumed surface missing"
zentty_product_prepare_input x11 "${log}" || fail "could not focus the resumed Codex TUI"
zentty_product_wait_for_log "${log}" 'zentty-linux: title=Ready | tmp' \
    "restored Codex TUI did not render the selected session-directory title" 1200 ||
    fail "real resumed TUI session-directory title missing"
zentty_product_establish_palette_input x11 "${log}" ||
    fail "could not prove resumed Codex terminal input readiness"
zentty_product_prepare_input x11 "${log}" ||
    fail "could not restore embedded-terminal focus after the readiness probe"
resume_probe='Zentty restored Codex authentication probe'
printf '%s' "${resume_probe}" | xclip -selection clipboard -in
[[ "$(xclip -selection clipboard -out)" == "${resume_probe}" ]] ||
    fail "real X11 clipboard did not retain the resumed Codex probe"
zentty_product_ctrl_shift_key x11 v
zentty_product_key x11 Return
zentty_product_wait_for_log "${log}" \
    "zentty-linux: agent-event pane=pane-1 worklane=worklane-1 kind=session.start session=${session_id}" \
    "desktop PATH resume did not emit an authenticated session event after real TUI input" ||
    fail "real Codex desktop PATH authentication missing"
zentty_product_wait_for_log "${log}" \
    "zentty-linux: pane-context-owner pane=pane-1 owner=agent cwd=${session_working_directory}" \
    "authenticated Codex hook did not retain the selected session directory" ||
    fail "real Codex effective directory projection missing"
zentty_product_wait_for_log "${log}" \
    "zentty-linux: agent-event pane=pane-1 worklane=worklane-1 kind=agent.idle session=${session_id}" \
    "controlled resumed Codex turn did not complete" ||
    fail "real Codex resumed-turn completion missing"
zentty_product_type x11 /exit
zentty_product_key x11 Return
zentty_product_wait_for_log "${log}" \
    "zentty-linux: pane-context-owner pane=pane-1 owner=shell cwd=${launch_working_directory}" \
    "exiting resumed Codex did not restore shell context ownership" ||
    fail "real Codex shell-context return missing"
zentty_product_wait_for_log "${log}" \
    'zentty-linux: agent-restore-launch pane=pane-1 result=completed fallback=shell' \
    "completed resumed Codex did not create its replacement shell" ||
    fail "real Codex replacement shell missing"
zentty_product_wait_for_log "${log}" \
    'zentty-linux: shell-signal pane=pane-1 kind=pane-root-pid event=attach' \
    "replacement shell did not attach through the real PTY" ||
    fail "real Codex replacement shell PTY missing"
shell_cwd_receipt="${state_directory}/returned-shell-cwd"
zentty_product_type x11 "pwd > '${shell_cwd_receipt}'"
zentty_product_key x11 Return
for _ in {1..500}; do
    [[ -s "${shell_cwd_receipt}" ]] && break
    sleep 0.01
done
[[ "$(cat "${shell_cwd_receipt}" 2>/dev/null)" == "${launch_working_directory}" ]] ||
    fail "exiting real resumed Codex did not return the same pane to its parent shell directory"
zentty_product_wait_for_log "${log}" \
    "zentty-linux: project-context pane=pane-1 root=${launch_working_directory}" \
    "project context did not return to the parent shell directory" ||
    fail "parent shell project-context restoration missing"
if grep -Fq 'zentty-linux: restore-failure pane=pane-1 state=shown' "${log}"; then
    fail "a completed real Codex return incorrectly presented recovery controls"
fi
close_product

echo "Installed Codex integration passed: x11, version=${codex_version#codex-cli }, model-endpoint=controlled-loopback-completed-turn, wrapper=staged, pty=real, hook=real, notify=real, ipc=real, relaunch=real-resume-tui, resume-cwd=session, sidebar=actual-gtk-label, context-ownership=agent-to-shell, shell-cwd=physical-receipt, lifecycle=physical"
