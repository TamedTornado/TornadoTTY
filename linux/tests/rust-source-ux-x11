    (( $(grep -Fc 'zentty-linux: pane-keyboard-resize direction=' "${log}" || true) >= keyboard_resize_count + 4 &&
       $(grep -Fc 'zentty-linux: pane-height-layout column=column-worklane-1 ' "${log}" || true) > keyboard_height_layout_count )) && break
    sleep 0.05
done
keyboard_height_restored="$(grep -F 'zentty-linux: pane-height-layout column=column-worklane-1 ' "${log}" | tail -1 | sed -n 's/.*pane-1:\([0-9][0-9]*\).*/\1/p')"
(( keyboard_height_restored >= keyboard_height_before - 1 && keyboard_height_restored <= keyboard_height_before + 1 )) ||
    fail "Resize Pane Up did not reverse the rendered vertical cell step"

for direction in Right Left Down Up; do
    grep -Fq "zentty-linux: pane-keyboard-resize direction=${direction} pane=pane-3 cell=" "${log}" ||
        fail "real ${direction} keyboard resize did not consume Ghostty cell metrics"
done
sleep 0.2

# Until Linux ports Zentty's complete offscreen-pane management system, the
# pane-local primary command remains Split Right. Exercise it on pane-2, not on
# the currently focused pane-3, and prove the resulting visible pair belongs to
