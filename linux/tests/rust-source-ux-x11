    sleep 0.05
done
(( $(grep -Fxc 'zentty-linux: action=previous-pane worklane=worklane-1 pane=pane-1' "${log}" || true) > previous_count )) ||
    fail "horizontal wheel-left did not traverse to the previous pane"
xdotool type --window "${window_id}" --delay 10 'wheel-previous'
xdotool key --window "${window_id}" Return
for _ in $(seq 1 100); do
    grep -Fxq 'zentty-linux: title-pane=pane-1 value=focus:wheel-previous' "${log}" && break
    sleep 0.05
done
grep -Fxq 'zentty-linux: title-pane=pane-1 value=focus:wheel-previous' "${log}" ||
    fail "horizontal wheel traversal did not restore the original PTY"

next_count="$(grep -Fxc 'zentty-linux: action=next-pane worklane=worklane-1 pane=pane-2' "${log}" || true)"
xdotool mousemove --window "${window_id}" 500 350 click 7
for _ in $(seq 1 100); do
    (( $(grep -Fxc 'zentty-linux: action=next-pane worklane=worklane-1 pane=pane-2' "${log}" || true) > next_count )) && break
    sleep 0.05
done
(( $(grep -Fxc 'zentty-linux: action=next-pane worklane=worklane-1 pane=pane-2' "${log}" || true) > next_count )) ||
