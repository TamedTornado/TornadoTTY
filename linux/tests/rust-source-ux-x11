    sleep 0.05
done
grep -Fxq 'zentty-linux: terminal-ready-pane=pane-3' "${log}" ||
    fail "the pane-local below control did not create a third real terminal"
grep -Fxq 'zentty-linux: geometry=worklane-1:column-worklane-1[pane-1,pane-3],column-pane-2[pane-2]' "${log}" ||
    fail "New Pane Below did not split the pointer-focused pane's own column"

# Drag the source-equivalent pane dividers through the real X11 pointer. The
# horizontal handle overlays the right edge of the leading column; the vertical
# handle overlays the boundary between pane-1 and pane-3. Receipts come from
# the model mutation reached by GTK GestureDrag, not a direct test-only setter.
layout_line="$(grep -F 'zentty-linux: pane-layout ' "${log}" | tail -1)"
left_width="$(sed -n 's/.*column-worklane-1:\([0-9][0-9]*\).*/\1/p' <<<"${layout_line}")"
height_line="$(grep -F 'zentty-linux: pane-height-layout column=column-worklane-1 ' "${log}" | tail -1)"
top_height="$(sed -n 's/.*pane-1:\([0-9][0-9]*\).*/\1/p' <<<"${height_line}")"
pane_viewport_height="$(sed -n 's/.* viewport=\([0-9][0-9]*\) .*/\1/p' <<<"${height_line}")"
[[ "${left_width}" =~ ^[1-9][0-9]*$ ]] || fail "leading column width was not observable"
[[ "${top_height}" =~ ^[1-9][0-9]*$ ]] || fail "top pane height was not observable"
[[ "${pane_viewport_height}" =~ ^[1-9][0-9]*$ ]] || fail "pane viewport height was not observable"
divider_x="$((restored_sidebar_width + left_width - 3))"
column_resize_count="$(grep -Fc 'zentty-linux: pane-divider-resize axis=horizontal after=column-worklane-1 ' "${log}" || true)"
xdotool mousemove --window "${window_id}" "${divider_x}" 350 mousedown 1
xdotool mousemove --sync --window "${window_id}" "$((divider_x + 60))" 350 mouseup 1
for _ in $(seq 1 100); do
    (( $(grep -Fc 'zentty-linux: pane-divider-resize axis=horizontal after=column-worklane-1 ' "${log}" || true) > column_resize_count )) && break
    sleep 0.05
done
resized_left_width="$(grep -F 'zentty-linux: pane-divider-resize axis=horizontal after=column-worklane-1 ' "${log}" | tail -1 | sed -n 's/.*leading=\([0-9.]*\).*/\1/p')"
awk -v before="${left_width}" -v after="${resized_left_width}" 'BEGIN { exit !(after >= before + 50 && after <= before + 70) }' ||
    fail "real horizontal pane-divider drag did not follow the pointer"

divider_y="$((700 - pane_viewport_height + top_height - 3))"
pane_resize_count="$(grep -Fc 'zentty-linux: pane-divider-resize axis=vertical column=column-worklane-1 after=pane-1 ' "${log}" || true)"
xdotool mousemove --window "${window_id}" "$((restored_sidebar_width + left_width / 2))" "${divider_y}" mousedown 1
xdotool mousemove --sync --window "${window_id}" "$((restored_sidebar_width + left_width / 2))" "$((divider_y + 50))" mouseup 1
for _ in $(seq 1 100); do
    (( $(grep -Fc 'zentty-linux: pane-divider-resize axis=vertical column=column-worklane-1 after=pane-1 ' "${log}" || true) > pane_resize_count )) && break
    sleep 0.05
done
(( $(grep -Fc 'zentty-linux: pane-divider-resize axis=vertical column=column-worklane-1 after=pane-1 ' "${log}" || true) > pane_resize_count )) ||
    fail "real vertical pane-divider drag did not reach the workspace model"
# Return both dividers to their pre-test positions with the same real pointer
# path. Synthetic double-click delivery to overlapping GTK drag/click gestures
# is nondeterministic under parallel qualification, so equalization is kept at
# the deterministic model/gesture contract layer rather than weakening this
# real-system journey with a flaky timing dependency.
xdotool mousemove --window "${window_id}" "$((restored_sidebar_width + left_width / 2))" "$((divider_y + 50))" mousedown 1
xdotool mousemove --sync --window "${window_id}" "$((restored_sidebar_width + left_width / 2))" "${divider_y}" mouseup 1
xdotool mousemove --window "${window_id}" "$((divider_x + 60))" 350 mousedown 1
xdotool mousemove --sync --window "${window_id}" "${divider_x}" 350 mouseup 1
sleep 0.2

# Exercise all four source keyboard resize commands through the real GTK key
# path. Assert the rendered allocation after each command, not merely action
# dispatch, and use the paired reverse commands to restore established geometry.
keyboard_layout_line="$(grep -F 'zentty-linux: pane-layout ' "${log}" | tail -1)"
keyboard_width_before="$(sed -n 's/.*column-worklane-1:\([0-9][0-9]*\).*/\1/p' <<<"${keyboard_layout_line}")"
keyboard_resize_count="$(grep -Fc 'zentty-linux: pane-keyboard-resize direction=' "${log}" || true)"
keyboard_layout_count="$(grep -Fc 'zentty-linux: pane-layout ' "${log}" || true)"
xdotool key --window "${window_id}" ctrl+alt+shift+Right
for _ in $(seq 1 100); do
    (( $(grep -Fc 'zentty-linux: pane-keyboard-resize direction=' "${log}" || true) > keyboard_resize_count &&
       $(grep -Fc 'zentty-linux: pane-layout ' "${log}" || true) > keyboard_layout_count )) && break
    sleep 0.05
done
keyboard_width_right="$(grep -F 'zentty-linux: pane-layout ' "${log}" | tail -1 | sed -n 's/.*column-worklane-1:\([0-9][0-9]*\).*/\1/p')"
(( keyboard_width_right > keyboard_width_before )) ||
    fail "Resize Pane Right did not widen the rendered focused source column"

keyboard_layout_count="$(grep -Fc 'zentty-linux: pane-layout ' "${log}" || true)"
keyboard_height_layout_count="$(grep -Fc 'zentty-linux: pane-height-layout column=column-worklane-1 ' "${log}" || true)"
xdotool key --window "${window_id}" ctrl+alt+shift+Left
for _ in $(seq 1 100); do
    (( $(grep -Fc 'zentty-linux: pane-keyboard-resize direction=' "${log}" || true) >= keyboard_resize_count + 2 &&
       $(grep -Fc 'zentty-linux: pane-layout ' "${log}" || true) > keyboard_layout_count &&
       $(grep -Fc 'zentty-linux: pane-height-layout column=column-worklane-1 ' "${log}" || true) > keyboard_height_layout_count )) && break
    sleep 0.05
done
keyboard_width_restored="$(grep -F 'zentty-linux: pane-layout ' "${log}" | tail -1 | sed -n 's/.*column-worklane-1:\([0-9][0-9]*\).*/\1/p')"
(( keyboard_width_restored >= keyboard_width_before - 1 && keyboard_width_restored <= keyboard_width_before + 1 )) ||
    fail "Resize Pane Left did not reverse the rendered horizontal cell step"

keyboard_height_line="$(grep -F 'zentty-linux: pane-height-layout column=column-worklane-1 ' "${log}" | tail -1)"
keyboard_height_before="$(sed -n 's/.*pane-1:\([0-9][0-9]*\).*/\1/p' <<<"${keyboard_height_line}")"
keyboard_height_layout_count="$(grep -Fc 'zentty-linux: pane-height-layout column=column-worklane-1 ' "${log}" || true)"
xdotool key --window "${window_id}" ctrl+alt+shift+Down
for _ in $(seq 1 300); do
    (( $(grep -Fc 'zentty-linux: pane-keyboard-resize direction=' "${log}" || true) >= keyboard_resize_count + 3 &&
       $(grep -Fc 'zentty-linux: pane-height-layout column=column-worklane-1 ' "${log}" || true) > keyboard_height_layout_count )) && break
    sleep 0.05
done
keyboard_height_down="$(grep -F 'zentty-linux: pane-height-layout column=column-worklane-1 ' "${log}" | tail -1 | sed -n 's/.*pane-1:\([0-9][0-9]*\).*/\1/p')"
(( keyboard_height_down > keyboard_height_before )) ||
