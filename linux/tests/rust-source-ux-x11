xdotool mousemove --window "${window_id}" 1178 60 click 1
for _ in $(seq 1 100); do
    grep -Fxq 'zentty-linux: pane-control action=close-pane target=pane-4' "${log}" && break
    sleep 0.05
done
grep -Fxq 'zentty-linux: pane-control action=close-pane target=pane-4' "${log}" ||
