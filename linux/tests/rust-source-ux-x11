xdotool type --window "${window_id}" --delay 10 'arranged-pane'
xdotool key --window "${window_id}" Return
for _ in $(seq 1 100); do
    grep -Fxq 'zentty-linux: title-pane=pane-5 value=focus:arranged-pane' "${log}" && break
    sleep 0.05
done
grep -Fxq 'zentty-linux: title-pane=pane-5 value=focus:arranged-pane' "${log}" ||
    fail "keyboard input did not reach the arranged real Ghostty PTY"

# Close each exact pane through its own hover-revealed Close Pane control. This
# both exercises the new pane-local targeting contract and gives Ghostty the
# product-owned surface-disposal sequence instead of destroying the X drawable
# underneath its renderer.
# Remove pane-5 first so the remaining three-pane geometry returns to the
# already-qualified two-column layout and fixed controlled coordinates.
xdotool mousemove --window "${window_id}" 1000 350
xdotool mousemove --window "${window_id}" 1178 60 click 1
for _ in $(seq 1 100); do
    grep -Fxq 'zentty-linux: pane-control action=close-pane target=pane-5' "${log}" && break
    sleep 0.05
done
grep -Fxq 'zentty-linux: pane-control action=close-pane target=pane-5' "${log}" ||
    fail "the arranged pane's Close Pane control did not target pane-5"
xdotool mousemove --window "${window_id}" 500 200
xdotool mousemove --window "${window_id}" 718 60 click 1
for _ in $(seq 1 100); do
    grep -Fxq 'zentty-linux: pane-control action=close-pane target=pane-1' "${log}" && break
    sleep 0.05
done
grep -Fxq 'zentty-linux: pane-control action=close-pane target=pane-1' "${log}" ||
    fail "the original pane's hover Close Pane control did not target pane-1"
xdotool mousemove --window "${window_id}" 1000 350
xdotool mousemove --window "${window_id}" 1178 60 click 1
for _ in $(seq 1 100); do
    grep -Fxq 'zentty-linux: pane-control action=close-pane target=pane-2' "${log}" && break
    sleep 0.05
done
grep -Fxq 'zentty-linux: pane-control action=close-pane target=pane-2' "${log}" ||
    fail "the right pane's hover Close Pane control did not target pane-2"
xdotool mousemove --window "${window_id}" 700 350
xdotool mousemove --window "${window_id}" 1178 60 click 1
for _ in $(seq 1 100); do
    grep -Fxq 'zentty-linux: pane-control action=close-pane target=pane-3' "${log}" && break
    sleep 0.05
done
grep -Fxq 'zentty-linux: pane-control action=close-pane target=pane-3' "${log}" ||
    fail "the final pane's hover Close Pane control did not target pane-3"

set +e
timeout --foreground --kill-after=2s 7s tail --pid="${product_pid}" -f /dev/null
wait_status=$?
set -e
if (( wait_status != 0 )); then
    fail "product did not finish after the pointer-driven split"
fi
set +e
wait "${product_pid}"
product_status=$?
set -e
product_pid=""
(( product_status == 0 )) || fail "product exited ${product_status}"

grep -Fxq 'zentty-linux: action=split-pane-right pane=pane-2' "${log}" ||
    fail "the contextual Split Right item did not activate after Rename Pane"
grep -Fxq 'zentty-linux: action=split-pane-below pane=pane-3' "${log}" ||
    fail "the pane-local below control did not activate its product action"
grep -Fxq 'zentty-linux: action=split-pane-right pane=pane-4' "${log}" ||
    fail "the pane-local Split Right control did not activate its product action"
grep -Fxq 'zentty-linux: action=add-pane-right pane=pane-5' "${log}" ||
    fail "the Arrange popover did not activate its explicit Add Pane Right action"
grep -Fxq 'zentty-linux: pane-controls pane=pane-1 state=shown' "${log}" ||
    fail "hover did not disclose pane-1's local control cluster"
grep -Fxq 'zentty-linux: pane-controls pane=pane-1 state=hidden' "${log}" ||
    fail "leaving pane-1 did not dismiss its local control cluster"
[[ "$(grep -Fxc 'zentty-linux: terminal-ready' "${log}" || true)" -eq 5 ]] ||
    fail "the pointer-driven controls did not initialize five real Ghostty terminals"
[[ "$(grep -Fc 'info(io_exec): started subcommand' "${log}" || true)" -eq 5 ]] ||
    fail "the scenario did not retain exactly one child process per real pane"
if grep -Eq 'panicked at|thread caused non-unwinding panic|RefCell already borrowed|CRITICAL: Gtk|has a parent GtkBox' "${log}"; then
    fail "the contextual action reported a panic or GTK lifecycle critical"
fi

echo "Rust source UX passed: x11, focus=real-pty-and-model, pane-local-right-below-close=real-pointer, contextual-and-arrange-routes=real"
