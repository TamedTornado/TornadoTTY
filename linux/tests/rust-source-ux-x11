    sleep 0.05
done
grep -Fxq 'zentty-linux: pane-control action=split-right target=pane-2' "${log}" ||
    fail "the right pane's visible Split Right control did not target pane-2"
for _ in $(seq 1 100); do
    grep -Fxq 'zentty-linux: terminal-ready-pane=pane-4' "${log}" && break
    sleep 0.05
done
grep -Fxq 'zentty-linux: geometry=worklane-1:column-worklane-1[pane-1,pane-3],column-pane-2[pane-2],column-pane-4[pane-4]' "${log}" ||
    fail "pane-2's Split Right control did not create its adjacent column"
