    sleep 0.05
done
grep -Fxq 'zentty-linux: title-pane=pane-2 value=focus:wheel-next' "${log}" ||
    fail "horizontal wheel traversal did not restore the second PTY"

# Return focus to the original terminal with a real pointer click. GTK focus
# entering a Ghostty descendant must update the durable workspace selection;
# otherwise a subsequent layout action silently targets the stale right pane.
xdotool mousemove --window "${window_id}" 500 350 click 1
for _ in $(seq 1 100); do
    grep -Fxq 'zentty-linux: focus-pane pane=pane-1' "${log}" && break
    sleep 0.05
done
grep -Fxq 'zentty-linux: focus-pane pane=pane-1' "${log}" ||
