#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
product="${ZENTTY_LINUX_BINARY:-${repo_root}/build/linux/bin/zentty-linux}"
ghostty_root="${GHOSTTY_SOURCE_DIR:-${repo_root}/build/linux-deps/ghostty}"
log=""
product_pid=""

fail() {
    if [[ -n "${log}" && -f "${log}" ]]; then
        cat "${log}" >&2
    fi
    echo "rust-source-ux-x11: error: $*" >&2
    exit 1
}

cleanup() {
    if [[ "${product_pid}" =~ ^[1-9][0-9]*$ ]]; then
        kill -TERM "${product_pid}" 2>/dev/null || true
        wait "${product_pid}" 2>/dev/null || true
    fi
    [[ -z "${log}" ]] || rm -f -- "${log}"
}
trap cleanup EXIT

[[ "${GDK_BACKEND:-}" == x11 ]] || fail "GDK_BACKEND must be x11"
[[ "${ZENTTY_NESTED_X11_SESSION_ID:-}" =~ ^[0-9a-f]{64}$ ]] ||
    fail "the source UX scenario must run through linux/tests/nested-x11"
for dependency in cut grep head mktemp readelf sed seq sleep tail timeout xdotool; do
    command -v "${dependency}" >/dev/null || fail "${dependency} is required"
done
[[ -x "${product}" ]] || fail "delivered Rust product is not built: ${product}"

layer_runpath="$(
    readelf -d "${ghostty_root}/zig-out/lib/libghostty-gtk-embed.so" |
        sed -n 's/.*Library runpath: \[\([^]]*\)\].*/\1/p' |
        cut -d: -f1
)"
[[ "${layer_runpath}" == .zig-cache/* ]] ||
    fail "Ghostty library has no pinned relative layer-shell runpath"
layer_directory="${ghostty_root}/${layer_runpath}"

log="$(mktemp)"
state_directory="$(mktemp -d)"
trap 'rm -rf -- "${state_directory}"; cleanup' EXIT
# The single quotes intentionally defer PTY-child expansion.
# shellcheck disable=SC2016
GDK_SCALE=1 \
GDK_DPI_SCALE=1 \
LD_LIBRARY_PATH="${ghostty_root}/zig-out/lib:${layer_directory}${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}" \
    "${product}" \
    --command 'printf "\033]2;zentty-title-one\a"; sleep 0.2; printf "\033]2;zentty-title-two\a"; while IFS= read -r line; do printf "\033]2;focus:%s\a" "$line"; done' \
    --state-directory "${state_directory}" \
    --no-session-restore >"${log}" 2>&1 &
product_pid=$!

window_id=""
for _ in $(seq 1 200); do
    window_id="$(xdotool search --name '^Zentty$' 2>/dev/null | head -1 || true)"
    if [[ "${window_id}" =~ ^[1-9][0-9]*$ ]] &&
        grep -Fxq 'zentty-linux: terminal-ready' "${log}"; then
        break
    fi
    sleep 0.05
done
[[ "${window_id}" =~ ^[1-9][0-9]*$ ]] || fail "real Zentty X11 window did not appear"

for _ in $(seq 1 100); do
    if grep -Fxq 'zentty-linux: title-pane=pane-1 value=zentty-title-two' "${log}"; then
        break
    fi
    sleep 0.05
done
grep -Fxq 'zentty-linux: title-pane=pane-1 value=zentty-title-two' "${log}" ||
    fail "the real terminal did not deliver both title changes"

# The controlled Xvfb profile fixes scale and starts at 1000x700. Exercise the
# source width contract through real external resizes: default 280px, narrowed
# to one third of a 600px window, then restored to the preferred width when the
# window widens again.
xdotool windowsize --sync "${window_id}" 1200 700
sleep 0.2
latest_sidebar_width="$(grep -F 'zentty-linux: sidebar-width=' "${log}" | tail -1)"
[[ "${latest_sidebar_width}" == 'zentty-linux: sidebar-width=280' ]] ||
    fail "the sidebar did not use Zentty's preferred width in a wide window"
xdotool windowsize --sync "${window_id}" 600 700
sleep 0.2
latest_sidebar_width="$(grep -F 'zentty-linux: sidebar-width=' "${log}" | tail -1)"
[[ "${latest_sidebar_width}" == 'zentty-linux: sidebar-width=198' ]] ||
    fail "the sidebar did not clamp to one third of a narrow window"
xdotool windowsize --sync "${window_id}" 1200 700
sleep 0.2
latest_sidebar_width="$(grep -F 'zentty-linux: sidebar-width=' "${log}" | tail -1)"
[[ "${latest_sidebar_width}" == 'zentty-linux: sidebar-width=280' ]] ||
    fail "the preferred sidebar width was lost after temporary window clamping"

# Drag the real GTK divider rather than calling a model setter. The allocation
# must follow the pointer and the preferred width must survive returning the
# divider to its source default before the remaining coordinate-driven flow.
xdotool mousemove --window "${window_id}" 282 350 mousedown 1
xdotool mousemove --sync --window "${window_id}" 360 350 mouseup 1
sleep 0.2
dragged_sidebar_width="$(
    grep -F 'zentty-linux: sidebar-width=' "${log}" | tail -1 | cut -d= -f2
)"
[[ "${dragged_sidebar_width}" =~ ^[0-9]+$ ]] ||
    fail "the divider drag produced no sidebar allocation receipt"
(( dragged_sidebar_width >= 350 && dragged_sidebar_width <= 365 )) ||
    fail "the real divider drag did not resize the sidebar"
xdotool mousemove --window "${window_id}" "$((dragged_sidebar_width + 2))" 350 mousedown 1
xdotool mousemove --sync --window "${window_id}" 288 350 mouseup 1
sleep 0.2
restored_sidebar_width="$(
    grep -F 'zentty-linux: sidebar-width=' "${log}" | tail -1 | cut -d= -f2
)"
[[ "${restored_sidebar_width}" =~ ^[0-9]+$ ]] ||
    fail "the restored divider produced no sidebar allocation receipt"
(( restored_sidebar_width >= 278 && restored_sidebar_width <= 282 )) ||
    fail "the real divider did not return to Zentty's preferred width"
[[ "$(grep -Fc 'info(opengl): loaded OpenGL' "${log}" || true)" -eq 1 ]] ||
    fail "title/sidebar updates reattached the Ghostty widget and reloaded its GL presentation"
[[ "$(grep -Fc 'info(io_exec): started subcommand' "${log}" || true)" -eq 1 ]] ||
    fail "title/sidebar updates restarted the real terminal child"

# Exercise the source leading-chrome sidebar toggle with the real pointer. The
# sidebar must leave and return without moving chrome, reloading Ghostty's GL
# presentation, restarting the PTY, or retaining keyboard focus itself.
grep -Fxq 'zentty-linux: chrome-controls=toggle-sidebar,arrange-panes,back,forward,notifications' "${log}" ||
    fail "the source leading chrome control group was not presented"
xdotool mousemove --window "${window_id}" 16 18 click 1
for _ in $(seq 1 100); do
    grep -Fxq 'zentty-linux: sidebar-visibility=hidden' "${log}" && break
    sleep 0.05
done
grep -Fxq 'zentty-linux: sidebar-visibility=hidden' "${log}" ||
    fail "the real leading-chrome toggle did not hide the sidebar"
hover_count="$(grep -Fxc 'zentty-linux: sidebar-visibility=hover-peek' "${log}" || true)"
xdotool mousemove --window "${window_id}" 2 350
for _ in $(seq 1 100); do
    (( $(grep -Fxc 'zentty-linux: sidebar-visibility=hover-peek' "${log}" || true) > hover_count )) && break
    sleep 0.05
done
(( $(grep -Fxc 'zentty-linux: sidebar-visibility=hover-peek' "${log}" || true) > hover_count )) ||
    fail "the hidden sidebar rail did not open the source hover overlay"
hidden_count="$(grep -Fxc 'zentty-linux: sidebar-visibility=hidden' "${log}" || true)"
xdotool mousemove --window "${window_id}" 700 350
for _ in $(seq 1 100); do
    (( $(grep -Fxc 'zentty-linux: sidebar-visibility=hidden' "${log}" || true) > hidden_count )) && break
    sleep 0.05
done
(( $(grep -Fxc 'zentty-linux: sidebar-visibility=hidden' "${log}" || true) > hidden_count )) ||
    fail "leaving the floating sidebar did not dismiss it after the source delay"
xdotool mousemove --window "${window_id}" 16 18 click 1
for _ in $(seq 1 100); do
    grep -Fxq 'zentty-linux: sidebar-visibility=pinned-open' "${log}" && break
    sleep 0.05
done
grep -Fxq 'zentty-linux: sidebar-visibility=pinned-open' "${log}" ||
    fail "the leading chrome did not remain reachable while the sidebar was hidden"
xdotool type --window "${window_id}" --delay 10 'retained-focus'
xdotool key --window "${window_id}" Return
for _ in $(seq 1 100); do
    grep -Fxq 'zentty-linux: title-pane=pane-1 value=focus:retained-focus' "${log}" && break
    sleep 0.05
done
grep -Fxq 'zentty-linux: title-pane=pane-1 value=focus:retained-focus' "${log}" ||
    fail "keyboard input did not return to the real Ghostty PTY after toggling the sidebar"
[[ "$(grep -Fc 'info(opengl): loaded OpenGL' "${log}" || true)" -eq 1 ]] ||
    fail "sidebar visibility reattached the Ghostty widget"
[[ "$(grep -Fc 'zentty-linux: sidebar-card id=' "${log}" || true)" -eq 1 ]] ||
    fail "metadata-only title/focus changes destroyed and rebuilt the live sidebar row"

# Drive the source-first Rename Pane item through the real X11 pointer and
# modal editor. Then send another title through the real PTY: the durable name
# must remain the sidebar identity instead of being overwritten by OSC churn.
xdotool mousemove --window "${window_id}" 250 170 click 1
sleep 0.2
xdotool mousemove --window "${window_id}" 250 233 click 1
rename_window=""
for _ in $(seq 1 100); do
    rename_window="$(xdotool search --name '^Rename Pane$' 2>/dev/null | head -1 || true)"
    [[ "${rename_window}" =~ ^[1-9][0-9]*$ ]] && break
    sleep 0.05
done
[[ "${rename_window}" =~ ^[1-9][0-9]*$ ]] || fail "the pane menu did not open Rename Pane"
xdotool windowfocus "${rename_window}"
xdotool type --delay 10 'Pointer Named'
xdotool key Return
for _ in $(seq 1 100); do
    grep -Fxq 'zentty-linux: action=rename-pane id=pane-1 title="Pointer Named"' "${log}" && break
    sleep 0.05
done
grep -Fxq 'zentty-linux: action=rename-pane id=pane-1 title="Pointer Named"' "${log}" ||
    fail "the real rename editor did not set a durable pane title"
sleep 0.1
xdotool type --window "${window_id}" --delay 10 'renamed-focus'
xdotool key --window "${window_id}" Return
for _ in $(seq 1 100); do
    grep -Fxq 'zentty-linux: title-pane=pane-1 value=focus:renamed-focus' "${log}" && break
    sleep 0.05
done
grep -Fxq 'zentty-linux: pane-display id=pane-1 label-present=true custom=true' "${log}" ||
    fail "a later real PTY title overwrote the durable pane identity"

# Reopen the same real pane menu and activate Split Right, now correctly
# located after Rename Pane rather than assuming the old scaffolding order.
xdotool mousemove --window "${window_id}" 250 170 click 1
sleep 0.2
xdotool mousemove --window "${window_id}" 250 270 click 1

for _ in $(seq 1 100); do
    grep -Fxq 'zentty-linux: terminal-ready-pane=pane-2' "${log}" && break
    sleep 0.05
done
grep -Fxq 'zentty-linux: terminal-ready-pane=pane-2' "${log}" ||
    fail "the contextual split did not focus a second real terminal"
xdotool type --window "${window_id}" --delay 10 'second-pane'
xdotool key --window "${window_id}" Return
for _ in $(seq 1 100); do
    grep -Fxq 'zentty-linux: title-pane=pane-2 value=focus:second-pane' "${log}" && break
    sleep 0.05
done

# Open the source command palette through the Linux Ctrl+Shift+P mapping while
# pane 2 owns real Ghostty focus. Search the durable pane-1 title, traverse from
# the search field into results, and execute the exact hidden pane jump.
xdotool key --window "${window_id}" ctrl+shift+p
for _ in $(seq 1 100); do
    grep -Fxq 'zentty-linux: command-palette=shown' "${log}" && break
    sleep 0.05
done
grep -Fxq 'zentty-linux: command-palette=shown' "${log}" ||
    fail "Ctrl+Shift+P did not open the command palette above a focused Ghostty pane"
xdotool type --window "${window_id}" --delay 10 'Pointer Named'
for _ in $(seq 1 100); do
    grep -Fxq 'zentty-linux: command-palette=query value="Pointer Named" results=1' "${log}" && break
    sleep 0.05
done
grep -Fxq 'zentty-linux: command-palette=query value="Pointer Named" results=1' "${log}" ||
    fail "command palette search did not resolve the exact durable pane identity"
xdotool key --window "${window_id}" Down Return
for _ in $(seq 1 100); do
    grep -Fq 'zentty-linux: command-palette=execute target=Pane(PaneReference { worklane_id: "worklane-1", pane_id: "pane-1" })' "${log}" && break
    sleep 0.05
done
grep -Fq 'zentty-linux: command-palette=execute target=Pane(PaneReference { worklane_id: "worklane-1", pane_id: "pane-1" })' "${log}" ||
    fail "keyboard palette execution did not choose the exact pane"
xdotool type --window "${window_id}" --delay 10 'palette-focus'
xdotool key --window "${window_id}" Return
for _ in $(seq 1 100); do
    grep -Fxq 'zentty-linux: title-pane=pane-1 value=focus:palette-focus' "${log}" && break
    sleep 0.05
done
grep -Fxq 'zentty-linux: title-pane=pane-1 value=focus:palette-focus' "${log}" ||
    fail "palette dismissal did not restore real PTY input to the selected pane"

# Reopen the real overlay and prove that text typed while it owns focus cannot
# leak into the PTY. Escape must dismiss it and restore focus to pane 1.
shown_before="$(grep -Fc 'zentty-linux: command-palette=shown' "${log}" || true)"
hidden_before="$(grep -Fc 'zentty-linux: command-palette=hidden' "${log}" || true)"
xdotool key --window "${window_id}" ctrl+shift+p
for _ in $(seq 1 100); do
    [[ "$(grep -Fc 'zentty-linux: command-palette=shown' "${log}" || true)" -gt "${shown_before}" ]] && break
    sleep 0.05
done
xdotool type --window "${window_id}" --delay 10 'shielded-query'
xdotool key --window "${window_id}" Escape
for _ in $(seq 1 100); do
    [[ "$(grep -Fc 'zentty-linux: command-palette=hidden' "${log}" || true)" -gt "${hidden_before}" ]] && break
    sleep 0.05
done
[[ "$(grep -Fc 'zentty-linux: command-palette=hidden' "${log}" || true)" -gt "${hidden_before}" ]] ||
    fail "Escape did not dismiss the command palette"
xdotool type --window "${window_id}" --delay 10 'palette-escape'
xdotool key --window "${window_id}" Return
for _ in $(seq 1 100); do
    grep -Fxq 'zentty-linux: title-pane=pane-1 value=focus:palette-escape' "${log}" && break
    sleep 0.05
done
grep -Fxq 'zentty-linux: title-pane=pane-1 value=focus:palette-escape' "${log}" ||
    fail "Escape dismissal did not restore real PTY focus"
grep -Fq 'focus:shielded-query' "${log}" &&
    fail "command-palette search input leaked into the real PTY"

# The full-window scrim is functional rather than decorative: a click outside
# the centered palette dismisses it without clicking through into Ghostty.
shown_before="$(grep -Fc 'zentty-linux: command-palette=shown' "${log}" || true)"
hidden_before="$(grep -Fc 'zentty-linux: command-palette=hidden' "${log}" || true)"
xdotool key --window "${window_id}" ctrl+shift+p
for _ in $(seq 1 100); do
    [[ "$(grep -Fc 'zentty-linux: command-palette=shown' "${log}" || true)" -gt "${shown_before}" ]] && break
    sleep 0.05
done
xdotool mousemove --window "${window_id}" 900 650 click 1
for _ in $(seq 1 100); do
    [[ "$(grep -Fc 'zentty-linux: command-palette=hidden' "${log}" || true)" -gt "${hidden_before}" ]] && break
    sleep 0.05
done
[[ "$(grep -Fc 'zentty-linux: command-palette=hidden' "${log}" || true)" -gt "${hidden_before}" ]] ||
    fail "outside click did not dismiss the command-palette scrim"
xdotool type --window "${window_id}" --delay 10 'palette-outside'
xdotool key --window "${window_id}" Return
for _ in $(seq 1 100); do
    grep -Fxq 'zentty-linux: title-pane=pane-1 value=focus:palette-outside' "${log}" && break
    sleep 0.05
done
grep -Fxq 'zentty-linux: title-pane=pane-1 value=focus:palette-outside' "${log}" ||
    fail "outside-click dismissal did not restore real PTY focus"
# Return to pane 2 through the real traversal route so the existing Back/Forward
# scenario retains its original pane-2 -> pane-1 -> pane-2 contract.
xdotool key --window "${window_id}" ctrl+Tab
for _ in $(seq 1 100); do
    grep -Fxq 'zentty-linux: action=next-pane worklane=worklane-1 pane=pane-2' "${log}" && break
    sleep 0.05
done
grep -Fxq 'zentty-linux: action=next-pane worklane=worklane-1 pane=pane-2' "${log}" ||
    fail "palette exact-pane jump did not remain interoperable with pane traversal"
grep -Fxq 'zentty-linux: title-pane=pane-2 value=focus:second-pane' "${log}" ||
    fail "the contextual split did not leave input focused in its new real PTY"

# Drive the actual leading-chrome navigation buttons. Back must select the
# original real Ghostty pane and restore PTY input; Forward must return to the
# second pane. This rejects an always-enabled decoration or an action that only
# updates model state without transferring terminal focus.
xdotool mousemove --window "${window_id}" 106 18 click 1
for _ in $(seq 1 100); do
    grep -Fxq 'zentty-linux: action=navigate-back worklane=worklane-1 pane=pane-1' "${log}" && break
    sleep 0.05
done
grep -Fxq 'zentty-linux: action=navigate-back worklane=worklane-1 pane=pane-1' "${log}" ||
    fail "the real Back button did not select the preceding pane"
xdotool type --window "${window_id}" --delay 10 'history-back'
xdotool key --window "${window_id}" Return
for _ in $(seq 1 100); do
    grep -Fxq 'zentty-linux: title-pane=pane-1 value=focus:history-back' "${log}" && break
    sleep 0.05
done
grep -Fxq 'zentty-linux: title-pane=pane-1 value=focus:history-back' "${log}" ||
    fail "Back did not restore keyboard input to the original real PTY"

xdotool mousemove --window "${window_id}" 140 18 click 1
for _ in $(seq 1 100); do
    grep -Fxq 'zentty-linux: action=navigate-forward worklane=worklane-1 pane=pane-2' "${log}" && break
    sleep 0.05
done
grep -Fxq 'zentty-linux: action=navigate-forward worklane=worklane-1 pane=pane-2' "${log}" ||
    fail "the real Forward button did not restore the newer pane"
xdotool type --window "${window_id}" --delay 10 'history-forward'
xdotool key --window "${window_id}" Return
for _ in $(seq 1 100); do
    grep -Fxq 'zentty-linux: title-pane=pane-2 value=focus:history-forward' "${log}" && break
    sleep 0.05
done
grep -Fxq 'zentty-linux: title-pane=pane-2 value=focus:history-forward' "${log}" ||
    fail "Forward did not restore keyboard input to the second real PTY"

# Linux-native Alt+Left/Alt+Right routes use the same source browser-history
# stacks as the chrome buttons. Drive both while the real Ghostty surface owns
# focus and require exact model receipts rather than allowing escape sequences
# to leak into the PTY.
back_count="$(grep -Fxc 'zentty-linux: action=navigate-back worklane=worklane-1 pane=pane-1' "${log}" || true)"
xdotool key --window "${window_id}" alt+Left
for _ in $(seq 1 100); do
    (( $(grep -Fxc 'zentty-linux: action=navigate-back worklane=worklane-1 pane=pane-1' "${log}" || true) > back_count )) && break
    sleep 0.05
done
(( $(grep -Fxc 'zentty-linux: action=navigate-back worklane=worklane-1 pane=pane-1' "${log}" || true) > back_count )) ||
    fail "Alt+Left did not activate pane history Back"
forward_count="$(grep -Fxc 'zentty-linux: action=navigate-forward worklane=worklane-1 pane=pane-2' "${log}" || true)"
xdotool key --window "${window_id}" alt+Right
for _ in $(seq 1 100); do
    (( $(grep -Fxc 'zentty-linux: action=navigate-forward worklane=worklane-1 pane=pane-2' "${log}" || true) > forward_count )) && break
    sleep 0.05
done
(( $(grep -Fxc 'zentty-linux: action=navigate-forward worklane=worklane-1 pane=pane-2' "${log}" || true) > forward_count )) ||
    fail "Alt+Right did not activate pane history Forward"

# Exercise the source quick-tap traversal chord at GTK capture phase while the
# embedded Ghostty widget owns keyboard focus. Shift+Ctrl+Tab moves backward;
# Ctrl+Tab moves forward. Distinct PTY title receipts reject a shortcut that
# only changes model selection or leaks Tab into the terminal.
xdotool key --window "${window_id}" ctrl+shift+Tab
for _ in $(seq 1 100); do
    grep -Fxq 'zentty-linux: action=previous-pane worklane=worklane-1 pane=pane-1' "${log}" && break
    sleep 0.05
done
grep -Fxq 'zentty-linux: action=previous-pane worklane=worklane-1 pane=pane-1' "${log}" ||
    fail "Ctrl+Shift+Tab did not traverse to the previous pane"
xdotool type --window "${window_id}" --delay 10 'shortcut-previous'
xdotool key --window "${window_id}" Return
for _ in $(seq 1 100); do
    grep -Fxq 'zentty-linux: title-pane=pane-1 value=focus:shortcut-previous' "${log}" && break
    sleep 0.05
done
grep -Fxq 'zentty-linux: title-pane=pane-1 value=focus:shortcut-previous' "${log}" ||
    fail "previous-pane traversal did not restore the original real PTY"

xdotool key --window "${window_id}" ctrl+Tab
for _ in $(seq 1 100); do
    grep -Fxq 'zentty-linux: action=next-pane worklane=worklane-1 pane=pane-2' "${log}" && break
    sleep 0.05
done
grep -Fxq 'zentty-linux: action=next-pane worklane=worklane-1 pane=pane-2' "${log}" ||
    fail "Ctrl+Tab did not traverse to the next pane"
xdotool type --window "${window_id}" --delay 10 'shortcut-next'
xdotool key --window "${window_id}" Return
for _ in $(seq 1 100); do
    grep -Fxq 'zentty-linux: title-pane=pane-2 value=focus:shortcut-next' "${log}" && break
    sleep 0.05
done
grep -Fxq 'zentty-linux: title-pane=pane-2 value=focus:shortcut-next' "${log}" ||
    fail "next-pane traversal did not restore the second real PTY"

# Keep Control held after a physical Tab tap. Traversal must happen on the Tab
# press and retaining Control must never reinterpret it as Worklane Peek.
peek_open_count="$(grep -Fc 'zentty-linux: worklane-peek=open' "${log}" || true)"
previous_count="$(grep -Fxc 'zentty-linux: action=previous-pane worklane=worklane-1 pane=pane-1' "${log}" || true)"
xdotool keydown --window "${window_id}" ctrl
xdotool key --window "${window_id}" shift+Tab
for _ in $(seq 1 100); do
    (( $(grep -Fxc 'zentty-linux: action=previous-pane worklane=worklane-1 pane=pane-1' "${log}" || true) > previous_count )) && break
    sleep 0.05
done
(( $(grep -Fxc 'zentty-linux: action=previous-pane worklane=worklane-1 pane=pane-1' "${log}" || true) > previous_count )) ||
    fail "Ctrl+Shift+Tab did not traverse immediately while Control remained held"
sleep 0.65
xdotool keyup --window "${window_id}" ctrl
[[ "$(grep -Fc 'zentty-linux: worklane-peek=open' "${log}" || true)" == "${peek_open_count}" ]] ||
    fail "holding Control after Ctrl-Tab incorrectly opened Worklane Peek"
xdotool key --window "${window_id}" ctrl+Tab
sleep 0.1

# This time keep physical Tab down beyond the source 200ms threshold. Peek must
# open only because Tab remains down, not merely because Control remains down.
xdotool keydown --window "${window_id}" ctrl
xdotool keydown --window "${window_id}" Tab
sleep 0.3
grep -Fxq 'zentty-linux: worklane-peek=open trigger=tab-hold' "${log}" ||
    fail "holding physical Tab did not open Worklane Peek"
grep -Fq 'zentty-linux: worklane-peek-hud value="focus:shortcut-next  •  Worklane 1"' "${log}" ||
    fail "Worklane Peek did not render its selected-pane HUD context"
xdotool keyup --window "${window_id}" Tab
peek_left_count="$(grep -Fxc 'zentty-linux: worklane-peek=spatial worklane=worklane-1 pane=pane-1' "${log}" || true)"
xdotool mousemove --window "${window_id}" 600 350 click 6
for _ in $(seq 1 100); do
    (( $(grep -Fxc 'zentty-linux: worklane-peek=spatial worklane=worklane-1 pane=pane-1' "${log}" || true) > peek_left_count )) && break
    sleep 0.05
done
(( $(grep -Fxc 'zentty-linux: worklane-peek=spatial worklane=worklane-1 pane=pane-1' "${log}" || true) > peek_left_count )) ||
    fail "horizontal wheel-left did not spatially navigate the open Peek"
xdotool key --window "${window_id}" Right
xdotool key --window "${window_id}" Left
grep -Fxq 'zentty-linux: worklane-peek=spatial worklane=worklane-1 pane=pane-1' "${log}" ||
    fail "Worklane Peek did not spatially preview the left pane"
xdotool keyup --window "${window_id}" ctrl
for _ in $(seq 1 100); do
    grep -Fxq 'zentty-linux: worklane-peek=commit worklane=worklane-1 pane=pane-1' "${log}" && break
    sleep 0.05
done
grep -Fxq 'zentty-linux: worklane-peek=commit worklane=worklane-1 pane=pane-1' "${log}" ||
    fail "releasing Control did not commit the Worklane Peek preview"
xdotool type --window "${window_id}" --delay 10 'peek-spatial-commit'
xdotool key --window "${window_id}" Return
for _ in $(seq 1 100); do
    grep -Fxq 'zentty-linux: title-pane=pane-1 value=focus:peek-spatial-commit' "${log}" && break
    sleep 0.05
done
grep -Fxq 'zentty-linux: title-pane=pane-1 value=focus:peek-spatial-commit' "${log}" ||
    fail "Worklane Peek commit did not restore the selected real PTY"

# Hold Tab to open again, release Tab while keeping Control down, advance with
# a fresh Ctrl+Tab tap, then cancel with Escape and restore the origin.
xdotool keydown --window "${window_id}" ctrl
xdotool keydown --window "${window_id}" Tab
sleep 0.3
xdotool keyup --window "${window_id}" Tab
xdotool key --window "${window_id}" Tab
grep -Fxq 'zentty-linux: worklane-peek=preview worklane=worklane-1 pane=pane-2' "${log}" ||
    fail "a repeated Tab did not advance the open Worklane Peek"
xdotool key --window "${window_id}" Escape
xdotool keyup --window "${window_id}" ctrl
grep -Fxq 'zentty-linux: worklane-peek=cancel' "${log}" ||
    fail "Escape did not cancel Worklane Peek"
xdotool type --window "${window_id}" --delay 10 'peek-cancel-origin'
xdotool key --window "${window_id}" Return
for _ in $(seq 1 100); do
    grep -Fxq 'zentty-linux: title-pane=pane-1 value=focus:peek-cancel-origin' "${log}" && break
    sleep 0.05
done
grep -Fxq 'zentty-linux: title-pane=pane-1 value=focus:peek-cancel-origin' "${log}" ||
    fail "Escape did not restore Worklane Peek's original real PTY"

# Return to pane 2, reopen Peek, and select the first visible card with the
# real pointer. The click only previews; Control release owns the exact commit.
xdotool key --window "${window_id}" ctrl+Tab
for _ in $(seq 1 100); do
    grep -Fxq 'zentty-linux: action=next-pane worklane=worklane-1 pane=pane-2' "${log}" && break
    sleep 0.05
done
xdotool keydown --window "${window_id}" ctrl
xdotool keydown --window "${window_id}" Tab
sleep 0.3
xdotool keyup --window "${window_id}" Tab
xdotool mousemove --window "${window_id}" 600 270 click 1
for _ in $(seq 1 100); do
    grep -Fxq 'zentty-linux: worklane-peek=click worklane=worklane-1 pane=pane-1' "${log}" && break
    sleep 0.05
done
grep -Fxq 'zentty-linux: worklane-peek=click worklane=worklane-1 pane=pane-1' "${log}" ||
