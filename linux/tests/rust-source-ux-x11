#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
product="${ZENTTY_LINUX_BINARY:-${repo_root}/build/linux/bin/zentty-linux}"
log=""
product_pid=""

# shellcheck source=linux/tests/lib/product-bundle
# shellcheck disable=SC1091
source "${repo_root}/linux/tests/lib/product-bundle"
# shellcheck source=linux/tests/lib/product-input
# shellcheck disable=SC1091
source "${repo_root}/linux/tests/lib/product-input"
# shellcheck source=linux/tests/lib/visual-evidence
# shellcheck disable=SC1091
source "${repo_root}/linux/tests/lib/visual-evidence"

fail() {
    if [[ -n "${log}" && -f "${log}" ]]; then
        cat "${log}" >&2
    fi
    echo "rust-source-ux-x11: error: $*" >&2
    exit 1
}

cleanup() {
    if [[ "${product_pid}" =~ ^[1-9][0-9]*$ ]]; then
        kill -TERM "${product_pid}" 2>/dev/null || true
        wait "${product_pid}" 2>/dev/null || true
    fi
    [[ -z "${log}" ]] || rm -f -- "${log}"
}
trap cleanup EXIT

[[ "${GDK_BACKEND:-}" == x11 ]] || fail "GDK_BACKEND must be x11"
[[ "${ZENTTY_NESTED_X11_SESSION_ID:-}" =~ ^[0-9a-f]{64}$ ]] ||
    fail "the source UX scenario must run through linux/tests/nested-x11"
for dependency in compare convert cut grep head identify import mktemp readelf readlink sed seq sleep tail timeout xdotool; do
    command -v "${dependency}" >/dev/null || fail "${dependency} is required"
done
[[ -x "${product}" ]] || fail "delivered Rust product is not built: ${product}"
zentty_product_bundle_resolve "${product}" || fail "staged product bundle is invalid"
product="${ZENTTY_PRODUCT_BINARY}"
bundle_lib="${ZENTTY_PRODUCT_BUNDLE_LIB}"
screenshot_dir="${repo_root}/build/linux-test-receipts/worklane-peek"
rm -rf -- "${screenshot_dir}"
mkdir -p -- "${screenshot_dir}"

log="$(mktemp)"
state_directory="$(mktemp -d)"
visual_cwd="/tmp/zentty-source-ux-cwd"
mkdir -p -- "${visual_cwd}"
trap 'rm -rf -- "${state_directory}"; cleanup' EXIT
# This journey exercises the explicit Split Right control later. Pin that
# product policy instead of depending on the adaptive default, whose narrow
# viewport intentionally exposes Add Pane Right. The adaptive branch is owned
# by rust-workspace-pane-settings.
mkdir -p -- "${XDG_CONFIG_HOME}/zentty"
cat >"${XDG_CONFIG_HOME}/zentty/config.toml" <<'TOML'
[pane_layout]
right_split_behavior = "alwaysSplit"
TOML
# Screenshot evidence must describe a settled state, not an arbitrary frame of
# a transition. Motion behavior has its own real-product coverage in
# rust-project-icons; this actor disables GTK animations for deterministic
# geometry-to-pixel correspondence.
mkdir -p -- "${XDG_CONFIG_HOME}/gtk-4.0"
cat >"${XDG_CONFIG_HOME}/gtk-4.0/settings.ini" <<'INI'
[Settings]
gtk-enable-animations=false
INI
mkdir -p -- "${XDG_CONFIG_HOME}/ghostty"
cat >"${XDG_CONFIG_HOME}/ghostty/config" <<'CONFIG'
resize-overlay = never
cursor-opacity = 0
CONFIG
# The single quotes intentionally defer PTY-child expansion.
# shellcheck disable=SC2016
(
    # This source-UX journey is not a development-server scenario. Give its
    # real PTY a private CWD so ambient listeners from the repository cannot
    # legitimately trigger a server-card rebuild during the metadata identity
    # assertion below.
    cd "${visual_cwd}"
    exec env \
        GDK_SCALE=1 \
        GDK_DPI_SCALE=1 \
        ZENTTY_VISUAL_STATE_DIR="${state_directory}" \
        LD_LIBRARY_PATH="${bundle_lib}${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}" \
        "${product}" \
        --command 'printf "\033]2;zentty-title-one\a"; sleep 0.2; printf "\033]2;zentty-title-two\a\033[2J\033[H\033[?25l"; while IFS= read -r line; do if [ "$line" = peek-live-start ]; then printf "\033[2J\033[H\033[?25l"; (sleep 1.5; printf "%s" "{\"version\":1,\"event\":\"session.start\",\"agent\":{\"name\":\"Codex\"},\"session\":{\"id\":\"peek-live-agent\"}}" | "$ZENTTY_CLI_BIN" ipc agent-event; printf "%s" "{\"version\":1,\"event\":\"agent.running\",\"agent\":{\"name\":\"Codex\"},\"session\":{\"id\":\"peek-live-agent\"}}" | "$ZENTTY_CLI_BIN" ipc agent-event; printf "%s" "{\"version\":1,\"event\":\"task.progress\",\"session\":{\"id\":\"peek-live-agent\"},\"progress\":{\"done\":2,\"total\":5}}" | "$ZENTTY_CLI_BIN" ipc agent-event; while [ ! -f "$ZENTTY_VISUAL_STATE_DIR/progress-captured" ]; do sleep 0.05; done; i=0; while [ "$i" -lt 10 ]; do i=$((i + 1)); printf "\033]2;peek-live:%s\a" "$i"; sleep 0.05; done; printf "%s" "{\"version\":1,\"event\":\"agent.needs-input\",\"agent\":{\"name\":\"Codex\"},\"session\":{\"id\":\"peek-live-agent\"},\"state\":{\"text\":\"Approve deployment to the production environment for the frontend worklane?\",\"interaction\":{\"kind\":\"approval\",\"text\":\"Approve deployment to the production environment for the frontend worklane?\"}}}" | "$ZENTTY_CLI_BIN" ipc agent-event; printf "\033]2;peek-live-final\a") & else printf "\033]2;focus:%s\a\033[2J\033[H\033[?25l" "$line"; fi; done' \
        --state-directory "${state_directory}" \
        --no-session-restore
) >"${log}" 2>&1 &
product_pid=$!

zentty_product_wait_for_log "${log}" 'zentty-linux: terminal-ready' \
    "initial real terminal did not become ready" || fail "initial terminal missing"
zentty_product_prepare_input x11 "${log}" || fail "could not prepare real X11 input"
window_id="${ZENTTY_PRODUCT_WINDOW_ID}"

hover_pane_controls() {
    local pane_id="$1"
    local x="$2"
    local y="$3"
    local latest=""
    xdotool mousemove --sync --window "${window_id}" "${x}" "${y}"
    for _ in $(seq 1 100); do
        latest="$(grep -F "zentty-linux: pane-controls pane=${pane_id} state=" "${log}" | tail -1 || true)"
        [[ "${latest}" == "zentty-linux: pane-controls pane=${pane_id} state=shown" ]] && return 0
        sleep 0.05
    done
    fail "pane controls did not become visible for ${pane_id}"
}

find_pane_drag_zone() {
    local pane_id="$1"
    local x_start="$2"
    local x_end="$3"
    local y_start="$4"
    local y_end="$5"
    local before x y
    before="$(grep -Fc "zentty-linux: pane-drag-zone pane=${pane_id} pointer=entered" "${log}" || true)"
    for y in $(seq "${y_start}" 8 "${y_end}"); do
        for x in $(seq "${x_start}" 20 "${x_end}"); do
            xdotool mousemove --sync --window "${window_id}" "${x}" "${y}"
            sleep 0.02
            if (( $(grep -Fc "zentty-linux: pane-drag-zone pane=${pane_id} pointer=entered" "${log}" || true) > before )); then
                return 0
            fi
        done
    done
    return 1
}

find_sidebar_pane_drag_source() {
    local pane_id="$1"
    local before x y
    before="$(grep -Fc "zentty-linux: pane-drag-zone pane=${pane_id} source=sidebar pointer=entered" "${log}" || true)"
    for y in $(seq 40 8 420); do
        for x in 30 60 120 180 220; do
            xdotool mousemove --sync --window "${window_id}" "${x}" "${y}"
            sleep 0.02
            if (( $(grep -Fc "zentty-linux: pane-drag-zone pane=${pane_id} source=sidebar pointer=entered" "${log}" || true) > before )); then
                return 0
            fi
        done
    done
    return 1
}

capture_peek_screenshot() {
    local name="$1"
    local image="${screenshot_dir}/${name}.png"
    local pane card x y width
    # Geometry is emitted from GTK's frame tick before Xvfb necessarily
    # presents those pixels. Let the private software renderer settle one
    # bounded frame interval before reading the drawable.
    sleep 0.3
    import -silent -window "${window_id}" "${image}"
    [[ "$(identify -format '%wx%h' "${image}")" == 1200x700 ]] ||
        fail "${name} Peek screenshot did not preserve controlled 1200x700 geometry"
    # Mask only each card's live terminal picture. Borders, headings,
    # selection, context, attention, and labels remain real pixels.
    for pane in pane-1 pane-3 pane-2 pane-5 pane-6; do
        card="$(grep -F 'zentty-linux: worklane-peek-card ' "${log}" |
            grep -F " pane=${pane} " | grep -E ' x=[0-9]+ ' | tail -1 || true)"
        [[ -n "${card}" ]] || continue
        printf '%s\n' "${card}" >>"${screenshot_dir}/${name}.geometry"
        x="$(sed -n 's/.* x=\([0-9][0-9]*\) .*/\1/p' <<<"${card}")"
        y="$(sed -n 's/.* y=\([0-9][0-9]*\) .*/\1/p' <<<"${card}")"
        width="$(sed -n 's/.* width=\([0-9][0-9]*\) .*/\1/p' <<<"${card}")"
        [[ "${x}${y}${width}" =~ ^[0-9]+$ ]] ||
            fail "${name} Peek screenshot card geometry malformed"
        convert "${image}" -fill '#080b10' \
            -draw "rectangle $((x + 8)),$((y + 8)),$((x + width - 8)),$((y + 150))" \
            "${image}"
    done
}

capture_unmasked_visual_scenario() {
    local scenario_id="$1"
    local capture_scope="${2:-window}"
    local image="${screenshot_dir}/${scenario_id}.png"
    local window_geometry x y width height
    # The PTY command below clears its deterministic terminal after every
    # synthetic interaction and hides the cursor. Preserve the real Ghostty
    # pixels rather than covering them with a mask.
    sleep 0.15
    if [[ "${capture_scope}" == root-crop ]]; then
        window_geometry="$(xdotool getwindowgeometry --shell "${window_id}")"
        x="$(sed -n 's/^X=//p' <<<"${window_geometry}")"
        y="$(sed -n 's/^Y=//p' <<<"${window_geometry}")"
        width="$(sed -n 's/^WIDTH=//p' <<<"${window_geometry}")"
        height="$(sed -n 's/^HEIGHT=//p' <<<"${window_geometry}")"
        [[ "${x}" =~ ^-?[0-9]+$ && "${y}" =~ ^-?[0-9]+$ &&
            "${width}" =~ ^[1-9][0-9]*$ && "${height}" =~ ^[1-9][0-9]*$ ]] ||
            fail "${scenario_id} window geometry was malformed"
        import -silent -window root -crop "${width}x${height}+${x}+${y}" "${image}"
    else
        import -silent -window "${window_id}" "${image}"
    fi
    zentty_visual_publish "${scenario_id}" linux/tests/rust-source-ux-x11 "${image}" -
}

apply_theme_mode_from_palette() {
    local title="$1"
    local mode="$2"
    local persisted_before
    persisted_before="$(grep -Fxc "zentty-linux: action=theme-mode result=persisted mode=${mode}" "${log}" || true)"
    xdotool key --window "${window_id}" ctrl+shift+p
    xdotool type --window "${window_id}" --delay 10 "${title}"
    for _ in $(seq 1 100); do
        grep -Fxq "zentty-linux: command-palette=query value=\"${title}\" results=1" "${log}" && break
        sleep 0.05
    done
    grep -Fxq "zentty-linux: command-palette=query value=\"${title}\" results=1" "${log}" ||
        fail "${title} did not resolve uniquely through the real command palette"
    xdotool key --window "${window_id}" Return
    for _ in $(seq 1 100); do
        (( $(grep -Fxc "zentty-linux: action=theme-mode result=persisted mode=${mode}" "${log}" || true) > persisted_before )) && return 0
        sleep 0.05
    done
    fail "${title} did not persist ${mode} mode"
}

close_focused_evidence_profile() {
    local confirmation_count wait_status product_status
    confirmation_count="$(grep -Fc 'zentty-linux: confirmation shown title="Quit Zentty?"' "${log}" || true)"
    zentty_product_close_window x11
    for _ in $(seq 1 100); do
        (( $(grep -Fc 'zentty-linux: confirmation shown title="Quit Zentty?"' "${log}" || true) > confirmation_count )) && break
        sleep 0.05
    done
    (( $(grep -Fc 'zentty-linux: confirmation shown title="Quit Zentty?"' "${log}" || true) > confirmation_count )) ||
        fail "focused evidence profile did not present its real quit confirmation"
    xdotool key Return
    set +e
    timeout --foreground --kill-after=2s 7s tail --pid="${product_pid}" -f /dev/null
    wait_status=$?
    wait "${product_pid}"
    product_status=$?
    set -e
    product_pid=""
    (( wait_status == 0 && product_status == 0 )) ||
        fail "focused evidence profile did not close cleanly"
}

accept_latest_pane_confirmation() {
    local before="$1"
    local accepted_before
    accepted_before="$(grep -Fc 'zentty-linux: confirmation accepted=true' "${log}" || true)"
    for _ in $(seq 1 100); do
        (( $(grep -Fc 'zentty-linux: confirmation shown title="Close this pane?"' "${log}" || true) > before )) && break
        sleep 0.05
    done
    (( $(grep -Fc 'zentty-linux: confirmation shown title="Close this pane?"' "${log}" || true) > before )) ||
        fail "pane close did not present the source confirmation"
    xdotool key Return
    for _ in $(seq 1 100); do
        (( $(grep -Fc 'zentty-linux: confirmation accepted=true' "${log}" || true) > accepted_before )) && return 0
        sleep 0.05
    done
    fail "pane close confirmation did not accept the physical Return key"
}

for _ in $(seq 1 100); do
    if grep -Fxq 'zentty-linux: title-pane=pane-1 value=zentty-title-two' "${log}"; then
        break
    fi
    sleep 0.05
done
grep -Fxq 'zentty-linux: title-pane=pane-1 value=zentty-title-two' "${log}" ||
    fail "the real terminal did not deliver both title changes"

if [[ "${ZENTTY_SOURCE_UX_PANE_DRAG_ONLY:-false}" == true ]]; then
    xdotool windowsize --sync "${window_id}" 1200 700
    xdotool key --window "${window_id}" ctrl+d
    zentty_product_wait_for_log "${log}" 'zentty-linux: terminal-ready-pane=pane-2' \
        "second real terminal did not become ready" || fail "second terminal missing"
    grep -Fq 'zentty-linux: geometry=worklane-1:column-worklane-1[pane-1],column-pane-2[pane-2]' "${log}" ||
        fail "pre-drag visible split was not established"

    # Use the real terminal drag strip, then discover the destination through
    # the product's live preview receipt instead of assuming WM decorations.
    find_pane_drag_zone pane-1 400 700 35 90 ||
        fail "physical pointer could not locate pane-1 terminal drag strip"
    xdotool mousedown 1
    sleep 0.25
    xdotool mousemove_relative --sync -- 0 40
    zentty_product_wait_for_log "${log}" 'zentty-linux: pane-drag=begin window=window-1 worklane=worklane-1 pane=pane-1 source=terminal-strip visual=full-card' \
        "GTK did not claim the terminal pane drag" || fail "pane drag did not begin"
    for point in '500 120' '650 200' '800 300' '1000 400'; do
        # shellcheck disable=SC2086
        xdotool mousemove --sync --window "${window_id}" ${point}
        sleep 0.05
    done
    zentty_product_wait_for_log "${log}" 'zentty-linux: pane-drag=target-enter pane=pane-2 accepted=true' \
        "canvas target did not accept the pane payload" || fail "canvas target missing"
    bottom_ready=false
    # Stay inside pane-2 even if the asynchronous 1200px resize has not yet
    # caused its fixed split widths to consume newly exposed blank viewport.
    for candidate_y in 450 500 550 600 640 660 680 690; do
        xdotool mousemove --sync --window "${window_id}" 800 "${candidate_y}"
        sleep 0.05
        if grep -Fq 'zentty-linux: pane-drag=preview target-pane=pane-2 hit=StackGap { after: true } reflow=live' "${log}"; then
            bottom_ready=true
            break
        fi
    done
    [[ "${bottom_ready}" == true ]] || fail "physical drag did not reach pane-2 bottom stack gap"
    xdotool mouseup 1
    zentty_product_wait_for_log "${log}" 'zentty-linux: pane-drop=commit pane=pane-1 source=window-1 destination=window-1' \
        "same-window stack drop did not commit" || fail "stack commit missing"
    grep -Fq 'zentty-linux: geometry=worklane-1:column-pane-2[pane-2,pane-1]' "${log}" ||
        fail "stack drop did not produce the exact vertical order"

    xdotool mousemove --sync --window "${window_id}" 700 560 click 1
    xdotool type --delay 10 'still-live-after-drag'
    xdotool key Return
    zentty_product_wait_for_log "${log}" 'zentty-linux: title-pane=pane-1 value=focus:still-live-after-drag' \
        "moved pane did not retain live PTY input" || fail "live PTY was not preserved"

    # The sidebar source must reach the same resolver. Removing pane-1 from
    # its two-pane stack makes pane-2 horizontally splittable during the drag.
    find_sidebar_pane_drag_source pane-1 ||
        fail "physical pointer could not locate moved pane-1 sidebar row"
    xdotool mousedown 1
    sleep 0.25
    xdotool mousemove_relative --sync -- 0 40
    zentty_product_wait_for_log "${log}" 'zentty-linux: pane-drag=begin window=window-1 worklane=worklane-1 pane=pane-1 visual=full-card' \
        "GTK did not claim the sidebar pane drag" || fail "sidebar pane drag did not begin"
    horizontal_before="$(grep -Fc 'zentty-linux: pane-drag=preview target-pane=pane-2 hit=Split { axis: Horizontal, leading: true } reflow=live' "${log}" || true)"
    horizontal_ready=false
    for candidate_x in 700 600 500 400 350 320 300 292; do
        xdotool mousemove --sync --window "${window_id}" "${candidate_x}" 220
        sleep 0.05
        if (( $(grep -Fc 'zentty-linux: pane-drag=preview target-pane=pane-2 hit=Split { axis: Horizontal, leading: true } reflow=live' "${log}" || true) > horizontal_before )); then
            horizontal_ready=true
            break
        fi
    done
    [[ "${horizontal_ready}" == true ]] ||
        fail "physical drag did not reach pane-2 leading horizontal split zone"
    xdotool mouseup 1
    zentty_product_wait_for_log_count "${log}" 'zentty-linux: pane-drop=commit pane=pane-1 source=window-1 destination=window-1' 2 \
        "second pane drag did not commit" || fail "horizontal commit missing"
    grep -Fq 'zentty-linux: geometry=worklane-1:column-pane-1[pane-1],column-pane-2[pane-2]' "${log}" ||
        fail "horizontal drop did not produce the exact leading split"

    # Escape cancellation and release over the compositor background must
    # leave both topology and persistence authority untouched.
    commit_before_cancel="$(grep -Fc 'zentty-linux: pane-drop=commit pane=pane-1' "${log}" || true)"
    cancel_before="$(grep -Fc 'zentty-linux: pane-drag=cancel pane=pane-1' "${log}" || true)"
    begin_before="$(grep -Fc 'zentty-linux: pane-drag=begin window=window-1 worklane=worklane-1 pane=pane-1 visual=full-card' "${log}" || true)"
    find_sidebar_pane_drag_source pane-1 || fail "physical pointer could not relocate pane-1 for cancellation"
    xdotool mousedown 1
    sleep 0.25
    xdotool mousemove_relative --sync -- 0 40
    zentty_product_wait_for_log_count "${log}" \
        'zentty-linux: pane-drag=begin window=window-1 worklane=worklane-1 pane=pane-1 visual=full-card' \
        "$((begin_before + 1))" "GTK did not claim the cancellable drag" ||
        fail "cancellable pane drag did not begin"
    xdotool key Escape
    xdotool mouseup 1 2>/dev/null || true
    zentty_product_wait_for_log_count "${log}" 'zentty-linux: pane-drag=cancel pane=pane-1' \
        "$((cancel_before + 1))" "Escape did not cancel the pane drag" ||
        fail "physical pane drag cancellation missing"

    invalid_end_before="$(grep -Fc 'zentty-linux: pane-drag=end pane=pane-1 visual=cleared' "${log}" || true)"
    begin_before="$(grep -Fc 'zentty-linux: pane-drag=begin window=window-1 worklane=worklane-1 pane=pane-1 visual=full-card' "${log}" || true)"
    find_sidebar_pane_drag_source pane-1 || fail "physical pointer could not relocate pane-1 for invalid drop"
    xdotool mousedown 1
    sleep 0.25
    xdotool mousemove_relative --sync -- 0 40
    zentty_product_wait_for_log_count "${log}" \
        'zentty-linux: pane-drag=begin window=window-1 worklane=worklane-1 pane=pane-1 visual=full-card' \
        "$((begin_before + 1))" "GTK did not claim the invalid-destination drag" ||
        fail "invalid-destination pane drag did not begin"
    read -r display_width display_height < <(xdotool getdisplaygeometry)
    xdotool mousemove --sync "$((display_width - 5))" "$((display_height - 5))"
    xdotool mouseup 1
    zentty_product_wait_for_log_count "${log}" 'zentty-linux: pane-drag=end pane=pane-1 visual=cleared' \
        "$((invalid_end_before + 1))" "invalid destination did not terminate the drag" ||
        fail "invalid-destination pane drag did not end"
    [[ "$(grep -Fc 'zentty-linux: pane-drop=commit pane=pane-1' "${log}" || true)" -eq "${commit_before_cancel}" ]] ||
        fail "cancelled or invalid pane drag mutated topology"
    [[ "$(grep -F 'zentty-linux: geometry=' "${log}" | tail -1)" == \
        'zentty-linux: geometry=worklane-1:column-pane-1[pane-1],column-pane-2[pane-2]' ]] ||
        fail "cancelled or invalid pane drag changed exact geometry"

    [[ "$(grep -Fc 'zentty-linux: terminal-ready-pane=pane-1' "${log}")" -eq 1 ]] ||
        fail "pane-1 surface was recreated during drag"
    [[ "$(grep -Fc 'zentty-linux: terminal-ready-pane=pane-2' "${log}")" -eq 1 ]] ||
        fail "pane-2 surface was recreated during drag"
    [[ "$(grep -Fc 'info(io_exec): started subcommand' "${log}")" -eq 2 ]] ||
        fail "pane drag restarted or duplicated a real PTY child"
    if grep -Eq 'panicked at|RefCell already borrowed|CRITICAL: Gtk|has a parent Gtk' "${log}"; then
        fail "pane drag reported a Rust or GTK lifecycle failure"
    fi
    echo 'Rust source UX pane drag passed: x11, real-gtk-dnd=1, exact-topology=1, live-pty-preserved=1'
    exit 0
fi

# The controlled Xvfb profile fixes scale and starts at 1000x700. Exercise the
# source width contract through real external resizes: default 280px, narrowed
# to one third of a 600px window, then restored to the preferred width when the
# window widens again.
xdotool windowsize --sync "${window_id}" 1200 700
for _ in $(seq 1 200); do
    grep -Fq 'zentty-linux: sidebar-width=280' "${log}" && break
    sleep 0.05
done
latest_sidebar_width="$(grep -F 'zentty-linux: sidebar-width=' "${log}" | tail -1)"
[[ "${latest_sidebar_width}" == 'zentty-linux: sidebar-width=280' ]] ||
    fail "the sidebar did not use Zentty's preferred width in a wide window"
xdotool windowsize --sync "${window_id}" 600 700
for _ in $(seq 1 200); do
    [[ "$(grep -F 'zentty-linux: sidebar-width=' "${log}" | tail -1)" == \
        'zentty-linux: sidebar-width=198' ]] && break
    sleep 0.05
done
latest_sidebar_width="$(grep -F 'zentty-linux: sidebar-width=' "${log}" | tail -1)"
[[ "${latest_sidebar_width}" == 'zentty-linux: sidebar-width=198' ]] ||
    fail "the sidebar did not clamp to one third of a narrow window"
xdotool windowsize --sync "${window_id}" 1200 700
for _ in $(seq 1 200); do
    [[ "$(grep -F 'zentty-linux: sidebar-width=' "${log}" | tail -1)" == \
        'zentty-linux: sidebar-width=280' ]] && break
    sleep 0.05
done
latest_sidebar_width="$(grep -F 'zentty-linux: sidebar-width=' "${log}" | tail -1)"
[[ "${latest_sidebar_width}" == 'zentty-linux: sidebar-width=280' ]] ||
    fail "the preferred sidebar width was lost after temporary window clamping"
capture_unmasked_visual_scenario empty-dark-x11

# Drag the real GTK divider rather than calling a model setter. The allocation
# must follow the pointer and the preferred width must survive returning the
# divider to its source default before the remaining coordinate-driven flow.
xdotool mousemove --window "${window_id}" 282 350 mousedown 1
xdotool mousemove --sync --window "${window_id}" 360 350 mouseup 1
sleep 0.2
dragged_sidebar_width="$(
    grep -F 'zentty-linux: sidebar-width=' "${log}" | tail -1 | cut -d= -f2
)"
[[ "${dragged_sidebar_width}" =~ ^[0-9]+$ ]] ||
    fail "the divider drag produced no sidebar allocation receipt"
(( dragged_sidebar_width >= 350 && dragged_sidebar_width <= 365 )) ||
    fail "the real divider drag did not resize the sidebar"
if [[ "${ZENTTY_SOURCE_UX_SIDEBAR_RESIZE_ONLY:-false}" == true ]]; then
    resize_persist_before="$(grep -Fc 'zentty-linux: sidebar-persist origin=resize ' "${log}" || true)"
    resize_projection_before="$(grep -Fc 'zentty-linux: config-live-projected window=window-1' "${log}" || true)"
    capture_unmasked_visual_scenario sidebar-resize-x11
    for _ in $(seq 1 160); do
        (( $(grep -Fc 'zentty-linux: sidebar-persist origin=resize ' "${log}" || true) > resize_persist_before )) &&
            (( $(grep -Fc 'zentty-linux: config-live-projected window=window-1' "${log}" || true) > resize_projection_before )) && break
        sleep 0.05
    done
