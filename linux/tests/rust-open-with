#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
# shellcheck source=linux/tests/lib/disposable-sshd
source "${repo_root}/linux/tests/lib/disposable-sshd"
# shellcheck source=linux/tests/lib/product-bundle
source "${repo_root}/linux/tests/lib/product-bundle"
# shellcheck source=linux/tests/lib/product-input
source "${repo_root}/linux/tests/lib/product-input"
product="${ZENTTY_LINUX_BINARY:-${repo_root}/build/linux/bin/zentty-linux}"
run_root="$(mktemp -d)"
project="${run_root}/project path # controlled"
state_directory="${run_root}/state"
config_home="${run_root}/config"
data_home="${run_root}/data"
fixture_bin="${run_root}/bin"
desktop_receipt="${run_root}/desktop.receipt"
custom_receipt="${run_root}/custom.receipt"
additional_receipt="${run_root}/additional.receipt"
refresh_receipt="${run_root}/refresh.receipt"
terminal_receipt="${run_root}/terminal.receipt"
log="${run_root}/product.log"
local_log="${log}"
product_pid=""
backend="${GDK_BACKEND:-}"

fail() {
    [[ ! -f "${log}" ]] || tail -120 "${log}" >&2
    echo "rust-open-with: error: $*" >&2
    exit 1
}

cleanup() {
    if [[ "${product_pid}" =~ ^[1-9][0-9]*$ ]]; then
        kill -TERM "${product_pid}" 2>/dev/null || true
        wait "${product_pid}" 2>/dev/null || true
    fi
    zentty_disposable_sshd_stop
    if [[ "${ZENTTY_KEEP_TEST_ARTIFACTS:-0}" == 1 ]]; then
        retained="/tmp/zentty-rust-open-with-retained.${BASHPID}"
        cp -a -- "${run_root}" "${retained}"
        echo "rust-open-with: retained artifacts=${retained}" >&2
        rm -rf -- "${run_root}"
    else
        rm -rf -- "${run_root}"
    fi
}
trap cleanup EXIT

case "${backend}" in
    x11)
        [[ "${ZENTTY_NESTED_X11_SESSION_ID:-}" =~ ^[0-9a-f]{64}$ ]] ||
            fail "X11 scenario must run through linux/tests/nested-x11"
        command -v xdotool >/dev/null || fail "xdotool is required"
        command -v xclip >/dev/null || fail "xclip is required"
        ;;
    wayland)
        [[ "${ZENTTY_NESTED_WAYLAND_INPUT_SESSION_ID:-}" =~ ^[0-9a-f]{64}$ ]] ||
            fail "Wayland scenario must run through linux/tests/nested-wayland-input"
        if ! zentty_product_uses_xdotool "${backend}"; then
            command -v wtype >/dev/null || fail "wtype is required"
        fi
        ;;
    *) fail "GDK_BACKEND must be x11 or wayland" ;;
esac
for dependency in desktop-file-validate grep head mktemp readelf readlink sed seq sleep update-desktop-database xdg-mime; do
    command -v "${dependency}" >/dev/null || fail "${dependency} is required"
done
[[ -x "${product}" ]] || fail "staged product is missing: ${product}"
zentty_product_bundle_resolve "${product}" || fail "staged product bundle is invalid"
product="${ZENTTY_PRODUCT_BINARY}"
bundle_lib="${ZENTTY_PRODUCT_BUNDLE_LIB}"

mkdir -p \
    "${project}" \
    "${state_directory}" \
    "${config_home}/zentty" \
    "${data_home}/applications" \
    "${fixture_bin}"
canonical_project="$(readlink -f -- "${project}")"

cat >"${fixture_bin}/desktop-open" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
printf 'argc=%s\narg1=%s\n' "$#" "${1:-}" >"${ZENTTY_DESKTOP_RECEIPT}"
EOF
cat >"${fixture_bin}/custom-open" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
printf 'argc=%s\narg1=%s\n' "$#" "${1:-}" >"${ZENTTY_CUSTOM_RECEIPT}"
EOF
cat >"${fixture_bin}/additional-open" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
printf 'argc=%s\narg1=%s\n' "$#" "${1:-}" >"${ZENTTY_ADDITIONAL_RECEIPT}"
EOF
cat >"${fixture_bin}/refresh-open" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
printf 'unexpected-launch\n' >"${ZENTTY_REFRESH_RECEIPT}"
EOF
cat >"${fixture_bin}/xdg-terminal-exec" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
printf 'argc=%s\narg1=%s\n' "$#" "${1:-}" >"${ZENTTY_TERMINAL_RECEIPT}"
EOF
chmod 700 "${fixture_bin}/desktop-open" "${fixture_bin}/custom-open" \
    "${fixture_bin}/additional-open" \
    "${fixture_bin}/refresh-open" \
    "${fixture_bin}/xdg-terminal-exec"
zentty_disposable_sshd_start || fail "could not start disposable loopback SSH server"
ln -s "${ZENTTY_DISPOSABLE_SSH_LAUNCHER}" "${fixture_bin}/zentty-ssh-fixture"

cat >"${data_home}/applications/zentty-controlled-files.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=Controlled Files
Exec=${fixture_bin}/desktop-open %u
MimeType=inode/directory;
NoDisplay=true
EOF
desktop-file-validate "${data_home}/applications/zentty-controlled-files.desktop"
XDG_DATA_HOME="${data_home}" XDG_CONFIG_HOME="${config_home}" \
    update-desktop-database "${data_home}/applications"
XDG_DATA_HOME="${data_home}" XDG_CONFIG_HOME="${config_home}" \
    xdg-mime default zentty-controlled-files.desktop inode/directory
[[ "$(XDG_DATA_HOME="${data_home}" XDG_CONFIG_HOME="${config_home}" xdg-mime query default inode/directory)" == \
    zentty-controlled-files.desktop ]] || fail "controlled desktop application is not the default directory handler"

cat >"${config_home}/zentty/config.toml" <<EOF
[open_with]
primary_target_id = "system-file-manager"
enabled_target_ids = ["system-file-manager", "system-terminal", "custom:controlled", "custom:refresh", "xcode"]

[[open_with.custom_apps]]
id = "custom:controlled"
name = "Controlled Editor"
path = "${fixture_bin}/custom-open"

[[open_with.custom_apps]]
id = "custom:refresh"
name = "Refresh Probe"
path = "${fixture_bin}/refresh-open"
EOF

start_product() {
    local output_log="$1"
    shift
    (
        cd "${project}"
        exec env \
            XDG_CONFIG_HOME="${config_home}" \
            XDG_DATA_HOME="${data_home}" \
            PATH="${fixture_bin}:${PATH}" \
            ZENTTY_DESKTOP_RECEIPT="${desktop_receipt}" \
            ZENTTY_CUSTOM_RECEIPT="${custom_receipt}" \
            ZENTTY_ADDITIONAL_RECEIPT="${additional_receipt}" \
            ZENTTY_REFRESH_RECEIPT="${refresh_receipt}" \
            ZENTTY_TERMINAL_RECEIPT="${terminal_receipt}" \
            GDK_SCALE=1 \
            GDK_DPI_SCALE=1 \
            LD_LIBRARY_PATH="${bundle_lib}${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}" \
            "${product}" "$@" --state-directory "${state_directory}" --no-session-restore
    ) >"${output_log}" 2>&1 &
    product_pid=$!
}

wait_for_product() {
    window_id=""
    for _ in $(seq 1 300); do
        if [[ "${backend}" == x11 ]]; then
            window_id="$(xdotool search --onlyvisible --pid "${product_pid}" 2>/dev/null | head -1 || true)"
        else
            window_id=wayland-focused
        fi
        [[ -n "${window_id}" ]] && grep -Fxq 'zentty-linux: terminal-ready' "${log}" && break
        sleep 0.05
    done
    [[ -n "${window_id}" ]] || fail "real Zentty window did not appear"
    if [[ "${backend}" == wayland ]]; then
        for _ in $(seq 1 100); do
            grep -Fq 'zentty-linux: focus-pane pane=pane-1' "${log}" && break
            sleep 0.05
        done
        grep -Fq 'zentty-linux: focus-pane pane=pane-1' "${log}" ||
            fail "Wayland compositor had not focused the real terminal"
    fi
}

start_product "${log}"
wait_for_product
zentty_product_prepare_input "${backend}" "${log}" ||
    fail "real product input could not be prepared"
[[ "${backend}" != x11 ]] || window_id="${ZENTTY_PRODUCT_WINDOW_ID}"
grep -Fq 'open-with-discovery available=4 primary=system-file-manager unavailable=xcode' "${log}" ||
    fail "controlled desktop/terminal/custom discovery and missing-target diagnostics differed"

open_palette() {
    local shown_before focus_before
    shown_before="$(grep -Fxc 'zentty-linux: command-palette=shown' "${log}" || true)"
    focus_before="$(grep -Fxc 'zentty-linux: command-palette-focus=confirmed result=true' "${log}" || true)"
    zentty_product_ctrl_shift_key "${backend}" p
    zentty_product_wait_for_log_count "${log}" \
        'zentty-linux: command-palette=shown' "$((shown_before + 1))" \
        "physical shortcut did not show the command palette after input readiness" || fail
    zentty_product_wait_for_log_count "${log}" \
        'zentty-linux: command-palette-focus=confirmed result=true' "$((focus_before + 1))" \
        "command palette did not focus its search entry" || fail
}

establish_wayland_input_readiness() {
    [[ "${backend}" == wayland ]] || return 0
    zentty_product_establish_palette_input "${backend}" "${log}" ||
        fail "Wayland compositor never delivered the bounded physical input readiness probe"
}

type_text() {
    zentty_product_type "${backend}" "$1"
}

activate_first() {
    zentty_product_key "${backend}" Down
    zentty_product_key "${backend}" Return
}

dismiss_palette() {
    zentty_product_key "${backend}" Escape
}

activate_palette_action() {
    local query="$1"
    open_palette
    type_text "${query}"
    for _ in $(seq 1 200); do
        grep -Fq "command-palette=query value=\"${query}\" results=1" "${log}" && break
        sleep 0.05
    done
    grep -Fq "command-palette=query value=\"${query}\" results=1" "${log}" ||
        fail "palette action was absent or ambiguous: ${query}"
    activate_first
}

establish_wayland_input_readiness

# Present the real settings page through its physical command-palette route.
# Source-compatible presentation reconciliation must remove the unavailable
# Xcode row while preserving every genuinely resolved Linux target.
activate_palette_action 'Open With Settings'
for _ in $(seq 1 100); do
    grep -Fq 'open-with-settings control=presentation-reconcile result=applied' "${log}" && break
    sleep 0.05
done
grep -Fq 'open-with-settings control=presentation-reconcile result=applied' "${log}" ||
    fail "Open With settings did not reconcile its stale target on presentation"
for _ in $(seq 1 100); do
    grep -Fq 'zentty-linux: settings-section selected=open-with' "${log}" && break
    sleep 0.05
done
grep -Fq 'zentty-linux: settings-section selected=open-with' "${log}" ||
    fail "Open With settings page did not finish presentation"
for _ in $(seq 1 100); do
    grep -Fq 'zentty-linux: shortcut-settings active search-focused=' "${log}" && break
    sleep 0.05
done
grep -Fq 'zentty-linux: shortcut-settings active search-focused=' "${log}" ||
    fail "Open With settings toplevel did not become active"
grep -Fq 'custom:controlled' "${config_home}/zentty/config.toml" ||
    fail "settings reconciliation removed the available controlled application"
if grep -Fq 'xcode' "${config_home}/zentty/config.toml"; then
    fail "settings reconciliation retained the unavailable Xcode target"
fi

settings_window_id=""
find_settings_window() {
    local candidate width height area best="" best_area=0
    while read -r candidate; do
        [[ "${candidate}" =~ ^[1-9][0-9]*$ ]] || continue
        width="$(xdotool getwindowgeometry --shell "${candidate}" 2>/dev/null | sed -n 's/^WIDTH=//p')"
        height="$(xdotool getwindowgeometry --shell "${candidate}" 2>/dev/null | sed -n 's/^HEIGHT=//p')"
        [[ "${width}" =~ ^[0-9]+$ && "${height}" =~ ^[0-9]+$ ]] || continue
        area=$((width * height))
        if (( area > best_area )); then
            best="${candidate}"
            best_area="${area}"
        fi
    done < <(xdotool search --name '^Tornado TTY Settings$' 2>/dev/null || true)
    printf '%s' "${best}"
}
settings_key() {
    local key="$1"
    if [[ "${backend}" == x11 ]]; then
        xdotool windowfocus --sync "${settings_window_id}"
        xdotool key --clearmodifiers --window "${settings_window_id}" "${key}"
    elif zentty_product_uses_xdotool "${backend}"; then
        zentty_product_xdotool_key "${key}"
    else
        case "${key}" in
            alt+*) wtype -M alt -k "${key#alt+}" -m alt ;;
            ctrl+*) wtype -M ctrl -k "${key#ctrl+}" -m ctrl ;;
            *) wtype -k "${key}" ;;
        esac
    fi
}

settings_primary_select() {
    local label="$1"
    if [[ "${backend}" == x11 ]]; then
        xdotool windowfocus --sync "${settings_window_id}"
        xdotool key --clearmodifiers --window "${settings_window_id}" End
    elif zentty_product_uses_xdotool "${backend}"; then
        [[ "${label}" == additional-open ]] || fail "unsupported controlled dropdown target: ${label}"
        # The controlled Weston profile is fixed at 1280x1024. GtkDropDown's
        # mnemonic opens the searchable popup with its search entry focused;
        # an actual pointer click on the known final row exercises selection
        # without relying on compositors to agree on popup keyboard traversal.
        sleep 0.2
        xdotool mousemove --window "${ZENTTY_PRODUCT_WINDOW_ID}" 1100 500 click 1
    else
        wtype -k End
    fi
}

focus_open_with_control() {
    local marker="$1" description="$2" before
    before="$(grep -Fc "${marker}" "${log}" || true)"
    settings_key ctrl+f
    for _ in $(seq 1 60); do
        settings_key Tab
        (( $(grep -Fc "${marker}" "${log}" || true) > before )) && return
        sleep 0.05
    done
    fail "keyboard traversal did not reach ${description}"
}

focus_primary_control() {
    local before
    before="$(grep -Fc 'open-with-settings focus=primary' "${log}" || true)"
    if [[ "${backend}" == wayland ]] && zentty_product_uses_xdotool "${backend}"; then
        # The native chooser is a separate Wayland surface. Weston can leave
        # keyboard focus at the destroyed chooser until the parent receives a
        # compositor-visible pointer activation, unlike a desktop compositor
        # with a shell that automatically reactivates the transient parent.
        zentty_product_move_pointer_to_terminal "${backend}"
        xdotool click 1
    fi
    settings_key alt+p
    for _ in $(seq 1 100); do
        (( $(grep -Fc 'open-with-settings focus=primary' "${log}" || true) > before )) && return
        sleep 0.05
    done
    fail "the Primary application mnemonic did not focus its dropdown"
}

focus_next_open_with_control() {
    local marker="$1" description="$2" before
    before="$(grep -Fc "${marker}" "${log}" || true)"
    for _ in $(seq 1 60); do
        settings_key Tab
        (( $(grep -Fc "${marker}" "${log}" || true) > before )) && return
        sleep 0.05
    done
    fail "keyboard traversal did not reach ${description}"
}

activate_refresh() {
    local refresh_before
    refresh_before="$(grep -Fc 'open-with-settings control=refresh result=applied' "${log}" || true)"
    if [[ "${backend}" == x11 ]]; then
        xdotool mousemove --sync --window "${settings_window_id}" 530 299 click 1
    else
        settings_key alt+f
    fi
    for _ in $(seq 1 200); do
        (( $(grep -Fc 'open-with-settings control=refresh result=applied' "${log}" || true) > refresh_before )) && return
        sleep 0.05
    done
    fail "Refresh Apps did not cross the existing discovery/config authority"
}

# Change the real custom-target checkbox through the controlled X11 pointer.
# Nested Wayland currently owns a virtual keyboard but not a scoped pointer
# injector, so it qualifies page presentation, reconciliation, and restart;
# the physical settings control is explicitly owned by this companion X11 run.
if [[ "${backend}" == x11 ]]; then
    for _ in $(seq 1 100); do
        settings_window_id="$(find_settings_window)"
        [[ "${settings_window_id}" =~ ^[1-9][0-9]*$ ]] && break
        sleep 0.05
    done
    [[ "${settings_window_id}" =~ ^[1-9][0-9]*$ ]] || fail "real Open With settings window did not appear"
    focus_open_with_control \
        'settings-focus widget=settings-open-with-target-custom:controlled' \
        'the controlled Open With target'
    settings_key space
    for _ in $(seq 1 100); do
        grep -Fq 'open-with-settings control=target-enabled result=applied' "${log}" && break
        sleep 0.05
    done
    grep -Fq 'open-with-settings control=target-enabled result=applied' "${log}" ||
        fail "physical checkbox input did not cross the Open With settings boundary"
    if grep -F 'enabled_target_ids' "${config_home}/zentty/config.toml" | grep -Fq 'custom:controlled'; then
        fail "disabled custom Open With target remained enabled in persisted configuration"
    fi
    focus_open_with_control \
        'settings-focus widget=settings-open-with-target-custom:controlled' \
        'the controlled Open With target after rebuild'
    settings_key space
    for _ in $(seq 1 100); do
        (( $(grep -Fc 'open-with-settings control=target-enabled result=applied' "${log}" || true) >= 2 )) && break
        sleep 0.05
    done
    (( $(grep -Fc 'open-with-settings control=target-enabled result=applied' "${log}" || true) >= 2 )) ||
        fail "physical checkbox input did not re-enable the Open With target"
    grep -F 'enabled_target_ids' "${config_home}/zentty/config.toml" | grep -Fq 'custom:controlled' ||
        fail "re-enabled custom Open With target was not persisted"
fi

# Remove a discovered executable while Settings remains open, then activate
# the real Refresh Apps control before any native chooser has introduced
# transient X11 surfaces. The page must reconcile through the existing runtime
# and config authority rather than treating environmental absence as success.
rm -- "${fixture_bin}/refresh-open"
activate_refresh
if grep -Fq 'custom:refresh' "${config_home}/zentty/config.toml"; then
    fail "refresh retained the externally removed application"
fi

# Add through the native GTK chooser on both compositors. Mnemonic activation
# and chooser input are physical user paths; the page receives no fixture API.
if [[ "${backend}" == x11 ]]; then
    settings_window_id="$(find_settings_window)"
    [[ "${settings_window_id}" =~ ^[1-9][0-9]*$ ]] || fail "Open With settings window disappeared before Add App"
    xdotool mousemove --sync --window "${settings_window_id}" 410 299 click 1
else
    settings_key alt+a
fi
for _ in $(seq 1 100); do
    grep -Fq 'open-with-settings control=add-custom result=chooser-opened' "${log}" && break
    sleep 0.05
done
grep -Fq 'open-with-settings control=add-custom result=chooser-opened' "${log}" ||
    fail "Add App did not open the native chooser"
if [[ "${backend}" == x11 ]]; then
    chooser_window=""
    for _ in $(seq 1 200); do
        chooser_window="$(xdotool search --onlyvisible --name '^(Add Open With Application|Open File)$' 2>/dev/null | tail -1 || true)"
        [[ "${chooser_window}" =~ ^[1-9][0-9]*$ ]] && break
        sleep 0.05
    done
    [[ "${chooser_window}" =~ ^[1-9][0-9]*$ ]] || fail "native application chooser did not map"
    xdotool windowfocus --sync "${chooser_window}"
    xdotool key --clearmodifiers ctrl+l
    printf '%s' "${fixture_bin}/additional-open" | xclip -selection clipboard -in
    xdotool key --clearmodifiers ctrl+v
    xdotool key --clearmodifiers Return
    # GTK may accept the explicit location immediately or only select its
    # enumerated row. Do not send a speculative second Return into Settings
    # after immediate success; accept again only while the chooser remains.
    for _ in {1..40}; do
        grep -Fq 'open-with-settings control=add-custom result=applied' "${log}" && break
        sleep 0.05
    done
    if ! grep -Fq 'open-with-settings control=add-custom result=applied' "${log}" &&
        xdotool search --onlyvisible --name '^(Add Open With Application|Open File)$' 2>/dev/null |
            grep -Fxq "${chooser_window}"; then
        xdotool windowfocus --sync "${chooser_window}"
        xdotool key --clearmodifiers Return
    fi
else
    sleep 0.4
    settings_key ctrl+l
    zentty_product_type "${backend}" "${fixture_bin}/additional-open"
    settings_key Return
fi
for _ in $(seq 1 200); do
    grep -Fq 'open-with-settings control=add-custom result=applied' "${log}" && break
    sleep 0.05
done
grep -Fq 'open-with-settings control=add-custom result=applied' "${log}" ||
    fail "native chooser selection did not add the custom application"
additional_id="$(sed -n 's/^id = "\(custom:[0-9a-f]\{16\}\)"$/\1/p' "${config_home}/zentty/config.toml" | tail -1)"
[[ "${additional_id}" =~ ^custom:[0-9a-f]{16}$ ]] ||
    fail "added application did not receive a stable custom ID"
grep -Fq "path = \"${fixture_bin}/additional-open\"" "${config_home}/zentty/config.toml" ||
    fail "native chooser application path was not persisted"

# Select the newly added target as primary through the accessible mnemonic and
# dropdown, then remove it through the real focused Remove button. The removal
# must fall back to the first surviving enabled target.
primary_apply_before="$(grep -Fc 'open-with-settings control=primary result=applied' "${log}" 2>/dev/null || true)"
if [[ "${backend}" == x11 ]] || ! zentty_product_uses_xdotool "${backend}"; then
    focus_open_with_control 'open-with-settings focus=primary' 'the Primary application dropdown'
else
    focus_primary_control
fi
settings_primary_select additional-open
for _ in $(seq 1 200); do
    (( $(grep -Fc 'open-with-settings control=primary result=applied' "${log}" 2>/dev/null || true) > primary_apply_before )) && break
    sleep 0.05
done
(( $(grep -Fc 'open-with-settings control=primary result=applied' "${log}" 2>/dev/null || true) > primary_apply_before )) ||
    fail "physical primary selection was not applied"
for _ in $(seq 1 100); do
    grep -Fq "primary_target_id = \"${additional_id}\"" "${config_home}/zentty/config.toml" && break
    sleep 0.05
done
grep -Fq "primary_target_id = \"${additional_id}\"" "${config_home}/zentty/config.toml" ||
    fail "physical primary selection did not persist the added target: expected=${additional_id} actual=$(sed -n 's/^primary_target_id = "\([^"]*\)"$/\1/p' "${config_home}/zentty/config.toml")"
focus_next_open_with_control \
    "open-with-settings focus=remove id=${additional_id}" \
    "the added application's Remove button"
settings_key Return
for _ in $(seq 1 100); do
    grep -Fq 'open-with-settings control=remove-custom result=applied' "${log}" && break
    sleep 0.05
done
grep -Fq 'open-with-settings control=remove-custom result=applied' "${log}" ||
    fail "focused Remove button did not update Open With settings"
if grep -Fq "${additional_id}" "${config_home}/zentty/config.toml"; then
    fail "removed custom application remained in configuration"
fi
grep -Fq 'primary_target_id = "system-file-manager"' "${config_home}/zentty/config.toml" ||
    fail "removing the primary target did not choose the deterministic fallback"

# An externally authored no-target preference remains a valid state. The live
# watcher must present it explicitly rather than silently selecting a launcher.
# Restore the controlled targets afterward for restart and launch assertions.
no_target_before="$(grep -Fc 'open-with-settings primary-state=none' "${log}" || true)"
reload_before="$(grep -Fc 'config-reload result=applied windows=1 retained-sections=none' "${log}" || true)"
sed -i 's/^enabled_target_ids = .*/enabled_target_ids = []/' "${config_home}/zentty/config.toml"
for _ in $(seq 1 200); do
    if (( $(grep -Fc 'open-with-settings primary-state=none' "${log}" || true) > no_target_before )) &&
        (( $(grep -Fc 'config-reload result=applied windows=1 retained-sections=none' "${log}" || true) > reload_before )); then
        break
    fi
    sleep 0.05
done
(( $(grep -Fc 'open-with-settings primary-state=none' "${log}" || true) > no_target_before )) ||
    fail "empty enabled catalog did not present the explicit no-target state"
grep -Fq 'enabled_target_ids = []' "${config_home}/zentty/config.toml" ||
    fail "no-target refresh silently selected an unrelated application"
reload_before="$(grep -Fc 'config-reload result=applied windows=1 retained-sections=none' "${log}" || true)"
sed -i 's/^enabled_target_ids = .*/enabled_target_ids = ["system-file-manager", "system-terminal", "custom:controlled"]/' "${config_home}/zentty/config.toml"
for _ in $(seq 1 200); do
    (( $(grep -Fc 'config-reload result=applied windows=1 retained-sections=none' "${log}" || true) > reload_before )) && break
    sleep 0.05
done
(( $(grep -Fc 'config-reload result=applied windows=1 retained-sections=none' "${log}" || true) > reload_before )) ||
    fail "restored external target preference did not update the live catalog"

# Restart through the real product boundary and prove the reconciled catalog is
# the configuration subsequently loaded by menus and the command palette.
kill -TERM "${product_pid}"
wait "${product_pid}" 2>/dev/null || true
product_pid=""
log="${run_root}/reconciled-product.log"
local_log="${log}"
start_product "${log}"
wait_for_product
grep -Fq 'open-with-discovery available=3 primary=system-file-manager unavailable=' "${log}" ||
    fail "reconciled Open With configuration did not survive restart"

activate_palette_action 'Open focused pane in Controlled Files'
for _ in $(seq 1 100); do
    [[ -s "${desktop_receipt}" ]] && break
    sleep 0.05
done
grep -Fxq 'argc=1' "${desktop_receipt}" || fail "desktop application did not receive exactly one URI"
grep -Fxq "arg1=${canonical_project}" "${desktop_receipt}" ||
    fail "desktop application received the wrong canonical local target: expected=${canonical_project} actual=$(sed -n 's/^arg1=//p' "${desktop_receipt}")"

activate_palette_action 'Open With: Controlled Editor'
for _ in $(seq 1 100); do
    [[ -s "${custom_receipt}" ]] && break
    sleep 0.05
done
grep -Fxq 'argc=1' "${custom_receipt}" || fail "custom application did not receive exactly one argv"
grep -Fxq "arg1=${canonical_project}" "${custom_receipt}" || fail "custom application received the wrong canonical path"

activate_palette_action 'Open With: System Terminal'
for _ in $(seq 1 100); do
    [[ -s "${terminal_receipt}" ]] && break
    sleep 0.05
done
grep -Fxq 'argc=1' "${terminal_receipt}" ||
    fail "terminal launcher did not receive exactly one option"
grep -Fxq "arg1=--dir=${canonical_project}" "${terminal_receipt}" ||
    fail "terminal launcher did not receive the exact monolithic XDG directory option"

# All three successful Open With routes are source-eligible Recent Actions.
# Reopen the real empty palette with physical input and require its rendered
# grouped state rather than inspecting the tracker directly.
open_palette
for title in \
    'Open With: System Terminal' \
    'Open With: Controlled Editor' \
    'Open focused pane in Controlled Files'; do
    grep -Fq "zentty-linux: command-palette-item section=\"Recent Actions\" title=\"${title}\"" "${log}" ||
        fail "successful Open With action missing from rendered Recent Actions: ${title}"
done
dismiss_palette

# A real foreground OpenSSH client must make the same action unavailable. This
# exercises the synchronous probe too, so the result cannot depend on the
# sidebar's asynchronous remote-identity cache winning a race.
printf 'remote-action-must-not-launch\n' >"${desktop_receipt}"
kill -TERM "${product_pid}"
wait "${product_pid}" 2>/dev/null || true
product_pid=""
log="${run_root}/remote-product.log"
start_product "${log}" --command "${ZENTTY_DISPOSABLE_SSH_LAUNCHER}"
wait_for_product
zentty_product_prepare_input "${backend}" "${log}" ||
    fail "restarted product input could not be prepared"
establish_wayland_input_readiness
for _ in $(seq 1 200); do
    grep -Fq 'zentty-linux: title-pane=pane-1 value=ssh-remote-ready' "${log}" && break
    sleep 0.05
done
grep -Fq 'zentty-linux: title-pane=pane-1 value=ssh-remote-ready' "${log}" ||
    fail "real foreground SSH process did not reach the controlled remote actor"
remote_rejections_before="$(grep -Fc 'action=open-with-target id=system-file-manager unavailable=remote-pane' "${log}" || true)"
activate_palette_action 'Open focused pane in Controlled Files'
for _ in $(seq 1 100); do
    (( $(grep -Fc 'action=open-with-target id=system-file-manager unavailable=remote-pane' "${log}" || true) > remote_rejections_before )) && break
    sleep 0.05
done
(( $(grep -Fc 'action=open-with-target id=system-file-manager unavailable=remote-pane' "${log}" || true) > remote_rejections_before )) ||
    fail "Open With did not reject a real remote pane"
grep -Fxq 'remote-action-must-not-launch' "${desktop_receipt}" ||
    fail "remote Open With unexpectedly invoked the desktop application"

grep -Fq 'action=open-with-target id=system-file-manager result=launched' "${local_log}" ||
    fail "primary desktop launch was not recorded"
grep -Fq 'action=open-with-target id=custom:controlled result=launched' "${local_log}" ||
    fail "selected custom launch was not recorded"
grep -Fq 'action=open-with-target id=system-terminal result=launched' "${local_log}" ||
    fail "system terminal launch was not recorded"
if grep -Eq 'panicked at|thread caused non-unwinding panic|RefCell already borrowed|CRITICAL: Gtk' "${local_log}" "${log}"; then
    fail "Open With journey reported a Rust or GTK lifecycle failure"
fi

echo "rust-open-with-${backend}: PASS desktop-app=real custom-executable=real xdg-terminal-contract=exact ssh=real physical-input=real canonical-target=exact missing=diagnostic remote=rejected"
