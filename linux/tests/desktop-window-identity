#!/usr/bin/env bash
set -euo pipefail

# Environment-only wrapper. The staged Rust driver owns the product process,
# actions, assertions, deadlines, evidence, and cleanup for this scenario.
repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
product="${ZENTTY_LINUX_BINARY:-${repo_root}/build/linux/bin/zentty-linux}"
driver="${TORNADOTTY_JOURNEY_DRIVER:-${product%/*}/tornadotty-journey-driver}"
backend="${GDK_BACKEND:-}"
application_id="com.tamedtornado.tornadotty"
desktop_entry="${repo_root}/linux/packaging/com.tamedtornado.tornadotty.desktop"

fail() {
    echo "desktop-window-identity: error: $*" >&2
    exit 1
}

case "${backend}" in
    wayland)
        [[ "${ZENTTY_NESTED_WAYLAND_SESSION_ID:-}" =~ ^[0-9a-f]{64}$ ]] ||
            fail "Wayland identity must run through linux/tests/nested-wayland"
        ;;
    x11)
        [[ "${ZENTTY_NESTED_X11_SESSION_ID:-}" =~ ^[0-9a-f]{64}$ ]] ||
            fail "X11 identity must run through linux/tests/nested-x11"
        command -v xdotool >/dev/null || fail "xdotool is required"
        command -v xprop >/dev/null || fail "xprop is required"
        ;;
    *) fail "GDK_BACKEND must be wayland or x11" ;;
esac
if [[ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ]]; then
    command -v dbus-run-session >/dev/null || fail "dbus-run-session is required"
    exec dbus-run-session -- "$0" "$@"
fi
[[ -x "${product}" ]] || fail "product is not executable: ${product}"
[[ -x "${driver}" ]] || fail "staged Rust journey driver is not executable: ${driver}"

exec "${driver}" scenario window-identity \
    "$(realpath -- "${product}")" "${backend}" "${application_id}" \
    "$(realpath -- "${desktop_entry}")"
