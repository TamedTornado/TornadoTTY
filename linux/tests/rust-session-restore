#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
product="${ZENTTY_LINUX_BINARY:-${repo_root}/build/linux/bin/zentty-linux}"
fixture="${repo_root}/crates/zentty-core/tests/fixtures/session-restore-v3.json"
actor="${repo_root}/linux/tests/fixtures/controlled-agent"
backend="${GDK_BACKEND:-}"
state_dir=""
fake_bin=""
log=""
agent_receipt=""
product_pid=""
agent_start_delay=0
agent_profile=codex-restore
agent_sessions='session-codex,session-two'
agent_sleep_seconds=30
agent_fail_once_marker=""
agent_skip_auth=false
agent_start_receipt=""
drag_source_pid=""
drag_receipt=""
remote_paste_evidence="file+png+batch-rollback"
cancel_remote_pattern=""
batch_remote_pattern=""
product_args=()
launch_count=0
event_receipt=""
session_root=""
session_directory=""
display_resource=""

# shellcheck source=linux/tests/lib/product-input
source "${repo_root}/linux/tests/lib/product-input"
# shellcheck source=linux/tests/lib/product-bundle
source "${repo_root}/linux/tests/lib/product-bundle"
# shellcheck source=linux/tests/lib/disposable-sshd
source "${repo_root}/linux/tests/lib/disposable-sshd"
# shellcheck source=linux/tests/lib/visual-evidence
source "${repo_root}/linux/tests/lib/visual-evidence"
# shellcheck source=linux/tests/lib/product-receipts
source "${repo_root}/linux/tests/lib/product-receipts"
# shellcheck source=linux/tests/lib/product-session
source "${repo_root}/linux/tests/lib/product-session"

fail() {
    [[ -z "${log}" || ! -f "${log}" ]] || cat "${log}" >&2
    [[ -z "${agent_receipt}" || ! -f "${agent_receipt}" ]] || cat "${agent_receipt}" >&2
    [[ -z "${drag_receipt}" || ! -f "${drag_receipt}" ]] || cat "${drag_receipt}" >&2
    echo "rust-session-restore: error: $*" >&2
    exit 1
}

cleanup() {
    if [[ "${TORNADOTTY_SESSION_SUPERVISOR_PID:-}" =~ ^[1-9][0-9]*$ ]]; then
        tornadotty_product_session_stop "${session_directory}" 500 2>/dev/null || true
    fi
    if [[ "${drag_source_pid}" =~ ^[1-9][0-9]*$ ]]; then
        kill -TERM "${drag_source_pid}" 2>/dev/null || true
        wait "${drag_source_pid}" 2>/dev/null || true
    fi
    zentty_disposable_sshd_stop
    [[ -z "${state_dir}" ]] || rm -rf -- "${state_dir}"
    [[ -z "${session_root}" ]] || rm -rf -- "${session_root}"
    [[ -z "${fake_bin}" ]] || rm -rf -- "${fake_bin}"
    [[ -z "${log}" ]] || rm -f -- "${log}"
    [[ -z "${agent_receipt}" ]] || rm -f -- "${agent_receipt}"
    [[ -z "${agent_start_receipt}" ]] || rm -f -- "${agent_start_receipt}"
    if [[ -n "${cancel_remote_pattern}" ]]; then
        find /tmp -maxdepth 1 -name "${cancel_remote_pattern}" -delete
    fi
    if [[ -n "${batch_remote_pattern}" ]]; then
        find /tmp -maxdepth 1 -name "${batch_remote_pattern}" -delete
    fi
}
trap cleanup EXIT

case "${backend}" in
    x11)
        [[ "${ZENTTY_NESTED_X11_SESSION_ID:-}" =~ ^[0-9a-f]{64}$ ]] ||
            fail "X11 restore must run through linux/tests/nested-x11"
        display_resource="display=x11:${ZENTTY_NESTED_X11_SESSION_ID}"
        ;;
    wayland)
        [[ "${ZENTTY_NESTED_WAYLAND_INPUT_SESSION_ID:-}" =~ ^[0-9a-f]{64}$ ]] ||
            fail "Wayland restore must run through linux/tests/nested-wayland-input"
        display_resource="display=wayland:${ZENTTY_NESTED_WAYLAND_INPUT_SESSION_ID}"
        ;;
    *) fail "GDK_BACKEND must be x11 or wayland" ;;
esac
if [[ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ]]; then
    command -v dbus-run-session >/dev/null || fail "dbus-run-session is required"
    exec dbus-run-session -- "$0" "$@"
fi
for dependency in jq readelf timeout mktemp grep sed pgrep cut tail sha256sum convert od import identify compare; do
    command -v "${dependency}" >/dev/null || fail "${dependency} is required"
done
[[ -x "${product}" ]] || fail "staged product is not built: ${product}"
zentty_product_bundle_resolve "${product}" || fail "staged product bundle is invalid"
product="${ZENTTY_PRODUCT_BINARY}"
bundle_lib="${ZENTTY_PRODUCT_BUNDLE_LIB}"
[[ -x "${actor}" ]] || fail "controlled agent actor is missing: ${actor}"
drag_source="${repo_root}/target/release-safe/file_drag_source"
if [[ "${backend}" == x11 || "${ZENTTY_NESTED_WAYLAND_OUTER_X11_INPUT:-}" == 1 ]]; then
    [[ -x "${drag_source}" ]] || fail "real GTK file drag source is missing: ${drag_source}"
fi


state_dir="$(mktemp -d)"
session_root="$(mktemp -d)"
fake_bin="$(mktemp -d)"
log=""
agent_receipt="$(mktemp)"
zentty_product_disable_lifecycle_confirmations
cat >>"${XDG_CONFIG_HOME}/zentty/config.toml" <<'EOF'

[appearance]
theme_mode = "dark"
EOF
mkdir -p "${XDG_CONFIG_HOME}/ghostty" "${XDG_CONFIG_HOME}/gtk-4.0"
cat >"${XDG_CONFIG_HOME}/ghostty/config" <<'EOF'
resize-overlay = never
cursor-opacity = 0
EOF
cat >"${XDG_CONFIG_HOME}/gtk-4.0/settings.ini" <<'EOF'
[Settings]
gtk-enable-animations=false
EOF
ln -s "${actor}" "${fake_bin}/codex"
real_scp="$(command -v scp)"
cat >"${fake_bin}/scp" <<EOF
#!/usr/bin/env bash
set -euo pipefail
if [[ -f "${state_dir}/delay-scp" ]]; then
    printf 'started\n' >"${state_dir}/scp-started"
    exec 3<>"${state_dir}/scp-delay-fifo"
    IFS= read -r -t 30 _ <&3 || true
    exec 3>&-
fi
exec "${real_scp}" "\$@"
EOF
chmod 700 "${fake_bin}/scp"
mkfifo "${state_dir}/scp-delay-fifo"

jq '
    (.workspace.windows[0].worklanes[].columns[].panes[] | select(.id == "pane-agent").workingDirectory) = "/tmp" |
    (.restoreDraftWindows[].paneDrafts[] | select(.paneID == "pane-agent").workingDirectory) = "/tmp" |
    (.restoreDraftWindows[].paneDrafts[] | select(.paneID == "pane-agent").taskProgress) = {"done":1,"total":2} |
    (.restoreDraftWindows[].paneDrafts[] | select(.paneID == "pane-agent").tasks) = {"worker-a":true,"worker-b":false} |
    .workspace.windows[0].worklanes[0].columns[0].panes += [{
        "id": "pane-ordinary-inactive",
        "workingDirectory": "/tmp"
    }] |
    .workspace.windows[0].worklanes[0].columns[0].paneHeights = [350, 175, 175] |
    .workspace.windows[0].worklanes += [{
        "id": "worklane-second-agent",
        "title": "Second agent",
        "nextPaneNumber": 2,
        "focusedColumnID": "column-second-agent",
        "columns": [{
            "id": "column-second-agent",
            "width": 720,
            "focusedPaneID": "pane-agent-two",
            "lastFocusedPaneID": "pane-agent-two",
            "paneHeights": [700],
            "panes": [{
                "id": "pane-agent-two",
                "workingDirectory": "/tmp",
                "titleSeed": "Codex"
            }]
        }]
    }, {
        "id": "worklane-active",
        "title": "Active shell",
        "nextPaneNumber": 2,
        "focusedColumnID": "column-active",
        "columns": [{
            "id": "column-active",
            "width": 720,
            "focusedPaneID": "pane-shell-active",
            "lastFocusedPaneID": "pane-shell-active",
            "paneHeights": [700],
            "panes": [{
                "id": "pane-shell-active",
                "workingDirectory": "/tmp"
            }]
        }]
    }] |
    .workspace.windows[0].activeWorklaneID = "worklane-active" |
    .restoreDraftWindows[0].paneDrafts += [{
        "paneID": "pane-agent-two",
        "kind": "agentResume",
        "toolName": "Codex",
        "sessionID": "session-two",
        "workingDirectory": "/tmp",
        "trackedPID": 5252,
        "agentLaunchSnapshot": {
            "arguments": ["codex", "resume", "session-two"]
        }
    }]
' "${fixture}" >"${state_dir}/restore-snapshot.json"

start_product() {
    launch_count=$((launch_count + 1))
    session_directory="${session_root}/launch-${launch_count}"
    event_receipt="${state_dir}/product-events-${launch_count}.ndjson"
    tornadotty_product_receipt_prepare "${product}" "${event_receipt}" ||
        fail "typed product receipt could not be prepared for launch ${launch_count}"
    tornadotty_product_session_start "${session_directory}" "${product}" \
        --resource "${display_resource}" -- \
        env \
        PATH="${fake_bin}:${PATH}" \
        ZENTTY_CONTROLLED_AGENT_PROFILE="${agent_profile}" \
        ZENTTY_CONTROLLED_AGENT_SESSIONS="${agent_sessions}" \
        ZENTTY_CONTROLLED_AGENT_COMPLETE_TASK_SESSION=session-codex \
        ZENTTY_CONTROLLED_AGENT_RECEIPT="${agent_receipt}" \
        ZENTTY_CONTROLLED_AGENT_START_DELAY_SECONDS="${agent_start_delay}" \
        ZENTTY_CONTROLLED_AGENT_START_RECEIPT="${agent_start_receipt}" \
        ZENTTY_CONTROLLED_AGENT_SLEEP_SECONDS="${agent_sleep_seconds}" \
        ZENTTY_CONTROLLED_AGENT_FAIL_ONCE_MARKER="${agent_fail_once_marker}" \
        ZENTTY_CONTROLLED_AGENT_SKIP_AUTH="${agent_skip_auth}" \
        GSK_RENDERER=cairo \
        LD_LIBRARY_PATH="${bundle_lib}${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}" \
        "${product}" --state-directory "${state_dir}" "${product_args[@]}" ||
        fail "Rust product supervisor did not start for launch ${launch_count}"
    product_pid="${TORNADOTTY_SESSION_PRODUCT_PID}"
    log="${TORNADOTTY_SESSION_PRODUCT_LOG}"
}

wait_for_agent_count() {
    local expected="$1"
    for _ in {1..240}; do
        [[ "$(grep -Ec '^resume:session-(codex|two) pid:[0-9]+$' "${agent_receipt}" || true)" -ge "${expected}" ]] && return
        kill -0 "${product_pid}" 2>/dev/null || fail "product exited before ${expected} agent launches"
        sleep 0.05
    done
    fail "timed out waiting for ${expected} controlled agent launches"
}

wait_for_product_exit() {
    local status
    if tornadotty_product_session_wait "${session_directory}" 12000; then
        status=0
    else
        status=$?
    fi
    product_pid=""
    ((status == 0)) || fail "product window close exited ${status}"
    tornadotty_product_receipt_validate "${event_receipt}" --complete >/dev/null ||
        fail "typed product lifecycle did not close cleanly"
}

assert_background_start() {
    local cumulative_count="$1"
    local ordinary_inactive_expected="${2:-false}"
    wait_for_agent_count "${cumulative_count}"
    zentty_product_wait_for_log "${log}" \
        'zentty-linux: agent-event pane=pane-agent worklane=worklane-main' \
        "first inactive agent did not authenticate" || fail "first inactive agent event missing"
    zentty_product_wait_for_log "${log}" \
        'zentty-linux: agent-event pane=pane-agent-two worklane=worklane-second-agent' \
        "second inactive agent did not authenticate" || fail "second inactive agent event missing"
    if [[ "${cumulative_count}" -eq 2 ]]; then
        zentty_product_wait_for_log "${log}" \
            'sidebar-agent-status pane=pane-agent phase=Starting interaction=None attention=false progress=1/2' \
            "restored task projection was not visible before the child hook" ||
            fail "restored task projection missing"
    fi
    zentty_product_wait_for_log "${log}" \
        'sidebar-agent-status pane=pane-agent phase=Starting interaction=None attention=false progress=2/2' \
        "real resumed child did not idempotently complete the remaining task" ||
        fail "restored task completion missing"
    grep -Fq '|worklane-active[title=Active shell,color=none]:pane-shell-active*' "${log}" ||
        fail "background startup changed the active worklane"
    tornadotty_product_receipt_wait "${event_receipt}" 10000 1 \
        terminal-ready pane-agent >/dev/null ||
        fail "first inactive agent surface lacked typed readiness"
    tornadotty_product_receipt_wait "${event_receipt}" 10000 1 \
        terminal-ready pane-agent-two >/dev/null ||
        fail "second inactive agent surface lacked typed readiness"
    for pane_id in pane-agent pane-agent-two pane-shell-active; do
        grep -Fq "zentty-linux: surface-config pane=${pane_id} cwd=/tmp" "${log}" ||
            fail "restored pane ${pane_id} did not pass its stored CWD to the real Ghostty surface"
    done
    zentty_product_wait_for_log "${agent_receipt}" 'cwd:session-codex value:/tmp' \
        "first restored agent child did not actually start in its stored CWD" ||
        fail "first restored agent child CWD missing"
    zentty_product_wait_for_log "${agent_receipt}" 'cwd:session-two value:/tmp' \
        "second restored agent child did not actually start in its stored CWD" ||
        fail "second restored agent child CWD missing"
    zentty_product_wait_for_log "${log}" 'zentty-linux: title-pane=pane-shell-active value=/tmp' \
        "restored ordinary shell did not report its stored CWD from the real PTY" ||
        fail "restored ordinary shell CWD missing"
    if [[ "${ordinary_inactive_expected}" == true ]]; then
        for pane_id in pane-shell pane-ordinary-inactive; do
            [[ "$(grep -Fxc "zentty-linux: terminal-ready-pane=${pane_id}" "${log}" || true)" -eq 1 ]] ||
                fail "eager restore did not initialize ordinary pane ${pane_id} exactly once"
        done
    else
        grep -Fq 'zentty-linux: terminal-ready-pane=pane-ordinary-inactive' "${log}" &&
            fail "ordinary inactive shell started before a real visit"
    fi
    if grep -Fq 'zentty-linux: focus-pane pane=pane-agent' "${log}"; then
        fail "inactive agent stole keyboard focus"
    fi
}

verify_remote_file_drop() {
    local drop_backend="$1"
    drag_receipt="${state_dir}/file-drag-source.ready"
    remote_paste_complete_before="$(grep -Fc 'zentty-linux: remote-paste pane=pane-shell-active state=complete' "${log}" || true)"
    "${drag_source}" "${remote_upload_payload}" "${drag_receipt}" >>"${log}" 2>&1 &
    drag_source_pid=$!
    for _ in {1..250}; do
        [[ -s "${drag_receipt}" ]] && break
        kill -0 "${drag_source_pid}" 2>/dev/null ||
            fail "real GTK file drag source exited before readiness"
        sleep 0.02
    done
    [[ -s "${drag_receipt}" ]] || fail "real GTK file drag source did not become ready"
    if [[ "${drop_backend}" == x11 ]]; then
        zentty_product_drag_from_x11_window 'Zentty File Drag Source' "${drag_receipt}" ||
            fail "physical X11 file drag could not be completed"
    else
        # The source toplevel may be tiled on either side by Weston.  Name an
        # interior terminal coordinate explicitly: the helper's generic
        # opposite-side destination can otherwise finish over the sidebar
        # after legitimately crossing the terminal drop target.
        ZENTTY_NESTED_WAYLAND_DRAG_TARGET_X=800 \
            ZENTTY_NESTED_WAYLAND_DRAG_TARGET_Y=500 \
            zentty_product_drag_in_nested_wayland "${drag_receipt}" ||
            fail "physical nested-Wayland file drag could not be completed"
    fi
    grep -Fq 'drag-begin:' "${drag_receipt}" || fail "GTK drag source never began a real drag"
    zentty_product_wait_for_log_count "${log}" \
        'zentty-linux: remote-paste pane=pane-shell-active state=complete' \
        "$((remote_paste_complete_before + 1))" \
        "remote file drop did not complete through the real product" ||
        fail "remote file-drop completion receipt missing"
    remote_drag_path="$(
        sed -n 's/^zentty-linux: remote-paste pane=pane-shell-active state=complete files=1 paths=//p' \
            "${log}" | tail -1
    )"
    [[ "${remote_drag_path}" == /tmp/zentty-paste-* ]] ||
        fail "remote file-drop receipt path is malformed"
    [[ "$(sha256sum "${remote_drag_path}" | cut -d' ' -f1)" == "${remote_upload_hash}" ]] ||
        fail "remote file-drop bytes did not match the desktop source"
    kill -TERM "${drag_source_pid}" 2>/dev/null || true
    wait "${drag_source_pid}" 2>/dev/null || true
    drag_source_pid=""
    xdotool windowfocus --sync "${ZENTTY_PRODUCT_WINDOW_ID}"
    sleep 0.1
}

focus_single_restored_agent() {
    jq '
        .workspace.windows[0].activeWorklaneID = "worklane-second-agent" |
        .restoreDraftWindows[0].paneDrafts |= map(select(.paneID == "pane-agent-two"))
    ' "${state_dir}/restore-snapshot.json" >"${state_dir}/restore-snapshot.focused"
    mv -- "${state_dir}/restore-snapshot.focused" "${state_dir}/restore-snapshot.json"
}

assert_completed_restore_shell() {
    local pane_id="$1"
    local prior_recovery="${2:-forbidden}"
    zentty_product_wait_for_log "${log}" \
        "zentty-linux: agent-restore-launch pane=${pane_id} result=completed fallback=shell" \
        "completed restore for ${pane_id} did not return to a shell" ||
        fail "completed restore shell fallback missing for ${pane_id}"
    if [[ "${prior_recovery}" == allowed ]]; then
        [[ "$(grep -Fc "zentty-linux: restore-failure pane=${pane_id} state=shown" "${log}")" -eq 1 ]] ||
            fail "retried restore did not retain exactly one initial recovery presentation"
    elif grep -Fq "zentty-linux: restore-failure pane=${pane_id} state=shown" "${log}"; then
        fail "completed restore incorrectly presented recovery controls"
    fi
    zentty_product_wait_for_log "${log}" \
        "zentty-linux: shell-signal pane=${pane_id} kind=pane-root-pid event=attach" \
        "replacement shell for ${pane_id} did not attach through the real PTY" ||
        fail "completed restore replacement shell missing for ${pane_id}"
    zentty_product_wait_for_log "${log}" \
        'zentty-linux: topology=worklane-main[title=Nimbu API,color=blue]:pane-agent,pane-shell,pane-ordinary-inactive|worklane-second-agent[title=Second agent,color=none]:pane-agent-two*|worklane-active[title=Active shell,color=none]:pane-shell-active' \
        "completed restore changed the durable workspace topology" ||
        fail "completed restore erased a pane or worklane"
}

if [[ "${ZENTTY_CODEX_ALIAS_RESTORE_ONLY:-false}" == true ]]; then
    agent_sessions='session-codex,session-two,Consulting Client'
    agent_start_delay=30
    agent_start_receipt="$(mktemp)"
    start_product
    zentty_product_prepare_input "${backend}" "${log}" ||
        fail "could not prepare Codex alias input"
    zentty_product_type "${backend}" "codex resume 'Consulting Client'"
    zentty_product_key "${backend}" Return
    zentty_product_wait_for_log "${log}" \
        'zentty-linux: shell-signal pane=pane-shell-active kind=shell-state state=running command-present=true' \
        "physical Codex alias submission did not cross the shell boundary" ||
        fail "Codex alias shell submission missing"
    zentty_product_wait_for_log "${agent_start_receipt}" \
        'Consulting Client' \
        "managed Codex wrapper did not receive the alias as one argument" ||
        fail "Codex alias wrapper launch missing"
    for _ in {1..100}; do
        jq -e '
            any(.restoreDraftWindows[0].paneDrafts[]?;
                .paneID == "pane-shell-active" and
                .sessionID == "Consulting Client" and
                .agentLaunchSnapshot.arguments == ["codex", "resume", "Consulting Client"])
        ' "${state_dir}/restore-snapshot.json" >/dev/null 2>&1 && break
        sleep 0.05
    done
    jq -e '
        any(.restoreDraftWindows[0].paneDrafts[]?;
            .paneID == "pane-shell-active" and
            .sessionID == "Consulting Client" and
            .agentLaunchSnapshot.arguments == ["codex", "resume", "Consulting Client"])
    ' "${state_dir}/restore-snapshot.json" >/dev/null ||
        fail "live snapshot did not persist the unresolved Codex alias"

    zentty_product_ctrl_key "${backend}" Tab
    zentty_product_wait_for_log "${log}" \
        'zentty-linux: topology=worklane-main[title=Nimbu API,color=blue]' \
        "physical traversal did not leave the provisional alias worklane" ||
        fail "Codex alias worklane did not become inactive"
    zentty_product_close_window "${backend}"
    wait_for_product_exit
    jq -e '
        .reason == "cleanExit" and
        any(.restoreDraftWindows[0].paneDrafts[]?;
            .paneID == "pane-shell-active" and
            .sessionID == "Consulting Client")
    ' "${state_dir}/restore-snapshot.json" >/dev/null ||
        fail "first clean close lost the unresolved Codex alias"

    : >"${agent_start_receipt}"
    start_product
    zentty_product_wait_for_log "${log}" \
        'zentty-linux: topology=worklane-main[title=Nimbu API,color=blue]' \
        "first lazy alias relaunch did not preserve the active worklane" ||
        fail "first lazy alias relaunch changed focus"
    grep -Fq 'Consulting Client' "${agent_start_receipt}" &&
        fail "unvisited alias materialized while lazy restore was enabled"
    zentty_product_prepare_input "${backend}" "${log}" ||
        fail "could not prepare first lazy alias close"
    zentty_product_close_window "${backend}"
    wait_for_product_exit
    jq -e '
        .reason == "cleanExit" and
        any(.restoreDraftWindows[0].paneDrafts[]?;
            .paneID == "pane-shell-active" and
            .sessionID == "Consulting Client")
    ' "${state_dir}/restore-snapshot.json" >/dev/null ||
        fail "unvisited relaunch lost the unresolved Codex alias"

    : >"${agent_start_receipt}"
    start_product
    zentty_product_prepare_input "${backend}" "${log}" ||
        fail "could not prepare second alias reveal"
    for _ in pane-shell pane-ordinary-inactive pane-agent-two pane-shell-active; do
        zentty_product_ctrl_key "${backend}" Tab
    done
    zentty_product_wait_for_log "${agent_start_receipt}" \
        'Consulting Client' \
        "visiting the preserved pane did not relaunch the Codex alias" ||
        fail "preserved Codex alias launch missing"
    zentty_product_close_window "${backend}"
    wait_for_product_exit
    printf 'rust-session-restore: PASS codex-alias provisional=durable canonical=optional unvisited-relaunches=2 argv=structural\n'
    exit 0
fi

if [[ "${ZENTTY_UNVISITED_RESTORE_ONLY:-false}" == true ]]; then
    # Reproduce the product failure in which a hidden restored pane receives
    # its initial shell title before the delayed agent hook authenticates. A
    # clean shutdown must retain the accepted draft rather than snapshotting
    # that incidental shell projection as the pane's durable intent.
    agent_start_delay=5
    start_product
    zentty_product_wait_for_log "${log}" \
        'zentty-linux: surface-owned pane=pane-agent-two live=4' \
        "hidden restored pane did not create its real Ghostty surface" ||
        fail "hidden restored pane readiness missing"
    grep -Fq 'zentty-linux: agent-event pane=pane-agent-two' "${log}" &&
        fail "delayed hidden agent authenticated before the first clean close"
    zentty_product_prepare_input "${backend}" "${log}" ||
        fail "could not prepare first clean-close input"
    zentty_product_close_window "${backend}"
    wait_for_product_exit
    jq -e '
        .reason == "cleanExit" and
        ([.restoreDraftWindows[0].paneDrafts[].sessionID] | sort) ==
            ["session-codex", "session-two"]
    ' "${state_dir}/restore-snapshot.json" >/dev/null ||
        fail "first unvisited clean close lost an accepted agent restore draft"

    agent_start_delay=0
    start_product
    zentty_product_prepare_input "${backend}" "${log}" ||
        fail "could not prepare first reveal input"
    zentty_product_ctrl_key "${backend}" Tab
    zentty_product_wait_for_log "${log}" \
        'zentty-linux: terminal-ready-pane=pane-agent' \
        "first preserved agent pane was not realized on visit" ||
        fail "first preserved agent reveal missing"
    for _ in pane-shell pane-ordinary-inactive pane-agent-two; do
        zentty_product_ctrl_key "${backend}" Tab
    done
    zentty_product_wait_for_log "${log}" \
        'zentty-linux: terminal-ready-pane=pane-agent-two' \
        "second preserved agent pane was not realized on visit" ||
        fail "second preserved agent reveal missing"
    wait_for_agent_count 2
    zentty_product_wait_for_log "${log}" \
        'zentty-linux: agent-event pane=pane-agent worklane=worklane-main' \
        "first preserved agent did not authenticate" ||
        fail "first preserved agent authentication missing"
    zentty_product_wait_for_log "${log}" \
        'zentty-linux: agent-event pane=pane-agent-two worklane=worklane-second-agent' \
        "second preserved agent did not authenticate" ||
        fail "second preserved agent authentication missing"
    zentty_product_close_window "${backend}"
    wait_for_product_exit

    start_product
    zentty_product_prepare_input "${backend}" "${log}" ||
        fail "could not prepare second reveal input"
    zentty_product_ctrl_key "${backend}" Tab
    zentty_product_wait_for_log "${log}" \
