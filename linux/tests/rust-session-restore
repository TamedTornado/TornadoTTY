zentty_product_prepare_input "${backend}" "${log}" || fail "could not prepare relaunch input"
sleep 0.2
zentty_product_close_window "${backend}"
wait_for_product_exit
[[ "$(grep -Fc 'resume:session-codex' "${agent_receipt}" || true)" -eq 2 ]] ||
