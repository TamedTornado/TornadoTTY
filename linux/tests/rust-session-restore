#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
product="${ZENTTY_LINUX_BINARY:-${repo_root}/build/linux/bin/zentty-linux}"
ghostty_root="${GHOSTTY_SOURCE_DIR:-${repo_root}/build/linux-deps/ghostty}"
backend="${GDK_BACKEND:-}"
fixture="${repo_root}/crates/zentty-core/tests/fixtures/session-restore-v3.json"

fail() {
    [[ -z "${first_log:-}" || ! -f "${first_log}" ]] || cat "${first_log}" >&2
    [[ -z "${second_log:-}" || ! -f "${second_log}" ]] || cat "${second_log}" >&2
    [[ -z "${agent_receipt:-}" || ! -f "${agent_receipt}" ]] || {
        echo "rust-session-restore: agent receipt:" >&2
        cat "${agent_receipt}" >&2
    }
    echo "rust-session-restore: error: $*" >&2
    exit 1
}

[[ "${backend}" == wayland || "${backend}" == x11 ]] ||
    fail "GDK_BACKEND must be wayland or x11"
if [[ "${backend}" == wayland ]]; then
    [[ "${ZENTTY_NESTED_WAYLAND_SESSION_ID:-}" =~ ^[0-9a-f]{64}$ ]] ||
        fail "Wayland restore must run through linux/tests/nested-wayland"
else
    [[ "${ZENTTY_NESTED_X11_SESSION_ID:-}" =~ ^[0-9a-f]{64}$ ]] ||
        fail "X11 restore must run through linux/tests/nested-x11"
fi
for dependency in jq readelf timeout mktemp grep; do
    command -v "${dependency}" >/dev/null || fail "${dependency} is required"
done
[[ -x "${product}" ]] || fail "delivered Rust product is not built: ${product}"
[[ -f "${ghostty_root}/zig-out/lib/libghostty-gtk-embed.so" ]] ||
    fail "pinned Ghostty library is not built"

layer_runpath="$(
    readelf -d "${ghostty_root}/zig-out/lib/libghostty-gtk-embed.so" |
        sed -n 's/.*Library runpath: \[\([^]]*\)\].*/\1/p' |
        cut -d: -f1
)"
[[ "${layer_runpath}" == .zig-cache/* ]] || fail "Ghostty layer-shell runpath is missing"
layer_directory="${ghostty_root}/${layer_runpath}"

state_dir="$(mktemp -d)"
first_log="$(mktemp)"
second_log="$(mktemp)"
fake_bin="$(mktemp -d)"
agent_receipt="$(mktemp)"
trap 'rm -rf -- "${state_dir}" "${fake_bin}"; rm -f -- "${first_log}" "${second_log}" "${agent_receipt}"' EXIT
cat >"${fake_bin}/codex" <<'SCRIPT'
#!/usr/bin/env bash
set -euo pipefail
has_hook=false
resume_session=""
arguments=("$@")
for ((index = 0; index < ${#arguments[@]}; index++)); do
    [[ "${arguments[index]}" == hooks.SessionStart=* ]] && has_hook=true
    if [[ "${arguments[index]}" == resume && $((index + 1)) -lt ${#arguments[@]} ]]; then
        resume_session="${arguments[index + 1]}"
    fi
done
${has_hook} || { echo "fake-codex: ephemeral SessionStart hook missing" >&2; exit 64; }
[[ "${resume_session}" == session-codex ]] || {
    echo "fake-codex: expected resume session-codex, got ${resume_session:-none}" >&2
    exit 64
}
printf 'resume:%s\n' "${resume_session}" >>"${ZENTTY_RESTORE_AGENT_RECEIPT}"
printf '%s' '{"hook_event_name":"SessionStart","session_id":"session-codex"}' |
    "${ZENTTY_CLI_BIN}" ipc agent-event --adapter=codex session-start
sleep 30
SCRIPT
chmod 700 "${fake_bin}/codex"
jq '
    .workspace.windows[0].worklanes[0].nextPaneNumber = 4 |
    .workspace.windows[0].worklanes[0].columns += [{
        "id": "column-right",
        "width": 320,
        "focusedPaneID": "pane-review",
        "lastFocusedPaneID": "pane-review",
        "paneHeights": [700],
        "panes": [{
            "id": "pane-review",
            "customTitle": "Review",
            "workingDirectory": "/tmp/project"
        }]
    }]
' "${fixture}" >"${state_dir}/restore-snapshot.json"

run_product() {
    local receipt="$1"
    set +e
    timeout --foreground --kill-after=2s 20s \
        env PATH="${fake_bin}:${PATH}" \
        ZENTTY_RESTORE_AGENT_RECEIPT="${agent_receipt}" \
        LD_LIBRARY_PATH="${ghostty_root}/zig-out/lib:${layer_directory}${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}" \
        "${product}" \
        --state-directory "${state_dir}" \
        --exercise-agent-restore \
        --quit-after-agent-restore >"${receipt}" 2>&1
    local status=$?
    set -e
    if (( status != 0 )); then
        cat "${receipt}" >&2
        fail "product restore run exited ${status}"
    fi
}

run_product "${first_log}"
[[ "$(grep -Fc 'resume:session-codex' "${agent_receipt}" || true)" -eq 1 ]] ||
    fail "first launch did not execute exactly one restored Codex session"
grep -F 'zentty-linux: agent-resume-launch pane=pane-agent command=codex resume session-codex' \
    "${first_log}" >/dev/null || fail "first launch did not route the resume command to its saved pane"

snapshot="${state_dir}/restore-snapshot.json"
lifecycle="${state_dir}/restore-lifecycle.json"
[[ -f "${snapshot}" && -f "${lifecycle}" ]] || fail "clean shutdown did not publish both state files"
jq -e '
    .reason == "cleanExit" and
    .workspace.schemaVersion == 3 and
    .workspace.activeWindowID == "window-main" and
    (.workspace.windows | length == 1) and
    (.workspace.windows[0].frame.width == 1720) and
    (.workspace.windows[0].worklanes[] | select(.id == "worklane-main") |
        .bookmarkOriginID == "bookmark-main" and
        (.columns | length) == 2 and
        .columns[0].paneHeights == [420, 280] and
        .columns[0].panes[0].lastRunCommand == "cargo test" and
        .columns[1].id == "column-right" and
        .columns[1].width == 320 and
        .columns[1].paneHeights == [700] and
        .columns[1].panes[0].id == "pane-review") and
    (.restoreDraftWindows[0].paneDrafts[0].sessionID == "session-codex")
' "${snapshot}" >/dev/null || fail "persisted source envelope lost metadata or product mutations"
jq -e '.cleanExit == true' "${lifecycle}" >/dev/null || fail "clean lifecycle marker was not written"

run_product "${second_log}"
resume_count="$(grep -Fc 'resume:session-codex' "${agent_receipt}" || true)"
[[ "${resume_count}" -eq 2 ]] ||
    fail "relaunch did not execute exactly one fresh restored Codex session (cumulative count=${resume_count})"
grep -F 'zentty-linux: agent-resume-launch pane=pane-agent command=codex resume session-codex' \
    "${second_log}" >/dev/null || fail "relaunch did not route the resume command to its saved pane"
grep -F 'zentty-linux: topology=worklane-main[title=Nimbu API,color=blue]:pane-agent,pane-shell,pane-review' \
    "${second_log}" >/dev/null || {
    cat "${second_log}" >&2
    fail "relaunch did not render the exact saved worklane and pane identities before mutation"
}
grep -F 'zentty-linux: geometry=worklane-main:column-left[pane-agent,pane-shell],column-right[pane-review]' \
    "${second_log}" >/dev/null || {
    cat "${second_log}" >&2
    fail "relaunch did not render the exact saved horizontal and vertical pane geometry"
}
grep -F 'zentty-linux: sidebar-card id=worklane-main panes=3 active=true title=Some("Nimbu API")' \
    "${second_log}" >/dev/null || fail "relaunch did not render restored source sidebar metadata"
grep -F 'zentty-linux: agent-restore-scenario verified drafts=1' \
    "${second_log}" >/dev/null || fail "relaunch did not authenticate the resumed agent session"

echo "Rust session restore passed: ${backend}, source-envelope=preserved, agent-resume=real-process, relaunch=real"
