#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
artifact="${1:?usage: debian-package-build-test ARTIFACT EXPANDED_MANIFEST}"
manifest="${2:?usage: debian-package-build-test ARTIFACT EXPANDED_MANIFEST}"
audit="${repo_root}/linux/tests/debian-package-audit"
temporary="$(mktemp -d)"
trap 'rm -rf -- "${temporary}"' EXIT

extract_package() {
    local name="$1"
    rm -rf -- "${temporary:?}/${name}"
    mkdir -p -- "${temporary}/${name}"
    dpkg-deb -x "${artifact}" "${temporary}/${name}"
    dpkg-deb -e "${artifact}" "${temporary}/${name}/DEBIAN"
}

expect_rejected() {
    local name="$1" expected="$2" candidate_manifest="${3:-${manifest}}"
    if "${audit}" "${temporary}/${name}" "${candidate_manifest}" >"${temporary}/${name}.log" 2>&1; then
        echo "debian-package-build-test: ${name} unexpectedly passed" >&2
        exit 1
    fi
    grep -Fq "${expected}" "${temporary}/${name}.log" || {
        cat "${temporary}/${name}.log" >&2
        echo "debian-package-build-test: ${name} lacked expected failure" >&2
        exit 1
    }
}

[[ -f "${artifact}" && -f "${manifest}" ]] || {
    echo "debian-package-build-test: artifact and manifest are required" >&2
    exit 1
}
[[ "$(dpkg-deb -f "${artifact}" Package)" == tornadotty ]]
[[ "$(dpkg-deb -f "${artifact}" Architecture)" == amd64 ]]
dpkg-deb --info "${artifact}" >/dev/null
dpkg-deb --contents "${artifact}" >/dev/null

extract_package positive
"${audit}" "${temporary}/positive" "${manifest}" >/dev/null
ZENTTY_BUILD_DIR="${temporary}/positive/usr/lib/tornadotty" \
    "${repo_root}/linux/tests/abi-surface" >/dev/null
LD_LIBRARY_PATH="${temporary}/positive/usr/lib/tornadotty/lib" \
    "${temporary}/positive/usr/lib/tornadotty/bin/tornadotty" --help \
    >"${temporary}/gui-help"
grep -Fxq 'Usage: tornadotty [OPTIONS]' "${temporary}/gui-help" ||
    fail "packaged GUI help uses the wrong public executable name"
set +e
"${temporary}/positive/usr/lib/tornadotty/bin/tornadotty-cli" \
    >"${temporary}/cli-stdout" 2>"${temporary}/cli-stderr"
cli_status=$?
set -e
[[ "${cli_status}" -ne 0 && ! -s "${temporary}/cli-stdout" ]] ||
    fail "packaged CLI usage did not take its expected error path"
grep -Fxq \
    'tornadotty-cli: usage: tornadotty-cli ipc <agent-event|agent-signal|agent-status> [arguments...]' \
    "${temporary}/cli-stderr" || fail "packaged CLI usage leaks an obsolete executable name"
(
    cd "${temporary}/positive"
    md5sum --check --strict DEBIAN/md5sums >/dev/null
)

extract_package missing-rename-metadata
sed -i '/^Replaces: zentty$/d' "${temporary}/missing-rename-metadata/DEBIAN/control"
expect_rejected missing-rename-metadata "legacy package replacement is missing"

extract_package undeclared
install -m 0644 /dev/null "${temporary}/undeclared/usr/lib/tornadotty/unexpected.a"
expect_rejected undeclared "expanded manifest and payload differ"

extract_package missing-license
rm "${temporary}/missing-license/usr/share/doc/tornadotty/copyright"
expect_rejected missing-license "expanded manifest and payload differ"

extract_package missing-third-party-notice
rm "${temporary}/missing-third-party-notice/usr/share/doc/tornadotty/third-party/ghostty/ghostty-LICENSE"
expect_rejected missing-third-party-notice "expanded manifest and payload differ"

extract_package wrong-mode
chmod 0777 "${temporary}/wrong-mode/usr/lib/tornadotty/bin/tornadotty-cli"
expect_rejected wrong-mode "payload mode drift"

extract_package duplicate-cli
duplicate_cli="${temporary}/duplicate-cli/usr/lib/tornadotty/libexec/zentty/agent-wrappers/shared/zentty"
install -D -m 0755 \
    "${temporary}/duplicate-cli/usr/lib/tornadotty/bin/tornadotty-cli" \
    "${duplicate_cli}"
duplicate_cli_manifest="${temporary}/duplicate-cli-manifest.json"
jq --arg sha "$(sha256sum "${duplicate_cli}" | awk '{print $1}')" \
    '.files += [{path:"/usr/lib/tornadotty/libexec/zentty/agent-wrappers/shared/zentty",
      type:"file",mode:"755",owner_component:"negative-fixture",sha256:$sha}]' \
    "${manifest}" >"${duplicate_cli_manifest}"
expect_rejected duplicate-cli "duplicate wrapper-owned TornadoTTY CLI executable is forbidden" \
    "${duplicate_cli_manifest}"

extract_package path-leak
printf '\n/home/builder/Projects/zentty/build/private\n' >> \
    "${temporary}/path-leak/usr/share/applications/com.tamedtornado.tornadotty.desktop"
path_manifest="${temporary}/path-leak-manifest.json"
path_sha="$(sha256sum "${temporary}/path-leak/usr/share/applications/com.tamedtornado.tornadotty.desktop" | awk '{print $1}')"
jq --arg sha "${path_sha}" '(.files[] | select(.path == "/usr/share/applications/com.tamedtornado.tornadotty.desktop") | .sha256) = $sha' \
    "${manifest}" >"${path_manifest}"
expect_rejected path-leak "source or build path leaked" "${path_manifest}"

extract_package bad-runpath
patchelf --set-rpath /tmp/build-tree \
    "${temporary}/bad-runpath/usr/lib/tornadotty/lib/libghostty-gtk-embed.so"
runpath_manifest="${temporary}/bad-runpath-manifest.json"
runpath_sha="$(sha256sum "${temporary}/bad-runpath/usr/lib/tornadotty/lib/libghostty-gtk-embed.so" | awk '{print $1}')"
jq --arg sha "${runpath_sha}" '(.files[] | select(.path == "/usr/lib/tornadotty/lib/libghostty-gtk-embed.so") | .sha256) = $sha' \
    "${manifest}" >"${runpath_manifest}"
expect_rejected bad-runpath "Ghostty RUNPATH is not install-relative" "${runpath_manifest}"

extract_package credential
printf '\napi_key=not-a-real-secret-fixture\n' >> \
    "${temporary}/credential/usr/share/applications/com.tamedtornado.tornadotty.desktop"
credential_manifest="${temporary}/credential-manifest.json"
credential_sha="$(sha256sum "${temporary}/credential/usr/share/applications/com.tamedtornado.tornadotty.desktop" | awk '{print $1}')"
jq --arg sha "${credential_sha}" '(.files[] | select(.path == "/usr/share/applications/com.tamedtornado.tornadotty.desktop") | .sha256) = $sha' \
    "${manifest}" >"${credential_manifest}"
expect_rejected credential "credential-shaped content in payload" "${credential_manifest}"

forbidden_file="${temporary}/forbidden-static/usr/lib/tornadotty/unexpected.a"
extract_package forbidden-static
install -m 0644 /dev/null "${forbidden_file}"
forbidden_manifest="${temporary}/forbidden-static-manifest.json"
jq --arg sha "$(sha256sum "${forbidden_file}" | awk '{print $1}')" \
    '.files += [{path:"/usr/lib/tornadotty/unexpected.a",type:"file",mode:"644",
      owner_component:"negative-fixture",sha256:$sha}]' \
    "${manifest}" >"${forbidden_manifest}"
expect_rejected forbidden-static "forbidden payload file" "${forbidden_manifest}"

echo "debian-package-build-test: PASS structural=real negatives=undeclared+license+third-party-license+mode+duplicate-cli+path+runpath+credential+static-archive"
