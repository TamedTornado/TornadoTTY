#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
binary="${repo_root}/build/linux/bin/zentty-linux"
receipt="${repo_root}/build/linux/physical-key-x11.log"

GDK_BACKEND=x11 \
ZENTTY_LINUX_PHYSICAL_KEY_TEST=1 \
ZENTTY_LINUX_ASYNC_BACKEND=epoll \
    "${binary}" >"${receipt}" 2>&1 &
host_pid=$!
cleanup() {
    kill "${host_pid}" 2>/dev/null || true
    wait "${host_pid}" 2>/dev/null || true
}
trap cleanup EXIT

window_id=""
for _ in $(seq 1 200); do
    window_id="$(xdotool search --name '^Zentty Linux$' 2>/dev/null | head -n 1 || true)"
    if [[ -n "${window_id}" ]] &&
        grep -F "zentty-linux: physical key input ready" "${receipt}" >/dev/null 2>&1; then
        break
    fi
    sleep 0.05
done
if [[ -z "${window_id}" ]]; then
    echo "error: Zentty window was not discoverable for key injection" >&2
    cat "${receipt}" >&2
    exit 1
fi
grep -F "zentty-linux: physical key input ready" "${receipt}" >/dev/null || {
    echo "error: Zentty did not establish terminal input focus" >&2
    cat "${receipt}" >&2
    exit 1
}

xdotool windowfocus --sync "${window_id}"
sleep 0.1
xdotool type --window "${window_id}" --delay 20 'zentty-physical-key'
xdotool key --window "${window_id}" Return

set +e
timeout 20s tail --pid="${host_pid}" -f /dev/null
tail_status=$?
set -e
if [[ "${tail_status}" -ne 0 ]]; then
    echo "error: Zentty did not acknowledge physical key events" >&2
    cat "${receipt}" >&2
    exit 1
fi
wait "${host_pid}"
trap - EXIT

grep -F "zentty-linux: terminal output acknowledged index=0" "${receipt}" >/dev/null
grep -F "zentty-linux: integration PASS surfaces=1" "${receipt}" >/dev/null
echo "Zentty Linux physical X11 key translation passed"
