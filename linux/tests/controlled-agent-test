#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
actor="${repo_root}/linux/tests/fixtures/controlled-agent"
temp_dir="$(mktemp -d)"
helper="${temp_dir}/zentty"
calls="${temp_dir}/calls"
payloads="${temp_dir}/payloads"
receipt="${temp_dir}/receipt"
trap 'rm -rf -- "${temp_dir}"' EXIT

fail() {
    echo "controlled-agent-test: $*" >&2
    exit 1
}

cat >"${helper}" <<'HELPER'
#!/usr/bin/env bash
set -euo pipefail
printf '%s\n' "$*" >>"${CONTROLLED_HELPER_CALLS}"
if [[ "${1:-}" == ipc ]]; then
    cat >>"${CONTROLLED_HELPER_PAYLOADS}"
fi
printf '\n' >>"${CONTROLLED_HELPER_PAYLOADS}"
HELPER
chmod 700 "${helper}"
: >"${calls}"
: >"${payloads}"

run_actor() {
    env \
        CONTROLLED_HELPER_CALLS="${calls}" \
        CONTROLLED_HELPER_PAYLOADS="${payloads}" \
        ZENTTY_CLI_BIN="${helper}" \
        ZENTTY_CONTROLLED_AGENT_SLEEP_SECONDS=0 \
        "$@"
}

start_gate="${temp_dir}/start-{pane}.gate"
calls_before="$(wc -l <"${calls}" 2>/dev/null || true)"
run_actor ZENTTY_CONTROLLED_AGENT_PROFILE=codex-notify \
    ZENTTY_CONTROLLED_AGENT_START_GATE="${start_gate}" \
    ZENTTY_PANE_ID=pane-test \
    "${actor}" -c 'notify=["/stage/bin/zentty","codex-notify"]' &
gated_actor_pid=$!
sleep 0.1
[[ "$(wc -l <"${calls}" 2>/dev/null || true)" -eq "${calls_before}" ]] ||
    fail "controlled start gate allowed an early helper call"
touch "${start_gate/\{pane\}/pane-test}"
wait "${gated_actor_pid}"
[[ "$(wc -l <"${calls}")" -eq $((calls_before + 1)) ]] ||
    fail "controlled start gate did not release exactly one helper call"
if run_actor ZENTTY_CONTROLLED_AGENT_PROFILE=codex-notify \
    ZENTTY_CONTROLLED_AGENT_START_GATE="${start_gate}" \
    ZENTTY_PANE_ID='../unsafe' \
    "${actor}" -c 'notify=["/stage/bin/zentty","codex-notify"]' \
    >"${temp_dir}/unsafe-gate.log" 2>&1; then
    fail "pane-scoped start gate accepted an unsafe pane ID"
fi
grep -Fq 'pane-scoped start gate requires a safe ZENTTY_PANE_ID' \
    "${temp_dir}/unsafe-gate.log" || fail "unsafe start gate lacked its exact diagnostic"

run_actor ZENTTY_CONTROLLED_AGENT_PROFILE=codex-permission "${actor}" \
    -c 'hooks.PermissionRequest=["command"]' -c 'hooks.state={"key":"value"}' \
    -c 'notify=["/stage/bin/zentty","codex-notify"]'
grep -Fxq 'ipc agent-event --adapter=codex' "${calls}" ||
    fail "Codex permission profile did not call the real helper contract"
grep -Fq '"hook_event_name":"PermissionRequest"' "${payloads}" ||
    fail "Codex permission profile emitted the wrong payload"

run_actor ZENTTY_CONTROLLED_AGENT_PROFILE=claude-question "${actor}" \
    --settings '{"hooks":{"PermissionRequest":"zentty ipc agent-event --adapter=claude"}}'
grep -Fxq 'ipc agent-event --adapter=claude PreToolUse' "${calls}" ||
    fail "Claude question profile did not call the real helper contract"
grep -Fq '"tool_name":"AskUserQuestion"' "${payloads}" ||
    fail "Claude question profile emitted the wrong payload"

run_actor ZENTTY_CONTROLLED_AGENT_PROFILE=claude-lifecycle "${actor}" \
    --settings '{"hooks":{"SessionStart":"zentty ipc agent-event --adapter=claude","PermissionRequest":"zentty ipc agent-event --adapter=claude"}}'
grep -Fq '"hook_event_name":"Stop"' "${payloads}" ||
    fail "Claude lifecycle profile did not emit Stop"
grep -Fq '"message":"Claude is waiting for your input"' "${payloads}" ||
    fail "Claude lifecycle profile did not emit the late generic notification"
grep -Fq '"message":"Allow release command?"' "${payloads}" ||
    fail "Claude lifecycle profile did not emit the explicit approval after the race"
grep -Fq '"label":"Staging"' "${payloads}" ||
    fail "Claude lifecycle profile did not preserve question options"

run_actor \
    ZENTTY_CONTROLLED_AGENT_PROFILE=codex-notify \
    "${actor}" -c 'notify=["/stage/bin/zentty","codex-notify"]'
grep -Fxq 'codex-notify {"type":"question","session_id":"codex-notify-e2e","message":"Choose execution mode?\n[Sandboxed] [Elevated]"}' "${calls}" ||
    fail "Codex notify profile did not call the source-compatible helper command"

run_actor ZENTTY_CONTROLLED_AGENT_PROFILE=codex-title "${actor}" \
    -c 'hooks.PreToolUse=["command"]'
grep -Fxq 'ipc agent-event --adapter=codex' "${calls}" ||
    fail "Codex title profile did not establish a canonical running session"

title_transcript="${temp_dir}/title-transcript.jsonl"
run_actor \
    ZENTTY_CONTROLLED_AGENT_PROFILE=codex-title-transcript \
    ZENTTY_CONTROLLED_CODEX_TRANSCRIPT="${title_transcript}" \
    "${actor}" -c 'hooks.PreToolUse=["command"]' >/dev/null
grep -Fq '"session_id":"codex-title-transcript-e2e"' "${payloads}" ||
    fail "Codex title-transcript profile did not establish its canonical session"
grep -Fq '"question":"Choose the integration scope"' "${title_transcript}" ||
    fail "Codex title-transcript profile did not flush the delayed real transcript"

pending_transcript="${temp_dir}/pending-transcript.jsonl"
run_actor \
    ZENTTY_CONTROLLED_AGENT_PROFILE=codex-title-transcript-pending \
    ZENTTY_CONTROLLED_CODEX_TRANSCRIPT="${pending_transcript}" \
    ZENTTY_CONTROLLED_AGENT_PENDING_ONESHOT=true \
    "${actor}" -c 'hooks.PreToolUse=["command"]' >/dev/null
grep -Fq '"session_id":"codex-title-transcript-pending-e2e"' "${payloads}" ||
    fail "pending transcript profile did not establish its canonical session"
[[ ! -e "${pending_transcript}" ]] ||
    fail "pending transcript profile unexpectedly created enrichment input"

run_actor ZENTTY_CONTROLLED_AGENT_PROFILE=codex-progress "${actor}" \
    -c 'hooks.PreToolUse=["command"]' >/dev/null
grep -Fq '"session_id":"codex-progress-e2e"' "${payloads}" ||
    fail "Codex progress profile did not establish its canonical session"

printf '\n' | run_actor \
    ZENTTY_CONTROLLED_AGENT_PROFILE=codex-lifecycle \
    ZENTTY_CONTROLLED_AGENT_LIFECYCLE_ONESHOT=true \
    "${actor}" -c 'notify=["/stage/bin/zentty","codex-notify"]'
grep -Fq '"message":"Submit this answer?"' "${calls}" ||
    fail "Codex lifecycle profile did not emit its pre-submit question"
grep -Fq '"message":"Interrupt this run?"' "${calls}" ||
    fail "Codex lifecycle profile did not emit its pre-interrupt question"
grep -Fq '"type":"agent-turn-complete"' "${calls}" ||
    fail "Codex lifecycle profile did not emit its stale idle signal"
grep -Fq '"hook_event_name":"PreToolUse"' "${payloads}" ||
    fail "Codex lifecycle profile did not emit recovery activity"

gemini_settings="${temp_dir}/gemini-settings.json"
cat >"${gemini_settings}" <<EOF
{"general":{"enableNotifications": true},"hooks":{"Notification":[{"hooks":[{"command":"${helper} ipc agent-event --adapter=gemini"}]}]}}
EOF
run_actor \
    ZENTTY_CONTROLLED_AGENT_PROFILE=gemini-permission \
    GEMINI_CLI_SYSTEM_SETTINGS_PATH="${gemini_settings}" \
    "${actor}"
grep -Fxq 'ipc agent-event --adapter=gemini' "${calls}" ||
    fail "Gemini permission profile did not call the real helper contract"
grep -Fq '"notification_type":"ToolPermission"' "${payloads}" ||
    fail "Gemini permission profile emitted the wrong payload"

run_actor \
    ZENTTY_CONTROLLED_AGENT_PROFILE=codex-restore \
    ZENTTY_CONTROLLED_AGENT_SESSIONS=session-one \
    ZENTTY_CONTROLLED_AGENT_RECEIPT="${receipt}" \
    "${actor}" resume -c 'hooks.SessionStart=["command"]' session-one >/dev/null
grep -Eq '^resume:session-one pid:[0-9]+$' "${receipt}" ||
    fail "Codex restore profile did not preserve the exact final session argument"
grep -Fxq 'ipc agent-event --adapter=codex session-start' "${calls}" ||
    fail "Codex restore profile did not send SessionStart"

shell_boundary="$({
    run_actor \
        ZENTTY_CONTROLLED_AGENT_PROFILE=shell-boundary \
        ZENTTY_PANE_ID=pane-shell ZENTTY_WORKLANE_ID=lane-shell \
        "${actor}" --zentty-shell-probe 'space and λ'
})"
grep -Fqx 'argument=<--zentty-shell-probe>' <<<"${shell_boundary}" ||
    fail "shell boundary profile lost the option argument"
grep -Fqx 'argument=<space and λ>' <<<"${shell_boundary}" ||
    fail "shell boundary profile lost the hostile argument"
grep -Fqx 'pane=pane-shell' <<<"${shell_boundary}" ||
    fail "shell boundary profile lost pane identity"
grep -Fqx 'worklane=lane-shell' <<<"${shell_boundary}" ||
    fail "shell boundary profile lost worklane identity"

if run_actor ZENTTY_CONTROLLED_AGENT_PROFILE=codex-permission "${actor}" >/dev/null 2>&1; then
    fail "Codex permission profile accepted missing ephemeral hooks"
fi
if run_actor \
    ZENTTY_CONTROLLED_AGENT_PROFILE=codex-restore \
    ZENTTY_CONTROLLED_AGENT_SESSIONS=session-one \
    ZENTTY_CONTROLLED_AGENT_RECEIPT="${receipt}" \
    "${actor}" resume -c 'hooks.SessionStart=["command"]' wrong-session >/dev/null 2>&1; then
    fail "Codex restore profile accepted an undeclared session"
fi

echo "Controlled agent tests passed: codex-permission, codex-notify, codex-title, codex-title-transcript, codex-title-transcript-pending, codex-progress, codex-lifecycle, claude-question, claude-lifecycle, gemini-permission, codex-restore, shell-boundary"
