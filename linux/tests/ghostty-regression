#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
# shellcheck source=linux/tests/lib/qualification-capacity
source "${repo_root}/linux/tests/lib/qualification-capacity"
ghostty_source="${GHOSTTY_SOURCE_DIR:-${repo_root}/build/linux-deps/ghostty}"
zig="${ZIG:-${repo_root}/../.tools/zig-x86_64-linux-0.16.0/zig}"
blueprint_dir="${BLUEPRINT_COMPILER_DIR:-${repo_root}/../.tools/blueprint-compiler-0.16.0/bin}"
zig_global_cache="${repo_root}/build/linux-deps/zig-global-cache"
zig_local_cache="${ZENTTY_ZIG_LOCAL_CACHE_DIR:-${ghostty_source}/.zig-cache}"
[[ "${zig_local_cache}" == /* ]] || zig_local_cache="${repo_root}/${zig_local_cache}"
build_jobs="${ZENTTY_BUILD_JOBS:-$(zentty_qualification_build_jobs)}"
[[ "${build_jobs}" =~ ^[1-9][0-9]*$ ]] || {
    echo "error: ZENTTY_BUILD_JOBS must be a positive integer" >&2
    exit 64
}
receipt="${repo_root}/build/linux/ghostty-regression.log"
install_dir="${ZENTTY_GHOSTTY_REGRESSION_INSTALL_DIR:-${repo_root}/build/linux-deps/ghostty-regression-out}"
if [[ "${install_dir}" != /* ]]; then
    install_dir="${repo_root}/${install_dir}"
fi
expected_revision="$(sed -n 's/^revision=//p' "${repo_root}/linux/ghostty.lock")"

if [[ ! -x "${zig}" ]]; then
    echo "error: Zig 0.16.0 not found at ${zig}" >&2
    exit 1
fi
if [[ ! -e "${ghostty_source}/.git" ]]; then
    echo "error: Ghostty checkout not found; run linux/scripts/build-local" >&2
    exit 1
fi
actual_revision="$(git -C "${ghostty_source}" rev-parse HEAD)"
if [[ "${actual_revision}" != "${expected_revision}" ]]; then
    echo "error: Ghostty checkout is ${actual_revision}; expected ${expected_revision}" >&2
    exit 1
fi
if [[ -n "$(git -C "${ghostty_source}" status --porcelain)" ]]; then
    echo "error: Ghostty regression requires a clean pinned checkout" >&2
    exit 1
fi
mkdir -p "${zig_global_cache}" "${zig_local_cache}"

(
    cd "${ghostty_source}"
    PATH="${blueprint_dir}:$(dirname "${zig}"):${PATH}" \
        ZIG_GLOBAL_CACHE_DIR="${zig_global_cache}" \
        ZIG_LOCAL_CACHE_DIR="${zig_local_cache}" \
        "${zig}" build test \
        -j"${build_jobs}" \
        --prefix "${install_dir}" \
        -Doptimize=Debug \
        -Dcpu=baseline \
        -fno-sys=gtk4-layer-shell
    PATH="${blueprint_dir}:$(dirname "${zig}"):${PATH}" \
        ZIG_GLOBAL_CACHE_DIR="${zig_global_cache}" \
        ZIG_LOCAL_CACHE_DIR="${zig_local_cache}" \
        "${zig}" build gtk-embed-lib-test \
        -j"${build_jobs}" \
        --prefix "${install_dir}" \
        -Doptimize=Debug \
        -Dcpu=baseline \
        -fno-sys=gtk4-layer-shell
) >"${receipt}" 2>&1

echo "Pinned Ghostty regression suite passed"
