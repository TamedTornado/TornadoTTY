#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
linux_main="${repo_root}/crates/zentty-linux/src/main.rs"
application_shell="${repo_root}/crates/zentty-linux/src/application_shell.rs"
matrix="${repo_root}/linux/qualification-matrix.json"
architecture="${repo_root}/docs/architecture/linux-product-architecture-v1.json"
actor="${repo_root}/linux/tests/fixtures/controlled-agent"
codex_notify_observer="${repo_root}/linux/tests/fixtures/codex-notify-observer"
controlled_anthropic="${repo_root}/crates/zentty-test-support/src/bin/controlled_anthropic.rs"
controlled_openai="${repo_root}/crates/zentty-test-support/src/bin/controlled_openai_responses.rs"
controlled_gemini="${repo_root}/crates/zentty-test-support/src/bin/controlled_gemini.rs"
wayland_input_harness="${repo_root}/linux/tests/nested-wayland-input"
failures=0

reject() {
    local message="$1"
    shift
    if "$@"; then
        echo "test-orchestration-contract: ${message}" >&2
        failures=$((failures + 1))
    fi
}

require() {
    local message="$1"
    shift
    if ! "$@" >/dev/null; then
        echo "test-orchestration-contract: ${message}" >&2
        failures=$((failures + 1))
    fi
}

for dependency in grep jq sed sort comm mktemp; do
    command -v "${dependency}" >/dev/null || {
        echo "test-orchestration-contract: ${dependency} is required" >&2
        exit 1
    }
done

reject "application shell still exports embedded schedule_* test scenarios" \
    grep -Eq 'pub\(crate\)[[:space:]]+fn schedule_[[:alnum:]_]+[[:space:]]*\(' "${application_shell}"
reject "application composition root still contains a test Scenario enum" \
    grep -Eq '^enum Scenario[[:space:]]*\{' "${linux_main}"
reject "application composition root still contains a scenario ExitPolicy" \
    grep -Eq '^enum ExitPolicy[[:space:]]*\{' "${linux_main}"

actual_options="$(mktemp)"
expected_options="$(mktemp)"
trap 'rm -f -- "${actual_options}" "${expected_options}"' EXIT
grep -Eo '"--[a-z0-9-]+"' "${linux_main}" | tr -d '"' | sort -u >"${actual_options}"
cat >"${expected_options}" <<'OPTIONS'
--async-backend
--command
--no-session-restore
--state-directory
OPTIONS
if ! diff="$(comm -3 "${expected_options}" "${actual_options}")"; then
    echo "test-orchestration-contract: product CLI differs from the reviewed non-test allowlist:" >&2
    printf '%s\n' "${diff}" >&2
    failures=$((failures + 1))
fi

require "the single reviewed deterministic agent actor is missing or not executable" \
    test -x "${actor}"
require "the installed-Codex notify observer is missing or not executable" \
    test -x "${codex_notify_observer}"
require "the reviewed Anthropic endpoint is missing" test -f "${controlled_anthropic}"
require "the reviewed OpenAI Responses endpoint is missing" test -f "${controlled_openai}"
require "the reviewed Gemini endpoint is missing" test -f "${controlled_gemini}"
require "the controlled input-capable Wayland harness is missing or not executable" \
    test -x "${wayland_input_harness}"
inline_actor_files="$({
    grep -RIl --include='*' -E 'cat[[:space:]]*>.*[/}]codex|cat[[:space:]]*>.*[/}]claude' \
        "${repo_root}/linux/tests" || true
} | grep -vFx "${actor}" || true)"
if [[ -n "${inline_actor_files}" ]]; then
    echo "test-orchestration-contract: integration tests still generate inline agent programs:" >&2
    printf '%s\n' "${inline_actor_files}" >&2
    failures=$((failures + 1))
fi
controlled_model_servers="$({
    grep -RIl --include='*.rs' --include='*' \
        -E 'CONTROLLED_[A-Z_]*READY=http://|TcpListener::bind\(\("127\.0\.0\.1"' \
        "${repo_root}/crates/zentty-test-support" "${repo_root}/linux/tests" || true
} | sort -u)"
expected_model_servers="$(printf '%s\n%s\n%s\n' "${controlled_anthropic}" "${controlled_openai}" "${controlled_gemini}" | sort -u)"
if [[ "${controlled_model_servers}" != "${expected_model_servers}" ]]; then
    echo "test-orchestration-contract: controlled-model server allowlist differs:" >&2
    printf '%s\n' "${controlled_model_servers}" >&2
    failures=$((failures + 1))
fi
require "installed Claude journey does not consume the reviewed endpoint" \
    grep -Fq 'target/release-safe/controlled_anthropic' \
    "${repo_root}/linux/tests/installed-claude-agent-team"
require "installed Codex journey does not consume the reviewed Responses endpoint" \
    grep -Fq 'target/release-safe/controlled_openai_responses' \
    "${repo_root}/linux/tests/installed-codex-integration"
require "installed Gemini journey does not consume the reviewed Gemini endpoint" \
    grep -Fq 'controlled_gemini' "${repo_root}/linux/tests/rust-agent-ipc"
require "installed Claude journey does not consume the single controlled actor" \
    grep -Fq 'linux/tests/fixtures/controlled-agent' \
    "${repo_root}/linux/tests/installed-claude-agent-team"

require "Wayland agent qualification does not name the event, tmux, installed Claude, and consolidated restore journeys" \
    jq -e '
        .cells[] | select(.id == "agent-integration-wayland") |
        .environment_profile == "nested-wayland-input-v1" and
        .command == "ZENTTY_REQUIRE_REAL_GEMINI=true ZENTTY_EXPECTED_GEMINI_VERSION=0.53.0 ZENTTY_RUN_CODEX_LIFECYCLE=true GDK_BACKEND=wayland linux/tests/rust-agent-ipc && GDK_BACKEND=wayland linux/tests/rust-tmux-compat-product && GDK_BACKEND=wayland linux/tests/installed-claude-agent-team && GDK_BACKEND=wayland linux/tests/rust-session-restore"
    ' "${matrix}"
require "X11 agent qualification does not add installed Codex and Claude to the consolidated journeys" \
    jq -e '
        .cells[] | select(.id == "agent-integration-x11") |
        .command == "ZENTTY_REQUIRE_REAL_GEMINI=true ZENTTY_EXPECTED_GEMINI_VERSION=0.53.0 ZENTTY_RUN_CODEX_LIFECYCLE=true GDK_BACKEND=x11 linux/tests/rust-agent-ipc && GDK_BACKEND=x11 linux/tests/rust-tmux-compat-product && GDK_BACKEND=x11 linux/tests/installed-codex-integration && GDK_BACKEND=x11 linux/tests/installed-claude-agent-team && GDK_BACKEND=x11 linux/tests/rust-session-restore"
    ' "${matrix}"
reject "superseded inactive-agent journey remains authoritative" \
    grep -Fq 'linux/tests/rust-inactive-agent-restore' "${matrix}"
reject "architecture contract still references the superseded inactive-agent journey" \
    grep -Fq 'linux/tests/rust-inactive-agent-restore' "${architecture}"

# The jq program is intentionally a literal rather than a shell template.
# shellcheck disable=SC2016
require "pane lifecycle family is not fully profile-pinned to distinct real product journeys" \
    jq -e '
        [.cells[] | select(.capability == "product_pane_terminal_lifecycle")] as $cells |
        ($cells | length) == 24 and
        all($cells[]; .status == "PASS") and
        all($cells[] | select(.optimize == "Debug");
            .command | contains("ZENTTY_LINUX_BINARY=build/linux-profiles/debug/bin/zentty-linux") and
            contains("ZENTTY_EXPECTED_PRODUCT_PROFILE=debug")) and
        all($cells[] | select(.optimize == "ReleaseSafe");
            .command | contains("ZENTTY_LINUX_BINARY=build/linux-profiles/release-safe/bin/zentty-linux") and
            contains("ZENTTY_EXPECTED_PRODUCT_PROFILE=release-safe")) and
        all($cells[] | select(.terminals == "single");
            (.command | contains("ZENTTY_RUST_SCENARIO=lifecycle")) and
            (.command | contains("ZENTTY_RUST_TERMINALS=1")) and
            (.command | contains("ZENTTY_RUST_CYCLES=3")) and
            (.command | contains("linux/tests/rust-product-smoke"))) and
        all($cells[] | select(.terminals == "multi");
            (.command | contains("linux/tests/rust-closed-pane-restore"))) and
        all($cells[] | select(.display == "wayland" and .terminals == "multi");
            .environment_profile == "nested-wayland-input-v1") and
        all($cells[] | select(.display == "wayland" and .terminals == "single");
            .environment_profile == "nested-wayland-v1") and
        all($cells[] | select(.display == "x11");
            .environment_profile == "nested-x11-v1")
    ' "${matrix}"

# The jq program is intentionally a literal rather than a shell template.
# shellcheck disable=SC2016
require "Rust/Ghostty adapter cells are not assigned to focused and real existing journeys" \
    jq -e '
        (.cells[] | select(.id == "rust-ghostty-api-product-usage") |
            .status == "PASS" and .display == "x11" and
            .environment_profile == "nested-x11-v1" and
            (.command | contains("linux/tests/ghostty-api-audit")) and
            (.command | contains("linux/tests/rust-closed-pane-restore")) and
            (.command | contains("linux/tests/rust-pane-search")) and
            (.command | contains("linux/tests/rust-tmux-compat-product"))) and
        (.cells[] | select(.id == "rust-ghostty-callback-drop-order") |
            .status == "PASS" and .display == "x11" and
            .environment_profile == "nested-x11-v1" and
            (.command | contains("cargo test -p zentty-ghostty --locked --doc")) and
            (.command | contains("linux/tests/rust-closed-pane-restore"))) and
        (.cells[] | select(.id == "rust-ghostty-config-construction") |
            .status == "PASS" and .display == "none" and
            .environment_profile == "isolated-none-v1" and
            (.command | contains("cargo test -p zentty-ghostty")))
    ' "${matrix}"

reject "Rust raw binding retains convenience constructors or speculative paste" \
    grep -Eq 'pub fn ghostty_gtk_embed_(runtime_new\(|surface_new\(|surface_request_paste\()' \
    "${repo_root}/crates/zentty-ghostty-sys/src/lib.rs"

# shellcheck disable=SC2016
require "Ghostty runtime-order and version-node cells are not executable real-artifact checks" \
    jq -e '
        (.cells[] | select(.id == "ghostty-runtime-initialization-order") |
            .status == "PASS" and .order == 31 and .display == "x11" and
            .environment_profile == "nested-x11-v1" and
            (.command | contains("build/linux-profiles/debug/bin/runtime-init-order")) and
            (.command | contains("linux/tests/runtime-init-order"))) and
        (.cells[] | select(.id == "ghostty-runtime-initialization-order-wayland") |
            .status == "PASS" and .order == 31 and .display == "wayland" and
            .environment_profile == "nested-wayland-v1" and
            (.command | contains("build/linux-profiles/debug/bin/runtime-init-order")) and
            (.command | contains("linux/tests/runtime-init-order"))) and
        (.cells[] | select(.id == "ghostty-abi-version-node") |
            .status == "PASS" and .display == "none" and
            .environment_profile == "isolated-none-v1" and
            (.command | contains("build/linux-profiles/release-safe/lib/libghostty-gtk-embed.so")) and
            (.command | contains("linux/tests/abi-version-node")))
    ' "${matrix}"

# shellcheck disable=SC2016
require "Ghostty old/new ABI mismatch remains prose-only or bypasses the real fixture" \
    jq -e '
        (.cells[] | select(.id == "ghostty-abi-old-new-mismatch") |
            .status == "PASS" and .display == "none" and
            .environment_profile == "isolated-none-v1" and
            (.command | contains("linux/tests/ghostty-abi-mismatch")) and
            (.command | contains("--self-test")))
    ' "${matrix}"

# shellcheck disable=SC2016
require "workspace recovery cells remain prose-only or bypass the focused real-I/O runner" \
    jq -e '
        (.cells[] | select(.id == "workspace-recovery-interrupted-write") |
            .status == "PASS" and .display == "none" and
            .environment_profile == "isolated-none-v1" and
            (.command | contains("cargo test --locked -p zentty-core --test session_restore_store")) and
            (.command | contains("linux/tests/workspace-recovery")) and
            (.command | contains("--self-test"))) and
        (.cells[] | select(.id == "workspace-recovery-corrupt-state") |
            .status == "PASS" and .display == "none" and
            .environment_profile == "isolated-none-v1" and
            .command == "cargo test --locked -p zentty-core --test session_restore_store malformed_type_incompatible_and_future_snapshots_follow_source_contract")
    ' "${matrix}"

((failures == 0)) || {
    echo "test-orchestration-contract: FAIL failures=${failures}" >&2
    exit 1
}
echo "Test orchestration contract passed: one actor, three protocol endpoints, external control, consolidated journeys"
