#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
linux_main="${repo_root}/crates/zentty-linux/src/main.rs"
application_shell="${repo_root}/crates/zentty-linux/src/application_shell.rs"
matrix="${repo_root}/linux/qualification-matrix.json"
architecture="${repo_root}/docs/architecture/linux-product-architecture-v1.json"
window_placement_policy="${repo_root}/docs/architecture/linux-window-placement-policy.md"
actor="${repo_root}/linux/tests/fixtures/controlled-agent"
codex_notify_observer="${repo_root}/linux/tests/fixtures/codex-notify-observer"
controlled_anthropic="${repo_root}/crates/zentty-test-support/src/bin/controlled_anthropic.rs"
controlled_openai="${repo_root}/crates/zentty-test-support/src/bin/controlled_openai_responses.rs"
controlled_gemini="${repo_root}/crates/zentty-test-support/src/bin/controlled_gemini.rs"
development_server="${repo_root}/crates/zentty-test-support/src/bin/development_server.rs"
platform_contract_actor="${repo_root}/crates/zentty-test-support/src/bin/platform_contract.rs"
wayland_input_harness="${repo_root}/linux/tests/nested-wayland-input"
multi_window_harness="${repo_root}/linux/tests/rust-multi-window"
workspace_settings_harness="${repo_root}/linux/tests/rust-workspace-pane-settings"
shortcut_settings_harness="${repo_root}/linux/tests/rust-shortcuts-settings"
cargo_age_policy="${repo_root}/linux/security/cargo-publish-age-policy.json"
cargo_age_exceptions="${repo_root}/linux/security/cargo-publish-age-exceptions.json"
cargo_age_audit="${repo_root}/linux/scripts/audit-cargo-publish-age"
cargo_config="${repo_root}/.cargo/config.toml"
failures=0

reject() {
    local message="$1"
    shift
    if "$@"; then
        echo "test-orchestration-contract: ${message}" >&2
        failures=$((failures + 1))
    fi
}

require() {
    local message="$1"
    shift
    if ! "$@" >/dev/null; then
        echo "test-orchestration-contract: ${message}" >&2
        failures=$((failures + 1))
    fi
}

for dependency in grep jq sed sort comm mktemp; do
    command -v "${dependency}" >/dev/null || {
        echo "test-orchestration-contract: ${dependency} is required" >&2
        exit 1
    }
done

reject "application shell still exports embedded schedule_* test scenarios" \
    grep -Eq 'pub\(crate\)[[:space:]]+fn schedule_[[:alnum:]_]+[[:space:]]*\(' "${application_shell}"
reject "application composition root still contains a test Scenario enum" \
    grep -Eq '^enum Scenario[[:space:]]*\{' "${linux_main}"
reject "application composition root still contains a scenario ExitPolicy" \
    grep -Eq '^enum ExitPolicy[[:space:]]*\{' "${linux_main}"

actual_options="$(mktemp)"
expected_options="$(mktemp)"
trap 'rm -f -- "${actual_options}" "${expected_options}"' EXIT
grep -Eo '"--[a-z0-9-]+"' "${linux_main}" | tr -d '"' | sort -u >"${actual_options}"
cat >"${expected_options}" <<'OPTIONS'
--async-backend
--command
--no-session-restore
--state-directory
OPTIONS
if ! diff="$(comm -3 "${expected_options}" "${actual_options}")"; then
    echo "test-orchestration-contract: product CLI differs from the reviewed non-test allowlist:" >&2
    printf '%s\n' "${diff}" >&2
    failures=$((failures + 1))
fi

require "the single reviewed deterministic agent actor is missing or not executable" \
    test -x "${actor}"
require "the installed-Codex notify observer is missing or not executable" \
    test -x "${codex_notify_observer}"
require "the reviewed Anthropic endpoint is missing" test -f "${controlled_anthropic}"
require "the reviewed OpenAI Responses endpoint is missing" test -f "${controlled_openai}"
require "the reviewed Gemini endpoint is missing" test -f "${controlled_gemini}"
require "the reviewed real development-server fixture is missing" test -f "${development_server}"
require "the reviewed Linux platform contract actor is missing" test -f "${platform_contract_actor}"
require "the controlled input-capable Wayland harness is missing or not executable" \
    test -x "${wayland_input_harness}"
require "the real multi-window product journey is missing or not executable" \
    test -x "${multi_window_harness}"
require "the real staged CLI contract journey is missing or not executable" \
    test -x "${repo_root}/linux/tests/rust-cli-contract"
require "the Cargo publication-age audit is missing or not executable" test -x "${cargo_age_audit}"
require "the Cargo age policy is not a seven-day empty-exception floor" \
    jq -e '.minimum_age_seconds == 604800 and .minimum_age == "7 days" and
        .stable_migration_tracking_issue == 96 and
        .exceptions_manifest == "linux/security/cargo-publish-age-exceptions.json"' \
        "${cargo_age_policy}"
require "the Cargo age exception manifest does not start empty" \
    jq -e '.schema_version == 1 and .exceptions == []' "${cargo_age_exceptions}"
require "native Cargo min-publish-age is not enabled" \
    grep -Fq 'min-publish-age = true' "${cargo_config}"
require "native Cargo does not deny too-new publications" \
    grep -Fq 'incompatible-publish-age = "deny"' "${cargo_config}"
require "native Cargo does not enforce a seven-day global publication age" \
    grep -Fq 'global-min-publish-age = "7 days"' "${cargo_config}"
require "the product build does not audit the complete lockfile before Cargo without consuming Cargo's build environment" \
    awk '
        /linux\/scripts\/audit-cargo-publish-age/ { audit = NR }
        /^GHOSTTY_LIB_DIR=.*\\$/ { environment = NR }
        /^[[:space:]]+cargo "\$\{cargo_arguments\[@\]\}" --jobs/ { cargo = NR }
        END { exit !(audit > 0 && environment == audit + 1 && cargo == environment + 5) }
    ' "${repo_root}/linux/scripts/build-local"
# The qualifier must retain this literal loop-variable expression.
# shellcheck disable=SC2016
require "local qualification does not serialize the lockfile audit before the matrix" \
    grep -Fq '"${test_path}" == linux/scripts/audit-cargo-publish-age' \
        "${repo_root}/linux/tests/qualify-local"
# The product script must retain this literal runtime path expression.
# shellcheck disable=SC2016
require "shortcut settings does not load Ghostty from the selected product bundle" \
    grep -Fq 'bundle_lib="${bundle_root}/lib"' "${shortcut_settings_harness}"
reject "shortcut settings still depends on a mutable Ghostty source-tree output" \
    grep -Fq 'ghostty_root}/zig-out' "${shortcut_settings_harness}"
require "the cross-compositor window placement policy is missing" \
    test -f "${window_placement_policy}"
require "the placement policy does not state Wayland compositor ownership" \
    grep -Fq 'compositor; GTK4 also removed' "${window_placement_policy}"
require "the placement policy does not reject an X11-only product path" \
    grep -Fq 'X11-only move implementation' "${window_placement_policy}"
inline_actor_files="$({
    grep -RIl --include='*' -E 'cat[[:space:]]*>.*[/}]codex|cat[[:space:]]*>.*[/}]claude' \
        "${repo_root}/linux/tests" || true
} | grep -vFx "${actor}" || true)"
if [[ -n "${inline_actor_files}" ]]; then
    echo "test-orchestration-contract: integration tests still generate inline agent programs:" >&2
    printf '%s\n' "${inline_actor_files}" >&2
    failures=$((failures + 1))
fi
controlled_model_servers="$({
    grep -RIl --include='*.rs' --include='*' \
        -E 'CONTROLLED_[A-Z_]*READY=http://|TcpListener::bind\(\("127\.0\.0\.1"' \
        "${repo_root}/crates/zentty-test-support" "${repo_root}/linux/tests" || true
} | grep -vFx "${development_server}" | sort -u)"
expected_model_servers="$(printf '%s\n%s\n%s\n' "${controlled_anthropic}" "${controlled_openai}" "${controlled_gemini}" | sort -u)"
if [[ "${controlled_model_servers}" != "${expected_model_servers}" ]]; then
    echo "test-orchestration-contract: controlled-model server allowlist differs:" >&2
    printf '%s\n' "${controlled_model_servers}" >&2
    failures=$((failures + 1))
fi
require "installed Claude journey does not consume the reviewed endpoint" \
    grep -Fq 'target/release-safe/controlled_anthropic' \
    "${repo_root}/linux/tests/installed-claude-agent-team"
require "installed Codex journey does not consume the reviewed Responses endpoint" \
    grep -Fq 'target/release-safe/controlled_openai_responses' \
    "${repo_root}/linux/tests/installed-codex-integration"
require "installed Gemini journey does not consume the reviewed Gemini endpoint" \
    grep -Fq 'controlled_gemini' "${repo_root}/linux/tests/rust-agent-ipc"
reject "qualify-local leaks the required Gemini journey into unrelated matrix cells" \
    grep -Eq '^[[:space:]]*ZENTTY_(REAL_GEMINI_BIN|EXPECTED_GEMINI_VERSION)=' \
    "${repo_root}/linux/tests/qualify-local"
# The grep intentionally matches the literal shell source expression.
# shellcheck disable=SC2016
require "the agent actor does not infer a required Gemini journey from ambient variables" \
    grep -Fq 'if [[ "${ZENTTY_REQUIRE_REAL_GEMINI:-false}" == true ]]; then' \
    "${repo_root}/linux/tests/rust-agent-ipc"
require "local builds do not expose the full provenance hash through the public version command" \
    grep -Fq 'ZENTTY_BUILD_COMMIT="${zentty_display_revision}"' \
    "${repo_root}/linux/scripts/build-local"
require "local builds embed a separate full revision for catalog provenance validation" \
    grep -Fq 'ZENTTY_BUILD_REVISION="${zentty_revision}"' \
    "${repo_root}/linux/scripts/build-local"
require "local build metadata does not lose the full provenance revision" \
    grep -Fq '"${zentty_revision}" \' \
    "${repo_root}/linux/scripts/build-local"
require "installed Claude journey does not consume the single controlled actor" \
    grep -Fq 'linux/tests/fixtures/controlled-agent' \
    "${repo_root}/linux/tests/installed-claude-agent-team"

# The four non-GUI/aggregate contracts must remain isolated, while clipboard
# qualification must keep real compositor, product, Ghostty selection, and PTY
# boundaries. This rejects a future downgrade to unit-only platform claims.
# shellcheck disable=SC2016
require "Linux platform contracts are not pinned to their real isolated and compositor journeys" \
    jq -e '
        (.cells[] | select(.id == "platform-xdg-paths-contract") |
            .status == "PASS" and .environment_profile == "isolated-none-v1" and
            .command == "target/release-safe/platform_contract xdg") and
        (.cells[] | select(.id == "platform-open-url-file-contract") |
            .status == "PASS" and .environment_profile == "isolated-none-v1" and
            .command == "target/release-safe/platform_contract open") and
        (.cells[] | select(.id == "platform-process-launch-contract") |
            .status == "PASS" and .environment_profile == "isolated-none-v1" and
            (.command | contains("target/release-safe/platform_contract process"))) and
        (.cells[] | select(.id == "platform-clipboard-x11") |
            .status == "PASS" and .terminals == "multi" and
            .environment_profile == "nested-x11-v1" and
            (.command | contains("build/linux/bin/zentty-linux")) and
            (.command | contains("ZENTTY_CLIPBOARD_ONLY=true")) and
            (.command | contains("linux/tests/rust-pane-search"))) and
        (.cells[] | select(.id == "platform-clipboard-wayland") |
            .status == "PASS" and .terminals == "multi" and
            .environment_profile == "nested-wayland-activation-v1" and
            (.command | contains("build/linux/bin/zentty-linux")) and
            (.command | contains("ZENTTY_CLIPBOARD_ONLY=true")) and
            (.command | contains("linux/tests/rust-pane-search"))) and
        (.cells[] | select(.id == "platform-settings-contract") |
            .status == "PASS" and .environment_profile == "isolated-none-v1" and
            (.depends_on | length) == 19 and
            (.depends_on | index("agent-settings-runtime-wayland") != null) and
            (.depends_on | index("platform-notifications-wayland") != null) and
            (.depends_on | index("open-with-wayland") != null) and
            (.depends_on | index("development-servers-wayland") != null))
    ' "${matrix}"

# Fractional scaling is a two-profile real-product journey in a controlled
# mixed-output compositor, never an ambient-desktop assumption or prose gap.
require "Wayland fractional scaling is not pinned to its controlled mixed-output journey" \
    jq -e '
        .cells[] | select(.id == "fractional-scale-wayland") |
        .status == "PASS" and .optimize == "both" and .terminals == "multi" and
        .environment_profile == "nested-wayland-scaling-v1" and
        (.depends_on | sort) == ["build-debug","build-release"] and
        (.command | contains("env -u GDK_SCALE -u GDK_DPI_SCALE")) and
        (.command | contains("linux/tests/rust-wayland-scaling"))
    ' "${matrix}"

require "Xwayland scaling is not pinned to its owned controlled compositor journey" \
    jq -e '
        .cells[] | select(.id == "scale-xwayland") |
        .status == "PASS" and .display == "x11" and .optimize == "both" and
        .terminals == "multi" and
        .environment_profile == "nested-xwayland-scaling-v1" and
        (.depends_on | sort) == ["build-debug","build-release"] and
        (.command | contains("GDK_BACKEND=x11")) and
        (.command | contains("ZENTTY_COMPOSITOR_SCALING_BACKEND=xwayland")) and
        (.command | contains("linux/tests/rust-wayland-scaling"))
    ' "${matrix}"

# CLI compatibility is a real staged-product boundary on each GTK backend,
# not a parser-only claim or an assumption about the developer desktop.
# shellcheck disable=SC2016
require "source CLI compatibility is not pinned to both controlled compositor journeys" \
    jq -e '
        [.cells[] | select(.capability == "cli_source_compatibility")] as $cells |
        ($cells | length) == 2 and
        all($cells[]; .status == "PASS" and .tier == "release" and
            .optimize == "ReleaseSafe" and .terminals == "multi" and
            (.command | contains("build/linux-profiles/release-safe/bin/zentty-linux")) and
            (.command | contains("linux/tests/rust-cli-contract"))) and
        any($cells[]; .display == "x11" and
            .environment_profile == "nested-x11-v1") and
        any($cells[]; .display == "wayland" and
            .environment_profile == "nested-wayland-input-v1")
    ' "${matrix}"

# Installed-product qualification must remain one paired extension of the
# package lifecycle and existing controlled compositor/input harnesses.
# shellcheck disable=SC2016
require "installed package qualification is not pinned to the real package and display journeys" \
    jq -e '
        [.cells[] | select(.capability == "installed_product")] as $cells |
        ($cells | length) == 2 and
        all($cells[];
            .status == "PASS" and .tier == "release" and
            .depends_on == ["install-uninstall"] and
            (.command | contains("linux/tests/debian-package-installed-product"))) and
        any($cells[]; .id == "installed-product-x11" and
            .environment_profile == "nested-x11-v1") and
        any($cells[]; .id == "installed-product-wayland" and
            .environment_profile == "nested-wayland-input-v1")
    ' "${matrix}"

require "Wayland agent qualification does not name the event, tmux, installed Claude, and consolidated restore journeys" \
    jq -e '
        .cells[] | select(.id == "agent-integration-wayland") |
        .environment_profile == "nested-wayland-multiwindow-v1" and
        .command == "ZENTTY_REQUIRE_REAL_GEMINI=true ZENTTY_REAL_GEMINI_BIN=linux/ci/node-tools/node_modules/.bin/gemini ZENTTY_EXPECTED_GEMINI_VERSION=0.53.0 ZENTTY_RUN_CODEX_LIFECYCLE=true GDK_BACKEND=wayland linux/tests/rust-agent-ipc && ZENTTY_TOPOLOGY_REPRESENTATIVE=1 GDK_BACKEND=wayland linux/tests/rust-tmux-compat-product && GDK_BACKEND=wayland linux/tests/installed-claude-agent-team && GDK_BACKEND=wayland linux/tests/rust-session-restore"
    ' "${matrix}"
require "controlled multi-window Wayland remote drop is not an explicit real-product cell" \
    jq -e '
        .cells[] | select(.id == "remote-file-drop-wayland") |
        .status == "PASS" and .capability == "remote_transfer" and
        .display == "wayland" and .optimize == "ReleaseSafe" and
        .environment_profile == "nested-wayland-multiwindow-v1" and
        .command == "ZENTTY_LINUX_BINARY=build/linux-profiles/release-safe/bin/zentty-linux GDK_BACKEND=wayland linux/tests/rust-session-restore"
    ' "${matrix}"
require "X11 agent qualification does not add installed Codex and Claude to the consolidated journeys" \
    jq -e '
        .cells[] | select(.id == "agent-integration-x11") |
        .command == "ZENTTY_REQUIRE_REAL_GEMINI=true ZENTTY_REAL_GEMINI_BIN=linux/ci/node-tools/node_modules/.bin/gemini ZENTTY_EXPECTED_GEMINI_VERSION=0.53.0 ZENTTY_RUN_CODEX_LIFECYCLE=true GDK_BACKEND=x11 linux/tests/rust-agent-ipc && GDK_BACKEND=x11 linux/tests/rust-tmux-compat-product && GDK_BACKEND=x11 linux/tests/installed-codex-integration && GDK_BACKEND=x11 linux/tests/installed-claude-agent-team && GDK_BACKEND=x11 linux/tests/rust-session-restore"
    ' "${matrix}"
reject "superseded inactive-agent journey remains authoritative" \
    grep -Fq 'linux/tests/rust-inactive-agent-restore' "${matrix}"
reject "architecture contract still references the superseded inactive-agent journey" \
    grep -Fq 'linux/tests/rust-inactive-agent-restore' "${architecture}"

# The jq program is intentionally a literal rather than a shell template.
# shellcheck disable=SC2016
require "clean, crash, and size multi-window restoration is not qualified on both real display stacks" \
    jq -e '
        [.cells[] | select(.id | startswith("product-multi-window-clean-crash-size-restore-"))] as $cells |
        ($cells | length) == 2 and
        all($cells[]; .status == "PASS" and .capability == "workspace_restore" and
            .optimize == "ReleaseSafe" and .terminals == "multi" and
            (.command | contains("build/linux-profiles/release-safe/bin/zentty-linux")) and
            (.command | contains("linux/tests/rust-multi-window"))) and
        any($cells[]; .display == "wayland" and
            .environment_profile == "nested-wayland-multiwindow-v1") and
        any($cells[]; .display == "x11" and
            .environment_profile == "nested-x11-v1")
    ' "${matrix}"

# The jq program is intentionally a literal rather than a shell template.
# shellcheck disable=SC2016
require "pane lifecycle family is not fully profile-pinned to distinct real product journeys" \
    jq -e '
        [.cells[] | select(.capability == "product_pane_terminal_lifecycle")] as $cells |
        ($cells | length) == 24 and
        all($cells[]; .status == "PASS") and
        all($cells[] | select(.optimize == "Debug");
            .command | contains("ZENTTY_LINUX_BINARY=build/linux-profiles/debug/bin/zentty-linux") and
            contains("ZENTTY_EXPECTED_PRODUCT_PROFILE=debug")) and
        all($cells[] | select(.optimize == "ReleaseSafe");
            .command | contains("ZENTTY_LINUX_BINARY=build/linux-profiles/release-safe/bin/zentty-linux") and
            contains("ZENTTY_EXPECTED_PRODUCT_PROFILE=release-safe")) and
        all($cells[] | select(.terminals == "single");
            (.command | contains("ZENTTY_RUST_SCENARIO=lifecycle")) and
            (.command | contains("ZENTTY_RUST_TERMINALS=1")) and
            (.command | contains("ZENTTY_RUST_CYCLES=3")) and
            (.command | contains("linux/tests/rust-product-smoke"))) and
        all($cells[] | select(.terminals == "multi");
            (.command | contains("linux/tests/rust-closed-pane-restore"))) and
        all($cells[] | select(.display == "wayland" and .terminals == "multi");
            .environment_profile == "nested-wayland-input-v1") and
        all($cells[] | select(.display == "wayland" and .terminals == "single");
            .environment_profile == "nested-wayland-v1") and
        all($cells[] | select(.display == "x11");
            .environment_profile == "nested-x11-v1")
    ' "${matrix}"

# The jq program is intentionally a literal rather than a shell template.
# shellcheck disable=SC2016
require "Rust/Ghostty adapter cells are not assigned to focused and real existing journeys" \
    jq -e '
        (.cells[] | select(.id == "rust-ghostty-api-product-usage") |
            .status == "PASS" and .display == "x11" and
            .environment_profile == "nested-x11-v1" and
            (.command | contains("linux/tests/ghostty-api-audit")) and
            (.command | contains("linux/tests/rust-closed-pane-restore")) and
            (.command | contains("linux/tests/rust-pane-search")) and
            (.command | contains("linux/tests/rust-tmux-compat-product"))) and
        (.cells[] | select(.id == "rust-ghostty-callback-drop-order") |
            .status == "PASS" and .display == "x11" and
            .environment_profile == "nested-x11-v1" and
            (.command | contains("GHOSTTY_LIB_DIR=$PWD/build/linux-profiles/debug/lib")) and
            (.command | contains("cargo test -p zentty-ghostty --locked --doc")) and
            (.command | contains("linux/tests/rust-closed-pane-restore"))) and
        (.cells[] | select(.id == "rust-global-find-product-usage-wayland") |
            .status == "PASS" and .display == "wayland" and
            .environment_profile == "nested-wayland-multiwindow-v1" and
            (.command | contains("ZENTTY_EXPECTED_PRODUCT_PROFILE=release-safe")) and
            (.command | contains("linux/tests/rust-pane-search"))) and
        (.cells[] | select(.id == "rust-ghostty-config-construction") |
            .status == "PASS" and .display == "none" and
            .environment_profile == "isolated-none-v1" and
            (.command | contains("GHOSTTY_LIB_DIR=$PWD/build/linux-profiles/debug/lib")) and
            (.command | contains("cargo test -p zentty-ghostty")))
    ' "${matrix}"

reject "Rust raw binding retains convenience constructors or speculative paste" \
    grep -Eq 'pub fn ghostty_gtk_embed_(runtime_new\(|surface_new\(|surface_request_paste\()' \
    "${repo_root}/crates/zentty-ghostty-sys/src/lib.rs"

# shellcheck disable=SC2016
require "Ghostty runtime-order and version-node cells are not executable real-artifact checks" \
    jq -e '
        (.cells[] | select(.id == "ghostty-runtime-initialization-order") |
            .status == "PASS" and .order == 31 and .display == "x11" and
            .environment_profile == "nested-x11-v1" and
            (.command | contains("build/linux-profiles/debug/bin/runtime-init-order")) and
            (.command | contains("linux/tests/runtime-init-order"))) and
        (.cells[] | select(.id == "ghostty-runtime-initialization-order-wayland") |
            .status == "PASS" and .order == 31 and .display == "wayland" and
            .environment_profile == "nested-wayland-v1" and
            (.command | contains("build/linux-profiles/debug/bin/runtime-init-order")) and
            (.command | contains("linux/tests/runtime-init-order"))) and
        (.cells[] | select(.id == "ghostty-abi-version-node") |
            .status == "PASS" and .display == "none" and
            .environment_profile == "isolated-none-v1" and
            (.command | contains("build/linux-profiles/release-safe/lib/libghostty-gtk-embed.so")) and
            (.command | contains("linux/tests/abi-version-node")))
    ' "${matrix}"

# shellcheck disable=SC2016
require "Ghostty old/new ABI mismatch remains prose-only or bypasses the real fixture" \
    jq -e '
        (.cells[] | select(.id == "ghostty-abi-old-new-mismatch") |
            .status == "PASS" and .display == "none" and
            .environment_profile == "isolated-none-v1" and
            (.command | contains("linux/tests/ghostty-abi-mismatch")) and
            (.command | contains("--self-test")))
    ' "${matrix}"

# shellcheck disable=SC2016
require "workspace recovery cells remain prose-only or bypass the focused real-I/O runner" \
    jq -e '
        (.cells[] | select(.id == "workspace-recovery-interrupted-write") |
            .status == "PASS" and .display == "none" and
            .environment_profile == "isolated-none-v1" and
            (.command | contains("cargo test --locked -p zentty-core --test session_restore_store")) and
            (.command | contains("linux/tests/workspace-recovery")) and
            (.command | contains("--self-test"))) and
        (.cells[] | select(.id == "workspace-recovery-corrupt-state") |
            .status == "PASS" and .display == "none" and
            .environment_profile == "isolated-none-v1" and
            .command == "cargo test --locked -p zentty-core --test session_restore_store malformed_type_incompatible_and_future_snapshots_follow_source_contract")
    ' "${matrix}"

# GUI journeys must synchronize on the state transition caused by an input,
# not merely on an earlier focus receipt or an arbitrary sleep. These focused
# constraints keep the repaired high-contention boundaries from regressing to
# the immediate assertions that produced moving full-matrix failures.
threshold_receipt_line="$(grep -n 'reload_before=.*config-reload result=applied' "${workspace_settings_harness}" | tail -1 | cut -d: -f1)"
threshold_write_line="$(grep -n 'sed -i .*visible_split_window_width' "${workspace_settings_harness}" | tail -1 | cut -d: -f1)"
if [[ ! "${threshold_receipt_line}" =~ ^[1-9][0-9]*$ ||
      ! "${threshold_write_line}" =~ ^[1-9][0-9]*$ ||
      "${threshold_receipt_line}" -ge "${threshold_write_line}" ]]; then
    echo "test-orchestration-contract: workspace threshold receipt boundary must precede the watched config write" >&2
    failures=$((failures + 1))
fi
require "settings journey does not count a new opacity application after physical Home" \
    grep -Fq 'opacity_apply_before=' "${repo_root}/linux/tests/rust-shortcuts-settings"
require "settings palette waits for the product-owned focus confirmation" \
    grep -Fq 'command-palette-focus=confirmed result=true' "${shortcut_settings_harness}"
