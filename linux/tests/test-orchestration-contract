#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
linux_main="${repo_root}/crates/zentty-linux/src/main.rs"
application_shell="${repo_root}/crates/zentty-linux/src/application_shell.rs"
matrix="${repo_root}/linux/qualification-matrix.json"
architecture="${repo_root}/docs/architecture/linux-product-architecture-v1.json"
actor="${repo_root}/linux/tests/fixtures/controlled-agent"
codex_notify_observer="${repo_root}/linux/tests/fixtures/codex-notify-observer"
controlled_anthropic="${repo_root}/crates/zentty-test-support/src/bin/controlled_anthropic.rs"
controlled_openai="${repo_root}/crates/zentty-test-support/src/bin/controlled_openai_responses.rs"
wayland_input_harness="${repo_root}/linux/tests/nested-wayland-input"
failures=0

reject() {
    local message="$1"
    shift
    if "$@"; then
        echo "test-orchestration-contract: ${message}" >&2
        failures=$((failures + 1))
    fi
}

require() {
    local message="$1"
    shift
    if ! "$@" >/dev/null; then
        echo "test-orchestration-contract: ${message}" >&2
        failures=$((failures + 1))
    fi
}

for dependency in grep jq sed sort comm mktemp; do
    command -v "${dependency}" >/dev/null || {
        echo "test-orchestration-contract: ${dependency} is required" >&2
        exit 1
    }
done

reject "application shell still exports embedded schedule_* test scenarios" \
    grep -Eq 'pub\(crate\)[[:space:]]+fn schedule_[[:alnum:]_]+[[:space:]]*\(' "${application_shell}"
reject "application composition root still contains a test Scenario enum" \
    grep -Eq '^enum Scenario[[:space:]]*\{' "${linux_main}"
reject "application composition root still contains a scenario ExitPolicy" \
    grep -Eq '^enum ExitPolicy[[:space:]]*\{' "${linux_main}"

actual_options="$(mktemp)"
expected_options="$(mktemp)"
trap 'rm -f -- "${actual_options}" "${expected_options}"' EXIT
grep -Eo '"--[a-z0-9-]+"' "${linux_main}" | tr -d '"' | sort -u >"${actual_options}"
cat >"${expected_options}" <<'OPTIONS'
--async-backend
--command
--no-session-restore
--state-directory
OPTIONS
if ! diff="$(comm -3 "${expected_options}" "${actual_options}")"; then
    echo "test-orchestration-contract: product CLI differs from the reviewed non-test allowlist:" >&2
    printf '%s\n' "${diff}" >&2
    failures=$((failures + 1))
fi

require "the single reviewed deterministic agent actor is missing or not executable" \
    test -x "${actor}"
require "the installed-Codex notify observer is missing or not executable" \
    test -x "${codex_notify_observer}"
require "the reviewed Anthropic endpoint is missing" test -f "${controlled_anthropic}"
require "the reviewed OpenAI Responses endpoint is missing" test -f "${controlled_openai}"
require "the controlled input-capable Wayland harness is missing or not executable" \
    test -x "${wayland_input_harness}"
inline_actor_files="$({
    grep -RIl --include='*' -E 'cat[[:space:]]*>.*[/}]codex|cat[[:space:]]*>.*[/}]claude' \
        "${repo_root}/linux/tests" || true
} | grep -vFx "${actor}" || true)"
if [[ -n "${inline_actor_files}" ]]; then
    echo "test-orchestration-contract: integration tests still generate inline agent programs:" >&2
    printf '%s\n' "${inline_actor_files}" >&2
    failures=$((failures + 1))
fi
controlled_model_servers="$({
    grep -RIl --include='*.rs' --include='*' \
        -E 'CONTROLLED_[A-Z_]*READY=http://|TcpListener::bind\(\("127\.0\.0\.1"' \
        "${repo_root}/crates/zentty-test-support" "${repo_root}/linux/tests" || true
} | sort -u)"
expected_model_servers="$(printf '%s\n%s\n' "${controlled_anthropic}" "${controlled_openai}" | sort -u)"
if [[ "${controlled_model_servers}" != "${expected_model_servers}" ]]; then
    echo "test-orchestration-contract: controlled-model server allowlist differs:" >&2
    printf '%s\n' "${controlled_model_servers}" >&2
    failures=$((failures + 1))
fi
require "installed Claude journey does not consume the reviewed endpoint" \
    grep -Fq 'target/release-safe/controlled_anthropic' \
    "${repo_root}/linux/tests/installed-claude-agent-team"
require "installed Codex journey does not consume the reviewed Responses endpoint" \
    grep -Fq 'target/release-safe/controlled_openai_responses' \
    "${repo_root}/linux/tests/installed-codex-integration"
require "installed Claude journey does not consume the single controlled actor" \
    grep -Fq 'linux/tests/fixtures/controlled-agent' \
    "${repo_root}/linux/tests/installed-claude-agent-team"

require "Wayland agent qualification does not name the event, tmux, installed Claude, and consolidated restore journeys" \
    jq -e '
        .cells[] | select(.id == "agent-integration-wayland") |
        .environment_profile == "nested-wayland-input-v1" and
        .command == "ZENTTY_RUN_CODEX_LIFECYCLE=true GDK_BACKEND=wayland linux/tests/rust-agent-ipc && GDK_BACKEND=wayland linux/tests/rust-tmux-compat-product && GDK_BACKEND=wayland linux/tests/installed-claude-agent-team && GDK_BACKEND=wayland linux/tests/rust-session-restore"
    ' "${matrix}"
require "X11 agent qualification does not add installed Codex and Claude to the consolidated journeys" \
    jq -e '
        .cells[] | select(.id == "agent-integration-x11") |
        .command == "ZENTTY_RUN_CODEX_LIFECYCLE=true GDK_BACKEND=x11 linux/tests/rust-agent-ipc && GDK_BACKEND=x11 linux/tests/rust-tmux-compat-product && GDK_BACKEND=x11 linux/tests/installed-codex-integration && GDK_BACKEND=x11 linux/tests/installed-claude-agent-team && GDK_BACKEND=x11 linux/tests/rust-session-restore"
    ' "${matrix}"
reject "superseded inactive-agent journey remains authoritative" \
    grep -Fq 'linux/tests/rust-inactive-agent-restore' "${matrix}"
reject "architecture contract still references the superseded inactive-agent journey" \
    grep -Fq 'linux/tests/rust-inactive-agent-restore' "${architecture}"

((failures == 0)) || {
    echo "test-orchestration-contract: FAIL failures=${failures}" >&2
    exit 1
}
echo "Test orchestration contract passed: one actor, two protocol endpoints, external control, consolidated journeys"
