#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
release_binary="${ZENTTY_RELEASE_SAFE_BINARY:-${repo_root}/build/linux-profiles/release-safe/bin/zentty-linux}"
debug_binary="${ZENTTY_DEBUG_BINARY:-${repo_root}/build/linux-profiles/debug/bin/zentty-linux}"
scaling_backend="${ZENTTY_COMPOSITOR_SCALING_BACKEND:-wayland}"
run_root="$(mktemp -d)"
product_pid=""
product_window=""
presented_outer=""

# shellcheck source=linux/tests/lib/product-bundle
source "${repo_root}/linux/tests/lib/product-bundle"
# shellcheck source=linux/tests/lib/product-input
source "${repo_root}/linux/tests/lib/product-input"
# shellcheck source=linux/tests/lib/visual-evidence
source "${repo_root}/linux/tests/lib/visual-evidence"

fail() {
    for candidate in "${run_root}"/*.log "${run_root}"/*.receipt "${run_root}"/*.outputs; do
        [[ -f "${candidate}" ]] || continue
        echo "--- ${candidate}" >&2
        if [[ "${candidate}" == *.log ]]; then
            grep -aE 'terminal-ready-pane=|preferred_scale\(|wl_surface@|wp_fractional_scale|wp_viewport|error:' \
                "${candidate}" | tail -120 >&2 || true
        else
            tail -120 "${candidate}" >&2
        fi
    done
    echo "rust-wayland-scaling: error: $*" >&2
    exit 1
}

pid_is_running() {
    kill -0 "$1" 2>/dev/null && [[ "$(ps -o stat= -p "$1" 2>/dev/null || true)" != Z* ]]
}

cleanup() {
    if [[ "${product_pid}" =~ ^[1-9][0-9]*$ ]]; then
        kill -TERM "${product_pid}" 2>/dev/null || true
        wait "${product_pid}" 2>/dev/null || true
    fi
    rm -rf -- "${run_root}"
}
trap cleanup EXIT

case "${scaling_backend}" in
    wayland)
        [[ "${GDK_BACKEND:-}" == wayland &&
            "${ZENTTY_NESTED_WAYLAND_XWAYLAND_PROFILE:-0}" == 0 ]] ||
            fail "native Wayland scaling requires the GTK Wayland backend"
        ;;
    xwayland)
        [[ "${GDK_BACKEND:-}" == x11 &&
            "${ZENTTY_NESTED_WAYLAND_XWAYLAND_PROFILE:-}" == 1 &&
            "${DISPLAY:-}" == "${ZENTTY_NESTED_XWAYLAND_DISPLAY:-missing}" &&
            "${ZENTTY_NESTED_XWAYLAND_PID:-}" =~ ^[1-9][0-9]*$ ]] ||
            fail "controlled owned Xwayland scaling session is required"
        ;;
    *) fail "unsupported compositor scaling backend: ${scaling_backend}" ;;
esac
[[ "${ZENTTY_NESTED_WAYLAND_INPUT_SESSION_ID:-}" =~ ^[0-9a-f]{64}$ &&
    "${ZENTTY_NESTED_WAYLAND_SCALING_PROFILE:-}" == 1 ]] ||
    fail "controlled mixed-scale compositor session is required"
[[ -z "${GDK_SCALE:-}" && -z "${GDK_DPI_SCALE:-}" ]] ||
    fail "process-local GDK scaling overrides are forbidden"
for dependency in wlr-randr wayland-info xdotool jq grep sed awk sort seq ps kill sleep mktemp import identify compare convert; do
    command -v "${dependency}" >/dev/null || fail "${dependency} is required"
done
if [[ "${scaling_backend}" == xwayland ]]; then
    for dependency in dump_xsettings xrdb xrandr; do
        command -v "${dependency}" >/dev/null || fail "${dependency} is required"
    done
    if dump_xsettings >"${run_root}/xwayland.xsettings" 2>&1; then
        fail "controlled Xwayland unexpectedly published an XSETTINGS manager"
    fi
    grep -Fxq 'No current owner for _XSETTINGS_S0 selection' \
        "${run_root}/xwayland.xsettings" ||
        fail "controlled Xwayland XSETTINGS absence was not explicit"
    xrdb -query >"${run_root}/xwayland.resources"
    ! grep -Eq '(^|[.*])Xft[.]dpi:' "${run_root}/xwayland.resources" ||
        fail "controlled Xwayland unexpectedly published X resource DPI"
fi
for binary in "${release_binary}" "${debug_binary}"; do
    [[ -x "${binary}" ]] || fail "staged Zentty product is missing: ${binary}"
done

outer_one="${ZENTTY_NESTED_WAYLAND_OUTER_X11_OUTPUT_1:?}"
outer_two="${ZENTTY_NESTED_WAYLAND_OUTER_X11_OUTPUT_2:?}"
outer_display="${ZENTTY_NESTED_WAYLAND_OUTER_DISPLAY:-${DISPLAY:?}}"
outer_windows=("${outer_one}" "${outer_two}")
for outer in "${outer_windows[@]}"; do
    geometry="$(DISPLAY="${outer_display}" xdotool getwindowgeometry --shell "${outer}")"
    [[ "${geometry}" == *$'WIDTH=1024\n'* && "${geometry}" == *$'HEIGHT=768\n'* ]] ||
        fail "owned labwc output window geometry is not 1024x768"
done

actor="${run_root}/actor"
cat >"${actor}" <<'ACTOR'
#!/usr/bin/env bash
set -euo pipefail
winches=0
trap 'winches=$((winches + 1))' WINCH
trap 'status=$?; printf "ERROR\t%s\t%s\t%s\n" "${ZENTTY_PANE_ID:-unknown}" "${LINENO}" "${status}" >>"${ZENTTY_SCALE_RECEIPT}"; exit "${status}"' ERR
stty -echo -icanon min 0 time 50
terminal_cell_size() {
    local response
    printf '\033[16t' >/dev/tty
    IFS= read -r -d t response </dev/tty
    [[ "${response}" =~ ^$'\033'\[6\;([1-9][0-9]*)\;([1-9][0-9]*)$ ]]
    printf '%s\t%s\n' "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}"
}
mouse_report() {
    local press release press_two release_two first_column first_row
    printf '\033[?1000h\033[?1006h' >/dev/tty
    printf 'ready\n' >"${ZENTTY_SCALE_ROOT}/${ZENTTY_SCALE_PROFILE}-${1}-mouse-ready"
    IFS= read -r -d M press </dev/tty
    IFS= read -r -d m release </dev/tty
    IFS= read -r -d M press_two </dev/tty
    IFS= read -r -d m release_two </dev/tty
    printf '\033[?1000l\033[?1006l' >/dev/tty
    [[ "${press}" =~ ^$'\033'\[\<0\;([1-9][0-9]*)\;([1-9][0-9]*)$ ]]
    first_column="${BASH_REMATCH[1]}"
    first_row="${BASH_REMATCH[2]}"
    [[ "${press_two}" =~ ^$'\033'\[\<0\;([1-9][0-9]*)\;([1-9][0-9]*)$ ]]
    printf 'MOUSE\t%s\t%s\t%s\t%s\t%s\t%s\n' \
        "${ZENTTY_SCALE_PROFILE}" "$1" "${first_column}" "${first_row}" \
        "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" >>"${ZENTTY_SCALE_RECEIPT}"
}
wait_for_changed_stable_geometry() {
    local previous_rows="$1" previous_columns="$2"
    local candidate_rows candidate_columns observed_rows="" observed_columns="" stable=0
    for _ in {1..400}; do
        read -r candidate_rows candidate_columns < <(stty size)
        if [[ "${candidate_rows}" == "${previous_rows}" &&
            "${candidate_columns}" == "${previous_columns}" ]]; then
            stable=0
        elif [[ "${candidate_rows}" == "${observed_rows}" &&
            "${candidate_columns}" == "${observed_columns}" ]]; then
            stable=$((stable + 1))
            # Require a sustained 400 ms plateau. Fractional output changes can
            # publish rows before the split allocation publishes final columns;
            # three scheduler ticks accepted that intermediate geometry.
            if (( stable >= 20 )); then
                printf '%s\t%s\n' "${candidate_rows}" "${candidate_columns}"
                return
            fi
        else
            observed_rows="${candidate_rows}"
            observed_columns="${candidate_columns}"
            stable=1
        fi
        sleep 0.02
    done
    return 1
}
first_stage=0
[[ "${ZENTTY_PANE_ID}" != pane-2 ]] || first_stage=1
previous_rows=""
previous_columns=""
for stage_number in $(seq "${first_stage}" 3); do
    marker="${ZENTTY_SCALE_ROOT}/${ZENTTY_SCALE_PROFILE}-stage-${stage_number}"
    while [[ ! -e "${marker}" ]]; do sleep 0.02; done
    if [[ -n "${previous_rows}" ]]; then
        IFS=$'\t' read -r rows columns < <(
            wait_for_changed_stable_geometry "${previous_rows}" "${previous_columns}"
        )
    else
        read -r rows columns < <(stty size)
    fi
    previous_rows="${rows}"
    previous_columns="${columns}"
    IFS=$'\t' read -r cell_height cell_width < <(terminal_cell_size)
    printf 'GEOMETRY\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
        "${ZENTTY_SCALE_PROFILE}" "${stage_number}" "${ZENTTY_PANE_ID}" \
        "${rows}" "${columns}" "${cell_height}" "${cell_width}" "${winches}" \
        >>"${ZENTTY_SCALE_RECEIPT}"
    if [[ "${ZENTTY_PANE_ID}" == pane-1 ]]; then
        mouse_report "${stage_number}"
    fi
    printf 'DONE\t%s\t%s\t%s\n' "${ZENTTY_SCALE_PROFILE}" "${stage_number}" \
        "${ZENTTY_PANE_ID}" >>"${ZENTTY_SCALE_RECEIPT}"
done
sleep 30
ACTOR
chmod +x "${actor}"

wait_for_log() {
    local file="$1" pattern="$2" description="$3"
    for _ in {1..400}; do
        [[ -f "${file}" ]] && grep -Fq -- "${pattern}" "${file}" && return
        pid_is_running "${product_pid}" || break
        sleep 0.02
    done
    fail "${description}"
}

wait_for_log_count_greater() {
    local file="$1" pattern="$2" before="$3" description="$4" observed
    for _ in {1..400}; do
        observed=0
        [[ ! -f "${file}" ]] || observed="$(grep -aFc -- "${pattern}" "${file}" || true)"
        (( observed > before )) && return
        pid_is_running "${product_pid}" || break
        sleep 0.02
    done
    fail "${description}"
}

focus_pane_one() {
    local cli="$1" selected_endpoint
    selected_endpoint="$(env -u ZENTTY_INSTANCE_SOCKET -u ZENTTY_PANE_TOKEN \
        -u ZENTTY_PANE_CREDENTIAL -u ZENTTY_WINDOW_ID -u ZENTTY_WORKLANE_ID \
        -u ZENTTY_PANE_ID "${cli}" select pane --pane-id pane-1 \
        --shell --include-control-token)"
    (
        eval "${selected_endpoint}"
        "${cli}" pane focus --pane-id pane-1
    )
}

split_pane_one() {
    local cli="$1" selected_endpoint
    selected_endpoint="$(env -u ZENTTY_INSTANCE_SOCKET -u ZENTTY_PANE_TOKEN \
        -u ZENTTY_PANE_CREDENTIAL -u ZENTTY_WINDOW_ID -u ZENTTY_WORKLANE_ID \
        -u ZENTTY_PANE_ID "${cli}" select pane --pane-id pane-1 \
        --shell --include-control-token)"
    (
        eval "${selected_endpoint}"
        "${cli}" split right --equal
    )
}

configure_outputs() {
    local output_file="$1" scale_one="$2" expected_scale expected_position expected_two_position
    if [[ "${scale_one}" == 1 ]]; then
        # Apply X11-1's scale before moving X11-2 beside it. In a combined
        # request, wlroots can resolve X11-2 against X11-1's old logical width
        # and silently relocate X11-1, reversing the intended left/right order.
        wlr-randr --output X11-1 --scale 1 --pos 0,0
        wlr-randr --output X11-2 --scale 2 --pos 1024,0
    else
        wlr-randr --output X11-1 --scale 1.5 --pos 0,0
        # labwc keeps the backend's X11-2-before-X11-1 adjacency when X11-1's
        # logical width changes. Anchor X11-2 at the origin and assert the
        # resulting order instead of pretending a rejected reordering worked.
        wlr-randr --output X11-2 --scale 2 --pos 0,0
        # Reassert X11-1 only after both logical widths have settled. Without
        # this final non-overlapping placement, labwc can transiently accept
        # both outputs at 0,0 depending on surface activity during the update.
        wlr-randr --output X11-1 --pos 512,0
    fi
    wlr-randr >"${output_file}"
    case "${scale_one}" in
        1) expected_scale=1.000000; expected_position=0,0; expected_two_position=1024,0 ;;
        1.5) expected_scale=1.500000; expected_position=512,0; expected_two_position=0,0 ;;
        *) fail "unsupported X11-1 scale ${scale_one}" ;;
    esac
    grep -A9 '^X11-1 ' "${output_file}" | grep -Fq "Scale: ${expected_scale}" ||
        fail "X11-1 scale ${scale_one} was not observed through output management"
    grep -A9 '^X11-1 ' "${output_file}" | grep -Fq "Position: ${expected_position}" ||
        fail "X11-1 scale ${scale_one} did not retain the controlled output order"
    grep -A9 '^X11-2 ' "${output_file}" | grep -Fq 'Scale: 2.000000' ||
        fail "X11-2 scale 2 was not retained"
    grep -A9 '^X11-2 ' "${output_file}" | grep -Fq "Position: ${expected_two_position}" ||
        fail "X11-2 did not retain the controlled output order"
    if [[ "${scaling_backend}" == xwayland ]]; then
        xrandr --current >"${output_file}.xwayland"
        [[ "$(grep -c ' connected ' "${output_file}.xwayland")" -eq 2 ]] ||
            fail "owned Xwayland did not expose exactly two compositor outputs"
        if [[ "${scale_one}" == 1 ]]; then
            grep -Eq '^X11-1 connected 1024x768\+' "${output_file}.xwayland" ||
                fail "owned Xwayland did not observe the compositor 1x geometry"
        else
            grep -Eq '^X11-1 connected 682x512\+' "${output_file}.xwayland" ||
                fail "owned Xwayland did not observe the compositor 1.5x geometry"
        fi
        grep -Eq '^X11-2 connected 512x384\+' "${output_file}.xwayland" ||
            fail "owned Xwayland did not retain the compositor 2x geometry"
    fi
}

send_compositor_key() {
    local outer="$1" key="$2"
    DISPLAY="${outer_display}" xdotool windowfocus --sync "${outer}"
    DISPLAY="${outer_display}" xdotool key "${key}"
}

capture_scaling_visual() {
    local scenario_id="$1"
    local image="${run_root}/${scenario_id}.png"
    local candidate_mean
    [[ "${presented_outer}" =~ ^[1-9][0-9]*$ ]] ||
        fail "${scenario_id} has no pointer-proven compositor output"
    # run_stage records the exact outer output that delivered this stage's real
    # pane-local pointer events. Capture that window rather than selecting the
    # brighter of both outputs: after MoveToOutput, wlroots can retain the last
    # presented frame on the old output, making brightness select stale pixels.
    # The shared evidence owner requires consecutive exact frames. A session
    # that never settles is a test failure, not a baseline.
    zentty_visual_capture_stable "${image}" \
        env DISPLAY="${outer_display}" import -silent -window "${presented_outer}" ||
        fail "${scenario_id} compositor frame did not settle"
    candidate_mean="$(convert "${image}" -colorspace gray -format '%[fx:mean]' info:)"
    awk -v selected="${candidate_mean}" 'BEGIN { exit !(selected > 0.001) }' ||
        fail "${scenario_id} found no presented compositor output"
    zentty_visual_publish "${scenario_id}" linux/tests/rust-wayland-scaling "${image}" - ||
        fail "${scenario_id} visual evidence did not match"
}

run_stage() {
    local profile="$1" stage="$2" pane_count="$3" receipt="$4" log="$5" candidate
    local done_pattern mouse_pattern x commits_before commits_after pointer_display
    local window_geometry window_width window_height
    local -a input_windows
    commits_before="$(grep -aEc ' -> wl_surface@[0-9]+\.commit\(\)' "${log}" || true)"
    : >"${run_root}/${profile}-stage-${stage}"
    wait_for_log "${run_root}/${profile}-${stage}-mouse-ready" '' \
        "${profile} stage ${stage} did not arm real terminal mouse reporting"
    sleep 0.5
    # The wlroots X11 backend does not expose which outer top-level implements
    # a named Wayland output. Address each non-overlapping, wrapper-owned output
    # once; only the output containing Zentty can deliver the SGR events. Scan
    # the terminal-height row rather than assuming a sidebar width or responsive
    # layout at any scale. The actor consumes the first two pane-local clicks.
    printf -v mouse_pattern 'MOUSE\t%s\t%s\t' "${profile}" "${stage}"
    if [[ "${scaling_backend}" == xwayland ]]; then
        input_windows=("${product_window}")
        pointer_display="${DISPLAY}"
    else
        input_windows=("${outer_windows[@]}")
        pointer_display="${outer_display}"
    fi
    for candidate in "${input_windows[@]}"; do
        window_geometry="$(DISPLAY="${pointer_display}" xdotool getwindowgeometry --shell "${candidate}")"
        window_width="$(sed -n 's/^WIDTH=//p' <<<"${window_geometry}")"
        window_height="$(sed -n 's/^HEIGHT=//p' <<<"${window_geometry}")"
        DISPLAY="${pointer_display}" xdotool windowfocus --sync "${candidate}"
        # The 2x Xwayland viewport is only 512 logical pixels wide, and its
        # split pane can be narrower than the old 100-pixel scan stride. A
        # 50-pixel stride guarantees two distinct pane-local columns without
        # assuming a sidebar width or clicking the same terminal cell twice.
        for x in $(seq 25 50 "$((window_width - 25))"); do
            DISPLAY="${pointer_display}" xdotool mousemove --sync --window "${candidate}" \
                "${x}" "$((window_height / 2))" click 1
            if grep -Fq -- "${mouse_pattern}" "${receipt}"; then
                if [[ "${scaling_backend}" == wayland ]]; then
                    presented_outer="${candidate}"
                    printf 'VISUAL_OUTPUT\t%s\t%s\t%s\n' \
                        "${profile}" "${stage}" "${presented_outer}" >>"${receipt}"
                    printf 'rust-wayland-scaling: visual-output profile=%s stage=%s outer-x11-window=%s\n' \
                        "${profile}" "${stage}" "${presented_outer}"
                fi
                break 2
            fi
        done
    done
    grep -Fq -- "${mouse_pattern}" "${receipt}" ||
        fail "${profile} stage ${stage} did not report two real pane-local pointer events"
    printf -v done_pattern 'DONE\t%s\t%s\tpane-1' "${profile}" "${stage}"
    wait_for_log "${receipt}" "${done_pattern}" \
        "${profile} stage ${stage} pane 1 did not acknowledge"
    if [[ "${pane_count}" -eq 2 ]]; then
        printf -v done_pattern 'DONE\t%s\t%s\tpane-2' "${profile}" "${stage}"
        wait_for_log "${receipt}" "${done_pattern}" \
            "${profile} stage ${stage} pane 2 did not acknowledge"
    fi
    sleep 0.2
    if [[ "${scaling_backend}" == wayland ]]; then
        commits_after="$(grep -aEc ' -> wl_surface@[0-9]+\.commit\(\)' "${log}" || true)"
        (( commits_after > commits_before )) ||
            fail "${profile} stage ${stage} stopped producing compositor-visible surface commits"
    else
        window_geometry="$(xdotool getwindowgeometry --shell "${product_window}")"
        printf 'WINDOW\t%s\t%s\t%s\t%s\t%s\t%s\n' "${profile}" "${stage}" \
            "$(sed -n 's/^X=//p' <<<"${window_geometry}")" \
            "$(sed -n 's/^Y=//p' <<<"${window_geometry}")" \
            "$(sed -n 's/^WIDTH=//p' <<<"${window_geometry}")" \
            "$(sed -n 's/^HEIGHT=//p' <<<"${window_geometry}")" >>"${receipt}"
    fi
}

run_profile() {
    local profile="$1" requested_binary="$2" product bundle_lib cli state receipt log
    local xwayland_two_x scale_event_before
    local -a product_environment
    product="${requested_binary}"
    zentty_product_bundle_resolve "${product}" || fail "${profile} staged bundle is invalid"
    product="${ZENTTY_PRODUCT_BINARY}"
    bundle_lib="${ZENTTY_PRODUCT_BUNDLE_LIB}"
    cli="$(dirname "${product}")/zentty"
    state="${run_root}/${profile}-state"
    receipt="${run_root}/${profile}.receipt"
    log="${run_root}/${profile}.log"
    mkdir -p "${state}" "${XDG_CONFIG_HOME}/zentty" "${XDG_CONFIG_HOME}/ghostty"
    cat >"${XDG_CONFIG_HOME}/zentty/config.toml" <<'CONFIG'
[confirmations]
confirm_before_closing_pane = false
confirm_before_closing_worklane = false
confirm_before_closing_window = false
confirm_before_quitting = false
CONFIG
    mkdir -p "${XDG_CONFIG_HOME}/gtk-4.0"
    cat >"${XDG_CONFIG_HOME}/gtk-4.0/settings.ini" <<'INI'
[Settings]
gtk-enable-animations=false
INI
    cat >"${XDG_CONFIG_HOME}/ghostty/config" <<'CONFIG'
resize-overlay = never
cursor-opacity = 0
CONFIG
    : >"${receipt}"
    configure_outputs "${run_root}/${profile}-baseline.outputs" 1
    DISPLAY="${outer_display}" xdotool windowfocus --sync "${outer_one}"
    DISPLAY="${outer_display}" xdotool mousemove --sync --window "${outer_one}" 512 384
    product_environment=(
        "ZENTTY_SCALE_ROOT=${run_root}"
        "ZENTTY_SCALE_PROFILE=${profile}"
        "ZENTTY_SCALE_RECEIPT=${receipt}"
        "LD_LIBRARY_PATH=${bundle_lib}${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"
    )
    [[ "${scaling_backend}" == xwayland ]] || product_environment+=(WAYLAND_DEBUG=client)
    (
        # Scaling evidence owns no Git/review scenario. Launch from the private
        # run root so the mutable source checkout cannot add an asynchronous
        # branch, dirty-tree, or stale-review transition to these screenshots.
        cd "${run_root}"
        exec env "${product_environment[@]}" "${product}" \
            --command "${actor}" --state-directory "${state}" \
            --no-session-restore
    ) >"${log}" 2>&1 &
    product_pid=$!
    wait_for_log "${log}" 'terminal-ready-pane=pane-1' \
        "${profile} single real terminal did not initialize"
    zentty_product_prepare_input "${scaling_backend/xwayland/x11}" "${log}" ||
        fail "${profile} compositor presentation/input did not become ready"
    if [[ "${scaling_backend}" == xwayland ]]; then
        product_window="${ZENTTY_PRODUCT_WINDOW_ID}"
        xdotool windowmove "${product_window}" 10 10
        xdotool windowactivate --sync "${product_window}"
    else
        send_compositor_key "${outer_two}" F1
    fi
    send_compositor_key "${outer_one}" F3
    run_stage "${profile}" 0 1 "${receipt}" "${log}" # single-baseline
    if [[ "${profile}" == release-safe && "${scaling_backend}" == wayland ]]; then
        capture_scaling_visual wide-dark-wayland
    fi

    split_pane_one "${cli}"
    wait_for_log "${log}" 'terminal-ready-pane=pane-2' \
        "${profile} second real Ghostty pane did not initialize"
    focus_pane_one "${cli}"
    run_stage "${profile}" 1 2 "${receipt}" "${log}" # multi-baseline

    scale_event_before="$(grep -aFc 'preferred_scale(180)' "${log}" || true)"
    configure_outputs "${run_root}/${profile}-fractional.outputs" 1.5
    if [[ "${scaling_backend}" == wayland ]]; then
        wait_for_log_count_greater "${log}" 'preferred_scale(180)' "${scale_event_before}" \
            "${profile} did not observe compositor preferred_scale(180)"
    else
        sleep 0.5
    fi
    run_stage "${profile}" 2 2 "${receipt}" "${log}" # fractional-1.5
    if [[ "${profile}" == release-safe && "${scaling_backend}" == wayland ]]; then
        capture_scaling_visual scale-150-wayland
    fi

    if [[ "${scaling_backend}" == wayland ]]; then
        scale_event_before="$(grep -aFc 'preferred_scale(240)' "${log}" || true)"
        # Fractional reconfiguration deterministically leaves X11-1 to the
        # right of X11-2. Address the pointer-proven current output and move
        # left, rather than sending a key to an assumed outer-window mapping.
        send_compositor_key "${presented_outer}" F1
        wait_for_log_count_greater "${log}" 'preferred_scale(240)' "${scale_event_before}" \
            "${profile} did not observe compositor preferred_scale(240)"
    else
        send_compositor_key "${outer_one}" F4
        xwayland_two_x="$(sed -n 's/^X11-2 connected [0-9][0-9]*x[0-9][0-9]*+\([0-9][0-9]*\)+.*/\1/p' \
            "${run_root}/${profile}-fractional.outputs.xwayland")"
        [[ "${xwayland_two_x}" =~ ^[0-9]+$ ]] ||
            fail "${profile} Xwayland 2x output position was unavailable"
        xdotool windowmove "${product_window}" "$((xwayland_two_x + 10))" 10
        xdotool windowactivate --sync "${product_window}"
        send_compositor_key "${outer_two}" F3
    fi
    focus_pane_one "${cli}"
    run_stage "${profile}" 3 2 "${receipt}" "${log}" # integer-2
    if [[ "${profile}" == release-safe && "${scaling_backend}" == wayland ]]; then
        capture_scaling_visual scale-200-wayland
    fi

    if [[ "${scaling_backend}" == xwayland ]]; then
        xdotool windowfocus --sync "${product_window}"
        xdotool key ctrl+q 2>/dev/null || true
    else
        DISPLAY="${outer_display}" xdotool windowfocus --sync "${outer_two}"
        DISPLAY="${outer_display}" xdotool key ctrl+q 2>/dev/null || true
    fi
    wait "${product_pid}" || fail "${profile} product did not exit cleanly"
    product_pid=""
    [[ "$(grep -Fc 'terminal-ready-pane=' "${log}")" -eq 2 ]] ||
        fail "${profile} panes restarted during scale transitions"
    [[ "$(grep -c '^GEOMETRY' "${receipt}")" -eq 7 &&
        "$(grep -c '^MOUSE' "${receipt}")" -eq 4 &&
        "$(grep -c '^DONE' "${receipt}")" -eq 7 ]] ||
        fail "${profile} PTY receipt counts are not exact"
    if [[ "${scaling_backend}" == xwayland ]]; then
        [[ "$(grep -c '^WINDOW' "${receipt}")" -eq 4 ]] ||
            fail "${profile} Xwayland window receipt count is not exact"
    fi
}

run_profile release-safe "${release_binary}"
run_profile debug "${debug_binary}"

validate_profile() {
    local profile="$1"
    local receipt="${run_root}/${profile}.receipt"
    awk -F '\t' -v profile="${profile}" -v backend="${scaling_backend}" '
        $1 == "GEOMETRY" {
            if (NF != 9 || $2 != profile || $3 !~ /^[0-3]$/ ||
                $4 !~ /^pane-[12]$/ || $5 !~ /^[1-9][0-9]*$/ ||
                $6 !~ /^[1-9][0-9]*$/ || $7 !~ /^[1-9][0-9]*$/ ||
                $8 !~ /^[1-9][0-9]*$/ || $9 !~ /^[0-9]+$/) exit 1
            key=$3 SUBSEP $4
            rows[key]=$5; columns[key]=$6; cell_h[key]=$7; cell_w[key]=$8; winch[key]=$9
        }
        $1 == "MOUSE" {
            if (NF != 7 || $2 != profile || $3 !~ /^[0-3]$/ ||
                $4 !~ /^[1-9][0-9]*$/ || $5 !~ /^[1-9][0-9]*$/ ||
                $6 !~ /^[1-9][0-9]*$/ || $7 !~ /^[1-9][0-9]*$/ ||
                $5 != $7 || $6 <= $4) exit 1
            mouse[$3]=1
        }
        $1 == "WINDOW" {
            if (NF != 7 || $2 != profile || $3 !~ /^[0-3]$/ ||
                $4 !~ /^[0-9]+$/ || $5 !~ /^[0-9]+$/ ||
                $6 !~ /^[1-9][0-9]*$/ || $7 !~ /^[1-9][0-9]*$/) exit 1
            window_w[$3]=$6; window_h[$3]=$7
        }
        $1 == "VISUAL_OUTPUT" {
            if (NF != 4 || $2 != profile || $3 !~ /^[0-3]$/ ||
                $4 !~ /^[1-9][0-9]*$/ || ($3 in visual_output)) exit 1
            visual_output[$3]=$4
        }
        END {
            if (length(rows) != 7 || length(mouse) != 4) exit 1
            for (stage=0; stage<=3; stage++) {
                key=stage SUBSEP "pane-1"
                if (!(key in rows) || !(stage in mouse)) exit 1
                # The owned 512-logical-pixel Xwayland output intentionally
                # fits the sidebar plus two panes. Each pane must retain a
                # usable 12-cell-width terminal, not an arbitrary 180 pixels
                # that the reviewed compact layout cannot physically provide.
                if (rows[key] * cell_h[key] < 150 || columns[key] < 12) exit 1
            }
            for (stage=1; stage<=3; stage++) {
                one=stage SUBSEP "pane-1"; two=stage SUBSEP "pane-2"
                if (rows[one] != rows[two] || columns[one] != columns[two] ||
                    cell_h[one] != cell_h[two] || cell_w[one] != cell_w[two]) exit 1
            }
            # Both scaled outputs have smaller logical geometry than the 1x
            # output. Each transition must resize both real PTYs exactly far
            # enough to produce a new cumulative SIGWINCH observation.
            if (winch[2 SUBSEP "pane-1"] <= winch[1 SUBSEP "pane-1"] ||
                winch[3 SUBSEP "pane-1"] <= winch[2 SUBSEP "pane-1"] ||
                winch[2 SUBSEP "pane-2"] <= winch[1 SUBSEP "pane-2"] ||
                winch[3 SUBSEP "pane-2"] <= winch[2 SUBSEP "pane-2"]) exit 1
            if (columns[1 SUBSEP "pane-1"] >= columns[0 SUBSEP "pane-1"]) exit 1
            if (backend == "wayland") {
                if (length(window_w) != 0 || length(visual_output) != 4 ||
                    rows[2 SUBSEP "pane-1"] >= rows[1 SUBSEP "pane-1"] ||
                    cell_h[2 SUBSEP "pane-1"] < cell_h[1 SUBSEP "pane-1"] * 1.8 ||
                    cell_w[2 SUBSEP "pane-1"] < cell_w[1 SUBSEP "pane-1"] * 1.8 ||
                    cell_h[3 SUBSEP "pane-1"] != cell_h[2 SUBSEP "pane-1"] ||
                    cell_w[3 SUBSEP "pane-1"] != cell_w[2 SUBSEP "pane-1"] ||
                    rows[3 SUBSEP "pane-1"] >= rows[2 SUBSEP "pane-1"]) exit 1
            } else {
                if (length(window_w) != 4 || window_w[0] != 1024 || window_w[1] != 1024 ||
                    window_w[2] != 682 || window_w[3] != 512 ||
                    window_h[2] >= window_h[1] || window_h[3] >= window_h[2] ||
                    rows[2 SUBSEP "pane-1"] >= rows[1 SUBSEP "pane-1"] ||
                    rows[3 SUBSEP "pane-1"] >= rows[2 SUBSEP "pane-1"] ||
                    cell_h[3 SUBSEP "pane-1"] != cell_h[1 SUBSEP "pane-1"] ||
                    cell_w[3 SUBSEP "pane-1"] != cell_w[1 SUBSEP "pane-1"]) exit 1
            }
        }
    ' "${receipt}" || fail "${profile} geometry, SIGWINCH, or mouse-coordinate coherence failed"
}

validate_profile release-safe
validate_profile debug
for profile in release-safe debug; do
    awk -F '\t' -v profile="${profile}" '
        $1 == "GEOMETRY" {
            printf "rust-wayland-scaling: receipt profile=%s stage=%s pane=%s rows=%s columns=%s cell=%sx%s winch=%s\n",
                profile, $3, $4, $5, $6, $8, $7, $9
        }
        $1 == "MOUSE" {
            printf "rust-wayland-scaling: pointer profile=%s stage=%s from=%s,%s to=%s,%s\n",
                profile, $3, $4, $5, $6, $7
        }
        $1 == "WINDOW" {
            printf "rust-wayland-scaling: window profile=%s stage=%s position=%s,%s size=%sx%s\n",
                profile, $3, $4, $5, $6, $7
        }
        $1 == "VISUAL_OUTPUT" {
            printf "rust-wayland-scaling: visual-output profile=%s stage=%s outer-x11-window=%s\n",
                profile, $3, $4
        }
    ' "${run_root}/${profile}.receipt"
done
echo "rust-wayland-scaling: PASS backend=${scaling_backend} profiles=ReleaseSafe,Debug scales=1,1.5,2 single-baseline multi-baseline fractional-1.5 integer-2 real-ghostty-csi real-pty SIGWINCH mouse-coordinate"
