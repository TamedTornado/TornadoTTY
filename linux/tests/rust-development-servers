#!/usr/bin/env bash
set -euo pipefail

if [[ "${ZENTTY_DEVELOPMENT_SERVER_PID_NAMESPACE:-}" != private ]]; then
    command -v unshare >/dev/null || {
        echo "rust-development-servers: error: unshare is required for private process discovery" >&2
        exit 77
    }
    exec unshare --user --map-root-user --pid --kill-child=TERM --mount-proc \
        env ZENTTY_DEVELOPMENT_SERVER_PID_NAMESPACE=private bash "$0" "$@"
fi

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
product="${ZENTTY_LINUX_BINARY:-${repo_root}/build/linux/bin/zentty-linux}"
server_fixture="${repo_root}/target/release-safe/development_server"
run_root="$(mktemp -d)"
log="${run_root}/product.log"
server_receipt="${run_root}/server.receipt"
watch_receipt="${run_root}/watch-server.receipt"
watch_list_receipt="${run_root}/watch-list.json"
watch_open_receipt="${run_root}/watch-open.receipt"
open_receipt="${run_root}/open.receipt"
alternate_open_receipt="${run_root}/alternate-open.receipt"
forged_browser_receipt="${run_root}/forged-browser.receipt"
system_open_receipt="${run_root}/system-open.receipt"
config_home="${run_root}/config"
data_home="${run_root}/data"
state_directory="${run_root}/state"
product_pid=""

# shellcheck source=linux/tests/lib/product-bundle
source "${repo_root}/linux/tests/lib/product-bundle"
# shellcheck source=linux/tests/lib/visual-evidence
source "${repo_root}/linux/tests/lib/visual-evidence"
# shellcheck source=linux/tests/lib/product-input
source "${repo_root}/linux/tests/lib/product-input"
backend="${GDK_BACKEND:-}"
container_id=""
docker_port=""
window_manager_pid=""

[[ "$$" -eq 1 ]] || {
    echo "rust-development-servers: error: private PID namespace was not established" >&2
    exit 77
}
echo "rust-development-servers: isolation pid-namespace=private"

fail() {
    [[ ! -f "${log}" ]] || cat "${log}" >&2
    echo "rust-development-servers-x11: error: $*" >&2
    exit 1
}

cleanup() {
    if [[ "${product_pid}" =~ ^[1-9][0-9]*$ ]]; then
        kill -TERM "${product_pid}" 2>/dev/null || true
        wait "${product_pid}" 2>/dev/null || true
    fi
    if [[ -n "${container_id}" ]]; then
        docker rm -f "${container_id}" >/dev/null 2>&1 || true
    fi
    if [[ "${window_manager_pid}" =~ ^[1-9][0-9]*$ ]]; then
        kill -TERM "${window_manager_pid}" 2>/dev/null || true
        wait "${window_manager_pid}" 2>/dev/null || true
    fi
    rm -rf -- "${run_root}"
}
trap cleanup EXIT

case "${backend}" in
    x11)
        [[ "${ZENTTY_NESTED_X11_SESSION_ID:-}" =~ ^[0-9a-f]{64}$ ]] ||
            fail "X11 scenario must run through linux/tests/nested-x11"
        command -v xdotool >/dev/null || fail "xdotool is required"
        command -v xclip >/dev/null || fail "xclip is required"
        command -v openbox >/dev/null || fail "openbox is required"
        openbox --sm-disable >"${run_root}/openbox.log" 2>&1 &
        window_manager_pid=$!
        for _ in $(seq 1 600); do
            xprop -root _NET_SUPPORTING_WM_CHECK 2>/dev/null | grep -Fq 'window id #' && break
            sleep 0.05
        done
        xprop -root _NET_SUPPORTING_WM_CHECK 2>/dev/null | grep -Fq 'window id #' ||
            fail "controlled Openbox window manager did not become ready"
        ;;
    wayland)
        [[ "${ZENTTY_NESTED_WAYLAND_INPUT_SESSION_ID:-}" =~ ^[0-9a-f]{64}$ ]] ||
            fail "Wayland scenario must run through linux/tests/nested-wayland-input"
        command -v wtype >/dev/null || fail "wtype is required"
        ;;
    *) fail "GDK_BACKEND must be x11 or wayland" ;;
esac
for dependency in cut grep head mktemp readelf sed seq sha256sum sleep xprop; do
    command -v "${dependency}" >/dev/null || fail "${dependency} is required"
done
[[ -x "${product}" ]] || fail "staged product is missing: ${product}"
zentty_product_bundle_resolve "${product}" || fail "staged product bundle is invalid"
product="${ZENTTY_PRODUCT_BINARY}"
bundle_lib="${ZENTTY_PRODUCT_BUNDLE_LIB}"
[[ -x "${server_fixture}" ]] || fail "real server fixture is missing: ${server_fixture}"

if [[ "${ZENTTY_TEST_DOCKER:-false}" == true ]]; then
    command -v docker >/dev/null || fail "docker is required for the container cell"
    busybox_image="${ZENTTY_TEST_BUSYBOX_IMAGE:-}"
    [[ "${busybox_image}" =~ ^busybox@sha256:[0-9a-f]{64}$ ]] ||
        fail "a content-pinned BusyBox image is required"
    container_id="$(
        docker run -d --rm --pull=never \
            --label "com.docker.compose.project.working_dir=${repo_root}" \
            --label 'com.docker.compose.service=web' \
            -p 127.0.0.1::8000 \
            "${busybox_image}" httpd -f -p 8000
    )" || fail "real disposable web container did not start"
    docker_port="$(docker port "${container_id}" 8000/tcp | sed -n 's/^127\.0\.0\.1:\([0-9][0-9]*\)$/\1/p')"
    [[ "${docker_port}" =~ ^[1-9][0-9]*$ ]] || fail "Docker did not publish a dynamic host port"
fi

mkdir -p "${run_root}/bin" "${state_directory}" "${config_home}/zentty" \
    "${config_home}/ghostty" \
    "${data_home}/applications"
cat >"${config_home}/ghostty/config" <<'EOF'
resize-overlay = never
cursor-opacity = 0
EOF
cat >"${run_root}/bin/preferred-browser" <<EOF
#!/usr/bin/env bash
printf '%s\n' "\$@" >>'${open_receipt}'
EOF
cat >"${run_root}/bin/alternate-browser" <<EOF
#!/usr/bin/env bash
printf '%s\n' "\$@" >>'${alternate_open_receipt}'
EOF
cat >"${run_root}/bin/system-browser" <<EOF
#!/usr/bin/env bash
printf '%s\n' "\$@" >>'${system_open_receipt}'
EOF
cat >"${run_root}/bin/removable-browser" <<'EOF'
#!/usr/bin/env bash
exit 0
EOF
cat >"${run_root}/bin/chooser-browser" <<'EOF'
#!/usr/bin/env bash
exit 0
EOF
chmod 700 "${run_root}/bin/preferred-browser" "${run_root}/bin/alternate-browser" \
    "${run_root}/bin/system-browser" "${run_root}/bin/removable-browser" \
    "${run_root}/bin/chooser-browser"
cat >"${data_home}/applications/zentty-system-browser.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=Controlled System Browser
Exec=${run_root}/bin/system-browser %u
MimeType=x-scheme-handler/http;x-scheme-handler/https;
NoDisplay=true
EOF
cat >"${config_home}/mimeapps.list" <<'EOF'
[Default Applications]
x-scheme-handler/http=zentty-system-browser.desktop;
x-scheme-handler/https=zentty-system-browser.desktop;
EOF
cat >"${config_home}/zentty/config.toml" <<EOF
[server_detection]
preferred_browser_id = "custom:preferred"
enabled_browser_target_ids = ["custom:preferred", "custom:alternate", "custom:gone"]

[[server_detection.custom_browsers]]
id = "custom:preferred"
name = "Preferred Browser"
path = "${run_root}/bin/preferred-browser"

[[server_detection.custom_browsers]]
id = "custom:alternate"
name = "Alternate Browser"
path = "${run_root}/bin/alternate-browser"

[[server_detection.custom_browsers]]
id = "custom:gone"
name = "Unavailable Browser"
path = "${run_root}/bin/browser-that-does-not-exist"

[[server_detection.custom_browsers]]
id = "custom:removable"
name = "Removable Browser"
path = "${run_root}/bin/removable-browser"

[[shortcuts.bindings]]
command_id = "server.open_selected"
shortcut = "command+option+o"
EOF
cat >"${run_root}/run-servers" <<EOF
#!/usr/bin/env bash
set -euo pipefail
watch_pid=""
server_pid=""
cleanup_watch() {
    if [[ "\${watch_pid}" =~ ^[1-9][0-9]*$ ]]; then
        kill -TERM "\${watch_pid}" 2>/dev/null || true
        wait "\${watch_pid}" 2>/dev/null || true
    fi
    if [[ "\${server_pid}" =~ ^[1-9][0-9]*$ ]]; then
        kill -TERM "\${server_pid}" 2>/dev/null || true
        wait "\${server_pid}" 2>/dev/null || true
    fi
}
trap cleanup_watch EXIT
"\${ZENTTY_CLI_BIN}" server watch -- '${server_fixture}' --receipt '${watch_receipt}' &
watch_pid=\$!
for _ in \$(seq 1 200); do
    [[ -s '${watch_receipt}' ]] && break
    sleep 0.01
done
watch_url=\$(sed -n 's/^url=//p' '${watch_receipt}')
for _ in \$(seq 1 200); do
    "\${ZENTTY_CLI_BIN}" server list --json >'${watch_list_receipt}'
    grep -Fq "\${watch_url}" '${watch_list_receipt}' && break
    sleep 0.01
done
"\${ZENTTY_CLI_BIN}" server open "\${watch_url}"
for _ in \$(seq 1 200); do
    [[ -s '${open_receipt}' ]] && break
    sleep 0.01
done
cp '${open_receipt}' '${watch_open_receipt}'
rm -f '${open_receipt}'
"\${ZENTTY_CLI_BIN}" server open "\${watch_url}" --browser custom:alternate
for _ in \$(seq 1 200); do
    [[ -s '${alternate_open_receipt}' ]] && break
    sleep 0.01
done
"\${ZENTTY_CLI_BIN}" server open "\${watch_url}" --browser system-default
for _ in \$(seq 1 200); do
    [[ -s '${system_open_receipt}' ]] && break
    sleep 0.01
done
if "\${ZENTTY_CLI_BIN}" server open "\${watch_url}" --browser forged-browser; then
    exit 41
else
    printf 'rejected\n' >'${forged_browser_receipt}'
fi
'${server_fixture}' --receipt '${server_receipt}' &
server_pid=\$!
for _ in \$(seq 1 200); do
    [[ -s '${server_receipt}' ]] && break
    sleep 0.01
done
printf '\033]2;Development servers\a\033[2J\033[H\033[?25l'
wait "\${server_pid}"
EOF
chmod 700 "${run_root}/run-servers"

GDK_SCALE=1 \
GDK_DPI_SCALE=1 \
XDG_CONFIG_HOME="${config_home}" \
XDG_DATA_HOME="${data_home}" \
PATH="${run_root}/bin:${PATH}" \
LD_LIBRARY_PATH="${bundle_lib}${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}" \
    "${product}" \
    --command "exec '${run_root}/run-servers'" \
    --state-directory "${state_directory}" \
    --no-session-restore >"${log}" 2>&1 &
product_pid=$!

window_id=""
for _ in $(seq 1 300); do
    if [[ -s "${server_receipt}" ]] && [[ -s "${watch_receipt}" ]] &&
        grep -Fq 'zentty-linux: server-detected ' "${log}"; then
        break
    fi
    sleep 0.05
done
[[ -s "${server_receipt}" ]] || fail "real PTY server did not publish readiness"
[[ -s "${watch_receipt}" ]] || fail "watched real server did not publish readiness"
if [[ "${backend}" == x11 ]]; then
    zentty_product_prepare_input "${backend}" "${log}" ||
        fail "mapped PID-owned Zentty window did not accept physical input"
    window_id="${ZENTTY_PRODUCT_WINDOW_ID}"
else
    window_id=wayland-focused
fi
port="$(sed -n 's#^url=http://127\.0\.0\.1:\([0-9][0-9]*\)/fixture$#\1#p' "${server_receipt}")"
server_pid="$(sed -n 's/^pid=\([0-9][0-9]*\)$/\1/p' "${server_receipt}")"
[[ "${port}" =~ ^[1-9][0-9]*$ ]] || fail "server fixture receipt is malformed"
[[ "${server_pid}" =~ ^[1-9][0-9]*$ ]] || fail "server PID receipt is malformed"
watch_port="$(sed -n 's#^url=http://127\.0\.0\.1:\([0-9][0-9]*\)/fixture$#\1#p' "${watch_receipt}")"
[[ "${watch_port}" =~ ^[1-9][0-9]*$ ]] || fail "watch server fixture receipt is malformed"
for _ in $(seq 1 100); do
    grep -Fq "origin=http://localhost:${watch_port} source=Watch confidence=Explicit" "${log}" && break
    sleep 0.05
done
grep -Fq "origin=http://localhost:${watch_port} source=Watch confidence=Explicit" "${log}" ||
    fail "authenticated watch output was not attributed to its real Ghostty pane"
grep -Fq "http://localhost:${watch_port}/fixture" "${watch_list_receipt}" ||
    fail "authenticated server list omitted the output-reported URL path"
[[ "$(cat "${watch_open_receipt}")" == "http://localhost:${watch_port}/fixture" ]] ||
    fail "authenticated server open discarded the output-reported URL path"
grep -Fxq "http://localhost:${watch_port}/fixture" "${alternate_open_receipt}" ||
    fail "authenticated explicit browser selection used the wrong target or URL"
grep -Fxq "http://localhost:${watch_port}/fixture" "${system_open_receipt}" ||
    fail "authenticated system-default browser selection used the wrong handler or URL"
[[ -s "${forged_browser_receipt}" ]] || fail "forged browser target was not rejected"
for _ in $(seq 1 200); do
    grep -Fq "origin=http://localhost:${port} source=Scanner confidence=Pid" "${log}" && break
    sleep 0.05
done
grep -Fq "origin=http://localhost:${port} source=Scanner confidence=Pid" "${log}" ||
    fail "real listener was not PID-attributed to its Ghostty pane"

if [[ "${backend}" == x11 ]]; then
    image="${run_root}/server-chrome-x11.png"
    xdotool windowsize --sync "${window_id}" 1400 800
    hidden_before="$(grep -Fc 'zentty-linux: sidebar-visibility=hidden' "${log}" || true)"
    xdotool mousemove --sync --window "${window_id}" 22 30 click 1
    for _ in $(seq 1 100); do
        (( $(grep -Fc 'zentty-linux: sidebar-visibility=hidden' "${log}" || true) > hidden_before )) && break
        sleep 0.05
    done
    (( $(grep -Fc 'zentty-linux: sidebar-visibility=hidden' "${log}" || true) > hidden_before )) ||
        fail "the controlled capture could not hide unrelated dynamic server rows"
    zentty_product_wait_for_log "${log}" \
        'zentty-linux: project-icon-projected owner=window-chrome fallback=folder-symbolic decoded=true' \
        'development-server chrome did not settle its project-icon fallback' ||
        fail "development-server project icon was not settled"
    zentty_product_wait_for_log "${log}" \
        'zentty-linux: title=Development servers' \
        'development-server terminal title did not reach the window chrome' ||
        fail "development-server terminal title was not settled"
    xdotool mousemove --sync 2000 1500
    zentty_visual_capture_stable "${image}" import -silent -window "${window_id}" ||
        fail "development-server X11 compositor frame did not settle"
    zentty_visual_publish server-chrome-x11 linux/tests/rust-development-servers "${image}" -

    xdotool mousemove --sync --window "${window_id}" 1306 30 click 1
    for _ in $(seq 1 100); do
        grep -Fq 'zentty-linux: chrome-popover=servers state=open' "${log}" && break
        sleep 0.05
    done
    grep -Fq 'zentty-linux: chrome-popover=servers state=open' "${log}" ||
        fail "the physical server-menu segment did not open its independent popover"
    xdotool key --window "${window_id}" Escape
    for _ in $(seq 1 100); do
        grep -Fq 'zentty-linux: chrome-popover=servers state=closed' "${log}" && break
        sleep 0.05
    done
    grep -Fq 'zentty-linux: chrome-popover=servers state=closed' "${log}" ||
        fail "the physical server-menu popover did not close"
    sleep 0.1

    rm -f "${open_receipt}"
    xdotool mousemove --sync --window "${window_id}" 1265 30 click 1
    for _ in $(seq 1 100); do [[ -s "${open_receipt}" ]] && break; sleep 0.05; done
    [[ "$(cat "${open_receipt}" 2>/dev/null || true)" == "http://localhost:${watch_port}/fixture" ]] ||
        fail "the physical server-primary segment did not open the selected server"
    xdotool mousemove --sync --window "${window_id}" 22 30 click 1
fi

# The source bindable command opens the highest-ranked server in the active
# worklane. Drive the persisted binding through the real GTK capture controller
# and require the configured browser process to receive the explicit Watch URL.
rm -f "${open_receipt}"
if [[ "${backend}" == x11 ]]; then
    xdotool windowfocus --sync "${window_id}"
    xdotool key --window "${window_id}" ctrl+alt+o
else
    wtype -M ctrl -M alt -k o -m alt -m ctrl
fi
for _ in $(seq 1 200); do [[ -s "${open_receipt}" ]] && break; sleep 0.05; done
[[ "$(cat "${open_receipt}" 2>/dev/null || true)" == "http://localhost:${watch_port}/fixture" ]] ||
    fail "bindable Open Selected Server did not launch the active worklane's primary server"
grep -Fq 'zentty-linux: shortcut=command+option+o action=open-selected-server' "${log}" ||
    fail "Open Selected Server bypassed the authoritative shortcut/action route"
rm -f "${open_receipt}"
if [[ -n "${container_id}" ]]; then
    for _ in $(seq 1 160); do
        grep -Fq "origin=http://localhost:${docker_port} source=Docker confidence=Cwd" "${log}" && break
        sleep 0.05
    done
    grep -Fq "origin=http://localhost:${docker_port} source=Docker confidence=Cwd" "${log}" ||
        fail "real container-published web port was not attributed to the matching project"
fi

# Exercise the Dev Servers page through the real command palette and physical
# GTK input. Presentation must reconcile the deliberately stale browser, and
# disabling passive detection must remove scanner/Docker projections without
# disturbing the authenticated Watch server or killing the real listener.
shown_before="$(grep -Fc 'zentty-linux: command-palette=shown' "${log}" || true)"
if [[ "${backend}" == x11 ]]; then
    xdotool windowfocus --sync "${window_id}"
    xdotool key --window "${window_id}" ctrl+shift+p
else
    wtype -M ctrl -M shift -k p -m shift -m ctrl
fi
for _ in $(seq 1 200); do
    (( $(grep -Fc 'zentty-linux: command-palette=shown' "${log}" || true) > shown_before )) && break
    sleep 0.05
done
(( $(grep -Fc 'zentty-linux: command-palette=shown' "${log}" || true) > shown_before )) ||
    fail "physical shortcut did not present the Dev Servers command palette"
if [[ "${backend}" == x11 ]]; then
    xdotool type --window "${window_id}" --delay 10 'Dev Servers Settings'
else
    wtype -d 50 -- 'Dev Servers Settings'
fi
for _ in $(seq 1 200); do
    grep -Fq 'command-palette=query value="Dev Servers Settings" results=1' "${log}" && break
    sleep 0.05
done
grep -Fq 'command-palette=query value="Dev Servers Settings" results=1' "${log}" ||
    fail "Dev Servers settings command was absent or ambiguous"
if [[ "${backend}" == x11 ]]; then
    xdotool key --window "${window_id}" Down Return
else
    wtype -k Down -k Return
fi
for _ in $(seq 1 200); do
    grep -Fq 'zentty-linux: settings-section selected=dev-servers' "${log}" &&
        grep -Fq 'zentty-linux: shortcut-settings active search-focused=' "${log}" && break
    sleep 0.05
done
grep -Fq 'zentty-linux: settings-section selected=dev-servers' "${log}" ||
    fail "Dev Servers settings did not deep-link through the shared shell"
grep -Fq 'dev-server-settings control=presentation-reconcile result=applied' "${log}" ||
    fail "Dev Servers settings did not reconcile its stale browser"
if grep -Fq 'custom:gone' "${config_home}/zentty/config.toml"; then
    fail "Dev Servers presentation retained an unavailable custom browser"
fi

settings_window_id=""
if [[ "${backend}" == x11 ]]; then
    for _ in $(seq 1 200); do
        settings_window_id="$(xdotool search --onlyvisible --name '^Zentty Settings$' 2>/dev/null | tail -1 || true)"
        [[ "${settings_window_id}" =~ ^[1-9][0-9]*$ ]] && break
        sleep 0.05
    done
    [[ "${settings_window_id}" =~ ^[1-9][0-9]*$ ]] || fail "Dev Servers settings window did not appear"
    xdotool windowfocus --sync "${settings_window_id}"

    focus_dev_server_control() {
        local widget="$1" description="$2" before
        before="$(grep -Fc "settings-focus widget=${widget}" "${log}" || true)"
        xdotool windowfocus --sync "${settings_window_id}"
        xdotool key --clearmodifiers --window "${settings_window_id}" ctrl+f
        for _ in $(seq 1 80); do
            xdotool key --clearmodifiers --window "${settings_window_id}" Tab
            (( $(grep -Fc "settings-focus widget=${widget}" "${log}" || true) > before )) && return
            sleep 0.05
        done
        fail "keyboard traversal did not reach ${description}"
    }

    focus_ignored_port_entry() {
        xdotool windowfocus --sync "${settings_window_id}"
        xdotool key --clearmodifiers --window "${settings_window_id}" alt+p
    }

    # Remove a configured custom browser through the real GTK row control.
    remove_browser_before="$(grep -Fc 'dev-server-settings control=remove-browser result=applied' "${log}" || true)"
    focus_dev_server_control \
        'settings-dev-servers-remove-browser-custom:removable' \
        'the removable custom browser'
    xdotool key --clearmodifiers --window "${settings_window_id}" Return
    for _ in $(seq 1 200); do
        (( $(grep -Fc 'dev-server-settings control=remove-browser result=applied' "${log}" || true) > remove_browser_before )) && break
        sleep 0.05
    done
    if grep -Fq "${run_root}/bin/removable-browser" "${config_home}/zentty/config.toml"; then
        fail "physical custom-browser removal retained the selected executable"
    fi

    # A real window manager gives GTK's native asynchronous FileDialog a
    # distinct managed transient, allowing deterministic physical interaction.
    focus_dev_server_control 'settings-dev-servers-add-browser' 'Add Browser'
    xdotool key --clearmodifiers --window "${settings_window_id}" Return
    chooser_window_id=""
    for _ in $(seq 1 200); do
        chooser_window_id="$(xdotool search --onlyvisible --name '^Add Browser Application$' 2>/dev/null | tail -1 || true)"
        [[ "${chooser_window_id}" =~ ^[1-9][0-9]*$ && "${chooser_window_id}" != "${settings_window_id}" ]] && break
        sleep 0.05
    done
    [[ "${chooser_window_id}" =~ ^[1-9][0-9]*$ && "${chooser_window_id}" != "${settings_window_id}" ]] ||
        fail "managed native browser chooser did not appear as a distinct transient"
    xdotool windowfocus --sync "${chooser_window_id}"
    xdotool key --clearmodifiers --window "${chooser_window_id}" ctrl+l
    printf '%s' "${run_root}/bin/chooser-browser" | xclip -selection clipboard -in
    xdotool key --clearmodifiers --window "${chooser_window_id}" ctrl+a ctrl+v Return
    sleep 0.2
    xdotool key --clearmodifiers Return
    for _ in $(seq 1 200); do
        grep -Fq 'dev-server-settings control=add-browser result=applied' "${log}" && break
        sleep 0.05
    done
    grep -Fq 'dev-server-settings control=add-browser result=applied' "${log}" ||
        fail "native browser chooser did not add the selected executable"
    grep -Fq "path = \"${run_root}/bin/chooser-browser\"" "${config_home}/zentty/config.toml" ||
        fail "native browser chooser did not persist the canonical executable"
    xdotool windowfocus --sync "${settings_window_id}"
    chooser_browser_id="$(awk -v path="${run_root}/bin/chooser-browser" '
        /^\[\[server_detection\.custom_browsers\]\]$/ { id="" }
        /^id = "/ { value=$0; sub(/^id = "/, "", value); sub(/"$/, "", value); id=value }
        /^path = "/ { value=$0; sub(/^path = "/, "", value); sub(/"$/, "", value); if (value == path) { print id; exit } }
    ' "${config_home}/zentty/config.toml")"
    [[ "${chooser_browser_id}" == custom:* ]] || fail "native chooser browser ID was not persisted"
    chooser_remove_before="$(grep -Fc 'dev-server-settings control=remove-browser result=applied' "${log}" || true)"
    focus_dev_server_control \
        "settings-dev-servers-remove-browser-${chooser_browser_id}" \
        'the native-chooser browser Remove button'
    xdotool key --clearmodifiers --window "${settings_window_id}" Return
    for _ in $(seq 1 200); do
        (( $(grep -Fc 'dev-server-settings control=remove-browser result=applied' "${log}" || true) > chooser_remove_before )) && break
        sleep 0.05
    done
    if grep -Fq "${run_root}/bin/chooser-browser" "${config_home}/zentty/config.toml"; then
        fail "physical removal retained the native-chooser browser"
    fi
    focus_dev_server_control \
        'settings-dev-servers-passive-detection' \
        'the passive detection switch'
    xdotool key --clearmodifiers --window "${settings_window_id}" space
    for _ in $(seq 1 200); do
        grep -Fq 'dev-server-settings control=passive-detection result=applied' "${log}" && break
        sleep 0.05
    done
    grep -Fq 'dev-server-settings control=passive-detection result=applied' "${log}" ||
        fail "physical settings input did not disable passive detection"
    grep -Fq 'passive_detection_enabled = false' "${config_home}/zentty/config.toml" ||
        fail "passive detection disable did not persist"
