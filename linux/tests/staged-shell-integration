#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
# shellcheck source=linux/tests/lib/shell-binaries
source "${repo_root}/linux/tests/lib/shell-binaries"
stage_root="${ZENTTY_STAGE_ROOT:-${repo_root}/build/linux}"
integration="${stage_root}/share/zentty/shell-integration"
shim="${stage_root}/libexec/zentty/tmux-shim"
wrapper_root="${stage_root}/libexec/zentty/agent-wrappers"
shell_name="${1:-}"

fail() {
    printf 'staged-shell-integration: error: %s\n' "$*" >&2
    exit 1
}

run_quiet_mode() {
    local label="$1"
    shift
    local stdout="${fixture}/${label}.stdout"
    local stderr="${fixture}/${label}.stderr"
    if ! "$@" >"${stdout}" 2>"${stderr}"; then
        cat "${stdout}" "${stderr}" >&2
        fail "${label} startup mode failed"
    fi
    if [[ -s "${stdout}" || -s "${stderr}" ]]; then
        cat "${stdout}" "${stderr}" >&2
        fail "${label} startup mode emitted user-visible bytes"
    fi
}

[[ "${shell_name}" =~ ^(bash|zsh|fish|nu)$ ]] || {
    echo "usage: staged-shell-integration bash|zsh|fish|nu" >&2
    exit 64
}
shell_binary="$(zentty_test_shell_binary "${shell_name}" "${repo_root}")" || {
    printf 'staged-shell-integration: SKIP missing shell prerequisite: %s\n' "${shell_name}" >&2
    exit 77
}
shell_version="$(zentty_test_shell_version "${shell_name}" "${shell_binary}")"
zentty_test_shell_version_supported "${shell_name}" "${shell_version}" || {
    printf 'staged-shell-integration: SKIP unsupported shell version: %s: %s\n' \
        "${shell_name}" "${shell_version}" >&2
    exit 77
}
[[ -f "${integration}/.zshenv" ]] || fail "staged integration tree is missing"
[[ -x "${shim}/tmux" ]] || fail "staged tmux shim is missing"

fixture="$(mktemp -d)"
trap 'rm -rf -- "${fixture}"' EXIT
fake_cli="${fixture}/zentty"
cat >"${fake_cli}" <<'FAKE_CLI'
#!/usr/bin/env bash
exit 0
FAKE_CLI
chmod 0700 "${fake_cli}"

common_environment=(
    env
    "HOME=${fixture}/home"
    "PATH=/usr/bin:/bin"
    "ZENTTY_CLI_BIN=${fake_cli}"
    "ZENTTY_AGENT_EVENT_COMMAND=${fake_cli} ipc agent-event"
    "ZENTTY_SHELL_INTEGRATION=1"
    "ZENTTY_SHELL_INTEGRATION_DIR=${integration}"
    "ZENTTY_SHELL_INTEGRATION_XDG_DIR=${integration}"
    "ZENTTY_TMUX_SHIM_DIR=${shim}"
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS=1"
    "ZENTTY_WINDOW_ID=window"
    "ZENTTY_WORKLANE_ID=worklane"
    "ZENTTY_PANE_ID=pane"
    "ZENTTY_PANE_TOKEN=token"
    "ZENTTY_INSTANCE_ID=instance"
    "ZENTTY_INSTANCE_SOCKET=${fixture}/instance.sock"
)
mkdir -p "${fixture}/home" "${fixture}/user-zdotdir"
mkdir -p "${fixture}/late-real-bin"
cat >"${fixture}/late-real-bin/codex" <<'LATE_CODEX'
#!/usr/bin/env bash
exit 0
LATE_CODEX
chmod 0700 "${fixture}/late-real-bin/codex"

case "${shell_name}" in
    bash)
        [[ -x "${wrapper_root}/codex/codex" ]] || fail "staged Codex wrapper is missing"
        # shellcheck disable=SC2016 # Expanded by the tested Bash process.
        "${common_environment[@]}" \
            "ZENTTY_ALL_WRAPPER_BIN_DIRS=${wrapper_root}/codex" \
            "ZENTTY_TEST_LATE_REAL_BIN=${fixture}/late-real-bin" \
            "ZENTTY_TEST_CODEX_WRAPPER=${wrapper_root}/codex/codex" \
            ZENTTY_BASH_ORIGINAL_PROMPT_COMMAND='PATH=/usr/bin:/bin; export ZENTTY_USER_PROMPT_RAN=1' \
            "${shell_binary}" --noprofile --norc -c '
                source "$ZENTTY_SHELL_INTEGRATION_DIR/zentty-bash-integration.bash"
                [[ "$ZENTTY_BASH_INTEGRATION_LOADED" == 1 ]]
                [[ "$ZENTTY_USER_PROMPT_RAN" == 1 ]]
                [[ "$(command -v tmux)" == "$ZENTTY_TMUX_SHIM_DIR/tmux" ]]
                ! command -v codex >/dev/null
                PATH="$ZENTTY_TEST_LATE_REAL_BIN:$PATH"
                _zentty_ensure_wrapper_path
                [[ "$(command -v codex)" == "$ZENTTY_TEST_CODEX_WRAPPER" ]]
            '
        # PROMPT_COMMAND is a prompt hook, not a non-interactive startup-file
        # override. Both login and non-login command shells must remain quiet
        # and leave the hook available for a later interactive shell.
        for mode in nonlogin login; do
            bash_arguments=(--noprofile --norc -c)
            [[ "${mode}" == login ]] && bash_arguments=(--noprofile --norc -l -c)
            # shellcheck disable=SC2016 # Expanded by the tested Bash process.
            run_quiet_mode "bash-${mode}" "${common_environment[@]}" \
                'PROMPT_COMMAND=. "$ZENTTY_SHELL_INTEGRATION_DIR/zentty-bash-integration.bash"' \
                "${shell_binary}" "${bash_arguments[@]}" \
                '[[ -z "${ZENTTY_BASH_INTEGRATION_LOADED:-}" && "$PROMPT_COMMAND" == *zentty-bash-integration.bash* ]]'
        done
        ;;
    zsh)
        cat >"${fixture}/user-zdotdir/.zshenv" <<'USER_ZSHENV'
export ZENTTY_USER_ZSHENV_RAN=1
if [[ -n "${ZENTTY_ZSH_MODE_MARKER:-}" ]]; then
    print -r -- user-zshenv >>"${ZENTTY_ZSH_MODE_MARKER}"
fi
USER_ZSHENV
        # shellcheck disable=SC2016 # Expanded by the tested Zsh process.
        "${common_environment[@]}" \
            "ZDOTDIR=${integration}" \
            "ZENTTY_ORIGINAL_ZDOTDIR=${fixture}/user-zdotdir" \
            "${shell_binary}" -i -c '
                [[ "$ZENTTY_USER_ZSHENV_RAN" == 1 ]]
                [[ "$ZDOTDIR" == *"/user-zdotdir" ]]
                [[ "$(command -v tmux)" == "$ZENTTY_TMUX_SHIM_DIR/tmux" ]]
            '
        : >"${fixture}/zsh-mode-user-marker"
        for mode in nonlogin login; do
            zsh_arguments=(-c)
            [[ "${mode}" == login ]] && zsh_arguments=(-l -c)
            # .zshenv deliberately restores and sources the user's .zshenv in
            # every mode, but installs interactive hooks only interactively.
            # shellcheck disable=SC2016 # Expanded by the tested Zsh process.
            run_quiet_mode "zsh-${mode}" "${common_environment[@]}" \
                "ZDOTDIR=${integration}" \
                "ZENTTY_ORIGINAL_ZDOTDIR=${fixture}/user-zdotdir" \
                "ZENTTY_ZSH_MODE_MARKER=${fixture}/zsh-mode-user-marker" \
                "${shell_binary}" "${zsh_arguments[@]}" \
                '[[ "$ZDOTDIR" == *"/user-zdotdir" && -z "${ZENTTY_ZSH_INTEGRATION_LOADED:-}" ]]'
        done
        [[ "$(wc -l <"${fixture}/zsh-mode-user-marker")" == 2 ]] ||
            fail "Zsh login/non-login modes did not source the user .zshenv exactly once"
        ;;
    fish)
        fish_marker="${fixture}/fish-passed"
        # shellcheck disable=SC2016 # Expanded by the tested Fish process.
        if ! printf '%s\n' \
            'not contains "$ZENTTY_SHELL_INTEGRATION_DIR" (string split : -- "$XDG_DATA_DIRS"); or exit 1' \
            'contains /usr/local/share (string split : -- "$XDG_DATA_DIRS"); or exit 1' \
            'contains /usr/share (string split : -- "$XDG_DATA_DIRS"); or exit 1' \
            'test (command -v tmux) = "$ZENTTY_TMUX_SHIM_DIR/tmux"; or exit 1' \
            "echo passed >${fish_marker}" \
            exit | \
            "${common_environment[@]}" \
                "XDG_DATA_DIRS=${integration}:/usr/local/share:/usr/share" \
                "ZENTTY_ORIGINAL_XDG_DATA_DIRS=/usr/local/share:/usr/share" \
                script --quiet --return --command "${shell_binary} -i" /dev/null \
                >"${fixture}/fish.log"; then
            cat "${fixture}/fish.log" >&2
            fail "Fish startup process failed"
        fi
        grep -Fxq passed "${fish_marker}" || fail "Fish startup assertions did not complete"
        # Fish executes vendor conf in command mode, where Zentty must consume
        # its XDG discovery root but must not install interactive hooks.
        # shellcheck disable=SC2016 # Expanded by the tested Fish process.
        run_quiet_mode fish-noninteractive "${common_environment[@]}" \
            "XDG_DATA_DIRS=${integration}:/usr/local/share:/usr/share" \
            "ZENTTY_ORIGINAL_XDG_DATA_DIRS=/usr/local/share:/usr/share" \
            "${shell_binary}" -c \
            'not set -q ZENTTY_FISH_INTEGRATION_LOADED; and not contains "$ZENTTY_SHELL_INTEGRATION_DIR" (string split : -- "$XDG_DATA_DIRS")'
        ;;
    nu)
        nu_marker="${fixture}/nu-passed"
        nu_command="if (\$env.XDG_DATA_DIRS | str contains \$env.ZENTTY_SHELL_INTEGRATION_DIR) { exit 1 }; "
        nu_command+="if not (\$env.XDG_DATA_DIRS | str contains '/usr/share') { exit 1 }; "
        nu_command+="if (which tmux | get 0.path) != (\$env.ZENTTY_TMUX_SHIM_DIR | path join tmux) { exit 1 }; "
        nu_command+="'passed' | save --force '${nu_marker}'; exit"
        nu_wrapper="${fixture}/run-nu"
        printf '#!/usr/bin/env bash\nexec %q -e %q\n' \
            "${shell_binary}" "${nu_command}" >"${nu_wrapper}"
        chmod 0700 "${nu_wrapper}"
        if ! "${common_environment[@]}" \
                "XDG_DATA_DIRS=${integration}:/usr/local/share:/usr/share" \
                "ZENTTY_ORIGINAL_XDG_DATA_DIRS=/usr/local/share:/usr/share" \
                script --quiet --return --command "${nu_wrapper}" /dev/null \
                >"${fixture}/nu.log"; then
            cat "${fixture}/nu.log" >&2
            fail "Nushell startup process failed"
        fi
        grep -Fxq passed "${nu_marker}" || fail "Nushell startup assertions did not complete"
        # Nushell does not load vendor autoload files for `-c`; leaving the
        # discovery path untouched allows a later interactive child to load it.
        # shellcheck disable=SC2016 # Expanded by the tested Nushell process.
        run_quiet_mode nu-noninteractive "${common_environment[@]}" \
            "XDG_DATA_DIRS=${integration}:/usr/local/share:/usr/share" \
            "ZENTTY_ORIGINAL_XDG_DATA_DIRS=/usr/local/share:/usr/share" \
            "${shell_binary}" -c \
            'if ($env | get -o ZENTTY_NU_INTEGRATION_LOADED | default "") != "" { exit 1 }; if not ($env.XDG_DATA_DIRS | str contains $env.ZENTTY_SHELL_INTEGRATION_DIR) { exit 1 }'
        ;;
esac

printf 'Staged shell integration passed: %s\n' "${shell_name}"
