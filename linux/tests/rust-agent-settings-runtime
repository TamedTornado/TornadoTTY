#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
product="${ZENTTY_LINUX_BINARY:-${repo_root}/build/linux/bin/zentty-linux}"
ghostty_root="${GHOSTTY_SOURCE_DIR:-${repo_root}/build/linux-deps/ghostty}"
backend="${GDK_BACKEND:-}"
run_root="$(mktemp -d)"
state_directory="${run_root}/state"
log="${run_root}/product.log"
config="${XDG_CONFIG_HOME}/zentty/config.toml"
product_pid=""

# shellcheck disable=SC1091
source "${repo_root}/linux/tests/lib/product-input"

fail() {
    [[ ! -f "${log}" ]] || cat "${log}" >&2
    echo "rust-agent-settings-runtime: error: $*" >&2
    exit 1
}

stop_product() {
    if [[ "${product_pid}" =~ ^[1-9][0-9]*$ ]]; then
        kill -TERM "${product_pid}" 2>/dev/null || true
        wait "${product_pid}" 2>/dev/null || true
        product_pid=""
    fi
}

cleanup() {
    stop_product
    rm -rf -- "${run_root}"
}
trap cleanup EXIT

case "${backend}" in
    x11)
        [[ "${ZENTTY_NESTED_X11_SESSION_ID:-}" =~ ^[0-9a-f]{64}$ ]] ||
            fail "X11 scenario must run through linux/tests/nested-x11"
        ;;
    wayland)
        [[ "${ZENTTY_NESTED_WAYLAND_INPUT_SESSION_ID:-}" =~ ^[0-9a-f]{64}$ ]] ||
            fail "Wayland scenario must run through linux/tests/nested-wayland-input"
        ;;
    *) fail "GDK_BACKEND must be x11 or wayland" ;;
esac
[[ -x "${product}" ]] || fail "staged product is missing: ${product}"
command -v codex >/dev/null || fail "a real Codex executable is required"

layer_runpath="$(
    readelf -d "${ghostty_root}/zig-out/lib/libghostty-gtk-embed.so" |
        sed -n 's/.*Library runpath: \[\([^]]*\)\].*/\1/p' |
        cut -d: -f1
)"
[[ "${layer_runpath}" == .zig-cache/* ]] || fail "Ghostty runpath is not pinned"
layer_directory="${ghostty_root}/${layer_runpath}"
mkdir -p "${state_directory}" "$(dirname "${config}")"

start_product() {
    : >"${log}"
    # The expansion belongs to the pane's real shell.
    # shellcheck disable=SC2016
    GDK_SCALE=1 \
    GDK_DPI_SCALE=1 \
    LD_LIBRARY_PATH="${ghostty_root}/zig-out/lib:${layer_directory}${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}" \
        "${product}" \
        --command 'printf '\''\033]2;agent-env codex=%s tmux=%s\a'\'' "$(command -v codex)" "${TMUX:-none}"; sleep 120' \
        --state-directory "${state_directory}" \
        --no-session-restore >"${log}" 2>&1 &
    product_pid=$!
    zentty_product_prepare_input "${backend}" "${log}" || fail "physical product input was unavailable"
}

type_text() {
    if [[ "${backend}" == x11 ]]; then
        xdotool type --delay 5 -- "$1"
    else
        wtype -d 35 -- "$1"
    fi
}

cat >"${config}" <<'EOF'
# agent settings integration receipt
[agent_teams]
enabled = false
[agent_integrations]
grandfathered_v1 = false
[agent_integrations.states]
codex = "off"
EOF
start_product
zentty_product_wait_for_log "${log}" 'agent-env codex=' \
    "disabled agent environment was not emitted" || fail "disabled environment missing"
grep -F 'agent-env codex=' "${log}" | grep -Fv '/libexec/zentty/agent-wrappers/codex/codex' >/dev/null ||
    fail "explicit off still selected Zentty's Codex wrapper"
grep -Fq 'tmux=none' "${log}" || fail "disabled teams still exported a tmux session"
stop_product

cat >"${config}" <<'EOF'
# agent settings integration receipt
[agent_teams]
enabled = true
[agent_integrations]
grandfathered_v1 = false
[agent_integrations.states]
codex = "on"
EOF
start_product
zentty_product_wait_for_log "${log}" '/libexec/zentty/agent-wrappers/codex/codex tmux=' \
    "enabled agent environment did not select the staged wrapper" || fail "enabled wrapper missing"
grep -F 'agent-env codex=' "${log}" | grep -F 'tmux=' | grep -Fv 'tmux=none' >/dev/null ||
    fail "enabled teams did not export the staged tmux compatibility session"

zentty_product_ctrl_shift_key "${backend}" p
type_text 'Agents Settings'
zentty_product_wait_for_log "${log}" \
    'command-palette=query value="Agents Settings" results=1' \
    "Agents Settings did not resolve uniquely" || fail "settings palette route failed"
zentty_product_key "${backend}" Down
zentty_product_key "${backend}" Return
zentty_product_wait_for_log "${log}" \
    'zentty-linux: settings-section selected=agents' \
    "palette did not deep-link to Agents" || fail "settings deep-link failed"
zentty_product_wait_for_log "${log}" \
    'agent-settings loaded teams=true wrappers-available=' \
    "Agents page did not report its exact source/platform inventory" || fail "settings inventory missing"
grep -F 'agent-settings loaded teams=true wrappers-available=' "${log}" |
    grep -Fq 'source-unavailable=8 status-item-available=false caffeination-available=true' ||
    fail "Agents page silently dropped source or platform inventory"
grep -Fq 'agent-settings integration=codex requested=on observed=wrapper-ready class=ephemeral' "${log}" ||
    fail "Agents page did not distinguish requested Codex state from observed wrapper readiness"
grep -Fq 'agent-settings integration=amp requested=ask observed=unavailable class=persistent consent=required-before-install' "${log}" ||
    fail "persistent consent/unavailability state was not explicit"
zentty_product_wait_for_log "${log}" 'shortcut-settings active search-focused=' \
    "Agents settings toplevel did not become active" || fail "settings activation missing"
settings_window_id=""
find_settings_window() {
    local candidate width height area best="" best_area=0
    while read -r candidate; do
        [[ "${candidate}" =~ ^[1-9][0-9]*$ ]] || continue
        width="$(xdotool getwindowgeometry --shell "${candidate}" 2>/dev/null | sed -n 's/^WIDTH=//p')"
        height="$(xdotool getwindowgeometry --shell "${candidate}" 2>/dev/null | sed -n 's/^HEIGHT=//p')"
        [[ "${width}" =~ ^[0-9]+$ && "${height}" =~ ^[0-9]+$ ]] || continue
        area=$((width * height))
        if (( area > best_area )); then
            best="${candidate}"
            best_area="${area}"
        fi
    done < <(xdotool search --onlyvisible --name '^Zentty Settings$' 2>/dev/null || true)
    printf '%s' "${best}"
}

if [[ "${backend}" == x11 ]]; then
    settings_window_id=""
    for _ in $(seq 1 100); do
        settings_window_id="$(find_settings_window)"
        [[ "${settings_window_id}" =~ ^[1-9][0-9]*$ ]] && break
        sleep 0.05
    done
    [[ "${settings_window_id}" =~ ^[1-9][0-9]*$ ]] || fail "real Agents settings toplevel was not identifiable"
    settings_width="$(xdotool getwindowgeometry --shell "${settings_window_id}" | sed -n 's/^WIDTH=//p')"
    [[ "${settings_width}" =~ ^[1-9][0-9]*$ ]] || fail "Agents settings width was unavailable"
    switch_x="$((settings_width - 65))"

    # The Linux inhibitor is a real page-owned setting, not a disabled source
    # placeholder. Exercise its native mnemonic and persisted config boundary.
    caffeination_before="$(grep -Fc 'agent-settings control=caffeination enabled=false result=applied' "${log}" || true)"
    xdotool key --window "${settings_window_id}" alt+s
    for _ in $(seq 1 100); do
        (( $(grep -Fc 'agent-settings control=caffeination enabled=false result=applied' "${log}" || true) > caffeination_before )) && break
        sleep 0.05
    done
    (( $(grep -Fc 'agent-settings control=caffeination enabled=false result=applied' "${log}" || true) > caffeination_before )) ||
        fail "Agents sleep-inhibition mnemonic did not activate the native switch"
    grep -A1 -Fx '[agent_caffeination]' "${config}" | grep -Fq 'enabled = false' ||
        fail "sleep-inhibition disabled state was not persisted"

    # A malformed externally edited document is retained as last-good by the
    # watcher, but a settings write must still fail transactionally rather than
    # overwriting it or claiming the requested state was accepted.
    cp "${config}" "${run_root}/valid-agent-config.toml"
    printf '%s\n' '[agent_integrations' >"${config}"
    malformed_before="$(grep -Fc 'config-reload result=retained-last-good' "${log}" || true)"
    for _ in $(seq 1 200); do
        (( $(grep -Fc 'config-reload result=retained-last-good' "${log}" || true) > malformed_before )) && break
        sleep 0.05
    done
    (( $(grep -Fc 'config-reload result=retained-last-good' "${log}" || true) > malformed_before )) ||
        fail "malformed external config was not retained as last-good"
    error_before="$(grep -Fc 'agent-settings control=codex result=error' "${log}" || true)"
    xdotool mousemove --sync --window "${settings_window_id}" "${switch_x}" 458 click 1
    for _ in $(seq 1 100); do
        (( $(grep -Fc 'agent-settings control=codex result=error' "${log}" || true) > error_before )) && break
        sleep 0.05
    done
    (( $(grep -Fc 'agent-settings control=codex result=error' "${log}" || true) > error_before )) ||
        fail "malformed-config write failure was not surfaced"
    [[ "$(grep -Fc 'agent-settings control=codex result=error' "${log}" || true)" == "$((error_before + 1))" ]] ||
        fail "switch rollback retried the rejected Agents settings write"
    grep -Fxq '[agent_integrations' "${config}" || fail "failed write replaced malformed external config"
    restore_watch_before="$(grep -Fc 'config-watch path=' "${log}" || true)"
    cp "${run_root}/valid-agent-config.toml" "${config}"
    for _ in $(seq 1 200); do
        (( $(grep -Fc 'config-watch path=' "${log}" || true) > restore_watch_before )) && break
        sleep 0.05
    done
    (( $(grep -Fc 'config-watch path=' "${log}" || true) > restore_watch_before )) ||
        fail "valid configuration restoration was not consumed"

    # Disable Codex through the same rendered native switch after rollback. The
    # accepted config and sole AgentRuntime authority must both change.
    watcher_before="$(grep -Fc 'config-watch path=' "${log}" || true)"
    xdotool mousemove --sync --window "${settings_window_id}" "${switch_x}" 458 click 1
    zentty_product_wait_for_log "${log}" \
        'agent-settings control=integration id=codex requested=off observed=wrapper-configured result=applied' \
        "physical Codex switch did not persist" || fail "Codex disable missing"
    grep -Fq 'codex = "off"' "${config}" || fail "Codex disabled state was not persisted"
    for _ in $(seq 1 200); do
        (( $(grep -Fc 'config-watch path=' "${log}" || true) > watcher_before )) && break
        sleep 0.05
    done
    (( $(grep -Fc 'config-watch path=' "${log}" || true) > watcher_before )) ||
        fail "settings write was not consumed before the external edit"

    # External edits while the page is open must rebuild it from the existing
    # watched config authority rather than leaving a stale requested state.
    refresh_before="$(grep -Fc 'settings-live-refresh section=agents' "${log}" || true)"
    page_load_before="$(grep -Fc 'agent-settings loaded teams=' "${log}" || true)"
    sed -i 's/codex = "off"/codex = "on"/' "${config}"
    for _ in $(seq 1 200); do
        (( $(grep -Fc 'settings-live-refresh section=agents' "${log}" || true) > refresh_before )) && break
        sleep 0.05
    done
    (( $(grep -Fc 'settings-live-refresh section=agents' "${log}" || true) > refresh_before )) ||
        fail "external integration edit did not refresh the open Agents page"
    for _ in $(seq 1 200); do
        (( $(grep -Fc 'agent-settings loaded teams=' "${log}" || true) > page_load_before )) && break
        sleep 0.05
    done
    (( $(grep -Fc 'agent-settings loaded teams=' "${log}" || true) > page_load_before )) ||
        fail "external integration edit did not rebuild the Agents page"
    grep -Fq 'agent-settings integration=codex requested=on observed=wrapper-ready class=ephemeral' "${log}" ||
        fail "refreshed page did not reconcile requested and observed Codex state"

    # Disable teams and prove a newly created real pane loses only the existing
    # tmux-team environment; no second runtime or PTY owner is introduced.
    settings_window_id=""
    for _ in $(seq 1 100); do
        settings_window_id="$(find_settings_window)"
        [[ "${settings_window_id}" =~ ^[1-9][0-9]*$ ]] && break
        sleep 0.05
    done
    [[ "${settings_window_id}" =~ ^[1-9][0-9]*$ ]] || fail "refreshed Agents settings toplevel disappeared"
    xdotool windowfocus --sync "${settings_window_id}"
    teams_before="$(grep -Fc 'agent-settings control=teams result=applied' "${log}" || true)"
    xdotool key --window "${settings_window_id}" alt+t
    for _ in $(seq 1 100); do
        (( $(grep -Fc 'agent-settings control=teams result=applied' "${log}" || true) > teams_before )) && break
        sleep 0.05
    done
    (( $(grep -Fc 'agent-settings control=teams result=applied' "${log}" || true) > teams_before )) ||
        fail "Agents teams mnemonic did not activate the native switch"
    grep -Fq 'enabled = false' "${config}" || fail "teams disabled state was not persisted"

    xdotool key --window "${settings_window_id}" Escape
    zentty_product_wait_for_log "${log}" 'shortcut-settings hidden parent-presented=true' \
        "Agents settings did not return focus" || fail "settings close missing"
    ZENTTY_PRODUCT_WINDOW_ID="$(xdotool search --onlyvisible --pid "${product_pid}" --name '^Zentty$' 2>/dev/null | head -1 || true)"
    export ZENTTY_PRODUCT_WINDOW_ID
    env_before="$(grep -Fc 'agent-env codex=' "${log}" || true)"
    zentty_product_ctrl_key "${backend}" t
    for _ in $(seq 1 200); do
        (( $(grep -Fc 'agent-env codex=' "${log}" || true) > env_before )) && break
        sleep 0.05
    done
    (( $(grep -Fc 'agent-env codex=' "${log}" || true) > env_before )) || fail "fresh pane environment was not emitted"
    grep -F 'agent-env codex=' "${log}" | tail -1 |
        grep -Fq '/libexec/zentty/agent-wrappers/codex/codex' ||
        fail "externally restored Codex state did not reach the new pane runtime"
    grep -F 'agent-env codex=' "${log}" | tail -1 | grep -Fq 'tmux=none' ||
        fail "disabled teams still exported a tmux compatibility session"
else
    # Cage owns real Wayland presentation and exact state projection. Its
    # scoped virtual keyboard has no settings-toplevel pointer injector, so the
    # companion X11 cell owns physical switch mutation and write-denial.
    grep -Fq 'codex = "on"' "${config}" || fail "Wayland presentation changed Codex state"
fi

grep -Fq '# agent settings integration receipt' "${config}" || fail "configuration comment was lost"
if [[ "${backend}" == x11 ]]; then
    echo "rust-agent-settings-runtime-x11: PASS real-pty real-wrapper-gating real-tmux-team-environment physical-settings-controls requested-vs-observed explicit-platform-unavailability live-refresh transactional-write-failure"
else
    echo "rust-agent-settings-runtime-wayland: PASS real-pty real-wrapper-gating real-tmux-team-environment physical-settings-deep-link requested-vs-observed explicit-platform-unavailability presentation-preservation companion-x11-owns-physical-controls"
fi
