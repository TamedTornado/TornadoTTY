  "tracking": "GH-26",
  "purpose": "Characterize every ApplicationShell field, method, action, authority, and lifecycle edge before extraction; this contract assigns ownership but does not create a second implementation.",
  "owners": [
    {
      "id": "application_runtime",
      "status": "existing",
      "planned_module": "crates/zentty-linux/src/main.rs and crates/zentty-linux/src/application.rs",
      "tracking": "GH-31",
      "responsibility": "Process composition root and sole default GLib main-context/main-loop scheduling authority; owns the single process-wide authenticated Agent IPC transport plus startup, cross-window routing, transfer, and shutdown ordering around each window shell."
    },
    {
      "id": "application_shell",
      "status": "existing",
      "planned_module": "crates/zentty-linux/src/application_shell.rs",
      "tracking": "GH-25",
      "responsibility": "Window composition root, sole live WorkspaceState, top-level GTK window ownership, UI projection, and delegation between focused coordinators."
    },
    {
      "id": "action_router",
      "status": "existing",
      "planned_module": "crates/zentty-linux/src/application_shell/action_router.rs",
      "tracking": "GH-27",
      "responsibility": "One GTK action registry, typed Variant decoding, command availability, shortcuts, and dispatch without product-state ownership."
    },
    {
      "id": "pane_runtime_coordinator",
      "status": "existing",
      "planned_module": "crates/zentty-linux/src/application_shell/pane_runtime.rs",
      "tracking": "GH-28",
      "responsibility": "The sole pane-to-Ghostty-surface projection, including launch-deferred pane identity, callback registrations, transactional construction, focus, child exit, and teardown."
    },
    {
      "id": "agent_event_coordinator",
      "status": "existing",
      "planned_module": "crates/zentty-linux/src/application_shell/agent_events.rs",
      "tracking": "GH-29",
      "responsibility": "The sole UI-thread drain of authenticated agent events, enrichment generations, cancellation, and projection through the core reducer."
    },
    {
      "id": "persistence_coordinator",
      "status": "existing",
      "planned_module": "crates/zentty-linux/src/persistence_coordinator.rs",
      "tracking": "GH-30",
      "responsibility": "One launch/live/shutdown snapshot lifecycle and one ordered persistence worker around the existing SessionRestoreStore and SnapshotPersistence implementation."
    },
    {
      "id": "existing_ui_projection",
      "status": "existing",
      "planned_module": "crates/zentty-linux/src/application_shell.rs and crates/zentty-linux/src/pane_dividers.rs",
      "tracking": "GH-31",
      "responsibility": "Window-local sidebar, pane-layout, accessible divider handles, peek, palette, search, navigation, rendering, and geometry projection pending final wiring review."
    },
    {
      "id": "existing_tmux_coordinator",
      "status": "existing",
      "planned_module": "crates/zentty-linux/src/application_shell/tmux_runtime.rs and crates/zentty-linux/src/tmux_store.rs",
      "tracking": "GH-14",
      "responsibility": "The already extracted bridge from the pure tmux compatibility model to the single product workspace and pane runtime, plus the one locked XDG file policy for source-compatible durable tmux state."
    }
  ],
