  "tracking": "GH-26",
  "purpose": "Characterize every ApplicationShell field, method, action, authority, and lifecycle edge before extraction; this contract assigns ownership but does not create a second implementation.",
  "owners": [
    {
      "id": "application_runtime",
      "status": "existing",
      "planned_module": "crates/zentty-linux/src/main.rs and crates/zentty-linux/src/application.rs",
      "tracking": "GH-31",
      "responsibility": "Process composition root and sole default GLib main-context/main-loop scheduling authority; owns the single process-wide authenticated Agent IPC transport plus startup, cross-window routing, transfer, and shutdown ordering around each window shell."
    },
    {
      "id": "application_shell",
      "status": "existing",
      "planned_module": "crates/zentty-linux/src/application_shell.rs",
      "tracking": "GH-25",
      "responsibility": "Window composition root, sole live WorkspaceState, top-level GTK window ownership, UI projection, and delegation between focused coordinators."
    },
    {
      "id": "config_store",
      "status": "existing",
      "planned_module": "crates/zentty-linux/src/config_store.rs",
      "tracking": "GH-20",
      "responsibility": "The sole process configuration loader: resolves the XDG path, performs bounded validation without logging contents, and supplies one immutable snapshot to application composition."
    },
    {
      "id": "action_router",
      "status": "existing",
      "planned_module": "crates/zentty-linux/src/application_shell/action_router.rs",
      "tracking": "GH-27",
      "responsibility": "One GTK action registry, typed Variant decoding, command availability, shortcuts, and dispatch without product-state ownership."
    },
    {
      "id": "pane_runtime_coordinator",
      "status": "existing",
      "planned_module": "crates/zentty-linux/src/application_shell/pane_runtime.rs",
      "tracking": "GH-28",
      "responsibility": "The sole pane-to-Ghostty-surface projection, including launch-deferred pane identity, callback registrations, transactional construction, focus, child exit, and teardown."
    },
    {
      "id": "agent_event_coordinator",
      "status": "existing",
      "planned_module": "crates/zentty-linux/src/application_shell/agent_events.rs",
      "tracking": "GH-29",
      "responsibility": "The sole UI-thread drain of authenticated agent events, enrichment generations, cancellation, and projection through the core reducer."
    },
    {
      "id": "global_search_coordinator",
      "status": "existing",
      "planned_module": "crates/zentty-linux/src/application_shell/global_search.rs",
      "tracking": "GH-34",
      "responsibility": "The sole window-local bridge from pure Global Find policy to existing Ghostty search sessions, GLib debounce, exact workspace selection, and numeric GTK projection."
    },
    {
      "id": "ssh_identity_coordinator",
      "status": "existing",
      "planned_module": "crates/zentty-linux/src/application_shell/ssh_identity.rs",
      "tracking": "GH-17",
      "responsibility": "The sole window-local projection from each Ghostty surface foreground process through bounded Linux process-tree inspection to transient SSH identity; owns one cancellable GLib polling source, at most one GLib/GIO blocking-pool probe, and no persistence or reconnection policy."
    },
    {
      "id": "remote_paste_coordinator",
      "status": "existing",
      "planned_module": "crates/zentty-linux/src/application_shell/remote_paste.rs",
      "tracking": "GH-17",
      "responsibility": "The sole window-local bridge from real GTK file/image clipboard and drop gestures to transactional remote transfer, SSH identity revalidation, cancellation, progress projection, and verified path insertion."
    },
    {
      "id": "clipboard_coordinator",
      "status": "existing",
      "planned_module": "crates/zentty-linux/src/application_shell/clipboard_actions.rs",
      "tracking": "GH-35",
      "responsibility": "The sole window-local bridge from a Ghostty-owned selection through pure Zentty formatting policy to the standard GTK clipboard; selection bytes are never persisted or logged."
    },
    {
      "id": "persistence_coordinator",
      "status": "existing",
      "planned_module": "crates/zentty-linux/src/persistence_coordinator.rs",
      "tracking": "GH-30",
      "responsibility": "One launch/live/shutdown snapshot lifecycle and one ordered persistence worker around the existing SessionRestoreStore and SnapshotPersistence implementation."
    },
    {
      "id": "existing_ui_projection",
      "status": "existing",
      "planned_module": "crates/zentty-linux/src/application_shell.rs and crates/zentty-linux/src/pane_dividers.rs",
      "tracking": "GH-31",
      "responsibility": "Window-local sidebar, pane-layout, accessible divider handles, peek, palette, search, navigation, rendering, and geometry projection pending final wiring review."
    },
    {
      "id": "existing_tmux_coordinator",
      "status": "existing",
      "planned_module": "crates/zentty-linux/src/application_shell/tmux_runtime.rs and crates/zentty-linux/src/tmux_store.rs",
      "tracking": "GH-14",
      "responsibility": "The already extracted bridge from the pure tmux compatibility model to the single product workspace and pane runtime, plus the one locked XDG file policy for source-compatible durable tmux state."
    },
    {
      "id": "server_runtime_coordinator",
      "status": "existing",
      "planned_module": "crates/zentty-linux/src/application_shell/server_runtime.rs, crates/zentty-linux/src/server_discovery.rs, and crates/zentty-linux/src/docker_discovery.rs",
      "tracking": "GH-19",
      "responsibility": "The sole window-local development-server registry and bounded Linux listener/container observer; projects source-ranked servers into existing sidebar/actions and revalidates ownership before signaling."
    },
    {
      "id": "task_runner_coordinator",
      "status": "existing",
      "planned_module": "crates/zentty-linux/src/application_shell/task_runner_runtime.rs and crates/zentty-core/src/task_runner.rs",
      "tracking": "GH-19",
      "responsibility": "The sole window-local task snapshot and launch bridge; discovers bounded source tasks for the focused pane, projects them into the existing command palette, revalidates activation, and transactionally launches through the existing workspace and Ghostty runtime."
    },
    {
      "id": "project_context_coordinator",
      "status": "existing",
      "planned_module": "crates/zentty-linux/src/application_shell/project_context_runtime.rs and crates/zentty-core/src/git_review_context.rs",
      "tracking": "GH-18",
      "responsibility": "The sole window-local Git, pull-request, and project-icon context projection; resolves bounded real repository state and canonically contained project icons for pane working directories, applies adaptive refresh without overlapping probes, rejects stale observations, preserves same-reference stale review evidence on transient failure, and launches only validated remote URLs."
    },
    {
      "id": "open_with_coordinator",
      "status": "existing",
      "planned_module": "crates/zentty-linux/src/application_shell/open_with_runtime.rs and crates/zentty-core/src/open_with.rs",
      "tracking": "GH-18",
      "responsibility": "The sole window-local Open With catalog and launch boundary; discovers real Linux desktop applications and executable targets once, resolves the focused canonical local directory or a revalidated product-owned source file, and launches through GIO or direct argv without a shell."
    },
    {
      "id": "bookmark_coordinator",
      "status": "existing",
      "planned_module": "crates/zentty-linux/src/application_shell/bookmark_runtime.rs, crates/zentty-linux/src/bookmarks_view.rs, crates/zentty-core/src/workspace_template.rs, and crates/zentty-core/src/bookmark_store.rs",
      "tracking": "GH-18",
      "responsibility": "The sole window-local bookmark/preset bridge: captures the existing live WorkspaceState and Ghostty foreground process, persists one bounded XDG store, restores through the existing pane runtime with fresh identities, and owns the source GTK popover, editing, linkage, import/export, recency, and visible fallback diagnostics."
    }
  ],
