{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TamedTornado/zentty/blob/linux/port/docs/architecture/schemas/zentty-application-response-v1.schema.json",
  "title": "Zentty application response v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "applicationApiVersion", "capabilities", "id", "ok", "result", "error"],
  "properties": {
    "version": {"const": 1},
    "applicationApiVersion": {"const": 1},
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "overview", "windows", "worklanes", "panes", "panes-current-worklane",
          "select-pane", "split", "grid", "focus", "pane-rename", "close",
          "worklane-color", "worklane-rename", "zoom", "resize", "layout",
          "theme", "notify"
        ]
      }
    },
    "id": {"type": "string", "maxLength": 128},
    "ok": {"type": "boolean"},
    "result": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["application"],
      "properties": {
        "application": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": {"enum": ["empty", "discovery", "selection", "topology", "theme"]},
            "value": {}
          },
          "allOf": [
            {
              "if": {"properties": {"kind": {"const": "empty"}}},
              "then": {"properties": {"value": {"type": "null"}}}
            },
            {
              "if": {"properties": {"kind": {"const": "discovery"}}},
              "then": {"properties": {"value": {"type": ["array", "object"]}}}
            },
            {
              "if": {"properties": {"kind": {"enum": ["selection", "topology"]}}},
              "then": {"properties": {"value": {"type": "object"}}}
            },
            {
              "if": {"properties": {"kind": {"const": "theme"}}},
              "then": {"properties": {"value": {"type": "string"}}}
            }
          ]
        }
      }
    },
    "error": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["category", "code", "message"],
      "properties": {
        "category": {
          "enum": [
            "invalid_arguments", "unsupported_operation", "unsupported_version",
            "authorization_failure", "stale_target", "stale_instance",
            "retryable_instance_replacement", "product_unavailable",
            "product_rejection", "permanent_transport_failure"
          ]
        },
        "code": {"type": "string", "pattern": "^[a-z0-9_]{1,64}$"},
        "message": {"type": "string", "maxLength": 4096}
      }
    }
  },
  "oneOf": [
    {
      "properties": {"ok": {"const": true}, "error": {"type": "null"}}
    },
    {
      "properties": {"ok": {"const": false}, "result": {"type": "null"}, "error": {"type": "object"}}
    }
  ]
}
