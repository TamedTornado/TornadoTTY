#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)"
contract="${ZENTTY_APPLICATION_SHELL_OWNERSHIP_CONTRACT:-${repo_root}/docs/architecture/application-shell-responsibilities-v1.json}"
main_file="${ZENTTY_APPLICATION_RUNTIME_SOURCE:-${repo_root}/crates/zentty-linux/src/main.rs}"
application_file="${ZENTTY_APPLICATION_COORDINATOR_SOURCE:-${repo_root}/crates/zentty-linux/src/application.rs}"
window_set_file="${ZENTTY_WINDOW_SET_SOURCE:-${repo_root}/crates/zentty-linux/src/window_set.rs}"
agent_runtime_file="${ZENTTY_AGENT_RUNTIME_SOURCE:-${repo_root}/crates/zentty-linux/src/agent_runtime.rs}"
codex_enrichment_file="${ZENTTY_CODEX_ENRICHMENT_SOURCE:-${repo_root}/crates/zentty-linux/src/codex_enrichment.rs}"
source_file="${ZENTTY_APPLICATION_SHELL_SOURCE:-${repo_root}/crates/zentty-linux/src/application_shell.rs}"
action_router_file="${ZENTTY_ACTION_ROUTER_SOURCE:-${repo_root}/crates/zentty-linux/src/application_shell/action_router.rs}"
agent_events_file="${ZENTTY_AGENT_EVENTS_SOURCE:-${repo_root}/crates/zentty-linux/src/application_shell/agent_events.rs}"
pane_runtime_file="${ZENTTY_PANE_RUNTIME_SOURCE:-${repo_root}/crates/zentty-linux/src/application_shell/pane_runtime.rs}"
pane_dividers_file="${ZENTTY_PANE_DIVIDERS_SOURCE:-${repo_root}/crates/zentty-linux/src/pane_dividers.rs}"
tmux_runtime_file="${ZENTTY_TMUX_RUNTIME_SOURCE:-${repo_root}/crates/zentty-linux/src/application_shell/tmux_runtime.rs}"
persistence_file="${ZENTTY_PERSISTENCE_COORDINATOR_SOURCE:-${repo_root}/crates/zentty-linux/src/persistence_coordinator.rs}"
tmux_compat_file="${ZENTTY_TMUX_COMPAT_SOURCE:-${repo_root}/crates/zentty-linux/src/tmux_compat.rs}"
tmux_store_file="${ZENTTY_TMUX_STORE_SOURCE:-${repo_root}/crates/zentty-linux/src/tmux_store.rs}"
matrix="${ZENTTY_QUALIFICATION_MATRIX:-${repo_root}/linux/qualification-matrix.json}"

fail() {
    echo "application-shell-ownership: error: $*" >&2
    exit 1
}

for dependency in jq sed sort comm mktemp sha256sum; do
    command -v "${dependency}" >/dev/null || fail "${dependency} is required"
done
[[ -r "${contract}" ]] || fail "ownership contract is missing: ${contract}"
[[ -r "${main_file}" ]] || fail "application runtime source is missing: ${main_file}"
[[ -r "${application_file}" ]] || fail "application coordinator source is missing: ${application_file}"
[[ -r "${window_set_file}" ]] || fail "window-set source is missing: ${window_set_file}"
[[ -r "${agent_runtime_file}" ]] || fail "agent runtime source is missing: ${agent_runtime_file}"
[[ -r "${codex_enrichment_file}" ]] || fail "Codex enrichment source is missing: ${codex_enrichment_file}"
[[ -r "${source_file}" ]] || fail "application shell source is missing: ${source_file}"
[[ -r "${action_router_file}" ]] || fail "action router source is missing: ${action_router_file}"
[[ -r "${agent_events_file}" ]] || fail "agent events source is missing: ${agent_events_file}"
[[ -r "${pane_runtime_file}" ]] || fail "pane runtime source is missing: ${pane_runtime_file}"
[[ -r "${pane_dividers_file}" ]] || fail "pane divider source is missing: ${pane_dividers_file}"
[[ -r "${tmux_runtime_file}" ]] || fail "tmux runtime source is missing: ${tmux_runtime_file}"
[[ -r "${persistence_file}" ]] || fail "persistence coordinator source is missing: ${persistence_file}"
[[ -r "${tmux_compat_file}" ]] || fail "tmux compatibility source is missing: ${tmux_compat_file}"
[[ -r "${tmux_store_file}" ]] || fail "tmux store source is missing: ${tmux_store_file}"
[[ -r "${matrix}" ]] || fail "qualification matrix is missing: ${matrix}"
jq empty "${contract}" >/dev/null 2>&1 || fail "ownership contract is not valid JSON"
jq empty "${matrix}" >/dev/null 2>&1 || fail "qualification matrix is not valid JSON"

temp_dir="$(mktemp -d)"
trap 'rm -rf -- "${temp_dir}"' EXIT

sed -n '/^pub(crate) struct ApplicationShell {/,/^}/p' "${source_file}" |
    sed -nE 's/^[[:space:]]+([a-zA-Z0-9_]+):.*/\1/p' |
    sort >"${temp_dir}/actual-fields"
jq -r '[.field_assignments[].fields[]] | sort | .[]' "${contract}" \
    >"${temp_dir}/contract-fields"
diff="$(comm -3 "${temp_dir}/actual-fields" "${temp_dir}/contract-fields")"
if [[ -n "${diff}" ]]; then
    printf '%s\n' "${diff}" >&2
    fail "field responsibility inventory differs from ApplicationShell"
fi

sed -n '/^impl ApplicationShell {/,/^fn observe_ghostty_search_state/p' "${source_file}" |
    sed '$d' |
    sed -nE 's/^[[:space:]]*(pub\(crate\)[[:space:]]+)?fn[[:space:]]+([a-zA-Z0-9_]+).*/\2/p' |
    sort >"${temp_dir}/actual-methods"
jq -r '[.method_assignments[].methods[]] | sort | .[]' "${contract}" \
    >"${temp_dir}/contract-methods"
diff="$(comm -3 "${temp_dir}/actual-methods" "${temp_dir}/contract-methods")"
if [[ -n "${diff}" ]]; then
    printf '%s\n' "${diff}" >&2
    fail "method responsibility inventory differs from ApplicationShell"
fi

sed -nE 's/^pub\(super\) const ACTION_[A-Z0-9_]+: &str = "([^"]+)";/\1/p' "${action_router_file}" |
    sort >"${temp_dir}/actual-actions"
jq -r '.action_contract[].name' "${contract}" | sort >"${temp_dir}/contract-actions"
diff="$(comm -3 "${temp_dir}/actual-actions" "${temp_dir}/contract-actions")"
if [[ -n "${diff}" ]]; then
    printf '%s\n' "${diff}" >&2
    fail "action inventory differs from ApplicationShell constants"
fi

main_sha256="$(sha256sum "${main_file}" | awk '{print $1}')"
application_sha256="$(sha256sum "${application_file}" | awk '{print $1}')"
window_set_sha256="$(sha256sum "${window_set_file}" | awk '{print $1}')"
agent_runtime_sha256="$(sha256sum "${agent_runtime_file}" | awk '{print $1}')"
codex_enrichment_sha256="$(sha256sum "${codex_enrichment_file}" | awk '{print $1}')"
source_sha256="$(sha256sum "${source_file}" | awk '{print $1}')"
action_router_sha256="$(sha256sum "${action_router_file}" | awk '{print $1}')"
agent_events_sha256="$(sha256sum "${agent_events_file}" | awk '{print $1}')"
pane_runtime_sha256="$(sha256sum "${pane_runtime_file}" | awk '{print $1}')"
pane_dividers_sha256="$(sha256sum "${pane_dividers_file}" | awk '{print $1}')"
tmux_runtime_sha256="$(sha256sum "${tmux_runtime_file}" | awk '{print $1}')"
persistence_sha256="$(sha256sum "${persistence_file}" | awk '{print $1}')"
tmux_compat_sha256="$(sha256sum "${tmux_compat_file}" | awk '{print $1}')"
tmux_store_sha256="$(sha256sum "${tmux_store_file}" | awk '{print $1}')"
jq -e --arg main_sha256 "${main_sha256}" \
    '.owned_source_sha256["crates/zentty-linux/src/main.rs"] == $main_sha256' \
    "${contract}" >/dev/null || fail "application runtime source hash differs from its ownership contract"
jq -e --arg application_sha256 "${application_sha256}" \
    '.owned_source_sha256["crates/zentty-linux/src/application.rs"] == $application_sha256' \
    "${contract}" >/dev/null || fail "application coordinator source hash differs from its ownership contract"
jq -e --arg window_set_sha256 "${window_set_sha256}" \
    '.owned_source_sha256["crates/zentty-linux/src/window_set.rs"] == $window_set_sha256' \
    "${contract}" >/dev/null || fail "window-set source hash differs from its ownership contract"
jq -e --arg agent_runtime_sha256 "${agent_runtime_sha256}" \
    '.owned_source_sha256["crates/zentty-linux/src/agent_runtime.rs"] == $agent_runtime_sha256' \
    "${contract}" >/dev/null || fail "agent runtime source hash differs from its ownership contract"
jq -e --arg codex_enrichment_sha256 "${codex_enrichment_sha256}" \
    '.owned_source_sha256["crates/zentty-linux/src/codex_enrichment.rs"] == $codex_enrichment_sha256' \
    "${contract}" >/dev/null || fail "Codex enrichment source hash differs from its ownership contract"
jq -e --arg pane_runtime_sha256 "${pane_runtime_sha256}" \
    '.owned_source_sha256["crates/zentty-linux/src/application_shell/pane_runtime.rs"] == $pane_runtime_sha256' \
    "${contract}" >/dev/null || fail "pane runtime source hash differs from its ownership contract"
jq -e --arg pane_dividers_sha256 "${pane_dividers_sha256}" \
    '.owned_source_sha256["crates/zentty-linux/src/pane_dividers.rs"] == $pane_dividers_sha256' \
    "${contract}" >/dev/null || fail "pane divider source hash differs from its ownership contract"
jq -e --arg agent_events_sha256 "${agent_events_sha256}" \
    '.owned_source_sha256["crates/zentty-linux/src/application_shell/agent_events.rs"] == $agent_events_sha256' \
    "${contract}" >/dev/null || fail "agent events source hash differs from its ownership contract"
jq -e --arg persistence_sha256 "${persistence_sha256}" \
    '.owned_source_sha256["crates/zentty-linux/src/persistence_coordinator.rs"] == $persistence_sha256' \
    "${contract}" >/dev/null || fail "persistence coordinator source hash differs from its ownership contract"
jq -e --arg tmux_runtime_sha256 "${tmux_runtime_sha256}" \
    '.owned_source_sha256["crates/zentty-linux/src/application_shell/tmux_runtime.rs"] == $tmux_runtime_sha256' \
    "${contract}" >/dev/null || fail "tmux runtime source hash differs from its ownership contract"
jq -e --arg tmux_compat_sha256 "${tmux_compat_sha256}" \
    '.owned_source_sha256["crates/zentty-linux/src/tmux_compat.rs"] == $tmux_compat_sha256' \
    "${contract}" >/dev/null || fail "tmux compatibility source hash differs from its ownership contract"
jq -e --arg tmux_store_sha256 "${tmux_store_sha256}" \
    '.owned_source_sha256["crates/zentty-linux/src/tmux_store.rs"] == $tmux_store_sha256' \
    "${contract}" >/dev/null || fail "tmux store source hash differs from its ownership contract"

sed -n '1,/^#\[cfg(test)\]/p' "${action_router_file}" |
    sed -nE 's/^[[:space:]]*(pub\(super\)[[:space:]]+)?(const[[:space:]]+)?fn[[:space:]]+([a-zA-Z0-9_]+).*/\3/p' |
    sort >"${temp_dir}/actual-action-router-functions"
jq -r '.owned_module_functions.action_router | sort | .[]' "${contract}" \
    >"${temp_dir}/contract-action-router-functions"
diff="$(comm -3 "${temp_dir}/actual-action-router-functions" "${temp_dir}/contract-action-router-functions")"
if [[ -n "${diff}" ]]; then
    printf '%s\n' "${diff}" >&2
    fail "action router function inventory differs from its ownership contract"
fi

sed -n '/^impl PaneRuntimeCoordinator {/,/^#\[cfg(test)\]/p' "${pane_runtime_file}" |
    sed '$d' |
    sed -nE 's/^[[:space:]]*(pub\(super\)[[:space:]]+)?(const[[:space:]]+)?fn[[:space:]]+([a-zA-Z0-9_]+).*/\3/p' |
    sort >"${temp_dir}/actual-pane-runtime-functions"
jq -r '.owned_module_functions.pane_runtime_coordinator | sort | .[]' "${contract}" \
    >"${temp_dir}/contract-pane-runtime-functions"
diff="$(comm -3 "${temp_dir}/actual-pane-runtime-functions" "${temp_dir}/contract-pane-runtime-functions")"
if [[ -n "${diff}" ]]; then
    printf '%s\n' "${diff}" >&2
    fail "pane runtime function inventory differs from its ownership contract"
fi

sed -n '1,/^#\[cfg(test)\]/p' "${pane_dividers_file}" |
    sed -nE 's/^[[:space:]]*(pub\(crate\)[[:space:]]+)?(const[[:space:]]+)?fn[[:space:]]+([a-zA-Z0-9_]+).*/\3/p' |
    sort >"${temp_dir}/actual-pane-divider-functions"
jq -r '.owned_module_functions.pane_dividers | sort | .[]' "${contract}" \
    >"${temp_dir}/contract-pane-divider-functions"
diff="$(comm -3 "${temp_dir}/actual-pane-divider-functions" "${temp_dir}/contract-pane-divider-functions")"
if [[ -n "${diff}" ]]; then
    printf '%s\n' "${diff}" >&2
    fail "pane divider function inventory differs from its ownership contract"
fi

sed -n '1,/^#\[cfg(test)\]/p' "${agent_events_file}" |
    sed -nE 's/^[[:space:]]*(pub\(super\)[[:space:]]+)?(const[[:space:]]+)?fn[[:space:]]+([a-zA-Z0-9_]+).*/\3/p' |
    sort >"${temp_dir}/actual-agent-event-functions"
jq -r '.owned_module_functions.agent_event_coordinator | sort | .[]' "${contract}" \
    >"${temp_dir}/contract-agent-event-functions"
diff="$(comm -3 "${temp_dir}/actual-agent-event-functions" "${temp_dir}/contract-agent-event-functions")"
if [[ -n "${diff}" ]]; then
    printf '%s\n' "${diff}" >&2
    fail "agent event coordinator function inventory differs from its ownership contract"
fi

sed -n '1,/^#\[cfg(test)\]/p' "${persistence_file}" |
    sed -nE 's/^[[:space:]]*(pub\(crate\)[[:space:]]+)?(const[[:space:]]+)?fn[[:space:]]+([a-zA-Z0-9_]+).*/\3/p' |
    sort >"${temp_dir}/actual-persistence-functions"
jq -r '.owned_module_functions.persistence_coordinator | sort | .[]' "${contract}" \
    >"${temp_dir}/contract-persistence-functions"
diff="$(comm -3 "${temp_dir}/actual-persistence-functions" "${temp_dir}/contract-persistence-functions")"
if [[ -n "${diff}" ]]; then
    printf '%s\n' "${diff}" >&2
    fail "persistence coordinator function inventory differs from its ownership contract"
fi

sed -n '/^impl ApplicationShell {/,/^}/p' "${tmux_runtime_file}" |
    sed -nE 's/^[[:space:]]*(pub\(super\)[[:space:]]+)?(const[[:space:]]+)?fn[[:space:]]+([a-zA-Z0-9_]+).*/\3/p' |
    sort >"${temp_dir}/actual-tmux-runtime-functions"
jq -r '.owned_module_functions.tmux_runtime_coordinator | sort | .[]' "${contract}" \
    >"${temp_dir}/contract-tmux-runtime-functions"
diff="$(comm -3 "${temp_dir}/actual-tmux-runtime-functions" "${temp_dir}/contract-tmux-runtime-functions")"
if [[ -n "${diff}" ]]; then
    printf '%s\n' "${diff}" >&2
    fail "tmux runtime function inventory differs from its ownership contract"
fi

sed -n '1,/^#\[cfg(test)\]/p' "${tmux_store_file}" |
    sed -nE 's/^[[:space:]]*(pub\(crate\)[[:space:]]+)?(const[[:space:]]+)?fn[[:space:]]+([a-zA-Z0-9_]+).*/\3/p' |
    sort >"${temp_dir}/actual-tmux-store-functions"
jq -r '.owned_module_functions.tmux_store_policy | sort | .[]' "${contract}" \
    >"${temp_dir}/contract-tmux-store-functions"
diff="$(comm -3 "${temp_dir}/actual-tmux-store-functions" "${temp_dir}/contract-tmux-store-functions")"
if [[ -n "${diff}" ]]; then
    printf '%s\n' "${diff}" >&2
    fail "tmux store function inventory differs from its ownership contract"
fi

jq -e --arg main_sha256 "${main_sha256}" \
    --arg application_sha256 "${application_sha256}" \
    --arg window_set_sha256 "${window_set_sha256}" \
    --arg agent_runtime_sha256 "${agent_runtime_sha256}" \
    --arg codex_enrichment_sha256 "${codex_enrichment_sha256}" \
    --arg source_sha256 "${source_sha256}" \
    --arg action_router_sha256 "${action_router_sha256}" \
    --arg agent_events_sha256 "${agent_events_sha256}" \
    --arg pane_runtime_sha256 "${pane_runtime_sha256}" \
    --arg pane_dividers_sha256 "${pane_dividers_sha256}" \
    --arg tmux_runtime_sha256 "${tmux_runtime_sha256}" \
    --arg persistence_sha256 "${persistence_sha256}" \
    --arg tmux_compat_sha256 "${tmux_compat_sha256}" \
    --arg tmux_store_sha256 "${tmux_store_sha256}" '
    .schema_version == 1 and
    .contract_id == "zentty-application-shell-responsibilities" and
    .source == "crates/zentty-linux/src/application_shell.rs" and
    .source_sha256 == $source_sha256 and
    .owned_source_sha256 == {
        "crates/zentty-linux/src/main.rs":$main_sha256,
        "crates/zentty-linux/src/application.rs":$application_sha256,
        "crates/zentty-linux/src/window_set.rs":$window_set_sha256,
        "crates/zentty-linux/src/agent_runtime.rs":$agent_runtime_sha256,
        "crates/zentty-linux/src/codex_enrichment.rs":$codex_enrichment_sha256,
        "crates/zentty-linux/src/application_shell/action_router.rs":$action_router_sha256,
        "crates/zentty-linux/src/application_shell/agent_events.rs":$agent_events_sha256,
        "crates/zentty-linux/src/application_shell/pane_runtime.rs":$pane_runtime_sha256,
        "crates/zentty-linux/src/application_shell/tmux_runtime.rs":$tmux_runtime_sha256,
        "crates/zentty-linux/src/pane_dividers.rs":$pane_dividers_sha256,
        "crates/zentty-linux/src/persistence_coordinator.rs":$persistence_sha256,
        "crates/zentty-linux/src/tmux_compat.rs":$tmux_compat_sha256,
        "crates/zentty-linux/src/tmux_store.rs":$tmux_store_sha256
    } and
    .tracking == "GH-26" and
    ([.owners[].id] | sort) == ([
        "action_router",
        "agent_event_coordinator",
        "application_runtime",
        "application_shell",
        "existing_tmux_coordinator",
        "existing_ui_projection",
        "pane_runtime_coordinator",
        "persistence_coordinator"
    ] | sort) and
    ([.owners[].id] | length) == ([.owners[].id] | unique | length) and
    all(.owners[];
        (.status == "existing" or .status == "planned") and
        (.responsibility | type == "string" and length > 0) and
        (.planned_module | type == "string" and length > 0) and
        (.tracking | type == "string" and test("^GH-[0-9]+$"))) and
    ([.field_assignments[].owner] - [.owners[].id] | length) == 0 and
    ([.method_assignments[].owner] - [.owners[].id] | length) == 0 and
    ([.field_assignments[].fields[]] | length) ==
        ([.field_assignments[].fields[]] | unique | length) and
    ([.method_assignments[].methods[]] | length) ==
        ([.method_assignments[].methods[]] | unique | length) and
    (.owned_module_functions | keys | sort) == (["action_router", "agent_event_coordinator", "pane_dividers", "pane_runtime_coordinator", "persistence_coordinator", "tmux_runtime_coordinator", "tmux_store_policy"] | sort) and
    (.owned_module_functions.action_router | length) ==
        (.owned_module_functions.action_router | unique | length) and
    (.owned_module_functions.pane_runtime_coordinator | length) ==
        (.owned_module_functions.pane_runtime_coordinator | unique | length) and
    (.owned_module_functions.pane_dividers | length) ==
        (.owned_module_functions.pane_dividers | unique | length) and
    (.owned_module_functions.agent_event_coordinator | length) ==
        (.owned_module_functions.agent_event_coordinator | unique | length) and
    (.owned_module_functions.persistence_coordinator | length) ==
        (.owned_module_functions.persistence_coordinator | unique | length) and
    (.owned_module_functions.tmux_runtime_coordinator | length) ==
        (.owned_module_functions.tmux_runtime_coordinator | unique | length) and
    (.owned_module_functions.tmux_store_policy | length) ==
        (.owned_module_functions.tmux_store_policy | unique | length) and
    all(.field_assignments[]; .fields | length > 0) and
    all(.method_assignments[]; .methods | length > 0) and
    ([.action_contract[].name] | length) ==
        ([.action_contract[].name] | unique | length) and
    all(.action_contract[];
        (.parameter == "none" or .parameter == "string" or
         .parameter == "string_pair") and
        (.owner == "action_router") and
        (.invalid_parameter == "ignore-without-panic")) and
    ([.action_contract[] | select(.parameter == "string") | .name] | sort) == ([
        "close-worklane", "move-pane-to-worklane", "select-worklane"
    ] | sort) and
    ([.action_contract[] | select(.parameter == "string_pair") | .name] | sort) == ([
        "move-worklane", "rename-pane", "rename-worklane", "reorder-worklane",
        "select-pane", "set-worklane-color"
    ] | sort) and
    ([.action_contract[] | select(.parameter == "none")] | length) == 50 and
    .conditional_action_availability == {
        "multiple_columns":["resize-pane-left","resize-pane-right","arrange-golden-wide","arrange-golden-narrow"],
        "multiple_panes_in_focused_column":["resize-pane-up","resize-pane-down","arrange-golden-tall","arrange-golden-short"],
        "all_other_actions":"always"
    } and
    .single_authorities == {
        "workspace_state": {"owner":"application_shell","maximum_instances_per_window":1},
        "gtk_action_registry": {"owner":"action_router","maximum_instances_per_window":1},
        "surface_registry": {"owner":"pane_runtime_coordinator","maximum_instances_per_window":1},
        "session_store": {"owner":"persistence_coordinator","maximum_instances_per_process":1},
        "agent_ipc_transport": {"owner":"agent_event_coordinator","maximum_instances_per_window":1},
        "agent_event_projection": {"owner":"agent_event_coordinator","maximum_instances_per_window":1},
        "tmux_compatibility_state": {"owner":"existing_tmux_coordinator","maximum_instances_per_window":1},
        "glib_scheduling": {"owner":"application_runtime","kind":"default-glib-main-context","maximum_instances_per_process":1}
    } and
    .construction_order == [
        "create-ghostty-runtime-before-gtk",
        "initialize-gtk-and-build-shell-widgets",
        "load-one-validated-workspace-state",
        "start-one-agent-ipc-runtime",
        "install-one-action-router",
        "construct-pane-surfaces-transactionally",
        "render-and-present"
    ] and
    .shutdown_order == [
        "mark-shutting-down-and-stop-user-actions",
        "remove-glib-producers-and-cancel-agent-enrichment",
        "freeze-one-workspace-and-agent-draft-snapshot",
        "detach-pane-widgets-and-quiesce-callbacks",
        "release-each-surface-once",
        "settle-native-finalizers-without-blocking",
        "save-through-one-session-store",
        "release-ghostty-runtime-after-surface-finalization"
    ] and
    .forbidden_parallel_authorities == [
        "alternate-test-product",
        "application-embedded-scenario-mode",
        "second-agent-event-queue",
        "second-agent-status-reducer",
        "second-async-runtime",
        "second-pane-or-surface-registry",
        "second-session-store-or-backup-journal",
        "second-workspace-state"
    ] and
    ([.behavior_evidence[].requirement] | sort) == ([
        "agent-event-routing-enrichment-and-shutdown",
        "gtk-action-and-source-ux-characterization",
        "pane-owner-cardinality-construction-and-teardown",
        "session-store-clean-exit-restore-and-failure",
        "single-authority-architecture-and-test-orchestration"
    ] | sort) and
    ([.behavior_evidence[].requirement] | length) ==
        ([.behavior_evidence[].requirement] | unique | length) and
    all(.behavior_evidence[];
        (.boundary | type == "string" and length > 40) and
        (.cells | type == "array" and length > 0)) and
    ([.behavior_evidence[].cells[]] | length) > 0 and
    .extraction_order == ["GH-27", "GH-28", "GH-29", "GH-30", "GH-31"]
' "${contract}" >/dev/null || fail "ownership contract invariants failed"

jq -e --slurpfile matrix "${matrix}" '
    all(.behavior_evidence[].cells[]; . as $cell_id |
        any($matrix[0].cells[]; .id == $cell_id and .status == "PASS"))
' "${contract}" >/dev/null || fail "behavior evidence is absent or non-PASS in the matrix"

echo "ApplicationShell ownership contract passed"
