#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)"
architecture_dir="${repo_root}/docs/architecture"
validator="${architecture_dir}/tests/validate-architecture"
source_contract="${architecture_dir}/linux-product-architecture-v1.json"
temp_dir="$(mktemp -d)"
trap 'rm -rf "${temp_dir}"' EXIT

run_expect_failure() {
    local name="$1"
    local pattern="$2"
    shift 2
    local output="${temp_dir}/${name}.log"
    set +e
    env "$@" "${validator}" >"${output}" 2>&1
    local status=$?
    set -e
    if [[ "${status}" -eq 0 ]]; then
        echo "architecture-contract-test: ${name} unexpectedly passed" >&2
        cat "${output}" >&2
        exit 1
    fi
    grep -F "${pattern}" "${output}" >/dev/null || {
        echo "architecture-contract-test: ${name} did not report '${pattern}'" >&2
        cat "${output}" >&2
        exit 1
    }
}

invalid_edge="${temp_dir}/invalid-edge.json"
jq '(.workspace_crates[] | select(.name == "zentty-core") | .workspace_dependencies) = ["zentty-linux"]' \
    "${source_contract}" >"${invalid_edge}"
run_expect_failure invalid-edge "architecture contract invariants failed" \
    "ZENTTY_ARCHITECTURE_CONTRACT=${invalid_edge}"

missing_real_edge="${temp_dir}/missing-real-edge.json"
jq '
    (.workspace_crates[] | select(.name == "zentty-agent-ipc") |
        .workspace_dependencies) -= ["zentty-tmux-compat"] |
    .allowed_workspace_edges -= ["zentty-agent-ipc->zentty-tmux-compat"]
' "${source_contract}" >"${missing_real_edge}"
run_expect_failure missing-real-edge \
    "Cargo workspace dependency graph differs from architecture contract" \
    "ZENTTY_ARCHITECTURE_CONTRACT=${missing_real_edge}"

unsafe_core="${temp_dir}/unsafe-core.json"
jq '(.workspace_crates[] | select(.name == "zentty-core") | .unsafe_policy) = "allow"' \
    "${source_contract}" >"${unsafe_core}"
run_expect_failure unsafe-core "architecture contract invariants failed" \
    "ZENTTY_ARCHITECTURE_CONTRACT=${unsafe_core}"

missing_owner="${temp_dir}/missing-owner.json"
jq '.long_lived_owners -= ["GhosttyPtyOwner"]' \
    "${source_contract}" >"${missing_owner}"
run_expect_failure missing-owner "architecture contract invariants failed" \
    "ZENTTY_ARCHITECTURE_CONTRACT=${missing_owner}"

invalid_creation_order="${temp_dir}/invalid-creation-order.json"
jq '.lifecycle.creation_order[1:3] |= reverse' \
    "${source_contract}" >"${invalid_creation_order}"
run_expect_failure invalid-creation-order "architecture contract invariants failed" \
    "ZENTTY_ARCHITECTURE_CONTRACT=${invalid_creation_order}"

invalid_shutdown_order="${temp_dir}/invalid-shutdown-order.json"
jq '.lifecycle.shutdown_order[4:7] |= reverse' \
    "${source_contract}" >"${invalid_shutdown_order}"
run_expect_failure invalid-shutdown-order "architecture contract invariants failed" \
    "ZENTTY_ARCHITECTURE_CONTRACT=${invalid_shutdown_order}"

stale_ghostty_revision="${temp_dir}/stale-ghostty-revision.json"
jq '.ghostty_revision = "0000000000000000000000000000000000000000"' \
    "${source_contract}" >"${stale_ghostty_revision}"
run_expect_failure stale-ghostty-revision "architecture contract invariants failed" \
    "ZENTTY_ARCHITECTURE_CONTRACT=${stale_ghostty_revision}"

blocking_runtime_free="${temp_dir}/blocking-runtime-free.json"
jq '.ffi_contract.runtime_free_gate = "block-until-weak-ref-callback"' \
    "${source_contract}" >"${blocking_runtime_free}"
run_expect_failure blocking-runtime-free "architecture contract invariants failed" \
    "ZENTTY_ARCHITECTURE_CONTRACT=${blocking_runtime_free}"

premature_runtime_lease="${temp_dir}/premature-runtime-lease.json"
jq '.ffi_contract.runtime_lease = "release-when-surface-owner-drops"' \
    "${source_contract}" >"${premature_runtime_lease}"
run_expect_failure premature-runtime-lease "architecture contract invariants failed" \
    "ZENTTY_ARCHITECTURE_CONTRACT=${premature_runtime_lease}"

minimal_msrv_graph="${temp_dir}/minimal-msrv-graph.json"
jq '.toolchain.msrv_job = "msrv-minimal-features"' \
    "${source_contract}" >"${minimal_msrv_graph}"
run_expect_failure minimal-msrv-graph "architecture contract invariants failed" \
    "ZENTTY_ARCHITECTURE_CONTRACT=${minimal_msrv_graph}"

drifted_traceability="${temp_dir}/drifted-traceability.json"
jq '(.cross_stream_traceability[] |
    select(.requirement_id == "ZL-4-WORKLANE-SHELL") |
    .test_ids[0]) = "TEST-WORKLANES"' \
    "${source_contract}" >"${drifted_traceability}"
run_expect_failure drifted-traceability "architecture contract invariants failed" \
    "ZENTTY_ARCHITECTURE_CONTRACT=${drifted_traceability}"

drifted_pane_family="${temp_dir}/drifted-pane-family.json"
jq '.qualification_cell_families[0].axes.async_backend = ["default", "epoll"]' \
    "${source_contract}" >"${drifted_pane_family}"
run_expect_failure drifted-pane-family "architecture contract invariants failed" \
    "ZENTTY_ARCHITECTURE_CONTRACT=${drifted_pane_family}"

missing_pane_family_cell="${temp_dir}/missing-pane-family-cell.json"
jq '.cells |= map(select(.id != "product-pane-lifecycle-debug-x11-io-uring-multi"))' \
    "${repo_root}/linux/qualification-matrix.json" >"${missing_pane_family_cell}"
run_expect_failure missing-pane-family-cell \
    "pane-terminal qualification family differs from authoritative matrix" \
    "ZENTTY_QUALIFICATION_MATRIX=${missing_pane_family_cell}"

invalid_proposed_status="${temp_dir}/invalid-proposed-status.json"
jq '.proposed_qualification_cells[0].status = "SKIP"' \
    "${source_contract}" >"${invalid_proposed_status}"
run_expect_failure invalid-proposed-status "architecture contract invariants failed" \
    "ZENTTY_ARCHITECTURE_CONTRACT=${invalid_proposed_status}"

drifted_matrix="${temp_dir}/drifted-matrix.json"
jq '(.cells[] | select(.id == "workspace-recipe-v3-contract") | .command) = "true"' \
    "${repo_root}/linux/qualification-matrix.json" >"${drifted_matrix}"
run_expect_failure drifted-matrix "architecture qualification mirror differs from authoritative matrix" \
    "ZENTTY_QUALIFICATION_MATRIX=${drifted_matrix}"

drifted_defect="${temp_dir}/drifted-defect.json"
jq '(.proposed_qualification_cells[] | select(.id == "product-boundary-wayland") | .defect) = "arbitrary stale mirror defect"' \
    "${source_contract}" >"${drifted_defect}"
run_expect_failure drifted-defect "architecture qualification mirror differs from authoritative matrix" \
    "ZENTTY_ARCHITECTURE_CONTRACT=${drifted_defect}"

drifted_prerequisite="${temp_dir}/drifted-prerequisite.json"
jq '(.proposed_qualification_cells[] | select(.id == "architecture-contract-v1") | .prerequisite) = "arbitrary stale mirror prerequisite"' \
    "${source_contract}" >"${drifted_prerequisite}"
run_expect_failure drifted-prerequisite "architecture qualification mirror differs from authoritative matrix" \
    "ZENTTY_ARCHITECTURE_CONTRACT=${drifted_prerequisite}"

"${validator}" >/dev/null
echo "Architecture validator negative self-tests passed"
