#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)"
validator="${repo_root}/docs/architecture/tests/validate-application-shell-ownership"
contract="${repo_root}/docs/architecture/application-shell-responsibilities-v1.json"
main_file="${repo_root}/crates/zentty-linux/src/main.rs"
application_file="${repo_root}/crates/zentty-linux/src/application.rs"
agent_runtime_file="${repo_root}/crates/zentty-linux/src/agent_runtime.rs"
agents_settings_file="${repo_root}/crates/zentty-linux/src/agents_settings.rs"
codex_enrichment_file="${repo_root}/crates/zentty-linux/src/codex_enrichment.rs"
source_file="${repo_root}/crates/zentty-linux/src/application_shell.rs"
shortcut_settings_file="${repo_root}/crates/zentty-linux/src/shortcut_settings.rs"
agent_events_file="${repo_root}/crates/zentty-linux/src/application_shell/agent_events.rs"
pane_runtime_file="${repo_root}/crates/zentty-linux/src/application_shell/pane_runtime.rs"
tmux_runtime_file="${repo_root}/crates/zentty-linux/src/application_shell/tmux_runtime.rs"
tmux_compat_file="${repo_root}/crates/zentty-linux/src/tmux_compat.rs"
tmux_store_file="${repo_root}/crates/zentty-linux/src/tmux_store.rs"
persistence_file="${repo_root}/crates/zentty-linux/src/persistence_coordinator.rs"
temp_dir="$(mktemp -d)"
trap 'rm -rf -- "${temp_dir}"' EXIT

expect_failure() {
    local name="$1"
    local expected="$2"
    shift 2
    local receipt="${temp_dir}/${name}.log"
    if env "$@" "${validator}" >"${receipt}" 2>&1; then
        echo "application-shell-ownership-test: ${name} unexpectedly passed" >&2
        exit 1
    fi
    grep -F "${expected}" "${receipt}" >/dev/null || {
        cat "${receipt}" >&2
        echo "application-shell-ownership-test: ${name} lacked expected failure" >&2
        exit 1
    }
}

"${validator}" >/dev/null

# A presentation-only source edit must not require re-signing the architecture
# contract. Structural inventories and authority constraints remain enforced.
sed '1i// presentation-only change used by the ownership validator self-test' \
    "${shortcut_settings_file}" >"${temp_dir}/presentation-only.rs"
env "ZENTTY_SHORTCUT_SETTINGS_SOURCE=${temp_dir}/presentation-only.rs" \
    "${validator}" >/dev/null

jq '.source_sha256 = "whole-file-hashes-are-not-architecture"' \
    "${contract}" >"${temp_dir}/reintroduced-source-hash.json"
expect_failure reintroduced-source-hash "ownership contract invariants failed" \
    "ZENTTY_APPLICATION_SHELL_OWNERSHIP_CONTRACT=${temp_dir}/reintroduced-source-hash.json"

jq '.field_assignments[0].fields += [.field_assignments[0].fields[0]]' \
    "${contract}" >"${temp_dir}/duplicate-field.json"
expect_failure duplicate-field "field responsibility inventory differs" \
    "ZENTTY_APPLICATION_SHELL_OWNERSHIP_CONTRACT=${temp_dir}/duplicate-field.json"

jq '(.method_assignments[].methods) |= map(select(. != "finish_pane_layout_action"))' \
    "${contract}" >"${temp_dir}/missing-method.json"
expect_failure missing-method "method responsibility inventory differs" \
    "ZENTTY_APPLICATION_SHELL_OWNERSHIP_CONTRACT=${temp_dir}/missing-method.json"

jq '.field_assignments[0].owner = "shadow_shell"' \
    "${contract}" >"${temp_dir}/unknown-owner.json"
expect_failure unknown-owner "ownership contract invariants failed" \
    "ZENTTY_APPLICATION_SHELL_OWNERSHIP_CONTRACT=${temp_dir}/unknown-owner.json"

jq '.single_authorities.surface_registry.maximum_instances_per_window = 2' \
    "${contract}" >"${temp_dir}/second-registry.json"
expect_failure second-registry "ownership contract invariants failed" \
    "ZENTTY_APPLICATION_SHELL_OWNERSHIP_CONTRACT=${temp_dir}/second-registry.json"

jq 'del(.single_authorities.gtk_action_registry)' \
    "${contract}" >"${temp_dir}/missing-action-authority.json"
expect_failure missing-action-authority "ownership contract invariants failed" \
    "ZENTTY_APPLICATION_SHELL_OWNERSHIP_CONTRACT=${temp_dir}/missing-action-authority.json"

jq '.single_authorities.glib_scheduling.owner = "application_shell"' \
    "${contract}" >"${temp_dir}/split-glib-authority.json"
expect_failure split-glib-authority "ownership contract invariants failed" \
    "ZENTTY_APPLICATION_SHELL_OWNERSHIP_CONTRACT=${temp_dir}/split-glib-authority.json"

jq '.shutdown_order[2:5] |= reverse' \
    "${contract}" >"${temp_dir}/shutdown-order.json"
expect_failure shutdown-order "ownership contract invariants failed" \
    "ZENTTY_APPLICATION_SHELL_OWNERSHIP_CONTRACT=${temp_dir}/shutdown-order.json"

jq '(.action_contract[] | select(.name == "select-pane") | .parameter) = "string"' \
    "${contract}" >"${temp_dir}/action-type.json"
expect_failure action-type "ownership contract invariants failed" \
    "ZENTTY_APPLICATION_SHELL_OWNERSHIP_CONTRACT=${temp_dir}/action-type.json"

jq '(.owned_module_functions.action_router) |= map(select(. != "populate"))' \
    "${contract}" >"${temp_dir}/missing-router-function.json"
expect_failure missing-router-function "action router function inventory differs" \
    "ZENTTY_APPLICATION_SHELL_OWNERSHIP_CONTRACT=${temp_dir}/missing-router-function.json"

jq '(.owned_module_functions.pane_runtime_coordinator) |= map(select(. != "remove"))' \
    "${contract}" >"${temp_dir}/missing-pane-runtime-function.json"
expect_failure missing-pane-runtime-function "pane runtime function inventory differs" \
    "ZENTTY_APPLICATION_SHELL_OWNERSHIP_CONTRACT=${temp_dir}/missing-pane-runtime-function.json"

jq '(.owned_module_functions.agent_event_coordinator) |= map(select(. != "apply_inputs"))' \
    "${contract}" >"${temp_dir}/missing-agent-event-function.json"
expect_failure missing-agent-event-function "agent event coordinator function inventory differs" \
    "ZENTTY_APPLICATION_SHELL_OWNERSHIP_CONTRACT=${temp_dir}/missing-agent-event-function.json"

sed '/runtime: Rc<RefCell<AgentRuntime>>,/a\    shadow_receiver: std::sync::mpsc::Receiver<zentty_core::AuthenticatedAgentEvent>,' \
    "${agent_events_file}" >"${temp_dir}/shadow-agent-event-queue.rs"
expect_failure shadow-agent-event-queue "agent event coordinator transport boundary" \
    "ZENTTY_AGENT_EVENTS_SOURCE=${temp_dir}/shadow-agent-event-queue.rs"

sed '/struct State {/a\    shadow_apply: Option<ApplyAgents>,' \
    "${agents_settings_file}" >"${temp_dir}/shadow-agents-settings.rs"
expect_failure shadow-agents-settings-owner "Agents settings write authority" \
    "ZENTTY_AGENTS_SETTINGS_SOURCE=${temp_dir}/shadow-agents-settings.rs"

jq '(.owned_module_functions.persistence_coordinator) |= map(select(. != "save_clean_exit"))' \
    "${contract}" >"${temp_dir}/missing-persistence-function.json"
expect_failure missing-persistence-function "persistence coordinator function inventory differs" \
    "ZENTTY_APPLICATION_SHELL_OWNERSHIP_CONTRACT=${temp_dir}/missing-persistence-function.json"

sed '/worker: PersistenceWorker,/a\    shadow_store: SessionRestoreStore,' \
    "${persistence_file}" >"${temp_dir}/shadow-persistence-store.rs"
expect_failure shadow-persistence-store "persistence store boundary" \
    "ZENTTY_PERSISTENCE_COORDINATOR_SOURCE=${temp_dir}/shadow-persistence-store.rs"

jq '(.owned_module_functions.tmux_runtime_coordinator) |= map(select(. != "execute_tmux_command"))' \
    "${contract}" >"${temp_dir}/missing-tmux-function.json"
expect_failure missing-tmux-function "tmux runtime function inventory differs" \
    "ZENTTY_APPLICATION_SHELL_OWNERSHIP_CONTRACT=${temp_dir}/missing-tmux-function.json"

jq '(.owned_module_functions.tmux_store_policy) |= map(select(. != "mutate"))' \
    "${contract}" >"${temp_dir}/missing-tmux-store-function.json"
expect_failure missing-tmux-store-function "tmux store function inventory differs" \
    "ZENTTY_APPLICATION_SHELL_OWNERSHIP_CONTRACT=${temp_dir}/missing-tmux-store-function.json"

sed '/tmux-command pane=/i\        let shadow_tmux_state = crate::tmux_compat::TmuxCompatProduct::default();' \
    "${tmux_runtime_file}" >"${temp_dir}/shadow-tmux-runtime.rs"
expect_failure shadow-tmux-runtime "tmux product authority" \
    "ZENTTY_TMUX_RUNTIME_SOURCE=${temp_dir}/shadow-tmux-runtime.rs"

sed '/let main_loop = glib::MainLoop::new/a\    let shadow_main_loop = glib::MainLoop::new(None, false);' \
    "${main_file}" >"${temp_dir}/shadow-main-loop.rs"
expect_failure shadow-main-loop "process main-loop authority" \
    "ZENTTY_APPLICATION_RUNTIME_SOURCE=${temp_dir}/shadow-main-loop.rs"

sed '/runtime: GhosttyRuntime,/a\    shadow_runtime: GhosttyRuntime,' \
    "${application_file}" >"${temp_dir}/shadow-application-runtime.rs"
expect_failure shadow-application-runtime "Ghostty runtime authority" \
    "ZENTTY_APPLICATION_COORDINATOR_SOURCE=${temp_dir}/shadow-application-runtime.rs"

sed '/receiver: mpsc::Receiver<AuthenticatedAgentEvent>,/a\    shadow_receiver: mpsc::Receiver<AuthenticatedAgentEvent>,' \
    "${agent_runtime_file}" >"${temp_dir}/shadow-agent-transport.rs"
expect_failure shadow-agent-transport "authenticated agent transport authority" \
    "ZENTTY_AGENT_RUNTIME_SOURCE=${temp_dir}/shadow-agent-transport.rs"

sed '/struct PendingWorker {/a\    shadow_generation: u64,' \
    "${codex_enrichment_file}" >"${temp_dir}/shadow-enrichment-generation.rs"
expect_failure shadow-enrichment-generation "Codex enrichment generation authority" \
    "ZENTTY_CODEX_ENRICHMENT_SOURCE=${temp_dir}/shadow-enrichment-generation.rs"

sed '/pub(crate) struct TmuxCompatProduct {/a\    shadow: std::collections::BTreeMap<String, String>,' \
    "${tmux_compat_file}" >"${temp_dir}/shadow-tmux-state.rs"
expect_failure shadow-tmux-state "tmux shadow state boundary" \
    "ZENTTY_TMUX_COMPAT_SOURCE=${temp_dir}/shadow-tmux-state.rs"

sed '/file: AtomicFileStore,/a\    shadow_file: AtomicFileStore,' \
    "${tmux_store_file}" >"${temp_dir}/shadow-tmux-store.rs"
expect_failure shadow-tmux-store "tmux persistence authority" \
    "ZENTTY_TMUX_STORE_SOURCE=${temp_dir}/shadow-tmux-store.rs"

sed '/surfaces: BTreeMap<String, GhosttySurface>,/a\    shadow_surfaces: BTreeMap<String, GhosttySurface>,' \
    "${pane_runtime_file}" >"${temp_dir}/shadow-pane-registry.rs"
expect_failure shadow-pane-registry "pane surface registry authority" \
    "ZENTTY_PANE_RUNTIME_SOURCE=${temp_dir}/shadow-pane-registry.rs"

sed '/pub(super) const ACTION_TOGGLE_SIDEBAR/a\pub(super) const ACTION_UNTRACKED: &str = "untracked";' \
    "${repo_root}/crates/zentty-linux/src/application_shell/action_router.rs" \
    >"${temp_dir}/untracked-action.rs"
expect_failure untracked-action "action inventory differs" \
    "ZENTTY_ACTION_ROUTER_SOURCE=${temp_dir}/untracked-action.rs"

sed '/window: gtk::Window,/a\    shadow_state: WorkspaceState,' \
    "${source_file}" >"${temp_dir}/extra-field.rs"
expect_failure extra-source-field "field responsibility inventory differs" \
    "ZENTTY_APPLICATION_SHELL_SOURCE=${temp_dir}/extra-field.rs"

echo "ApplicationShell ownership validator negative tests passed"
