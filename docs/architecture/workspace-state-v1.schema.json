{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TamedTornado/zentty/blob/linux/port/docs/architecture/workspace-state-v1.schema.json",
  "title": "Zentty workspace state version 1",
  "description": "Strict durable Linux product state. Presentation caches, process state, and secret-bearing data are deliberately absent.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "workspace_id",
    "revision",
    "active_window_id",
    "windows"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "workspace_id": {
      "$ref": "#/$defs/stable_id"
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "active_window_id": {
      "$ref": "#/$defs/stable_id"
    },
    "windows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/window"
      }
    }
  },
  "$defs": {
    "stable_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "order",
        "active_worklane_id",
        "worklanes"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/stable_id"
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "active_worklane_id": {
          "$ref": "#/$defs/stable_id"
        },
        "worklanes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/worklane"
          }
        }
      }
    },
    "worklane": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "order",
        "title",
        "layout",
        "active_pane_id",
        "panes"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/stable_id"
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "title": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "pattern": "^[^\\u0000]+$"
        },
        "layout": {
          "$ref": "#/$defs/worklane_layout"
        },
        "active_pane_id": {
          "$ref": "#/$defs/stable_id"
        },
        "panes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/pane"
          }
        }
      }
    },
    "worklane_layout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "columns"
      ],
      "properties": {
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/column_layout"
          }
        }
      }
    },
    "column_layout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "weight"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "weight": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "pane": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "order",
        "title",
        "layout",
        "cwd",
        "command",
        "agent"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/stable_id"
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "title": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "pattern": "^[^\\u0000]+$"
        },
        "layout": {
          "$ref": "#/$defs/pane_layout"
        },
        "cwd": {
          "type": "string",
          "pattern": "^/[^\\u0000]*$",
          "minLength": 1
        },
        "command": {
          "$ref": "#/$defs/command"
        },
        "agent": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/agent"
            }
          ]
        }
      }
    },
    "pane_layout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "column",
        "row",
        "row_weight"
      ],
      "properties": {
        "column": {
          "type": "integer",
          "minimum": 0
        },
        "row": {
          "type": "integer",
          "minimum": 0
        },
        "row_weight": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "launch_profile_id"
      ],
      "properties": {
        "launch_profile_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]{0,63}$"
        }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter",
        "resume_id"
      ],
      "properties": {
        "adapter": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "resume_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000]+$"
        }
      }
    }
  },
  "x-zentty-invariants": {
    "ordering": "Every order array is exactly 0..n-1 after sorting by order.",
    "identity": "Window, worklane, and pane IDs are globally unique and active IDs resolve in their containing object.",
    "unknown_fields": "Reject the document and preserve its bytes; never silently discard fields.",
    "newer_versions": "Reject the document and preserve its bytes; start in read-only recovery rather than overwrite it.",
    "older_versions": "Run explicit sequential migrations in memory, validate the result, retain a private backup, then use the atomic write protocol.",
    "corruption": "Leave unreadable state untouched, disable automatic saves, and enter a visible recovery flow.",
    "atomic_write": "Hold the workspace lock; write a mode-0600 same-directory exclusive temporary file, flush and fsync it, rename over the primary, then fsync the directory.",
    "confidentiality": "Command stores only an approved non-secret launch_profile_id, never free-form program, argv, headers, environment, or an observed shell command. The platform layer resolves that profile and any secret-provider handles only into transient launch data outside the serializable model. All persisted strings reject NUL. Never persist credentials, clipboard contents, agent transcripts, arbitrary environment entries, or unapproved secrets.",
    "agent_resume_id": "May be persisted only when the adapter contract classifies it as a non-secret opaque identifier; it is never a credential or transcript."
  }
}
